+/*
+ * kbase backend for pan_kmod.
+ *
+ * The Nura 3.10 kernel exposes ARM kbase r15p0 through /dev/mali0 with the
+ * legacy "UK 10.6" ioctl ABI: one misc device, one ioctl, function id in the
+ * first u32 of the argument buffer, a per-fd kbase context, SAME_VA memory
+ * (CPU VA == GPU VA, page tables installed at mmap() time), job chains
+ * submitted as 64-byte base_jd_atom_v2 records, completion events read from
+ * the fd, and Android-sync-fence based soft jobs.
+ *
+ * This backend translates pan_kmod to that ABI.  It implements memory, VM
+ * (no-op: kbase maps at mmap time), submission with in/out fences, and a
+ * binary sync provider on top of kbase sync timelines.  It does not implement
+ * dma-buf import/export, timeline sync objects, perf counters, eviction or
+ * job timestamp queries; those are reported as unsupported.
+ *
+ * Everything here was derived from the kernel sources in
+ * drivers/gpu/arm/t7xx/r15p0 (see the references in the functions below).
+ * There is no hardware in this tree; the code is compile/link validated.
+ */
+
+#include <errno.h>
+#include <fcntl.h>
+#include <limits.h>
+#include <poll.h>
+#include <pthread.h>
+#include <stdarg.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/ioctl.h>
+#include <sys/mman.h>
+#include <time.h>
+#include <unistd.h>
+
+#include <xf86drm.h>
+
+#include "drm-uapi/panfrost_drm.h"
+#include "pan_kmod_backend.h"
+#include "util/macros.h"
+#include "util/os_mman.h"
+#include "util/u_atomic.h"
+
+/* ------------------------------------------------------------------ */
+/* UK 10.6 wire ABI (mali_uk.h, mali_kbase_uku.h, mali_base_kernel.h). */
+
+#define KBASE_UK_VERSION_MAJOR 10
+#define KBASE_UK_VERSION_MINOR 6
+
+#define UK_FUNC_ID 512
+#define UKP_FUNC_ID_CHECK_VERSION 0
+
+#define KBASE_UK_IOCTL(size) _IOC(_IOC_WRITE, 0, 0, (size))
+#define KBASE_UK_CALL_MAX_SIZE 568
+
+#define KBASE_FUNC_MEM_ALLOC (UK_FUNC_ID + 0)
+#define KBASE_FUNC_MEM_FREE (UK_FUNC_ID + 4)
+#define KBASE_FUNC_GPU_PROPS_REG_DUMP (UK_FUNC_ID + 14)
+#define KBASE_FUNC_GET_VERSION (UK_FUNC_ID + 16)
+#define KBASE_FUNC_SET_FLAGS (UK_FUNC_ID + 18)
+#define KBASE_FUNC_STREAM_CREATE (UK_FUNC_ID + 24)
+#define KBASE_FUNC_JOB_SUBMIT (UK_FUNC_ID + 28)
+#define KBASE_FUNC_GET_CONTEXT_ID (UK_FUNC_ID + 31)
+
+#define KBASE_GET_VERSION_BUFFER_SIZE 64
+#define BASE_MEM_MAP_TRACKING_HANDLE (3ull << 12)
+
+union kbase_uk_header {
+   uint32_t id;
+   uint32_t ret;
+   uint64_t sizer;
+};
+
+struct kbase_uk_version_check {
+   union kbase_uk_header header;
+   uint16_t major;
+   uint16_t minor;
+   uint8_t padding[4];
+};
+
+struct kbase_uk_set_flags {
+   union kbase_uk_header header;
+   uint32_t create_flags;
+   uint32_t padding;
+};
+
+struct kbase_uk_get_ddk_version {
+   union kbase_uk_header header;
+   char version_buffer[KBASE_GET_VERSION_BUFFER_SIZE];
+   uint32_t version_string_size;
+   uint32_t padding;
+};
+
+struct kbase_uk_context_id {
+   union kbase_uk_header header;
+   int32_t id;
+};
+
+struct kbase_uk_mem_alloc {
+   union kbase_uk_header header;
+   uint64_t va_pages;
+   uint64_t commit_pages;
+   uint64_t extent;
+   uint64_t flags;
+   uint64_t gpu_va;
+   uint16_t va_alignment;
+   uint8_t padding[6];
+};
+
+struct kbase_uk_mem_free {
+   union kbase_uk_header header;
+   uint64_t gpu_addr;
+};
+
+struct kbase_uk_stream_create {
+   union kbase_uk_header header;
+   char name[32];
+   int32_t fd;
+   uint32_t padding;
+};
+
+union kbase_pointer {
+   void *value;
+   uint32_t compat_value;
+   uint64_t sizer;
+};
+
+struct kbase_uk_job_submit {
+   union kbase_uk_header header;
+   union kbase_pointer addr;
+   uint32_t nr_atoms;
+   uint32_t stride;
+   uint32_t gles_ctx_handle; /* Samsung systrace extension */
+   uint32_t frame_number;
+   void *surfacep;
+};
+
+struct base_jd_udata {
+   uint64_t blob[2];
+};
+
+struct base_dependency {
+   uint8_t atom_id;
+   uint8_t dependency_type;
+};
+
+#define BASE_JD_DEP_TYPE_INVALID 0
+#define BASE_JD_DEP_TYPE_DATA 1
+#define BASE_JD_DEP_TYPE_ORDER 2
+
+struct base_jd_atom_v2 {
+   uint64_t jc;
+   struct base_jd_udata udata;
+   union kbase_pointer extres_list;
+   uint16_t nr_extres;
+   uint16_t compat_core_req;
+   struct base_dependency pre_dep[2];
+   uint8_t atom_number;
+   uint8_t prio;
+   uint8_t device_nr;
+   uint8_t padding;
+   uint32_t core_req;
+   uint32_t gles_ctx_handle;
+   uint32_t frame_number;
+   void *surfacep;
+};
+
+struct base_jd_event_v2 {
+   uint32_t event_code;
+   uint8_t atom_number;
+   uint8_t pad[3];
+   struct base_jd_udata udata;
+};
+
+struct base_dump_cpu_gpu_counters {
+   uint64_t system_time;
+   uint64_t cycle_counter;
+   uint64_t sec;
+   uint64_t usec;
+   uint8_t padding[32];
+};
+
+struct base_fence {
+   struct {
+      int fd;
+      int stream_fd;
+   } basep;
+};
+
+/* Requirements (mali_base_kernel.h).  Values are shared with
+ * drm-uapi/panfrost_drm.h's PANFROST_JD_REQ_* for the low bits. */
+#define BASE_JD_REQ_DEP 0u
+#define BASE_JD_REQ_FS (1u << 0)
+#define BASE_JD_REQ_CS (1u << 1)
+#define BASE_JD_REQ_T (1u << 2)
+#define BASE_JD_REQ_CF (1u << 3)
+#define BASE_JD_REQ_V (1u << 4)
+#define BASE_JD_REQ_SOFT_JOB (1u << 9)
+#define BASE_JD_REQ_SOFT_DUMP_CPU_GPU_TIME (BASE_JD_REQ_SOFT_JOB | 1)
+#define BASE_JD_REQ_SOFT_FENCE_TRIGGER (BASE_JD_REQ_SOFT_JOB | 2)
+#define BASE_JD_REQ_SOFT_FENCE_WAIT (BASE_JD_REQ_SOFT_JOB | 3)
+
+#define BASE_JD_PRIO_MEDIUM 0
+
+#define BASE_JD_EVENT_DONE 0x01
+
+/* Memory flags (mali_base_kernel.h enum base_mem_alloc_flags). */
+#define BASE_MEM_PROT_CPU_RD (1u << 0)
+#define BASE_MEM_PROT_CPU_WR (1u << 1)
+#define BASE_MEM_PROT_GPU_RD (1u << 2)
+#define BASE_MEM_PROT_GPU_WR (1u << 3)
+#define BASE_MEM_PROT_GPU_EX (1u << 4)
+#define BASE_MEM_GROW_ON_GPF (1u << 9)
+#define BASE_MEM_COHERENT_SYSTEM (1u << 10)
+#define BASE_MEM_CACHED_CPU (1u << 12)
+#define BASE_MEM_SAME_VA (1u << 13)
+
+_Static_assert(sizeof(struct kbase_uk_version_check) == 16, "UK ABI");
+_Static_assert(sizeof(struct kbase_uk_set_flags) == 16, "UK ABI");
+_Static_assert(sizeof(struct kbase_uk_get_ddk_version) == 80, "UK ABI");
+_Static_assert(sizeof(struct kbase_uk_context_id) == 16, "UK ABI");
+_Static_assert(sizeof(struct kbase_uk_mem_alloc) == 56, "UK ABI");
+_Static_assert(sizeof(struct kbase_uk_mem_free) == 16, "UK ABI");
+_Static_assert(sizeof(struct kbase_uk_stream_create) == 48, "UK ABI");
+_Static_assert(sizeof(struct kbase_uk_job_submit) == 40, "UK ABI");
+_Static_assert(sizeof(struct base_jd_atom_v2) == 64, "UK ABI");
+_Static_assert(sizeof(struct base_jd_event_v2) == 24, "UK ABI");
+_Static_assert(sizeof(struct base_dump_cpu_gpu_counters) == 64, "UK ABI");
+_Static_assert(sizeof(struct base_fence) == 8, "UK ABI");
+_Static_assert(__builtin_offsetof(struct base_jd_atom_v2, core_req) == 44,
+               "UK ABI");
+
+/* GPU props wire layout; offsets measured from the kernel headers (the same
+ * numbers are static-asserted in parity/userspace/gpu/kbase-winsys). */
+struct kbase_props_raw {
+   uint64_t shader_present;
+   uint64_t tiler_present;
+   uint64_t l2_present;
+   uint64_t stack_present;
+   uint32_t l2_features;
+   uint32_t suspend_size;
+   uint32_t mem_features;
+   uint32_t mmu_features;
+   uint32_t as_present;
+   uint32_t js_present;
+   uint32_t js_features[16];
+   uint32_t tiler_features;
+   uint32_t texture_features[3];
+   uint32_t gpu_id;
+   uint32_t thread_max_threads;
+   uint32_t thread_max_workgroup_size;
+   uint32_t thread_max_barrier_size;
+   uint32_t thread_features;
+   uint32_t coherency_mode;
+};
+
+struct kbase_props_core {
+   uint32_t product_id;
+   uint16_t version_status;
+   uint16_t minor_revision;
+   uint16_t major_revision;
+   uint16_t padding;
+   uint32_t gpu_speed_mhz;
+   uint32_t gpu_freq_khz_max;
+   uint32_t gpu_freq_khz_min;
+   uint32_t log2_program_counter_size;
+   uint32_t texture_features[3];
+   uint64_t gpu_available_memory_size;
+};
+
+struct kbase_props_coherency {
+   uint32_t num_groups;
+   uint32_t num_core_groups;
+   uint32_t coherency;
+   uint32_t padding;
+   struct {
+      uint64_t core_mask;
+      uint16_t num_cores;
+      uint16_t padding[3];
+   } group[16];
+};
+
+struct kbase_gpu_props {
+   struct kbase_props_core core_props; /* 0 */
+   struct {
+      uint8_t log2_line_size;
+      uint8_t log2_cache_size;
+      uint8_t num_l2_slices;
+      uint8_t padding[5];
+   } l2_props; /* 48 */
+   uint64_t unused_1; /* 56 */
+   struct {
+      uint32_t bin_size_bytes;
+      uint32_t max_active_levels;
+   } tiler_props; /* 64 */
+   struct {
+      uint32_t max_threads;
+      uint32_t max_workgroup_size;
+      uint32_t max_barrier_size;
+      uint16_t max_registers;
+      uint8_t max_task_queue;
+      uint8_t max_thread_group_split;
+      uint8_t impl_tech;
+      uint8_t padding[7];
+   } thread_props; /* 72 */
+   struct kbase_props_raw raw_props; /* 96 */
+   struct kbase_props_coherency coherency_info; /* 256 */
+};
+
+_Static_assert(sizeof(struct kbase_gpu_props) == 528, "gpu props ABI");
+_Static_assert(__builtin_offsetof(struct kbase_gpu_props, raw_props) == 96, "");
+_Static_assert(__builtin_offsetof(struct kbase_props_raw, gpu_id) == 136, "");
+_Static_assert(__builtin_offsetof(struct kbase_gpu_props, coherency_info) ==
+                  256,
+               "");
+
+/* ------------------------------------------------------------------ */
+/* Helpers. */
+
+#define KBASE_MAX_ATOMS 256
+#define KBASE_SYNC_SLOTS 128
+#define KBASE_PAGE_SIZE 4096u
+
+static int
+kbase_uk_call(int fd, void *args, size_t size)
+{
+   if (size > KBASE_UK_CALL_MAX_SIZE)
+      return -E2BIG;
+   if (ioctl(fd, KBASE_UK_IOCTL(size), args) != 0)
+      return -errno;
+   return 0;
+}
+
+static int64_t
+kbase_now_ns(void)
+{
+   struct timespec ts;
+
+   clock_gettime(CLOCK_MONOTONIC, &ts);
+   return (int64_t)ts.tv_sec * 1000000000ll + ts.tv_nsec;
+}
+
+static void
+kbase_deadline_to_ts(int64_t deadline_ns, struct timespec *ts)
+{
+   ts->tv_sec = deadline_ns / 1000000000ll;
+   ts->tv_nsec = deadline_ns % 1000000000ll;
+}
+
+struct kbase_kmod_dev;
+
+extern const struct pan_kmod_ops kbase_kmod_ops;
+
+/* Binary sync provider: every "sync object" is a table slot holding zero or
+ * one fence fd plus a software-signaled bit.  kbase fences are Android sync
+ * fences, which are pollable, so wait() is a poll loop. */
+struct kbase_sync_slot {
+   int fd;
+   bool signaled;
+   bool in_use;
+};
+
+struct kbase_sync_provider {
+   struct util_sync_provider base;
+   struct kbase_kmod_dev *dev;
+   pthread_mutex_t lock;
+   struct kbase_sync_slot slots[KBASE_SYNC_SLOTS];
+};
+
+struct kbase_kmod_dev {
+   struct pan_kmod_dev base;
+
+   struct pan_kmod_vm *vm;
+   int tl_fd; /* kbase sync timeline */
+   uint32_t next_bo_handle;
+
+   pthread_mutex_t lock;
+   pthread_cond_t cond;
+   bool atom_busy[KBASE_MAX_ATOMS];
+   uint32_t last_event[KBASE_MAX_ATOMS];
+
+   pthread_t ev_thread;
+   bool ev_thread_valid;
+   int stop_pipe[2];
+
+   int64_t slot_timeout_ns;
+
+   struct kbase_sync_provider sync;
+};
+
+struct kbase_kmod_bo {
+   struct pan_kmod_bo base;
+   void *cpu;
+   uint64_t gpu_va;
+   uint64_t size;
+   uint64_t mk_flags;
+};
+
+struct kbase_kmod_vm {
+   struct pan_kmod_vm base;
+};
+
+static inline struct kbase_kmod_dev *
+kbase_dev(struct pan_kmod_dev *dev)
+{
+   return container_of(dev, struct kbase_kmod_dev, base);
+}
+
+/* ------------------------------------------------------------------ */
+/* Device creation. */
+
+static int
+kbase_handshake(struct kbase_kmod_dev *kdev)
+{
+   struct kbase_uk_version_check ver;
+   struct kbase_uk_set_flags flags;
+   struct kbase_uk_get_ddk_version version;
+   struct kbase_uk_context_id ctx;
+   int fd = kdev->base.fd;
+   int ret;
+
+   memset(&ver, 0, sizeof(ver));
+   ver.header.id = UKP_FUNC_ID_CHECK_VERSION;
+   ver.major = KBASE_UK_VERSION_MAJOR;
+   ver.minor = KBASE_UK_VERSION_MINOR;
+   ret = kbase_uk_call(fd, &ver, sizeof(ver));
+   if (ret || ver.header.ret)
+      return -EPROTO;
+   if (!(ver.major == 10 && ver.minor >= 3) && !(ver.major > 10))
+      return -EPROTO;
+
+   memset(&flags, 0, sizeof(flags));
+   flags.header.id = KBASE_FUNC_SET_FLAGS;
+   ret = kbase_uk_call(fd, &flags, sizeof(flags));
+   if (ret || flags.header.ret)
+      return -EPROTO;
+
+   /* kbase_mmap() refuses every mapping until the tracking page is mapped
+    * (mali_kbase_mem_linux.c:kbase_mmap). */
+   void *mtp = mmap(NULL, KBASE_PAGE_SIZE, PROT_NONE, MAP_SHARED, fd,
+                    (off_t)BASE_MEM_MAP_TRACKING_HANDLE);
+   if (mtp == MAP_FAILED)
+      return -errno;
+
+   memset(&version, 0, sizeof(version));
+   version.header.id = KBASE_FUNC_GET_VERSION;
+   ret = kbase_uk_call(fd, &version, sizeof(version));
+   if (ret || version.header.ret)
+      return -EPROTO;
+
+   memset(&ctx, 0, sizeof(ctx));
+   ctx.header.id = KBASE_FUNC_GET_CONTEXT_ID;
+   ret = kbase_uk_call(fd, &ctx, sizeof(ctx));
+   if (ret)
+      return ret;
+
+   return 0;
+}
+
+static void
+kbase_props_from_kernel(struct pan_kmod_dev_props *props,
+                        const struct kbase_gpu_props *p)
+{
+   memset(props, 0, sizeof(*props));
+   props->gpu_id = p->raw_props.gpu_id;
+   props->gpu_variant = 0;
+   props->gpu_features = 0;
+   props->shader_present = p->raw_props.shader_present;
+   props->tiler_features = p->raw_props.tiler_features;
+   props->mem_features = p->raw_props.mem_features;
+   props->mmu_features = p->raw_props.mmu_features;
+   memcpy(props->texture_features, p->raw_props.texture_features,
+          sizeof(p->raw_props.texture_features));
+   props->l2_features = p->raw_props.l2_features;
+   props->max_threads_per_core = p->thread_props.max_threads;
+   props->max_tasks_per_core = p->thread_props.max_task_queue;
+   props->max_threads_per_wg = p->thread_props.max_workgroup_size;
+   props->num_registers_per_core = p->thread_props.max_registers;
+   props->max_tls_instance_per_core = p->raw_props.thread_max_threads;
+   props->afbc_features = 0; /* Midgard (arch 4) has no AFBC */
+   props->gpu_can_query_timestamp = false;
+   props->pgsize_bitmap = 1ull << 12;
+   props->supported_bo_flags = PAN_KMOD_BO_FLAG_EXECUTABLE |
+                               PAN_KMOD_BO_FLAG_ALLOC_ON_FAULT |
+                               PAN_KMOD_BO_FLAG_NO_MMAP;
+   props->supported_vm_op_flags = 0;
+   /* mali_base_kernel.h: raw coherency_mode is the *selected* mode, 0 = the
+    * platform did not negotiate IO coherency. */
+   props->is_io_coherent = p->raw_props.coherency_mode != 0;
+}
+
+/* ------------------------------------------------------------------ */
+/* Sync provider. */
+
+static struct kbase_sync_provider *
+sync_provider(struct util_sync_provider *p)
+{
+   return container_of(p, struct kbase_sync_provider, base);
+}
+
+static int
+kbase_sync_slot_alloc_locked(struct kbase_sync_provider *s, uint32_t *handle)
+{
+   /* Handle 0 is reserved: panfrost uses out_sync == 0 to mean "no
+    * explicit fence". */
+   for (uint32_t i = 1; i < KBASE_SYNC_SLOTS; i++) {
+      if (!s->slots[i].in_use) {
+         s->slots[i].in_use = true;
+         s->slots[i].fd = -1;
+         s->slots[i].signaled = false;
+         *handle = i;
+         return 0;
+      }
+   }
+   return -ENOMEM;
+}
+
+static int
+kbase_sync_create(struct util_sync_provider *p, uint32_t flags,
+                  uint32_t *handle)
+{
+   struct kbase_sync_provider *s = sync_provider(p);
+   int ret;
+
+   pthread_mutex_lock(&s->lock);
+   ret = kbase_sync_slot_alloc_locked(s, handle);
+   if (ret == 0)
+      s->slots[*handle].signaled = !!(flags & DRM_SYNCOBJ_CREATE_SIGNALED);
+   pthread_mutex_unlock(&s->lock);
+   return ret;
+}
+
+static int
+kbase_sync_destroy(struct util_sync_provider *p, uint32_t handle)
+{
+   struct kbase_sync_provider *s = sync_provider(p);
+
+   if (handle >= KBASE_SYNC_SLOTS)
+      return -EINVAL;
+
+   pthread_mutex_lock(&s->lock);
+   if (s->slots[handle].fd >= 0)
+      close(s->slots[handle].fd);
+   s->slots[handle].fd = -1;
+   s->slots[handle].signaled = false;
+   s->slots[handle].in_use = false;
+   pthread_mutex_unlock(&s->lock);
+   return 0;
+}
+
+static int
+kbase_sync_handle_to_fd(struct util_sync_provider *p, uint32_t handle,
+                        int *out_fd)
+{
+   struct kbase_sync_provider *s = sync_provider(p);
+
+   if (handle == 0 || handle >= KBASE_SYNC_SLOTS)
+      return -EINVAL;
+
+   pthread_mutex_lock(&s->lock);
+   *out_fd = s->slots[handle].fd >= 0
+                ? fcntl(s->slots[handle].fd, F_DUPFD_CLOEXEC, 0)
+                : -1;
+   pthread_mutex_unlock(&s->lock);
+   return *out_fd >= 0 ? 0 : -EINVAL;
+}
+
+static int
+kbase_sync_fd_to_handle(struct util_sync_provider *p, int obj_fd,
+                        uint32_t *handle)
+{
+   struct kbase_sync_provider *s = sync_provider(p);
+   int ret;
+
+   pthread_mutex_lock(&s->lock);
+   ret = kbase_sync_slot_alloc_locked(s, handle);
+   if (ret == 0) {
+      s->slots[*handle].fd = fcntl(obj_fd, F_DUPFD_CLOEXEC, 0);
+      s->slots[*handle].signaled = false;
+      if (s->slots[*handle].fd < 0)
+         ret = -errno;
+   }
+   pthread_mutex_unlock(&s->lock);
+   return ret;
+}
+
+static int
+kbase_sync_import_file(struct util_sync_provider *p, uint32_t handle,
+                       int sync_file_fd)
+{
+   struct kbase_sync_provider *s = sync_provider(p);
+   int fd;
+
+   if (handle == 0 || handle >= KBASE_SYNC_SLOTS)
+      return -EINVAL;
+
+   fd = fcntl(sync_file_fd, F_DUPFD_CLOEXEC, 0);
+   if (fd < 0)
+      return -errno;
+
+   pthread_mutex_lock(&s->lock);
+   if (s->slots[handle].fd >= 0)
+      close(s->slots[handle].fd);
+   s->slots[handle].fd = fd;
+   s->slots[handle].signaled = false;
+   pthread_mutex_unlock(&s->lock);
+   return 0;
+}
+
+static int
+kbase_sync_export_file(struct util_sync_provider *p, uint32_t handle,
+                       int *out_fd)
+{
+   return kbase_sync_handle_to_fd(p, handle, out_fd);
+}
+
+static int
+kbase_sync_wait(struct util_sync_provider *p, uint32_t *handles,
+                unsigned num_handles, int64_t timeout_nsec, unsigned flags,
+                uint32_t *first_signaled)
+{
+   struct kbase_sync_provider *s = sync_provider(p);
+   /* panfrost passes an absolute monotonic deadline; treat values at or above
+    * INT64_MAX/2 (OS_TIMEOUT_INFINITE and absolute deadlines) as "forever"
+    * instead of overflowing. */
+   int64_t deadline;
+   if (timeout_nsec < 0 ||
+       (uint64_t)timeout_nsec >= (uint64_t)INT64_MAX / 2)
+      deadline = -1;
+   else
+      deadline = kbase_now_ns() + timeout_nsec;
+
+   (void)flags;
+   (void)first_signaled;
+
+   for (unsigned i = 0; i < num_handles; i++) {
+      if (handles[i] == 0 || handles[i] >= KBASE_SYNC_SLOTS)
+         return -EINVAL;
+   }
+
+   for (;;) {
+      unsigned pending = 0;
+
+      pthread_mutex_lock(&s->lock);
+      for (unsigned i = 0; i < num_handles; i++) {
+         struct kbase_sync_slot *slot = &s->slots[handles[i]];
+
+         if (slot->signaled)
+            continue;
+         if (slot->fd >= 0) {
+            struct pollfd pfd = {.fd = slot->fd, .events = POLLIN};
+            int r = poll(&pfd, 1, 0);
+            if (r > 0 && (pfd.revents & (POLLIN | POLLHUP | POLLERR))) {
+               slot->signaled = true;
+               continue;
+            }
+         }
+         pending++;
+      }
+      pthread_mutex_unlock(&s->lock);
+
+      if (!pending)
+         return 0;
+
+      if (deadline >= 0 && kbase_now_ns() >= deadline) {
+         errno = ETIME;
+         return -1;
+      }
+
+      struct timespec ts = {.tv_sec = 0, .tv_nsec = 1000000};
+      nanosleep(&ts, NULL);
+   }
+}
+
+static int
+kbase_sync_reset(struct util_sync_provider *p, const uint32_t *handles,
+                 uint32_t handle_count)
+{
+   struct kbase_sync_provider *s = sync_provider(p);
+
+   pthread_mutex_lock(&s->lock);
+   for (uint32_t i = 0; i < handle_count; i++) {
+      if (handles[i] == 0 || handles[i] >= KBASE_SYNC_SLOTS)
+         continue;
+      s->slots[handles[i]].signaled = false;
+      if (s->slots[handles[i]].fd >= 0) {
+         close(s->slots[handles[i]].fd);
+         s->slots[handles[i]].fd = -1;
+      }
+   }
+   pthread_mutex_unlock(&s->lock);
+   return 0;
+}
+
+static int
+kbase_sync_signal(struct util_sync_provider *p, const uint32_t *handles,
+                  uint32_t handle_count)
+{
+   /* A kbase fence can only be signaled by the GPU (soft fence trigger
+    * atom); a userspace signal would silently break submission ordering. */
+   (void)p;
+   (void)handles;
+   (void)handle_count;
+   return -ENOSYS;
+}
