+/* ------------------------------------------------------------------ */
+/* VM.  kbase has no VM ioctl: the mapping is installed when the BO is
+ * mmapped, so vm_bind only reports the address assigned at allocation. */
+
+static struct pan_kmod_vm *
+kbase_kmod_vm_create(struct pan_kmod_dev *dev, uint32_t flags,
+                     uint64_t va_start, uint64_t va_range)
+{
+   struct kbase_kmod_dev *kdev = kbase_dev(dev);
+   struct kbase_kmod_vm *vm;
+
+   (void)va_start;
+   (void)va_range;
+
+   if (kdev->vm) {
+      mesa_loge("kbase: only one VM per kbase context is supported");
+      return NULL;
+   }
+
+   vm = pan_kmod_dev_alloc(dev, sizeof(*vm));
+   if (!vm)
+      return NULL;
+
+   pan_kmod_vm_init(&vm->base, dev, 0, flags);
+   vm->base.pgsize_bitmap = 1ull << 12;
+   kdev->vm = &vm->base;
+   return &vm->base;
+}
+
+static void
+kbase_kmod_vm_destroy(struct pan_kmod_vm *vm)
+{
+   struct kbase_kmod_dev *kdev = kbase_dev(vm->dev);
+
+   if (kdev->vm == vm)
+      kdev->vm = NULL;
+   pan_kmod_dev_free(vm->dev, container_of(vm, struct kbase_kmod_vm, base));
+}
+
+static int
+kbase_kmod_vm_bind(struct pan_kmod_vm *vm, enum pan_kmod_vm_op_mode mode,
+                   struct pan_kmod_vm_op *ops, uint32_t op_count)
+{
+   (void)vm;
+
+   if (mode != PAN_KMOD_VM_OP_MODE_IMMEDIATE &&
+       mode != PAN_KMOD_VM_OP_MODE_DEFER_TO_NEXT_IDLE_POINT)
+      return -1;
+
+   for (uint32_t i = 0; i < op_count; i++) {
+      if (ops[i].type == PAN_KMOD_VM_OP_TYPE_MAP) {
+         struct kbase_kmod_bo *bo =
+            container_of(ops[i].map.bo, struct kbase_kmod_bo, base);
+
+         if (ops[i].map.bo_offset != 0 || ops[i].va.size != bo->size)
+            return -1;
+         if (ops[i].flags & PAN_KMOD_VM_OP_OP_MAP_SPARSE)
+            return -1;
+         if (ops[i].va.start != PAN_KMOD_VM_MAP_AUTO_VA &&
+             ops[i].va.start != bo->gpu_va)
+            return -1;
+
+         ops[i].va.start = bo->gpu_va;
+      } else if (ops[i].type == PAN_KMOD_VM_OP_TYPE_UNMAP) {
+         /* Unmapping happens at munmap()/BO destruction. */
+      } else {
+         return -1;
+      }
+   }
+
+   return 0;
+}
+
+/* ------------------------------------------------------------------ */
+/* Submission. */
+
+/* Translate one panfrost job-chain submission into a kbase atom batch:
+ *   [fence-wait atom] [job atom] [fence-trigger atom]
+ * Dependencies are resolved against kbase's persistent 256-entry atom
+ * table, so the trigger atom must follow the job atom in the same batch. */
+static int
+kbase_kmod_submit_job(struct pan_kmod_dev *dev,
+                      struct drm_panfrost_submit *submit)
+{
+   struct kbase_kmod_dev *kdev = kbase_dev(dev);
+   struct base_jd_atom_v2 atoms[3];
+   struct base_fence wait_fence = {.basep = {.fd = -1, .stream_fd = -1}};
+   struct base_fence trig_fence = {.basep = {.fd = -1,
+                                             .stream_fd = kdev->tl_fd}};
+   uint8_t slots[3];
+   unsigned n_atoms = 0, n_slots = 1;
+   uint32_t wait_slot = 0, job_slot, trig_slot;
+   int in_fd = -1, out_fd = -1;
+   int64_t deadline;
+   int ret;
+
+   if (!submit->jc)
+      return -EINVAL;
+
+   if (submit->in_sync_count) {
+      if (submit->in_sync_count > 1) {
+         mesa_loge("kbase: at most one in-fence per job is supported");
+         return -EINVAL;
+      }
+      const uint32_t *in_syncs =
+         (const uint32_t *)(uintptr_t)submit->in_syncs;
+      in_fd = kbase_sync_get_fd_dup(&kdev->sync, in_syncs[0]);
+      if (in_fd < 0) {
+         mesa_loge("kbase: in-fence has no fd (was it imported?)");
+         return -EINVAL;
+      }
+   }
+
+   if (in_fd >= 0)
+      n_slots++;
+   uint32_t out_sync = submit->out_sync;
+
+   deadline = kdev->slot_timeout_ns < 0
+                 ? -1
+                 : kbase_now_ns() + kdev->slot_timeout_ns;
+
+   pthread_mutex_lock(&kdev->lock);
+   ret = kbase_alloc_slots_locked(kdev, n_slots, slots, deadline);
+   pthread_mutex_unlock(&kdev->lock);
+   if (ret) {
+      if (in_fd >= 0)
+         close(in_fd);
+      return ret;
+   }
+
+   unsigned idx = 0;
+   if (in_fd >= 0) {
+      wait_slot = slots[idx++];
+      wait_fence.basep.fd = in_fd;
+   }
+   job_slot = slots[idx++];
+   trig_slot = slots[idx++];
+
+   if (wait_slot) {
+      struct base_jd_atom_v2 *a = &atoms[n_atoms++];
+      memset(a, 0, sizeof(*a));
+      a->jc = (uint64_t)(uintptr_t)&wait_fence;
+      a->core_req = BASE_JD_REQ_SOFT_FENCE_WAIT;
+      a->atom_number = wait_slot;
+      a->prio = BASE_JD_PRIO_MEDIUM;
+   }
+
+   {
+      struct base_jd_atom_v2 *a = &atoms[n_atoms++];
+      uint32_t core_req = 0;
+
+      if (submit->requirements & PANFROST_JD_REQ_FS)
+         core_req |= BASE_JD_REQ_FS;
+      else
+         /* Vertex/geometry/compute chain plus tiling.  kbase only uses this
+          * to pick a job slot and for DVFS hints; the real job types are in
+          * the Midgard job-chain headers. */
+         core_req |= BASE_JD_REQ_CS | BASE_JD_REQ_T;
+
+      if (submit->requirements & PANFROST_JD_REQ_CYCLE_COUNT)
+         mesa_loge_once("kbase: PANFROST_JD_REQ_CYCLE_COUNT is not supported");
+
+      memset(a, 0, sizeof(*a));
+      a->jc = submit->jc;
+      a->core_req = core_req;
+      a->atom_number = job_slot;
+      a->prio = BASE_JD_PRIO_MEDIUM;
+      if (wait_slot) {
+         a->pre_dep[0].atom_id = wait_slot;
+         a->pre_dep[0].dependency_type = BASE_JD_DEP_TYPE_ORDER;
+         a->pre_dep[1].dependency_type = BASE_JD_DEP_TYPE_INVALID;
+      } else {
+         a->pre_dep[0].dependency_type = BASE_JD_DEP_TYPE_INVALID;
+         a->pre_dep[1].dependency_type = BASE_JD_DEP_TYPE_INVALID;
+      }
+   }
+
+   {
+      struct base_jd_atom_v2 *a = &atoms[n_atoms++];
+      memset(a, 0, sizeof(*a));
+      a->jc = (uint64_t)(uintptr_t)&trig_fence;
+      a->core_req = BASE_JD_REQ_SOFT_FENCE_TRIGGER;
+      a->atom_number = trig_slot;
+      a->prio = BASE_JD_PRIO_MEDIUM;
+      a->pre_dep[0].atom_id = job_slot;
+      a->pre_dep[0].dependency_type = BASE_JD_DEP_TYPE_ORDER;
+   }
+
+   struct kbase_uk_job_submit js = {
+      .header.id = KBASE_FUNC_JOB_SUBMIT,
+      .addr.value = atoms,
+      .nr_atoms = n_atoms,
+      .stride = sizeof(struct base_jd_atom_v2),
+   };
+
+   ret = kbase_uk_call(dev->fd, &js, sizeof(js));
+   if (ret || js.header.ret) {
+      mesa_loge("kbase JOB_SUBMIT failed (ret=%d hdr=%u)", ret, js.header.ret);
+      if (ret == 0)
+         ret = -EPROTO;
+      pthread_mutex_lock(&kdev->lock);
+      for (unsigned i = 0; i < n_slots; i++)
+         kdev->atom_busy[slots[i]] = false;
+      pthread_cond_broadcast(&kdev->cond);
+      pthread_mutex_unlock(&kdev->lock);
+      if (in_fd >= 0)
+         close(in_fd);
+      if (trig_fence.basep.fd >= 0)
+         close(trig_fence.basep.fd);
+      return ret;
+   }
+
+   if (in_fd >= 0)
+      close(in_fd);
+
+   out_fd = trig_fence.basep.fd;
+   if (out_sync) {
+      kbase_sync_set_fd(&kdev->sync, out_sync, out_fd);
+   } else if (out_fd >= 0) {
+      close(out_fd);
+   }
+
+   return 0;
+}
+
+/* JM contexts do not exist in kbase: every fd is one context. */
+static int
+kbase_kmod_jm_ctx_create(struct pan_kmod_dev *dev, uint32_t *handle,
+                         uint16_t priority)
+{
+   (void)dev;
+   (void)priority;
+   *handle = 0;
+   return 0;
+}
+
+static void
+kbase_kmod_jm_ctx_destroy(struct pan_kmod_dev *dev, uint32_t handle)
+{
+   (void)dev;
+   (void)handle;
+}
+
+/* ------------------------------------------------------------------ */
+/* Unsupported optional features. */
+
+static uint64_t
+kbase_kmod_query_timestamp(const struct pan_kmod_dev *dev)
+{
+   (void)dev;
+   return 0;
+}
+
+static struct pan_kmod_perf_session *
+kbase_kmod_perf_create(struct pan_kmod_dev *dev)
+{
+   (void)dev;
+   return NULL;
+}
+
+static int
+kbase_kmod_perf_enable(struct pan_kmod_perf_session *session,
+                       const struct pan_kmod_perf_config *cfg)
+{
+   (void)session;
+   (void)cfg;
+   return -1;
+}
+
+static int
+kbase_kmod_perf_disable(struct pan_kmod_perf_session *session)
+{
+   (void)session;
+   return -1;
+}
+
+static void
+kbase_kmod_perf_dump(struct pan_kmod_perf_session *session,
+                     struct mali_perf_dump_info *info)
+{
+   (void)session;
+   (void)info;
+}
+
+static void
+kbase_kmod_perf_destroy(struct pan_kmod_perf_session *session)
+{
+   (void)session;
+}
+
+/* ------------------------------------------------------------------ */
+/* Backend entry points. */
+
+static void
+kbase_kmod_dev_destroy(struct pan_kmod_dev *dev)
+{
+   struct kbase_kmod_dev *kdev = kbase_dev(dev);
+
+   if (kdev->ev_thread_valid) {
+      char c = 1;
+      ssize_t ignored = write(kdev->stop_pipe[1], &c, 1);
+      (void)ignored;
+      pthread_join(kdev->ev_thread, NULL);
+   }
+   if (kdev->stop_pipe[0] >= 0) {
+      close(kdev->stop_pipe[0]);
+      close(kdev->stop_pipe[1]);
+   }
+
+   if (kdev->vm)
+      kbase_kmod_vm_destroy(kdev->vm);
+
+   if (kdev->tl_fd >= 0)
+      close(kdev->tl_fd);
+
+   /* Closes the fd when PAN_KMOD_DEV_FLAG_OWNS_FD is set and finalizes the
+    * sync provider.  The tracking page and every SAME_VA allocation are
+    * released by the kbase context teardown. */
+   pan_kmod_dev_cleanup(dev);
+
+   pthread_mutex_destroy(&kdev->sync.lock);
+   pthread_cond_destroy(&kdev->cond);
+   pthread_mutex_destroy(&kdev->lock);
+
+   pan_kmod_dev_free(dev, kdev);
+}
+
+static int
+kbase_kmod_stream_create(struct kbase_kmod_dev *kdev)
+{
+   struct kbase_uk_stream_create sc;
+
+   memset(&sc, 0, sizeof(sc));
+   sc.header.id = KBASE_FUNC_STREAM_CREATE;
+   snprintf(sc.name, sizeof(sc.name), "panfrost-kbase-%d", (int)getpid());
+   sc.fd = -1;
+
+   int ret = kbase_uk_call(kdev->base.fd, &sc, sizeof(sc));
+   if (ret || sc.header.ret || sc.fd < 0) {
+      mesa_loge("kbase STREAM_CREATE failed (ret=%d hdr=%u)", ret,
+                sc.header.ret);
+      return -1;
+   }
+
+   kdev->tl_fd = sc.fd;
+   return 0;
+}
+
+static struct pan_kmod_dev *
+kbase_kmod_dev_create(int fd, uint32_t flags,
+                      const struct pan_kmod_allocator *allocator)
+{
+   struct kbase_kmod_dev *kdev;
+   struct pan_kmod_dev_props *props;
+   struct {
+      union kbase_uk_header header;
+      struct kbase_gpu_props props;
+   } *msg;
+   int ret;
+
+   if (fd < 0)
+      return NULL;
+
+   /* Only kbase character devices are handled here.  DRM fds answer
+    * drmGetVersion(); refuse them before touching kbase handshake state. */
+   drmVersionPtr ver = drmGetVersion(fd);
+   if (ver) {
+      drmFreeVersion(ver);
+      return NULL;
+   }
+
+   kdev = pan_kmod_alloc(allocator, sizeof(*kdev));
+   if (!kdev)
+      return NULL;
+
+   memset(kdev, 0, sizeof(*kdev));
+   kdev->tl_fd = -1;
+   kdev->stop_pipe[0] = kdev->stop_pipe[1] = -1;
+   kdev->slot_timeout_ns = 10000000000ll; /* 10 s */
+   kdev->base.fd = fd;
+
+   pthread_mutex_init(&kdev->lock, NULL);
+   pthread_condattr_t attr;
+   pthread_condattr_init(&attr);
+   pthread_condattr_setclock(&attr, CLOCK_MONOTONIC);
+   pthread_cond_init(&kdev->cond, &attr);
+   pthread_condattr_destroy(&attr);
+
+   kbase_sync_provider_init(&kdev->sync, kdev);
+
+   props = pan_kmod_alloc(allocator, sizeof(*props));
+   msg = pan_kmod_alloc(allocator, sizeof(*msg));
+   if (!props || !msg)
+      goto err_free;
+
+   if (kbase_handshake(kdev) != 0) {
+      mesa_loge("kbase: handshake failed on fd %d", fd);
+      goto err_free;
+   }
+
+   memset(msg, 0, sizeof(*msg));
+   msg->header.id = KBASE_FUNC_GPU_PROPS_REG_DUMP;
+   ret = kbase_uk_call(fd, msg, sizeof(*msg));
+   if (ret || msg->header.ret) {
+      mesa_loge("kbase GPU_PROPS_REG_DUMP failed (ret=%d hdr=%u)", ret,
+                msg->header.ret);
+      goto err_free;
+   }
+
+   kbase_props_from_kernel(props, &msg->props);
+   pan_kmod_free(allocator, msg);
+   msg = NULL;
+
+   static const struct pan_kmod_driver drv_info = {
+      .version = {.major = 1, .minor = 0},
+   };
+
+   if (pan_kmod_dev_init(&kdev->base, fd, flags, &drv_info, allocator,
+                         &kbase_kmod_ops, &kdev->sync.base) != 0)
+      goto err_free;
+
+   kdev->base.props = *props;
+   pan_kmod_free(allocator, props);
+   props = NULL;
+
+   if (pipe(kdev->stop_pipe) != 0)
+      goto err_cleanup;
+   fcntl(kdev->stop_pipe[0], F_SETFD, FD_CLOEXEC);
+   fcntl(kdev->stop_pipe[1], F_SETFD, FD_CLOEXEC);
+   fcntl(kdev->stop_pipe[0], F_SETFL, O_NONBLOCK);
+   fcntl(kdev->stop_pipe[1], F_SETFL, O_NONBLOCK);
+
+   if (kbase_kmod_stream_create(kdev) != 0)
+      goto err_cleanup;
+
+   if (pthread_create(&kdev->ev_thread, NULL, kbase_event_thread, kdev) != 0)
+      goto err_cleanup;
+   kdev->ev_thread_valid = true;
+
+   return &kdev->base;
+
+err_cleanup:
+   /* Ownership of fd has not been transferred to the caller yet: keep it
+    * open so panfrost_open_device()'s error path can close it once. */
+   kdev->base.flags &= ~PAN_KMOD_DEV_FLAG_OWNS_FD;
+   kbase_kmod_dev_destroy(&kdev->base);
+   return NULL;
+
+err_free:
+   if (props)
+      pan_kmod_free(allocator, props);
+   if (msg)
+      pan_kmod_free(allocator, msg);
+   if (kdev->stop_pipe[0] >= 0)
+      close(kdev->stop_pipe[0]);
+   if (kdev->stop_pipe[1] >= 0)
+      close(kdev->stop_pipe[1]);
+   kbase_sync_finalize(&kdev->sync.base);
+   pthread_mutex_destroy(&kdev->sync.lock);
+   pthread_cond_destroy(&kdev->cond);
+   pthread_mutex_destroy(&kdev->lock);
+   pan_kmod_free(allocator, kdev);
+   return NULL;
+}
+
+const struct pan_kmod_ops kbase_kmod_ops = {
+   .dev_create = kbase_kmod_dev_create,
+   .dev_destroy = kbase_kmod_dev_destroy,
+   .dev_query_user_va_range = NULL,
+   .bo_alloc = kbase_kmod_bo_alloc,
+   .bo_free = kbase_kmod_bo_free,
+   .bo_import = kbase_kmod_bo_import,
+   .bo_export = kbase_kmod_bo_export,
+   .bo_mmap = kbase_kmod_bo_mmap,
+   .bo_wait = kbase_kmod_bo_wait,
+   .flush_bo_map_syncs = kbase_kmod_flush_bo_map_syncs,
+   .bo_make_evictable = NULL,
+   .bo_make_unevictable = NULL,
+   .vm_create = kbase_kmod_vm_create,
+   .vm_destroy = kbase_kmod_vm_destroy,
+   .vm_bind = kbase_kmod_vm_bind,
+   .query_timestamp = kbase_kmod_query_timestamp,
+   .bo_set_label = kbase_kmod_bo_set_label,
+   .perf_create = kbase_kmod_perf_create,
+   .perf_enable = kbase_kmod_perf_enable,
+   .perf_disable = kbase_kmod_perf_disable,
+   .perf_dump = kbase_kmod_perf_dump,
+   .perf_destroy = kbase_kmod_perf_destroy,
+   .submit_job = kbase_kmod_submit_job,
+   .jm_ctx_create = kbase_kmod_jm_ctx_create,
+   .jm_ctx_destroy = kbase_kmod_jm_ctx_destroy,
+};
diff --git a/src/panfrost/lib/kmod/kbase_kmod_test.c b/src/panfrost/lib/kmod/kbase_kmod_test.c
new file mode 100644
index 0000000..5b3edd5
--- /dev/null
+++ b/src/panfrost/lib/kmod/kbase_kmod_test.c
@@ -0,0 +1,120 @@
+/*
+ * Copyright © 2026 Nura userspace effort
+ * SPDX-License-Identifier: MIT
+ */
+
+/*
+ * Sanity test for the kbase pan_kmod backend, runnable without hardware.
+ *
+ *   - a non-kbase fd must be rejected (no crash, no kbase ioctl side effects);
+ *   - a DRM fd must be rejected by the kbase backend (and picked up by the
+ *     DRM backends when they are present);
+ *   - with /dev/mali0 present, the backend must create a device, expose
+ *     sensible T720 props and allow a BO round trip.
+ *
+ * Exit: 0 pass, 2 no /dev/mali0 (device checks skipped), 1 fail.
+ */
+
+#include <fcntl.h>
+#include <stdio.h>
+#include <string.h>
+#include <unistd.h>
+
+#include "kmod/pan_kmod.h"
+#include "pan_props.h"
+
+int
+main(void)
+{
+   int fails = 0;
+   int fd;
+
+   fd = open("/dev/null", O_RDWR);
+   if (fd < 0)
+      return 1;
+   struct pan_kmod_dev *dev = pan_kmod_dev_create(fd, 0, NULL);
+   if (dev) {
+      printf("FAIL: kbase backend accepted /dev/null\n");
+      pan_kmod_dev_destroy(dev);
+      fails++;
+   } else {
+      printf("ok: /dev/null rejected\n");
+   }
+   close(fd);
+
+   fd = open("/dev/dri/card0", O_RDWR);
+   if (fd >= 0) {
+      dev = pan_kmod_dev_create(fd, 0, NULL);
+      /* Either NULL (no DRM backend built) or a DRM device; never a kbase
+       * device. */
+      if (dev) {
+         printf("ok: /dev/dri/card0 handled by another backend\n");
+         pan_kmod_dev_destroy(dev);
+      } else {
+         printf("ok: /dev/dri/card0 rejected (no DRM backend configured)\n");
+         close(fd);
+      }
+   }
+
+   fd = open("/dev/mali0", O_RDWR);
+   if (fd < 0) {
+      printf("no /dev/mali0: kbase device checks skipped\n");
+      return fails ? 1 : 2;
+   }
+
+   dev = pan_kmod_dev_create(fd, PAN_KMOD_DEV_FLAG_OWNS_FD, NULL);
+   if (!dev) {
+      printf("FAIL: kbase device creation failed\n");
+      close(fd);
+      return 1;
+   }
+
+   printf("gpu_id=0x%llx arch=%u cores=%u va_bits=%u\n",
+          (unsigned long long)dev->props.gpu_id, pan_arch(dev->props.gpu_id),
+          pan_query_core_count(&dev->props),
+          (unsigned)(dev->props.mmu_features & 0xff));
+
+   struct pan_kmod_vm *vm = pan_kmod_vm_create(dev, PAN_KMOD_VM_FLAG_AUTO_VA,
+                                               0, 1ull << 39);
+   if (!vm) {
+      printf("FAIL: vm_create\n");
+      fails++;
+   }
+
+   struct pan_kmod_bo *bo =
+      pan_kmod_bo_alloc(dev, vm, 4096, 0);
+   if (!bo) {
+      printf("FAIL: bo_alloc\n");
+      fails++;
+   } else {
+      struct pan_kmod_vm_op op = {
+         .type = PAN_KMOD_VM_OP_TYPE_MAP,
+         .va = {.start = PAN_KMOD_VM_MAP_AUTO_VA, .size = bo->size},
+         .map = {.bo = bo, .bo_offset = 0},
+      };
+      if (pan_kmod_vm_bind(vm, PAN_KMOD_VM_OP_MODE_IMMEDIATE, &op, 1) != 0 ||
+          op.va.start == PAN_KMOD_VM_MAP_AUTO_VA) {
+         printf("FAIL: vm_bind\n");
+         fails++;
+      } else {
+         printf("ok: bo gpu_va=0x%llx size=%llu\n",
+                (unsigned long long)op.va.start,
+                (unsigned long long)bo->size);
+      }
+      void *cpu = pan_kmod_bo_mmap(bo, PROT_READ | PROT_WRITE, MAP_SHARED, NULL);
+      if (cpu == MAP_FAILED) {
+         printf("FAIL: bo_mmap\n");
+         fails++;
+      } else {
+         memset(cpu, 0x5a, 64);
+         printf("ok: bo cpu mapping usable\n");
+      }
+      pan_kmod_bo_put(bo);
+   }
+
+   if (vm)
+      pan_kmod_vm_destroy(vm);
+   pan_kmod_dev_destroy(dev);
+   printf("%s\n", fails ? "FAILED" : "kbase backend OK");
+   return fails ? 1 : 0;
+}
