+static int
+kbase_sync_transfer(struct util_sync_provider *p, uint32_t dst_handle,
+                    uint64_t dst_point, uint32_t src_handle,
+                    uint64_t src_point, uint32_t flags)
+{
+   struct kbase_sync_provider *s = sync_provider(p);
+   int fd;
+
+   (void)dst_point;
+   (void)src_point;
+   (void)flags;
+
+   if (dst_handle == 0 || src_handle == 0 ||
+       dst_handle >= KBASE_SYNC_SLOTS || src_handle >= KBASE_SYNC_SLOTS)
+      return -EINVAL;
+
+   pthread_mutex_lock(&s->lock);
+   fd = s->slots[src_handle].fd >= 0
+           ? fcntl(s->slots[src_handle].fd, F_DUPFD_CLOEXEC, 0)
+           : -1;
+   if (s->slots[dst_handle].fd >= 0)
+      close(s->slots[dst_handle].fd);
+   s->slots[dst_handle].fd = fd;
+   s->slots[dst_handle].signaled = s->slots[src_handle].signaled;
+   pthread_mutex_unlock(&s->lock);
+   return 0;
+}
