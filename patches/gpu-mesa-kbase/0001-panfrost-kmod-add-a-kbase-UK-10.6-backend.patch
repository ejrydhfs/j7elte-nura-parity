+/* ------------------------------------------------------------------ */
+/* Events and atom slots. */
+
+static void *
+kbase_event_thread(void *arg)
+{
+   struct kbase_kmod_dev *kdev = arg;
+   struct pollfd pfd[2] = {
+      {.fd = kdev->base.fd, .events = POLLIN},
+      {.fd = kdev->stop_pipe[0], .events = POLLIN},
+   };
+
+   for (;;) {
+      int r = poll(pfd, 2, -1);
+
+      if (r < 0) {
+         if (errno == EINTR)
+            continue;
+         break;
+      }
+      if (pfd[1].revents & POLLIN)
+         break;
+      if (!(pfd[0].revents & (POLLIN | POLLHUP | POLLERR)))
+         continue;
+
+      struct base_jd_event_v2 ev;
+      ssize_t n = read(kdev->base.fd, &ev, sizeof(ev));
+
+      if (n == 0)
+         break;
+      if (n < 0) {
+         if (errno == EINTR)
+            continue;
+         break;
+      }
+      if (n != (ssize_t)sizeof(ev))
+         continue;
+
+      if (ev.atom_number < KBASE_MAX_ATOMS) {
+         pthread_mutex_lock(&kdev->lock);
+         kdev->last_event[ev.atom_number] = ev.event_code;
+         kdev->atom_busy[ev.atom_number] = false;
+         pthread_cond_broadcast(&kdev->cond);
+         pthread_mutex_unlock(&kdev->lock);
+      }
+   }
+   return NULL;
+}
+
+/* Must be called with kdev->lock held. */
+static int
+kbase_alloc_slots_locked(struct kbase_kmod_dev *kdev, unsigned count,
+                         uint8_t *slots, int64_t deadline)
+{
+   unsigned found = 0;
+
+   while (found < count) {
+      for (unsigned i = 1; i < KBASE_MAX_ATOMS && found < count; i++) {
+         if (!kdev->atom_busy[i]) {
+            kdev->atom_busy[i] = true;
+            slots[found++] = (uint8_t)i;
+         }
+      }
+      if (found == count)
+         return 0;
+
+      for (unsigned k = 0; k < found; k++)
+         kdev->atom_busy[slots[k]] = false;
+      found = 0;
+
+      if (deadline < 0) {
+         pthread_cond_wait(&kdev->cond, &kdev->lock);
+      } else {
+         struct timespec ts;
+         kbase_deadline_to_ts(deadline, &ts);
+         if (pthread_cond_timedwait(&kdev->cond, &kdev->lock, &ts) ==
+             ETIMEDOUT)
+            return -ETIME;
+      }
+   }
+   return 0;
+}
+
+/* ------------------------------------------------------------------ */
+/* BO management. */
+
+static uint64_t
+kbase_mem_flags(uint32_t kmod_flags)
+{
+   uint64_t flags = BASE_MEM_PROT_CPU_RD | BASE_MEM_PROT_CPU_WR |
+                    BASE_MEM_PROT_GPU_RD | BASE_MEM_PROT_GPU_WR |
+                    BASE_MEM_CACHED_CPU | BASE_MEM_COHERENT_SYSTEM;
+
+   if (kmod_flags & PAN_KMOD_BO_FLAG_EXECUTABLE) {
+      /* kbase_check_alloc_flags() rejects GPU_EX together with GPU_WR. */
+      flags &= ~BASE_MEM_PROT_GPU_WR;
+      flags |= BASE_MEM_PROT_GPU_EX;
+   }
+   if (kmod_flags & PAN_KMOD_BO_FLAG_ALLOC_ON_FAULT)
+      flags |= BASE_MEM_GROW_ON_GPF;
+
+   return flags;
+}
+
+static struct pan_kmod_bo *
+kbase_kmod_bo_alloc(struct pan_kmod_dev *dev, struct pan_kmod_vm *exclusive_vm,
+                    uint64_t size, uint32_t flags)
+{
+   struct kbase_kmod_dev *kdev = kbase_dev(dev);
+   struct kbase_kmod_bo *bo;
+   struct kbase_uk_mem_alloc alloc;
+   uint64_t pages, mem_flags;
+   void *cpu;
+   int ret;
+
+   if (!size)
+      return NULL;
+
+   pages = (size + KBASE_PAGE_SIZE - 1) / KBASE_PAGE_SIZE;
+   mem_flags = kbase_mem_flags(flags);
+
+   memset(&alloc, 0, sizeof(alloc));
+   alloc.header.id = KBASE_FUNC_MEM_ALLOC;
+   alloc.va_pages = pages;
+   /* Growable (tiler heap) memory commits one page up front and faults the
+    * rest in; kbase MEM_ALLOC would otherwise back the whole 128 MiB. */
+   alloc.commit_pages = (mem_flags & BASE_MEM_GROW_ON_GPF) ? 1 : pages;
+   alloc.extent = 0;
+   alloc.flags = mem_flags;
+
+   ret = kbase_uk_call(dev->fd, &alloc, sizeof(alloc));
+   if (ret || alloc.header.ret) {
+      mesa_loge("kbase MEM_ALLOC failed (ret=%d, hdr=%u)", ret,
+                alloc.header.ret);
+      return NULL;
+   }
+
+   /* 64-bit clients always get BASE_MEM_SAME_VA: the GPU VA is assigned by
+    * kbasep_reg_mmap() and equals the CPU mapping address.  Every kbase BO
+    * therefore has to be mapped here, even the "invisible" ones. */
+   cpu = mmap(NULL, pages * KBASE_PAGE_SIZE, PROT_READ | PROT_WRITE,
+              MAP_SHARED, dev->fd, (off_t)alloc.gpu_va);
+   if (cpu == MAP_FAILED) {
+      mesa_loge("kbase BO mmap failed: %s", strerror(errno));
+      struct kbase_uk_mem_free f = {
+         .header.id = KBASE_FUNC_MEM_FREE,
+         .gpu_addr = alloc.gpu_va,
+      };
+      kbase_uk_call(dev->fd, &f, sizeof(f));
+      return NULL;
+   }
+
+   bo = pan_kmod_dev_alloc(dev, sizeof(*bo));
+   if (!bo) {
+      munmap(cpu, pages * KBASE_PAGE_SIZE);
+      return NULL;
+   }
+
+   pthread_mutex_lock(&kdev->lock);
+   uint32_t handle = ++kdev->next_bo_handle;
+   pthread_mutex_unlock(&kdev->lock);
+
+   pan_kmod_bo_init(&bo->base, dev, exclusive_vm, pages * KBASE_PAGE_SIZE,
+                    flags, handle);
+   bo->cpu = cpu;
+   bo->gpu_va = (uint64_t)(uintptr_t)cpu;
+   bo->size = pages * KBASE_PAGE_SIZE;
+   bo->mk_flags = alloc.flags;
+
+   return &bo->base;
+}
+
+static void
+kbase_kmod_bo_free(struct pan_kmod_bo *bo)
+{
+   struct kbase_kmod_bo *kbo = container_of(bo, struct kbase_kmod_bo, base);
+
+   if (kbo->cpu)
+      munmap(kbo->cpu, kbo->size);
+
+   pan_kmod_dev_free(bo->dev, kbo);
+}
+
+static void *
+kbase_kmod_bo_mmap(struct pan_kmod_bo *bo, int prot, int flags,
+                   void *host_addr)
+{
+   struct kbase_kmod_bo *kbo = container_of(bo, struct kbase_kmod_bo, base);
+
+   (void)prot;
+   (void)flags;
+   (void)host_addr;
+
+   /* Already mapped at allocation time: SAME_VA fixes the GPU address to
+    * the mmap address, so the mapping cannot be created lazily. */
+   return kbo->cpu;
+}
