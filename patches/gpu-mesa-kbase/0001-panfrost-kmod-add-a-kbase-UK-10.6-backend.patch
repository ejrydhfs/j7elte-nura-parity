+static void
+kbase_sync_finalize(struct util_sync_provider *p)
+{
+   struct kbase_sync_provider *s = sync_provider(p);
+
+   pthread_mutex_lock(&s->lock);
+   for (unsigned i = 0; i < KBASE_SYNC_SLOTS; i++) {
+      if (s->slots[i].fd >= 0)
+         close(s->slots[i].fd);
+      s->slots[i].fd = -1;
+      s->slots[i].in_use = false;
+   }
+   pthread_mutex_unlock(&s->lock);
+}
