+/* Install a fresh kbase fence fd into a sync slot (out-fence of a submit). */
+static void
+kbase_sync_set_fd(struct kbase_sync_provider *s, uint32_t handle, int fd)
+{
+   if (handle == 0 || handle >= KBASE_SYNC_SLOTS) {
+      if (fd >= 0)
+         close(fd);
+      return;
+   }
+
+   pthread_mutex_lock(&s->lock);
+   if (s->slots[handle].fd >= 0)
+      close(s->slots[handle].fd);
+   s->slots[handle].fd = fd;
+   s->slots[handle].signaled = false;
+   pthread_mutex_unlock(&s->lock);
+}
+
+static int
+kbase_sync_get_fd_dup(struct kbase_sync_provider *s, uint32_t handle)
+{
+   int fd = -1;
+
+   if (handle == 0 || handle >= KBASE_SYNC_SLOTS)
+      return -1;
+   pthread_mutex_lock(&s->lock);
+   if (s->slots[handle].fd >= 0)
+      fd = fcntl(s->slots[handle].fd, F_DUPFD_CLOEXEC, 0);
+   pthread_mutex_unlock(&s->lock);
+   return fd;
+}
