+sha512sums="
+79652524d1ddeb823794df70190f458b9b9c122831c88713afc0b0d0b5880a85d9bf9f86c1ae68a8d74779777c23ec3e48b3c91078a33b7e0a47979e465a76db  wpa_supplicant.conf
+1ef40be14502b37e8f82a720acf5396677ca13c10095cf130f6390f28e17da7d69a1d8029feb91a1a13357ac5764d42b429d9f361289b849b11f768ecb63a326  j7elte-wifi.initd
+a0abe483dbdede54a47ccb83517fa228a248343b4baa80f0aaf53e78ea307d8d6630962388ad00cbea13daaa58f200b10687d616bece7d3e277ec6b3ecebad37  j7elte-wifi.confd
+c58cf2e39856e84c54ed31a26290c1e8be6cd04f0016593618076343b3ce0d6c297bf13adfd61d30606308c55977fdc338c06a1ab2fad987188cc561d29a579a  j7elte-wifi.tmpfiles
+d04efd4e21d29897a5879d2a56c1c66f2f315e67421a88ceed4da09ff3e803acc960515cd6b1c6f080cb62ff105377c5d5f3589386faf2b7f6a45ce316d22714  j7elte-wifi.post-install
