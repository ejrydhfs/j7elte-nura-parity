+# systemd-tmpfiles equivalent of the j7elte-wifi OpenRC service: make sure
+# bcmdhd can persist its generated per-device MAC (/efs/wifi/.mac.info).
+d /efs/wifi 0755 root root -
diff --git a/device/archived/j7elte-wifi/wpa_supplicant.conf b/device/archived/j7elte-wifi/wpa_supplicant.conf
new file mode 100644
index 0000000..bc201b1
--- /dev/null
+++ b/device/archived/j7elte-wifi/wpa_supplicant.conf
@@ -0,0 +1,27 @@
+# wpa_supplicant configuration -- Samsung Galaxy J7 (j7elte)
+#
+# Installed by j7elte-wifi.  No network is configured on purpose.
+#
+# The kernel's built-in bcmdhd driver registers "wlan0" (cfg80211 with both
+# nl80211 and WEXT support), so wpa_supplicant's default nl80211 driver is
+# used.  The regulatory domain comes from the Wi-Fi NVRAM blob
+# (/lib/firmware/postmarketos/samsung-j7elte/nvram_net.txt, ccode=GB); do not
+# force one here.
+#
+# To add a network without editing this file:
+#   wpa_passphrase "SSID" "passphrase" >> /etc/wpa_supplicant/wpa_supplicant.conf
+#   rc-service wpa_supplicant restart
+#
+# On images using NetworkManager (the postmarketOS default) this file is not
+# read; NetworkManager runs its own wpa_supplicant instance over D-Bus.
+
+ctrl_interface=/run/wpa_supplicant
+ctrl_interface_group=0
+update_config=1
+ap_scan=1
+
+# Example (disabled):
+#network={
+#	ssid="example"
+#	psk="secret"
+#}
