diff --git a/device/archived/j7elte-wifi/j7elte-wifi.confd b/device/archived/j7elte-wifi/j7elte-wifi.confd
new file mode 100644
index 0000000..723a15b
--- /dev/null
+++ b/device/archived/j7elte-wifi/j7elte-wifi.confd
@@ -0,0 +1,6 @@
+# /etc/conf.d/j7elte-wifi
+#
+# Directory the built-in bcmdhd driver writes its generated per-device MAC to
+# (/efs/wifi/.mac.info).  Override only if /efs is mounted read-only or a real
+# EFS partition is available elsewhere.
+J7ELTE_WIFI_MAC_STATE_DIR=/efs/wifi
diff --git a/device/archived/j7elte-wifi/j7elte-wifi.initd b/device/archived/j7elte-wifi/j7elte-wifi.initd
new file mode 100755
index 0000000..0d81473
--- /dev/null
+++ b/device/archived/j7elte-wifi/j7elte-wifi.initd
@@ -0,0 +1,48 @@
+#!/sbin/openrc-run
+# Provision the directory that bcmdhd uses to persist a per-device MAC.
+#
+# With CONFIG_WIFI_BROADCOM_COB=y the driver compiles READ_MACADDR and calls
+# dhd_set_macaddr_from_file() (drivers/net/wireless/bcmdhd_1_77_nn/
+# dhd_custom_cis.c) before it preinitialises the dongle.  The file is
+# /efs/wifi/.mac.info; when it is missing the driver generates a MAC and
+# writes it back, but if the directory does not exist the write fails and the
+# shared NVRAM MAC (00:90:4c:c5:12:38) is used on every device.
+#
+# This service only creates the directory.  It never writes a MAC itself and
+# does nothing when a real EFS partition is mounted on /efs.
+
+# shellcheck disable=SC2034  # read by openrc-run
+description="bcmdhd per-device MAC state directory (j7elte)"
+# shellcheck disable=SC2034
+description_check="Check the bcmdhd MAC state directory"
+
+: "${J7ELTE_WIFI_MAC_STATE_DIR:=/efs/wifi}"
+
+depend() {
+	need localmount
+	before wpa_supplicant networkmanager
+}
+
+start() {
+	ebegin "Preparing ${J7ELTE_WIFI_MAC_STATE_DIR}"
+
+	if grep -q ' /efs ' /proc/mounts; then
+		ewarn "/efs is a mount point (real EFS?); not touching ${J7ELTE_WIFI_MAC_STATE_DIR}"
+		eend 0
+		return 0
+	fi
+
+	if [ -d "${J7ELTE_WIFI_MAC_STATE_DIR}" ]; then
+		eend 0
+		return 0
+	fi
+
+	mkdir -p "${J7ELTE_WIFI_MAC_STATE_DIR}"
+	ret=$?
+	if [ ${ret} -eq 0 ]; then
+		chmod 0755 "${J7ELTE_WIFI_MAC_STATE_DIR}"
+		eend 0
+	else
+		eend 1 "Failed to create ${J7ELTE_WIFI_MAC_STATE_DIR}"
+	fi
+}
diff --git a/device/archived/j7elte-wifi/j7elte-wifi.post-install b/device/archived/j7elte-wifi/j7elte-wifi.post-install
new file mode 100755
index 0000000..8f81577
--- /dev/null
+++ b/device/archived/j7elte-wifi/j7elte-wifi.post-install
@@ -0,0 +1,16 @@
+#!/bin/sh
+
+post_install() {
+	# bcmdhd needs the directory before it can persist a generated MAC.
+	mkdir -p /efs/wifi 2>/dev/null || true
+
+	if [ -d /etc/runlevels ] && command -v rc-update >/dev/null 2>&1; then
+		rc-update add j7elte-wifi default >/dev/null 2>&1 || true
+	fi
+}
+
+pre_deinstall() {
+	if [ -d /etc/runlevels ] && command -v rc-update >/dev/null 2>&1; then
+		rc-update del j7elte-wifi default >/dev/null 2>&1 || true
+	fi
+}
