diff --git a/device/archived/j7elte-wifi/APKBUILD b/device/archived/j7elte-wifi/APKBUILD
new file mode 100644
index 0000000..6363732
--- /dev/null
+++ b/device/archived/j7elte-wifi/APKBUILD
@@ -0,0 +1,51 @@
+# Maintainer: ROM/Nura parity integration (SM-J700M / j7elte)
+#
+# Configuration-only package: the bcmdhd driver is built into
+# linux-samsung-j7elte (CONFIG_BCM4343=y) and registers wlan0 itself.  This
+# package provides the wpa_supplicant template and the /efs/wifi directory the
+# driver uses to persist a generated per-device MAC.
+pkgname=j7elte-wifi
+pkgver=0.1
+pkgrel=0
+pkgdesc="Wi-Fi userspace configuration for the built-in bcmdhd driver (Samsung Galaxy J7)"
+url="https://postmarketos.org"
+arch="noarch"
+license="MIT"
+options="!check"
+depends="wpa_supplicant"
+install="$pkgname.post-install"
+source="wpa_supplicant.conf
+	j7elte-wifi.initd
+	j7elte-wifi.confd
+	j7elte-wifi.tmpfiles
+	j7elte-wifi.post-install
+	"
+builddir="$srcdir"
+
+package() {
+	install -Dm644 "$srcdir"/wpa_supplicant.conf \
+		"$pkgdir"/etc/wpa_supplicant/wpa_supplicant.conf
+
+	# OpenRC: provision /efs/wifi before anything brings wlan0 up.
+	install -Dm755 "$srcdir"/j7elte-wifi.initd \
+		"$pkgdir"/etc/init.d/j7elte-wifi
+	install -Dm644 "$srcdir"/j7elte-wifi.confd \
+		"$pkgdir"/etc/conf.d/j7elte-wifi
+
+	# systemd: same directory, via systemd-tmpfiles.
+	install -Dm644 "$srcdir"/j7elte-wifi.tmpfiles \
+		"$pkgdir"/usr/lib/tmpfiles.d/j7elte-wifi.conf
+
+	# bcmdhd writes /efs/wifi/.mac.info with O_CREAT; the parent directory
+	# must exist or the generated MAC is discarded and the shared NVRAM MAC
+	# is used (dhd_custom_cis.c:dhd_set_macaddr_from_file).
+	install -d -m 0755 "$pkgdir"/efs/wifi
+}
