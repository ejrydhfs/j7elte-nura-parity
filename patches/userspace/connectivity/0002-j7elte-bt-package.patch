@@ -0,0 +1,50 @@
+# Maintainer: ROM/Nura parity integration (SM-J700M / j7elte)
+#
+# Userspace bring-up for the BCM43438 Bluetooth controller on UART 3
+# (/dev/ttySAC3).  The kernel has CONFIG_BT_HCIUART(_H4)=y but no hci_bcm /
+# btbcm driver, so hciattach must download the patch RAM.  After a power cycle
+# the controller reports the local name BCM43430A1, so hciattach looks for
+# BCM43430A1*.hcd; firmware-samsung-j7elte installs
+# /lib/firmware/postmarketos/samsung-j7elte/BCM43430A1.hcd.
+pkgname=j7elte-bt
+pkgver=0.1
+pkgrel=1
+pkgdesc="BCM43438 Bluetooth UART attach (hciattach) for the Samsung Galaxy J7"
+url="https://postmarketos.org"
+arch="noarch"
+license="MIT"
+options="!check"
+# bluez-openrc supplies /etc/init.d/bluetooth, which this service starts after
+# the HCI transport is attached.  hciattach, hcitool and hciconfig ship in
+# bluez-deprecated; /usr/sbin/rfkill is in util-linux-misc.
+depends="bluez bluez-deprecated bluez-openrc util-linux-misc"
+install="$pkgname.post-install"
+source="j7elte-bt.initd
+	j7elte-bt.confd
+	j7elte-bt.service
+	j7elte-bt-addr
+	j7elte-bt.post-install
+	"
+builddir="$srcdir"
+
+package() {
+	install -Dm755 "$srcdir"/j7elte-bt.initd \
+		"$pkgdir"/etc/init.d/j7elte-bt
+	install -Dm644 "$srcdir"/j7elte-bt.confd \
+		"$pkgdir"/etc/conf.d/j7elte-bt
+	install -Dm755 "$srcdir"/j7elte-bt-addr \
+		"$pkgdir"/usr/libexec/j7elte-bt-addr
+
+	# Optional systemd equivalent; on OpenRC images the init script above is
+	# used.  Both read /etc/conf.d/j7elte-bt.
+	install -Dm644 "$srcdir"/j7elte-bt.service \
+		"$pkgdir"/usr/lib/systemd/system/j7elte-bt.service
+}
+
+sha512sums="
+1fc268d52e15e99517a2bfa1a0a5e4a20e32c5ecdfdce8cfe17b560421027eadea5ec20a55a93555a8da69e275d6977a7d3c15ab09ef1629193510accd7bc518  j7elte-bt.initd
+1d9ccebe95a23982f753008f569a2442ba6a060352d2630bad14a919ea5901c7d327d68affcb136614d98e1467b6dd39ee1de60581c7eb8677456b48cdc45ac0  j7elte-bt.confd
+f62f6a03e12fd3a8bf8409a60aedd7d21980d2a6f784ee3e1e84767f3df057b37ce5d1fb6298d2a84e6d007a956a09bf16eb772a58094448d813e4eb05b97c16  j7elte-bt.service
+4aa9a84bfc41498089b76d32c5a889c1bc51cbdb4c80d5666c83ce2478433d09a9fda3121f556ad9b35caa0ba980580367ff5d392d223f20de607ecb3318dd15  j7elte-bt-addr
+f386625ea6cf9ef49b7a3ef23e5fe268b504ce3f1a8b1a8e30c5a180d081c0233a16f6cbc043a9ae66aacb5cce836e364c26a2bf2ee62d41c2065aedef68df2f  j7elte-bt.post-install
+"
diff --git a/device/archived/j7elte-bt/j7elte-bt-addr b/device/archived/j7elte-bt/j7elte-bt-addr
new file mode 100755
index 0000000..632d1a5
--- /dev/null
+++ b/device/archived/j7elte-bt/j7elte-bt-addr
@@ -0,0 +1,73 @@
+#!/bin/sh
+# Program the Broadcom controller's public BD_ADDR from EFS (j7elte).
+#
+# The BCM43430A1 powers up with its factory address (43:43:A1:12:1F:AC on this
+# unit).  The stock ROM reads /efs/bluetooth/bt_addr and writes it back with
+# Broadcom's vendor Write_BD_ADDR command (OGF 0x3F, OCF 0x0001) before
+# starting its Bluetooth stack, and BlueZ needs the same: bluetoothd caches the
+# controller address when it powers the adapter on.
+#
+# Write_BD_ADDR takes the address little-endian, i.e. the "AA:BB:CC:DD:EE:FF"
+# string from EFS must be sent as 0xFF 0xEE 0xDD 0xCC 0xBB 0xAA.  After the
+# write the HCI device is reset so the kernel re-reads the address from the
+# controller; the write lives in controller RAM until the next power cycle.
+#
+# Usage: j7elte-bt-addr [address-file]
+
+set -u
+
+ADDR_FILE="${1:-/efs/bluetooth/bt_addr}"
+HCI="${HCI:-hci0}"
+HCICONFIG="${HCICONFIG:-$(command -v hciconfig 2>/dev/null)}"
+[ -n "${HCICONFIG}" ] || HCICONFIG=/usr/sbin/hciconfig
+HCITOOL="${HCITOOL:-$(command -v hcitool 2>/dev/null)}"
+[ -n "${HCITOOL}" ] || HCITOOL=/usr/sbin/hcitool
+
+log() {
+	echo "j7elte-bt-addr: $*" >&2
+}
+
+valid_octet() {
+	case "$1" in
+	[0-9A-Fa-f]|[0-9A-Fa-f][0-9A-Fa-f]) return 0 ;;
+	esac
+	return 1
+}
+
+[ -r "${ADDR_FILE}" ] || { log "${ADDR_FILE} is not readable"; exit 1; }
+
+IFS=: read -r b1 b2 b3 b4 b5 b6 _rest < "${ADDR_FILE}" || true
+for b in "${b1:-}" "${b2:-}" "${b3:-}" "${b4:-}" "${b5:-}" "${b6:-}"; do
+	if ! valid_octet "${b}"; then
+		log "${ADDR_FILE} does not contain a valid BD_ADDR"
+		exit 1
+	fi
+done
+
+[ -e "/sys/class/bluetooth/${HCI}" ] || { log "${HCI} does not exist"; exit 1; }
+
+# hcitool needs the device up before it will accept a raw HCI command.
+"${HCICONFIG}" "${HCI}" up || { log "cannot bring ${HCI} up"; exit 1; }
+i=0
+while [ "${i}" -lt 10 ]; do
+	"${HCICONFIG}" "${HCI}" 2>/dev/null | grep -q "UP RUNNING" && break
+	sleep 1
+	i=$((i + 1))
+done
+
+"${HCITOOL}" cmd 0x3f 0x0001 \
+	"0x${b6}" "0x${b5}" "0x${b4}" "0x${b3}" "0x${b2}" "0x${b1}" >/dev/null \
+	|| { log "Write_BD_ADDR vendor command failed"; exit 1; }
+
+"${HCICONFIG}" "${HCI}" reset || { log "${HCI} reset failed"; exit 1; }
+sleep 1
+
+got=$("${HCICONFIG}" "${HCI}" 2>/dev/null | sed -n 's/.*BD Address: *\([0-9A-Fa-f:]*\).*/\1/p')
+want="${b1}:${b2}:${b3}:${b4}:${b5}:${b6}"
+if [ "$(echo "${got}" | tr 'a-f' 'A-F')" != "$(echo "${want}" | tr 'a-f' 'A-F')" ]; then
+	log "address mismatch after reset: ${got:-none} (wanted ${want})"
+	exit 1
+fi
+
+log "public address ${got}"
+exit 0
diff --git a/device/archived/j7elte-bt/j7elte-bt.confd b/device/archived/j7elte-bt/j7elte-bt.confd
new file mode 100644
index 0000000..2f5bad4
--- /dev/null
+++ b/device/archived/j7elte-bt/j7elte-bt.confd
@@ -0,0 +1,37 @@
+# /etc/conf.d/j7elte-bt
+#
+# Parameters for the BCM43438 HCI attach on the Samsung Galaxy J7 (j7elte).
+# This file is read by both the OpenRC service and the systemd unit.
+
+# UART that carries HCI: kernel BT_UPORT 3, DT alias uart3 = serial_3.
+J7ELTE_BT_UART=/dev/ttySAC3
+
+# hciattach backend.  bcm43xx downloads the BCM43438 patch RAM; there is no
+# hci_bcm/btbcm driver in this 3.10 kernel, so do not use plain btattach.
+J7ELTE_BT_TYPE=bcm43xx
+
+# Line speed used while resetting the controller.
+J7ELTE_BT_INIT_SPEED=115200
+
+# Operating line speed after the patch RAM has been downloaded.  115200 is the
+# safe default; BCM43438 supports 3000000 once hci0 comes up reliably.
+J7ELTE_BT_SPEED=115200
+
+# Hardware flow control: flow or noflow.
+J7ELTE_BT_FLOW=flow
+
+# hciattach initialisation timeout in seconds.
+J7ELTE_BT_TIMEOUT=30
+
+# OpenRC service only: attach attempts and pause between them.
+J7ELTE_BT_RETRIES=3
+J7ELTE_BT_RETRY_DELAY=1
+
+# Local name the controller reports after a power cycle.  hciattach looks for
+# <name>*.hcd under /lib/firmware; firmware-samsung-j7elte installs
+# BCM43430A1.hcd.
+J7ELTE_BT_CHIP_NAME=BCM43430A1
+
+# EFS file with the factory public address; programmed with Broadcom's
+# Write_BD_ADDR vendor command before bluetoothd starts.
+J7ELTE_BT_ADDR_FILE=/efs/bluetooth/bt_addr
diff --git a/device/archived/j7elte-bt/j7elte-bt.initd b/device/archived/j7elte-bt/j7elte-bt.initd
new file mode 100755
index 0000000..682625b
--- /dev/null
+++ b/device/archived/j7elte-bt/j7elte-bt.initd
@@ -0,0 +1,209 @@
+#!/sbin/openrc-run
+# Attach the Broadcom BCM43438 Bluetooth controller on the j7elte.
+#
+# The controller sits on UART port 3 (BT_UPORT 3 in
+# drivers/bluetooth/bcm43xx.c; DT alias uart3 = serial_3), i.e. /dev/ttySAC3,
+# and is a plain H4 device: patch RAM must be downloaded by userspace.  On
+# Linux 3.10 there is no hci_bcm/btbcm driver, so btattach alone is not enough
+# -- hciattach's bcm43xx backend resets the chip, matches the firmware by the
+# controller's local name and downloads it.
+#
+# Two hardware quirks drive the ordering below:
+#
+#  * After a fresh power-up the controller reports the local name
+#    "BCM43430A1" and hciattach finds BCM43430A1.hcd.  Once bluetoothd has
+#    run, it writes the host name ("Samsung Galaxy J7") into the controller and
+#    that name survives an HCI Reset, so a later attach would look for
+#    "Samsung Galax*.hcd" and silently skip the patch RAM download.  Toggling
+#    the rfkill switch power-cycles the chip (BT_EN) and restores the default
+#    name, making the firmware lookup deterministic.
+#  * The chip powers up with a factory-default public address
+#    (43:43:A1:...); the stock ROM programs the EFS address with Broadcom's
+#    Write_BD_ADDR vendor command before starting its Bluetooth stack.  That is
+#    what j7elte-bt-addr does.
+#
+# The platform driver registers its rfkill switch soft-blocked
+# (rfkill_init_sw_state(..., 0) followed by rfkill_set_sw_state(..., true) in
+# bcm43xx.c), and only unblocking it drives BT_EN high.  So the order is:
+#   stop bluetoothd -> rfkill power-cycle -> hciattach -> set BD_ADDR
+#   -> bluetoothd
+#
+# Firmware (firmware-samsung-j7elte) installs the blob as
+# /lib/firmware/postmarketos/samsung-j7elte/BCM43430A1.hcd; Alpine's hciattach
+# searches /lib/firmware recursively for "<local name>*.hcd" (bluez patch 004).
+#
+# This service is enabled in the default runlevel by its package, unless
+# /etc/j7elte-bt.disabled exists.  To disable permanently:
+#   touch /etc/j7elte-bt.disabled && rc-service j7elte-bt stop
+#   rc-update del j7elte-bt default
+
+# shellcheck disable=SC2034  # read by openrc-run
+description="Broadcom BCM43438 Bluetooth HCI attach (j7elte)"
+# shellcheck disable=SC2034
+description_stop="Detach the BCM43438 Bluetooth HCI transport (j7elte)"
+
+: "${J7ELTE_BT_UART:=/dev/ttySAC3}"
+: "${J7ELTE_BT_TYPE:=bcm43xx}"
+: "${J7ELTE_BT_INIT_SPEED:=115200}"
+: "${J7ELTE_BT_SPEED:=115200}"
+: "${J7ELTE_BT_FLOW:=flow}"
+: "${J7ELTE_BT_TIMEOUT:=30}"
+: "${J7ELTE_BT_RETRIES:=3}"
+: "${J7ELTE_BT_RETRY_DELAY:=1}"
+: "${J7ELTE_BT_CHIP_NAME:=BCM43430A1}"
+: "${J7ELTE_BT_ADDR_FILE:=/efs/bluetooth/bt_addr}"
+
+HCIATTACH="${HCIATTACH:-$(command -v hciattach 2>/dev/null)}"
+[ -n "${HCIATTACH}" ] || HCIATTACH=/usr/sbin/hciattach
+RFKILL="${RFKILL:-$(command -v rfkill 2>/dev/null)}"
+[ -n "${RFKILL}" ] || RFKILL=/usr/sbin/rfkill
+ADDR_HELPER="${ADDR_HELPER:-/usr/libexec/j7elte-bt-addr}"
+PIDFILE=/run/j7elte-bt.pid
+LOCKFILE=/etc/j7elte-bt.disabled
+# hciattach prints the attach/firmware progress on stdout/stderr; keep it so
+# the patch-RAM download is visible in the field.
+BTLOG=/var/log/j7elte-bt.log
+BTERR=/var/log/j7elte-bt.err
+
+depend() {
+	need localmount
+	after udev-settle coldplug
+	# NOTE: do not declare "before bluetooth".  bluetoothd must be stopped
+	# while the transport is recreated, and this script starts it again at the
+	# end; with "before bluetooth" OpenRC would make that start wait for this
+	# service to finish starting (deadlock until the dependency timeout).
+}
+
+# hciattach runs with -n so the attach process stays in the foreground and can
+# be supervised; hci0 only exists while that process holds the N_HCI line
+# discipline.
+_attach_ok() {
+	[ -e /sys/class/bluetooth/hci0 ] || return 1
+	[ -s "${PIDFILE}" ] || return 1
+	kill -0 "$(cat "${PIDFILE}")" 2>/dev/null
+}
+
+_stop_attach() {
+	if [ -s "${PIDFILE}" ]; then
+		start-stop-daemon --stop --quiet --pidfile "${PIDFILE}" \
+			--retry TERM/5/KILL/5
+		rm -f "${PIDFILE}"
+	fi
+	return 0
+}
+
+_bluetoothctl_started() {
+	rc-service bluetooth status >/dev/null 2>&1
+}
+
+start() {
+	if [ -e "${LOCKFILE}" ]; then
+		ewarn "j7elte-bt disabled by ${LOCKFILE}; not attaching"
+		return 0
+	fi
+
+	if [ ! -x "${HCIATTACH}" ]; then
+		eerror "${HCIATTACH} not found (install bluez-deprecated)"
+		return 1
+	fi
+
+	if [ ! -c "${J7ELTE_BT_UART}" ]; then
+		eerror "${J7ELTE_BT_UART} not found; is CONFIG_SERIAL_SAMSUNG UART 3 enabled?"
+		return 1
+	fi
+
+	if ! command -v find >/dev/null 2>&1 || \
+	   ! find /lib/firmware -type f -name "${J7ELTE_BT_CHIP_NAME}*.hcd" \
+		-print -quit 2>/dev/null | grep -q .; then
+		ewarn "no ${J7ELTE_BT_CHIP_NAME}*.hcd under /lib/firmware;"
+		ewarn "hciattach will attach without patch RAM (install firmware-samsung-j7elte)"
+	fi
+
+	# bluetoothd caches the controller address and sets the local name, so it
+	# must not be running while the transport is (re)created.
+	if _bluetoothctl_started; then
+		ebegin "Stopping bluetoothd for the transport reset"
+		rc-service bluetooth stop
+		eend $?
+	fi
+
+	_stop_attach
+
+	# Power-cycle the controller so it reports its default local name and the
+	# patch RAM lookup is deterministic (see the comment at the top).
+	ebegin "Power-cycling the Bluetooth controller"
+	if ! "${RFKILL}" block bluetooth; then
+		eend 1 "rfkill block bluetooth failed; did bcm43xx probe?"
+		return 1
+	fi
+	sleep 1
+	if ! "${RFKILL}" unblock bluetooth; then
+		eend 1 "rfkill unblock bluetooth failed; did bcm43xx probe?"
+		return 1
+	fi
+	sleep 1
+	eend 0
+
+	attempt=1
+	waited=0
+	while [ "${attempt}" -le "${J7ELTE_BT_RETRIES}" ]; do
+		ebegin "Attaching ${J7ELTE_BT_TYPE} on ${J7ELTE_BT_UART} at ${J7ELTE_BT_SPEED} (attempt ${attempt}/${J7ELTE_BT_RETRIES})"
+		_stop_attach
+		start-stop-daemon --start --quiet --background --make-pidfile \
+			--pidfile "${PIDFILE}" --exec "${HCIATTACH}" \
+			--stdout "${BTLOG}" --stderr "${BTERR}" -- \
+			-n -t "${J7ELTE_BT_TIMEOUT}" -s "${J7ELTE_BT_INIT_SPEED}" \
+			"${J7ELTE_BT_UART}" "${J7ELTE_BT_TYPE}" \
+			"${J7ELTE_BT_SPEED}" "${J7ELTE_BT_FLOW}"
+
+		waited=0
+		while [ "${waited}" -lt "${J7ELTE_BT_TIMEOUT}" ]; do
+			_attach_ok && break
+			sleep 1
+			waited=$((waited + 1))
+		done
+
+		if _attach_ok; then
+			eend 0
+			break
+		fi
+
+		eend 1
+		_stop_attach
+		attempt=$((attempt + 1))
+		if [ "${attempt}" -le "${J7ELTE_BT_RETRIES}" ]; then
+			sleep "${J7ELTE_BT_RETRY_DELAY}"
+		fi
+	done
+
+	if ! _attach_ok; then
+		eerror "hciattach did not create hci0 after ${J7ELTE_BT_RETRIES} attempt(s)"
+		eerror "Check dmesg for '[BT]' messages and that ${J7ELTE_BT_CHIP_NAME}.hcd is installed"
+		return 1
+	fi
+
+	# Program the public address from EFS before bluetoothd caches it.
+	if [ -x "${ADDR_HELPER}" ]; then
+		ebegin "Programming the Bluetooth public address from ${J7ELTE_BT_ADDR_FILE}"
+		if "${ADDR_HELPER}" "${J7ELTE_BT_ADDR_FILE}"; then
+			eend 0
+		else
+			# Not fatal: the controller still works, but with its factory
+			# default address instead of the EFS one.
+			eend 1 "could not program the BD_ADDR; check ${J7ELTE_BT_ADDR_FILE}"
+		fi
+	else
+		ewarn "${ADDR_HELPER} missing; controller keeps its factory BD_ADDR"
+	fi
+
+	# bluez-openrc provides this service; it also takes care of D-Bus.
+	ebegin "Starting bluetoothd"
+	rc-service bluetooth start
+	eend $?
+}
+
+stop() {
+	ebegin "Detaching Bluetooth HCI transport from ${J7ELTE_BT_UART}"
+	_stop_attach
+	eend 0
+}
diff --git a/device/archived/j7elte-bt/j7elte-bt.post-install b/device/archived/j7elte-bt/j7elte-bt.post-install
new file mode 100755
index 0000000..c5f4c8b
--- /dev/null
+++ b/device/archived/j7elte-bt/j7elte-bt.post-install
@@ -0,0 +1,21 @@
+#!/bin/sh
+
+post_install() {
+	if [ -e /etc/j7elte-bt.disabled ]; then
+		return 0
+	fi
+
+	if [ -d /etc/runlevels ] && command -v rc-update >/dev/null 2>&1; then
+		rc-update add j7elte-bt default >/dev/null 2>&1 || true
+	elif command -v systemctl >/dev/null 2>&1; then
+		systemctl enable j7elte-bt.service >/dev/null 2>&1 || true
+	fi
+}
+
+pre_deinstall() {
+	if [ -d /etc/runlevels ] && command -v rc-update >/dev/null 2>&1; then
+		rc-update del j7elte-bt default >/dev/null 2>&1 || true
+	elif command -v systemctl >/dev/null 2>&1; then
+		systemctl disable j7elte-bt.service >/dev/null 2>&1 || true
+	fi
+}
diff --git a/device/archived/j7elte-bt/j7elte-bt.service b/device/archived/j7elte-bt/j7elte-bt.service
new file mode 100644
index 0000000..9c63c54
--- /dev/null
+++ b/device/archived/j7elte-bt/j7elte-bt.service
@@ -0,0 +1,29 @@
+[Unit]
+Description=Broadcom BCM43438 Bluetooth HCI attach (j7elte)
+Documentation=file:///etc/conf.d/j7elte-bt
+ConditionPathExists=/dev/ttySAC3
+ConditionPathExists=/usr/sbin/hciattach
+ConditionPathExists=!/etc/j7elte-bt.disabled
+# The HCI transport must exist before bluetoothd enumerates controllers, so
+# this unit is ordered *before* bluetooth.service (same intent as the OpenRC
+# "before bluetooth" dependency), not after it.  bluetooth.service is pulled
+# in so a systemd image does not need a separate enable.
+After=dev-ttySAC3.device
+Wants=bluetooth.service
+Before=bluetooth.service
+
+[Service]
+Type=simple
+EnvironmentFile=/etc/conf.d/j7elte-bt
+# Power-cycle the controller first: it then reports its default local name
+# (BCM43430A1), which is what hciattach uses to locate the patch RAM.
+ExecStartPre=/bin/sh -c '/usr/sbin/rfkill block bluetooth; sleep 1; /usr/sbin/rfkill unblock bluetooth; sleep 1'
+ExecStart=/usr/sbin/hciattach -n -t ${J7ELTE_BT_TIMEOUT} -s ${J7ELTE_BT_INIT_SPEED} ${J7ELTE_BT_UART} ${J7ELTE_BT_TYPE} ${J7ELTE_BT_SPEED} ${J7ELTE_BT_FLOW}
+# Program the EFS address once the transport exists and before bluetoothd
+# powers the adapter up.
+ExecStartPost=/usr/libexec/j7elte-bt-addr ${J7ELTE_BT_ADDR_FILE}
+Restart=on-failure
+RestartSec=3
+
+[Install]
+WantedBy=multi-user.target
