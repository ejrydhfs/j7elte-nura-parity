+# Maintainer: ROM/Nura parity integration (SM-J700M / j7elte)
+#
+# Userspace bring-up for the BCM43438 Bluetooth controller on UART 3
+# (/dev/ttySAC3).  The kernel has CONFIG_BT_HCIUART(_H4)=y but no hci_bcm /
+# btbcm driver, so hciattach must download the patch RAM from
+# /lib/firmware/postmarketos/samsung-j7elte/BCM43438A1.hcd.
+pkgname=j7elte-bt
+pkgver=0.1
+pkgrel=0
+pkgdesc="BCM43438 Bluetooth UART attach (hciattach) for the Samsung Galaxy J7"
+url="https://postmarketos.org"
+arch="noarch"
+license="MIT"
+options="!check"
+# bluez-openrc supplies /etc/init.d/bluetooth, which this service starts after
+# the HCI transport is attached.  hciattach ships in bluez-deprecated;
+# /usr/sbin/rfkill is in util-linux-misc.
+depends="bluez bluez-deprecated bluez-openrc util-linux-misc"
+install="$pkgname.post-install"
+source="j7elte-bt.initd
+	j7elte-bt.confd
+	j7elte-bt.service
+	j7elte-bt.post-install
+	"
+builddir="$srcdir"
+
+package() {
+	install -Dm755 "$srcdir"/j7elte-bt.initd \
+		"$pkgdir"/etc/init.d/j7elte-bt
+	install -Dm644 "$srcdir"/j7elte-bt.confd \
+		"$pkgdir"/etc/conf.d/j7elte-bt
+
+	# Optional systemd equivalent; on OpenRC images the init script above is
+	# used.  Both read /etc/conf.d/j7elte-bt.
+	install -Dm644 "$srcdir"/j7elte-bt.service \
+		"$pkgdir"/usr/lib/systemd/system/j7elte-bt.service
+}
+
+sha512sums="
+bcd2d43b543f6a41c4c0a1b219846ce3591f2546e017ac4d4adc5ed4d8c2e15f79308e302845fa5866b6368c133630a53cc0692696a1a19e337b6df6577724f7  j7elte-bt.initd
+89bafe5e5ae79bf7266728db5d329728fa2519d7701648bc12ddadb341d56d8f5256e643fadae006735a68cfbee5d613fe329cce06a5f1edfd09490d64b103dc  j7elte-bt.confd
+d1b8c9a8d38f4e15f3e8471c5ee3095f703f9b726f9c4c2aa3384d7e09ac00409df96022292357bfa2e58f5fcb98a574e52890ba609eb3fd24cf1d514bcb6ed6  j7elte-bt.service
+f386625ea6cf9ef49b7a3ef23e5fe268b504ce3f1a8b1a8e30c5a180d081c0233a16f6cbc043a9ae66aacb5cce836e364c26a2bf2ee62d41c2065aedef68df2f  j7elte-bt.post-install
+"
diff --git a/device/archived/j7elte-bt/j7elte-bt.confd b/device/archived/j7elte-bt/j7elte-bt.confd
new file mode 100644
index 0000000..bc8b737
--- /dev/null
+++ b/device/archived/j7elte-bt/j7elte-bt.confd
@@ -0,0 +1,28 @@
+# /etc/conf.d/j7elte-bt
+#
+# Parameters for the BCM43438 HCI attach on the Samsung Galaxy J7 (j7elte).
+# This file is read by both the OpenRC service and the systemd unit.
+
+# UART that carries HCI: kernel BT_UPORT 3, DT alias uart3 = serial_3.
+J7ELTE_BT_UART=/dev/ttySAC3
+
+# hciattach backend.  bcm43xx downloads the BCM43438 patch RAM; there is no
+# hci_bcm/btbcm driver in this 3.10 kernel, so do not use plain btattach.
+J7ELTE_BT_TYPE=bcm43xx
+
+# Line speed used while resetting the controller.
+J7ELTE_BT_INIT_SPEED=115200
+
+# Operating line speed after the patch RAM has been downloaded.  115200 is the
+# safe default; BCM43438 supports 3000000 once hci0 comes up reliably.
+J7ELTE_BT_SPEED=115200
+
+# Hardware flow control: flow or noflow.
+J7ELTE_BT_FLOW=flow
+
+# hciattach initialisation timeout in seconds.
+J7ELTE_BT_TIMEOUT=30
+
+# OpenRC service only: attach attempts and pause between them.
+J7ELTE_BT_RETRIES=3
+J7ELTE_BT_RETRY_DELAY=1
diff --git a/device/archived/j7elte-bt/j7elte-bt.initd b/device/archived/j7elte-bt/j7elte-bt.initd
new file mode 100755
index 0000000..7a88bb6
--- /dev/null
+++ b/device/archived/j7elte-bt/j7elte-bt.initd
@@ -0,0 +1,138 @@
+#!/sbin/openrc-run
+# Attach the Broadcom BCM43438 Bluetooth controller on the j7elte.
+#
+# The controller sits on UART port 3 (BT_UPORT 3 in
+# drivers/bluetooth/bcm43xx.c; DT alias uart3 = serial_3), i.e. /dev/ttySAC3,
+# and is a plain H4 device: patch RAM must be downloaded by userspace.  On
+# Linux 3.10 there is no hci_bcm/btbcm driver, so btattach alone is not enough
+# -- hciattach's bcm43xx backend resets the chip, matches the firmware by the
+# controller's local name and downloads it.
+#
+# The platform driver registers its rfkill switch soft-blocked
+# (rfkill_init_sw_state(..., 0) followed by rfkill_set_sw_state(..., true) in
+# bcm43xx.c), and only unblocking it drives BT_EN high.  So the order is:
+#   rfkill unblock bluetooth -> hciattach -> bluetoothd
+#
+# Firmware (firmware-samsung-j7elte) installs BCM43438A1.hcd under
+# /lib/firmware/postmarketos/samsung-j7elte/; Alpine's hciattach searches
+# /lib/firmware recursively for "<local name>*.hcd" (bluez patch 004).
+#
+# This service is enabled in the default runlevel by its package, unless
+# /etc/j7elte-bt.disabled exists.  To disable permanently:
+#   touch /etc/j7elte-bt.disabled && rc-service j7elte-bt stop
+#   rc-update del j7elte-bt default
+
+# shellcheck disable=SC2034  # read by openrc-run
+description="Broadcom BCM43438 Bluetooth HCI attach (j7elte)"
+# shellcheck disable=SC2034
+description_stop="Detach the BCM43438 Bluetooth HCI transport (j7elte)"
+
+: "${J7ELTE_BT_UART:=/dev/ttySAC3}"
+: "${J7ELTE_BT_TYPE:=bcm43xx}"
+: "${J7ELTE_BT_INIT_SPEED:=115200}"
+: "${J7ELTE_BT_SPEED:=115200}"
+: "${J7ELTE_BT_FLOW:=flow}"
+: "${J7ELTE_BT_TIMEOUT:=30}"
+: "${J7ELTE_BT_RETRIES:=3}"
+: "${J7ELTE_BT_RETRY_DELAY:=1}"
+
+HCIATTACH=/usr/bin/hciattach
+RFKILL=/usr/sbin/rfkill
+PIDFILE=/run/j7elte-bt.pid
+LOCKFILE=/etc/j7elte-bt.disabled
+
+depend() {
+	need localmount
+	after udev-settle coldplug
+	before bluetooth
+}
+
+# hciattach runs with -n so the attach process stays in the foreground and can
+# be supervised; hci0 only exists while that process holds the N_HCI line
+# discipline.
+_attach_ok() {
+	[ -e /sys/class/bluetooth/hci0 ] || return 1
+	[ -s "${PIDFILE}" ] || return 1
+	kill -0 "$(cat "${PIDFILE}")" 2>/dev/null
+}
+
+_stop_attach() {
+	if [ -s "${PIDFILE}" ]; then
+		start-stop-daemon --stop --quiet --pidfile "${PIDFILE}" \
+			--retry TERM/5/KILL/5
+		rm -f "${PIDFILE}"
+	fi
+	return 0
+}
+
+start() {
+	if [ -e "${LOCKFILE}" ]; then
+		ewarn "j7elte-bt disabled by ${LOCKFILE}; not attaching"
+		return 0
+	fi
+
+	if [ ! -x "${HCIATTACH}" ]; then
+		eerror "${HCIATTACH} not found (install bluez-deprecated)"
+		return 1
+	fi
+
+	if [ ! -c "${J7ELTE_BT_UART}" ]; then
+		eerror "${J7ELTE_BT_UART} not found; is CONFIG_SERIAL_SAMSUNG UART 3 enabled?"
+		return 1
+	fi
+
+	ebegin "Unblocking the Bluetooth rfkill switch"
+	if ! "${RFKILL}" unblock bluetooth; then
+		eend 1 "rfkill unblock bluetooth failed; did bcm43xx probe?"
+		return 1
+	fi
+	eend 0
+
+	attempt=1
+	waited=0
+	while [ "${attempt}" -le "${J7ELTE_BT_RETRIES}" ]; do
+		ebegin "Attaching ${J7ELTE_BT_TYPE} on ${J7ELTE_BT_UART} at ${J7ELTE_BT_SPEED} (attempt ${attempt}/${J7ELTE_BT_RETRIES})"
+		_stop_attach
+		start-stop-daemon --start --quiet --background --make-pidfile \
+			--pidfile "${PIDFILE}" --exec "${HCIATTACH}" -- \
+			-n -t "${J7ELTE_BT_TIMEOUT}" -s "${J7ELTE_BT_INIT_SPEED}" \
+			"${J7ELTE_BT_UART}" "${J7ELTE_BT_TYPE}" \
+			"${J7ELTE_BT_SPEED}" "${J7ELTE_BT_FLOW}"
+
+		waited=0
+		while [ "${waited}" -lt "${J7ELTE_BT_TIMEOUT}" ]; do
+			_attach_ok && break
+			sleep 1
+			waited=$((waited + 1))
+		done
+
+		if _attach_ok; then
+			eend 0
+			break
+		fi
+
+		eend 1
+		_stop_attach
+		attempt=$((attempt + 1))
+		if [ "${attempt}" -le "${J7ELTE_BT_RETRIES}" ]; then
+			sleep "${J7ELTE_BT_RETRY_DELAY}"
+		fi
+	done
+
+	if ! _attach_ok; then
+		eerror "hciattach did not create hci0 after ${J7ELTE_BT_RETRIES} attempt(s)"
+		eerror "Check dmesg for '[BT]' messages and that BCM43438A1.hcd is installed"
+		return 1
+	fi
+
+	# bluez-openrc provides this service; it also takes care of D-Bus.
+	ebegin "Starting bluetoothd"
+	rc-service bluetooth start
+	eend $?
+}
+
+stop() {
+	ebegin "Detaching Bluetooth HCI transport from ${J7ELTE_BT_UART}"
+	_stop_attach
+	eend 0
+}
diff --git a/device/archived/j7elte-bt/j7elte-bt.post-install b/device/archived/j7elte-bt/j7elte-bt.post-install
new file mode 100755
index 0000000..c5f4c8b
--- /dev/null
+++ b/device/archived/j7elte-bt/j7elte-bt.post-install
@@ -0,0 +1,21 @@
+#!/bin/sh
+
+post_install() {
+	if [ -e /etc/j7elte-bt.disabled ]; then
+		return 0
+	fi
+
+	if [ -d /etc/runlevels ] && command -v rc-update >/dev/null 2>&1; then
+		rc-update add j7elte-bt default >/dev/null 2>&1 || true
+	elif command -v systemctl >/dev/null 2>&1; then
+		systemctl enable j7elte-bt.service >/dev/null 2>&1 || true
+	fi
+}
+
+pre_deinstall() {
+	if [ -d /etc/runlevels ] && command -v rc-update >/dev/null 2>&1; then
+		rc-update del j7elte-bt default >/dev/null 2>&1 || true
+	elif command -v systemctl >/dev/null 2>&1; then
+		systemctl disable j7elte-bt.service >/dev/null 2>&1 || true
+	fi
+}
diff --git a/device/archived/j7elte-bt/j7elte-bt.service b/device/archived/j7elte-bt/j7elte-bt.service
new file mode 100644
index 0000000..c4fb100
--- /dev/null
+++ b/device/archived/j7elte-bt/j7elte-bt.service
@@ -0,0 +1,24 @@
+[Unit]
+Description=Broadcom BCM43438 Bluetooth HCI attach (j7elte)
+Documentation=file:///etc/conf.d/j7elte-bt
+ConditionPathExists=/dev/ttySAC3
+ConditionPathExists=/usr/bin/hciattach
+ConditionPathExists=!/etc/j7elte-bt.disabled
+# The HCI transport must exist before bluetoothd enumerates controllers, so
+# this unit is ordered *before* bluetooth.service (same intent as the OpenRC
+# "before bluetooth" dependency), not after it.  bluetooth.service is pulled
+# in so a systemd image does not need a separate enable.
+After=dev-ttySAC3.device
+Wants=bluetooth.service
+Before=bluetooth.service
+
+[Service]
+Type=simple
+EnvironmentFile=/etc/conf.d/j7elte-bt
+ExecStartPre=/usr/sbin/rfkill unblock bluetooth
+ExecStart=/usr/bin/hciattach -n -t ${J7ELTE_BT_TIMEOUT} -s ${J7ELTE_BT_INIT_SPEED} ${J7ELTE_BT_UART} ${J7ELTE_BT_TYPE} ${J7ELTE_BT_SPEED} ${J7ELTE_BT_FLOW}
+Restart=on-failure
+RestartSec=3
+
+[Install]
+WantedBy=multi-user.target
