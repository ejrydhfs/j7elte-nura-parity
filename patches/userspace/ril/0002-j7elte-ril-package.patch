+		uint8_t v;
+
+		if (optind + 1 >= argc ||
+		    parse_uint(argv[optind + 1], &state) < 0) {
+			errmsg("call-srvcc needs STATE (0, 1 or 2)");
+			rc = 2;
+			goto out;
+		}
+		v = state == 1 ? 1 : state == 2 ? 2 : 0;
+		rc = send_one(&ril, &req_call_srvcc, v);
+	} else if (!strcmp(cmd, "call-block")) {
+		unsigned status;
+
+		if (optind + 1 >= argc ||
+		    parse_uint(argv[optind + 1], &status) < 0 ||
+		    status > 0xff) {
+			errmsg("call-block needs STATUS (0..255)");
+			rc = 2;
+			goto out;
+		}
+		rc = send_one(&ril, &req_call_block, (uint8_t)status);
+	} else if (!strcmp(cmd, "call-transfer")) {
+		const char *s[4] = { NULL, NULL, NULL, NULL };
+		uint8_t buf[358];
+		unsigned arg;
+		int i;
+
+		if (optind + 2 >= argc ||
+		    parse_uint(argv[optind + 1], &arg) < 0 || arg > 0xff) {
+			errmsg("call-transfer needs ARG(0..255) NUM1 [NUM2] "
+			       "[NUM3] [NUM4]");
+			rc = 2;
+			goto out;
+		}
+		for (i = 0; i < 4 && optind + 2 + i < argc; i++)
+			s[i] = argv[optind + 2 + i];
+		rc = send_frame_now(&ril, buf,
+				    build_call_transfer(buf, sizeof(buf), arg,
+							s));
+	} else if (!strcmp(cmd, "call-cancel-transfer")) {
+		unsigned arg;
+
+		if (optind + 1 >= argc ||
+		    parse_uint(argv[optind + 1], &arg) < 0 || arg > 0xff) {
+			errmsg("call-cancel-transfer needs ARG (0..255)");
+			rc = 2;
+			goto out;
+		}
+		rc = send_one(&ril, &req_call_cancel_transfer,
+			      (uint8_t)arg);
+	} else if (!strcmp(cmd, "call-manage")) {
+		unsigned type, index;
+		uint8_t buf[92];
+
+		if (optind + 3 >= argc ||
+		    parse_uint(argv[optind + 1], &type) < 0 ||
+		    parse_uint(argv[optind + 2], &index) < 0 ||
+		    index > 0xff) {
+			errmsg("call-manage needs TYPE INDEX(0..255) NUMBER");
+			rc = 2;
+			goto out;
+		}
+		rc = send_frame_now(&ril, buf,
+				    build_call_manage(buf, sizeof(buf), type,
+						      index,
+						      argv[optind + 3]));
+	} else if (!strcmp(cmd, "audio-path")) {
+		unsigned path, mode;
+
+		if (optind + 2 >= argc ||
+		    parse_uint(argv[optind + 1], &path) < 0 ||
+		    parse_uint(argv[optind + 2], &mode) < 0 ||
+		    path > 0xff || mode > 0xff) {
+			errmsg("audio-path needs PATH(0..255) MODE(0..255)");
+			rc = 2;
+			goto out;
+		}
+		rc = send_two(&ril, &req_snd_audio_path,
+			      (uint8_t)path, (uint8_t)mode);
+	} else if (!strcmp(cmd, "sms-smsc")) {
+		rc = cmd_query(&ril, &req_sms_get_smsc);
+	} else if (!strcmp(cmd, "sms-smsc-set")) {
+		if (optind + 1 >= argc) {
+			errmsg("sms-smsc-set needs an address string");
+			rc = 2;
+			goto out;
+		}
+		rc = cmd_sms_smsc_set(&ril, argv[optind + 1]);
+	} else if (!strcmp(cmd, "sms-send")) {
+		const char *number, *text, *sca = NULL;
+		unsigned domain = 0;
+
+		if (optind + 2 >= argc) {
+			errmsg("sms-send needs NUMBER TEXT [SMSC] [DOMAIN]; "
+			       "without SMSC the stored SMSC is queried from "
+			       "the CP");
+			rc = 2;
+			goto out;
+		}
+		number = argv[optind + 1];
+		text = argv[optind + 2];
+		if (optind + 3 < argc)
+			sca = argv[optind + 3];
+		if (optind + 4 < argc &&
+		    parse_uint(argv[optind + 4], &domain) < 0) {
+			errmsg("invalid DOMAIN '%s'", argv[optind + 4]);
+			rc = 2;
+			goto out;
+		}
+		rc = cmd_sms_send_text(&ril, number, text, sca, domain);
+	} else if (!strcmp(cmd, "sms-send-tpdu")) {
+		uint8_t tpdu[256];
+		size_t tlen = 0;
+		unsigned domain = 0;
+
+		if (optind + 2 >= argc ||
+		    parse_hex(argv[optind + 1], tpdu, sizeof(tpdu),
+			      &tlen) < 0 || !tlen) {
+			errmsg("sms-send-tpdu needs TPDU_HEX SMSC [DOMAIN]; "
+			       "TPDU is the framework-built GSM 03.40 PDU");
+			rc = 2;
+			goto out;
+		}
+		if (optind + 3 < argc &&
+		    parse_uint(argv[optind + 3], &domain) < 0) {
+			errmsg("invalid DOMAIN '%s'", argv[optind + 3]);
+			rc = 2;
+			goto out;
+		}
+		rc = cmd_sms_send(&ril, tpdu, tlen, argv[optind + 2],
+				  domain);
+	} else if (!strcmp(cmd, "sms-write")) {
+		uint8_t tpdu[256], buf[268];
+		size_t tlen = 0, len;
+		unsigned index, status;
+
+		if (optind + 4 >= argc ||
+		    parse_uint(argv[optind + 1], &index) < 0 ||
+		    parse_uint(argv[optind + 2], &status) < 0 ||
+		    index > 0xff || status > 0xff ||
+		    parse_hex(argv[optind + 3], tpdu, sizeof(tpdu),
+			      &tlen) < 0 || !tlen) {
+			errmsg("sms-write needs INDEX STATUS TPDU_HEX SMSC");
+			rc = 2;
+			goto out;
+		}
+		len = build_sms_write(buf, sizeof(buf), index, status, tpdu,
+				      tlen, argv[optind + 4]);
+		rc = send_frame_now(&ril, buf, len);
+	} else if (!strcmp(cmd, "sms-read") ||
+		   !strcmp(cmd, "sms-delete")) {
+		unsigned index, storage;
+		uint8_t buf[16];
+		const struct ipc_req *req = !strcmp(cmd, "sms-read") ?
+			&req_sms_read : &req_sms_delete;
+		size_t len;
+
+		if (optind + 2 >= argc ||
+		    parse_uint(argv[optind + 1], &index) < 0 ||
+		    parse_uint(argv[optind + 2], &storage) < 0 ||
+		    index > 0xff || storage > 0xffff) {
+			errmsg("%s needs INDEX STORAGE", cmd);
+			rc = 2;
+			goto out;
+		}
+		len = build_sms_store(buf, sizeof(buf), req, index, storage);
+		if (!strcmp(cmd, "sms-read"))
+			rc = send_frame_wait(&ril, buf, len);
+		else
+			rc = send_frame_now(&ril, buf, len);
+	} else if (!strcmp(cmd, "sms-ack")) {
+		const char *arg = optind + 2 < argc ? argv[optind + 2] : NULL;
+		unsigned tpid, cause = 0x80;
+		uint8_t buf[16];
+		size_t len;
+		int ok;
+
+		if (optind + 1 >= argc ||
+		    parse_uint(argv[optind + 1], &tpid) < 0 ||
+		    tpid > 0xff || !arg ||
+		    (strcmp(arg, "ok") && strcmp(arg, "fail"))) {
+			errmsg("sms-ack needs TPID ok|fail [CAUSE] "
+			       "(TPID must be <= 255)");
+			rc = 2;
+			goto out;
+		}
+		ok = !strcmp(arg, "ok");
+		if (!ok && optind + 3 < argc &&
+		    parse_uint(argv[optind + 3], &cause) < 0) {
+			errmsg("invalid CAUSE '%s'", argv[optind + 3]);
+			rc = 2;
+			goto out;
+		}
+		len = build_sms_ack(buf, sizeof(buf), tpid, ok, cause);
+		rc = send_frame_now(&ril, buf, len);
+	} else if (!strcmp(cmd, "pdp-get")) {
+		rc = cmd_query(&ril, &req_pdp_get);
+	} else if (!strcmp(cmd, "pdp-define")) {
+		unsigned cid, proto = 0;
+
+		if (optind + 2 >= argc ||
+		    parse_uint(argv[optind + 1], &cid) < 0) {
+			errmsg("pdp-define needs CID APN [PROTO] "
+			       "(e.g. pdp-define 1 internet 3)");
+			rc = 2;
+			goto out;
+		}
+		if (optind + 3 < argc &&
+		    parse_uint(argv[optind + 3], &proto) < 0) {
+			errmsg("invalid PROTO '%s'", argv[optind + 3]);
+			rc = 2;
+			goto out;
+		}
+		rc = cmd_pdp_define(&ril, cid, argv[optind + 2], proto);
+	} else if (!strcmp(cmd, "pdp-activate")) {
+		unsigned cid, auth = 0;
+
+		if (optind + 2 >= argc ||
+		    parse_uint(argv[optind + 1], &cid) < 0) {
+			errmsg("pdp-activate needs CID APN [AUTH]");
+			rc = 2;
+			goto out;
+		}
+		if (optind + 3 < argc &&
+		    parse_uint(argv[optind + 3], &auth) < 0) {
+			errmsg("invalid AUTH '%s'", argv[optind + 3]);
+			rc = 2;
+			goto out;
+		}
+		rc = cmd_pdp_activate(&ril, cid, argv[optind + 2], auth);
+	} else if (!strcmp(cmd, "pdp-deactivate")) {
+		unsigned cid, reason = 1;
+
+		if (optind + 1 >= argc ||
+		    parse_uint(argv[optind + 1], &cid) < 0) {
+			errmsg("pdp-deactivate needs CID [REASON 1..4]");
+			rc = 2;
+			goto out;
+		}
+		if (optind + 2 < argc &&
+		    parse_uint(argv[optind + 2], &reason) < 0) {
+			errmsg("invalid REASON '%s'", argv[optind + 2]);
+			rc = 2;
+			goto out;
+		}
+		rc = cmd_pdp_deactivate(&ril, cid, reason);
+	} else if (!strcmp(cmd, "pdp-action")) {
+		unsigned cid, action;
+		uint8_t buf[0x70];
+
+		if (optind + 2 >= argc ||
+		    parse_uint(argv[optind + 1], &cid) < 0 ||
+		    parse_uint(argv[optind + 2], &action) < 0 ||
+		    cid > 0xff || action < 2 || action > 5) {
+			errmsg("pdp-action needs CID ACTION(2..5); actions 0 "
+			       "and 1 use pdp-deactivate/pdp-activate");
+			rc = 2;
+			goto out;
+		}
+		rc = send_frame_now(&ril, buf,
+				    build_pdp_action(buf, sizeof(buf), cid,
+						     action));
+	} else if (!strcmp(cmd, "ipv6-config")) {
+		uint8_t addr[16];
+		size_t alen = 0;
+		unsigned cid;
+		uint8_t buf[0x18];
+
+		if (optind + 2 >= argc ||
+		    parse_uint(argv[optind + 1], &cid) < 0 || cid > 0xff ||
+		    parse_hex(argv[optind + 2], addr, sizeof(addr), &alen) < 0 ||
+		    alen != sizeof(addr)) {
+			errmsg("ipv6-config needs CID ADDR_HEX (exactly 16 "
+			       "bytes)");
+			rc = 2;
+			goto out;
+		}
+		rc = send_frame_now(&ril, buf,
+				    build_ipv6_config(buf, sizeof(buf), cid,
+						      addr));
+	} else if (!strcmp(cmd, "mobile-data")) {
+		unsigned b0, b1;
+		uint8_t buf[IPC_HDR_LEN + 2];
+
+		if (optind + 2 >= argc ||
+		    parse_uint(argv[optind + 1], &b0) < 0 ||
+		    parse_uint(argv[optind + 2], &b1) < 0 ||
+		    b0 > 1 || b1 > 1) {
+			errmsg("mobile-data needs B0 B1 (0 or 1)");
+			rc = 2;
+			goto out;
+		}
+		rc = send_frame_now(&ril, buf,
+				    build_mobile_data(buf, sizeof(buf), b0,
+						      b1));
+	} else if (!strcmp(cmd, "ps-attach")) {
+		const char *arg = optind + 1 < argc ? argv[optind + 1] : NULL;
+		unsigned reason = 0;
+		int on;
+
+		if (!arg || (strcmp(arg, "on") && strcmp(arg, "off") &&
+			     strcmp(arg, "1") && strcmp(arg, "0"))) {
+			errmsg("ps-attach needs 'on' or 'off' [reason 1..4]");
+			rc = 2;
+			goto out;
+		}
+		on = !strcmp(arg, "on") || !strcmp(arg, "1");
+		if (optind + 2 < argc &&
+		    parse_uint(argv[optind + 2], &reason) < 0) {
+			errmsg("invalid reason '%s'", argv[optind + 2]);
+			rc = 2;
+			goto out;
+		}
+		rc = cmd_ps_attach(&ril, on, reason);
+	} else if (!strcmp(cmd, "raw")) {
+		uint8_t buf[IPC_MAX_MSG];
+		size_t len = 0;
+
+		if (optind + 1 >= argc || parse_hex(argv[optind + 1], buf,
+						   sizeof(buf), &len) < 0 || !len) {
+			errmsg("raw needs hex bytes (e.g. 070000000a0302 01)");
+			rc = 2;
+			goto out;
+		}
+		rc = ipc_send(&ril, buf, len) < 0;
+	} else if (!strcmp(cmd, "listen")) {
+		rc = cmd_listen(&ril);
+	} else {
+		errmsg("unknown command '%s'", cmd);
+		usage(stderr);
+		rc = 2;
+		goto out;
+	}
+
+	/* Drain anything still queued (responses to the last request). */
+	if (rc == 0 && strcmp(cmd, "listen") != 0)
+		drain(&ril, 300);
+
+	if (daemon_mode) {
+		errmsg("supervising the CP; exit on POLLHUP");
+		rc = cmd_listen(&ril);
+	}
+
+out:
+	if (ril.rfs_fd >= 0)
+		close(ril.rfs_fd);
+	if (ril.ipc_fd >= 0)
+		close(ril.ipc_fd);
+	return rc;
+}
diff --git a/device/archived/j7elte-ril/j7elte-ril.confd b/device/archived/j7elte-ril/j7elte-ril.confd
new file mode 100644
index 0000000..c788f8a
--- /dev/null
+++ b/device/archived/j7elte-ril/j7elte-ril.confd
@@ -0,0 +1,26 @@
+# /etc/conf.d/j7elte-ril
+#
+# SIPC5 FMT/RFS client for the Samsung Galaxy J7 (j7elte, Exynos 7580 +
+# Shannon SS310AP).  Read by both the OpenRC service and the systemd unit.
+
+# Kernel IO devices created by drivers/misc/modem_v1.
+# Opening *both* is what makes the kernel answer the CP's PHONE_START with
+# INIT_END (rild_ready(), link_device_shmem.c:261); with only one of them open
+# the CP keeps retrying and telephony never comes up.
+J7ELTE_RIL_IPC_DEV=/dev/umts_ipc0
+J7ELTE_RIL_RFS_DEV=/dev/umts_rfs0
+
+# Response timeout per message, in seconds.
+J7ELTE_RIL_TIMEOUT=5
+
+# Extra arguments.  Useful ones:
+#   -v            verbose (hex dump of every frame, kernel state changes)
+#   -j            one JSON object per inbound message
+#   --no-rfs      do not open /dev/umts_rfs0 (breaks INIT_END; debug only)
+J7ELTE_RIL_EXTRA_ARGS="-v"
+
+# Command run once the CP is ONLINE before the daemon starts listening.
+#   info        full query set (versions, time, PIN state, operator,
+#               registration, IMEI)
+#   state       only print the kernel state
+J7ELTE_RIL_COMMAND=info
diff --git a/device/archived/j7elte-ril/j7elte-ril.initd b/device/archived/j7elte-ril/j7elte-ril.initd
new file mode 100755
index 0000000..6d044c9
--- /dev/null
+++ b/device/archived/j7elte-ril/j7elte-ril.initd
@@ -0,0 +1,82 @@
+#!/sbin/openrc-run
+# SIPC5 RIL client for the Samsung Galaxy J7 (j7elte).
+#
+# Stock Android runs rild + libsec-ril.so (bionic, not installable here).  This
+# service runs j7elte-ril, which speaks the recovered subset of the same
+# protocol on /dev/umts_ipc0 and /dev/umts_rfs0:
+#
+#   * opens both channels, so the kernel sends INIT_END to the CP
+#     (otherwise the CP retries PHONE_START forever),
+#   * re-issues IOCTL_MODEM_BOOT_OFF when the CP is ONLINE on the wire but the
+#     kernel still reports OFFLINE (a RIL started after j7elte-cbd) -- without
+#     that, misc_write() rejects every message with -EPERM,
+#   * sends SMS_DEVICE_READY plus the MISC/NET/SEC queries (IMEI, versions,
+#     operator, registration state, PIN state) and decodes the answers,
+#   * then stays resident, logging unsolicited messages, and exits non-zero on
+#     POLLHUP (CP crash) so this service is restarted.
+#
+# Calls/SMS/data are NOT implemented yet: see parity/reports/ril-re.md.
+
+# shellcheck disable=SC2034  # read by openrc-run
+description="SIPC5 RIL client for the SS310AP baseband (j7elte)"
+# shellcheck disable=SC2034
+description_stop="Detach from the baseband (channels closed, CP keeps running)"
+
+: "${J7ELTE_RIL_IPC_DEV:=/dev/umts_ipc0}"
+: "${J7ELTE_RIL_RFS_DEV:=/dev/umts_rfs0}"
+: "${J7ELTE_RIL_TIMEOUT:=5}"
+: "${J7ELTE_RIL_EXTRA_ARGS:=-v}"
+: "${J7ELTE_RIL_COMMAND:=info}"
+
+PIDFILE=/run/j7elte-ril.pid
+
+depend() {
+	need localmount
+	after j7elte-cbd
+	# Without j7elte-cbd the CP stays powered down; do not hard-fail if the
+	# admin disabled it, the command below will report it.
+	use net
+}
+
+start() {
+	if [ ! -c "${J7ELTE_RIL_IPC_DEV}" ]; then
+		eerror "${J7ELTE_RIL_IPC_DEV} not found: CONFIG_SEC_MODEM_V1 /"
+		eerror "CONFIG_SEC_MODEM_SS310AP must be built in and the modem"
+		eerror "node must have probed (dmesg | grep 'mif:')"
+		return 1
+	fi
+
+	set -- -i "${J7ELTE_RIL_IPC_DEV}" \
+		-r "${J7ELTE_RIL_RFS_DEV}" \
+		-t "${J7ELTE_RIL_TIMEOUT}" \
+		-d "${J7ELTE_RIL_COMMAND}"
+	# shellcheck disable=SC2086
+	set -- "$@" ${J7ELTE_RIL_EXTRA_ARGS}
+
+	ebegin "Starting the SIPC5 RIL client"
+	start-stop-daemon --start --quiet --background --make-pidfile \
+		--pidfile "${PIDFILE}" --exec /usr/bin/j7elte-ril -- "$@"
+	eend $?
+
+	# Give the query set a moment so a broken protocol shows up in the
+	# service status instead of a silently idle daemon.
+	sleep 3
+	if [ -s "${PIDFILE}" ] && ! kill -0 "$(cat "${PIDFILE}")" 2>/dev/null; then
+		eerror "j7elte-ril exited; see 'dmesg | grep mif:' and run"
+		eerror "'j7elte-ril -v info' in the foreground"
+		return 1
+	fi
+	return 0
+}
+
+stop() {
+	ebegin "Stopping the SIPC5 RIL client"
+	if [ -s "${PIDFILE}" ]; then
+		start-stop-daemon --stop --quiet --pidfile "${PIDFILE}" \
+			--retry TERM/5
+		rm -f "${PIDFILE}"
+	fi
+	eend 0
+	# Closing the channels does not power the CP down and the kernel keeps
+	# cp_boot_done set, so a restart only re-opens the devices.
+}
diff --git a/device/archived/j7elte-ril/j7elte-ril.service b/device/archived/j7elte-ril/j7elte-ril.service
new file mode 100644
index 0000000..f68fd3d
--- /dev/null
+++ b/device/archived/j7elte-ril/j7elte-ril.service
@@ -0,0 +1,21 @@
+[Unit]
+Description=SIPC5 RIL client for the Samsung J7 (j7elte) baseband
+After=dev-umts_ipc0.device dev-umts_rfs0.device
+Wants=dev-umts_ipc0.device
+
+[Service]
+Type=simple
+# Defaults first; the file is read afterwards, so /etc/conf.d/j7elte-ril can
+# override all four.  The unquoted variables are whitespace-split by systemd,
+# so J7ELTE_RIL_EXTRA_ARGS can hold several flags.
+Environment=J7ELTE_RIL_IPC_DEV=/dev/umts_ipc0
+Environment=J7ELTE_RIL_RFS_DEV=/dev/umts_rfs0
+Environment=J7ELTE_RIL_TIMEOUT=5
+Environment=J7ELTE_RIL_COMMAND=info
+EnvironmentFile=-/etc/conf.d/j7elte-ril
+ExecStart=/usr/bin/j7elte-ril -i $J7ELTE_RIL_IPC_DEV -r $J7ELTE_RIL_RFS_DEV -t $J7ELTE_RIL_TIMEOUT -d $J7ELTE_RIL_COMMAND $J7ELTE_RIL_EXTRA_ARGS
+Restart=on-failure
+RestartSec=5
+
+[Install]
+WantedBy=multi-user.target
