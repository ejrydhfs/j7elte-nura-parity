+static int parse_hex(const char *s, uint8_t *out, size_t max, size_t *len)
+{
+	size_t n = 0;
+
+	while (*s) {
+		char tmp[3];
+		unsigned v;
+
+		if (*s == ' ' || *s == ':')
+			s++;
+		if (!s[0] || !s[1])
+			return -1;
+		tmp[0] = s[0];
+		tmp[1] = s[1];
+		tmp[2] = '\0';
+		if (sscanf(tmp, "%2x", &v) != 1)
+			return -1;
+		if (n >= max)
+			return -1;
+		out[n++] = (uint8_t)v;
+		s += 2;
+	}
+	*len = n;
+	return 0;
+}
