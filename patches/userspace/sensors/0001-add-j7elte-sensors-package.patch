+# Maintainer: j7elte parity work <parity@example.invalid>
+# net.hadess.SensorProxy bridge for the Samsung K2HH accelerometer and the
+# CM36672P/STK3013 proximity sensor, which are evdev/sysfs devices (not IIO)
+# in the Nura kernel.
+pkgname=j7elte-sensors
+pkgver=1.0.0
+pkgrel=0
+pkgdesc="net.hadess.SensorProxy bridge for Samsung Galaxy J7 (j7elte) evdev sensors"
+url="https://postmarketos.org"
+arch="aarch64"
+license="GPL-3.0-or-later"
+depends="dbus"
+makedepends=""
+options="!check"
+source="
+	j7elte-sensors.c
+	dbus-wire.c
+	dbus-wire.h
+	Makefile
+	j7elte-sensors.service
+	j7elte-sensors.initd
+	j7elte-sensors.conf
+"
+builddir="$srcdir"
+
+build() {
+	make CC="$CC" CFLAGS="$CFLAGS" LDFLAGS="$LDFLAGS"
+}
+
+package() {
+	install -Dm755 j7elte-sensors \
+		"$pkgdir"/usr/bin/j7elte-sensors
+	install -Dm644 j7elte-sensors.service \
+		"$pkgdir"/usr/lib/systemd/system/j7elte-sensors.service
+	install -Dm755 j7elte-sensors.initd \
+		"$pkgdir"/etc/init.d/j7elte-sensors
+	install -Dm644 j7elte-sensors.conf \
+		"$pkgdir"/usr/share/dbus-1/system.d/j7elte-sensors.conf
+}
