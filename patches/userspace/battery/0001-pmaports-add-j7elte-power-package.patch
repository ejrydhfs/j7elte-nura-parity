+39c794087231ebd1f4b74fb0b26bc21e12270d81ffe655f78b6397722e701f3f1a78886fbae467ed31248bcd6a2c7cacd0f993fee251798af2a493f1f605f60e  j7elte-power.c
+dce24255f1ec266120784886c026ebdd78c354f287ae39300da67230dd0b465e2caaf19aafa55102a8a9200831c35daf2147a2e355231beeb3b9ea1e0a58f29a  j7elte-power.conf
+404b353564d5bbdd1d5f26c269a0347fd640615090453d98a7f668259362ac33954b1ebf039525f5dea3d10492e077460e7b637af3a1a561ff4bac7a7e93c82c  j7elte-power.service
+9cd74e5e84ed6da39d5e7ad1b1385c1a2af5cf18ea344abdd2cb86b414d6b9ddf563d21158deb15f1804703edbb05ba611ce5b13a8f56a01d7a835a5c61e55dc  j7elte-efs-restore.service
+502b6d856797078b27dd1469d6dab6e99baae8b90ea24291fb711d96175e6e0beb851841ef5fa00a6f276604dabc8862dbe07b8a015cc783a74d87df4803f37b  j7elte-power.initd
