new file mode 100644
index 0000000..6f9b748
--- /dev/null
+++ b/device/archived/j7elte-audio-ucm/VoiceCall.conf
@@ -0,0 +1,343 @@
+# VoiceCall use case for the Universal7580-I2S card (j7elte).
+#
+# Uses DAI link 2 ("cp" / "voice call", codec DAI "cod3022x-aif2"),
+# exposed as hw:${CardId},2.  Control sequences are the stock ROM
+# incall_nb-* / gain-incall_nb-* paths.
+#
+# NOTE: on this vendor kernel the CP link uses the "snd-soc-dummy"
+# platform, i.e. no in-kernel modem/voice PCM backend is attached.
+# The mixer graph below is complete and matches the ROM, but audible
+# call audio additionally needs a modem audio driver/userspace stack
+# that postmarketOS does not currently provide for j7elte.
+
+Syntax 3
+
+SectionVerb {
+	EnableSequence [
+		cset "name='S2801 Mixer En' 'Off'"
+		cset "name='S2801 SRC1 En' 'Off'"
+		cset "name='S2801 SRC2 En' 'Off'"
+		cset "name='S2801 SRC3 En' 'Off'"
+		cset "name='S2801 CH1 Mixer En' 'Off'"
+		cset "name='S2801 CH2 Mixer En' 'Off'"
+		cset "name='S2801 CH3 Mixer En' 'Off'"
+		cset "name='S2801 CH4 Mixer En' 'Off'"
+		cset "name='S2801 RMIX1 En' 'Off'"
+		cset "name='S2801 RMIX2 En' 'Off'"
+		cset "name='S2801 CH3 Rec En' 'Off'"
+		cset "name='MonoMix Mode' 'Disable'"
+		cset "name='HP HP On' off"
+		cset "name='EP EP On' off"
+		cset "name='SPK SPK On' off"
+	]
+
+	DisableSequence [
+		cset "name='S2801 Mixer En' 'Off'"
+		cset "name='S2801 SRC1 En' 'Off'"
+		cset "name='S2801 SRC2 En' 'Off'"
+		cset "name='S2801 SRC3 En' 'Off'"
+		cset "name='S2801 CH1 Mixer En' 'Off'"
+		cset "name='S2801 CH2 Mixer En' 'Off'"
+		cset "name='S2801 CH3 Mixer En' 'Off'"
+		cset "name='S2801 CH4 Mixer En' 'Off'"
+		cset "name='S2801 RMIX1 En' 'Off'"
+		cset "name='S2801 RMIX2 En' 'Off'"
+		cset "name='S2801 CH3 Rec En' 'Off'"
+		cset "name='HP HP On' off"
+		cset "name='EP EP On' off"
+		cset "name='SPK SPK On' off"
+	]
+}
+
+SectionDevice."Earpiece" {
+	Comment "Earpiece voice call"
+
+	EnableSequence [
+		# route-cp
+		cset "name='S2801 Mixer En' 'On'"
+		cset "name='S2801 SRC1 En' 'Off'"
+		cset "name='S2801 SRC2 En' 'On'"
+		cset "name='S2801 SRC3 En' 'Off'"
+		cset "name='S2801 CH1 Mixer En' 'On'"
+		cset "name='S2801 CH2 Mixer En' 'On'"
+		cset "name='S2801 CH3 Mixer En' 'Off'"
+		cset "name='S2801 CH4 Mixer En' 'Off'"
+		cset "name='S2801 RMIX1 En' 'On'"
+		cset "name='S2801 RMIX2 En' 'On'"
+		cset "name='S2801 CH3 Rec En' 'Off'"
+		cset "name='S2801 CH1 DOUT Select' 'RMIX_OUT'"
+		cset "name='S2801 CH2 DOUT Select' 'AIF4IN'"
+		cset "name='MonoMix Mode' 'L'"
+		cset "name='Chargepump Mode' 'CLASS-G-A'"
+		cset "name='DNC Max Gain' 24"
+		# dev-codec-disable-analog-bypass
+		cset "name='HPL Mixer ADCL Switch' off"
+		cset "name='HPL Mixer ADCR Switch' off"
+		cset "name='HPR Mixer ADCL Switch' off"
+		cset "name='HPR Mixer ADCR Switch' off"
+		cset "name='EP Mixer ADCL Switch' off"
+		cset "name='EP Mixer ADCR Switch' off"
+		cset "name='SPK Mixer ADCL Switch' off"
+		cset "name='SPK Mixer ADCR Switch' off"
+		# dev-handset
+		cset "name='HP HP On' off"
+		cset "name='SPK SPK On' off"
+		cset "name='EP EP On' on"
+		# gain-incall_nb-handset
+		cset "name='S2801 MIX1_LVL' 0"
+		cset "name='S2801 MIX2_LVL' 0"
+		cset "name='DAC Gain' 127"
+		cset "name='Earphone Volume' 0"
+	]
+
+	DisableSequence [
+		cset "name='EP EP On' off"
+		cset "name='HP HP On' off"
+		cset "name='SPK SPK On' off"
+	]
+
+	Value {
+		PlaybackPriority 200
+		PlaybackPCM "hw:${CardId},2"
+		PlaybackChannels 2
+		PlaybackRate 8000
+	}
+}
+
+SectionDevice."Speaker" {
+	Comment "Speaker voice call"
+
+	EnableSequence [
+		# route-cp
+		cset "name='S2801 Mixer En' 'On'"
+		cset "name='S2801 SRC1 En' 'Off'"
+		cset "name='S2801 SRC2 En' 'On'"
+		cset "name='S2801 SRC3 En' 'Off'"
+		cset "name='S2801 CH1 Mixer En' 'On'"
+		cset "name='S2801 CH2 Mixer En' 'On'"
+		cset "name='S2801 CH3 Mixer En' 'Off'"
+		cset "name='S2801 CH4 Mixer En' 'Off'"
+		cset "name='S2801 RMIX1 En' 'On'"
+		cset "name='S2801 RMIX2 En' 'On'"
+		cset "name='S2801 CH3 Rec En' 'Off'"
+		cset "name='S2801 CH1 DOUT Select' 'RMIX_OUT'"
+		cset "name='S2801 CH2 DOUT Select' 'AIF4IN'"
+		cset "name='MonoMix Mode' 'L'"
+		cset "name='Chargepump Mode' 'CLASS-G-A'"
+		cset "name='DNC Max Gain' 24"
+		# dev-codec-disable-analog-bypass
+		cset "name='HPL Mixer ADCL Switch' off"
