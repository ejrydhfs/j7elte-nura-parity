+# ALSA Use Case Manager configuration for Samsung Galaxy J7 (j7elte)
+# Sound card: ASoC card name / driver "Universal7580-I2S"
+# (sound/soc/samsung/universal7580-cod3022x.c, COD3022X + S2801X aux codec)
+#
+# Derived from the stock ROM mixer graph
+# (/etc/mixer_paths.xml, J700MUBU2BRC2).  Every control name below is
+# registered by the Nura kernel driver; see
+# parity/reports/audio-userspace.md for the cross-check.
+
+Syntax 3
+
+SectionUseCase."HiFi" {
+	File "/j7elte/HiFi.conf"
+	Comment "Music playback, capture, headset and headphone routing"
+}
+
+SectionUseCase."VoiceCall" {
+	File "/j7elte/VoiceCall.conf"
+	Comment "Voice call routing through the CP (modem) DAI"
+}
