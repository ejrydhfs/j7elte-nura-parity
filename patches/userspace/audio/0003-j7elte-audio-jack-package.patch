+# Automatic audio jack routing for the Samsung Galaxy J7 (j7elte).
+#
+# The vendor sec_jack driver (drivers/misc/sec_jack.c) reports the jack
+# type through /sys/class/switch/h2w/state and a kobject uevent, but
+# registers no snd_jack kcontrol, so ALSA UCM / PipeWire cannot switch
+# routes on plug.  This daemon listens for the switch uevent, debounces
+# it and applies the matching UCM2 device of the j7elte-audio-ucm profile
+# (Speaker / Headphones / Headset Mic) via alsaucm, with an amixer
+# fallback.
+#
+# See parity/reports/audio-jack.md and parity/reports/audio-userspace.md.
+
+pkgname=j7elte-audio-jack
+pkgver=0.1
+pkgrel=0
+pkgdesc="Automatic headset jack routing for Samsung Galaxy J7 (j7elte)"
+url="https://postmarketos.org"
+arch="aarch64"
+license="GPL-3.0-or-later"
+depends="alsa-utils j7elte-audio-ucm"
+options="!check"
+builddir="$srcdir"
+
+source="
+	j7elte-audio-jack.c
+	j7elte-audio-jack.conf
+	j7elte-audio-jack.initd
+	j7elte-audio-jack.service
+"
+
+build() {
+	$CC $CFLAGS -std=c11 -D_POSIX_C_SOURCE=200809L -Wall -Wextra \
+		-o j7elte-audio-jack "$srcdir"/j7elte-audio-jack.c $LDFLAGS
+}
+
+package() {
+	install -Dm755 j7elte-audio-jack "$pkgdir"/usr/bin/j7elte-audio-jack
+	install -Dm644 j7elte-audio-jack.conf \
+		"$pkgdir"/etc/j7elte-audio-jack.conf
+	install -Dm755 j7elte-audio-jack.initd \
+		"$pkgdir"/etc/init.d/j7elte-audio-jack
+	install -Dm644 j7elte-audio-jack.service \
+		"$pkgdir"/usr/lib/systemd/system/j7elte-audio-jack.service
+}
+
