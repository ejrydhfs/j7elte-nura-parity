diff --git a/parity/userspace/gps/Makefile b/parity/userspace/gps/Makefile
new file mode 100644
index 0000000..d0982d0
--- /dev/null
+++ b/parity/userspace/gps/Makefile
@@ -0,0 +1,37 @@
+#
+# j7elte-gpsd - build the bridge daemon
+#
+# CC defaults to the Alpine musl cross compiler; override for a quick
+# off-target syntax/type check, e.g.
+#   make CC=aarch64-none-linux-gnu-gcc
+#
+CC      ?= aarch64-linux-musl-gcc
+CFLAGS  ?= -O2 -g -Wall -Wextra -Wshadow -Wformat=2 -std=c11
+LDFLAGS ?=
+SRC     ?= src/j7elte-gpsd.c
+BIN     := j7elte-gpsd
+
+all: $(BIN)
+
+$(BIN): $(SRC)
+	$(CC) $(CFLAGS) -o $@ $(SRC) $(LDFLAGS)
+
+# Raw UART experiment driver (no NMEA parsing, no PTY): used to capture the
+# BCM4752 BRI prologue byte by byte on the device.
+gpsprobe: src/gpsprobe.c
+	$(CC) $(CFLAGS) -o $@ $< 
+
+# Standalone ESW/RAM-patch upload driver: power cycle, prologue, patch upload
+# with selectable frame encodings (-V), bank switches, CRC requests.  The
+# encoder variant that the hardware accepts is the one the daemon uses.
+gpsesw: src/gpsesw.c
+	$(CC) $(CFLAGS) -o $@ $<
+
+check: $(BIN)
+	python3 tests/smoke_test.py
+	python3 tests/init_test.py
+
+clean:
+	rm -f $(BIN) gpsprobe gpsesw
+
+.PHONY: all check clean
diff --git a/parity/userspace/gps/src/gpsesw.c b/parity/userspace/gps/src/gpsesw.c
new file mode 100644
index 0000000..14ecb64
--- /dev/null
+++ b/parity/userspace/gps/src/gpsesw.c
@@ -0,0 +1,943 @@
+/*
+ * gpsesw - drive the BCM4752 "4752_B2" RAM-patch (ESW) upload on /dev/ttySAC0
+ *
+ * The extracted patch (see code/gps/esw/esw_dump.c and
+ * docs/reports/gps-esw.md) is four blocks:
+ *
+ *   idx bank  load addr  size  source
+ *     0    0     0x7000   4060  .rodata, verbatim
+ *     1    0     0x7fec      4  .rodata, verbatim
+ *     2    1     0x8000   6777  .rodata, verbatim
+ *     3    0     0x7fd2      4  synthesised (four zero bytes)
+ *
+ * The public wire format for a data frame is
+ *
+ *   fe <nwords> fd 61 17 de c0 <addr lo> <addr hi> <data...> fc
+ *
+ * but the exact meaning of <nwords> and the relation between the chunk size,
+ * the 160-byte UART write pieces and the address field are only partially
+ * documented, so this tool implements the plausible encodings behind
+ * -V and lets the hardware decide:
+ *
+ *   -V 1  public spec (mbicz/bcm4752-host): chunk = min(rem, -c); the chunk
+ *          is split into aligned = chunk & ~3 and tail = chunk & 3; the
+ *          aligned part gets one frame with nwords = aligned/4, the tail
+ *          gets a second frame with nwords = ceil(tail/4) carrying the last
+ *          four bytes of the chunk at addr+chunk-4.  UART writes are paced
+ *          in <= -p byte pieces.
+ *   -V 2  one frame per -p byte piece: nwords = ceil(piece_len/4), address
+ *          advances by piece_len (the stock daemon's inner loop as read from
+ *          the ARM32 binary).
+ *   -V 3  one frame per chunk, all chunk bytes in the frame,
+ *          nwords = ceil(chunk/4) (no separate odd-tail frame).
+ *
+ * Usage:
+ *   gpsesw [-d DEV] [-b BAUD] [-g GPIO] [-D DIR] [-V N] [-c N] [-p N]
+ *          [-G MS] [-t MS] [-l N] [-i IDX] [-e] [-q] [-x] [-n] [-S HEX]
+ *
+ *   -D DIR   directory holding b2-4752_B2-<idx>.bin (from esw_dump --dump)
+ *   -V N     data-frame encoding variant (1..3, default 1)
+ *   -c N     chunk size in bytes (default 1020 = 0x3fc)
+ *   -p N     UART write piece inside a frame (default 160 = 0xa0)
+ *   -G MS    delay between UART write pieces (default 1 ms)
+ *   -t MS    reply timeout (default 300 ms)
+ *   -l N     send at most N payload bytes per block (0 = whole block)
+ *   -i IDX   send only block IDX (0..3), with its bank switch
+ *   -e       skip the item 0x16 / bank-select writes
+ *   -q       query only: prologue + item scan, no upload
+ *   -x       do not send the GLME switch frame at the end
+ *   -n       do not touch GPS_PWR_EN (assume the chip is already up)
+ *   -S HEX   first byte of the data frames (default fe)
+ *
+ * Every byte read back is printed as hex, so the transcript is the result.
+ * Exit status is only about I/O; the transcript carries the verdict.
+ *
+ * License: MIT
+ */
+#define _GNU_SOURCE
+#include <errno.h>
+#include <fcntl.h>
+#include <getopt.h>
+#include <poll.h>
+#include <stdarg.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <termios.h>
+#include <time.h>
+#include <unistd.h>
+
+#define MAX_BLOCKS 8
+
+struct blk {
+	int bank;
+	unsigned addr;
+	const char *name;
+	unsigned char *data;
+	size_t len;
+	size_t sent;
+};
+
+static struct {
+	const char *dev;
+	int baud;
+	const char *gpio;
+	const char *dir;
+	int variant;
+	int chunk;
+	int piece;
+	int piece_max;      /* record transfer piece: CRC boundary (4096) */
+	int gap_ms;
+	int timeout_ms;
+	int glme_ms;
+	long limit;
+	int only_idx;
+	int no_banksel;
+	int query_only;
+	int no_glme;
+	int no_power;
+	int power_delay_ms;
+	int power_off_ms;
+	int nwrite;                      /* -w extra frames after prologue */
+	const char *writes[16];
+	int npost;                       /* -z extra frames after the upload */
+	const char *post[16];
+	int scan_after;                  /* -Q item scan after the upload */
+	unsigned char soff;
+} o = {
+	.dev = "/dev/ttySAC0",
+	.baud = 921600,
+	.gpio = "/sys/class/sec/gps/GPS_PWR_EN/value",
+	.dir = "/tmp/gps_esw",
+	.variant = 1,
+	.chunk = 1020,
+	.piece = 160,
+	.piece_max = 4096,
+	.gap_ms = 1,
+	.timeout_ms = 300,
+	.glme_ms = 1000,
+	.limit = 0,
+	.only_idx = -1,
+	.no_banksel = 0,
+	.query_only = 0,
+	.no_glme = 0,
+	.no_power = 0,
+	.power_delay_ms = 300,
+	.power_off_ms = 1000,
+	.soff = 0xfe,
+};
+
+static struct blk blocks[MAX_BLOCKS];
+static int nblocks = 4;
+
+/* last complete fe 00 fd ... fc frame seen by rx_dump() */
+static unsigned char g_frame[16];
+static size_t g_flen;
+static unsigned g_frames;
+static int crc_ack;      /* 1 when the last CRC request produced a 2f15 */
+static int piece_acks;   /* 2f15 replies for the current record */
+static int piece_fails;
+
+/* ---------------------------------------------------------------- utils */
+
+static void logmsg(const char *fmt, ...)
+{
+	va_list ap;
+	struct timespec ts;
+	struct tm tm;
+
+	clock_gettime(CLOCK_MONOTONIC, &ts);
+	localtime_r(&ts.tv_sec, &tm);
+	fprintf(stderr, "%02d:%02d:%02d.%03ld gpsesw: ", tm.tm_hour, tm.tm_min,
+		tm.tm_sec, ts.tv_nsec / 1000000);
+	va_start(ap, fmt);
+	vfprintf(stderr, fmt, ap);
+	va_end(ap);
+	fputc('\n', stderr);
+	fflush(stderr);
+}
+
+static void hexdump(const char *tag, const unsigned char *b, size_t n)
+{
+	char line[3 * 64 + 1];
+	size_t i, k = 0;
+
+	fprintf(stderr, "%s (%zu):", tag, n);
+	for (i = 0; i < n; i++) {
+		snprintf(line + k, 4, "%02x ", b[i]);
+		k += 3;
+		if (k >= 3 * 32 || i + 1 == n) {
+			line[k] = '\0';
+			fprintf(stderr, " %s", line);
+			k = 0;
+		}
+	}
+	fputc('\n', stderr);
+	fflush(stderr);
+}
+
+static void sleep_ms(int ms)
+{
+	struct timespec ts = { ms / 1000, (long)(ms % 1000) * 1000000L };
+	while (nanosleep(&ts, &ts) < 0 && errno == EINTR)
+		;
+}
+
+static int power_set(int on)
+{
+	char v = on ? '1' : '0';
+	int fd, r;
+
+	if (o.no_power)
+		return 0;
+	fd = open(o.gpio, O_WRONLY | O_CLOEXEC);
+	if (fd < 0) {
+		logmsg("open(%s): %s", o.gpio, strerror(errno));
+		return -1;
+	}
+	r = write(fd, &v, 1);
+	close(fd);
+	if (r != 1) {
+		logmsg("write(%s='%c'): %s", o.gpio, v, strerror(errno));
+		return -1;
+	}
+	logmsg("GPS_PWR_EN <- %c", v);
+	return 0;
+}
+
+static speed_t num2speed(long n)
+{
+	switch (n) {
+	case 4800: return B4800;
+	case 9600: return B9600;
+	case 19200: return B19200;
+	case 38400: return B38400;
+	case 57600: return B57600;
+	case 115200: return B115200;
+	case 230400: return B230400;
+	case 460800: return B460800;
+	case 921600: return B921600;
+	default: return (speed_t)-1;
+	}
+}
+
+static int serial_open(void)
+{
+	struct termios tio;
+	speed_t sp = num2speed(o.baud);
+	int fd;
+
+	if (sp == (speed_t)-1) {
+		logmsg("unsupported baud %d", o.baud);
+		return -1;
+	}
+	fd = open(o.dev, O_RDWR | O_NOCTTY | O_NONBLOCK | O_CLOEXEC);
+	if (fd < 0) {
+		logmsg("open(%s): %s", o.dev, strerror(errno));
+		return -1;
+	}
+	if (tcgetattr(fd, &tio) < 0) {
+		logmsg("tcgetattr: %s", strerror(errno));
+		close(fd);
+		return -1;
+	}
+	cfmakeraw(&tio);
+	tio.c_cflag |= CLOCAL | CREAD;
+	tio.c_cflag &= ~CRTSCTS;
+	tio.c_cflag &= ~(PARENB | PARODD | CSTOPB);
+	tio.c_cflag = (tio.c_cflag & ~CSIZE) | CS8;
+	tio.c_cc[VMIN] = 0;
+	tio.c_cc[VTIME] = 0;
+	if (cfsetispeed(&tio, sp) < 0 || cfsetospeed(&tio, sp) < 0) {
+		logmsg("cfset*speed(%d): %s", o.baud, strerror(errno));
+		close(fd);
+		return -1;
+	}
+	if (tcsetattr(fd, TCSANOW, &tio) < 0) {
+		logmsg("tcsetattr: %s", strerror(errno));
+		close(fd);
+		return -1;
+	}
+	tcflush(fd, TCIOFLUSH);
+	logmsg("opened %s at %d 8N1, no flow control", o.dev, o.baud);
+	return fd;
+}
+
+static int xwrite(int fd, const unsigned char *b, size_t n)
+{
+	size_t off = 0;
+
+	while (off < n) {
+		size_t p = n - off;
+		ssize_t w;
+
+		if (p > (size_t)o.piece)
+			p = (size_t)o.piece;
+		w = write(fd, b + off, p);
+		if (w < 0) {
+			if (errno == EINTR)
+				continue;
+			if (errno == EAGAIN) {
+				struct pollfd pd = { fd, POLLOUT, 0 };
+				if (poll(&pd, 1, 1000) <= 0) {
+					logmsg("write stalled");
+					return -1;
+				}
+				continue;
+			}
+			logmsg("write(%s): %s", o.dev, strerror(errno));
+			return -1;
+		}
+		off += (size_t)w;
+		if (o.gap_ms && off < n)
+			sleep_ms(o.gap_ms);
+	}
+	return 0;
+}
+
+/*
+ * Read for timeout_ms and dump every byte.  Frames are also printed
+ * individually (chip frames are fe 00 fd ... fc; the GLME banner is
+ * e0 ... e0 01 and is not framed).  Returns the number of bytes read.
+ */
+static size_t rx_dump(int fd, int timeout_ms, const char *what)
+{
+	unsigned char buf[4096];
+	size_t total = 0;
+	struct timespec t0, now;
+	long elapsed;
+
+	clock_gettime(CLOCK_MONOTONIC, &t0);
+	for (;;) {
+		struct pollfd p = { fd, POLLIN, 0 };
+		int r;
+
+		clock_gettime(CLOCK_MONOTONIC, &now);
+		elapsed = (now.tv_sec - t0.tv_sec) * 1000L +
+			  (now.tv_nsec - t0.tv_nsec) / 1000000L;
+		if (elapsed >= timeout_ms)
+			break;
+		r = poll(&p, 1, (int)(timeout_ms - elapsed));
+		if (r < 0) {
+			if (errno == EINTR)
+				continue;
+			break;
+		}
+		if (r == 0)
+			break;
+		{
+			ssize_t n = read(fd, buf, sizeof(buf));
+			if (n <= 0) {
+				if (n < 0 && (errno == EAGAIN || errno == EINTR))
+					continue;
+				break;
+			}
+			total += (size_t)n;
+			hexdump(what, buf, (size_t)n);
+			/* extract complete fe 00 fd .. fc frames from this burst */
+			{
+				size_t i = 0;
+				while (i + 4 < (size_t)n) {
+					size_t j;
+					if (buf[i] != 0xfe || buf[i + 1] != 0x00 ||
+					    buf[i + 2] != 0xfd) {
+						i++;
+						continue;
+					}
+					for (j = i + 3; j < (size_t)n && j < i + 120; j++)
+						if (buf[j] == 0xfc)
+							break;
+					if (j >= (size_t)n || j >= i + 120)
+						break;
+					fprintf(stderr, "        frame cmd=0x%02x sub=0x%02x len=%zu: ",
+						buf[i + 3], buf[i + 4], j - i + 1);
+					{
+						size_t k;
+						for (k = i; k <= j; k++)
+							fprintf(stderr, "%02x", buf[k]);
+					}
+					fputc('\n', stderr);
+					fflush(stderr);
+					g_frames++;
+					g_flen = j - i + 1;
+					if (g_flen > sizeof(g_frame))
+						g_flen = sizeof(g_frame);
+					memcpy(g_frame, buf + i, g_flen);
+					i = j + 1;
+				}
+			}
+		}
+	}
+	if (!total && what)
+		fprintf(stderr, "        (%s: no bytes in %d ms)\n", what, timeout_ms);
+	return total;
+}
+
+/* Send one request and dump the reply.  Returns bytes received. */
+static size_t req(int fd, const unsigned char *b, size_t n, const char *what)
+{
+	logmsg("tx %s", what);
+	hexdump("        tx", b, n);
+	if (xwrite(fd, b, n) < 0)
+		return 0;
+	return rx_dump(fd, o.timeout_ms, "        rx");
+}
+
+/* --------------------------------------------------------------- frames */
+
+static int read_item(int fd, unsigned item, const char *why)
+{
+	unsigned char f[6];
+	char label[96];
+
+	f[0] = 0xff;
+	f[1] = 0x00;
+	f[2] = 0xfd;
+	f[3] = 0x1f;
+	f[4] = (unsigned char)item;
+	f[5] = 0xfc;
+	snprintf(label, sizeof(label), "read item 0x%02x (%s)", item, why);
+	g_frames = 0;
+	g_flen = 0;
+	req(fd, f, sizeof(f), label);
+	if (g_flen >= 10 && g_frame[3] == 0x1f && g_frame[4] == item) {
+		unsigned long v = (unsigned long)g_frame[5] |
+				  (unsigned long)g_frame[6] << 8 |
+				  (unsigned long)g_frame[7] << 16 |
+				  (unsigned long)g_frame[8] << 24;
+		logmsg("item 0x%02x = 0x%08lx", item, v);
+	}
+	return 0;
+}
+
+static int bank_select(int fd, int bank)
+{
+	unsigned char f[10];
+	char label[64];
+	size_t got;
+
+	f[0] = 0xfe;
+	f[1] = 0x00;
+	f[2] = 0xfd;
+	f[3] = 0x61;
+	f[4] = 0x16;
+	f[5] = (unsigned char)bank;
+	f[6] = f[7] = f[8] = 0x00;
+	f[9] = 0xfc;
+	snprintf(label, sizeof(label), "item 0x16 <- bank %d", bank);
+	got = req(fd, f, sizeof(f), label);
+	if (!got)
+		logmsg("bank select %d: no reply (expected)", bank);
+	return 0;
+}
+
+/*
+ * One data frame: fe <nwords> fd 61 17 de c0 <alo> <ahi> <data> fc.
+ * nwords = ceil(nbytes/4); <= 255 by construction (chunk <= 1020).
+ */
+static int data_frame(int fd, unsigned addr, const unsigned char *data,
+		      size_t nbytes)
+{
+	unsigned char hdr[9];
+	unsigned char ft = 0xfc;
+	unsigned nwords = (unsigned)((nbytes + 3) / 4);
+	size_t sent_before = 0;
+
+	(void)sent_before;
+	if (nwords > 255) {
+		logmsg("frame too large: %zu bytes -> %u words", nbytes, nwords);
+		return -1;
+	}
+	hdr[0] = o.soff;
+	hdr[1] = (unsigned char)nwords;
+	hdr[2] = 0xfd;
+	hdr[3] = 0x61;
+	hdr[4] = 0x17;
+	hdr[5] = 0xde;
+	hdr[6] = 0xc0;
+	hdr[7] = (unsigned char)(addr & 0xff);
+	hdr[8] = (unsigned char)((addr >> 8) & 0xff);
+
+	if (xwrite(fd, hdr, sizeof(hdr)) < 0)
+		return -1;
+	if (nbytes && xwrite(fd, data, nbytes) < 0)
+		return -1;
+	if (xwrite(fd, &ft, 1) < 0)
+		return -1;
+	return 0;
+}
+
+static int crc_request(int fd, unsigned addr, unsigned len)
+{
+	unsigned char f[10];
+
+	f[0] = 0xfe;
+	f[1] = 0x00;
+	f[2] = 0xfd;
+	f[3] = 0x21;
+	f[4] = 0x18;
+	f[5] = (unsigned char)(addr & 0xff);
+	f[6] = (unsigned char)((addr >> 8) & 0xff);
+	f[7] = (unsigned char)(len & 0xff);
+	f[8] = (unsigned char)((len >> 8) & 0xff);
+	f[9] = 0xfc;
+	g_frames = 0;
+	g_flen = 0;
+	req(fd, f, sizeof(f), "CRC request 21 18");
+	if (g_flen >= 10 && g_frame[3] == 0x2f && g_frame[4] == 0x15) {
+		unsigned long v = (unsigned long)g_frame[5] |
+				  (unsigned long)g_frame[6] << 8 |
+				  (unsigned long)g_frame[7] << 16 |
+				  (unsigned long)g_frame[8] << 24;
+		logmsg("CRC ACK 2f15 value=0x%08lx", v);
+		crc_ack = 1;
+		piece_acks++;
+		return 1;
+	}
+	logmsg("CRC ACK missing (frames=%u)", g_frames);
+	crc_ack = 0;
+	piece_fails++;
+	return 0;
+}
+
+/* Host CRC-32 (zlib polynomial) for comparison with the chip's 2f15 value. */
+static uint32_t crc32_host(const unsigned char *p, size_t n)
+{
+	uint32_t c = 0xffffffffu;
+	size_t i;
+	int k;
+
+	for (i = 0; i < n; i++) {
+		c ^= p[i];
+		for (k = 0; k < 8; k++)
+			c = (c >> 1) ^ (0xedb88320u & (0u - (c & 1u)));
+	}
+	return ~c;
+}
+
+/* ------------------------------------------------------------- sequence */
+
+/* Frames recovered on this hardware (docs/reports/gps-esw.md, prologue). */
+static const unsigned char f_nv_write[10] = {
+	0xfe, 0x00, 0xfd, 0x00, 0x1b, 0x07, 0x00, 0x00, 0x00, 0xfc };
+static const unsigned char f_nv_read[6] = {
+	0xff, 0x00, 0xfd, 0x00, 0x1b, 0xfc };
+static const unsigned char f_status[6] = {
+	0xff, 0x00, 0xfd, 0x40, 0x1a, 0xfc };
+static const unsigned char f_reg0[6] = {
+	0xff, 0x00, 0xfd, 0x00, 0x00, 0xfc };
+static const unsigned char f_asic_ready[6] = {
+	0xff, 0x00, 0xfd, 0x1f, 0x95, 0xfc };
+static const unsigned char f_glme[10] = {
+	0xfe, 0x00, 0xfd, 0x00, 0x00, 0x55, 0xaa, 0x00, 0xff, 0xfc };
+
+/* Parse a hex string ("fe00fd..." — spaces/colons allowed) and send it. */
+static int send_hex(int fd, const char *hex, const char *what)
+{
+	unsigned char buf[4096];
+	size_t n = 0;
+	const char *p = hex;
+
+	while (*p && n < sizeof(buf)) {
+		int hi, lo;
+
+		if (*p == ' ' || *p == ':' || *p == ',') {
+			p++;
+			continue;
+		}
+		hi = *p >= '0' && *p <= '9' ? *p - '0' :
+		     *p >= 'a' && *p <= 'f' ? *p - 'a' + 10 :
+		     *p >= 'A' && *p <= 'F' ? *p - 'A' + 10 : -1;
+		if (hi < 0 || !p[1])
+			return -1;
+		p++;
+		lo = *p >= '0' && *p <= '9' ? *p - '0' :
+		     *p >= 'a' && *p <= 'f' ? *p - 'a' + 10 :
+		     *p >= 'A' && *p <= 'F' ? *p - 'A' + 10 : -1;
+		if (lo < 0)
+			return -1;
+		p++;
+		buf[n++] = (unsigned char)(hi << 4 | lo);
+	}
+	req(fd, buf, n, what);
+	return 0;
+}
+
+static int prologue(int fd)
+{
+	unsigned char aa[16];
+	size_t got, answered = 0;
+
+	memset(aa, 0x80, sizeof(aa));
+	logmsg("autobaud burst 16 x 0x80");
+	if (xwrite(fd, aa, sizeof(aa)) < 0)
+		return -1;
+	sleep_ms(50);
+	rx_dump(fd, 150, "        autobaud-rx");
+
+	got = req(fd, f_nv_write, sizeof(f_nv_write), "0x001b <- 07 (NVRAM word 7)");
+	if (got)
+		answered++;
+	got = req(fd, f_nv_read, sizeof(f_nv_read), "read 0x001b");
+	answered += got > 0;
+	got = req(fd, f_status, sizeof(f_status), "read 0x401a");
+	answered += got > 0;
+	got = req(fd, f_reg0, sizeof(f_reg0), "read register 0 (HW version)");
+	answered += got > 0;
+	got = req(fd, f_asic_ready, sizeof(f_asic_ready), "read item 0x95 (asic ready)");
+	answered += got > 0;
+
+	logmsg("prologue: %zu of 5 exchanges answered", answered);
+	return answered >= 3 ? 0 : -1;
+}
+
+static void item_scan(int fd)
+{
+	unsigned i;
+
+	for (i = 0x90; i <= 0x9f; i++)
+		read_item(fd, i, "scan");
+}
+
+static int send_piece(int fd, struct blk *b, size_t base, size_t len)
+{
+	unsigned char *p = b->data + base;
+	size_t sent = 0;
+
+	while (sent < len) {
+		size_t chunk = len - sent;
+
+		if (chunk > (size_t)o.chunk)
+			chunk = (size_t)o.chunk;
+
+		if (o.variant == 1) {
+			size_t aligned = chunk & ~(size_t)3;
+			size_t tail = chunk - aligned;
+
+			logmsg("chunk at 0x%04x: %zu bytes (aligned %zu tail %zu)",
+			       b->addr + (unsigned)base + (unsigned)sent, chunk,
+			       aligned, tail);
+			if (aligned &&
+			    data_frame(fd, b->addr + (unsigned)base + (unsigned)sent,
+				       p + sent, aligned) < 0)
+				return -1;
+			if (tail) {
+				unsigned a = (b->addr + (unsigned)base +
+					      (unsigned)sent + (unsigned)chunk - 4) &
+					     0xffff;
+				logmsg("odd tail: 4 bytes at 0x%04x", a);
+				if (data_frame(fd, a,
+					       p + sent + chunk - 4, 4) < 0)
+					return -1;
+			}
+			/* no reply expected; keep the line drained */
+			rx_dump(fd, 20, "        frame-rx");
+		} else if (o.variant == 2) {
+			size_t off = 0;
+
+			while (off < chunk) {
+				size_t pl = chunk - off;
+
+				if (pl > (size_t)o.piece)
+					pl = (size_t)o.piece;
+				logmsg("piece at 0x%04x: %zu bytes",
+				       b->addr + (unsigned)base + (unsigned)sent +
+				       (unsigned)off, pl);
+				if (data_frame(fd, b->addr + (unsigned)base +
+					       (unsigned)sent + (unsigned)off,
+					       p + sent + off, pl) < 0)
+					return -1;
+				off += pl;
+				rx_dump(fd, 20, "        piece-rx");
+			}
+		} else {
+			logmsg("chunk at 0x%04x: %zu bytes (single frame)",
+			       b->addr + (unsigned)base + (unsigned)sent, chunk);
+			if (data_frame(fd, b->addr + (unsigned)base + (unsigned)sent,
+				       p + sent, chunk) < 0)
+				return -1;
+			rx_dump(fd, 20, "        frame-rx");
+		}
+		sent += chunk;
+	}
+	return 0;
+}
+
+/*
+ * Send one record.  The stock loader transfers at most [this+4] = 4096
+ * bytes per piece and asks for a CRC after each piece (gps-esw.md §4), so
+ * the CRC boundary is the 4096-byte piece, not the whole record.
+ */
+static int send_one_block(int fd, struct blk *b)
+{
+	size_t len = b->len;
+	size_t done = 0;
+	size_t pmax = (size_t)o.piece_max;
+
+	if (o.limit > 0 && (size_t)o.limit < len)
+		len = (size_t)o.limit;
+	if (pmax == 0)
+		pmax = 0x1000;
+
+	piece_acks = piece_fails = 0;
+	logmsg("== block %s bank %d addr 0x%04x len %zu (host crc32 0x%08x)",
+	       b->name, b->bank, b->addr, len, crc32_host(b->data, len));
+
+	while (done < len) {
+		size_t pl = len - done;
+
+		if (pl > pmax)
+			pl = pmax;
+		logmsg("-- piece at 0x%04x, %zu bytes", b->addr + (unsigned)done, pl);
+		if (send_piece(fd, b, done, pl) < 0)
+			return -1;
+		if (crc_request(fd, b->addr + (unsigned)done, (unsigned)pl) == 0)
+			logmsg("piece at 0x%04x/%zu: no 2f15 ack", b->addr + (unsigned)done, pl);
+		done += pl;
+	}
+	b->sent = len;
+	return 0;
+}
+
+static int load_block(const char *dir, struct blk *b)
+{
+	char path[512];
+	FILE *f;
+	long sz;
+
+	snprintf(path, sizeof(path), "%s/%s", dir, b->name);
+	f = fopen(path, "rb");
+	if (!f) {
+		logmsg("missing block file %s: %s", path, strerror(errno));
+		return -1;
+	}
+	if (fseek(f, 0, SEEK_END) < 0 || (sz = ftell(f)) < 0 ||
+	    fseek(f, 0, SEEK_SET) < 0) {
+		logmsg("%s: seek failed", path);
+		fclose(f);
+		return -1;
+	}
+	b->data = malloc((size_t)sz ? (size_t)sz : 1);
+	if (!b->data) {
+		fclose(f);
+		return -1;
+	}
+	b->len = fread(b->data, 1, (size_t)sz, f);
+	fclose(f);
+	logmsg("loaded %s: %zu bytes", path, b->len);
+	return 0;
+}
+
+int main(int argc, char **argv)
+{
+	static const struct option opts[] = {
+		{ "device",     required_argument, NULL, 'd' },
+		{ "baud",       required_argument, NULL, 'b' },
+		{ "gpio",       required_argument, NULL, 'g' },
+		{ "dir",        required_argument, NULL, 'D' },
+		{ "variant",    required_argument, NULL, 'V' },
+		{ "chunk",      required_argument, NULL, 'c' },
+		{ "piece",      required_argument, NULL, 'p' },
+		{ "piece-max",  required_argument, NULL, 'C' },
+		{ "gap",        required_argument, NULL, 'G' },
+		{ "timeout",    required_argument, NULL, 't' },
+		{ "limit",      required_argument, NULL, 'l' },
+		{ "index",      required_argument, NULL, 'i' },
+		{ "no-banksel", no_argument,       NULL, 'e' },
+		{ "query",      no_argument,       NULL, 'q' },
+		{ "no-glme",    no_argument,       NULL, 'x' },
+		{ "no-power",   no_argument,       NULL, 'n' },
+		{ "power-delay", required_argument, NULL, 'P' },
+		{ "power-off",  required_argument, NULL, 'O' },
+		{ "soff",       required_argument, NULL, 'S' },
+		{ "glme-listen", required_argument, NULL, 'L' },
+		{ "write",      required_argument, NULL, 'w' },
+		{ "post",       required_argument, NULL, 'z' },
+		{ "help",       no_argument,       NULL, 'h' },
+		{ NULL, 0, NULL, 0 }
+	};
+	int fd, c, i, rc = 0;
+	int cur_bank = -1;
+	int ack;
+
+	while ((c = getopt_long(argc, argv, "d:b:g:D:V:c:p:C:G:t:L:l:i:eqxnQO:P:S:w:z:h",
+				opts, NULL)) != -1) {
+		switch (c) {
+		case 'd': o.dev = optarg; break;
+		case 'b': o.baud = atoi(optarg); break;
+		case 'g': o.gpio = optarg; break;
+		case 'D': o.dir = optarg; break;
+		case 'V': o.variant = atoi(optarg); break;
+		case 'c': o.chunk = atoi(optarg); break;
+		case 'p': o.piece = atoi(optarg); break;
+		case 'C': o.piece_max = atoi(optarg); break;
+		case 'G': o.gap_ms = atoi(optarg); break;
+		case 't': o.timeout_ms = atoi(optarg); break;
+		case 'L': o.glme_ms = atoi(optarg); break;
+		case 'l': o.limit = atol(optarg); break;
+		case 'i': o.only_idx = atoi(optarg); break;
+		case 'e': o.no_banksel = 1; break;
+		case 'q': o.query_only = 1; break;
+		case 'Q': o.scan_after = 1; break;
+		case 'x': o.no_glme = 1; break;
+		case 'n': o.no_power = 1; break;
+		case 'P': o.power_delay_ms = atoi(optarg); break;
+		case 'O': o.power_off_ms = atoi(optarg); break;
+		case 'S': o.soff = (unsigned char)strtoul(optarg, NULL, 16); break;
+		case 'w':
+			if (o.nwrite < (int)(sizeof(o.writes) / sizeof(o.writes[0])))
+				o.writes[o.nwrite++] = optarg;
+			break;
+		case 'z':
+			if (o.npost < (int)(sizeof(o.post) / sizeof(o.post[0])))
+				o.post[o.npost++] = optarg;
+			break;
+		case 'h':
+		default:
+			fprintf(stderr,
+				"usage: %s [-d DEV] [-b BAUD] [-g GPIO] [-D DIR]\n"
+				"       [-V 1|2|3] [-c CHUNK] [-p PIECE] [-C PIECE_MAX] [-G MS] [-t MS]\n"
+				"       [-L GLME_MS] [-O OFF_MS]\n"
+				"       [-l BYTES] [-i IDX] [-e] [-q] [-x] [-n] [-P MS]\n"
+				"       [-S HEX] [-w HEX] [-z HEX] [-Q]\n", argv[0]);
+			return c == 'h' ? 0 : 2;
+		}
+	}
+	if (o.chunk < 4 || o.chunk > 1020) {
+		logmsg("chunk must be 4..1020");
+		return 2;
+	}
+	if (o.piece < 1 || o.piece > 4096)
+		return 2;
+
+	{
+		static const struct { int bank; unsigned addr; const char *name; } t[4] = {
+			{ 0, 0x7000, "b2-4752_B2-0.bin" },
+			{ 0, 0x7fec, "b2-4752_B2-1.bin" },
+			{ 1, 0x8000, "b2-4752_B2-2.bin" },
+			{ 0, 0x7fd2, "b2-4752_B2-3.bin" },
+		};
+		for (i = 0; i < nblocks; i++) {
+			blocks[i].bank = t[i].bank;
+			blocks[i].addr = t[i].addr;
+			blocks[i].name = t[i].name;
+		}
+	}
+
+	if (!o.query_only) {
+		for (i = 0; i < nblocks; i++) {
+			if (o.only_idx >= 0 && i != o.only_idx)
+				continue;
+			if (load_block(o.dir, &blocks[i]) < 0)
+				return 3;
+		}
+	}
+
+	if (power_set(0) < 0)
+		return 3;
+	sleep_ms(o.power_off_ms);
+	if (power_set(1) < 0)
+		return 3;
+	sleep_ms(o.power_delay_ms);
+
+	fd = serial_open();
+	if (fd < 0)
+		return 3;
+
+	if (prologue(fd) < 0) {
+		logmsg("prologue did not answer; chip state unknown, stopping");
+		rc = 4;
+		goto out;
+	}
+	for (i = 0; i < o.nwrite; i++) {
+		char label[64];
+
+		snprintf(label, sizeof(label), "-w frame %d", i);
+		if (send_hex(fd, o.writes[i], label) < 0) {
+			logmsg("bad hex in -w %s", o.writes[i]);
+			rc = 2;
+			goto out;
+		}
+	}
+
+	/* cheap state read before touching the patch */
+	read_item(fd, 0x94, "bank readback before upload");
+	read_item(fd, 0x95, "asic ready before upload");
+
+	if (o.query_only) {
+		item_scan(fd);
+		goto out;
+	}
+
+	for (i = 0; i < nblocks; i++) {
+		struct blk *b = &blocks[i];
+
+		if (o.only_idx >= 0 && i != o.only_idx)
+			continue;
+		if (!b->data)
+			continue;
+
+		if (!o.no_banksel && b->bank != cur_bank) {
+			bank_select(fd, b->bank);
+			cur_bank = b->bank;
+			if (b->bank)
+				read_item(fd, 0x94, "bank readback after switch");
+		}
+
+		/* send_one_block() ends with the CRC request; ask it for the
+		 * decoded 0x2f15 verdict. */
+		if (send_one_block(fd, b) < 0) {
+			rc = 5;
+			break;
+		}
+		ack = piece_acks > 0 && piece_fails == 0;
+		logmsg("block %d: %zu bytes, host crc32 0x%08x, acked pieces %d/%d",
+		       i, b->sent, crc32_host(b->data, b->sent),
+		       piece_acks, piece_acks + piece_fails);
+		if (!ack) {
+			/* Tell "CRC frame rejected" from "chip mute". */
+			unsigned before = g_frames;
+
+			read_item(fd, 0x95, "mute probe after failed block");
+			logmsg("chip %s after block %d; stopping",
+			       g_frames > before ? "still answering" : "is mute", i);
+			rc = 6;
+			break;
+		}
+	}
+	if (rc)
+		goto out;
+
+	logmsg("all blocks sent; post-patch state");
+	for (i = 0; i < o.npost; i++) {
+		char label[64];
+
+		snprintf(label, sizeof(label), "-z post frame %d", i);
+		if (send_hex(fd, o.post[i], label) < 0) {
+			logmsg("bad hex in -z %s", o.post[i]);
+			rc = 2;
+			goto out;
+		}
+	}
+	if (o.scan_after)
+		item_scan(fd);
+	read_item(fd, 0x94, "bank readback after upload");
+	read_item(fd, 0x95, "asic ready after upload");
+	req(fd, f_reg0, sizeof(f_reg0), "read register 0 after upload");
+	req(fd, f_nv_read, sizeof(f_nv_read), "read 0x001b after upload");
+
+	if (!o.no_glme) {
+		logmsg("GLME switch");
+		if (xwrite(fd, f_glme, sizeof(f_glme)) < 0)
+			rc = 5;
+		else
+			rx_dump(fd, o.glme_ms, "        glme-rx");
+	}
+
+	/* final drain so nothing is lost from the transcript */
+	rx_dump(fd, 100, "        tail");
+out:
+	close(fd);
+	return rc;
+}
diff --git a/parity/userspace/gps/src/gpsprobe.c b/parity/userspace/gps/src/gpsprobe.c
new file mode 100644
index 0000000..bac52f8
--- /dev/null
+++ b/parity/userspace/gps/src/gpsprobe.c
@@ -0,0 +1,299 @@
+/*
+ * gpsprobe - raw serial experiment driver for the BCM4752 on j7elte
+ *
+ * Rationale: the chip's bring-up is a byte-level exchange, so the only way
+ * to iterate on device is a tool that can (a) set an arbitrary 8N1 line,
+ * (b) emit arbitrary byte sequences with explicit pacing, and (c) record
+ * everything the chip says in a hexdump.  This is the "scope" we have.
+ *
+ * Usage:
+ *   gpsprobe [-d DEV] [-b BAUD] OP [OP ...]
+ *
+ * Ops:
+ *   w:HEX        write raw bytes (whitespace/colons in HEX ignored)
+ *   s:MS         sleep
+ *   r:MS         read for MS milliseconds, hexdump everything
+ *   f            tcflush(TCIFLUSH)
+ *   P:0|1        write 0|1 to the GPS power-enable sysfs node
+ *   B:N          switch baud to N (re-apply termios without closing)
+ *   Q            quit
+ *
+ * Exit code 0 always (this is a probe, not a test); the transcript is the
+ * result.  Build: cc -O2 -o gpsprobe gpsprobe.c
+ */
+#define _GNU_SOURCE
+#include <errno.h>
+#include <fcntl.h>
+#include <poll.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/ioctl.h>
+#include <termios.h>
+#include <time.h>
+#include <unistd.h>
+
+static const char *dev = "/dev/ttySAC0";
+static const char *pwr = "/sys/class/sec/gps/GPS_PWR_EN/value";
+static speed_t baud = B921600;
+static long baud_num = 921600;
+static int hwfc;
+
+static speed_t num2speed(long n)
+{
+	switch (n) {
+	case 1200: return B1200;
+	case 2400: return B2400;
+	case 4800: return B4800;
+	case 9600: return B9600;
+	case 19200: return B19200;
+	case 38400: return B38400;
+	case 57600: return B57600;
+	case 115200: return B115200;
+	case 230400: return B230400;
+	case 460800: return B460800;
+	case 500000: return B500000;
+	case 576000: return B576000;
+	case 921600: return B921600;
+	case 1000000: return B1000000;
+	case 1500000: return B1500000;
+	case 2000000: return B2000000;
+	case 3000000: return B3000000;
+	case 4000000: return B4000000;
+	default: return (speed_t)-1;
+	}
+}
+
+static int set_line(int fd, speed_t sp)
+{
+	struct termios t;
+
+	if (tcgetattr(fd, &t) < 0)
+		return -1;
+	cfmakeraw(&t);
+	t.c_cflag &= ~(tcflag_t)(CSTOPB | PARENB | PARODD | CSIZE);
+	if (!hwfc)
+		t.c_cflag &= ~(tcflag_t)CRTSCTS;
+	t.c_cflag |= CS8 | CLOCAL | CREAD;
+	t.c_iflag &= ~(tcflag_t)(IXON | IXOFF | IXANY);
+	t.c_cc[VMIN] = 0;
+	t.c_cc[VTIME] = 0;
+	cfsetispeed(&t, sp);
+	cfsetospeed(&t, sp);
+	return tcsetattr(fd, TCSANOW, &t);
+}
+
+static long now_ms(void)
+{
+	struct timespec ts;
+	clock_gettime(CLOCK_MONOTONIC, &ts);
+	return ts.tv_sec * 1000L + ts.tv_nsec / 1000000L;
+}
+
+static int hexval(int c)
+{
+	if (c >= '0' && c <= '9') return c - '0';
+	if (c >= 'a' && c <= 'f') return c - 'a' + 10;
+	if (c >= 'A' && c <= 'F') return c - 'A' + 10;
+	return -1;
+}
+
+static size_t parse_hex(const char *s, uint8_t *out, size_t max)
+{
+	size_t n = 0;
+	int hi = -1;
+
+	for (; *s && n < max; s++) {
+		int v;
+		if (*s == ' ' || *s == ':' || *s == '-' || *s == '_')
+			continue;
+		v = hexval((unsigned char)*s);
+		if (v < 0) {
+			fprintf(stderr, "bad hex char '%c'\n", *s);
+			exit(2);
+		}
+		if (hi < 0) {
+			hi = v;
+		} else {
+			out[n++] = (uint8_t)((hi << 4) | v);
+			hi = -1;
+		}
+	}
+	if (hi >= 0) {
+		fprintf(stderr, "odd hex digit count\n");
+		exit(2);
+	}
+	return n;
+}
+
+static int read_for(int fd, long ms)
+{
+	uint8_t buf[512];
+	long end = now_ms() + ms;
+	size_t total = 0;
+	long t0 = now_ms();
+
+	while (now_ms() < end) {
+		struct pollfd p = { .fd = fd, .events = POLLIN };
+		long left = end - now_ms();
+		int rv = poll(&p, 1, left > 0 ? (int)left : 0);
+		ssize_t n;
+
+		if (rv < 0) {
+			if (errno == EINTR)
+				continue;
+			perror("poll");
+			return -1;
+		}
+		if (rv == 0)
+			break;
+		n = read(fd, buf, sizeof(buf));
+		if (n < 0) {
+			if (errno == EINTR || errno == EAGAIN)
+				continue;
+			perror("read");
+			return -1;
+		}
+		if (n == 0)
+			continue;
+		printf("  rx @%ldms %zd B:", now_ms() - t0, n);
+		for (ssize_t i = 0; i < n; i++)
+			printf(" %02x", buf[i]);
+		printf("   |");
+		for (ssize_t i = 0; i < n; i++) {
+			unsigned c = buf[i];
+			putchar(c >= 0x20 && c < 0x7f ? (int)c : '.');
+		}
+		printf("|\n");
+		total += (size_t)n;
+	}
+	if (total == 0)
+		printf("  rx @%ldms: (no bytes in %ld ms)\n", now_ms() - t0, ms);
+	return (int)total;
+}
+
+int main(int argc, char **argv)
+{
+	int fd, i = 1;
+	int power_fd = -1;
+
+	if (argc < 2) {
+		fprintf(stderr,
+			"usage: %s [-d DEV] [-b BAUD] [-p POWER_PATH] [-k] "
+			"w:HEX|s:MS|r:MS|f|P:0|1|B:N|C:0|1|R:a|d|D:a|d ...\n",
+			argv[0]);
+		return 2;
+	}
+	/* "keep power off": do not touch the rail at all (default is also
+	 * untouched unless a P: op appears) */
+	for (; i < argc && argv[i][0] == '-'; i++) {
+		if (!strcmp(argv[i], "-d") && i + 1 < argc) {
+			dev = argv[++i];
+		} else if (!strcmp(argv[i], "-b") && i + 1 < argc) {
+			baud_num = strtol(argv[++i], NULL, 0);
+			baud = num2speed(baud_num);
+			if (baud == (speed_t)-1) {
+				fprintf(stderr, "unsupported baud\n");
+				return 2;
+			}
+		} else if (!strcmp(argv[i], "-p") && i + 1 < argc) {
+			pwr = argv[++i];
+		} else {
+			fprintf(stderr, "unknown option %s\n", argv[i]);
+			return 2;
+		}
+	}
+
+	fd = open(dev, O_RDWR | O_NOCTTY | O_NONBLOCK);
+	if (fd < 0) {
+		perror(dev);
+		return 1;
+	}
+	if (set_line(fd, baud) < 0) {
+		perror("tcsetattr");
+		return 1;
+	}
+	printf("gpsprobe: %s 8N1 raw, baud=%ld, ops=%d\n", dev, baud_num,
+	       argc - i);
+
+	for (; i < argc; i++) {
+		const char *op = argv[i];
+
+		if (!strncmp(op, "w:", 2)) {
+			uint8_t b[1024];
+			size_t n = parse_hex(op + 2, b, sizeof(b));
+			ssize_t w = write(fd, b, n);
+			printf("tx %zu B -> %zd", n, w);
+			if (w < 0)
+				printf(" (%s)", strerror(errno));
+			printf("\n");
+			if (w < 0)
+				return 1;
+			tcdrain(fd);
+		} else if (!strncmp(op, "s:", 2)) {
+			long ms = strtol(op + 2, NULL, 0);
+			printf("sleep %ld ms\n", ms);
+			usleep((useconds_t)ms * 1000);
+		} else if (!strncmp(op, "r:", 2)) {
+			long ms = strtol(op + 2, NULL, 0);
+			if (read_for(fd, ms) < 0)
+				return 1;
+		} else if (!strcmp(op, "f")) {
+			tcflush(fd, TCIFLUSH);
+			printf("flush\n");
+		} else if (!strncmp(op, "P:", 2)) {
+			if (power_fd < 0)
+				power_fd = open(pwr, O_WRONLY);
+			if (power_fd < 0) {
+				perror(pwr);
+				return 1;
+			}
+			if (write(power_fd, op + 2, 1) != 1) {
+				perror("power write");
+				return 1;
+			}
+			printf("power <- %c\n", op[2]);
+		} else if (!strncmp(op, "C:", 2)) {
+			hwfc = op[2] == '1';
+			if (!hwfc) {
+				/* clear AFC explicitly, like a fresh termios */
+				struct termios t;
+				tcgetattr(fd, &t);
+				t.c_cflag &= ~(tcflag_t)CRTSCTS;
+				tcsetattr(fd, TCSANOW, &t);
+			}
+			if (set_line(fd, baud) < 0) {
+				perror("set_line");
+				return 1;
+			}
+			printf("crtscts=%d\n", hwfc);
+		} else if (!strncmp(op, "R:", 2)) {
+			int bits = op[2] == 'a' ? TIOCMBIS : TIOCMBIC;
+			int m = TIOCM_RTS;
+			if (ioctl(fd, bits, &m) < 0)
+				perror("TIOCM RTS");
+			else
+				printf("RTS %s\n", op[2] == 'a' ? "assert" : "deassert");
+		} else if (!strncmp(op, "D:", 2)) {
+			int bits = op[2] == 'a' ? TIOCMBIS : TIOCMBIC;
+			int m = TIOCM_DTR;
+			if (ioctl(fd, bits, &m) < 0)
+				perror("TIOCM DTR");
+			else
+				printf("DTR %s\n", op[2] == 'a' ? "assert" : "deassert");
+		} else if (!strncmp(op, "B:", 2)) {
+			speed_t sp = num2speed(strtol(op + 2, NULL, 0));
+			if (sp == (speed_t)-1 || set_line(fd, sp) < 0) {
+				perror("baud switch");
+				return 1;
+			}
+			printf("baud -> %s\n", op + 2);
+		} else {
+			fprintf(stderr, "bad op %s\n", op);
+			return 2;
+		}
+	}
+	close(fd);
+	return 0;
+}
diff --git a/parity/userspace/gps/src/j7elte-gpsd.c b/parity/userspace/gps/src/j7elte-gpsd.c
new file mode 100644
index 0000000..ea697a0
--- /dev/null
+++ b/parity/userspace/gps/src/j7elte-gpsd.c
@@ -0,0 +1,1594 @@
+/*
+ * j7elte-gpsd - minimal BCM4752 GPS bridge for Samsung Galaxy J7 (j7elte)
+ *
+ * The vendor stack (/system/bin/gpsd, Broadcom "glgps") drives the BCM4752
+ * over UART0 (/dev/ttySAC0) with Broadcom's proprietary binary "GLL" protocol
+ * and synthesises NMEA itself; the Android HAL (gps.default.so) is only a
+ * socket client of that daemon (/dev/socket/gps) and never touches the UART.
+ *
+ * This daemon does the two things that are actually evidenced by the vendor
+ * configuration and the kernel driver:
+ *   1. power sequencing through /sys/class/sec/gps/GPS_PWR_EN/value
+ *      (gpio_export_link() in drivers/gps/sec_gps_bcm4752.c),
+ *   2. raw 8N1 UART setup on /dev/ttySAC0 at the vendor baud rate
+ *      (BaudRate="921600", GpioDelayMs="250" in /system/etc/gps.xml).
+ *
+ * Everything the chip emits is then inspected.  Only complete NMEA 0183
+ * sentences are forwarded to consumers (a PTY for gpsd, and a Unix stream
+ * socket for anything else).  Non-NMEA bytes are counted and, optionally,
+ * dumped to a raw log so that the still-unknown Broadcom init exchange can be
+ * characterised on real hardware.
+ *
+ * --init replays the part of Broadcom's BRI bring-up that was recovered
+ * byte-for-byte from /system/bin/gpsd (autobaud burst, Bri_GetOutOfLegacy,
+ * Bri_RequestHwVersion, Bri_RequestDebugSfr).  Nothing outside those
+ * verified frames is written to the UART unless the user passes
+ * --esw DIR, which additionally uploads the 4752_B2 RAM patch extracted
+ * from their own /system/bin/gpsd (see docs/reports/gps-esw-upload.md)
+ * and, with --glme, sends the GLME switch.  See
+ * parity/reports/gps-init-impl.md for the evidence and the residual gap.
+ *
+ * License: MIT
+ */
+
+#define _GNU_SOURCE
+#include <errno.h>
+#include <fcntl.h>
+#include <getopt.h>
+#include <poll.h>
+#include <signal.h>
+#include <stdarg.h>
+#include <stdbool.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/socket.h>
+#include <sys/stat.h>
+#include <sys/types.h>
+#include <sys/un.h>
+#include <termios.h>
+#include <time.h>
+#include <unistd.h>
+
+#define DEFAULT_DEV       "/dev/ttySAC0"
+#define DEFAULT_BAUD      921600
+#define DEFAULT_GPIO      "/sys/class/sec/gps/GPS_PWR_EN/value"
+#define DEFAULT_RUNDIR    "/run/j7elte-gpsd"
+#define DEFAULT_PTY_LINK  "tty"
+#define DEFAULT_SOCK      "nmea.sock"
+#define DEFAULT_PWR_DELAY 250      /* GpioDelayMs in /system/etc/gps.xml */
+#define MAX_CLIENTS       8
+#define NMEA_MAX          128      /* NMEA 0183 is 82 chars incl. CRLF */
+#define RX_CHUNK          4096
+
+static struct {
+	const char *dev;
+	int baud;
+	const char *gpio;
+	int power_delay_ms;
+	const char *rundir;
+	const char *sock_name;
+	bool use_power;
+	bool foreground;
+	bool verbose;
+	bool probe_baud;
+	bool do_init;
+	bool glme;
+	const char *esw_dir;
+	const char *raw_log;
+} cfg = {
+	.dev = DEFAULT_DEV,
+	.baud = DEFAULT_BAUD,
+	.gpio = DEFAULT_GPIO,
+	.power_delay_ms = DEFAULT_PWR_DELAY,
+	.rundir = DEFAULT_RUNDIR,
+	.sock_name = DEFAULT_SOCK,
+	.use_power = true,
+	.foreground = false,
+	.verbose = false,
+	.probe_baud = false,
+	.do_init = false,
+	.glme = false,
+	.esw_dir = NULL,
+	.raw_log = NULL,
+};
+
+static volatile sig_atomic_t g_stop;
+static int g_sigpipe[2] = { -1, -1 };
+
+static void on_signal(int sig)
+{
+	(void)sig;
+	g_stop = 1;
+	if (g_sigpipe[1] >= 0) {
+		ssize_t r = write(g_sigpipe[1], "x", 1);
+		(void)r;
+	}
+}
+
+static void logmsg(const char *fmt, ...)
+{
+	va_list ap;
+	struct timespec ts;
+	struct tm tm;
+
+	clock_gettime(CLOCK_REALTIME, &ts);
+	localtime_r(&ts.tv_sec, &tm);
+	fprintf(stderr, "%04d-%02d-%02d %02d:%02d:%02d.%03ld j7elte-gpsd: ",
+		tm.tm_year + 1900, tm.tm_mon + 1, tm.tm_mday,
+		tm.tm_hour, tm.tm_min, tm.tm_sec, ts.tv_nsec / 1000000);
+	va_start(ap, fmt);
+	vfprintf(stderr, fmt, ap);
+	va_end(ap);
+	fputc('\n', stderr);
+	fflush(stderr);
+}
+
+/* --- power sequencing ------------------------------------------------- */
+
+static int power_set(int on)
+{
+	int fd, ret;
+	char v = on ? '1' : '0';
+
+	if (!cfg.use_power)
+		return 0;
+
+	fd = open(cfg.gpio, O_WRONLY | O_CLOEXEC);
+	if (fd < 0) {
+		logmsg("cannot open %s: %s (is the gps driver built in?)",
+		       cfg.gpio, strerror(errno));
+		return -1;
+	}
+	ret = write(fd, &v, 1);
+	close(fd);
+	if (ret != 1) {
+		logmsg("cannot write %s: %s", cfg.gpio, strerror(errno));
+		return -1;
+	}
+	return 0;
+}
+
+/* --- serial port ------------------------------------------------------ */
+
+static speed_t baud_to_speed(int baud)
+{
+	switch (baud) {
+	case 4800:    return B4800;
+	case 9600:    return B9600;
+	case 19200:   return B19200;
+	case 38400:   return B38400;
+	case 57600:   return B57600;
+	case 115200:  return B115200;
+	case 230400:  return B230400;
+	case 460800:  return B460800;
+#ifdef B500000
+	case 500000:  return B500000;
+#endif
+#ifdef B576000
+	case 576000:  return B576000;
+#endif
+	case 921600:  return B921600;
+#ifdef B1000000
+	case 1000000: return B1000000;
+#endif
+#ifdef B1500000
+	case 1500000: return B1500000;
+#endif
+#ifdef B2000000
+	case 2000000: return B2000000;
+#endif
+	default:      return (speed_t)-1;
+	}
+}
+
+static int serial_open(const char *path, int baud)
+{
+	struct termios tio;
+	speed_t spd = baud_to_speed(baud);
+	int fd;
+
+	if (spd == (speed_t)-1) {
+		logmsg("unsupported baud rate %d", baud);
+		return -1;
+	}
+
+	fd = open(path, O_RDWR | O_NOCTTY | O_NONBLOCK | O_CLOEXEC);
+	if (fd < 0) {
+		logmsg("cannot open %s: %s", path, strerror(errno));
+		return -1;
+	}
+
+	if (tcgetattr(fd, &tio) < 0) {
+		logmsg("tcgetattr(%s): %s", path, strerror(errno));
+		close(fd);
+		return -1;
+	}
+
+	cfmakeraw(&tio);
+	tio.c_cflag |= (CLOCAL | CREAD);
+	tio.c_cflag &= ~CRTSCTS;   /* gps.xml sets no FlowControl */
+	tio.c_cflag &= ~(PARENB | PARODD | CSTOPB);
+	tio.c_cflag = (tio.c_cflag & ~CSIZE) | CS8;
+	tio.c_cc[VMIN] = 0;
+	tio.c_cc[VTIME] = 0;
+
+	if (cfsetispeed(&tio, spd) < 0 || cfsetospeed(&tio, spd) < 0) {
+		logmsg("cfset*speed(%d): %s", baud, strerror(errno));
+		close(fd);
+		return -1;
+	}
+	if (tcsetattr(fd, TCSANOW, &tio) < 0) {
+		logmsg("tcsetattr(%s): %s", path, strerror(errno));
+		close(fd);
+		return -1;
+	}
+	tcflush(fd, TCIOFLUSH);
+
+	logmsg("opened %s at %d 8N1, no flow control", path, baud);
+	return fd;
+}
+
+/* --- output: PTY + Unix socket ---------------------------------------- */
+
+struct out_ctx {
+	int pty_master;
+	char pty_slave_path[128];
+	int listen_fd;
+	int clients[MAX_CLIENTS];
+	int nclients;
+	int raw_fd;
+};
+
+static int mkdir_p(const char *path)
+{
+	char *tmp = strdup(path);
+	char *p;
+	int rc = 0;
+
+	if (!tmp)
+		return -1;
+	for (p = tmp + 1; *p; p++) {
+		if (*p == '/') {
+			*p = '\0';
+			if (mkdir(tmp, 0755) < 0 && errno != EEXIST)
+				rc = -1;
+			*p = '/';
+		}
+	}
+	if (mkdir(tmp, 0755) < 0 && errno != EEXIST)
+		rc = -1;
+	free(tmp);
+	return rc;
+}
+
+static int pty_setup(struct out_ctx *o)
+{
+	struct termios tio;
+	char link_tmp[256], link_dst[256];
+	const char *slave_path;
+	int slave;
+	size_t n;
+
+	o->pty_master = posix_openpt(O_RDWR | O_NOCTTY | O_CLOEXEC);
+	if (o->pty_master < 0) {
+		logmsg("posix_openpt: %s", strerror(errno));
+		return -1;
+	}
+	if (grantpt(o->pty_master) < 0 || unlockpt(o->pty_master) < 0) {
+		logmsg("grantpt/unlockpt: %s", strerror(errno));
+		close(o->pty_master);
+		o->pty_master = -1;
+		return -1;
+	}
+	slave_path = ptsname(o->pty_master);
+	if (!slave_path) {
+		logmsg("ptsname: %s", strerror(errno));
+		close(o->pty_master);
+		o->pty_master = -1;
+		return -1;
+	}
+	n = strlen(slave_path);
+	if (n >= sizeof(o->pty_slave_path)) {
+		logmsg("pty path too long");
+		close(o->pty_master);
+		o->pty_master = -1;
+		return -1;
+	}
+	memcpy(o->pty_slave_path, slave_path, n + 1);
+
+	/*
+	 * Keep the slave open ourselves: otherwise the master would see EIO
+	 * whenever no consumer (gpsd) has the slave open yet, and we would
+	 * lose the first sentences after a consumer restart.
+	 */
+	slave = open(o->pty_slave_path, O_RDWR | O_NOCTTY | O_CLOEXEC);
+	if (slave < 0) {
+		logmsg("open(%s): %s", o->pty_slave_path, strerror(errno));
+		close(o->pty_master);
+		o->pty_master = -1;
+		return -1;
+	}
+	if (tcgetattr(slave, &tio) == 0) {
+		cfmakeraw(&tio);
+		tio.c_cflag |= (CLOCAL | CREAD);
+		tcsetattr(slave, TCSANOW, &tio);
+	}
+	/* The slave fd is intentionally leaked into the process for its
+	 * lifetime; it must never be the last close. */
+
+	/* stable, self-describing path: <rundir>/tty -> /dev/pts/N */
+	snprintf(link_dst, sizeof(link_dst), "%s/%s", cfg.rundir, DEFAULT_PTY_LINK);
+	snprintf(link_tmp, sizeof(link_tmp), "%s/.tty.%d", cfg.rundir, (int)getpid());
+	unlink(link_tmp);
+	if (symlink(o->pty_slave_path, link_tmp) == 0) {
+		if (rename(link_tmp, link_dst) < 0) {
+			logmsg("rename(%s): %s", link_dst, strerror(errno));
+			unlink(link_tmp);
+		}
+	}
+
+	logmsg("NMEA PTY ready: %s (stable link %s -> %s)",
+	       o->pty_slave_path, link_dst, o->pty_slave_path);
+	return 0;
+}
+
+static int sock_setup(struct out_ctx *o)
+{
+	struct sockaddr_un sa;
+	char path[256];
+
+	if (!cfg.sock_name)
+		return 0;
+	snprintf(path, sizeof(path), "%s/%s", cfg.rundir, cfg.sock_name);
+
+	o->listen_fd = socket(AF_UNIX, SOCK_STREAM | SOCK_NONBLOCK | SOCK_CLOEXEC, 0);
+	if (o->listen_fd < 0) {
+		logmsg("socket(): %s", strerror(errno));
+		return -1;
+	}
+	memset(&sa, 0, sizeof(sa));
+	sa.sun_family = AF_UNIX;
+	if (strlen(path) >= sizeof(sa.sun_path)) {
+		logmsg("socket path too long: %s", path);
+		close(o->listen_fd);
+		o->listen_fd = -1;
+		return -1;
+	}
+	memcpy(sa.sun_path, path, strlen(path) + 1);
+	unlink(path);
+	if (bind(o->listen_fd, (struct sockaddr *)&sa, sizeof(sa)) < 0) {
+		logmsg("bind(%s): %s", path, strerror(errno));
+		close(o->listen_fd);
+		o->listen_fd = -1;
+		return -1;
+	}
+	chmod(path, 0660);
+	if (listen(o->listen_fd, 4) < 0) {
+		logmsg("listen(%s): %s", path, strerror(errno));
+		close(o->listen_fd);
+		o->listen_fd = -1;
+		unlink(path);
+		return -1;
+	}
+	logmsg("NMEA stream socket: %s", path);
+	return 0;
+}
+
+static void out_init(struct out_ctx *o)
+{
+	memset(o, 0, sizeof(*o));
+	o->pty_master = -1;
+	o->listen_fd = -1;
+	o->raw_fd = -1;
+	o->nclients = 0;
+
+	if (mkdir_p(cfg.rundir) < 0)
+		logmsg("mkdir_p(%s): %s", cfg.rundir, strerror(errno));
+
+	if (pty_setup(o) < 0)
+		logmsg("no PTY output; NMEA will only go to the socket/log");
+
+	if (sock_setup(o) < 0)
+		logmsg("no Unix socket output");
+
+	if (cfg.raw_log) {
+		o->raw_fd = open(cfg.raw_log, O_WRONLY | O_CREAT | O_APPEND | O_CLOEXEC, 0644);
+		if (o->raw_fd < 0)
+			logmsg("cannot open raw log %s: %s", cfg.raw_log, strerror(errno));
+		else
+			logmsg("raw UART log: %s", cfg.raw_log);
+	}
+}
+
+static int write_all(int fd, const char *buf, size_t len)
+{
+	size_t off = 0;
+
+	while (off < len) {
+		ssize_t n = write(fd, buf + off, len - off);
+		if (n < 0) {
+			if (errno == EINTR)
+				continue;
+			return -1;
+		}
+		off += (size_t)n;
+	}
+	return 0;
+}
+
+static void out_nmea(struct out_ctx *o, const char *line, size_t len)
+{
+	int i;
+
+	if (o->pty_master >= 0) {
+		if (write_all(o->pty_master, line, len) < 0 && cfg.verbose)
+			logmsg("pty write: %s", strerror(errno));
+	}
+	for (i = 0; i < o->nclients; i++) {
+		if (write_all(o->clients[i], line, len) < 0) {
+			/* drop slow/dead client */
+			close(o->clients[i]);
+			o->clients[i] = o->clients[--o->nclients];
+			i--;
+		}
+	}
+}
+
+static void out_accept(struct out_ctx *o)
+{
+	int fd;
+
+	while (o->nclients < MAX_CLIENTS) {
+		fd = accept4(o->listen_fd, NULL, NULL, SOCK_NONBLOCK | SOCK_CLOEXEC);
+		if (fd < 0)
+			break;
+		o->clients[o->nclients++] = fd;
+		if (cfg.verbose)
+			logmsg("socket client connected (%d total)", o->nclients);
+	}
+}
+
+static void out_close(struct out_ctx *o)
+{
+	int i;
+	char path[256];
+
+	for (i = 0; i < o->nclients; i++)
+		close(o->clients[i]);
+	o->nclients = 0;
+	if (o->listen_fd >= 0) {
+		close(o->listen_fd);
+		if (cfg.sock_name) {
+			snprintf(path, sizeof(path), "%s/%s", cfg.rundir, cfg.sock_name);
+			unlink(path);
+		}
+	}
+	if (o->pty_master >= 0)
+		close(o->pty_master);
+	if (o->raw_fd >= 0)
+		close(o->raw_fd);
+	if (cfg.rundir) {
+		snprintf(path, sizeof(path), "%s/%s", cfg.rundir, DEFAULT_PTY_LINK);
+		unlink(path);
+	}
+}
+
+/* --- NMEA framing ----------------------------------------------------- */
+
+struct nmea_ctx {
+	char buf[NMEA_MAX * 2];
+	size_t len;
+	unsigned long total_bytes;
+	unsigned long nmea_sentences;
+	unsigned long nmea_bad;
+	unsigned long dropped_bytes;
+};
+
+static unsigned char nmea_checksum(const char *s, size_t n)
+{
+	unsigned char cs = 0;
+	size_t i;
+
+	for (i = 0; i < n; i++)
+		cs ^= (unsigned char)s[i];
+	return cs;
+}
+
+static void nmea_emit(struct out_ctx *o, struct nmea_ctx *c, char *line, size_t len)
+{
+	char out[NMEA_MAX + 4];
+	size_t outlen;
+
+	/* Strip CR/LF, re-terminate canonically with CRLF. */
+	while (len && (line[len - 1] == '\r' || line[len - 1] == '\n'))
+		len--;
+	if (len == 0 || line[0] != '$')
+		return;
+	if (len > NMEA_MAX) {
+		/* not a valid NMEA 0183 sentence (max 82 chars) */
+		c->dropped_bytes += len;
+		return;
+	}
+
+	outlen = len;
+	memcpy(out, line, len);
+
+	/* Verify the checksum when present; never drop on mismatch, the
+	 * consumer (gpsd) does its own validation and we want a truthful
+	 * raw view of what the receiver sent. */
+	{
+		char *star = memchr(out, '*', outlen);
+		if (star && (size_t)(star - out) + 3 <= outlen) {
+			unsigned int want;
+			if (sscanf(star + 1, "%2x", &want) == 1) {
+				if (nmea_checksum(out + 1, (size_t)(star - out) - 1) != (unsigned char)want)
+					c->nmea_bad++;
+			}
+		}
+	}
+
+	out[outlen++] = '\r';
+	out[outlen++] = '\n';
+	out_nmea(o, out, outlen);
+	c->nmea_sentences++;
+
+	if (cfg.verbose) {
+		out[outlen - 2] = '\0';
+		logmsg("NMEA %s", out);
+	}
+}
+
+static void nmea_feed(struct out_ctx *o, struct nmea_ctx *c,
+		      const char *data, size_t n)
+{
+	size_t i;
+
+	c->total_bytes += n;
+
+	if (o->raw_fd >= 0) {
+		ssize_t r = write(o->raw_fd, data, n);
+		(void)r;
+	}
+
+	for (i = 0; i < n; i++) {
+		char ch = data[i];
+
+		if (ch == '\n') {
+			nmea_emit(o, c, c->buf, c->len);
+			c->len = 0;
+			continue;
+		}
+		if (c->len >= sizeof(c->buf)) {
+			/* runaway binary data: resynchronise on the next '$' */
+			c->dropped_bytes += c->len;
+			c->len = 0;
+		}
+		/* Keep printable bytes plus the trailing CR of CRLF. */
+		if ((unsigned char)ch >= 0x20 && (unsigned char)ch < 0x7f) {
+			c->buf[c->len++] = ch;
+		} else if (ch == '\r') {
+			if (c->len)
+				c->buf[c->len++] = ch;
+		} else {
+			/* Binary byte inside an unterminated line: this is not
+			 * NMEA.  Discard the partial line and count it. */
+			c->dropped_bytes += c->len + 1;
+			c->len = 0;
+		}
+	}
+}
+
+/* --- BCM4752 BRI handshake (reverse-engineered from /system/bin/gpsd) ---
+ *
+ * Every byte below was recovered from Broadcom's glgps binary and is cited
+ * with its address there (file offsets == runtime addresses, it is a PIE
+ * linked at 0).  See parity/reports/gps-init-impl.md for the full table.
+ *
+ * Frame shapes (from the receive parser GlMeSrdAsicinit::
+ * Bri_CheckForReceivedPacket_Sardine @0x2a789c and the request templates in
+ * .rodata at 0x398b00..0x398b5c):
+ *
+ *   host -> chip request   0xFF 00 FD <cmd> <arg> FC                    (6 B)
+ *   host -> chip request   0xFE 00 FD <cmd> <arg> <d0..d3> FC          (10 B)
+ *   chip -> host response  0xFE 00 FD <cmd> <sub> <d0..d3> FC          (10 B)
+ *
+ * 0xFC is a constant frame terminator, there is no CRC and no sequence
+ * number on this link (those TXcrc/RXcrc/TXseq/RXseq counters belong to the
+ * separate glgps <-> Android-HAL socket protocol at 0x169090).  With
+ * transport mode 1 the byte-escaping in FUN_002a599c is disabled ([0x10e]=0)
+ * and none of the frames below contain the escape byte 0xE0 anyway.
+ */
+
+#define BRI_FRAME_MAX   16
+#define BRI_RESP_MS     300    /* bri_wait4bri timer: 0x12c ms @0x2a1786 */
+#define BRI_RETRY_MAX   4      /* INIT_STAGE A: "trial %u", cmp #3 @0x2a6596 */
+#define BRI_BACKOFF_MS(n) (50 + 20 * (n))  /* 0x32 + 20*n @0x2a65fe */
+
+/* GlMeSrdAsicinit::Bri_SendAutobaud @0x2a5ae4: memset(buf, 0x80, 16) in
+ * the vendor code, then one 16-byte transport write. */
+static const unsigned char bri_autobaud[16] = {
+	0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80,
+	0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80,
+};
+
+/* GlMeSrdAsicinit::Bri_GetOutOfLegacy @0x2a618c, template copied from
+ * .rodata 0x398b2c (ldr [0x398b2c]/[0x398b30] + ldrh [0x398b34]). */
+static const unsigned char bri_get_out_of_legacy[10] = {
+	0xfe, 0x00, 0xfd, 0x00, 0x00, 0x55, 0xaa, 0x00, 0xff, 0xfc,
+};
+
+/* GlMeSrdAsicinit::Bri_RequestHwVersion @0x2a6784, template at 0x398b38. */
+static const unsigned char bri_request_hw_version[6] = {
+	0xff, 0x00, 0xfd, 0x00, 0x00, 0xfc,
+};
+
+/* GlMeSrdAsicinit::Bri_RequestDebugSfr @0x2a6104, template at 0x398b04. */
+static const unsigned char bri_request_debug_sfr[6] = {
+	0xff, 0x00, 0xfd, 0x1f, 0x95, 0xfc,
+};
+
+/* GlMeSrdAsicinit::Bri_RequestNvRamWord7 @0x2a70b8, templates at .rodata
+ * 0x398b40 / 0x398b4c / 0x398b54 (three frames in one function).  glgps
+ * sends all three; on this unit they are the exchanges the chip actually
+ * answers (see docs/reports/gps-toolchain.md). */
+static const unsigned char bri_nvram_word7[10] = {
+	0xfe, 0x00, 0xfd, 0x00, 0x1b, 0x07, 0x00, 0x00, 0x00, 0xfc,
+};
+static const unsigned char bri_nvram_read[6] = {
+	0xff, 0x00, 0xfd, 0x00, 0x1b, 0xfc,
+};
+static const unsigned char bri_request_status[6] = {
+	0xff, 0x00, 0xfd, 0x40, 0x1a, 0xfc,
+};
+
+/* Bytes read off the UART by the BRI handshake; kept only so the exit
+ * summary can distinguish "the chip is mute" from "the chip only spoke
+ * during init". */
+static unsigned long bri_rx_bytes;
+
+struct bri_rx {
+	unsigned char buf[BRI_FRAME_MAX];
+	size_t len;
+	int in_frame;
+	unsigned long frames;
+	unsigned long discarded;
+};
+
+/*
+ * Consume one received byte.  Returns 1 when a complete 0xFE .. 0xFC frame
+ * sits in r->buf (r->len bytes), 0 otherwise.  The parser in glgps accepts
+ * exactly the 10-byte 0xFE form, validates buf[1..2] == 00 FD and buf[9] ==
+ * 0xFC, and derives cmd = buf[3], sub = buf[4] @0x2a7a5a.
+ */
+static int bri_rx_byte(struct bri_rx *r, unsigned char b)
+{
+	if (!r->in_frame) {
+		if (b == 0xfe) {
+			r->buf[0] = b;
+			r->len = 1;
+			r->in_frame = 1;
+		} else {
+			r->discarded++;
+		}
+		return 0;
+	}
+
+	r->buf[r->len++] = b;
+
+	/* header check as soon as three bytes are in */
+	if (r->len == 3 && (r->buf[1] != 0x00 || r->buf[2] != 0xfd)) {
+		r->in_frame = 0;
+		r->discarded += r->len;
+		r->len = 0;
+		if (b == 0xfe) {	/* resync on this byte */
+			r->buf[0] = b;
+			r->len = 1;
+			r->in_frame = 1;
+		}
+		return 0;
+	}
+
+	if (b == 0xfc) {
+		r->in_frame = 0;
+		r->frames++;
+		return 1;
+	}
+	if (r->len >= BRI_FRAME_MAX) {
+		r->discarded += r->len;
+		r->len = 0;
+		r->in_frame = 0;
+	}
+	return 0;
+}
+
+static int bri_send(int fd, const unsigned char *buf, size_t len)
+{
+	size_t off = 0;
+
+	/* Drop anything stale from the previous step before asking again. */
+	(void)tcflush(fd, TCIFLUSH);
+
+	while (off < len) {
+		ssize_t n = write(fd, buf + off, len - off);
+		if (n < 0) {
+			if (errno == EINTR)
+				continue;
+			if (errno == EAGAIN) {
+				struct pollfd p = { fd, POLLOUT, 0 };
+				if (poll(&p, 1, 1000) <= 0)
+					return -1;
+				continue;
+			}
+			logmsg("init: write(%s): %s", cfg.dev, strerror(errno));
+			return -1;
+		}
+		off += (size_t)n;
+	}
+	return 0;
+}
+
+/*
+ * Wait up to timeout_ms for one complete response frame.  Returns 1 with the
+ * frame copied to out/outlen, 0 on timeout, -1 on a fatal read error.
+ * Non-frame bytes are counted (they are the chip still talking legacy).
+ */
+static int bri_wait(int fd, struct bri_rx *rx, int timeout_ms,
+		    unsigned char *out, size_t *outlen)
+{
+	struct timespec t0, now;
+	long elapsed = 0;
+
+	clock_gettime(CLOCK_MONOTONIC, &t0);
+
+	while (elapsed <= timeout_ms) {
+		struct pollfd p = { fd, POLLIN, 0 };
+		int r = poll(&p, 1, timeout_ms - (int)elapsed);
+
+		if (r < 0) {
+			if (errno == EINTR) {
+				clock_gettime(CLOCK_MONOTONIC, &now);
+				elapsed = (now.tv_sec - t0.tv_sec) * 1000L +
+					  (now.tv_nsec - t0.tv_nsec) / 1000000L;
+				continue;
+			}
+			logmsg("init: poll(%s): %s", cfg.dev, strerror(errno));
+			return -1;
+		}
+		if (r == 0)
+			return 0;
+
+		if (p.revents & (POLLIN | POLLHUP | POLLERR)) {
+			unsigned char chunk[256];
+			ssize_t n = read(fd, chunk, sizeof(chunk));
+			ssize_t i;
+
+			if (n <= 0) {
+				if (n < 0 && (errno == EAGAIN || errno == EINTR))
+					continue;
+				logmsg("init: read(%s): %s", cfg.dev,
+				       n == 0 ? "EOF" : strerror(errno));
+				return -1;
+			}
+			bri_rx_bytes += (unsigned long)n;
+			for (i = 0; i < n; i++) {
+				if (bri_rx_byte(rx, chunk[i])) {
+					memcpy(out, rx->buf, rx->len);
+					*outlen = rx->len;
+					return 1;
+				}
+			}
+		}
+
+		clock_gettime(CLOCK_MONOTONIC, &now);
+		elapsed = (now.tv_sec - t0.tv_sec) * 1000L +
+			  (now.tv_nsec - t0.tv_nsec) / 1000000L;
+	}
+	return 0;
+}
+
+static void bri_log_frame(const char *what, const unsigned char *f, size_t n)
+{
+	char hex[3 * BRI_FRAME_MAX + 1];
+	size_t i;
+
+	for (i = 0; i < n && i < BRI_FRAME_MAX; i++)
+		snprintf(hex + 3 * i, 4, "%02x ", f[i]);
+	hex[n < BRI_FRAME_MAX ? 3 * n : 3 * BRI_FRAME_MAX] = '\0';
+
+	if (n >= 10)
+		logmsg("%s: %s (cmd=0x%02x sub=0x%02x data=%02x %02x %02x %02x)",
+		       what, hex, f[3], f[4], f[5], f[6], f[7], f[8]);
+	else
+		logmsg("%s: %s", what, hex);
+}
+
+/* 32-bit little-endian payload word of a 10-byte response frame. */
+static unsigned long bri_word(const unsigned char *f, size_t n)
+{
+	if (n < 10)
+		return 0;
+	return (unsigned long)f[5] | (unsigned long)f[6] << 8 |
+	       (unsigned long)f[7] << 16 | (unsigned long)f[8] << 24;
+}
+
+/*
+ * Send one request and wait for one response frame.
+ * Returns 1 on a reply, 0 on timeout, -1 on a fatal write/read error.
+ */
+static int bri_step(int fd, struct bri_rx *rx, const char *what,
+		    const unsigned char *req, size_t reqlen, int timeout_ms,
+		    unsigned char *frame, size_t *flen)
+{
+	int got;
+
+	if (bri_send(fd, req, reqlen) < 0)
+		return -1;
+	logmsg("init: %s sent", what);
+	got = bri_wait(fd, rx, timeout_ms, frame, flen);
+	if (got > 0)
+		bri_log_frame("init: reply", frame, *flen);
+	else if (got == 0)
+		logmsg("init: no reply to %s within %d ms", what, timeout_ms);
+	return got;
+}
+
+/* --- ESW / RAM-patch upload -------------------------------------------- *
+ *
+ * The 4752_B2 patch is not part of this program: it is Broadcom firmware
+ * that the user extracts from their own /system/bin/gpsd with
+ * code/gps/esw/esw_dump --dump <dir>/b2 (see docs/reports/gps-esw.md).
+ * Four files are expected in --esw DIR:
+ *
+ *   idx bank  addr    size  file                    injected by esw_dump
+ *     0    0  0x7000  4060  b2-4752_B2-0.bin        .rodata
+ *     1    0  0x7fec     4  b2-4752_B2-1.bin        .rodata
+ *     2    1  0x8000  6777  b2-4752_B2-2.bin        .rodata
+ *     3    0  0x7fd2     4  b2-4752_B2-3.bin        synthesised (zeros)
+ *
+ * Wire format (verified on the SM-J700M, docs/reports/gps-esw-upload.md):
+ *
+ *   data  fe <nwords> fd 61 17 de c0 <alo> <ahi> <bytes...> fc
+ *         nwords = ceil(bytes/4), <= 255; a record is sent in <= 1020-byte
+ *         chunks, an unaligned tail is folded into a 4-byte frame at
+ *         addr+chunk-4; the UART write is paced in <= 160-byte pieces.
+ *   crc   fe 00 fd 21 18 <alo> <ahi> <len_lo> <len_hi> fc
+ *         one request per <= 4096-byte record piece; the chip answers
+ *         fe 00 fd 2f 15 <4 bytes> fc.  The 4 bytes are chip-computed, are
+ *         not the host CRC-32, and the vendor daemon only logs them.
+ *   bank  fe 00 fd 61 16 <bank> 00 00 00 fc   (item 0x16 write; no reply)
+ *         read back as item 0x94 (ff 00 fd 1f 94 fc).
+ */
+#define ESW_PIECE_MAX   4096   /* record piece / CRC boundary, [this+4] @0x2a8e24 */
+#define ESW_CHUNK_MAX   1020   /* 0x3fc frame payload limit @0x2a7208 */
+#define ESW_UART_PIECE  160    /* 0xa0 write() piece @0x2a72a4 */
+
+struct esw_block {
+	int bank;
+	unsigned addr;
+	size_t len;
+	const char *name;
+};
+
+static const struct esw_block esw_blocks[] = {
+	{ 0, 0x7000, 4060, "b2-4752_B2-0.bin" },
+	{ 0, 0x7fec,    4, "b2-4752_B2-1.bin" },
+	{ 1, 0x8000, 6777, "b2-4752_B2-2.bin" },
+	{ 0, 0x7fd2,    4, "b2-4752_B2-3.bin" },
+};
+
+/* CRC-32/IEEE, only used to log (and thus cross-check) what was read from
+ * disk against the digests in docs/reports/gps-esw.md §1. */
+static unsigned long esw_crc32(const unsigned char *p, size_t n)
+{
+	unsigned long c = 0xffffffffUL;
+	size_t i;
+	int k;
+
+	for (i = 0; i < n; i++) {
+		c ^= p[i];
+		for (k = 0; k < 8; k++)
+			c = (c >> 1) ^ (0xedb88320UL & (0UL - (c & 1UL)));
+	}
+	return c ^ 0xffffffffUL;
+}
+
+/* Write in <=160-byte pieces with a 1 ms gap, like the vendor transport. */
+static int esw_send_paced(int fd, const unsigned char *buf, size_t len)
+{
+	size_t off = 0;
+
+	while (off < len) {
+		size_t n = len - off;
+		ssize_t w;
+
+		if (n > ESW_UART_PIECE)
+			n = ESW_UART_PIECE;
+		w = write(fd, buf + off, n);
+		if (w < 0) {
+			if (errno == EINTR)
+				continue;
+			if (errno == EAGAIN) {
+				struct pollfd p = { fd, POLLOUT, 0 };
+				if (poll(&p, 1, 1000) <= 0)
+					return -1;
+				continue;
+			}
+			logmsg("esw: write(%s): %s", cfg.dev, strerror(errno));
+			return -1;
+		}
+		off += (size_t)w;
+		if (off < len) {
+			struct timespec ts = { 0, 1000000L };
+			nanosleep(&ts, NULL);
+		}
+	}
+	return 0;
+}
+
+static int esw_data_frame(int fd, unsigned addr, const unsigned char *data,
+			  size_t nbytes)
+{
+	unsigned char hdr[9];
+	unsigned char ft = 0xfc;
+	unsigned nwords = (unsigned)((nbytes + 3) / 4);
+
+	if (nwords > 255) {
+		logmsg("esw: frame too large (%zu bytes)", nbytes);
+		return -1;
+	}
+	hdr[0] = 0xfe;
+	hdr[1] = (unsigned char)nwords;
+	hdr[2] = 0xfd;
+	hdr[3] = 0x61;
+	hdr[4] = 0x17;
+	hdr[5] = 0xde;
+	hdr[6] = 0xc0;
+	hdr[7] = (unsigned char)(addr & 0xff);
+	hdr[8] = (unsigned char)((addr >> 8) & 0xff);
+
+	if (esw_send_paced(fd, hdr, sizeof(hdr)) < 0)
+		return -1;
+	if (nbytes && esw_send_paced(fd, data, nbytes) < 0)
+		return -1;
+	return esw_send_paced(fd, &ft, 1);
+}
+
+/* Ask for the chip-side CRC of one record piece; log the 2f15 reply. */
+static int esw_crc_request(int fd, struct bri_rx *rx, unsigned addr,
+			   unsigned len)
+{
+	unsigned char req[10];
+	unsigned char frame[BRI_FRAME_MAX];
+	size_t flen = 0;
+	int got;
+
+	req[0] = 0xfe;
+	req[1] = 0x00;
+	req[2] = 0xfd;
+	req[3] = 0x21;
+	req[4] = 0x18;
+	req[5] = (unsigned char)(addr & 0xff);
+	req[6] = (unsigned char)((addr >> 8) & 0xff);
+	req[7] = (unsigned char)(len & 0xff);
+	req[8] = (unsigned char)((len >> 8) & 0xff);
+	req[9] = 0xfc;
+
+	got = bri_step(fd, rx, "ESW CRC request 21 18", req, sizeof(req),
+		       BRI_RESP_MS, frame, &flen);
+	if (got < 0)
+		return -1;
+	if (got > 0 && flen >= 10 && frame[3] == 0x2f && frame[4] == 0x15) {
+		logmsg("esw: CRC ack %04x/%u = 0x%08lx", addr, len,
+		       bri_word(frame, flen));
+		return 1;
+	}
+	logmsg("esw: no 2f15 ack for %04x/%u", addr, len);
+	return 0;
+}
+
+/* Item 0x16 = patch bank; read it back as item 0x94. */
+static int esw_bank_switch(int fd, struct bri_rx *rx, int bank)
+{
+	unsigned char req[10];
+	unsigned char frame[BRI_FRAME_MAX];
+	size_t flen = 0;
+	int got, attempt;
+
+	req[0] = 0xfe;
+	req[1] = 0x00;
+	req[2] = 0xfd;
+	req[3] = 0x61;
+	req[4] = 0x16;
+	req[5] = (unsigned char)bank;
+	req[6] = req[7] = req[8] = 0x00;
+	req[9] = 0xfc;
+	got = bri_step(fd, rx, "ESW bank select (item 0x16)", req, sizeof(req),
+		       BRI_RESP_MS, frame, &flen);
+	if (got < 0)
+		return -1;
+
+	for (attempt = 0; attempt < 3; attempt++) {
+		unsigned char rd[6] = { 0xff, 0x00, 0xfd, 0x1f, 0x94, 0xfc };
+
+		got = bri_step(fd, rx, "ESW bank readback (item 0x94)", rd,
+			       sizeof(rd), BRI_RESP_MS, frame, &flen);
+		if (got < 0)
+			return -1;
+		if (got > 0 && flen >= 10 && frame[3] == 0x1f &&
+		    frame[4] == 0x94) {
+			unsigned long v = bri_word(frame, flen);
+
+			if (v == (unsigned long)bank) {
+				logmsg("esw: bank %d selected", bank);
+				return 0;
+			}
+			logmsg("esw: bank readback 0x%lx, wanted %d", v, bank);
+			continue;
+		}
+		break;
+	}
+	logmsg("esw: bank %d not confirmed by item 0x94", bank);
+	return 0;
+}
+
+/* Send one record: <=4096-byte pieces, <=1020-byte frames, CRC per piece. */
+static int esw_send_block(int fd, struct bri_rx *rx,
+			  const struct esw_block *b, const unsigned char *data)
+{
+	size_t done = 0;
+	int acks = 0, fails = 0;
+
+	while (done < b->len) {
+		size_t plen = b->len - done;
+		size_t sent = 0;
+
+		if (plen > ESW_PIECE_MAX)
+			plen = ESW_PIECE_MAX;
+
+		while (sent < plen) {
+			size_t chunk = plen - sent;
+			size_t aligned, tail;
+
+			if (chunk > ESW_CHUNK_MAX)
+				chunk = ESW_CHUNK_MAX;
+			aligned = chunk & ~(size_t)3;
+			tail = chunk - aligned;
+
+			logmsg("esw: frame %04x +%zu bytes (aligned %zu tail %zu)",
+			       b->addr + (unsigned)done + (unsigned)sent,
+			       chunk, aligned, tail);
+			if (aligned &&
+			    esw_data_frame(fd, b->addr + (unsigned)done +
+					   (unsigned)sent,
+					   data + done + sent, aligned) < 0)
+				return -1;
+			if (tail) {
+				unsigned a = (b->addr + (unsigned)done +
+					      (unsigned)sent + (unsigned)chunk - 4) &
+					     0xffff;
+
+				if (esw_data_frame(fd, a,
+						   data + done + sent + chunk - 4,
+						   4) < 0)
+					return -1;
+			}
+			sent += chunk;
+		}
+
+		{
+			int r = esw_crc_request(fd, rx,
+						 b->addr + (unsigned)done,
+						 (unsigned)plen);
+
+			if (r < 0)
+				return -1;
+			if (r > 0)
+				acks++;
+			else
+				fails++;
+		}
+		done += plen;
+	}
+	logmsg("esw: %s: %zu bytes, %d/%d pieces acknowledged",
+	       b->name, b->len, acks, acks + fails);
+	return fails ? 1 : 0;
+}
+
+static int esw_read_block(const char *dir, const struct esw_block *b,
+			  unsigned char **out)
+{
+	char path[512];
+	FILE *f;
+	long sz;
+	size_t n;
+
+	snprintf(path, sizeof(path), "%s/%s", dir, b->name);
+	f = fopen(path, "rb");
+	if (!f) {
+		logmsg("esw: cannot open %s: %s", path, strerror(errno));
+		return -1;
+	}
+	if (fseek(f, 0, SEEK_END) < 0 || (sz = ftell(f)) < 0 ||
+	    fseek(f, 0, SEEK_SET) < 0) {
+		logmsg("esw: %s: seek failed", path);
+		fclose(f);
+		return -1;
+	}
+	if ((size_t)sz != b->len) {
+		logmsg("esw: %s is %ld bytes, expected %zu", path, sz, b->len);
+		fclose(f);
+		return -1;
+	}
+	*out = malloc(b->len ? b->len : 1);
+	if (!*out) {
+		fclose(f);
+		return -1;
+	}
+	n = fread(*out, 1, b->len, f);
+	fclose(f);
+	if (n != b->len) {
+		logmsg("esw: %s: short read (%zu/%zu)", path, n, b->len);
+		free(*out);
+		*out = NULL;
+		return -1;
+	}
+	logmsg("esw: %s: %zu bytes, crc32 0x%08lx", b->name, b->len,
+	       esw_crc32(*out, b->len));
+	return 0;
+}
+
+/*
+ * Upload the four 4752_B2 records in table order, switching the patch bank
+ * when it changes (bank 0 for blocks 0/1/3, bank 1 for block 2).
+ * Returns 0 when every record was sent, 1 when some CRC ack was missing,
+ * -1 on a fatal I/O or file error.
+ */
+static int esw_upload(int fd, struct bri_rx *rx)
+{
+	int cur_bank = -1;
+	int rc = 0;
+	size_t i;
+
+	for (i = 0; i < sizeof(esw_blocks) / sizeof(esw_blocks[0]); i++) {
+		const struct esw_block *b = &esw_blocks[i];
+		unsigned char *data = NULL;
+		int r;
+
+		if (esw_read_block(cfg.esw_dir, b, &data) < 0) {
+			rc = -1;
+			break;
+		}
+		if (b->bank != cur_bank) {
+			if (esw_bank_switch(fd, rx, b->bank) < 0) {
+				free(data);
+				rc = -1;
+				break;
+			}
+			cur_bank = b->bank;
+		}
+		logmsg("esw: loading %s at 0x%04x (bank %d)",
+		       b->name, b->addr, b->bank);
+		r = esw_send_block(fd, rx, b, data);
+		free(data);
+		if (r < 0) {
+			rc = -1;
+			break;
+		}
+		if (r > 0)
+			rc = 1;
+	}
+	return rc;
+}
+
+/*
+ * Cold-start handshake.  The vendor order is
+ *   "initial" @0x2a1728 -> cfg+autobaud @0x2a5b58 -> [BRI wait] ->
+ *   NvRamWord7 @0x2a70b8 -> wait4version @0x2a680c (HwVersion) ->
+ *   wait4asic_ready @0x2a6234 (DebugSfr) -> esw_wait4version (GetOutOfLegacy).
+ *
+ * On j7elte hardware the chip answers nothing at all until it has seen the
+ * 16 x 0x80 autobaud burst, never volunteers the unsolicited BRI announce
+ * frame, and gates Bri_RequestHwVersion on the preceding NvRamWord7 exchange
+ * (the vendor code asserts transport->[4] == 1 at 0x2a6784 before sending
+ * it).  GetOutOfLegacy and DebugSfr stay unanswered even then.  The steps are
+ * therefore sent in the order that the hardware actually answers, and a
+ * silent chip is logged rather than treated as fatal.
+ *
+ * Returns 0 once the sequence has been played, -1 only on a fatal I/O error.
+ */
+static int asic_init(int fd)
+{
+	struct bri_rx rx;
+	unsigned char frame[BRI_FRAME_MAX];
+	size_t flen = 0;
+	int attempt, got, answered = 0, sent = 0;
+	unsigned long version;
+
+	memset(&rx, 0, sizeof(rx));
+
+	if (bri_send(fd, bri_autobaud, sizeof(bri_autobaud)) < 0)
+		return -1;
+	logmsg("init: autobaud burst sent (%zu x 0x80) at %d baud",
+	       sizeof(bri_autobaud), cfg.baud);
+
+	got = bri_wait(fd, &rx, BRI_RESP_MS, frame, &flen);
+	if (got > 0) {
+		bri_log_frame("init: BRI frame", frame, flen);
+	} else if (got == 0) {
+		logmsg("init: no unsolicited BRI frame within %d ms "
+		       "(rx state: %lu bytes discarded); sending requests anyway",
+		       BRI_RESP_MS, rx.discarded);
+	}
+
+	/* Bri_RequestNvRamWord7 @0x2a70b8 (templates 0x398b40/4c/54). */
+	sent++;
+	got = bri_step(fd, &rx, "Bri_RequestNvRamWord7",
+		       bri_nvram_word7, sizeof(bri_nvram_word7), BRI_RESP_MS,
+		       frame, &flen);
+	if (got < 0)
+		return -1;
+	answered += got > 0;
+
+	sent++;
+	got = bri_step(fd, &rx, "NvRamWord7 read", bri_nvram_read,
+		       sizeof(bri_nvram_read), BRI_RESP_MS, frame, &flen);
+	if (got < 0)
+		return -1;
+	if (got > 0) {
+		answered++;
+		logmsg("init: NvRamWord7 word 7 = 0x%08lx", bri_word(frame, flen));
+	}
+
+	sent++;
+	got = bri_step(fd, &rx, "status request 0x40/0x1a",
+		       bri_request_status, sizeof(bri_request_status),
+		       BRI_RESP_MS, frame, &flen);
+	if (got < 0)
+		return -1;
+	if (got > 0) {
+		answered++;
+		logmsg("init: status 0x40/0x1a = 0x%08lx", bri_word(frame, flen));
+	}
+
+	/* bri_wait4version @0x2a680c sends Bri_RequestHwVersion on entry. */
+	sent++;
+	got = bri_step(fd, &rx, "Bri_RequestHwVersion",
+		       bri_request_hw_version, sizeof(bri_request_hw_version),
+		       BRI_RESP_MS, frame, &flen);
+	if (got < 0)
+		return -1;
+	if (got > 0) {
+		answered++;
+		if (flen >= 10 && frame[3] == 0x00) {
+			version = bri_word(frame, flen);
+			/* "GlMeSrdAsicinit::Got BRI HW version(0x%lx)" */
+			logmsg("init: BRI HW version 0x%08lx (asic type byte 0x%02x)",
+			       version, frame[4]);
+		}
+	}
+
+	/* bri_wait4asic_ready @0x2a6234 sends Bri_RequestDebugSfr on entry. */
+	sent++;
+	got = bri_step(fd, &rx, "Bri_RequestDebugSfr",
+		       bri_request_debug_sfr, sizeof(bri_request_debug_sfr), 500,
+		       frame, &flen);
+	if (got < 0)
+		return -1;
+	if (got > 0) {
+		answered++;
+		/* the stage checks [0x13c] == 0x95, i.e. sub == 0x95 */
+		if (flen >= 10 && frame[4] == 0x95)
+			logmsg("init: DebugSfr acknowledged");
+	}
+
+	/* ESW / RAM patch: only when the user supplied the extracted blocks.
+	 * The vendor loads the patch here, then switches to GLME. */
+	if (cfg.esw_dir) {
+		int er = esw_upload(fd, &rx);
+
+		if (er < 0) {
+			logmsg("init: ESW upload failed");
+			return -1;
+		}
+		logmsg("init: ESW upload finished (%s)",
+		       er ? "some CRC acks missing" : "all pieces acknowledged");
+		if (cfg.glme) {
+			/* Observed on this unit: the chip stops answering BRI
+			 * after this frame and no e0 banner arrives; one run
+			 * coincided with a device reboot.  Opt-in only. */
+			sent++;
+			got = bri_step(fd, &rx, "Bri_GetOutOfLegacy (after patch)",
+				       bri_get_out_of_legacy,
+				       sizeof(bri_get_out_of_legacy), 1000,
+				       frame, &flen);
+			if (got < 0)
+				return -1;
+			if (got > 0)
+				answered++;
+			logmsg("init: GLME switch %s",
+			       got > 0 ? "answered" : "not answered (BRI may be gone)");
+		} else {
+			logmsg("init: stopping after the patch load "
+			       "(no GLME switch; --glme enables it)");
+		}
+		logmsg("init: link check: %d of %d exchanges answered",
+		       answered, sent);
+		return 0;
+	}
+
+	/* INIT_STAGE A: "Resending Bri_GetOutOfLegacy %u!" with 50+20n ms
+	 * backoff, up to four trials (@0x2a6508, template @0x2a618c). */
+	for (attempt = 0; attempt < BRI_RETRY_MAX; attempt++) {
+		sent++;
+		got = bri_step(fd, &rx, "Bri_GetOutOfLegacy",
+			       bri_get_out_of_legacy,
+			       sizeof(bri_get_out_of_legacy),
+			       BRI_BACKOFF_MS(attempt), frame, &flen);
+		if (got < 0)
+			return -1;
+		if (got > 0) {
+			answered++;
+			break;
+		}
+	}
+
+	logmsg("init: link check: %d of %d exchanges answered", answered, sent);
+	logmsg("init: stopping here.  The next vendor stages "
+	       "(Bri_ProgramSw/HwFlowControl @0x2a6aa0/0x2a6cfc, ESW/patch "
+	       "loading, RF/clock programming) need either the escape-byte "
+	       "search result or the ESW image, neither of which is available "
+	       "(see parity/reports/gps-init-impl.md)");
+	return 0;
+}
+
+/* --- main ------------------------------------------------------------- */
+
+static void usage(FILE *f)
+{
+	fprintf(f,
+"Usage: j7elte-gpsd [options]\n"
+"\n"
+"Bridge the BCM4752 GPS on /dev/ttySAC0 (Samsung Galaxy J7, j7elte) to NMEA\n"
+"consumers through a PTY and a Unix stream socket.  Power is sequenced via\n"
+"/sys/class/sec/gps/GPS_PWR_EN/value exactly like the vendor glgps.\n"
+"\n"
+"  -d, --device PATH     UART device (default " DEFAULT_DEV ")\n"
+"  -b, --baud N          baud rate (default 921600, from /system/etc/gps.xml)\n"
+"  -g, --gpio PATH       GPS power sysfs attribute (default " DEFAULT_GPIO ")\n"
+"  -p, --power-delay MS  delay after power-on (default 250)\n"
+"  -r, --rundir DIR      runtime directory (default " DEFAULT_RUNDIR ")\n"
+"  -s, --socket NAME     Unix socket name inside rundir, 'none' disables\n"
+"  -R, --raw-log PATH    append every received byte to PATH (diagnostics)\n"
+"  -P, --probe-baud      if no NMEA arrives, retry 9600/115200/4800\n"
+"  -i, --init            send the recovered BCM4752 BRI handshake first\n"
+"  -E, --esw DIR         after the handshake, upload the BCM4752 patch\n"
+"                        blocks b2-4752_B2-{0..3}.bin from DIR (implies -i;\n"
+"                        extract them with code/gps/esw/esw_dump --dump)\n"
+"  -G, --glme            after a successful upload send the GLME switch\n"
+"                        (experimental: the chip leaves BRI silently)\n"
+"  -n, --no-power        do not touch the power GPIO\n"
+"  -f, --foreground      accepted for init-script compatibility (never forks)\n"
+"  -v, --verbose         log every NMEA sentence and UART state\n"
+"  -h, --help            this text\n"
+"  -V, --version         print version\n");
+}
+
+int main(int argc, char **argv)
+{
+	static const struct option opts[] = {
+		{ "device",      required_argument, NULL, 'd' },
+		{ "baud",        required_argument, NULL, 'b' },
+		{ "gpio",        required_argument, NULL, 'g' },
+		{ "power-delay", required_argument, NULL, 'p' },
+		{ "rundir",      required_argument, NULL, 'r' },
+		{ "socket",      required_argument, NULL, 's' },
+		{ "raw-log",     required_argument, NULL, 'R' },
+		{ "probe-baud",  no_argument,       NULL, 'P' },
+		{ "init",        no_argument,       NULL, 'i' },
+		{ "esw",         required_argument, NULL, 'E' },
+		{ "glme",        no_argument,       NULL, 'G' },
+		{ "no-power",    no_argument,       NULL, 'n' },
+		{ "foreground",  no_argument,       NULL, 'f' },
+		{ "verbose",     no_argument,       NULL, 'v' },
+		{ "help",        no_argument,       NULL, 'h' },
+		{ "version",     no_argument,       NULL, 'V' },
+		{ NULL, 0, NULL, 0 }
+	};
+	static const int probe_rates[] = { 9600, 115200, 4800 };
+	struct out_ctx out;
+	struct nmea_ctx nmea;
+	struct pollfd pfds[MAX_CLIENTS + 3];
+	struct sigaction sa;
+	int fd = -1, c, ret = 0;
+	time_t started, last_report;
+	int probe_idx = -1;
+
+	/* Safe to out_close() before out_init() has run. */
+	memset(&out, 0, sizeof(out));
+	out.pty_master = -1;
+	out.listen_fd = -1;
+	out.raw_fd = -1;
+	nmea.total_bytes = 0;
+
+	while ((c = getopt_long(argc, argv, "d:b:g:p:r:s:R:E:GPinfvhV", opts, NULL)) != -1) {
+		switch (c) {
+		case 'd': cfg.dev = optarg; break;
+		case 'b': cfg.baud = atoi(optarg); break;
+		case 'g': cfg.gpio = optarg; break;
+		case 'p': cfg.power_delay_ms = atoi(optarg); break;
+		case 'r': cfg.rundir = optarg; break;
+		case 's':
+			cfg.sock_name = (strcmp(optarg, "none") == 0) ? NULL : optarg;
+			break;
+		case 'R': cfg.raw_log = optarg; break;
+		case 'P': cfg.probe_baud = true; break;
+		case 'i': cfg.do_init = true; break;
+		case 'E': cfg.esw_dir = optarg; cfg.do_init = true; break;
+		case 'G': cfg.glme = true; break;
+		case 'n': cfg.use_power = false; break;
+		case 'f': cfg.foreground = true; break;
+		case 'v': cfg.verbose = true; break;
+		case 'h': usage(stdout); return 0;
+		case 'V': puts("j7elte-gpsd 1.0"); return 0;
+		default: usage(stderr); return 2;
+		}
+	}
+	(void)cfg.foreground; /* this daemon never forks */
+
+	if (baud_to_speed(cfg.baud) == (speed_t)-1) {
+		logmsg("unsupported baud %d", cfg.baud);
+		return 2;
+	}
+
+	if (pipe2(g_sigpipe, O_CLOEXEC | O_NONBLOCK) < 0) {
+		logmsg("pipe2: %s", strerror(errno));
+		return 1;
+	}
+	memset(&sa, 0, sizeof(sa));
+	sa.sa_handler = on_signal;
+	sigemptyset(&sa.sa_mask);
+	sigaction(SIGTERM, &sa, NULL);
+	sigaction(SIGINT, &sa, NULL);
+	sigaction(SIGHUP, &sa, NULL);
+	signal(SIGPIPE, SIG_IGN);
+
+	logmsg("starting: uart=%s baud=%d power=%s delay=%dms",
+	       cfg.dev, cfg.baud, cfg.use_power ? cfg.gpio : "untouched",
+	       cfg.power_delay_ms);
+
+	if (power_set(1) < 0)
+		logmsg("continuing without power control");
+
+	if (cfg.power_delay_ms > 0) {
+		struct timespec ts = { cfg.power_delay_ms / 1000,
+				       (cfg.power_delay_ms % 1000) * 1000000L };
+		nanosleep(&ts, NULL);
+	}
+
+	fd = serial_open(cfg.dev, cfg.baud);
+	if (fd < 0) {
+		ret = 1;
+		goto out;
+	}
+
+	out_init(&out);
+	memset(&nmea, 0, sizeof(nmea));
+
+	if (cfg.do_init) {
+		/* Consumes the chip's handshake replies; anything that is not a
+		 * BRI frame during this phase is counted, not forwarded. */
+		if (asic_init(fd) < 0)
+			logmsg("init: handshake aborted, falling back to the "
+			       "raw receive loop");
+		else
+			logmsg("init: handshake sequence finished");
+	}
+
+	started = last_report = time(NULL);
+
+	while (!g_stop) {
+		int nfds = 0, r, serial_idx, listen_idx = -1, sig_idx;
+
+		pfds[nfds].fd = fd;
+		pfds[nfds].events = POLLIN;
+		serial_idx = nfds++;
+
+		if (out.listen_fd >= 0) {
+			pfds[nfds].fd = out.listen_fd;
+			pfds[nfds].events = POLLIN;
+			listen_idx = nfds++;
+		}
+
+		sig_idx = nfds;
+		pfds[nfds].fd = g_sigpipe[0];
+		pfds[nfds].events = POLLIN;
+		nfds++;
+
+		r = poll(pfds, (nfds_t)nfds, 1000);
+		if (r < 0) {
+			if (errno == EINTR)
+				continue;
+			logmsg("poll: %s", strerror(errno));
+			break;
+		}
+
+		if (pfds[sig_idx].revents & POLLIN) {
+			char tmp[16];
+			ssize_t n = read(g_sigpipe[0], tmp, sizeof(tmp));
+			(void)n;
+			break;
+		}
+
+		if (listen_idx >= 0 && (pfds[listen_idx].revents & POLLIN))
+			out_accept(&out);
+
+		if (pfds[serial_idx].revents & (POLLIN | POLLHUP | POLLERR)) {
+			char buf[RX_CHUNK];
+			ssize_t n = read(fd, buf, sizeof(buf));
+			if (n > 0) {
+				nmea_feed(&out, &nmea, buf, (size_t)n);
+			} else if (n == 0 || (n < 0 && errno != EAGAIN && errno != EINTR)) {
+				logmsg("read(%s): %s; reopening", cfg.dev,
+				       n == 0 ? "EOF" : strerror(errno));
+				close(fd);
+				fd = serial_open(cfg.dev, cfg.baud);
+				if (fd < 0) {
+					ret = 1;
+					break;
+				}
+			}
+		}
+
+		/* Status / diagnostics */
+		{
+			time_t now = time(NULL);
+
+			if (now - last_report >= 30) {
+				last_report = now;
+				logmsg("stats: rx=%lu B nmea=%lu bad_cs=%lu dropped=%lu clients=%d",
+				       nmea.total_bytes, nmea.nmea_sentences,
+				       nmea.nmea_bad, nmea.dropped_bytes,
+				       out.nclients);
+			}
+
+			if (nmea.total_bytes == 0 && now - started == 10)
+				logmsg("no UART data 10s after power-on: the BCM4752 "
+				       "does not free-run NMEA; try --init "
+				       "(see parity/reports/gps-init-impl.md)");
+
+			if (cfg.probe_baud && nmea.total_bytes == 0 &&
+			    now - started >= 15 && probe_idx + 1 < (int)(sizeof(probe_rates) / sizeof(probe_rates[0]))) {
+				probe_idx++;
+				logmsg("probing alternative baud rate %d", probe_rates[probe_idx]);
+				close(fd);
+				fd = serial_open(cfg.dev, probe_rates[probe_idx]);
+				if (fd < 0) {
+					ret = 1;
+					break;
+				}
+				started = now;
+				nmea.total_bytes = 0;
+			}
+		}
+	}
+
+	/* If nothing was ever received, say so once more on exit. */
+	if (nmea.total_bytes == 0)
+		logmsg("exiting: no NMEA bytes were ever received from %s "
+		       "(%lu bytes were consumed by the BRI handshake)",
+		       cfg.dev, bri_rx_bytes);
+	else
+		logmsg("exiting: rx=%lu B, %lu NMEA sentences forwarded, "
+		       "%lu bad checksums, %lu non-NMEA bytes discarded",
+		       nmea.total_bytes, nmea.nmea_sentences,
+		       nmea.nmea_bad, nmea.dropped_bytes);
+
+out:
+	out_close(&out);
+	if (fd >= 0)
+		close(fd);
+	power_set(0);
+	logmsg("GPS powered off");
+	return ret;
+}
diff --git a/parity/userspace/gps/tests/init_test.py b/parity/userspace/gps/tests/init_test.py
new file mode 100755
index 0000000..0dbc483
--- /dev/null
+++ b/parity/userspace/gps/tests/init_test.py
@@ -0,0 +1,147 @@
+#!/usr/bin/env python3
+"""
+Off-target test of the --init handshake of j7elte-gpsd.
+
+The BCM4752 is emulated by the test itself on the master side of a PTY.
+It reproduces what the real chip does on j7elte hardware: it never sends the
+unsolicited BRI announce frame, ignores the 10-byte NvRamWord7 selection, and
+answers the NvRamWord7 read, the 0x40/0x1a status request, the HW version
+request and the DebugSfr request -- in that order and only in that order
+(DebugSfr is state-gated on the NvRamWord7 exchange, as the vendor code
+asserts at 0x2a6784).  The test checks that the daemon emits exactly the
+bytes in the reverse-engineered tables, in the order the hardware answers.
+
+The daemon runs under qemu-aarch64 against the cross sysroot, so this also
+exercises the real termios/poll/write path.
+"""
+import os
+import pty
+import re
+import select
+import signal
+import subprocess
+import sys
+import tempfile
+import time
+
+ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+BIN = os.path.join(ROOT, "j7elte-gpsd")
+SYSROOT = ("/run/media/user/00000000-0000-4000-8000-000000000000/"
+           "j7elte-session/toolchains/gcc-arm-10.3-2021.07-x86_64-"
+           "aarch64-none-linux-gnu/aarch64-none-linux-gnu/libc")
+
+AUTOBAUD = b"\x80" * 16
+OUT_OF_LEGACY = bytes([0xFE, 0x00, 0xFD, 0x00, 0x00, 0x55, 0xAA, 0x00, 0xFF, 0xFC])
+REQ_HW_VERSION = bytes([0xFF, 0x00, 0xFD, 0x00, 0x00, 0xFC])
+REQ_DEBUG_SFR = bytes([0xFF, 0x00, 0xFD, 0x1F, 0x95, 0xFC])
+NV_SELECT = bytes([0xFE, 0x00, 0xFD, 0x00, 0x1B, 0x07, 0x00, 0x00, 0x00, 0xFC])
+NV_READ = bytes([0xFF, 0x00, 0xFD, 0x00, 0x1B, 0xFC])
+REQ_STATUS = bytes([0xFF, 0x00, 0xFD, 0x40, 0x1A, 0xFC])
+
+
+def resp(cmd, sub, data=b"\x02\x03\x04\x05"):
+    return bytes([0xFE, 0x00, 0xFD, cmd, sub]) + data + b"\xFC"
+
+
+def read_exact(fd, n, timeout=10.0):
+    buf = b""
+    end = time.time() + timeout
+    while len(buf) < n and time.time() < end:
+        r, _, _ = select.select([fd], [], [], 0.2)
+        if r:
+            buf += os.read(fd, 4096)
+            # the PTY master echoes nothing; drop any CR/LF noise
+            buf = buf.replace(b"\r", b"").replace(b"\n", b"")
+    return buf
+
+
+def main():
+    failures = []
+
+    def check(name, cond, detail=""):
+        print(("PASS: " if cond else "FAIL: ") + name + ((" " + detail) if detail and not cond else ""))
+        if not cond:
+            failures.append(name)
+
+    tmp = tempfile.mkdtemp(prefix="gpsd-init-")
+    rundir = os.path.join(tmp, "run")
+    master, slave = pty.openpty()
+    slave_name = os.ttyname(slave)
+
+    cmd = [
+        "qemu-aarch64", "-L", SYSROOT, BIN,
+        "--device", slave_name,
+        "--baud", "921600",
+        "--no-power",
+        "--power-delay", "0",
+        "--rundir", rundir,
+        "--socket", "none",
+        "--init",
+        "--verbose",
+    ]
+    logpath = os.path.join(tmp, "daemon.log")
+    log = open(logpath, "w+")
+    proc = subprocess.Popen(cmd, stdout=log, stderr=log)
+
+    try:
+        got = read_exact(master, len(AUTOBAUD))
+        check("autobaud burst is 16 x 0x80", got == AUTOBAUD, repr(got))
+
+        # The real chip never announces itself; answer anyway so that the
+        # daemon's announce window has something to log.
+        os.write(master, resp(0x00, 0x01))
+
+        got = read_exact(master, len(NV_SELECT))
+        check("Bri_RequestNvRamWord7 selection frame", got == NV_SELECT, repr(got))
+        # ... which the chip ignores.
+
+        got = read_exact(master, len(NV_READ))
+        check("NvRamWord7 read frame", got == NV_READ, repr(got))
+        os.write(master, resp(0x00, 0x1B, b"\x07\x00\x00\x00"))
+
+        got = read_exact(master, len(REQ_STATUS))
+        check("status 0x40/0x1a frame", got == REQ_STATUS, repr(got))
+        os.write(master, resp(0x40, 0x1A, b"\x02\x00\x10\xa4"))
+
+        got = read_exact(master, len(REQ_HW_VERSION))
+        check("Bri_RequestHwVersion frame", got == REQ_HW_VERSION, repr(got))
+        os.write(master, resp(0x00, 0x00, b"\x05\x00\x02\x30"))
+
+        got = read_exact(master, len(REQ_DEBUG_SFR))
+        check("Bri_RequestDebugSfr frame", got == REQ_DEBUG_SFR, repr(got))
+        os.write(master, resp(0x1F, 0x95, b"\x00\x00\x00\x00"))
+
+        got = read_exact(master, len(OUT_OF_LEGACY))
+        check("Bri_GetOutOfLegacy frame", got == OUT_OF_LEGACY, repr(got))
+        os.write(master, resp(0x00, 0x01))
+
+        time.sleep(0.4)
+    finally:
+        proc.send_signal(signal.SIGTERM)
+        try:
+            proc.wait(timeout=10)
+        except subprocess.TimeoutExpired:
+            proc.kill()
+            proc.wait()
+        log.flush()
+        text = open(logpath).read()
+        log.close()
+
+    check("NvRamWord7 word decoded", "NvRamWord7 word 7 = 0x00000007" in text)
+    check("status decoded", "status 0x40/0x1a = 0xa4100002" in text)
+    check("HW version decoded", "BRI HW version 0x30020005" in text)
+    check("DebugSfr acknowledged", "DebugSfr acknowledged" in text)
+    check("link check counted", "link check: 5 of 6 exchanges answered" in text)
+    check("residual blocker logged", "stopping here" in text)
+    check("GetOutOfLegacy not repeated after an ack",
+          text.count("Bri_GetOutOfLegacy sent") == 1)
+
+    print("\n--- daemon log ---")
+    print(text)
+    print("------------------")
+    print(("FAILED: %d" % len(failures)) if failures else "ALL PASS")
+    return 1 if failures else 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/parity/userspace/gps/tests/smoke_test.py b/parity/userspace/gps/tests/smoke_test.py
new file mode 100755
index 0000000..14634d9
--- /dev/null
+++ b/parity/userspace/gps/tests/smoke_test.py
@@ -0,0 +1,136 @@
+#!/usr/bin/env python3
+"""
+Off-target functional test for j7elte-gpsd.
+
+No BCM4752 hardware is involved: the "UART" is a host PTY, the "GPS_PWR_EN"
+attribute is a regular file, and the daemon itself runs under qemu-aarch64
+against the aarch64 cross sysroot.  The test checks:
+
+  * power sequencing writes "1" on start and "0" on SIGTERM,
+  * raw 8N1 termios setup succeeds on a tty-like device,
+  * valid NMEA sentences are forwarded to the PTY and to the Unix socket,
+  * binary (non-NMEA) bytes are dropped and counted, not forwarded,
+  * the PTY is exposed at <rundir>/tty and the socket at <rundir>/<name>.
+"""
+import os
+import pty
+import select
+import signal
+import subprocess
+import sys
+import tempfile
+import time
+
+ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+BIN = os.path.join(ROOT, "j7elte-gpsd")
+SYSROOT = "/run/media/user/00000000-0000-4000-8000-000000000000/j7elte-session/toolchains/gcc-arm-10.3-2021.07-x86_64-aarch64-none-linux-gnu/aarch64-none-linux-gnu/libc"
+
+NMEA = [
+    b"$GPGGA,123519,4807.038,N,01131.000,E,1,08,0.9,545.4,M,46.9,M,,*47\r\n",
+    b"$GPRMC,123519,A,4807.038,N,01131.000,E,022.4,084.4,230394,003.1,W*6A\r\n",
+]
+
+
+def read_until(fd, marker, timeout=10.0):
+    buf = b""
+    end = time.time() + timeout
+    while time.time() < end:
+        r, _, _ = select.select([fd], [], [], 0.2)
+        if r:
+            buf += os.read(fd, 65536)
+            if marker in buf:
+                return buf
+    return buf
+
+
+def main():
+    tmp = tempfile.mkdtemp(prefix="gpsd-test-")
+    rundir = os.path.join(tmp, "run")
+    gpio = os.path.join(tmp, "GPS_PWR_EN")
+    open(gpio, "w").write("0")
+
+    master, slave = pty.openpty()
+    slave_name = os.ttyname(slave)
+
+    cmd = [
+        "qemu-aarch64", "-L", SYSROOT, BIN,
+        "--device", slave_name,
+        "--baud", "921600",
+        "--gpio", gpio,
+        "--power-delay", "10",
+        "--rundir", rundir,
+        "--socket", "test.sock",
+        "--verbose",
+    ]
+    print("exec:", " ".join(cmd))
+    log = open(os.path.join(tmp, "daemon.log"), "w+b")
+    p = subprocess.Popen(cmd, stdout=log, stderr=subprocess.STDOUT)
+
+    time.sleep(1.0)
+    if open(gpio).read().strip() != "1":
+        print("FAIL: power GPIO not asserted")
+        p.kill()
+        return 1
+
+    # Feed one good sentence, a binary blob, then another good sentence.
+    os.write(master, NMEA[0])
+    os.write(master, bytes.fromhex("aa4412") + b"\x01\x02\x03\xff\xfe")
+    os.write(master, NMEA[1])
+
+    link = os.path.join(rundir, "tty")
+    if not os.path.islink(link):
+        print("FAIL: %s missing" % link)
+        p.kill()
+        return 1
+    pty_consumer = os.open(link, os.O_RDONLY | os.O_NOCTTY | os.O_NONBLOCK)
+    got = read_until(pty_consumer, NMEA[1][:12], 5.0)
+
+    import socket
+    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
+    s.settimeout(5.0)
+    s.connect(os.path.join(rundir, "test.sock"))
+    os.write(master, NMEA[0])
+    sock_got = b""
+    try:
+        sock_got = s.recv(4096)
+    except Exception:
+        pass
+
+    p.send_signal(signal.SIGTERM)
+    try:
+        p.wait(timeout=10)
+    except subprocess.TimeoutExpired:
+        p.kill()
+
+    gpio_after = open(gpio).read().strip()
+    log.flush()
+    log.seek(0)
+    daemon_log = log.read().decode(errors="replace")
+
+    ok = True
+    def check(name, cond):
+        nonlocal ok
+        print(("PASS: " if cond else "FAIL: ") + name)
+        ok = ok and cond
+
+    check("power asserted on start", True)
+    check("first NMEA sentence reached PTY", NMEA[0].split(b",")[0] in got)
+    check("second NMEA sentence reached PTY", NMEA[1].split(b",")[0] in got)
+    check("binary bytes not forwarded to PTY", b"\xaa\x44\x12" not in got)
+    check("NMEA reached Unix socket", sock_got.startswith(b"$"))
+    check("power deasserted on exit", gpio_after == "0")
+    check("stats accounted for dropped binary bytes",
+          "non-NMEA bytes discarded" in daemon_log)
+    check("stable PTY link reported", "NMEA PTY ready" in daemon_log)
+
+    if not ok:
+        print("---- daemon log ----")
+        print(daemon_log)
+    else:
+        print("all checks passed; log tail:")
+        print("\n".join(daemon_log.strip().splitlines()[-6:]))
+    return 0 if ok else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
