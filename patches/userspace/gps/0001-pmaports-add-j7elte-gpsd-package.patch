+#
+# Userspace bridge for the Broadcom BCM4752 GPS of the Samsung Galaxy J7
+# (j7elte).  The kernel side (linux-samsung-j7elte) already provides
+# /sys/class/sec/gps/GPS_PWR_EN/value and leaves /dev/ttySAC0 free; see
+# parity/reports/gps.md and parity/reports/gps-userspace.md.
+maintainer=""
+pkgname=j7elte-gpsd
+pkgver=1.0
+pkgrel=0
+pkgdesc="BCM4752 GPS NMEA bridge for the Samsung Galaxy J7 (j7elte)"
+url="https://postmarketos.org"
