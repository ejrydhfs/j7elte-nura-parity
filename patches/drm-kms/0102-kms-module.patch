@@ -491,6 +495,7 @@
 		dev_err(dev, "IOVMM: No IOVM region %pa to free.\n", &iova);
 	}
 }
+EXPORT_SYMBOL_GPL(iovmm_unmap);
 
 int iovmm_map_oto(struct device *dev, phys_addr_t phys, size_t size)
 {
