From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: KmsModule <kmsmodule@local>
Date: Mon, 23 Nov 2026 12:10:00 
Subject: [PATCH 0102] gpu31-kms: loadable module plumbing + unbind-safe vendor remove

int53/int59 keep the source series unchanged and add the module plumbing so
the KMS driver can be loaded by hand on a running device instead of replacing
the vendor display stack at boot:

  - DRM_EXYNOS7580 becomes tristate.  The KMS choice still gates it and the
    vendor DECON fbdev stack stays built in, so /dev/fb0 always exists and a
    failed load is reversible with rmmod or a reboot.
  - Module build: CONFIG_MODULES=y + CONFIG_MODULE_UNLOAD=y (the shipping
    config had modules off), module_init/module_exit instead of the built-in
    late_initcall (int58 proved the vendor late_initcall_sync move bootloops,
    so int59 keeps the vendor DECON at the stock late_initcall).  The
    built-in path is untouched.
  - Loadable set: DRM_KMS_HELPER is a promptless tristate selected by our
    symbol, so it resolves to =m; the two objects are drm_kms_helper.ko and
    exynos-drm7580.ko (helper first).  Everything else the driver uses (DRM
    core, vendor decon stack, IOVMM) stays built in.  Never auto-loaded: no
    MODULE_ALIAS/softdep, no modules.alias on the device, DT untouched.
  - Vendor unbind is now safe and the device is re-bindable:
      * decon_remove() mirrors the probe unwind: pipe disabled (state != OFF),
        update/psr/vsync threads stopped, lpd workqueue destroyed, ion client
        destroyed, framebuffers released, media entity unregistered, and the
        platform drvdata + exported decon_int_drvdata cleared;
      * decon and decon->pdata are devm allocations, so the stock kfree() of
        both is gone from ->remove and from the probe fail_kfree label (the
        stock code double-freed them on unbind or probe failure, which the
        KMS module probe would hit: it calls decon_probe_common()).  Devres
        releases them (and the devm IRQs) after ->remove returns, i.e. IRQs
        before the structs.
      This is what makes `unbind' -> insmod -> rmmod -> rebound work.
  - Exports: the only imports modpost cannot resolve from the built-in tree
    were iovmm_map()/iovmm_unmap() (drivers/iommu/exynos-iovmm-v6.c); they are
    EXPORT_SYMBOL_GPL now.  decon_kms_* are already exported by 0100.  The
    full import list is in docs/reports/decon-kms-module.md.

No device tree hunks.  rmmod runs the unload path (drm_put_dev -> fbdev +
drm cleanup -> decon_kms_put) as long as no DRM client holds card0 open.

From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: KmsModule <kmsmodule@local>
Date: Mon, 23 Nov 2026 12:10:00 
Subject: [PATCH 0102] gpu31-kms: build the KMS driver as a loadable module (int53)

int53 keeps the source series unchanged and adds the module plumbing so the
KMS driver can be loaded by hand on a running device instead of replacing the
vendor display stack at boot:

  - DRM_EXYNOS7580 becomes tristate; the KMS choice still gates it and the
    vendor DECON fbdev stack stays built in (EXYNOS_DECON_EXYNOS7580=y), so
    /dev/fb0 and the hardening display are always there and a failed load is
    reversible with rmmod or a reboot;
  - built as a module the driver registers with module_init/module_exit
    (module_platform_driver would pull the driver registration into probe
    order, which does not exist for a module); the built-in late_initcall
    path is untouched, so int52 and the shipping KMS image are unchanged;
  - the module is never auto-loaded: no MODULE_ALIAS/softdep and no
    modules.alias on the device, and the device tree is untouched; the test
    unbinds the vendor driver first
    (echo 14830000.decon_fb > /sys/bus/platform/drivers/decon/unbind)
    and then insmods exynos-drm7580.ko;
  - vendor decon_remove() now clears the platform drvdata, the exported
    decon_int_drvdata and unregisters the V4L2 subdev before freeing the
    decon_device: the stock remove leaves all three dangling, so an unbind
    followed by the module probe would read freed memory;
  - exports: every vendor symbol the module imports is EXPORT_SYMBOL_GPL
    (added here next to the definition) - see the symbol list in
    docs/reports/decon-kms-module.md.

No device tree hunks.  rmmod runs the same unload path as the built-in
remove (drm_put_dev -> fbdev + drm cleanup -> decon_kms_put), as long as no
DRM client holds card0 open.


--- a/drivers/gpu/drm/exynos7580/Kconfig
+++ b/drivers/gpu/drm/exynos7580/Kconfig
@@ -1,6 +1,6 @@
 config DRM_EXYNOS7580
-	bool "DRM/KMS support for Samsung Exynos 7580 (DECON + MIPI DSIM)"
-	depends on DRM=y && OF && ARM64 && ARCH_EXYNOS && EXYNOS7580_DISPLAY_KMS && EXYNOS_IOVMM_V6
+	tristate "DRM/KMS support for Samsung Exynos 7580 (DECON + MIPI DSIM)"
+	depends on DRM && OF && ARM64 && ARCH_EXYNOS && EXYNOS7580_DISPLAY_KMS && EXYNOS_IOVMM_V6
 	select DRM_KMS_HELPER
 	select DRM_KMS_CMA_HELPER
 	select VIDEOMODE_HELPERS
@@ -11,7 +11,14 @@
 
 	  Provides a single CRTC with one primary plane, a DSI encoder and
 	  connector, CMA backed dumb buffers and fbdev emulation.  Only the
-	  EXYNOS7580_DISPLAY_KMS choice may select it.  It must be built in
-	  (not a module): it binds the DECON node at late_initcall, after
-	  the vendor DSIM/panel driver, and the vendor fbdev driver binds
-	  only at late_initcall_sync when this probe fails.
+	  EXYNOS7580_DISPLAY_KMS choice may select it.
+
+	  Built in (=y) it binds the DECON node at late_initcall, after the
+	  vendor DSIM/panel driver, and the vendor fbdev driver binds only at
+	  late_initcall_sync when this probe fails.  Built as a module (=m,
+	  int53) the vendor fbdev driver always binds at boot; the module is
+	  never auto-loaded (no modules.alias on the device) and is brought
+	  up by hand after unbinding the vendor driver:
+
+	    echo 14830000.decon_fb > /sys/bus/platform/drivers/decon/unbind
+	    insmod exynos-drm7580.ko
--- a/drivers/gpu/drm/exynos7580/exynos_drm7580_main.c
+++ b/drivers/gpu/drm/exynos7580/exynos_drm7580_main.c
@@ -530,7 +530,26 @@
 {
 	return platform_driver_register(&exynos7580_drm_platform_driver);
 }
+
+#ifdef MODULE
+/*
+ * int53: built as a loadable module.  module_init is level 6, which is
+ * fine because nothing binds at boot: the module is only loaded by hand
+ * after the vendor fbdev driver has been unbound, i.e. after the panel
+ * driver and the vendor stack are fully up.  The built-in image keeps the
+ * level-7 late_initcall so the vendor fbdev fallback ordering is
+ * unchanged.
+ */
+static void __exit exynos7580_drm_exit(void)
+{
+	platform_driver_unregister(&exynos7580_drm_platform_driver);
+}
+
+module_init(exynos7580_drm_init);
+module_exit(exynos7580_drm_exit);
+#else
 late_initcall(exynos7580_drm_init);
+#endif
 
 MODULE_AUTHOR("gpu31-kms");
 MODULE_DESCRIPTION(DRIVER_DESC);
--- a/drivers/video/exynos/decon_7580/decon_core.c
+++ b/drivers/video/exynos/decon_7580/decon_core.c
@@ -4692,7 +4692,7 @@
 						GFP_KERNEL);
 	if (!decon->pdata) {
 		decon_err("no memory for DECON platdata\n");
-		kfree(decon);
+		/* decon is a devm allocation: devres frees it. */
 		return -ENOMEM;
 	}
 
@@ -5103,9 +5103,12 @@
 	mutex_destroy(&decon->vsync_info.irq_lock);
 
 fail_kfree:
-	kfree(decon->pdata);
-	kfree(decon);
-
+	/*
+	 * decon and decon->pdata are devm allocations (probe_common): the
+	 * driver core frees them after a failed probe/bind, so they must not
+	 * be freed here as well (the stock code double-freed on probe failure,
+	 * which matters because the KMS module probe calls this body).
+	 */
 	decon_err("decon probe fail");
 	return ret;
 }
@@ -5121,15 +5124,28 @@
 	struct decon_device *decon = platform_get_drvdata(pdev);
 	int i;
 
+	if (!decon)
+		return 0;
+
+	/*
+	 * int53: the vendor driver never supported unbind.  The stock remove
+	 * only stopped the update thread, released the framebuffers and
+	 * kfree()d the devm-allocated decon_device (double free when the
+	 * driver core releases devres after ->remove), and it left the
+	 * psr/vsync threads, the lpd workqueue, the ion client and the V4L2
+	 * subdev alive against freed memory.  Unbind is a supported operation
+	 * for the module test, so mirror the probe unwind (fail_* labels) and
+	 * decon_kms_teardown(); decon and decon->pdata stay devm allocations
+	 * and are released by the driver core after this returns.
+	 */
+	if (decon->state != DECON_STATE_OFF)
+		decon_disable(decon);
+
 	pm_runtime_disable(dev);
 	decon_put_clocks(decon);
+	iovmm_deactivate(dev);
 
-	iovmm_deactivate(dev);
-	/*
-	 * fb0 may not exist: it is only registered when the vendor probe owned
-	 * the pipe (KMS mode attaches without a framebuffer, and the
-	 * coexistence hand-off unregisters it).
-	 */
+	/* fb0 may not exist (KMS stand-up never registered one). */
 	if (decon->fb_registered) {
 		unregister_framebuffer(
 			decon->windows[decon->pdata->default_win]->fbinfo);
@@ -5139,11 +5155,33 @@
 	if (decon->update_regs_thread)
 		kthread_stop(decon->update_regs_thread);
 
+	decon_int_destroy_psr_thread(decon);
+
+	if (decon->vsync_info.thread)
+		kthread_stop(decon->vsync_info.thread);
+	decon_int_destroy_vsync_thread(decon);
+
+	if (decon->ion_client) {
+		ion_client_destroy(decon->ion_client);
+		decon->ion_client = NULL;
+	}
+
+	if (decon->lpd_wq) {
+		destroy_workqueue(decon->lpd_wq);
+		decon->lpd_wq = NULL;
+	}
+
 	for (i = 0; i < decon->pdata->max_win; i++)
 		decon_release_windows(decon->windows[i]);
 
 	debugfs_remove_recursive(decon->debug_root);
-	kfree(decon);
+	decon->debug_root = NULL;
+
+	decon_unregister_entity(decon);
+
+	platform_set_drvdata(pdev, NULL);
+	if (decon_int_drvdata == decon)
+		decon_int_drvdata = NULL;
 
 	decon_info("remove sucessful\n");
 	return 0;
--- a/drivers/iommu/exynos-iovmm-v6.c
+++ b/drivers/iommu/exynos-iovmm-v6.c
@@ -13,6 +13,7 @@
 #endif
 
 #include <linux/kernel.h>
+#include <linux/export.h>
 #include <linux/hardirq.h>
 #include <linux/slab.h>
 #include <linux/scatterlist.h>
@@ -434,6 +435,9 @@
 		"IOVMM: Failed to allocated VM region for %#x bytes.\n", size);
 	return (dma_addr_t)ret;
 }
