From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: KmsMain <kmsmain@local>
Date: Mon, 23 Nov 2026 09:45:56 
Subject: [PATCH 0200] gpu31-kms: DECON KMS main bind - card0, atomic drm_driver, late_initcall

Register the DECON DRM/KMS device (card0) on the stock Exynos 7580 tree.

This is the M1 integration patch for the slice that owns probe/bind and it
implements the binding rules of docs/reports/decon-kms-coexist.md 4.3:

  - a drm_driver with DRIVER_ATOMIC|DRIVER_MODESET|DRIVER_GEM|DRIVER_PRIME and
    DRIVER_NAME "exynos" (Mesa kmsro pairs exynos_dri.so with the render node
    by driver name, decon-kms-req.md requirement 2);
  - a platform_driver that matches ONLY "samsung,exynos5-decon_driver" -
    never the dsim node, never a new compatible; the shipped dt.img is used
    unchanged;
  - card0 is registered with drm_platform_init() from a late_initcall
    (level 7, drivers/gpu/ after drivers/video/), never
    module_platform_driver (level 6, before the panel driver);
  - every failure returns an error to the driver core, so the vendor DECON
    fbdev driver - moved here to late_initcall_sync - binds the still-unbound
    device and restores /dev/fb0 plus the X11 path without a re-flash;
  - the vblank plumbing the fence slice arms flip events from:
    drm_vblank_init() plus get/enable/disable_vblank and the DECON FRAME
    interrupt trampoline, which calls drm_handle_vblank() and
    exynos7580_vblank_irq();
  - the global atomic commit: fallible CRTC link enable ->
    drm_atomic_helper_prepare_planes() -> drm_atomic_helper_swap_state() ->
    exynos7580_commit_tail(); drm_atomic_helper_commit() is deliberately not
    used because the link enable can fail before any state is swapped;
  - construction order planes -> crtc (index 0, primary = planes[0]) -> DSI
    encoder/connector -> fbdev (fb0 + initial modeset), with the unwind of
    everything this patch registered.

The DECON handle comes from decon_kms_get(&pdev->dev): the vendor decon_probe()
does not run in KMS mode, so the shim must stand the DECON up there (clocks,
SFR mapping, runtime PM/iovmm, panel hand-off). A failure is fatal for the
probe, before any DRM object exists.

This patch also carries, rebased onto the pre-state it expects, the
display-owner Kconfig choice and the vendor fbdev late_initcall_sync move from
patches/drm-kms-coexist/0001-display-owner-kconfig.patch (same semantics; that
patch is subsumed and must NOT be applied a second time on top of this one).

Two deltas against that patch, both required to keep Kconfig sane on this tree:

  1. the choice's first default reads "default EXYNOS7580_DISPLAY_FBDEV"
     without "if FB", and EXYNOS7580_DISPLAY_FBDEV no longer says
     "depends on FB".  With either of those, Kconfig reports a recursive
     dependency: FB is selected by DRM_KMS_HELPER, DRM_KMS_HELPER is selected
     by DRM_EXYNOS7580, DRM_EXYNOS7580 depends on EXYNOS7580_DISPLAY_KMS, and
     the choice would depend on FB.  The semantics are unchanged: FBDEV stays
     the shipping default, EXYNOS7580_DISPLAY_KMS still requires DRM=y and is
     selected by the KMS config fragment, and the vendor symbol
     EXYNOS_DECON_EXYNOS7580 still depends on FB.
  2. the vendor Kconfig files are used as the pre-state: nothing else in this
     patch touches the vendor stack.

Apply order: patches/drm-atomic/0001..0005, the patches/drm-kms core fixes,
the crtc/plane/dsi/dmabuf/fence/fbdev source patches, then this one.  No device
tree hunks.

diff --git a/drivers/gpu/drm/Kconfig b/drivers/gpu/drm/Kconfig
--- a/drivers/gpu/drm/Kconfig
+++ b/drivers/gpu/drm/Kconfig
@@ -201,6 +201,8 @@
 
 source "drivers/gpu/drm/exynos/Kconfig"
 
+source "drivers/gpu/drm/exynos7580/Kconfig"
+
 source "drivers/gpu/drm/vmwgfx/Kconfig"
 
 source "drivers/gpu/drm/gma500/Kconfig"
diff --git a/drivers/gpu/drm/Makefile b/drivers/gpu/drm/Makefile
--- a/drivers/gpu/drm/Makefile
+++ b/drivers/gpu/drm/Makefile
@@ -45,6 +45,7 @@
 obj-$(CONFIG_DRM_VIA)	+=via/
 obj-$(CONFIG_DRM_NOUVEAU) +=nouveau/
 obj-$(CONFIG_DRM_EXYNOS) +=exynos/
+obj-$(CONFIG_DRM_EXYNOS7580) += exynos7580/
 obj-$(CONFIG_DRM_GMA500) += gma500/
 obj-$(CONFIG_DRM_UDL) += udl/
 obj-$(CONFIG_DRM_AST) += ast/
diff --git a/drivers/video/exynos/decon_7580/Kconfig b/drivers/video/exynos/decon_7580/Kconfig
--- a/drivers/video/exynos/decon_7580/Kconfig
+++ b/drivers/video/exynos/decon_7580/Kconfig
@@ -1,3 +1,31 @@
+choice
+	prompt "Exynos 7580 display stack"
+	default EXYNOS7580_DISPLAY_FBDEV
+	help
+	  Selects whether the DECON DRM/KMS display driver is built.  The
+	  vendor fbdev stack is always built: it provides the DSIM/panel
+	  and window/register code the KMS driver calls, and it stays in
+	  the image as the late_initcall_sync fallback if the KMS probe
+	  fails.
+
+config EXYNOS7580_DISPLAY_FBDEV
+	bool "Legacy DECON fbdev only (X11 / nura-shell)"
+	help
+	  Shipping default.  No DRM display driver; the vendor fbdev
+	  driver owns DECON and registers /dev/fb0, as it does today.
+
+config EXYNOS7580_DISPLAY_KMS
+	bool "DECON DRM/KMS on top of the vendor stack (Plasma Mobile)"
+	depends on DRM=y
+	help
+	  Builds the DRM/KMS display driver.  It binds the DECON node at
+	  late_initcall (after the vendor DSIM/panel driver) and registers
+	  card0 plus an fb0 through drm_fbdev_cma.  The vendor fbdev
+	  driver is compiled in but cannot bind while KMS owns DECON; if
+	  the KMS probe fails, it binds at late_initcall_sync and restores
+	  the fbdev/X11 path.
+
+endchoice
 config EXYNOS_DECON_EXYNOS7580
 	bool "Samsung Exynos Display system (DECON, MIPI)"
 	depends on FB
diff --git a/drivers/video/exynos/decon_7580/decon_core.c b/drivers/video/exynos/decon_7580/decon_core.c
--- a/drivers/video/exynos/decon_7580/decon_core.c
+++ b/drivers/video/exynos/decon_7580/decon_core.c
@@ -4887,7 +4887,13 @@
 {
 	platform_driver_unregister(&decon_driver);
 }
-late_initcall(exynos_decon_register);
+/*
+ * Run after every other late_initcall so that a DECON DRM/KMS driver built
+ * into the same image (EXYNOS7580_DISPLAY_KMS) can bind the device first.
+ * If that driver's probe fails the device stays unbound and this vendor
+ * fbdev driver takes over here, restoring /dev/fb0 and the X11 path.
+ */
+late_initcall_sync(exynos_decon_register);
 module_exit(exynos_decon_unregister);
 
 MODULE_AUTHOR("Ayoung Sim <a.sim@samsung.com>");
diff --git a/drivers/gpu/drm/exynos7580/Kconfig b/drivers/gpu/drm/exynos7580/Kconfig
new file mode 100644
--- /dev/null
+++ b/drivers/gpu/drm/exynos7580/Kconfig
@@ -0,0 +1,17 @@
+config DRM_EXYNOS7580
+	bool "DRM/KMS support for Samsung Exynos 7580 (DECON + MIPI DSIM)"
+	depends on DRM=y && OF && ARM64 && ARCH_EXYNOS && EXYNOS7580_DISPLAY_KMS
+	select DRM_KMS_HELPER
+	select DRM_KMS_CMA_HELPER
+	select VIDEOMODE_HELPERS
+	help
+	  DRM/KMS driver for the Samsung Exynos 7580 display subsystem:
+	  the DECON display controller, the MIPI DSIM master/D-PHY and the
+	  ea8061 720x1280 panel found on the Galaxy J7 (j7elte).
+
+	  Provides a single CRTC with one primary plane, a DSI encoder and
+	  connector, CMA backed dumb buffers and fbdev emulation.  Only the
+	  EXYNOS7580_DISPLAY_KMS choice may select it.  It must be built in
+	  (not a module): it binds the DECON node at late_initcall, after
+	  the vendor DSIM/panel driver, and the vendor fbdev driver binds
+	  only at late_initcall_sync when this probe fails.
diff --git a/drivers/gpu/drm/exynos7580/Makefile b/drivers/gpu/drm/exynos7580/Makefile
new file mode 100644
--- /dev/null
+++ b/drivers/gpu/drm/exynos7580/Makefile
@@ -0,0 +1,18 @@
+#
+# Samsung Exynos 7580 DECON DRM/KMS driver
+#
+# The window/register/DSIM low-level code and the ea8061 panel description are
+# shared with the vendor fbdev driver (it stays built in as the
+# late_initcall_sync fallback), so its directory is on the include path.
+#
+ccflags-y += -I$(srctree)/drivers/video/exynos/decon_7580
+
+obj-$(CONFIG_DRM_EXYNOS7580) += exynos-drm7580.o
+exynos-drm7580-y := \
+	exynos_drm7580_main.o \
+	exynos_drm7580_crtc.o \
+	exynos_drm7580_plane.o \
+	exynos_drm7580_dsi.o \
+	exynos_drm7580_dmabuf.o \
+	exynos_drm7580_fence.o \
+	exynos_drm7580_fbdev.o
diff --git a/drivers/gpu/drm/exynos7580/exynos_drm7580_main.c b/drivers/gpu/drm/exynos7580/exynos_drm7580_main.c
new file mode 100644
--- /dev/null
+++ b/drivers/gpu/drm/exynos7580/exynos_drm7580_main.c
@@ -0,0 +1,554 @@
+/*
+ * Samsung Exynos 7580 DECON DRM/KMS - driver registration, probe and bind
+ *
+ * This file is the integration point of the DECON KMS slices.  It owns:
+ *
+ *   - the drm_driver (DRIVER_ATOMIC | DRIVER_MODESET | DRIVER_GEM |
+ *     DRIVER_PRIME) and its DRIVER_NAME, which must stay "exynos": Mesa's
+ *     kmsro pairs /usr/lib/dri/exynos_dri.so with the render node by driver
+ *     name (docs/reports/decon-kms-req.md, requirement 2);
+ *   - the platform_driver that binds ONLY
+ *     "samsung,exynos5-decon_driver" (never the dsim node, never a new
+ *     compatible - the shipped dt.img is used unchanged);
+ *   - registration of card0 through drm_platform_init(), at late_initcall;
+ *   - the vblank plumbing (drm_vblank_init + get/enable/disable_vblank and
+ *     the DECON FRAME interrupt trampoline) that the fence slice arms flip
+ *     events from;
+ *   - the ordered construction of the subdriver objects
+ *     (planes -> crtc -> dsi encoder/connector -> fbdev) and their unwind.
+ *
+ * Binding rules (docs/reports/decon-kms-coexist.md 4.3):
+ *
+ *   - late_initcall, not module_platform_driver: level 7 in drivers/gpu/ is
+ *     after the vendor DSIM/panel driver (level 7 in drivers/video/), so the
+ *     panel is already lit when we probe, and it is before the vendor DECON
+ *     fbdev driver, which was moved to late_initcall_sync and is the fallback
+ *     when this probe returns an error;
+ *   - every failure path returns an error to the driver core and unwinds what
+ *     this file registered; it never marks the device bound, so the vendor
+ *     `decon` fbdev driver can attach and restore today's /dev/fb0 and X11;
+ *   - no device tree change.
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License version 2 as
+ * published by the Free Software Foundation.
+ */
+
+#include <linux/err.h>
+#include <linux/export.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/scatterlist.h>
+#include <linux/slab.h>
+
+#include <drm/drmP.h>
+#include <drm/drm_atomic.h>
+#include <drm/drm_atomic_helper.h>
+#include <drm/drm_crtc.h>
+#include <drm/drm_crtc_helper.h>
+#include <drm/drm_gem_cma_helper.h>
+
+#include <linux/exynos_decon_kms.h>
+
+#include "exynos_drm7580.h"
+
+#define DRIVER_NAME		"exynos"
+#define DRIVER_DESC		"Samsung Exynos 7580 DECON DRM/KMS"
+#define DRIVER_DATE		"20261123"
+#define DRIVER_MAJOR		1
+#define DRIVER_MINOR		0
+#define DRIVER_PATCHLEVEL	0
+
+/*
+ * The only node KMS may claim.  The DSIM node stays with the vendor
+ * dsim_drv.c (level 7, drivers/video/, linked first) and the KMS DSI encoder
+ * calls into it; claiming it here would take the panel away from both.
+ */
+#define DECON_COMPATIBLE	"samsung,exynos5-decon_driver"
+#define DSIM_COMPATIBLE		"samsung,exynos5-mipi-dsi"
+
+/* The DECON has one video pipe; the CRTC is created at index 0. */
+#define EXYNOS7580_PIPE		0
+
+/* The KMS device is a singleton: there is one decon_0 in the shipped DT. */
+static struct exynos7580_device *exynos7580_device;
+
+/*
+ * Vblank users of the single pipe.  The DECON FRAME interrupt has one handler
+ * owned by the vendor shim (decon_kms_register_vblank_cb()), so the DRM
+ * refcount is kept here instead of in struct exynos7580_device, whose layout
+ * is fixed by the shared contract header.
+ *
+ * The callback is installed once from ->load() and removed in the unwind and
+ * in ->unload(), never from enable_vblank()/disable_vblank(): the DRM core
+ * calls those with dev->vbl_lock held (spinlock, IRQs off, drm_irq.c
+ * drm_vblank_get/put), and decon_kms_register_vblank_cb() is documented as
+ * process context.
+ */
+static atomic_t exynos7580_vblank_users = ATOMIC_INIT(0);
+
+static const struct file_operations exynos7580_fops;
+
+/* ------------------------------------------------------------------------
+ * vblank / DRM_IRQ plumbing
+ *
+ * The vendor DECON driver owns the interrupt; decon_kms_register_vblank_cb()
+ * installs our callback on the FRAME interrupt and enables it while a callback
+ * is registered.  DRM only needs the three driver hooks below plus a
+ * drm_handle_vblank() call from the IRQ: get_vblank_counter() feeds
+ * drm_vblank_count() (the core accounts for missed interrupts), which is what
+ * drm_crtc_arm_vblank_event() in the fence slice timestamps its events with.
+ * ------------------------------------------------------------------------ */
+
+static u32 exynos7580_get_vblank_counter(struct drm_device *drm, int pipe)
+{
+	if (pipe != EXYNOS7580_PIPE)
+		return 0;
+
+	return drm_vblank_count(drm, pipe);
+}
+
+/*
+ * Runs in hard IRQ context on every frame-done interrupt of the DECON.
+ * Must not sleep and must not call back into the decon_kms API.
+ */
+static void exynos7580_vblank_isr(void *data)
+{
+	struct exynos7580_device *ex = data;
+
+	if (!ex || !ex->dev)
+		return;
+
+	drm_handle_vblank(ex->drm, EXYNOS7580_PIPE);
+	exynos7580_vblank_irq(ex->drm, EXYNOS7580_PIPE);
+}
+
+static int exynos7580_enable_vblank(struct drm_device *drm, int pipe)
+{
+	if (pipe != EXYNOS7580_PIPE)
+		return -EINVAL;
+	if (!to_exynos7580(drm))
+		return -ENODEV;
+
+	/* The FRAME interrupt is already armed from ->load(). */
+	atomic_inc(&exynos7580_vblank_users);
+	return 0;
+}
+
+static void exynos7580_disable_vblank(struct drm_device *drm, int pipe)
+{
+	if (pipe != EXYNOS7580_PIPE)
+		return;
+
+	atomic_dec(&exynos7580_vblank_users);
+}
+
+/* ------------------------------------------------------------------------
+ * PRIME export of CMA (dumb/scanout) buffers
+ *
+ * KWin creates its scanout buffers through CREATE_DUMB and then exports them
+ * with drmPrimeHandleToFD() for the GPU (docs/reports/decon-kms-req.md,
+ * requirement 21).  The generic 3.10 helper drm_gem_prime_export() needs the
+ * sg-table/vmap callbacks below; import of foreign buffers is the dmabuf
+ * slice's exynos7580_gem_prime_import(), see exynos_drm7580.h.
+ *
+ * These callbacks describe drm_gem_cma_object buffers.  That is exactly what
+ * CREATE_DUMB allocates here; a buffer imported from another exporter is not
+ * re-exported through this path by any supported user.
+ * ------------------------------------------------------------------------ */
+
+static struct sg_table *exynos7580_gem_prime_get_sg_table(
+					struct drm_gem_object *obj)
+{
+	struct drm_gem_cma_object *cma_obj = to_drm_gem_cma_obj(obj);
+	struct sg_table *sgt;
+	int ret;
+
+	sgt = kzalloc(sizeof(*sgt), GFP_KERNEL);
+	if (!sgt)
+		return ERR_PTR(-ENOMEM);
+
+	ret = sg_alloc_table(sgt, 1, GFP_KERNEL);
+	if (ret) {
+		kfree(sgt);
+		return ERR_PTR(ret);
+	}
+
+	sg_dma_address(sgt->sgl) = cma_obj->paddr;
+	sg_dma_len(sgt->sgl) = obj->size;
+
+	return sgt;
+}
+
+static void *exynos7580_gem_prime_vmap(struct drm_gem_object *obj)
+{
+	return to_drm_gem_cma_obj(obj)->vaddr;
+}
+
+static void exynos7580_gem_prime_vunmap(struct drm_gem_object *obj,
+					void *vaddr)
+{
+}
+
+/* ------------------------------------------------------------------------
+ * Atomic commit
+ *
+ * The generic drm_atomic_helper_commit() is deliberately not used: the DECON
+ * link enable (DSIM stream on, DECON clocks, iovmm) can fail, and it has to
+ * happen before any plane state is prepared or swapped so that a failure
+ * leaves userspace's previous state untouched.  The window programming itself
+ * (one decon_kms_commit() from the last plane hook) and the vblank-armed flip
+ * event are owned by the plane and fence slices respectively.
+ * ------------------------------------------------------------------------ */
+
+static int exynos7580_atomic_commit(struct drm_device *drm,
+				    struct drm_atomic_state *state, bool async)
+{
+	struct exynos7580_device *ex = to_exynos7580(drm);
+	int ret;
+
+	if (async)
+		return -EBUSY;
+	if (!ex)
+		return -ENODEV;
+
+	ret = exynos7580_crtc_enable_link(ex);
+	if (ret) {
+		DRM_ERROR("DECON link enable failed: %d\n", ret);
+		return ret;
+	}
+
+	ret = drm_atomic_helper_prepare_planes(drm, state);
+	if (ret)
+		return ret;
+
+	drm_atomic_helper_swap_state(drm, state);
+
+	exynos7580_commit_tail(state);
+
+	return 0;
+}
+
+static const struct drm_mode_config_funcs exynos7580_mode_config_funcs = {
+	.fb_create	= exynos7580_fb_create,
+	.atomic_check	= drm_atomic_helper_check,
+	.atomic_commit	= exynos7580_atomic_commit,
+};
+
+/* ------------------------------------------------------------------------
+ * Initial modeset
+ *
+ * The fbdev slice owns fb0 and the drm_fb_helper behind it; its
+ * exynos7580_fbdev_init() performs the coexist-mandated
+ * drm_modeset_lock_all() + drm_fb_helper_restore_fbdev_mode() sequence
+ * (through drm_fbdev_cma_restore_mode()) and returns an error when fb0 did
+ * not register or the CRTC does not scan it out.  Main cannot repeat that
+ * call: the helper is not part of the shared contract and the fence/plane
+ * slices own the commit path.  What main does own is the postcondition - a
+ * modeset that registered fb0 but left the CRTC inactive is a probe failure,
+ * because the vendor fallback would otherwise find its own fb0 already taken.
+ * ------------------------------------------------------------------------ */
+
+static int exynos7580_initial_modeset(struct exynos7580_device *ex,
+				      struct drm_device *drm)
+{
+	int ret = 0;
+
+	drm_modeset_lock_all(drm);
+
+	if (!ex->crtc.state || !ex->crtc.state->enable) {
+		DRM_ERROR("CRTC is not active after the initial modeset\n");
+		ret = -EIO;
+	} else if (!ex->crtc.primary || !ex->crtc.primary->fb) {
+		DRM_ERROR("primary plane has no fb0 after the initial modeset\n");
+		ret = -EIO;
+	}
+
+	drm_modeset_unlock_all(drm);
+
+	return ret;
+}
+
+/* ------------------------------------------------------------------------
+ * load / unload
+ * ------------------------------------------------------------------------ */
+
+static int exynos7580_load(struct drm_device *drm, unsigned long flags)
+{
+	struct exynos7580_device *ex;
+	int ret;
+
+	/*
+	 * The DRM core allocates the drm_device (drm_platform_init() ->
+	 * drm_get_platform_dev()); we only keep a pointer to it and publish our
+	 * own state through dev_private, which is what to_exynos7580() reads.
+	 */
+	ex = platform_get_drvdata(drm->platformdev);
+	if (!ex)
+		return -ENODEV;
+
+	ex->drm = drm;
+	ex->dev = &drm->platformdev->dev;
+	drm->dev_private = ex;
+
+	drm_mode_config_init(drm);
+	drm->mode_config.min_width = 64;
+	drm->mode_config.min_height = 64;
+	drm->mode_config.max_width = 2048;
+	drm->mode_config.max_height = 2048;
+	drm->mode_config.funcs = &exynos7580_mode_config_funcs;
+
+	ret = drm_vblank_init(drm, 1);
+	if (ret) {
+		DRM_ERROR("drm_vblank_init failed: %d\n", ret);
+		goto err_config;
+	}
+
+	/* Planes first: the CRTC is created around planes[0]. */
+	ret = exynos7580_planes_init(ex);
+	if (ret) {
+		DRM_ERROR("plane init failed: %d\n", ret);
+		goto err_vblank;
+	}
+
+	ret = exynos7580_crtc_init(ex);
+	if (ret) {
+		DRM_ERROR("CRTC init failed: %d\n", ret);
+		goto err_vblank;
+	}
+
+	/*
+	 * Allocate the per-object atomic states.  The reset callback of the
+	 * connector is called by hand after dsi_init() below:
+	 * drm_mode_config_reset() forces connector->status to unknown, and
+	 * only the DSI encoder knows the panel is connected.
+	 */
+	drm_mode_config_reset(drm);
+
+	ret = exynos7580_dsi_init(ex);
+	if (ret) {
+		DRM_ERROR("DSI encoder/connector init failed: %d\n", ret);
+		goto err_vblank;
+	}
+	if (!ex->connector.state && ex->connector.funcs->reset)
+		ex->connector.funcs->reset(&ex->connector);
+
+	/*
+	 * Arm the FRAME interrupt before the first commit: the initial modeset
+	 * below arms its flip event from vblank, so the counter must advance.
+	 */
+	ret = decon_kms_register_vblank_cb(ex->decon, exynos7580_vblank_isr, ex);
+	if (ret) {
+		DRM_ERROR("failed to arm DECON FRAME interrupt: %d\n", ret);
+		goto err_vblank;
+	}
+
+	/*
+	 * Last fallible step: this registers /dev/fb0 and runs the initial
+	 * modeset.  exynos7580_fbdev_init() must leave no fb0 behind when it
+	 * fails (otherwise the vendor fallback would only get fb1).
+	 */
+	ret = exynos7580_fbdev_init(ex);
+	if (ret) {
+		DRM_ERROR("fbdev init failed: %d\n", ret);
+		goto err_vblank;
+	}
+
+	ret = exynos7580_initial_modeset(ex, drm);
+	if (ret)
+		goto err_vblank;
+
+	DRM_INFO("exynos7580: %s bound, card0 ready (atomic)\n",
+		 DECON_COMPATIBLE);
+
+	return 0;
+
+err_vblank:
+	decon_kms_register_vblank_cb(ex->decon, NULL, NULL);
+	drm_vblank_cleanup(drm);
+err_config:
+	drm_mode_config_cleanup(drm);
+	drm->dev_private = NULL;
+	ex->drm = NULL;
+	return ret;
+}
+
+static int exynos7580_unload(struct drm_device *drm)
+{
+	struct exynos7580_device *ex = drm->dev_private;
+
+	if (!ex)
+		return 0;
+
+	atomic_set(&exynos7580_vblank_users, 0);
+	decon_kms_register_vblank_cb(ex->decon, NULL, NULL);
+
+	drm_vblank_cleanup(drm);
+	drm_mode_config_cleanup(drm);
+
+	if (ex->decon) {
+		decon_kms_put(ex->decon);
+		ex->decon = NULL;
+	}
+
+	drm->dev_private = NULL;
+	ex->drm = NULL;
+
+	return 0;
+}
