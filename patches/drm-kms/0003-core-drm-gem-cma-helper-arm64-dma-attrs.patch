From 8d20356ddc8bc8a86549ab5abbb52f085f3667bf Mon Sep 17 00:00:00 2001
From: KmsFbdev <kmsfbdev@local>
Date: Mon, 23 Nov 2026 09:30:37 -0500
Subject: [PATCH] core: build the CMA GEM helper on arm64 (attribute based DMA
 API)

drm_gem_cma_helper.c used dma_alloc_writecombine()/dma_free_writecombine(),
which only exist for 32 bit ARM (arch/arm/include/asm/dma-mapping.h:195-210).
On arm64 the file does not compile, which is why CONFIG_DRM_KMS_CMA_HELPER
had never been enabled in this tree.

Use DEFINE_DMA_ATTRS() + dma_set_attr(DMA_ATTR_WRITE_COMBINE) with
dma_alloc_attrs()/dma_free_attrs(): identical semantics on arm (those wrappers
are exactly that) and valid on arm64, whose __get_dma_pgprot() honours
DMA_ATTR_WRITE_COMBINE (arch/arm64/mm/dma-mapping.c:37-45).

Also fix the two format specifiers in drm_gem_cma_describe() that this file's
first arm64 build turns up (%08Zx on a dma_addr_t, %d on a size_t).

Needed by KmsFbdev: /dev/fb0 on the DECON KMS device is allocated through
drm_gem_cma_create() (drm_fbdev_cma_init()).
---
 drivers/gpu/drm/drm_gem_cma_helper.c | 22 ++++++++++++++++------
 1 file changed, 16 insertions(+), 6 deletions(-)

diff --git a/drivers/gpu/drm/drm_gem_cma_helper.c b/drivers/gpu/drm/drm_gem_cma_helper.c
index 0a7e011..3610fd5 100644
--- a/drivers/gpu/drm/drm_gem_cma_helper.c
+++ b/drivers/gpu/drm/drm_gem_cma_helper.c
@@ -35,8 +35,15 @@ static unsigned int get_gem_mmap_offset(struct drm_gem_object *obj)
 static void drm_gem_cma_buf_destroy(struct drm_device *drm,
 		struct drm_gem_cma_object *cma_obj)
 {
-	dma_free_writecombine(drm->dev, cma_obj->base.size, cma_obj->vaddr,
-			cma_obj->paddr);
+	/*
+	 * arm64 only has the attribute based DMA API; the
+	 * dma_{alloc,free}_writecombine() wrappers are 32 bit ARM only.
+	 */
+	DEFINE_DMA_ATTRS(attrs);
+
+	dma_set_attr(DMA_ATTR_WRITE_COMBINE, &attrs);
+	dma_free_attrs(drm->dev, cma_obj->base.size, cma_obj->vaddr,
+			cma_obj->paddr, &attrs);
 }
 
 /*
@@ -50,6 +57,7 @@ struct drm_gem_cma_object *drm_gem_cma_create(struct drm_device *drm,
 {
 	struct drm_gem_cma_object *cma_obj;
 	struct drm_gem_object *gem_obj;
+	DEFINE_DMA_ATTRS(attrs);
 	int ret;
 
 	size = round_up(size, PAGE_SIZE);
@@ -58,8 +66,9 @@ struct drm_gem_cma_object *drm_gem_cma_create(struct drm_device *drm,
 	if (!cma_obj)
 		return ERR_PTR(-ENOMEM);
 
-	cma_obj->vaddr = dma_alloc_writecombine(drm->dev, size,
-			&cma_obj->paddr, GFP_KERNEL | __GFP_NOWARN);
+	dma_set_attr(DMA_ATTR_WRITE_COMBINE, &attrs);
+	cma_obj->vaddr = dma_alloc_attrs(drm->dev, size, &cma_obj->paddr,
+			GFP_KERNEL | __GFP_NOWARN, &attrs);
 	if (!cma_obj->vaddr) {
 		dev_err(drm->dev, "failed to allocate buffer with size %d\n", size);
 		ret = -ENOMEM;
@@ -262,9 +271,10 @@ void drm_gem_cma_describe(struct drm_gem_cma_object *cma_obj, struct seq_file *m
 	if (obj->map_list.map)
 		off = (uint64_t)obj->map_list.hash.key;
 
-	seq_printf(m, "%2d (%2d) %08llx %08Zx %p %d",
+	seq_printf(m, "%2d (%2d) %08llx %08llx %p %zu",
 			obj->name, obj->refcount.refcount.counter,
-			off, cma_obj->paddr, cma_obj->vaddr, obj->size);
+			off, (unsigned long long)cma_obj->paddr,
+			cma_obj->vaddr, obj->size);
 
 	seq_printf(m, "\n");
 }
