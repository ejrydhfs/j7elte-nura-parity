From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: KmsFbPost <kmsfbpost@local>
Date: Tue, 24 Nov 2026 03:00:00 
Subject: [PATCH 0117] gpu31-kms: fix the fb0 postcondition and guard the pan path (int74)

1. exynos7580_fbdev_start_scanout()'s postcondition compared the legacy
   crtc->primary->fb / state->enable fields, which the atomic commit path does
   not maintain.  On int73 the pipe was scanning (VIDINTCON0=0x8803, FRAME IRQ
   firing) but the check failed and tore the load down.  The predicate is now
   the atomic state:
     crtc->state && crtc->state->active && crtc->enabled &&
     crtc->primary->state && crtc->primary->state->fb == fb
   and the failure log prints id, enabled, state, active, state->crtc,
   primary->state, primary->state->fb, the legacy primary->fb and the wanted
   fb, so a real mismatch is unambiguous.

2. drm_fb_helper_pan_display() walked into drm_crtc_index() (a BUG() when the
   CRTC is not in dev->mode_config.crtc_list) after a failed first load left
   fb0 alive while the CRTC had been cleaned up.  It now verifies the CRTC is
   the registered object first and returns -ENODEV with
   "pan_display: crtc %p is not registered" instead of crashing.

Both files belong to loadable modules in this configuration (the fbdev slice
and drm_kms_helper), so the built-in image code is unchanged.

--- a/drivers/gpu/drm/exynos7580/exynos_drm7580_fbdev.c
+++ b/drivers/gpu/drm/exynos7580/exynos_drm7580_fbdev.c
@@ -143,12 +143,27 @@
 		return -ENODEV;
 	}
 
-	if (ex->crtc.primary->fb != fb || !ex->crtc.state || !ex->crtc.state->enable) {
+	/*
+	 * int74: after drm_fbdev_cma_init() + restore_mode() the authoritative
+	 * state is the atomic one: crtc->state->active and
+	 * primary->state->fb.  crtc->primary->fb and state->enable are legacy
+	 * fields that the atomic commit path does not maintain, so the old
+	 * predicate failed on a pipe that was demonstrably scanning
+	 * (VIDINTCON0=0x8803, FRAME IRQ firing).
+	 */
+	if (!ex->crtc.state || !ex->crtc.state->active ||
+	    !ex->crtc.enabled ||
+	    !ex->crtc.primary || !ex->crtc.primary->state ||
+	    ex->crtc.primary->state->fb != fb) {
 		dev_err(ex->dev,
-			"CRTC does not scan fb0 out: crtc id=%u state=%p enable=%d primary->fb=%p want=%p\n",
-			ex->crtc.base.id, ex->crtc.state,
-			ex->crtc.state ? ex->crtc.state->enable : -1,
-			ex->crtc.primary->fb, fb);
+			"CRTC does not scan fb0 out: crtc id=%u enabled=%d state=%p active=%d state->crtc=%p primary->state=%p primary->state->fb=%p legacy primary->fb=%p want=%p\n",
+			ex->crtc.base.id, ex->crtc.enabled, ex->crtc.state,
+			ex->crtc.state ? ex->crtc.state->active : -1,
+			ex->crtc.state ? ex->crtc.state->crtc : NULL,
+			ex->crtc.primary ? ex->crtc.primary->state : NULL,
+			ex->crtc.primary && ex->crtc.primary->state ?
+				ex->crtc.primary->state->fb : NULL,
+			ex->crtc.primary ? ex->crtc.primary->fb : NULL, fb);
 		/* int70: name the register state that made the check fail. */
 		decon_kms_log_state(ex->decon, "fbdev scanout failed");
 		return -EIO;
--- a/drivers/gpu/drm/drm_fb_helper.c
+++ b/drivers/gpu/drm/drm_fb_helper.c
@@ -820,8 +820,29 @@
 	}
 
 	for (i = 0; i < fb_helper->crtc_count; i++) {
+		struct drm_crtc *tmp;
+		bool registered = false;
+
 		crtc = fb_helper->crtc_info[i].mode_set.crtc;
 
+		/*
+		 * int74: drm_crtc_index() (called from drm_atomic_get_crtc_state()
+		 * via drm_mode_set_config_internal()) BUGs when the CRTC is no
+		 * longer the registered object (e.g. after a failed first load
+		 * tore the CRTC down while fb0 stayed).  Turn that BUG into a
+		 * clean error instead of a kernel crash.
+		 */
+		list_for_each_entry(tmp, &dev->mode_config.crtc_list, head)
+			if (tmp == crtc) {
+				registered = true;
+				break;
+			}
+		if (!registered) {
+			DRM_ERROR("pan_display: crtc %p is not registered\n", crtc);
+			drm_modeset_unlock_all(dev);
+			return -ENODEV;
+		}
+
 		modeset = &fb_helper->crtc_info[i].mode_set;
 
 		modeset->x = var->xoffset;
