@@ -79,6 +79,7 @@ irqreturn_t decon_int_irq_handler(int irq, void *dev_data)
 	u32 irq_sts_reg;
 	ktime_t timestamp;
 	u32 fifo_level;
+	bool kms_frame = false;
 
 	timestamp = ktime_get();
 
@@ -96,6 +97,7 @@ irqreturn_t decon_int_irq_handler(int irq, void *dev_data)
 			VIDINTCON1_INT_FRAME);
