+/* ---------- KMS EXPORT API, address path (see exynos_decon_kms.h) ------ */
+
+/*
+ * DRM fourcc -> DECON pixel format.  The supported set is exactly what
+ * decon_get_memory_plane_cnt() accepts (decon_core.c:1369); 3.10's fourcc
+ * header has no *M variants for the multi-plane formats, so NV12/NV21 are
+ * the only two-plane formats a DRM client can ask for.
+ */
+enum decon_pixel_format decon_fourcc_to_format(u32 fourcc)
+{
+	switch (fourcc) {
+	case DRM_FORMAT_ARGB8888:
+		return DECON_PIXEL_FORMAT_ARGB_8888;
+	case DRM_FORMAT_ABGR8888:
+		return DECON_PIXEL_FORMAT_ABGR_8888;
+	case DRM_FORMAT_RGBA8888:
+		return DECON_PIXEL_FORMAT_RGBA_8888;
+	case DRM_FORMAT_BGRA8888:
+		return DECON_PIXEL_FORMAT_BGRA_8888;
+	case DRM_FORMAT_XRGB8888:
+		return DECON_PIXEL_FORMAT_XRGB_8888;
+	case DRM_FORMAT_XBGR8888:
+		return DECON_PIXEL_FORMAT_XBGR_8888;
+	case DRM_FORMAT_RGBX8888:
+		return DECON_PIXEL_FORMAT_RGBX_8888;
+	case DRM_FORMAT_BGRX8888:
+		return DECON_PIXEL_FORMAT_BGRX_8888;
+	case DRM_FORMAT_RGBA5551:
+		return DECON_PIXEL_FORMAT_RGBA_5551;
+	case DRM_FORMAT_RGB565:
+		return DECON_PIXEL_FORMAT_RGB_565;
+	case DRM_FORMAT_NV12:
+		return DECON_PIXEL_FORMAT_NV12;
+	case DRM_FORMAT_NV21:
+		return DECON_PIXEL_FORMAT_NV21;
+	default:
+		return DECON_PIXEL_FORMAT_MAX;
+	}
+}
+
+/*
+ * Bits per pixel of a DECON pixel format: the same arithmetic the fb var fill
+ * in decon_set_win_buffer() uses.  RGB formats are the component sum plus
+ * padding; the planar YUV formats are addressed as 12 bpp.
+ */
+static u32 decon_format_bpp(enum decon_pixel_format format)
+{
+	if (format > DECON_PIXEL_FORMAT_RGB_565)
+		return 12;
+
+	return decon_red_length(format) + decon_green_length(format) +
+		decon_blue_length(format) + decon_transp_length(format) +
+		decon_padding(format);
+}
+
+/*
+ * Program one window from DMA addresses the caller already owns.  This is the
+ * exporter-agnostic half of decon_set_win_buffer(): it performs the same
+ * validation and fills the same struct decon_reg_data fields
+ * (decon_core.c:1550-1701), but no fb_info, no ION handle and no dma-buf
+ * ownership is involved, so a dma-buf from any exporter can be scanned out.
+ */
+int decon_export_regs_param_addr(struct decon_device *decon,
+				 struct decon_reg_data *regs,
+				 unsigned int win_idx,
+				 const struct decon_kms_win *win)
+{
+	struct decon_win_config config;
+	enum decon_pixel_format format;
+	u32 bpp, transp_len;
+	int plane_cnt, i;
+
+	if (!decon || !regs || !win || !decon->pdata)
+		return -EINVAL;
+	if (win_idx >= decon->pdata->max_win)
+		return -EINVAL;
+	if (win->state != DECON_KMS_WIN_BUFFER)
+		return -EINVAL;
+
+	format = decon_fourcc_to_format(win->fourcc);
+	if (format >= DECON_PIXEL_FORMAT_MAX) {
+		decon_err("unsupported fourcc 0x%08x on win[%u]\n",
+			  win->fourcc, win_idx);
+		return -EINVAL;
+	}
+
+	if ((int)win->blending >= (int)DECON_BLENDING_MAX) {
+		decon_err("unknown blending %u\n", win->blending);
+		return -EINVAL;
+	}
+
+	if (win_idx == 0 && (int)win->blending != (int)DECON_BLENDING_NONE) {
+		decon_err("blending not allowed on window 0\n");
+		return -EINVAL;
+	}
+
+	if (!win->dst.w || !win->dst.h || win->dst.x < 0 || win->dst.y < 0) {
+		decon_err("win[%u] size is abnormal (w:%u, h:%u, x:%d, y:%d)\n",
+			  win_idx, win->dst.w, win->dst.h,
+			  win->dst.x, win->dst.y);
+		return -EINVAL;
+	}
+
+	plane_cnt = decon_get_memory_plane_cnt(format);
+	if (plane_cnt <= 0 || plane_cnt > MAX_BUF_PLANE_CNT)
+		return -EINVAL;
+
+	bpp = decon_format_bpp(format);
+	transp_len = decon_transp_length(format);
+
+	if (win->dst.w * bpp / 8 < 128) {
+		decon_err("window wide < 128bytes, width = %u, bpp = %u\n",
+			  win->dst.w, bpp);
+		return -EINVAL;
+	}
+
+	if (win->src.f_w < win->dst.w) {
+		decon_err("f_width(%u) < width(%u), bpp = %u\n",
+			  win->src.f_w, win->dst.w, bpp);
+		return -EINVAL;
+	}
+
+	if (format <= DECON_PIXEL_FORMAT_RGB_565 &&
+	    !decon_validate_x_alignment(decon, win->dst.x, win->dst.w, bpp))
+		return -EINVAL;
+
+	memset(&config, 0, sizeof(config));
+	config.state = DECON_WIN_STATE_BUFFER;
+	config.format = format;
+	config.idma_type = win->idma_type;
+	config.blending = win->blending;
+	config.plane_alpha = win->plane_alpha;
+	config.protection = win->protection;
+	config.src.x = win->src.x;
+	config.src.y = win->src.y;
+	config.src.w = win->src.w;
+	config.src.h = win->src.h;
+	config.src.f_w = win->src.f_w;
+	config.src.f_h = win->src.f_h;
+	config.dst.x = win->dst.x;
+	config.dst.y = win->dst.y;
+	config.dst.w = win->dst.w;
+	config.dst.h = win->dst.h;
+	config.dst.f_w = win->dst.f_w;
+	config.dst.f_h = win->dst.f_h;
+	config.block_area.x = win->block_area.x;
+	config.block_area.y = win->block_area.y;
+	config.block_area.w = win->block_area.w;
+	config.block_area.h = win->block_area.h;
+
+	for (i = 0; i < plane_cnt; i++)
+		regs->dma_buf_data[win_idx][i].dma_addr = win->addr[i];
+
+	if (decon_is_plane_offset_calc_required(format))
+		decon_calc_plane_offset(&config,
+					&regs->dma_buf_data[win_idx][0]);
+
+	regs->buf_start[win_idx] = win->addr[0];
+	regs->vidosd_a[win_idx] = vidosd_a(win->dst.x, win->dst.y);
+	regs->vidosd_b[win_idx] = vidosd_b(win->dst.x, win->dst.y,
+					  win->dst.w, win->dst.h);
+	regs->whole_w[win_idx] = win->src.f_w;
+	regs->whole_h[win_idx] = win->src.f_h;
+	regs->offset_x[win_idx] = win->src.x;
+	regs->offset_y[win_idx] = win->src.y;
+	regs->wincon[win_idx] = wincon(bpp, transp_len, format) |
+				decon_rgborder(format);
+	regs->protection[win_idx] = win->protection;
+
+	decon_set_alpha_blending(&config, regs, win_idx, transp_len);
+	/* decon_set_alpha_blending() may rewrite PREMULT to COVERAGE */
+	regs->win_config[win_idx] = config;
+
+	return 0;
+}
+EXPORT_SYMBOL_GPL(decon_export_regs_param_addr);
+
+/*
+ * Translate one frame descriptor set into struct decon_reg_data: window
+ * enable bits, colour/alpha setup, geometry validation and the bandwidth vote.
+ * Buffers must already be in @regs (decon_export_regs_param_addr()); nothing
+ * here owns or resolves a buffer, which is what makes it fb-free.
+ */
+int decon_export_set_win_config(struct decon_device *decon,
+				struct decon_reg_data *regs,
+				const struct decon_win_config *cfg,
+				unsigned int nr_win)
+{
+	struct decon_win_config config;
+	u64 bw = 0;
+	unsigned int i;
+
+	if (!decon || !regs || !decon->pdata || !decon->lcd_info)
+		return -EINVAL;
+	if (!cfg || nr_win > decon->pdata->max_win)
+		return -EINVAL;
+
+	for (i = 0; i < decon->pdata->max_win; i++) {
+		bool enabled = false;
+		u32 color_map = WIN_MAP_MAP | WIN_MAP_MAP_COLOUR(0);
+
+		memset(&config, 0, sizeof(config));
+		if (i < nr_win)
+			config = cfg[i];
+
+		switch (config.state) {
+		case DECON_WIN_STATE_BUFFER:
+			if (does_layer_need_scale(&config)) {
+				decon_err("ERROR: layer(%u) needs scaling(%u,%u) -> (%u,%u)\n",
+					  i, config.src.w, config.dst.w,
+					  config.src.h, config.dst.h);
+				return -EINVAL;
+			}
+			if (decon_get_memory_plane_cnt(config.format) < 0) {
+				decon_err("unsupported format %d on win[%u]\n",
+					  config.format, i);
+				return -EINVAL;
+			}
+			if (!config.dst.w || !config.dst.h ||
+			    config.dst.x < 0 || config.dst.y < 0) {
+				decon_err("win[%u] size is abnormal\n", i);
+				return -EINVAL;
+			}
+			/* registers were filled by regs_param_addr() */
+			enabled = true;
+			color_map = 0;
+			bw += decon_calc_bandwidth(config.dst.w, config.dst.h,
+				DIV_ROUND_UP(decon_format_bpp(config.format), 8),
+				decon->lcd_info->fps);
+			regs->num_of_window++;
+			break;
+		case DECON_WIN_STATE_COLOR:
+			if (does_layer_need_scale(&config))
+				return -EINVAL;
+			enabled = true;
+			color_map |= WIN_MAP_MAP_COLOUR(config.color);
