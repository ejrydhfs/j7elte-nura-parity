diff --git a/device/archived/firmware-samsung-j7elte/APKBUILD b/device/archived/firmware-samsung-j7elte/APKBUILD
new file mode 100644
index 0000000..092bfa0
--- /dev/null
+++ b/device/archived/firmware-samsung-j7elte/APKBUILD
@@ -0,0 +1,43 @@
+# Maintainer: ROM/Nura parity integration (SM-J700M / j7elte)
+# Blobs extracted from the stock Samsung ROM J700MUBU2BRC2 (AP tar).
+# Rebuild firmware.tar.gz with ./extract-firmware.sh <AP-tar.md5>.
+pkgname=firmware-samsung-j7elte
+pkgver=1
+pkgrel=0
+pkgdesc="Proprietary firmware for the Samsung Galaxy J7 (j7elte, Exynos 7580)"
+url="https://opensource.samsung.com"
+arch="aarch64"
+license="proprietary"
+options="!check !archcheck !spdx !strip !tracedeps pmb:cross-native"
+source="firmware.tar.gz"
+builddir="$srcdir"
+
+package() {
+	local _fw="$pkgdir/lib/firmware"
+	local _wifidir="$_fw/postmarketos/samsung-j7elte"
+
+	# Wi-Fi: Broadcom bcmdhd opens these by absolute path
+	# (CONFIG_BCMDHD_FW_PATH / CONFIG_BCMDHD_NVRAM_PATH in linux-samsung-j7elte).
+	install -Dm644 "$srcdir"/bcmdhd_sta.bin   "$_wifidir/bcmdhd_sta.bin"
+	install -Dm644 "$srcdir"/bcmdhd_apsta.bin "$_wifidir/bcmdhd_apsta.bin"
+	install -Dm644 "$srcdir"/bcmdhd_mfg.bin   "$_wifidir/bcmdhd_mfg.bin"
+	install -Dm644 "$srcdir"/nvram_net.txt    "$_wifidir/nvram_net.txt"
+	install -Dm644 "$srcdir"/nvram_mfg.txt    "$_wifidir/nvram_mfg.txt"
+
+	# Bluetooth: BCM43438 patch RAM, consumed by BlueZ hciattach bcm43xx
+	# (scans /lib/firmware for <ReadLocalName>*.hcd). Both the ROM filename and
+	# the bare "BCM43438A1.hcd" name are installed.
+	install -Dm644 "$srcdir"/bcm43438A1_V0051.0230.hcd "$_wifidir/BCM43438A1.hcd"
+	install -Dm644 "$srcdir"/bcm43438A1_V0051.0230.hcd "$_wifidir/bcm43438A1_V0051.0230.hcd"
+
+	# Camera (FIMC-IS) and video codec (MFC): request_firmware() names resolve
+	# to /lib/firmware/<name>.
+	local f
+	for f in fimc_is_fw2_3l2.bin setfile_3l2.bin setfile_5e3.bin fimc_is_fd.bin mfc_fw.bin; do
+		install -Dm644 "$srcdir/$f" "$_fw/$f"
+	done
+}
+
+sha512sums="
+369340c6bcf8171adb559adc3b61d8605bbd0bce5010d9aae56a0ea49415b880ba63643d52c198f6a857617e67aaea41efe0858ed184b026c6313fa67da09b1b  firmware.tar.gz
+"
diff --git a/device/archived/firmware-samsung-j7elte/extract-firmware.sh b/device/archived/firmware-samsung-j7elte/extract-firmware.sh
new file mode 100755
index 0000000..43b6fd9
--- /dev/null
+++ b/device/archived/firmware-samsung-j7elte/extract-firmware.sh
@@ -0,0 +1,54 @@
+#!/bin/sh
+# Rebuild firmware.tar.gz for firmware-samsung-j7elte from the stock SM-J700M ROM.
+#
+# Usage: ./extract-firmware.sh <AP_J700MUBU2BRC2_*.tar.md5>
+#
+# Requires: tar, simg2img, debugfs, gzip, sha512sum.
+# The tarball is deterministic (sorted, epoch mtimes), so the sha512 in the
+# APKBUILD is reproducible.
+set -eu
+
+AP=${1:?usage: $0 <AP_J700MUBU2BRC2_*.tar.md5>}
+here=$(cd "$(dirname "$0")" && pwd)
+cd "$here"
+
+work=$(mktemp -d)
+trap 'rm -rf "$work"' EXIT
+
+echo "extracting system.img from $AP ..."
+tar -xf "$AP" -C "$work" system.img
+simg2img "$work/system.img" "$work/system.raw"
+
+# ROM path (inside system.img) -> local name
+EXTRACT="
+/etc/wifi/bcmdhd_sta.bin
+/etc/wifi/bcmdhd_apsta.bin
+/etc/wifi/bcmdhd_mfg.bin
+/etc/wifi/nvram_net.txt
+/etc/wifi/nvram_mfg.txt
+/vendor/firmware/bcm43438A1_V0051.0230.hcd
+/vendor/firmware/fimc_is_fd.bin
+/vendor/firmware/fimc_is_fw2_3l2.bin
+/vendor/firmware/mfc_fw.bin
+/vendor/firmware/setfile_3l2.bin
+/vendor/firmware/setfile_5e3.bin
+"
+
+rm -rf files
+mkdir files
+for src in $EXTRACT; do
+	base=$(basename "$src")
+	debugfs -R "dump $src files/$base" "$work/system.raw" >/dev/null 2>&1
+	if [ ! -s "files/$base" ]; then
+		echo "ERROR: $src not found in system.img" >&2
+		exit 1
+	fi
+done
+
+echo "verifying checksums ..."
+(cd files && sha512sum -c ../files.sha512)
+
+echo "building deterministic firmware.tar.gz ..."
+(cd files && tar --sort=name --mtime=@0 --owner=0 --group=0 --numeric-owner -cf - *) |
+	gzip -n > firmware.tar.gz
+sha512sum firmware.tar.gz
