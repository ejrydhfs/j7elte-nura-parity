+
+static inline u32 dsim_read(struct exynos7580_drm *drv, u32 reg)
+{
+	return readl(drv->dsim_base + reg);
+}
+
+static inline void dsim_write(struct exynos7580_drm *drv, u32 reg, u32 val)
+{
+	writel(val, drv->dsim_base + reg);
+}
+
+static inline void dsim_write_mask(struct exynos7580_drm *drv, u32 reg,
+				   u32 val, u32 mask)
+{
+	u32 old = dsim_read(drv, reg);
+
+	writel((val & mask) | (old & ~mask), drv->dsim_base + reg);
+}
