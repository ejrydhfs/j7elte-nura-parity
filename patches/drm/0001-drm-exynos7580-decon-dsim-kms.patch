+};
+
+/* b_dphyctl for escape clocks 7..20 MHz (dsim_reg_7580.c:b_dphyctl[]) */
+static const u32 b_dphyctl[14] = {
+	0x0af, 0x0c8, 0x0e1, 0x0fa,
+	0x113, 0x12c, 0x145, 0x15e, 0x177,
+	0x190, 0x1a9, 0x1c2, 0x1db, 0x1f4
+};
+
+static void dsim_function_reset(struct exynos7580_drm *drv)
+{
+	dsim_write_mask(drv, DSIM_SWRST, ~0, DSIM_SWRST_FUNCRST);
+}
+
+static void dsim_sw_reset(struct exynos7580_drm *drv)
+{
+	dsim_write_mask(drv, DSIM_SWRST, ~0, DSIM_SWRST_RESET);
+}
+
+static void dsim_clear_int(struct exynos7580_drm *drv, u32 bits)
+{
+	dsim_write(drv, DSIM_INTSRC, bits);
+}
+
+/* dsim_reg_set_int(id, 0): mask every interrupt source we care about. */
+static void dsim_irq_mask(struct exynos7580_drm *drv)
+{
+	u32 mask = DSIM_INTMSK_SFR_PL_FIFO_EMPTY |
+		   DSIM_INTMSK_SFR_PH_FIFO_EMPTY |
+		   DSIM_INTMSK_FRAME_DONE |
+		   DSIM_INTMSK_RX_DATA_DONE |
+		   DSIM_INTMSK_RX_ECC;
+
+	dsim_write_mask(drv, DSIM_INTMSK, ~0, mask);
+}
+
+/* dsim_reg_calculate_pms() */
+static int dsim_calculate_pms(struct dsim_pll_param *pll)
+{
+	u32 p_div, m_div, s_div;
+	u32 target_freq, fin_pll, voc_out, fout_cal;
+	u32 fin = 26;
+	u32 fout_max = 2500;
+
+	target_freq = pll->pll_freq;
+	pll->pll_freq = 0;
+
+	for (p_div = 1; p_div <= 63; p_div++) {
+		for (m_div = 64; m_div <= 1023; m_div++) {
+			for (s_div = 0; s_div <= 5; s_div++) {
+				fin_pll = fin / p_div;
+				voc_out = (m_div * fin) / p_div;
+				fout_cal = (m_div * fin) /
+					(p_div * (1 << s_div));
+
+				if (fin_pll < 4 || fin_pll > 12)
+					continue;
+				if (voc_out < 1250 || voc_out > 2500)
+					continue;
+				if (fout_cal < 40 || fout_cal > 2500)
+					continue;
+				if (fout_cal < target_freq)
+					continue;
+				if (fout_cal <= fout_max) {
+					fout_max = fout_cal;
+					pll->p = p_div;
+					pll->m = m_div;
+					pll->s = s_div;
+					pll->pll_freq = fout_cal;
+				}
+			}
+		}
+	}
+
+	if (!pll->pll_freq) {
+		pr_err("exynos7580-dsim: cannot compute PLL PMS for %u MHz\n",
+		       target_freq);
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
+/* dsim_reg_get_dphy_timing() */
+static int dsim_get_dphy_timing(u32 hs_clk, u32 esc_clk,
+				struct dphy_timing_value *t)
+{
+	int i;
+
+	for (i = ARRAY_SIZE(dphy_timing) - 1; i >= 0; i--) {
+		if (dphy_timing[i][0] < hs_clk)
+			continue;
+
+		t->bps = dphy_timing[i][0];
+		t->clk_prepare = dphy_timing[i][1];
+		t->clk_zero = dphy_timing[i][2];
+		t->clk_post = dphy_timing[i][3];
+		t->clk_trail = dphy_timing[i][4];
+		t->hs_prepare = dphy_timing[i][5];
+		t->hs_zero = dphy_timing[i][6];
+		t->hs_trail = dphy_timing[i][7];
+		t->lpx = dphy_timing[i][8];
+		t->hs_exit = dphy_timing[i][9];
+		break;
+	}
+
+	if (i < 0) {
+		pr_err("exynos7580-dsim: no D-PHY timing for %u Mbps\n", hs_clk);
+		return -EINVAL;
+	}
+
+	if (esc_clk < 7 || esc_clk > 20) {
+		pr_err("exynos7580-dsim: invalid escape clock %u MHz\n", esc_clk);
+		return -EINVAL;
+	}
+
+	t->b_dphyctl = b_dphyctl[esc_clk - 7];
+
+	return 0;
+}
+
+/* dsim_reg_set_dphy_timing_values() */
+static void dsim_set_dphy_timing(struct exynos7580_drm *drv,
+				 struct dphy_timing_value *t)
+{
+	dsim_write(drv, DSIM_PHYTIMING,
+		   DSIM_PHYTIMING_M_TLPXCTL(t->lpx) |
+		   DSIM_PHYTIMING_M_THSEXITCTL(t->hs_exit));
+
+	dsim_write(drv, DSIM_PHYTIMING1,
+		   DSIM_PHYTIMING1_M_TCLKPRPRCTL(t->clk_prepare) |
+		   DSIM_PHYTIMING1_M_TCLKZEROCTL(t->clk_zero) |
+		   DSIM_PHYTIMING1_M_TCLKPOSTCTL(t->clk_post) |
+		   DSIM_PHYTIMING1_M_TCLKTRAILCTL(t->clk_trail));
+
+	dsim_write(drv, DSIM_PHYTIMING2,
+		   DSIM_PHYTIMING2_M_THSPRPRCTL(t->hs_prepare) |
+		   DSIM_PHYTIMING2_M_THSZEROCTL(t->hs_zero) |
+		   DSIM_PHYTIMING2_M_THSTRAILCTL(t->hs_trail));
+
+	dsim_write_mask(drv, DSIM_PHYCTRL,
+			DSIM_PHYCTRL_B_DPHYCTL0(t->b_dphyctl),
+			DSIM_PHYCTRL_B_DPHYCTL0_MASK);
+}
+
+/* dsim_reg_set_porch() */
+static void dsim_set_porch(struct exynos7580_drm *drv)
+{
+	struct decon_lcd *lcd = &drv->lcd;
+	u32 val, mask;
+
+	if (lcd->mode == DECON_VIDEO_MODE) {
+		val = DSIM_MVPORCH_CMD_ALLOW(EXYNOS7580_DSIM_CMD_ALLOW_VALUE) |
+		      DSIM_MVPORCH_STABLE_VFP(EXYNOS7580_DSIM_STABLE_VFP_VALUE) |
+		      DSIM_MVPORCH_VBP(lcd->vbp);
+		mask = DSIM_MVPORCH_CMD_ALLOW_MASK | DSIM_MVPORCH_VBP_MASK |
+		       DSIM_MVPORCH_STABLE_VFP_MASK;
+		dsim_write_mask(drv, DSIM_MVPORCH, val, mask);
+
+		dsim_write(drv, DSIM_MHPORCH,
+			   DSIM_MHPORCH_HFP(lcd->hfp) |
+			   DSIM_MHPORCH_HBP(lcd->hbp));
+
+		dsim_write_mask(drv, DSIM_MSYNC,
+				DSIM_MSYNC_VSA(lcd->vsa) |
+				DSIM_MSYNC_HSA(lcd->hsa),
+				DSIM_MSYNC_VSA_MASK | DSIM_MSYNC_HSA_MASK);
+	}
+
+	val = DSIM_MDRESOL_VRESOL(lcd->yres) |
+	      DSIM_MDRESOL_HRESOL(lcd->xres) | DSIM_MDRESOL_SHADOW_EN;
+	mask = DSIM_MDRESOL_VRESOL_MASK | DSIM_MDRESOL_HRESOL_MASK |
+	       DSIM_MDRESOL_SHADOW_EN;
+	dsim_write_mask(drv, DSIM_MDRESOL, val, mask);
+}
+
+/* dsim_reg_set_config() */
+static void dsim_set_config(struct exynos7580_drm *drv, int lanes)
+{
+	u32 val, mask;
+
+	if (drv->lcd.mode == DECON_VIDEO_MODE) {
+		val = DSIM_CONFIG_VIDEO_MODE;
+	} else {
+		val = 0;
+		val &= ~DSIM_CONFIG_CLKLANE_STOP_START;
+	}
+
+	val |= DSIM_CONFIG_BURST_MODE | DSIM_CONFIG_EOT_R03_DISABLE |
+	       DSIM_CONFIG_HFP_DISABLE |
+	       DSIM_CONFIG_NUM_OF_DATA_LANE(lanes - 1) |
+	       DSIM_CONFIG_PIXEL_FORMAT(DSIM_PIXEL_FORMAT_RGB24);
+
+	mask = DSIM_CONFIG_NONCONTINUOUS_CLOCK_LANE |
+	       DSIM_CONFIG_CLKLANE_STOP_START |
+	       DSIM_CONFIG_EOT_R03_DISABLE |
+	       DSIM_CONFIG_BURST_MODE | DSIM_CONFIG_VIDEO_MODE |
+	       DSIM_CONFIG_HFP_DISABLE | DSIM_CONFIG_PIXEL_FORMAT_MASK |
+	       DSIM_CONFIG_NUM_OF_DATA_LANE_MASK;
+
+	dsim_write_mask(drv, DSIM_CONFIG, val, mask);
+
+	/* video mode uses a continuous clock lane */
+	dsim_write_mask(drv, DSIM_CONFIG,
+			drv->lcd.mode == DECON_VIDEO_MODE ? 0 : ~0,
+			DSIM_CONFIG_NONCONTINUOUS_CLOCK_LANE);
+}
+
+/* dsim_reg_init() */
+static void dsim_hw_init(struct exynos7580_drm *drv)
+{
+	dsim_function_reset(drv);
+
+	dsim_write_mask(drv, DSIM_ESCMODE,
+			DSIM_ESCMODE_STOP_STATE_CNT(EXYNOS7580_DSIM_STOP_STATE_CNT),
+			DSIM_ESCMODE_STOP_STATE_CNT_MASK);
+	dsim_write_mask(drv, DSIM_TIMEOUT,
+			DSIM_TIMEOUT_BTA_TOUT(EXYNOS7580_DSIM_BTA_TIMEOUT),
+			DSIM_TIMEOUT_BTA_TOUT_MASK);
+	dsim_write_mask(drv, DSIM_TIMEOUT,
+			DSIM_TIMEOUT_LPDR_TOUT(EXYNOS7580_DSIM_LP_RX_TIMEOUT),
+			DSIM_TIMEOUT_LPDR_TOUT_MASK);
+	dsim_write_mask(drv, DSIM_MULTI_PKT,
+			DSIM_MULTI_PKT_CNT(EXYNOS7580_DSIM_MULTI_PACKET_CNT),
+			DSIM_MULTI_PKT_CNT_MASK);
+
+	dsim_write_mask(drv, DSIM_MDRESOL, ~0, DSIM_MDRESOL_SHADOW_EN);
+	dsim_set_porch(drv);
+	dsim_set_config(drv, drv->data_lanes);
+}
+
+static int dsim_wait_pll_stable(struct exynos7580_drm *drv)
+{
+	int cnt = 1000;
+
+	dsim_clear_int(drv, DSIM_INTSRC_PLL_STABLE);
+	dsim_write_mask(drv, DSIM_PLLCTRL, ~0, DSIM_PLLCTRL_PLL_EN);
+
+	while (--cnt) {
+		if (dsim_read(drv, DSIM_STATUS) & DSIM_STATUS_PLL_STABLE)
+			return 0;
+		udelay(10);
+	}
+
+	dev_err(drv->dev, "DSIM PLL did not lock\n");
+	return -EBUSY;
+}
+
+static bool dsim_lane_stop_state(struct exynos7580_drm *drv)
+{
+	u32 val = dsim_read(drv, DSIM_STATUS);
+
+	return (val & DSIM_STATUS_STOP_STATE_DAT(0xf)) &&
+	       ((val & DSIM_STATUS_STOP_STATE_CLK) ||
+		(val & DSIM_STATUS_TX_READY_HS_CLK));
+}
+
+static int dsim_wait_lane_stop_state(struct exynos7580_drm *drv)
+{
+	int cnt = 100;
+
+	do {
+		if (dsim_lane_stop_state(drv))
+			return 0;
+		udelay(10);
+	} while (--cnt);
+
+	dev_err(drv->dev, "DSIM lanes did not reach stop state\n");
+	return -EBUSY;
+}
+
+static int dsim_wait_hs_clk_ready(struct exynos7580_drm *drv)
+{
+	int cnt = 1000;
+	u32 val = dsim_read(drv, DSIM_CONFIG);
+
+	if (val & DSIM_CONFIG_NONCONTINUOUS_CLOCK_LANE)
+		return 0;
+
+	do {
+		if (dsim_read(drv, DSIM_STATUS) & DSIM_STATUS_TX_READY_HS_CLK)
+			return 0;
+		udelay(10);
+	} while (--cnt);
+
+	dev_err(drv->dev, "DSIM HS clock did not become ready\n");
+	return -EBUSY;
+}
+
+/*
+ * Configure D-PHY PLL, byte clock, escape clock and lane escape clocks
+ * (dsim_reg_set_clocks()/dsim_reg_enable_clocks()).
+ */
+static int dsim_clocks(struct exynos7580_drm *drv, bool enable)
+{
+	struct dsim_pll_param pll = { .pll_freq = drv->lcd.hs_clk };
+	struct dphy_timing_value t;
+	u32 lanes = DSIM_LANE_CLOCK | ((1 << drv->data_lanes) - 1) << 1;
+	u32 byte_clk, esc_div;
+	int ret;
+
+	if (!enable) {
+		dsim_write_mask(drv, DSIM_CLKCTRL, 0,
+				DSIM_CLKCTRL_LANE_ESCCLK_EN_MASK);
+		dsim_write_mask(drv, DSIM_CLKCTRL, 0,
+				DSIM_CLKCTRL_ESCCLK_EN |
+				DSIM_CLKCTRL_ESC_PRESCALER_MASK);
+		dsim_write_mask(drv, DSIM_CLKCTRL, 0,
+				DSIM_CLKCTRL_BYTECLK_EN);
+		dsim_write_mask(drv, DSIM_PLLCTRL, 0, DSIM_PLLCTRL_PLL_EN);
+		return 0;
+	}
+
+	/* byte clock source is the D-PHY PLL */
+	dsim_write_mask(drv, DSIM_CLKCTRL, 0, DSIM_CLKCTRL_BYTE_CLK_SRC_MASK);
+
+	ret = dsim_calculate_pms(&pll);
+	if (ret)
+		return ret;
+
+	dsim_write_mask(drv, DSIM_PLLCTRL,
+			((pll.p & 0x3f) << 14) | ((pll.m & 0x1ff) << 4) |
+			((pll.s & 0x7) << 1), DSIM_PLLCTRL_PMS_MASK);
+	dsim_write(drv, DSIM_PLLTMR, EXYNOS7580_DSIM_PLL_STABLE_TIME);
+
+	byte_clk = pll.pll_freq / 8;
+
+	esc_div = byte_clk / drv->lcd.esc_clk;
+	if ((byte_clk / esc_div) > drv->lcd.esc_clk)
+		esc_div++;
+
+	ret = dsim_get_dphy_timing(pll.pll_freq,
+				   byte_clk / esc_div, &t);
+	if (ret)
+		return ret;
+	dsim_set_dphy_timing(drv, &t);
+
+	/* vendor PLL/mPHY magic values, dsim_reg_7580.c */
+	dsim_write_mask(drv, DSIM_PLLCTRL1, DSIM_PLLCTRL1_M_PLL0_DEFAULT,
+			DSIM_PLLCTRL1_M_PLL0_DEFAULT_MASK);
+	dsim_write(drv, DSIM_PHYCTRL_M1, DSIM_PHYCTRL_M1_PLL_LOCK);
+
+	ret = dsim_wait_pll_stable(drv);
+	if (ret)
+		return ret;
+
+	dsim_write_mask(drv, DSIM_CLKCTRL, ~0, DSIM_CLKCTRL_BYTECLK_EN);
+	dsim_write_mask(drv, DSIM_CLKCTRL,
+			DSIM_CLKCTRL_ESCCLK_EN |
+			DSIM_CLKCTRL_ESC_PRESCALER(esc_div),
+			DSIM_CLKCTRL_ESCCLK_EN |
+			DSIM_CLKCTRL_ESC_PRESCALER_MASK);
+	dsim_write_mask(drv, DSIM_CLKCTRL,
+			DSIM_CLKCTRL_LANE_ESCCLK_EN(lanes),
+			DSIM_CLKCTRL_LANE_ESCCLK_EN_MASK);
+
+	dev_dbg(drv->dev, "DSIM PLL %u MHz (p %u m %u s %u), byte %u MHz, esc div %u\n",
+		pll.pll_freq, pll.p, pll.m, pll.s, byte_clk, esc_div);
+
+	return 0;
+}
+
+/* dsim_reg_set_lanes() */
+static int dsim_set_lanes(struct exynos7580_drm *drv, bool enable)
+{
+	u32 lanes = DSIM_LANE_CLOCK | ((1 << drv->data_lanes) - 1) << 1;
+
+	dsim_write_mask(drv, DSIM_CONFIG, enable ? ~0 : 0,
+			DSIM_CONFIG_LANE_ENx(lanes));
+	udelay(300);
+
+	if (enable)
+		return dsim_wait_lane_stop_state(drv);
+
+	return 0;
+}
+
+/* dsim_reg_set_standby() */
+static void dsim_set_standby(struct exynos7580_drm *drv, bool enable)
+{
+	u32 val = DSIM_MDRESOL_VRESOL(drv->lcd.yres) |
+		  DSIM_MDRESOL_HRESOL(drv->lcd.xres);
+	u32 mask = DSIM_MDRESOL_VRESOL_MASK | DSIM_MDRESOL_HRESOL_MASK;
+
+	if (enable)
+		val |= DSIM_MDRESOL_STAND_BY;
+	mask |= DSIM_MDRESOL_STAND_BY;
+
+	dsim_write_mask(drv, DSIM_MDRESOL, val, mask);
+}
+
+/* dsim_reg_set_hs_clock() */
+static int dsim_set_hs_clock(struct exynos7580_drm *drv, bool enable)
+{
+	if (enable) {
+		/* HS transfer mode for both command and pixel data */
+		dsim_write_mask(drv, DSIM_ESCMODE, 0, DSIM_ESCMODE_CMD_LPDT);
+		dsim_write_mask(drv, DSIM_ESCMODE, 0, DSIM_ESCMODE_TX_LPDT);
+
+		dsim_set_standby(drv, true);
+
+		/* vendor workaround for a 2-cycle miss issue */
+		dsim_function_reset(drv);
+
+		dsim_write_mask(drv, DSIM_CLKCTRL, ~0,
+				DSIM_CLKCTRL_TX_REQUEST_HSCLK);
+
+		return dsim_wait_hs_clk_ready(drv);
+	}
+
+	dsim_set_standby(drv, false);
+	dsim_write_mask(drv, DSIM_CLKCTRL, 0, DSIM_CLKCTRL_TX_REQUEST_HSCLK);
+
+	return 0;
+}
+
+/*
+ * Wait until the given FIFO reports empty through the raw status register.
+ * Same bits the vendor waits on through its interrupt completions.
+ */
+static int dsim_wait_fifo(struct exynos7580_drm *drv, bool payload)
+{
+	u32 bit = payload ? DSIM_INTSRC_SFR_PL_FIFO_EMPTY :
+			    DSIM_INTSRC_SFR_PH_FIFO_EMPTY;
+	int cnt = 10000;	/* 100 ms */
+
+	do {
+		if (dsim_read(drv, DSIM_INTSRC) & bit) {
+			dsim_clear_int(drv, bit);
+			return 0;
+		}
+		udelay(10);
+	} while (--cnt);
+
+	dev_err(drv->dev, "DSIM %s FIFO empty timeout (INTSRC %08x)\n",
+		payload ? "payload" : "packet header",
+		dsim_read(drv, DSIM_INTSRC));
+	return -ETIMEDOUT;
+}
+
+static void dsim_write_payload(struct exynos7580_drm *drv, const u8 *data,
+			       int len)
+{
+	int i;
+
+	for (i = 0; i < len; i += 4) {
+		u32 payload = data[i];
+
+		if (i + 1 < len)
+			payload |= data[i + 1] << 8;
+		if (i + 2 < len)
+			payload |= data[i + 2] << 16;
+		if (i + 3 < len)
+			payload |= data[i + 3] << 24;
+
+		dsim_write(drv, DSIM_PAYLOAD, payload);
+	}
+}
+
+/*
+ * MIPI DCS write, equivalent to ea8061_lcd_ctrl.c:dsim_write_hl_data() ->
+ * dsim_drv.c:dsim_write_data().
+ */
+static int dsim_dcs_write(struct exynos7580_drm *drv, const u8 *cmd, u32 len)
+{
+	int ret;
+
+	if (!drv->dsim_on) {
+		dev_err(drv->dev, "DSIM is not running, cannot send DCS %02x\n",
+			cmd[0]);
+		return -EINVAL;
+	}
+
+	if (len == 1 || len == 2) {
+		u32 data_id = (len == 1) ? MIPI_DSI_DCS_SHORT_WRITE :
+					   MIPI_DSI_DCS_SHORT_WRITE_PARAM;
+
+		dsim_clear_int(drv, DSIM_INTSRC_SFR_PH_FIFO_EMPTY);
+		dsim_write(drv, DSIM_PKTHDR,
+			   DSIM_PKTHDR_ID(data_id) | DSIM_PKTHDR_DATA0(cmd[0]) |
+			   (len == 2 ? DSIM_PKTHDR_DATA1(cmd[1]) : 0));
+
+		return dsim_wait_fifo(drv, false);
+	}
+
+	dsim_clear_int(drv, DSIM_INTSRC_SFR_PL_FIFO_EMPTY |
+		       DSIM_INTSRC_SFR_PH_FIFO_EMPTY);
+
+	dsim_write_payload(drv, cmd, len);
+
+	dsim_write(drv, DSIM_PKTHDR,
+		   DSIM_PKTHDR_ID(MIPI_DSI_DCS_LONG_WRITE) |
+		   DSIM_PKTHDR_DATA0(len & 0xff) |
+		   DSIM_PKTHDR_DATA1((len >> 8) & 0xff));
+
+	ret = dsim_wait_fifo(drv, true);
+	if (ret)
+		return ret;
+
+	return dsim_wait_fifo(drv, false);
+}
+
+/* ---------------------------------------------------------------------- */
+/* Panel board control (decon_board.c equivalent)			  */
+/* ---------------------------------------------------------------------- */
+
+static void exynos7580_board_run(struct exynos7580_drm *drv,
+				 struct exynos7580_board_action *acts, int num)
+{
+	int i;
+
+	for (i = 0; i < num; i++) {
+		struct exynos7580_board_action *a = &acts[i];
+		int ret;
+
+		switch (a->type) {
+		case EXYNOS7580_BOARD_REGULATOR_ENABLE:
+			if (a->regulator) {
+				ret = regulator_enable(a->regulator);
+				if (ret)
+					dev_err(drv->dev, "cannot enable regulator: %d\n",
+						ret);
+			}
+			break;
+		case EXYNOS7580_BOARD_REGULATOR_DISABLE:
+			if (a->regulator)
+				regulator_disable(a->regulator);
+			break;
+		case EXYNOS7580_BOARD_GPIO_HIGH:
+		case EXYNOS7580_BOARD_GPIO_LOW:
+			if (drv->reset_gpio_valid)
+				gpio_set_value_cansleep(drv->reset_gpio,
+					a->type == EXYNOS7580_BOARD_GPIO_HIGH);
+			break;
+		case EXYNOS7580_BOARD_DELAY_USLEEP:
+			usleep_range(a->delay[0], a->delay[1]);
+			break;
+		case EXYNOS7580_BOARD_DELAY_MSLEEP:
+			msleep(a->delay[0]);
+			break;
+		case EXYNOS7580_BOARD_DELAY_MDELAY:
+			mdelay(a->delay[0]);
+			break;
+		}
+	}
+}
+
+int exynos7580_panel_power(struct exynos7580_drm *drv, bool on)
+{
+	if (drv->panel_powered == on)
+		return 0;
+
+	drv->panel_powered = on;
+
+	if (on)
+		exynos7580_board_run(drv, drv->power_on, drv->num_power_on);
+	else
+		exynos7580_board_run(drv, drv->power_off, drv->num_power_off);
+
+	return 0;
+}
+
+void exynos7580_panel_reset(struct exynos7580_drm *drv)
+{
+	if (!drv->reset_gpio_valid) {
+		dev_warn(drv->dev, "no panel reset GPIO described\n");
+		return;
+	}
+
+	exynos7580_board_run(drv, drv->reset, drv->num_reset);
+}
+
+/* ---------------------------------------------------------------------- */
+/* ea8061 panel							  */
+/* ---------------------------------------------------------------------- */
+
+static int panel_write(struct exynos7580_drm *drv, const unsigned char *seq,
+		       u32 len)
+{
+	int ret = dsim_dcs_write(drv, seq, len);
+	int retry = 5;
+
+	while (ret && --retry) {
+		dev_dbg(drv->dev, "retrying DCS %02x\n", seq[0]);
+		ret = dsim_dcs_write(drv, seq, len);
+	}
+
+	if (ret)
+		dev_err(drv->dev, "DCS write %02x failed: %d\n", seq[0], ret);
+
+	return ret;
+}
+
+#define PANEL_SEQ(drv, seq) panel_write(drv, seq, ARRAY_SIZE(seq))
+
+/*
+ * ea8061_lcd_ctrl.c:ea8061_init().  The vendor applies a runtime-computed
+ * gamma/AID/ELVSS table read from the panel MTP; that path is not implemented
+ * here (see parity/reports/drm-driver.md) so the panel keeps its OTP default
+ * gamma and brightness.
+ */
+int exynos7580_panel_init(struct exynos7580_drm *drv)
+{
+	int ret;
+
+	usleep_range(5000, 6000);
+
+	ret = PANEL_SEQ(drv, SEQ_TEST_KEY_ON_F0);
+	if (ret)
+		return ret;
+
+	ret = PANEL_SEQ(drv, SEQ_TEST_KEY_ON_FC);
+	if (ret)
+		return ret;
+
+	ret = PANEL_SEQ(drv, SEQ_EA8061_LTPS_STOP);
+	if (ret)
+		return ret;
+
+	if (drv->panel_rev >= EXYNOS7580_PANEL_REV_D)
+		ret = PANEL_SEQ(drv, SEQ_EA8061_LTPS_TIMING_REV_D);
+	else
+		ret = PANEL_SEQ(drv, SEQ_EA8061_LTPS_TIMING);
+	if (ret)
+		return ret;
+
+	ret = PANEL_SEQ(drv, SEQ_EA8061_LTPS_UPDATE);
+	if (ret)
+		return ret;
+
+	ret = PANEL_SEQ(drv, SEQ_EA8061_SCAN_DIRECTION);
+	if (ret)
+		return ret;
+
+	ret = PANEL_SEQ(drv, SEQ_EA8061_AID_SET_DEFAULT);
+	if (ret)
+		return ret;
+
+	ret = PANEL_SEQ(drv, SEQ_EA8061_SLEW_CONTROL);
+	if (ret)
+		return ret;
+
+	/* EL_ON toggling with the manual gate, ea8061_init() */
+	ret = PANEL_SEQ(drv, SEQ_GP_01);
+	if (ret)
+		return ret;
+
+	ret = PANEL_SEQ(drv, SEQ_F3_ON);
+	if (ret)
+		return ret;
+
+	ret = PANEL_SEQ(drv, SEQ_SLEEP_OUT);
+	if (ret)
+		return ret;
+
+	msleep(20);
+
+	ret = PANEL_SEQ(drv, SEQ_GP_02);
+	if (ret || PANEL_SEQ(drv, SEQ_F3_08))
+		return -EIO;
+	usleep_range(150, 160);
+
+	ret = PANEL_SEQ(drv, SEQ_GP_02);
+	if (ret || PANEL_SEQ(drv, SEQ_F3_OFF))
+		return -EIO;
+	usleep_range(100, 110);
+
+	ret = PANEL_SEQ(drv, SEQ_GP_02);
+	if (ret || PANEL_SEQ(drv, SEQ_F3_08))
+		return -EIO;
+	usleep_range(150, 160);
+
+	ret = PANEL_SEQ(drv, SEQ_GP_02);
+	if (ret || PANEL_SEQ(drv, SEQ_F3_OFF))
+		return -EIO;
+	usleep_range(100, 110);
+
+	ret = PANEL_SEQ(drv, SEQ_SLEEP_IN);
+	if (ret)
+		return ret;
+
+	ret = PANEL_SEQ(drv, SEQ_GP_01);
+	if (ret || PANEL_SEQ(drv, SEQ_F3_OFF))
+		return -EIO;
+
+	ret = PANEL_SEQ(drv, SEQ_SLEEP_OUT);
+	if (ret)
+		return ret;
+
+	msleep(120);
+
+	/* Vendor applies brightness/gamma here; OTP defaults are kept. */
+
+	ret = PANEL_SEQ(drv, SEQ_DISPLAY_ON);
+	if (ret)
+		return ret;
+
+	ret = PANEL_SEQ(drv, SEQ_TEST_KEY_OFF_FC);
+	if (ret)
+		return ret;
+
+	return PANEL_SEQ(drv, SEQ_TEST_KEY_OFF_F0);
+}
+
+/* ea8061_lcd_ctrl.c:ea8061_exit() */
+void exynos7580_panel_suspend(struct exynos7580_drm *drv)
+{
+	PANEL_SEQ(drv, SEQ_DISPLAY_OFF);
+	msleep(35);
+	PANEL_SEQ(drv, SEQ_SLEEP_IN);
+	msleep(150);
+}
+
+/* ---------------------------------------------------------------------- */
+/* DSIM enable/disable						  */
+/* ---------------------------------------------------------------------- */
+
+/*
+ * dsim_drv.c:dsim_enable(), minus the vendor DPHY power hook (empty there) and
+ * with polling command transfers.
+ */
+int exynos7580_dsim_enable(struct exynos7580_drm *drv)
+{
+	int ret;
+
+	mutex_lock(&drv->lock);
+
+	if (drv->dsim_on) {
+		mutex_unlock(&drv->lock);
+		return 0;
+	}
+
+	exynos7580_panel_power(drv, true);
+
+	dsim_hw_init(drv);
+
+	ret = dsim_clocks(drv, true);
+	if (ret)
+		goto err_clocks;
+
+	clk_prepare_enable(drv->dsim_esc_clk);
+	clk_prepare_enable(drv->dsim_byte_clk);
+
+	ret = dsim_set_lanes(drv, true);
+	if (ret)
+		goto err_lanes;
+
+	exynos7580_panel_reset(drv);
+
+	ret = dsim_set_hs_clock(drv, true);
+	if (ret)
+		goto err_hs;
+
+	/* DSIM interrupts stay masked: command transfers poll INTSRC. */
+	dsim_irq_mask(drv);
+
+	drv->dsim_on = true;
+
+	/* Must happen with the HS link already up, as in the vendor driver. */
+	ret = exynos7580_panel_init(drv);
+	if (ret) {
+		drv->dsim_on = false;
+		goto err_hs;
+	}
+
+	mutex_unlock(&drv->lock);
+
+	dev_info(drv->dev, "MIPI DSIM up: %d lanes, hs %u MHz, esc %u MHz\n",
+		 drv->data_lanes, drv->lcd.hs_clk, drv->lcd.esc_clk);
+
+	return 0;
+
+err_hs:
+	dsim_set_lanes(drv, false);
+err_lanes:
+	clk_disable_unprepare(drv->dsim_byte_clk);
+	clk_disable_unprepare(drv->dsim_esc_clk);
+err_clocks:
+	dsim_clocks(drv, false);
+	dsim_sw_reset(drv);
+	exynos7580_panel_power(drv, false);
+
+	mutex_unlock(&drv->lock);
+
+	dev_err(drv->dev, "failed to bring up DSIM: %d\n", ret);
+	return ret;
+}
+
+/*
+ * Put DSIM back into a defined idle state at probe time, whatever the
+ * bootloader left behind.  Requires the DSIM pclk to be running.
+ */
+void exynos7580_dsim_quiesce(struct exynos7580_drm *drv)
+{
+	dsim_irq_mask(drv);
+	dsim_write_mask(drv, DSIM_CLKCTRL, 0,
+			DSIM_CLKCTRL_TX_REQUEST_HSCLK);
+	dsim_write_mask(drv, DSIM_CONFIG, 0, DSIM_CONFIG_LANE_ENx(0x1f));
+	dsim_clocks(drv, false);
+	dsim_sw_reset(drv);
+}
+
+/* dsim_drv.c:dsim_disable() */
+void exynos7580_dsim_disable(struct exynos7580_drm *drv)
+{
+	mutex_lock(&drv->lock);
+
+	if (!drv->dsim_on) {
+		mutex_unlock(&drv->lock);
+		return;
+	}
+
+	exynos7580_panel_suspend(drv);
+
+	dsim_irq_mask(drv);
+	dsim_set_hs_clock(drv, false);
+	dsim_set_lanes(drv, false);
+	dsim_clocks(drv, false);
+	dsim_sw_reset(drv);
+
+	clk_disable_unprepare(drv->dsim_byte_clk);
+	clk_disable_unprepare(drv->dsim_esc_clk);
+
+	drv->dsim_on = false;
+
+	exynos7580_panel_power(drv, false);
+
+	mutex_unlock(&drv->lock);
+}
