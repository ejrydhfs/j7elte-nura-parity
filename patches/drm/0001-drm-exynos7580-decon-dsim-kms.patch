+/* ---------------------------------------------------------------------- */
+/* Driver load/unload and platform glue					  */
+/* ---------------------------------------------------------------------- */
+
+static int exynos7580_load(struct drm_device *drm, unsigned long flags)
+{
+	struct platform_device *pdev = drm->platformdev;
+	struct exynos7580_drm *drv;
+	struct resource *res, dsim_res;
+	int ret, irq;
+
+	drv = kzalloc(sizeof(*drv), GFP_KERNEL);
+	if (!drv)
+		return -ENOMEM;
+
+	drv->drm = drm;
+	drv->dev = &pdev->dev;
+	mutex_init(&drv->lock);
+	mutex_init(&drv->iova_lock);
+	INIT_LIST_HEAD(&drv->iova_list);
+
+	drm->dev_private = drv;
+	platform_set_drvdata(pdev, drv);
+
+	ret = exynos7580_parse_dt(drv);
+	if (ret)
+		goto err_free;
+
+	ret = exynos7580_get_clocks(drv);
+	if (ret)
+		goto err_free;
+
+	/*
+	 * The display controller sits in the DISP power domain; runtime PM
+	 * also brings up all DECON/DSIM clocks in exynos7580_runtime_resume().
+	 * Keep one reference for the whole lifetime of the card so that SFR
+	 * accesses (including the ones done while the panel is off) are always
+	 * valid.
+	 */
+	pm_runtime_enable(drv->dev);
+	ret = pm_runtime_get_sync(drv->dev);
+	if (ret < 0) {
+		dev_err(drv->dev, "cannot power up the display domain: %d\n",
+			ret);
+		goto err_pm_disable;
+	}
+
+	res = platform_get_resource(pdev, IORESOURCE_MEM, 0);
+	if (!res) {
+		dev_err(drv->dev, "no DECON memory resource\n");
+		ret = -ENODEV;
+		goto err_pm;
+	}
+
+	drv->decon_base = devm_ioremap_resource(drv->dev, res);
+	if (IS_ERR(drv->decon_base)) {
+		ret = PTR_ERR(drv->decon_base);
+		drv->decon_base = NULL;
+		goto err_pm;
+	}
+
+	ret = of_address_to_resource(drv->dsim_np, 0, &dsim_res);
+	if (ret) {
+		dev_err(drv->dev, "no DSIM memory resource\n");
+		goto err_pm;
+	}
+	drv->dsim_base = devm_ioremap_resource(drv->dev, &dsim_res);
+	if (IS_ERR(drv->dsim_base)) {
+		ret = PTR_ERR(drv->dsim_base);
+		drv->dsim_base = NULL;
+		goto err_pm;
+	}
+
+	if (dma_set_mask(drv->dev, DMA_BIT_MASK(32)) ||
+	    dma_set_coherent_mask(drv->dev, DMA_BIT_MASK(32)))
+		dev_warn(drv->dev, "cannot set a 32 bit DMA mask\n");
+
+	/*
+	 * DECON reads pixels through the display System MMU.  If the IOMMU
+	 * driver is not available the SysMMU stays in bypass and physical
+	 * addresses are used instead (drv->use_iommu == false).
+	 */
+	if (!iovmm_activate(drv->dev))
+		drv->use_iommu = true;
+	else
+		dev_warn(drv->dev,
+			 "display IOMMU unavailable, using physical addresses\n");
+
+	/* Quiesce whatever the bootloader left enabled. */
+	exynos7580_dsim_quiesce(drv);
+	exynos7580_decon_stop(drv);
+
+	ret = exynos7580_modeset_init(drv);
+	if (ret)
+		goto err_modeset;
+
+	ret = drm_vblank_init(drm, 1);
+	if (ret) {
+		dev_err(drv->dev, "cannot init vblank: %d\n", ret);
+		goto err_modeset;
+	}
+	drv->vblank_init = true;
+
+	/*
+	 * DECON exposes three interrupt lines; only the frame done one
+	 * (interrupts[2] in the DT) is used, for vblank.  It is requested
+	 * directly instead of through drm_irq_install() because the DRM
+	 * platform bus only knows about interrupts[0] (the FIFO line).
+	 */
+	irq = platform_get_irq(pdev, 2);
+	if (irq < 0) {
+		dev_err(drv->dev, "no frame done interrupt\n");
+		ret = irq;
+		goto err_modeset;
+	}
+
+	ret = devm_request_irq(drv->dev, irq, exynos7580_decon_irq, 0,
+			       DRIVER_NAME, drm);
+	if (ret) {
+		dev_err(drv->dev, "cannot request IRQ %d: %d\n", irq, ret);
+		goto err_modeset;
+	}
+	drv->irq = irq;
+
+	drv->fbdev = drm_fbdev_cma_init(drm, 32, 1, 1);
+	if (IS_ERR(drv->fbdev)) {
+		ret = PTR_ERR(drv->fbdev);
+		drv->fbdev = NULL;
+		dev_err(drv->dev, "cannot init fbdev: %d\n", ret);
+		goto err_modeset;
+	}
+
+	dev_info(drv->dev, "DRM/KMS registered, mode %s, %s\n", drv->mode.name,
+		 drv->use_iommu ? "IOMMU" : "physical addresses");
+
+	return 0;
+
+err_modeset:
+	if (drv->vblank_init)
+		drm_vblank_cleanup(drm);
+	drm_mode_config_cleanup(drm);
+	drv->modeset_init = false;
+	if (drv->use_iommu)
+		iovmm_deactivate(drv->dev);
+err_pm:
+	pm_runtime_put_sync(drv->dev);
+err_pm_disable:
+	pm_runtime_disable(drv->dev);
+err_free:
+	platform_set_drvdata(pdev, NULL);
+	drm->dev_private = NULL;
+	kfree(drv);
+	return ret;
+}
+
+static int exynos7580_unload(struct drm_device *drm)
+{
+	struct exynos7580_drm *drv = drm->dev_private;
+	struct platform_device *pdev = drm->platformdev;
+
+	if (!drv)
+		return 0;
+
+	if (drv->display_on) {
+		exynos7580_decon_stop(drv);
+		drv->display_on = false;
+	}
+
+	if (drv->dsim_on)
+		exynos7580_dsim_disable(drv);
+
+	if (drv->irq) {
+		devm_free_irq(drv->dev, drv->irq, drm);
+		drv->irq = 0;
+	}
+
+	if (drv->fbdev) {
+		drm_fbdev_cma_fini(drv->fbdev);
+		drv->fbdev = NULL;
+	}
+
+	if (drv->vblank_init) {
+		drm_vblank_cleanup(drm);
+		drv->vblank_init = false;
+	}
+
+	if (drv->modeset_init) {
+		drm_mode_config_cleanup(drm);
+		drv->modeset_init = false;
+	}
+
+	if (drv->use_iommu)
+		iovmm_deactivate(drv->dev);
+
+	pm_runtime_put_sync(drv->dev);
+	pm_runtime_disable(drv->dev);
+
+	of_node_put(drv->dsim_np);
+
+	platform_set_drvdata(pdev, NULL);
+	drm->dev_private = NULL;
+	kfree(drv);
+
+	return 0;
+}
+
+static int exynos7580_probe(struct platform_device *pdev)
+{
+	return drm_platform_init(&exynos7580_drm_driver, pdev);
+}
+
+static int exynos7580_remove(struct platform_device *pdev)
+{
+	drm_platform_exit(&exynos7580_drm_driver, pdev);
+	return 0;
+}
+
+static const struct of_device_id exynos7580_drm_dt_match[] = {
+	{ .compatible = "samsung,exynos7580-decon-drm" },
+	{ },
+};
+MODULE_DEVICE_TABLE(of, exynos7580_drm_dt_match);
+
+static struct platform_driver exynos7580_platform_driver = {
+	.probe		= exynos7580_probe,
+	.remove		= exynos7580_remove,
+	.driver		= {
+		.name	= DRIVER_NAME,
+		.owner	= THIS_MODULE,
+		.of_match_table = exynos7580_drm_dt_match,
+		.pm	= &exynos7580_pm_ops,
+	},
+};
+
+module_platform_driver(exynos7580_platform_driver);
+
+MODULE_AUTHOR("Nura");
+MODULE_DESCRIPTION(DRIVER_DESC);
+MODULE_LICENSE("GPL v2");
