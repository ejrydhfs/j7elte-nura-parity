+/*
+ * Samsung Exynos 7580 (universal7580 / j7elte) DRM/KMS driver
+ *
+ * Single display pipe: DECON -> MIPI DSIM -> ea8061 720x1280 panel.
+ *
+ * This driver is deliberately standalone instead of extending
+ * drivers/gpu/drm/exynos: the in-tree Exynos DRM is the pre-atomic 3.10
+ * framework built around FIMD/HDMI/mixer, and the Exynos 7580 DECON has a
+ * different register map and a different power/clock model (runtime PM power
+ * domain + exynos_iovmm).  Adding a second display controller there would
+ * have touched 3.10's fragile non-atomic encoder/connector plumbing used by
+ * the other (unused on this board) outputs.
+ *
+ * Only legacy CRTC helpers are used; 3.10 has no atomic helpers.
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License version 2 as
+ * published by the Free Software Foundation.
+ */
+
+#include <linux/dma-mapping.h>
+#include <linux/exynos_iovmm.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/of_address.h>
+#include <linux/of_gpio.h>
+#include <linux/platform_device.h>
+#include <linux/pm_runtime.h>
+#include <linux/regulator/consumer.h>
+#include <linux/scatterlist.h>
+#include <linux/slab.h>
+
+#include "exynos7580_drm.h"
+
+#include <drm/drm_fb_helper.h>
+
+#define DRIVER_NAME	"exynos7580-drm"
+#define DRIVER_DESC	"Samsung Exynos 7580 DECON/DSIM DRM driver"
+#define DRIVER_DATE	"20261024"
+#define DRIVER_MAJOR	1
+#define DRIVER_MINOR	0
+#define DRIVER_PATCHLEVEL 0
+
+static int exynos7580_load(struct drm_device *drm, unsigned long flags);
+static int exynos7580_unload(struct drm_device *drm);
