+/* ---------------------------------------------------------------------- */
+/* Encoder							  */
+/* ---------------------------------------------------------------------- */
+
+static void exynos7580_encoder_dpms(struct drm_encoder *encoder, int mode)
+{
+	struct exynos7580_drm *drv = encoder_to_drv(encoder);
+
+	if (mode == DRM_MODE_DPMS_ON) {
+		if (!drv->dsim_on)
+			exynos7580_dsim_enable(drv);
+		if (!drv->display_on && encoder->crtc && encoder->crtc->fb) {
+			exynos7580_decon_start(drv);
+			drv->display_on = true;
+		}
+	} else {
+		if (drv->dsim_on)
+			exynos7580_dsim_disable(drv);
+	}
+}
+
+static bool exynos7580_encoder_mode_fixup(struct drm_encoder *encoder,
+					  const struct drm_display_mode *mode,
+					  struct drm_display_mode *adjusted_mode)
+{
+	struct exynos7580_drm *drv = encoder_to_drv(encoder);
+
+	return exynos7580_mode_is_panel(drv, mode);
+}
+
+static void exynos7580_encoder_mode_set(struct drm_encoder *encoder,
+					struct drm_display_mode *mode,
+					struct drm_display_mode *adjusted_mode)
+{
+	struct exynos7580_drm *drv = encoder_to_drv(encoder);
+
+	/*
+	 * The DSI link and the panel have to be up before the controller is
+	 * started (crtc commit), as in the vendor driver where DSIM s_stream(1)
+	 * runs before decon_reg_init()/decon_reg_start().
+	 */
+	if (!drv->dsim_on)
+		exynos7580_dsim_enable(drv);
+}
+
+static void exynos7580_encoder_disable(struct drm_encoder *encoder)
+{
+	struct exynos7580_drm *drv = encoder_to_drv(encoder);
+
+	if (drv->dsim_on)
+		exynos7580_dsim_disable(drv);
+}
+
+static void exynos7580_encoder_destroy(struct drm_encoder *encoder)
+{
+	drm_encoder_cleanup(encoder);
+}
+
+static const struct drm_encoder_helper_funcs exynos7580_encoder_helper_funcs = {
+	.dpms = exynos7580_encoder_dpms,
+	.mode_fixup = exynos7580_encoder_mode_fixup,
+	.mode_set = exynos7580_encoder_mode_set,
+	.disable = exynos7580_encoder_disable,
+};
+
+static const struct drm_encoder_funcs exynos7580_encoder_funcs = {
+	.destroy = exynos7580_encoder_destroy,
+};
