+/* ---------------------------------------------------------------------- */
+/* CRTC								  */
+/* ---------------------------------------------------------------------- */
+
+static bool exynos7580_mode_is_panel(struct exynos7580_drm *drv,
+				     const struct drm_display_mode *mode)
+{
+	return mode->hdisplay == drv->lcd.xres &&
+	       mode->vdisplay == drv->lcd.yres;
+}
+
+static void exynos7580_crtc_dpms(struct drm_crtc *crtc, int mode)
+{
+	struct exynos7580_drm *drv = crtc_to_drv(crtc);
+
+	if (mode == DRM_MODE_DPMS_ON) {
+		/*
+		 * From off to on the legacy helper calls us before the
+		 * encoder; only prepare the controller here, the encoder
+		 * starts the output once the DSI link is up.
+		 */
+		if (!drv->display_on && crtc->fb)
+			exynos7580_decon_prepare(drv, crtc->fb);
+	} else {
+		if (drv->display_on) {
+			exynos7580_decon_stop(drv);
+			drv->display_on = false;
+		}
+	}
+}
+
+static void exynos7580_crtc_prepare(struct drm_crtc *crtc)
+{
+}
+
+static void exynos7580_crtc_commit(struct drm_crtc *crtc)
+{
+	struct exynos7580_drm *drv = crtc_to_drv(crtc);
+
+	if (!drv->display_on) {
+		exynos7580_decon_start(drv);
+		drv->display_on = true;
+	}
+}
+
+static bool exynos7580_crtc_mode_fixup(struct drm_crtc *crtc,
+				       const struct drm_display_mode *mode,
+				       struct drm_display_mode *adjusted_mode)
+{
+	struct exynos7580_drm *drv = crtc_to_drv(crtc);
+
+	return exynos7580_mode_is_panel(drv, mode);
+}
+
+static int exynos7580_crtc_mode_set(struct drm_crtc *crtc,
+				    struct drm_display_mode *mode,
+				    struct drm_display_mode *adjusted_mode,
+				    int x, int y, struct drm_framebuffer *old_fb)
+{
+	struct exynos7580_drm *drv = crtc_to_drv(crtc);
+
+	if (!exynos7580_mode_is_panel(drv, mode))
+		return -EINVAL;
+
+	if (drv->display_on)
+		return exynos7580_decon_set_base(drv, crtc->fb);
+
+	return exynos7580_decon_prepare(drv, crtc->fb);
+}
+
+static int exynos7580_crtc_mode_set_base(struct drm_crtc *crtc, int x, int y,
+					 struct drm_framebuffer *old_fb)
+{
+	struct exynos7580_drm *drv = crtc_to_drv(crtc);
+
+	if (!crtc->fb)
+		return -EINVAL;
+
+	return exynos7580_decon_set_base(drv, crtc->fb);
+}
+
+static void exynos7580_crtc_disable(struct drm_crtc *crtc)
+{
+	struct exynos7580_drm *drv = crtc_to_drv(crtc);
+
+	if (drv->display_on) {
+		exynos7580_decon_stop(drv);
+		drv->display_on = false;
+	}
+
+	if (drv->dsim_on)
+		exynos7580_dsim_disable(drv);
+}
+
+static void exynos7580_crtc_destroy(struct drm_crtc *crtc)
+{
+	drm_crtc_cleanup(crtc);
+}
+
+static const struct drm_crtc_helper_funcs exynos7580_crtc_helper_funcs = {
+	.dpms = exynos7580_crtc_dpms,
+	.prepare = exynos7580_crtc_prepare,
+	.commit = exynos7580_crtc_commit,
+	.mode_fixup = exynos7580_crtc_mode_fixup,
+	.mode_set = exynos7580_crtc_mode_set,
+	.mode_set_base = exynos7580_crtc_mode_set_base,
+	.disable = exynos7580_crtc_disable,
+};
+
+static const struct drm_crtc_funcs exynos7580_crtc_funcs = {
+	.set_config = drm_crtc_helper_set_config,
+	.destroy = exynos7580_crtc_destroy,
+};
