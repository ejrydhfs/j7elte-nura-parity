+			     struct drm_framebuffer *fb);
+void exynos7580_decon_start(struct exynos7580_drm *drv);
+void exynos7580_decon_stop(struct exynos7580_drm *drv);
+int exynos7580_decon_set_base(struct exynos7580_drm *drv,
+			      struct drm_framebuffer *fb);
+void exynos7580_decon_disable_window(struct exynos7580_drm *drv);
+void exynos7580_decon_vblank(struct exynos7580_drm *drv, bool enable);
+irqreturn_t exynos7580_decon_irq(int irq, void *data);
+
+/* exynos7580_dsim.c */
+int exynos7580_dsim_enable(struct exynos7580_drm *drv);
+void exynos7580_dsim_disable(struct exynos7580_drm *drv);
+void exynos7580_dsim_quiesce(struct exynos7580_drm *drv);
+int exynos7580_panel_power(struct exynos7580_drm *drv, bool on);
+void exynos7580_panel_reset(struct exynos7580_drm *drv);
+int exynos7580_panel_init(struct exynos7580_drm *drv);
+void exynos7580_panel_suspend(struct exynos7580_drm *drv);
+
+#endif /* __EXYNOS7580_DRM_H__ */
