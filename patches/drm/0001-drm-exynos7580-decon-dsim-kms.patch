+static const uint32_t exynos7580_plane_formats[] = {
+	DRM_FORMAT_XRGB8888,
+	DRM_FORMAT_ARGB8888,
+};
+
+static int exynos7580_plane_update(struct drm_plane *plane,
+				   struct drm_crtc *crtc,
+				   struct drm_framebuffer *fb,
+				   int crtc_x, int crtc_y,
+				   unsigned int crtc_w, unsigned int crtc_h,
+				   uint32_t src_x, uint32_t src_y,
+				   uint32_t src_w, uint32_t src_h)
+{
+	struct exynos7580_drm *drv = plane_to_drv(plane);
+
+	if (crtc != &drv->crtc || !fb)
+		return -EINVAL;
+
+	/* Window 0 covers the whole panel; no scaling or panning. */
+	if (crtc_x || crtc_y || crtc_w != drv->lcd.xres ||
+	    crtc_h != drv->lcd.yres || src_x || src_y ||
+	    src_w != (drv->lcd.xres << 16) || src_h != (drv->lcd.yres << 16))
+		return -EINVAL;
+
+	return exynos7580_decon_set_base(drv, fb);
+}
+
+static int exynos7580_plane_disable(struct drm_plane *plane)
+{
+	struct exynos7580_drm *drv = plane_to_drv(plane);
+
+	exynos7580_decon_disable_window(drv);
+	return 0;
+}
+
+static void exynos7580_plane_destroy(struct drm_plane *plane)
+{
+	drm_plane_cleanup(plane);
+}
