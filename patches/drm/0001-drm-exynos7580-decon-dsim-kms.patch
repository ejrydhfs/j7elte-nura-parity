+static const struct drm_connector_funcs exynos7580_connector_funcs = {
+	.dpms = exynos7580_connector_dpms,
+	.detect = exynos7580_connector_detect,
+	.fill_modes = drm_helper_probe_single_connector_modes,
+	.destroy = exynos7580_connector_destroy,
