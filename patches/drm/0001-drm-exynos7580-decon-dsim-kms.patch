diff --git a/drivers/gpu/drm/exynos7580/Kconfig b/drivers/gpu/drm/exynos7580/Kconfig
new file mode 100644
index 0000000..15c0d98
--- /dev/null
+++ b/drivers/gpu/drm/exynos7580/Kconfig
@@ -0,0 +1,18 @@
+config DRM_EXYNOS7580
+	tristate "DRM/KMS support for Samsung Exynos 7580 (DECON + MIPI DSIM)"
+	depends on DRM && OF && ARM64 && ARCH_EXYNOS
+	select DRM_KMS_HELPER
+	select DRM_KMS_CMA_HELPER
+	select VIDEOMODE_HELPERS
+	help
+	  DRM/KMS driver for the Samsung Exynos 7580 display subsystem:
+	  the DECON display controller, the MIPI DSIM master/D-PHY and the
+	  ea8061 720x1280 panel found on the Galaxy J7 (j7elte).
+
+	  Provides a single CRTC with one primary plane, a DSI encoder and
+	  connector, CMA backed dumb buffers and fbdev emulation.  The
+	  vendor fbdev display stack (EXYNOS_DECON_EXYNOS7580) must be
+	  disabled when this driver is enabled, both claim the same
+	  hardware.
+
+	  If M is selected the module will be called exynos7580-drm.
diff --git a/drivers/gpu/drm/exynos7580/Makefile b/drivers/gpu/drm/exynos7580/Makefile
new file mode 100644
index 0000000..6ccffe0
--- /dev/null
+++ b/drivers/gpu/drm/exynos7580/Makefile
@@ -0,0 +1,11 @@
+#
+# Samsung Exynos 7580 DECON/DSIM DRM driver
+#
+# Register maps, LCD description and the ea8061 command byte streams are
+# shared with the vendor fbdev driver, so its directory is on the include
+# path (it is still present in the tree, only its Kconfig option is off).
+#
+ccflags-y += -I$(srctree)/drivers/video/exynos/decon_7580
+
+obj-$(CONFIG_DRM_EXYNOS7580) += exynos7580-drm.o
+exynos7580-drm-y := exynos7580_drm.o exynos7580_decon.o exynos7580_dsim.o
diff --git a/drivers/gpu/drm/exynos7580/exynos7580_decon.c b/drivers/gpu/drm/exynos7580/exynos7580_decon.c
new file mode 100644
index 0000000..2f0493a
--- /dev/null
+++ b/drivers/gpu/drm/exynos7580/exynos7580_decon.c
@@ -0,0 +1,465 @@
+/*
+ * Samsung Exynos 7580 DECON (display controller) support
+ *
+ * Every register write in this file mirrors a function of the vendor fbdev
+ * driver in drivers/video/exynos/decon_7580/.  The reference is noted at the
+ * function level; register offsets and field encodings come from
+ * drivers/video/exynos/decon_7580/regs-decon.h (included through
+ * exynos7580_drm.h).
+ *
+ * The vendor driver has no notion of DRM objects: it programs DECON from
+ * decon_core.c (decon_enable/decon_disable/__decon_update_regs) using the
+ * register primitives of decon_reg_7580.c.  This file keeps exactly the same
+ * register order, but expresses it as prepare/start/stop so that it fits the
+ * legacy DRM CRTC helper model.
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License version 2 as
+ * published by the Free Software Foundation.
+ */
+
+#include <linux/delay.h>
+#include <linux/io.h>
+
+#include "regs-decon.h"
+#include "exynos7580_drm.h"
+
+static inline u32 decon_read(struct exynos7580_drm *drv, u32 reg)
+{
+	return readl(drv->decon_base + reg);
+}
+
+static inline void decon_write(struct exynos7580_drm *drv, u32 reg, u32 val)
+{
+	writel(val, drv->decon_base + reg);
+}
+
+static inline void decon_write_mask(struct exynos7580_drm *drv, u32 reg,
+				    u32 val, u32 mask)
+{
+	u32 old = decon_read(drv, reg);
+
+	writel((val & mask) | (old & ~mask), drv->decon_base + reg);
+}
+
+/*
+ * decon_reg_reset() - software reset of the display controller
+ * (decon_reg_7580.c:decon_reg_reset)
+ */
+void exynos7580_decon_reset(struct exynos7580_drm *drv)
+{
+	int tries;
+
+	decon_write(drv, VIDCON0, VIDCON0_SWRESET);
+	for (tries = 2000; tries; --tries) {
+		if (!(decon_read(drv, VIDCON0) & VIDCON0_SWRESET))
+			break;
+		udelay(10);
+	}
+
+	if (!tries)
+		dev_err(drv->dev, "DECON reset timed out\n");
+}
+
+/*
+ * decon_reg_clear_win()
+ */
+static void decon_clear_win(struct exynos7580_drm *drv, int win)
+{
+	decon_write(drv, WINCON(win), WINCON_RESET_VALUE);
+	decon_write(drv, VIDOSD_A(win), 0);
+	decon_write(drv, VIDOSD_B(win), 0);
+	decon_write(drv, VIDOSD_C(win), 0);
+	decon_write(drv, VIDOSD_D(win), 0);
+}
+
+/*
+ * decon_reg_set_porch()
+ */
+static void decon_set_porch(struct exynos7580_drm *drv, int dsi)
+{
+	struct decon_lcd *lcd = &drv->lcd;
+
+	decon_write(drv, VIDTCON0(dsi),
+		    VIDTCON0_VBPD(lcd->vbp - 1) | VIDTCON0_VFPD(lcd->vfp - 1));
+	decon_write(drv, VIDTCON1(dsi), VIDTCON1_VSPW(lcd->vsa - 1));
+	decon_write(drv, VIDTCON2(dsi),
+		    VIDTCON2_HBPD(lcd->hbp - 1) | VIDTCON2_HFPD(lcd->hfp - 1));
+	decon_write(drv, VIDTCON3(dsi), VIDTCON3_HSPW(lcd->hsa - 1));
+	decon_write(drv, VIDTCON4(dsi),
+		    VIDTCON4_LINEVAL(lcd->yres - 1) |
+		    VIDTCON4_HOZVAL(lcd->xres - 1));
+}
+
+static void decon_shadow_protect(struct exynos7580_drm *drv, int win, bool on)
+{
+	decon_write_mask(drv, SHADOWCON, on ? ~0 : 0,
+			 SHADOWCON_WIN_PROTECT(win));
+}
+
+static void decon_update_standalone(struct exynos7580_drm *drv)
+{
+	decon_write_mask(drv, DECON_UPDATE, ~0, DECON_UPDATE_STANDALONE_F);
+}
+
+/*
+ * decon_reg_wait_for_update_timeout(), with the vendor 300 ms timeout.
+ * Once the shadow update has been latched the standalone bit self clears.
+ */
+static int decon_wait_update(struct exynos7580_drm *drv, unsigned long usec)
+{
+	unsigned long cnt = usec / 100;
+
+	while ((decon_read(drv, DECON_UPDATE) & DECON_UPDATE_STANDALONE_F) &&
+	       --cnt)
+		udelay(100);
+
+	if (!cnt) {
+		dev_err(drv->dev, "DECON shadow update timed out\n");
+		return -EBUSY;
+	}
+
+	return 0;
+}
+
+/*
+ * decon_reg_wait_stop_status_timeout(): VIDCON0 DECON_STOP_STATUS is set while
+ * the controller is still running and clears once it has stopped.
+ */
+static int decon_wait_stop(struct exynos7580_drm *drv, unsigned long usec)
+{
+	unsigned long cnt = usec / 10;
+	bool running;
+
+	do {
+		running = !!(decon_read(drv, VIDCON0) &
+			     VIDCON0_DECON_STOP_STATUS);
+		if (running)
+			udelay(10);
+	} while (running && --cnt);
+
+	return running ? -EBUSY : 0;
+}
+
+static u32 decon_wincon(u32 format)
+{
+	u32 val;
+
+	switch (format) {
+	case DRM_FORMAT_XRGB8888:
+		val = WINCON_BPPMODE_XRGB8888 | WINCON_ALPHA_SEL;
+		break;
+	case DRM_FORMAT_ARGB8888:
+		val = WINCON_BPPMODE_ARGB8888 | WINCON_BLD_PIX |
+			WINCON_ALPHA_SEL;
+		break;
+	default:
+		return 0;
+	}
+
+	/*
+	 * exynos7580 must use 16 word burst; the field has no shadow register
+	 * so it has to be retained on every update (decon_core.c:2310).
+	 *
+	 * OUTSTAND_MAX also has no shadow register and the vendor driver forces
+	 * it back to its reset value on every write
+	 * (decon_reg_7580.c:decon_reg_set_regs_data).
+	 */
+	return val | WINCON_BURSTLEN_16WORD | WINCON_ENWIN |
+	       (WINCON_OUTSTAND_MAX_DEFAULT << WINCON_OUTSTAND_MAX_POS);
+}
+
+static int decon_check_fb(struct exynos7580_drm *drv,
+			  struct drm_framebuffer *fb)
+{
+	if (!fb)
+		return -EINVAL;
+
+	if (fb->width != drv->lcd.xres || fb->height != drv->lcd.yres) {
+		dev_err(drv->dev, "unsupported fb size %ux%u (panel is %ux%u)\n",
+			fb->width, fb->height, drv->lcd.xres, drv->lcd.yres);
+		return -EINVAL;
+	}
+
+	/*
+	 * DECON has no stride register: VIDW_WHOLE_X covers a line of exactly
+	 * width * bytes-per-pixel, see decon_core.c:decon_set_win_buffer()
+	 * (fix.line_length = src.f_w * bpp / 8).
+	 */
+	if (fb->pitches[0] != fb->width * (fb->bits_per_pixel >> 3)) {
+		dev_err(drv->dev, "non-tight pitch %u is not supported\n",
+			fb->pitches[0]);
+		return -EINVAL;
+	}
+
+	if (!decon_wincon(fb->pixel_format)) {
+		dev_err(drv->dev, "unsupported pixel format %08x\n",
+			fb->pixel_format);
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
+static dma_addr_t decon_fb_iova(struct exynos7580_drm *drv,
+				struct drm_framebuffer *fb)
+{
+	struct drm_gem_cma_object *cma_obj;
+	dma_addr_t iova = 0;
+
+	cma_obj = drm_fb_cma_get_gem_obj(fb, 0);
+	if (!cma_obj) {
+		dev_err(drv->dev, "framebuffer has no GEM object\n");
+		return 0;
+	}
+
+	if (exynos7580_iova_get(drv, &cma_obj->base, &iova))
+		return 0;
+
+	/* The controller requires a 32 bit address. */
+	if (upper_32_bits(iova)) {
+		dev_err(drv->dev, "buffer address %pad is out of range\n", &iova);
+		return 0;
+	}
+
+	return iova;
+}
+
+/*
+ * Program window 0 with the given framebuffer.  Mirrors
+ * decon_reg_set_regs_data() + the shadow update done by
+ * __decon_update_regs().
+ */
+static int decon_set_window(struct exynos7580_drm *drv,
+			    struct drm_framebuffer *fb)
+{
+	dma_addr_t iova;
+	int ret;
+
+	ret = decon_check_fb(drv, fb);
+	if (ret)
+		return ret;
+
+	iova = decon_fb_iova(drv, fb);
+	if (!iova)
+		return -EINVAL;
+
+	decon_shadow_protect(drv, 0, true);
+
+	/* window 0 is fed by IDMA G0 (decon_reg_config_win_channel) */
+	decon_write_mask(drv, WINCHMAP0, WINCHMAP_DMA(IDMA_G0 + 1, 0),
+			 WINCHMAP_MASK(0));
+
+	decon_write(drv, WINCON(0), decon_wincon(fb->pixel_format));
+	decon_write(drv, WIN_MAP(0), 0);	/* no colour map */
+
+	decon_write(drv, VIDOSD_A(0), VIDOSD_A_TOPLEFT_X(0) |
+		    VIDOSD_A_TOPLEFT_Y(0));
+	decon_write(drv, VIDOSD_B(0),
+		    VIDOSD_B_BOTRIGHT_X(fb->width - 1) |
+		    VIDOSD_B_BOTRIGHT_Y(fb->height - 1));
+	decon_write(drv, VIDOSD_C(0), 0);
+	/* opaque plane alpha, same value as decon_set_alpha_blending() */
+	decon_write(drv, VIDOSD_D(0),
+		    VIDOSD_D_ALPHA1_R_F(0xff) | VIDOSD_D_ALPHA1_G_F(0xff) |
+		    VIDOSD_D_ALPHA1_B_F(0xff));
+
+	decon_write(drv, VIDW_ADD0(0), (u32)iova);
+	decon_write(drv, VIDW_WHOLE_X(0), fb->width);
+	decon_write(drv, VIDW_WHOLE_Y(0), fb->height);
+	decon_write(drv, VIDW_OFFSET_X(0), 0);
+	decon_write(drv, VIDW_OFFSET_Y(0), 0);
+
+	decon_shadow_protect(drv, 0, false);
+	decon_update_standalone(drv);
+
+	return 0;
+}
+
+/*
+ * Bring DECON into the state produced by decon_reg_init() +
+ * decon_reg_configure_lcd() for a video mode DSI output, and load window 0.
+ * Output stays disabled (VIDCON0 ENVID cleared) until exynos7580_decon_start().
+ */
+int exynos7580_decon_prepare(struct exynos7580_drm *drv,
+			     struct drm_framebuffer *fb)
+{
+	struct decon_lcd *lcd = &drv->lcd;
+	int win, ret;
+
+	if (lcd->mode != DECON_VIDEO_MODE) {
+		dev_err(drv->dev, "only MIPI video mode is supported\n");
+		return -EINVAL;
+	}
+
+	mutex_lock(&drv->lock);
+
+	exynos7580_decon_reset(drv);
+
+	decon_write(drv, BLENDCON, BLENDCON_NEW_8BIT_ALPHA_VALUE);
+
+	/* RGB interface towards DSIM, display on */
+	decon_write(drv, VIDOUTCON0, VIDOUTCON0_LCD_ON_F |
+		    VIDOUTCON0_RGBIF_F);
+
+	decon_write_mask(drv, CRCCTRL, 0, CRCCTRL_CRCCLKEN |
+			 CRCCTRL_CRCEN | CRCCTRL_CRCSTART_F);
+
+	/* video mode holds the pixel clock (decon_reg_init) */
+	decon_write_mask(drv, VIDCON1(0), VIDCON1_VCLK_HOLD,
+			 VIDCON1_VCLK_MASK);
+
+	for (win = 0; win < EXYNOS7580_MAX_WINDOWS; win++)
+		decon_clear_win(drv, win);
+
+	decon_write_mask(drv, VIDCON1(0), VIDCON1_RGB_ORDER_O_RGB,
+			 VIDCON1_RGB_ORDER_O_MASK);
+	decon_set_porch(drv, 0);
+
+	decon_write(drv, LINECNT_OP_THRESHOLD(0), lcd->yres - 1);
+
+	decon_write_mask(drv, VCLKCON0, ~0, VCLKCON0_CLKVALUP);
+	decon_write_mask(drv, VCLKCON0, ~0, VCLKCON0_VLCKFREE);
+	decon_write_mask(drv, VIDCON0, 0, VIDCON0_ENVID_F | VIDCON0_ENVID);
+
+	decon_write(drv, VIDINTCON1, VIDINTCON1_INT_I80 |
+		    VIDINTCON1_INT_FRAME | VIDINTCON1_INT_FIFO);
+
+	ret = decon_set_window(drv, fb);
+
+	mutex_unlock(&drv->lock);
+
+	return ret;
+}
+
+/*
+ * decon_reg_start(): enable the video output and latch the shadow registers.
+ */
+void exynos7580_decon_start(struct exynos7580_drm *drv)
+{
+	mutex_lock(&drv->lock);
+
+	decon_write_mask(drv, VIDCON0, ~0, VIDCON0_ENVID_F | VIDCON0_ENVID);
+	decon_update_standalone(drv);
+
+	mutex_unlock(&drv->lock);
+}
+
+/*
+ * decon_reg_stop(): stop at the next frame boundary, wait for the controller
+ * to report stopped and reset it.
+ */
+void exynos7580_decon_stop(struct exynos7580_drm *drv)
+{
+	mutex_lock(&drv->lock);
+
+	decon_write_mask(drv, VIDCON0, 0, VIDCON0_ENVID_F);
+	decon_update_standalone(drv);
+
+	if (decon_wait_stop(drv, 20 * 1000))
+		dev_warn(drv->dev, "DECON did not stop in time\n");
+
+	decon_write(drv, VIDINTCON1, VIDINTCON1_INT_I80 |
+		    VIDINTCON1_INT_FRAME | VIDINTCON1_INT_FIFO);
+
+	exynos7580_decon_reset(drv);
+
+	mutex_unlock(&drv->lock);
+}
+
+/*
+ * Address update for an already running pipe (legacy mode_set_base / plane
+ * update).
+ */
+int exynos7580_decon_set_base(struct exynos7580_drm *drv,
+			      struct drm_framebuffer *fb)
+{
+	dma_addr_t iova;
+	int ret;
+
+	ret = decon_check_fb(drv, fb);
+	if (ret)
+		return ret;
+
+	iova = decon_fb_iova(drv, fb);
+	if (!iova)
+		return -EINVAL;
+
+	mutex_lock(&drv->lock);
+
+	decon_shadow_protect(drv, 0, true);
+	decon_write(drv, VIDW_ADD0(0), (u32)iova);
+	decon_write(drv, VIDW_WHOLE_X(0), fb->width);
+	decon_write(drv, VIDW_WHOLE_Y(0), fb->height);
+	decon_write(drv, VIDW_OFFSET_X(0), 0);
+	decon_write(drv, VIDW_OFFSET_Y(0), 0);
+	decon_shadow_protect(drv, 0, false);
+
+	decon_update_standalone(drv);
+	decon_wait_update(drv, 300 * 1000);
+
+	mutex_unlock(&drv->lock);
+
+	return 0;
+}
+
+void exynos7580_decon_disable_window(struct exynos7580_drm *drv)
+{
+	mutex_lock(&drv->lock);
+
+	decon_shadow_protect(drv, 0, true);
+	decon_write_mask(drv, WINCON(0), 0, WINCON_ENWIN);
+	decon_shadow_protect(drv, 0, false);
+	decon_update_standalone(drv);
+
+	mutex_unlock(&drv->lock);
+}
+
+/*
+ * Vblank: DECON raises INT_FRAME at the beginning of vsync.  The vendor
+ * driver programs VIDINTCON0 the same way in decon_reg_set_int().
+ */
+void exynos7580_decon_vblank(struct exynos7580_drm *drv, bool enable)
+{
+	/*
+	 * Called by drm_vblank_get()/drm_vblank_put() with the vblank spinlock
+	 * held, so no sleeping locks here.
+	 */
+	if (enable) {
+		u32 val = VIDINTCON0_INT_ENABLE | VIDINTCON0_FIFOLEVEL_EMPTY |
+			  VIDINTCON0_INT_FRAME | VIDINTCON0_FRAMESEL0_VSYNC;
+
+		decon_write(drv, VIDINTCON1, VIDINTCON1_INT_FRAME);
+		decon_write(drv, VIDINTCON0, val);
+	} else {
+		decon_write_mask(drv, VIDINTCON0, 0, VIDINTCON0_INT_ENABLE);
+	}
+}
+
+irqreturn_t exynos7580_decon_irq(int irq, void *data)
+{
+	struct drm_device *drm = data;
+	struct exynos7580_drm *drv = drm->dev_private;
+	u32 status;
+	bool handled = false;
+
+	if (!drv)
+		return IRQ_NONE;
+
+	status = decon_read(drv, VIDINTCON1);
+
+	if (status & VIDINTCON1_INT_FRAME) {
+		decon_write(drv, VIDINTCON1, VIDINTCON1_INT_FRAME);
+		drv->vblank_count++;
+		drm_handle_vblank(drm, 0);
+		handled = true;
+	}
+
+	if (status & VIDINTCON1_INT_FIFO) {
+		/* FIFO underrun, only meaningful for diagnostics. */
+		decon_write(drv, VIDINTCON1, VIDINTCON1_INT_FIFO);
+		handled = true;
+	}
+
+	return handled ? IRQ_HANDLED : IRQ_NONE;
+}
diff --git a/drivers/gpu/drm/exynos7580/exynos7580_drm.c b/drivers/gpu/drm/exynos7580/exynos7580_drm.c
new file mode 100644
