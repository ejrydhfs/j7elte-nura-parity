+static void exynos7580_output_poll_changed(struct drm_device *drm)
+{
+	struct exynos7580_drm *drv = drm->dev_private;
+
+	if (drv && drv->fbdev)
+		drm_fbdev_cma_hotplug_event(drv->fbdev);
+}
+
+static const struct drm_mode_config_funcs exynos7580_mode_config_funcs = {
+	.fb_create = exynos7580_fb_create,
+	.output_poll_changed = exynos7580_output_poll_changed,
+};
+
+static int exynos7580_modeset_init(struct exynos7580_drm *drv)
+{
+	struct drm_device *drm = drv->drm;
+	int ret;
+
+	drm_mode_config_init(drm);
+	drv->modeset_init = true;
+
+	drm->mode_config.min_width = drv->lcd.xres;
+	drm->mode_config.max_width = drv->lcd.xres;
+	drm->mode_config.min_height = drv->lcd.yres;
+	drm->mode_config.max_height = drv->lcd.yres;
+	drm->mode_config.funcs = &exynos7580_mode_config_funcs;
+
+	ret = drm_crtc_init(drm, &drv->crtc, &exynos7580_crtc_funcs);
+	if (ret) {
+		dev_err(drv->dev, "cannot init CRTC: %d\n", ret);
+		return ret;
+	}
+	drm_crtc_helper_add(&drv->crtc, &exynos7580_crtc_helper_funcs);
+
+	ret = drm_encoder_init(drm, &drv->encoder, &exynos7580_encoder_funcs,
+			       DRM_MODE_ENCODER_LVDS);
+	if (ret) {
+		dev_err(drv->dev, "cannot init encoder: %d\n", ret);
+		return ret;
+	}
+	drv->encoder.possible_crtcs = 1;
+	drm_encoder_helper_add(&drv->encoder,
+			       &exynos7580_encoder_helper_funcs);
+
+	ret = drm_connector_init(drm, &drv->connector,
+				 &exynos7580_connector_funcs,
+				 DRM_MODE_CONNECTOR_LVDS);
+	if (ret) {
+		dev_err(drv->dev, "cannot init connector: %d\n", ret);
+		return ret;
+	}
+	drm_connector_helper_add(&drv->connector,
+				 &exynos7580_connector_helper_funcs);
+
+	ret = drm_mode_connector_attach_encoder(&drv->connector, &drv->encoder);
+	if (ret) {
+		dev_err(drv->dev, "cannot attach encoder: %d\n", ret);
+		return ret;
+	}
+
+	ret = drm_plane_init(drm, &drv->plane, 1, &exynos7580_plane_funcs,
+			     exynos7580_plane_formats,
+			     ARRAY_SIZE(exynos7580_plane_formats), false);
+	if (ret) {
+		dev_err(drv->dev, "cannot init primary plane: %d\n", ret);
+		return ret;
+	}
+
+	return 0;
+}
