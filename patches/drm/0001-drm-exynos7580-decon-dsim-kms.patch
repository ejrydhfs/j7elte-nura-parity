+/* ---------------------------------------------------------------------- */
+/* Device tree parsing							  */
+/* ---------------------------------------------------------------------- */
+
+/*
+ * Board control lists.  The syntax is the one implemented by the vendor
+ * driver in drivers/video/exynos/decon_7580/decon_board.c:
+ *
+ *   subnode {
+ *       type = "regulator,enable", "delay,usleep", ...;
+ *       regulator = "LCD_1P8", ...;
+ *       delay = <10000 11000>, ...;
+ *       gpios = <&gpd1 3 0x1>, ...;
+ *   };
+ *
+ * Only the actions used by the j7elte board description are supported.
+ */
+static int exynos7580_parse_board_list(struct exynos7580_drm *drv,
+				       struct device_node *board,
+				       const char *name,
+				       struct exynos7580_board_action *acts,
+				       int max, int *count)
+{
+	struct device_node *np;
+	struct property *prop;
+	const char *type;
+	int n = 0, reg_idx = 0, delay_idx = 0, gpio_idx = 0;
+
+	np = of_get_child_by_name(board, name);
+	if (!np)
+		return -ENOENT;
+
+	of_property_for_each_string(np, "type", prop, type) {
+		struct exynos7580_board_action *a;
+
+		if (n >= max) {
+			dev_warn(drv->dev, "%s: too many actions, truncated\n",
+				 name);
+			break;
+		}
+
+		a = &acts[n];
+
+		if (!strncmp(type, "regulator,", 10)) {
+			const char *rname;
+			struct regulator *reg;
+
+			if (of_property_read_string_index(np, "regulator",
+							  reg_idx++, &rname)) {
+				dev_err(drv->dev, "%s: missing regulator name\n",
+					name);
+				goto err;
+			}
+
+			reg = devm_regulator_get(drv->dev, rname);
+			if (IS_ERR(reg)) {
+				int ret = PTR_ERR(reg);
+
+				dev_err(drv->dev, "no regulator %s: %d\n",
+					rname, ret);
+				if (ret == -EPROBE_DEFER)
+					goto err_defer;
+				goto err;
+			}
+
+			a->regulator = reg;
+			a->type = strstr(type, "disable") ?
+				EXYNOS7580_BOARD_REGULATOR_DISABLE :
+				EXYNOS7580_BOARD_REGULATOR_ENABLE;
+		} else if (!strncmp(type, "gpio,", 5)) {
+			a->type = strstr(type, "high") ?
+				EXYNOS7580_BOARD_GPIO_HIGH :
+				EXYNOS7580_BOARD_GPIO_LOW;
+			gpio_idx++;
+		} else if (!strncmp(type, "delay,usleep", 12)) {
+			if (of_property_read_u32_index(np, "delay", delay_idx++,
+						       &a->delay[0]) ||
+			    of_property_read_u32_index(np, "delay", delay_idx++,
+						       &a->delay[1])) {
+				dev_err(drv->dev, "%s: missing usleep range\n",
+					name);
+				goto err;
+			}
+			a->type = EXYNOS7580_BOARD_DELAY_USLEEP;
+		} else if (!strncmp(type, "delay,msleep", 12)) {
+			if (of_property_read_u32_index(np, "delay", delay_idx++,
+						       &a->delay[0])) {
+				dev_err(drv->dev, "%s: missing msleep\n", name);
+				goto err;
+			}
+			a->type = EXYNOS7580_BOARD_DELAY_MSLEEP;
+		} else if (!strncmp(type, "delay,mdelay", 12)) {
+			if (of_property_read_u32_index(np, "delay", delay_idx++,
+						       &a->delay[0])) {
+				dev_err(drv->dev, "%s: missing mdelay\n", name);
+				goto err;
+			}
+			a->type = EXYNOS7580_BOARD_DELAY_MDELAY;
+		} else {
+			dev_warn(drv->dev, "%s: unsupported action \"%s\"\n",
+				 name, type);
+			continue;
+		}
+
+		n++;
+	}
+
+	of_node_put(np);
+	*count = n;
+	return 0;
+
+err_defer:
+	of_node_put(np);
+	return -EPROBE_DEFER;
+err:
+	of_node_put(np);
+	return -EINVAL;
+}
+
+static int exynos7580_parse_dt(struct exynos7580_drm *drv)
+{
+	struct device_node *np = drv->dev->of_node;
+	struct device_node *lcd_np, *board_np;
+	u32 res[3];
+	u32 val;
+	int ret;
+
+	drv->dsim_np = of_find_compatible_node(NULL, NULL,
+					       "samsung,exynos7580-dsim");
+	if (!drv->dsim_np) {
+		dev_err(drv->dev, "no DSIM node found\n");
+		return -ENODEV;
+	}
+
+	lcd_np = of_parse_phandle(drv->dsim_np, "lcd_info", 0);
+	if (!lcd_np) {
+		dev_err(drv->dev, "DSIM node has no lcd_info\n");
+		return -EINVAL;
+	}
+
+	if (of_property_read_u32(lcd_np, "mode", &val)) {
+		dev_err(drv->dev, "panel has no mode\n");
+		goto err_lcd;
+	}
+	drv->lcd.mode = val;
+
+	if (of_property_read_u32_array(lcd_np, "resolution", res, 2)) {
+		dev_err(drv->dev, "panel has no resolution\n");
+		goto err_lcd;
+	}
+	drv->lcd.xres = res[0];
+	drv->lcd.yres = res[1];
+
+	of_property_read_u32_array(lcd_np, "size", res, 2);
+	drv->lcd.width = res[0];
+	drv->lcd.height = res[1];
+
+	of_property_read_u32(lcd_np, "timing,refresh", &drv->lcd.fps);
+
+	if (of_property_read_u32_array(lcd_np, "timing,h-porch", res, 3)) {
+		dev_err(drv->dev, "panel has no horizontal porches\n");
+		goto err_lcd;
+	}
+	drv->lcd.hbp = res[0];
+	drv->lcd.hfp = res[1];
+	drv->lcd.hsa = res[2];
+
+	if (of_property_read_u32_array(lcd_np, "timing,v-porch", res, 3)) {
+		dev_err(drv->dev, "panel has no vertical porches\n");
+		goto err_lcd;
+	}
+	drv->lcd.vbp = res[0];
+	drv->lcd.vfp = res[1];
+	drv->lcd.vsa = res[2];
+
+	of_property_read_u32(lcd_np, "timing,dsi-hs-clk", &drv->lcd.hs_clk);
+	of_property_read_u32(lcd_np, "timing,dsi-escape-clk",
+			     &drv->lcd.esc_clk);
+	of_property_read_u32(lcd_np, "mic", &drv->lcd.mic_enabled);
+	of_property_read_u32(lcd_np, "type_of_ddi", &drv->lcd.ddi_type);
+	of_property_read_u32(lcd_np, "rev", &drv->panel_rev);
+	of_node_put(lcd_np);
+
+	if (!drv->lcd.xres || !drv->lcd.yres ||
+	    !drv->lcd.hs_clk || !drv->lcd.esc_clk) {
+		dev_err(drv->dev, "incomplete panel description\n");
+		return -EINVAL;
+	}
+
+	if (of_property_read_u32(np, "disp-pll-clk", &val) || !val)
+		val = 64500000;		/* j7elte pixel clock (disp_pll), 828x1300x60 */
+	drv->disp_pll_rate = val;
+
+	if (of_property_read_u32(drv->dsim_np, "data_lane_cnt", &val)) {
+		dev_err(drv->dev, "DSIM node has no data_lane_cnt\n");
+		return -EINVAL;
+	}
+	if (val < 1 || val > 4) {
+		dev_err(drv->dev, "invalid lane count %u\n", val);
+		return -EINVAL;
+	}
+	drv->data_lanes = val;
+
+	board_np = of_parse_phandle(drv->dsim_np, "decon_board", 0);
+	if (!board_np) {
+		dev_err(drv->dev, "DSIM node has no decon_board\n");
+		return -EINVAL;
+	}
+
+	ret = exynos7580_parse_board_list(drv, board_np,
+					  "dsim_set_panel_power_enable",
+					  drv->power_on,
+					  EXYNOS7580_MAX_BOARD_ACTIONS,
+					  &drv->num_power_on);
+	if (ret && ret != -ENOENT)
+		goto err_board;
+
+	ret = exynos7580_parse_board_list(drv, board_np,
+					  "dsim_set_panel_power_disable",
+					  drv->power_off,
+					  EXYNOS7580_MAX_BOARD_ACTIONS,
+					  &drv->num_power_off);
+	if (ret && ret != -ENOENT)
+		goto err_board;
+
+	/*
+	 * The reset list carries one gpio entry per edge.  All of them point at
+	 * the same line (see exynos7580-j7elte_rev00.dts), so request it once.
+	 */
+	{
+		struct device_node *rst;
+		int gpio;
+
+		rst = of_get_child_by_name(board_np, "dsim_reset_panel");
+		if (rst) {
+			gpio = of_get_named_gpio(rst, "gpios", 0);
+			if (gpio < 0) {
+				dev_err(drv->dev, "panel reset gpio missing\n");
+				of_node_put(rst);
+				ret = gpio;
+				goto err_board;
+			}
+
+			ret = devm_gpio_request_one(drv->dev, gpio,
+						    GPIOF_OUT_INIT_LOW,
+						    "panel-reset");
+			if (ret) {
+				dev_err(drv->dev, "cannot claim reset gpio %d\n",
+					gpio);
+				of_node_put(rst);
+				goto err_board;
+			}
+
+			drv->reset_gpio = gpio;
+			drv->reset_gpio_valid = true;
+			of_node_put(rst);
+		}
+
+		ret = exynos7580_parse_board_list(drv, board_np,
+						  "dsim_reset_panel",
+						  drv->reset,
+						  EXYNOS7580_MAX_BOARD_ACTIONS,
+						  &drv->num_reset);
+		if (ret && ret != -ENOENT)
+			goto err_board;
+	}
+
+	of_node_put(board_np);
+
+	/* Build the one and only mode of this panel. */
+	{
+		struct drm_display_mode *mode = &drv->mode;
+		u32 htotal = drv->lcd.xres + drv->lcd.hbp + drv->lcd.hfp +
+			     drv->lcd.hsa;
+		u32 vtotal = drv->lcd.yres + drv->lcd.vbp + drv->lcd.vfp +
+			     drv->lcd.vsa;
+
+		memset(mode, 0, sizeof(*mode));
+		mode->clock = (htotal * vtotal * drv->lcd.fps) / 1000;
+		mode->hdisplay = drv->lcd.xres;
+		mode->hsync_start = drv->lcd.xres + drv->lcd.hfp;
+		mode->hsync_end = mode->hsync_start + drv->lcd.hsa;
+		mode->htotal = htotal;
+		mode->vdisplay = drv->lcd.yres;
+		mode->vsync_start = drv->lcd.yres + drv->lcd.vfp;
+		mode->vsync_end = mode->vsync_start + drv->lcd.vsa;
+		mode->vtotal = vtotal;
+		mode->flags = 0;
+		drm_mode_set_name(mode);
+	}
+
+	dev_info(drv->dev, "panel %s, %u Mbps/lane, %d lanes, video mode\n",
+		 drv->mode.name, drv->lcd.hs_clk, drv->data_lanes);
+
+	return 0;
+
+err_board:
+	of_node_put(board_np);
+	return ret;
+err_lcd:
+	of_node_put(lcd_np);
+	return -EINVAL;
+}
+
+/* ---------------------------------------------------------------------- */
+/* Clocks and power							  */
+/* ---------------------------------------------------------------------- */
+
+static struct clk *exynos7580_clk(struct exynos7580_drm *drv, const char *name)
+{
+	struct clk *clk = clk_get(drv->dev, name);
+
+	if (IS_ERR(clk)) {
+		dev_err(drv->dev, "cannot get clock %s: %ld\n", name,
+			PTR_ERR(clk));
+		return NULL;
+	}
+
+	return clk;
+}
+
+/*
+ * Mirrors decon_int_set_clocks()/decon_clk_set_* from
+ * drivers/video/exynos/decon_7580/decon-int_drv.c and decon_helper.c.
+ * The divider helper there programs parent_rate / (divider + 1).
+ */
+static void exynos7580_clk_config(struct exynos7580_drm *drv)
+{
+	unsigned long rate;
+
+	clk_set_rate(drv->disp_pll, drv->disp_pll_rate);
+
+	/* eclk: DECON core clock */
+	clk_set_parent(drv->mout_eclk_a, drv->bus_pll);
+	clk_set_parent(drv->mout_eclk_b, drv->mout_eclk_a);
+	clk_set_parent(drv->mout_eclk_user, drv->sclk_disp_eclk);
+	clk_set_parent(drv->m_decon0_eclk, drv->mout_eclk_user);
+
+	rate = clk_get_rate(drv->mout_eclk_b);
+	clk_set_rate(drv->dout_sclk_disp_eclk, DIV_ROUND_UP(rate, 5)); /* /5 */
+	clk_set_rate(drv->d_decon0_eclk, clk_get_rate(drv->m_decon0_eclk));
+
+	/* vclk: pixel clock, disp_pll / 1 = 64.5 MHz (828 x 1300 x 60) */
+	clk_set_parent(drv->m_decon0_vclk, drv->disp_pll);
+	clk_set_rate(drv->d_decon0_vclk, clk_get_rate(drv->m_decon0_vclk));
+
+	/* aclk: DMA clock */
+	clk_set_parent(drv->mout_aclk_disp_200, drv->bus_pll);
+	rate = clk_get_rate(drv->mout_aclk_disp_200);
+	clk_set_rate(drv->dout_aclk_disp_200, DIV_ROUND_UP(rate, 4)); /* /4 */
+	clk_set_parent(drv->mout_aclk_disp_200_user, drv->aclk_disp_200);
+
+	/* pclk: bus clock for SFR accesses */
+	if (drv->d_pclk_disp) {
+		struct clk *parent = clk_get_parent(drv->d_pclk_disp);
+
+		if (parent)
+			clk_set_rate(drv->d_pclk_disp,
+				     DIV_ROUND_UP(clk_get_rate(parent), 2));
+	}
+}
+
+static int exynos7580_get_clocks(struct exynos7580_drm *drv)
+{
+	drv->decon_pclk = exynos7580_clk(drv, "pclk_decon0");
+	drv->decon_aclk = exynos7580_clk(drv, "aclk_decon0");
+	drv->decon_eclk = exynos7580_clk(drv, "decon0_eclk");
+	drv->decon_vclk = exynos7580_clk(drv, "decon0_vclk");
+	drv->decon_aclk_disp = exynos7580_clk(drv, "aclk_disp");
+	drv->disp_pll = exynos7580_clk(drv, "disp_pll");
+	drv->bus_pll = exynos7580_clk(drv, "bus_pll");
+	drv->mout_eclk_a = exynos7580_clk(drv,
+			"mout_sclk_disp_decon_int_eclk_a");
+	drv->mout_eclk_b = exynos7580_clk(drv,
+			"mout_sclk_disp_decon_int_eclk_b");
+	drv->mout_eclk_user = exynos7580_clk(drv,
+			"mout_sclk_decon_int_eclk_user");
+	drv->sclk_disp_eclk = exynos7580_clk(drv,
+			"sclk_disp_decon_int_eclk");
+	drv->dout_sclk_disp_eclk = exynos7580_clk(drv,
+			"dout_sclk_disp_decon_int_eclk");
+	drv->m_decon0_eclk = exynos7580_clk(drv, "m_decon0_eclk");
+	drv->d_decon0_eclk = exynos7580_clk(drv, "d_decon0_eclk");
+	drv->m_decon0_vclk = exynos7580_clk(drv, "m_decon0_vclk");
+	drv->d_decon0_vclk = exynos7580_clk(drv, "d_decon0_vclk");
+	drv->mout_aclk_disp_200 = exynos7580_clk(drv, "mout_aclk_disp_200");
+	drv->dout_aclk_disp_200 = exynos7580_clk(drv, "dout_aclk_disp_200");
+	drv->mout_aclk_disp_200_user = exynos7580_clk(drv,
+			"mout_aclk_disp_200_user");
+	drv->d_pclk_disp = exynos7580_clk(drv, "d_pclk_disp");
+	drv->aclk_disp_200 = exynos7580_clk(drv, "aclk_disp_200");
+	drv->mif_pll = exynos7580_clk(drv, "mif_pll");
+
+	/* DSIM clocks live on the dsim node, look them up by phandle. */
+	drv->dsim_pclk = of_clk_get_by_name(drv->dsim_np, "pclk_dsim0");
+	if (IS_ERR(drv->dsim_pclk))
+		drv->dsim_pclk = NULL;
+	drv->dsim_esc_clk = of_clk_get_by_name(drv->dsim_np, "mipi0_rx");
+	if (IS_ERR(drv->dsim_esc_clk))
+		drv->dsim_esc_clk = NULL;
+	drv->dsim_byte_clk = of_clk_get_by_name(drv->dsim_np, "mipi0_bit");
+	if (IS_ERR(drv->dsim_byte_clk))
+		drv->dsim_byte_clk = NULL;
+	drv->dsim_rgb_vclk = of_clk_get_by_name(drv->dsim_np, "rgb_vclk0");
+	if (IS_ERR(drv->dsim_rgb_vclk))
+		drv->dsim_rgb_vclk = NULL;
+	drv->dsim_pclk_disp = of_clk_get_by_name(drv->dsim_np, "pclk_disp");
+	if (IS_ERR(drv->dsim_pclk_disp))
+		drv->dsim_pclk_disp = NULL;
+
+	if (!drv->decon_pclk || !drv->decon_aclk || !drv->decon_eclk ||
+	    !drv->decon_vclk || !drv->decon_aclk_disp || !drv->disp_pll ||
+	    !drv->bus_pll || !drv->dsim_pclk || !drv->dsim_esc_clk ||
+	    !drv->dsim_byte_clk || !drv->dsim_rgb_vclk ||
+	    !drv->dsim_pclk_disp)
+		return -ENODEV;
+
+	return 0;
+}
+
+static void exynos7580_clk_enable(struct exynos7580_drm *drv)
+{
+	clk_prepare_enable(drv->decon_pclk);
+	clk_prepare_enable(drv->decon_aclk);
+	clk_prepare_enable(drv->decon_eclk);
+	clk_prepare_enable(drv->decon_vclk);
+	clk_prepare_enable(drv->decon_aclk_disp);
+	clk_prepare_enable(drv->dsim_pclk);
+	clk_prepare_enable(drv->dsim_rgb_vclk);
+	clk_prepare_enable(drv->dsim_pclk_disp);
+}
+
+static void exynos7580_clk_disable(struct exynos7580_drm *drv)
+{
+	clk_disable_unprepare(drv->dsim_pclk_disp);
+	clk_disable_unprepare(drv->dsim_rgb_vclk);
+	clk_disable_unprepare(drv->dsim_pclk);
+	clk_disable_unprepare(drv->decon_aclk_disp);
+	clk_disable_unprepare(drv->decon_vclk);
+	clk_disable_unprepare(drv->decon_eclk);
+	clk_disable_unprepare(drv->decon_aclk);
+	clk_disable_unprepare(drv->decon_pclk);
+}
+
+static int exynos7580_runtime_suspend(struct device *dev)
+{
+	struct exynos7580_drm *drv = dev_get_drvdata(dev);
+
+	if (!drv)
+		return 0;
+
+	exynos7580_clk_disable(drv);
+	return 0;
+}
+
+static int exynos7580_runtime_resume(struct device *dev)
+{
+	struct exynos7580_drm *drv = dev_get_drvdata(dev);
+
+	if (!drv)
+		return 0;
+
+	exynos7580_clk_config(drv);
+	exynos7580_clk_enable(drv);
+	return 0;
+}
+
+static const struct dev_pm_ops exynos7580_pm_ops = {
+	.runtime_suspend = exynos7580_runtime_suspend,
+	.runtime_resume = exynos7580_runtime_resume,
+};
+
+/* ---------------------------------------------------------------------- */
+/* GEM/IOMMU helpers							  */
+/* ---------------------------------------------------------------------- */
+
+/*
+ * DECON fetches pixels through the display System MMU (sysmmu@14860000), so
+ * every scanout buffer needs an IOVA, exactly like the vendor driver's
+ * ion_iovmm_map() in decon_core.c:decon_map_ion_handle().  Mappings are
+ * cached per GEM object and released from the GEM free callback.
+ */
+int exynos7580_iova_get(struct exynos7580_drm *drv, struct drm_gem_object *obj,
+			dma_addr_t *iova)
+{
+	struct drm_gem_cma_object *cma_obj = to_drm_gem_cma_obj(obj);
+	struct exynos7580_iova *m;
+	int ret = 0;
+
+	mutex_lock(&drv->iova_lock);
+
+	list_for_each_entry(m, &drv->iova_list, list) {
+		if (m->obj == obj) {
+			*iova = m->iova;
+			goto out;
+		}
+	}
+
+	if (!drv->use_iommu) {
+		*iova = cma_obj->paddr;
+		goto out;
+	}
+
+	m = kzalloc(sizeof(*m), GFP_KERNEL);
+	if (!m) {
+		ret = -ENOMEM;
+		goto out;
+	}
+
+	{
+		struct sg_table sgt;
+
+		ret = sg_alloc_table(&sgt, 1, GFP_KERNEL);
+		if (ret) {
+			kfree(m);
+			goto out;
+		}
+
+		sg_set_buf(sgt.sgl, cma_obj->vaddr, obj->size);
+		m->iova = iovmm_map(drv->dev, sgt.sgl, 0, obj->size,
+				    DMA_TO_DEVICE, 0);
+		sg_free_table(&sgt);
+
+		if (IS_ERR_VALUE(m->iova)) {
+			dev_err(drv->dev, "failed to map %zu bytes: %ld\n",
+				(size_t)obj->size, (long)m->iova);
+			kfree(m);
+			ret = -ENOMEM;
+			goto out;
+		}
+	}
+
+	m->obj = obj;
+	list_add_tail(&m->list, &drv->iova_list);
+	*iova = m->iova;
+out:
+	mutex_unlock(&drv->iova_lock);
+	return ret;
+}
+
+static void exynos7580_iova_put(struct exynos7580_drm *drv,
+				struct drm_gem_object *obj)
+{
+	struct exynos7580_iova *m, *tmp;
+
+	mutex_lock(&drv->iova_lock);
+
+	list_for_each_entry_safe(m, tmp, &drv->iova_list, list) {
+		if (m->obj != obj)
+			continue;
+
+		if (drv->use_iommu)
+			iovmm_unmap(drv->dev, m->iova);
+		list_del(&m->list);
+		kfree(m);
+		break;
+	}
+
+	mutex_unlock(&drv->iova_lock);
+}
+
+static void exynos7580_gem_free_object(struct drm_gem_object *obj)
+{
+	struct exynos7580_drm *drv = obj->dev->dev_private;
+
+	if (drv)
+		exynos7580_iova_put(drv, obj);
+
+	drm_gem_cma_free_object(obj);
+}
