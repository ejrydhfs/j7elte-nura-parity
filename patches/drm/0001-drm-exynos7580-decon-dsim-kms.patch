+/*
+ * Samsung Exynos 7580 (universal7580 / j7elte) DRM/KMS driver
+ *
+ * DECON (display controller) CRTC + primary plane, MIPI DSIM encoder and
+ * connector, and ea8061 720x1280 panel support.
+ *
+ * The hardware is a single fixed display pipe:
+ *
+ *   DECON (0x14830000) --rgb--> DSIM (0x14800000) --mipi-dphy--> ea8061 panel
+ *
+ * Register maps and the panel command sequences are taken verbatim from the
+ * vendor fbdev driver in drivers/video/exynos/decon_7580 so that there is a
+ * single source of truth for the values (see exynos7580_decon.c and
+ * exynos7580_dsim.c for the per-function traceability notes).
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License version 2 as
+ * published by the Free Software Foundation.
+ */
+
+#ifndef __EXYNOS7580_DRM_H__
+#define __EXYNOS7580_DRM_H__
+
+#include <linux/clk.h>
+#include <linux/gpio.h>
+#include <linux/kernel.h>
+#include <linux/list.h>
+#include <linux/mutex.h>
+#include <linux/regulator/consumer.h>
+#include <linux/types.h>
+
+#include <drm/drmP.h>
+#include <drm/drm_crtc_helper.h>
+#include <drm/drm_fb_cma_helper.h>
+#include <drm/drm_gem_cma_helper.h>
+
+/* Vendor headers: register maps, the Exynos LCD description and the exact
+ * ea8061 initialisation byte streams. */
+#include "decon_common.h"
+
+#define EXYNOS7580_MAX_WINDOWS		3
+#define EXYNOS7580_MAX_BOARD_ACTIONS	8
+
+/* Values taken from drivers/video/exynos/decon_7580/decon_reg_7580.c */
+#define EXYNOS7580_SHADOW_OFFSET	0x7000
+
+/* VIDINTCON0 FRAMESEL0 is a two bit field, the vendor header only defines the
+ * encodings. */
+#define EXYNOS7580_VIDINTCON0_FRAMESEL0_MASK	(0x3 << 15)
+
+/* DSIM constants from drivers/video/exynos/decon_7580/dsim_reg_7580.c */
+#define EXYNOS7580_DSIM_STOP_STATE_CNT	0x7ff
+#define EXYNOS7580_DSIM_BTA_TIMEOUT	0xff
+#define EXYNOS7580_DSIM_LP_RX_TIMEOUT	0xffff
+#define EXYNOS7580_DSIM_MULTI_PACKET_CNT 0xffff
+#define EXYNOS7580_DSIM_PLL_STABLE_TIME	22200
+#define EXYNOS7580_DSIM_CMD_ALLOW_VALUE	4
+#define EXYNOS7580_DSIM_STABLE_VFP_VALUE 2
+
+/* EA8061 panel revision threshold used by the vendor driver:
+ * ea8061_init() uses SEQ_EA8061_LTPS_TIMING_REV_D when id[2] >= 0x03.
+ * The DT describes the panel as rev = <4>. */
+#define EXYNOS7580_PANEL_REV_D		0x03
+
+enum exynos7580_board_action_type {
+	EXYNOS7580_BOARD_REGULATOR_ENABLE,
+	EXYNOS7580_BOARD_REGULATOR_DISABLE,
+	EXYNOS7580_BOARD_GPIO_HIGH,
+	EXYNOS7580_BOARD_GPIO_LOW,
+	EXYNOS7580_BOARD_DELAY_USLEEP,
+	EXYNOS7580_BOARD_DELAY_MSLEEP,
+	EXYNOS7580_BOARD_DELAY_MDELAY,
+};
+
+struct exynos7580_board_action {
+	enum exynos7580_board_action_type type;
+	int gpio;
+	u32 delay[2];
+	struct regulator *regulator;
+};
+
+/* Cached IOMMU mapping of a GEM object. Scanned out buffers must stay mapped
+ * for as long as DECON can fetch them, exactly like the vendor driver's
+ * ion_iovmm_map() of a dma_buf. */
+struct exynos7580_iova {
+	struct list_head list;
+	struct drm_gem_object *obj;
+	dma_addr_t iova;
+};
+
+struct exynos7580_drm {
+	struct drm_device *drm;
+	struct device *dev;
+
+	/* Device tree data */
+	struct device_node *dsim_np;
+	struct decon_lcd lcd;
+	struct drm_display_mode mode;
+	unsigned int panel_rev;
+	int data_lanes;
+
+	/* MMIO */
+	void __iomem *decon_base;
+	void __iomem *dsim_base;
+
+	/* DECON clocks (names from the decon DT node) */
+	struct clk *decon_pclk;
+	struct clk *decon_aclk;
+	struct clk *decon_eclk;
+	struct clk *decon_vclk;
+	struct clk *decon_aclk_disp;
