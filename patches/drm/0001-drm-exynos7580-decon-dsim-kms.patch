+/* ---------------------------------------------------------------------- */
+/* Connector							  */
+/* ---------------------------------------------------------------------- */
+
+/*
+ * 3.10 has no DRM_MODE_CONNECTOR_DSI; an internal panel is reported as LVDS,
+ * which is what pre-DSI connector enums used for fixed panels.
+ */
+static int exynos7580_connector_get_modes(struct drm_connector *connector)
+{
+	struct exynos7580_drm *drv = connector_to_drv(connector);
+	struct drm_display_mode *mode;
+
+	mode = drm_mode_create(connector->dev);
+	if (!mode)
+		return 0;
+
+	drm_mode_copy(mode, &drv->mode);
+	mode->type = DRM_MODE_TYPE_DRIVER | DRM_MODE_TYPE_PREFERRED;
+	drm_mode_probed_add(connector, mode);
+
+	return 1;
+}
+
+static int exynos7580_connector_mode_valid(struct drm_connector *connector,
+					   struct drm_display_mode *mode)
+{
+	struct exynos7580_drm *drv = connector_to_drv(connector);
+
+	return exynos7580_mode_is_panel(drv, mode) ? MODE_OK : MODE_BAD;
+}
+
+static struct drm_encoder *
+exynos7580_connector_best_encoder(struct drm_connector *connector)
+{
+	struct exynos7580_drm *drv = connector_to_drv(connector);
+
+	return &drv->encoder;
+}
+
+static enum drm_connector_status
+exynos7580_connector_detect(struct drm_connector *connector, bool force)
+{
+	/* The panel is soldered on; it is always there. */
+	return connector_status_connected;
+}
