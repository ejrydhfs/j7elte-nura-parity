+{
+	return container_of(crtc, struct exynos7580_drm, crtc);
+}
+
+static struct exynos7580_drm *encoder_to_drv(struct drm_encoder *encoder)
+{
+	return container_of(encoder, struct exynos7580_drm, encoder);
+}
