+/*
+ * Samsung Exynos 7580 MIPI DSIM (DSI master + D-PHY) and ea8061 panel support
+ *
+ * This file is a straight port of the vendor dsim driver and the ea8061 panel
+ * driver:
+ *
+ *   drivers/video/exynos/decon_7580/dsim_reg_7580.c  register sequences
+ *   drivers/video/exynos/decon_7580/dsim_drv.c       power/clock sequencing
+ *   drivers/video/exynos/decon_7580/panels/ea8061_lcd_ctrl.c  panel init
+ *   drivers/video/exynos/decon_7580/panels/ea8061_param.h     panel bytes
+ *
+ * The only structural difference is that command transfers poll the DSIM
+ * interrupt status register instead of waiting on the vendor interrupt
+ * completions.  DSIM interrupts are therefore left masked; INTSRC is a raw
+ * status register and is updated regardless of INTMSK.
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License version 2 as
+ * published by the Free Software Foundation.
+ */
