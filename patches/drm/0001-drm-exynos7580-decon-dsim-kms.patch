+	struct clk *bus_pll;
+	struct clk *mout_eclk_a;
+	struct clk *mout_eclk_b;
+	struct clk *mout_eclk_user;
+	struct clk *sclk_disp_eclk;
+	struct clk *dout_sclk_disp_eclk;
+	struct clk *m_decon0_eclk;
+	struct clk *d_decon0_eclk;
+	struct clk *m_decon0_vclk;
+	struct clk *d_decon0_vclk;
+	struct clk *mout_aclk_disp_200;
+	struct clk *dout_aclk_disp_200;
+	struct clk *mout_aclk_disp_200_user;
+	struct clk *d_pclk_disp;
+	struct clk *aclk_disp_200;
+	struct clk *mif_pll;
+
+	/* DSIM clocks (looked up through the dsim DT node) */
+	struct clk *dsim_pclk;
+	struct clk *dsim_esc_clk;
+	struct clk *dsim_byte_clk;
+	struct clk *dsim_rgb_vclk;
+	struct clk *dsim_pclk_disp;
+
+	/* Panel board control */
+	struct exynos7580_board_action power_on[EXYNOS7580_MAX_BOARD_ACTIONS];
+	int num_power_on;
+	struct exynos7580_board_action power_off[EXYNOS7580_MAX_BOARD_ACTIONS];
+	int num_power_off;
+	struct exynos7580_board_action reset[EXYNOS7580_MAX_BOARD_ACTIONS];
+	int num_reset;
+	int reset_gpio;
+	bool reset_gpio_valid;
+
+	/* Runtime state */
+	struct mutex lock;		/* serialises DECON/DSIM register access */
+	struct mutex iova_lock;		/* protects iova_list */
+	struct list_head iova_list;
+	unsigned long disp_pll_rate;
+	bool use_iommu;
+	bool display_on;
+	bool dsim_on;
+	bool panel_powered;
+	bool modeset_init;
+	bool vblank_init;
+	int irq;
+	u32 vblank_count;
+
+	/* DRM objects, one of each: the SoC has a single display pipe. */
+	struct drm_crtc crtc;
+	struct drm_encoder encoder;
+	struct drm_connector connector;
+	struct drm_plane plane;
+	struct drm_fbdev_cma *fbdev;
+};
