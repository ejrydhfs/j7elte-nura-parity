#!/bin/sh

post_install() {
	# bcmdhd needs the directory before it can persist a generated MAC.
	mkdir -p /efs/wifi 2>/dev/null || true

	if [ -d /etc/runlevels ] && command -v rc-update >/dev/null 2>&1; then
		rc-update add j7elte-wifi default >/dev/null 2>&1 || true
	fi
}

pre_deinstall() {
	if [ -d /etc/runlevels ] && command -v rc-update >/dev/null 2>&1; then
		rc-update del j7elte-wifi default >/dev/null 2>&1 || true
	fi
}
