+void *
+pan_fbddbg_remap(struct panfrost_bo *bo)
+{
+        struct drm_panfrost_mmap_bo m = { .handle = bo->gem_handle };
+        void *p;
+        if (drmIoctl(bo->dev->fd, DRM_IOCTL_PANFROST_MMAP_BO, &m))
+                return MAP_FAILED;
+        p = os_mmap(NULL, bo->size, PROT_READ | PROT_WRITE, MAP_SHARED,
+                    bo->dev->fd, m.offset);
+        return p;
+}
+uint32_t
+pan_fbddbg_kread(struct panfrost_device *dev, int handle, unsigned off)
+{
+        struct pan_fbddbg_read r = { .handle = (uint32_t) handle, .offset = off };
+        if (ioctl(dev->fd, PAN_FBDDBG_IOC, &r))
+                return 0xdeadbeefu;
+        return r.value;
+}
