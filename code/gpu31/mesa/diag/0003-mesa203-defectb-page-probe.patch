 #include <stdlib.h>
 #include <unistd.h>
 #include <string.h>
+#include <stdint.h>
+#include <fcntl.h>
 #include "pan_bo.h"
+
+/* FBDDBG (defectb): print the physical identity and kernel page flags of
+ * the user-mapped shader page at a given instant. Needs root (pagemap,
+ * kpageflags, kpagecount are root-only); silently no-ops otherwise. */
+static void
+pan_fbddbg_page_probe(const char *where, void *p)
+{
+        if (!getenv("PAN_FBD_PAGE_PROBE") || !p)
+                return;
+
+        uint64_t va = (uintptr_t) p;
+        uint64_t entry = 0, flags = 0, count = 0;
+        uint64_t pfn;
+        int fd;
+
+        fd = open("/proc/self/pagemap", O_RDONLY);
+        if (fd < 0)
+                return;
+        if (pread(fd, &entry, 8, (off_t) ((va >> 12) * 8)) != 8)
+                entry = 0;
+        close(fd);
+        pfn = entry & ((1ULL << 55) - 1);
+
+        fd = open("/proc/kpageflags", O_RDONLY);
+        if (fd >= 0) {
+                if (pread(fd, &flags, 8, (off_t) (pfn * 8)) != 8)
+                        flags = 0;
+                close(fd);
+        }
+        fd = open("/proc/kpagecount", O_RDONLY);
+        if (fd >= 0) {
+                if (pread(fd, &count, 8, (off_t) (pfn * 8)) != 8)
+                        count = 0;
+                close(fd);
+        }
+
+        fprintf(stderr, "FBDDBG PAGEPROBE %s: va=0x%llx pfn=0x%llx "
+                "present=%u kcount=%llu kflags=0x%llx w0=%08x w256=%08x\n",
+                where, (unsigned long long) va, (unsigned long long) pfn,
+                (unsigned) (entry >> 63), (unsigned long long) count,
+                (unsigned long long) flags,
+                ((uint32_t *) p)[0],
+                ((uint32_t *) p)[256]);
+
+        /* Same line into ftrace, so page free/alloc events can be ordered
+         * against the probe without guessing timestamps. */
+        fd = open("/sys/kernel/debug/tracing/trace_marker", O_WRONLY);
+        if (fd >= 0) {
+                char line[160];
+                int n = snprintf(line, sizeof(line),
+                        "FBDDBG %s pfn=0x%llx kcount=%llu kflags=0x%llx w0=%08x",
+                        where, (unsigned long long) pfn,
+                        (unsigned long long) count, (unsigned long long) flags,
+                        ((uint32_t *) p)[0]);
+                if (n > 0)
+                        (void) write(fd, line, (size_t) n);
+                close(fd);
+        }
+}
