+/* FBDDBG (defectb): one line into the ftrace ring so BO create/mmap/free
+ * can be interleaved with kmem/filemap page events (root only; no-op
+ * otherwise). */
+static void
+pan_fbddbg_marker(const char *what, unsigned long long gpu, int h, size_t size)
+{
+        int fd = open("/sys/kernel/debug/tracing/trace_marker", O_WRONLY);
+        char line[128];
+        int n;
+
+        if (fd < 0)
+                return;
+        n = snprintf(line, sizeof(line), "FBDDBG %s gpu=0x%llx h=%d size=%zu",
+                     what, gpu, h, size);
+        if (n > 0)
+                (void) write(fd, line, (size_t) n);
+        close(fd);
+}
