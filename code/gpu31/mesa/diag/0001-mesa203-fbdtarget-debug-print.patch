+static bool
+pan_fbddbg_read(struct pan_pool *pool, mali_ptr addr, unsigned words,
+                uint32_t *out)
+{
+        for (unsigned i = 0; i < panfrost_pool_num_bos(pool); i++) {
+                struct panfrost_bo *b =
+                        *util_dynarray_element(&pool->bos, struct panfrost_bo *, i);
+
+                if (b && b->ptr.cpu && addr >= b->ptr.gpu &&
+                    addr + words * 4 <= b->ptr.gpu + b->size) {
+                        memcpy(out, (char *)b->ptr.cpu + (addr - b->ptr.gpu),
+                               words * 4);
+                        return true;
+                }
+        }
+
+        fprintf(stderr, "FBDDBG chain addr=0x%llx: no pool BO\n",
+                (unsigned long long)addr);
+        return false;
+}
+
+static bool
+pan_fbddbg_read_batch(struct panfrost_batch *batch, mali_ptr addr,
+                      unsigned words, uint32_t *out)
+{
+        struct hash_entry *entry;
+
+        if (!addr)
+                return false;
+
+        hash_table_foreach(batch->bos, entry) {
+                struct panfrost_bo *b = (struct panfrost_bo *)entry->key;
+
+                if (b && b->ptr.cpu && addr >= b->ptr.gpu &&
+                    addr + words * 4 <= b->ptr.gpu + b->size) {
+                        memcpy(out, (char *)b->ptr.cpu + (addr - b->ptr.gpu),
+                               words * 4);
+                        return true;
+                }
+        }
+
+        if (pan_fbddbg_read(&batch->invisible_pool, addr, words, out))
+                return true;
+
+        fprintf(stderr, "FBDDBG batch-read addr=0x%llx: not in batch->bos\n",
+                (unsigned long long)addr);
+        return false;
+}
+
+static void
+pan_fbddbg_dump_bo(struct panfrost_bo *bo, unsigned off, unsigned words,
+                   const char *tag)
+{
+        uint32_t *p;
+
+        if (!bo || !bo->ptr.cpu || off + words * 4 > bo->size) {
+                fprintf(stderr, "FBDDBG %s bo=%p: not mmapped/short\n",
+                        tag, (void *)bo);
+                return;
+        }
+
+        p = (uint32_t *)((char *)bo->ptr.cpu + off);
+        fprintf(stderr, "FBDDBG %s bo=0x%llx gpu=0x%llx off=%u:",
+                tag, (unsigned long long)bo->ptr.gpu,
+                (unsigned long long)(bo->ptr.gpu + off), off);
+        for (unsigned w = 0; w < words; w++)
+                fprintf(stderr, " %08x", p[w]);
+        fprintf(stderr, "\n");
+}
