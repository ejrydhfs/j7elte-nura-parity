+                                (unsigned long long)b->ptr.gpu,
+                                pan_fbddbg_seen[i][0], pan_fbddbg_seen[i][1],
+                                now[0], now[1]);
+                        memcpy(pan_fbddbg_seen[i], now, 16);
+                }
+        }
