+/* FBDDBG (isadump): capture the exact BO bytes and the packed renderer-state
+ * descriptor that a live submit will consume, for offline Midgard
+ * disassembly.  Env-gated; no effect when PAN_FBD_ISADUMP is unset. */
+
+static void
+pan_fbddbg_dump_file(const char *path, const void *p, size_t n)
+{
+        int fd;
+
+        if (!getenv("PAN_FBD_ISADUMP") || !p || !n)
+                return;
+
+        fd = open(path, O_WRONLY | O_CREAT | O_TRUNC, 0644);
+        if (fd < 0)
+                return;
+
+        (void) write(fd, p, n);
+        close(fd);
+}
+
+static void
+pan_fbddbg_isadump(const char *stage, const char *tag, uint64_t shader,
+                   const struct panfrost_bo *bo, const void *meta,
+                   size_t meta_size)
+{
+        char path[64], text[1024];
+        unsigned nz = 0, n, i, len = 0;
+        uint32_t *w;
+
+        if (!getenv("PAN_FBD_ISADUMP") || !bo || !bo->ptr.cpu)
+                return;
+
+        w = bo->ptr.cpu;
+        n = bo->size / 4;
+        if (n > 24)
+                n = 24;
+
+        for (i = 0; i < n; i++)
+                nz += !!(w[i] & ~0xFu);
+
+        len += snprintf(text + len, sizeof(text) - len,
+                        "stage=%s tag=%s shader=0x%llx first_tag=%u "
+                        "bo=0x%llx size=%zu nonzero=%u/24 isa=",
+                        stage, tag, (unsigned long long) shader,
+                        (unsigned) (shader & 0xF),
+                        (unsigned long long) bo->ptr.gpu, bo->size, nz);
+        for (i = 0; i < n && len + 16 < sizeof(text); i++)
+                len += snprintf(text + len, sizeof(text) - len, " %08x", w[i]);
+        len += snprintf(text + len, sizeof(text) - len, "\n");
+
+        snprintf(path, sizeof(path), "/tmp/isadump-%s-isa.bin", tag);
+        pan_fbddbg_dump_file(path, bo->ptr.cpu, n * 4);
+
+        if (meta && meta_size) {
+                snprintf(path, sizeof(path), "/tmp/isadump-%s-meta.bin", tag);
+                pan_fbddbg_dump_file(path, meta, meta_size);
+        }
+
+        snprintf(path, sizeof(path), "/tmp/isadump-%s.txt", tag);
+        pan_fbddbg_dump_file(path, text, strlen(text));
+}
