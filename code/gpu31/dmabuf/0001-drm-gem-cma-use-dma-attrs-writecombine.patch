From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: t <t@t>
Date: Thu, 19 Nov 2026 00:00:00 -0500
Subject: [PATCH 1/3] drm/gem_cma: use dma_attrs WRITE_COMBINE on arm64

On arm64 this tree provides only the attribute-based DMA API
(arch/arm64/include/asm/dma-mapping.h:97-123:
dma_alloc_attrs/dma_free_attrs on get_dma_ops(dev)->alloc/free,
dma_alloc_coherent/free_coherent as NULL-attrs macros at :94-95).
The dma_{alloc,free}_writecombine() wrappers are 32-bit ARM only:
no definition exists under arch/arm64 or include/ (only a stray
comment in arch/arm64/mach-exynos/memory_compressor.c:491), so
drivers/gpu/drm/drm_gem_cma_helper.c cannot link there as written.
DMA_ATTR_WRITE_COMBINE is declared in include/linux/dma-attrs.h:16
and honoured by arm64 __get_dma_pgprot (arch/arm64/mm/dma-mapping.c:
40-41 -> pgprot_writecombine -> MT_NORMAL_NC, non-cacheable).

Mirror the adaptation already proven in
patches/drm/0001-drm-exynos7580-decon-dsim-kms.patch (CMA helper
hunk): allocate/free through DEFINE_DMA_ATTRS + WRITE_COMBINE.
This is the same patch content for the in-tree helper; kept as a
standalone file here so the integrator can apply it once whether or
not the display series is in the tree. If both are applied, the
second application is a no-op context match -- apply only once.

Slice contract: shared tree never edited; integrator applies.

---
 drivers/gpu/drm/drm_gem_cma_helper.c | 15 ++++++++++++---
 1 file changed, 12 insertions(+), 3 deletions(-)

diff --git a/drivers/gpu/drm/drm_gem_cma_helper.c b/drivers/gpu/drm/drm_gem_cma_helper.c
--- a/drivers/gpu/drm/drm_gem_cma_helper.c
+++ b/drivers/gpu/drm/drm_gem_cma_helper.c
@@ -35,8 +35,15 @@ static unsigned int get_gem_mmap_offset(struct drm_gem_object *obj)
 static void drm_gem_cma_buf_destroy(struct drm_device *drm,
 		struct drm_gem_cma_object *cma_obj)
 {
-	dma_free_writecombine(drm->dev, cma_obj->base.size, cma_obj->vaddr,
-			cma_obj->paddr);
+	/*
+	 * arm64 (this tree) only provides the attribute based DMA API, the
+	 * dma_{alloc,free}_writecombine() wrappers are 32 bit ARM only.
+	 */
+	DEFINE_DMA_ATTRS(attrs);
+
+	dma_set_attr(DMA_ATTR_WRITE_COMBINE, &attrs);
+	dma_free_attrs(drm->dev, cma_obj->base.size, cma_obj->vaddr,
+			cma_obj->paddr, &attrs);
 }
 
 /*
@@ -50,6 +57,7 @@ struct drm_gem_cma_object *drm_gem_cma_create(struct drm_device *drm,
 {
 	struct drm_gem_cma_object *cma_obj;
 	struct drm_gem_object *gem_obj;
+	DEFINE_DMA_ATTRS(attrs);
 	int ret;
 
 	size = round_up(size, PAGE_SIZE);
@@ -58,8 +66,9 @@ struct drm_gem_cma_object *drm_gem_cma_create(struct drm_device *drm,
 	if (!cma_obj)
 		return ERR_PTR(-ENOMEM);
 
-	cma_obj->vaddr = dma_alloc_writecombine(drm->dev, size,
-			&cma_obj->paddr, GFP_KERNEL | __GFP_NOWARN);
+	dma_set_attr(DMA_ATTR_WRITE_COMBINE, &attrs);
+	cma_obj->vaddr = dma_alloc_attrs(drm->dev, size, &cma_obj->paddr,
+			GFP_KERNEL | __GFP_NOWARN, &attrs);
 	if (!cma_obj->vaddr) {
 		dev_err(drm->dev, "failed to allocate buffer with size %d\n", size);
 		ret = -ENOMEM;
-- 
