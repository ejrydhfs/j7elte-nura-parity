diff -u '--exclude=.git' -Naur a/drivers/gpu/drm/panfrost/panfrost7580_drv.h b/drivers/gpu/drm/panfrost/panfrost7580_drv.h
--- a/drivers/gpu/drm/panfrost/panfrost7580_drv.h	1969-12-31 19:00:00.000000000 -0500
+++ b/drivers/gpu/drm/panfrost/panfrost7580_drv.h	2026-11-21 00:00:00.000000000 -0500
@@ -0,0 +1,126 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * panfrost7580_drv.h - shared device/file state for the panfrost7580
+ * render-only platform driver (Exynos 7580 / Mali-T720, j7elte).
+ *
+ * Stock DT node (never edited): mali@0x11400000, "arm,mali",
+ * reg 0x11400000/0x5000, IRQs index order 0/1/2 = job/mmu/gpu
+ * (SPI 282/283/281), 6 clocks, power-domain <&pd_g3d> (0x60).
+ *
+ * Layout contracts (both required by the reused slice code):
+ *  - struct p7580_drv starts with struct p7580_dev gd, so the GEM
+ *    helpers (which take dev->dev_private as struct p7580_dev *)
+ *    operate on our device state directly.
+ *  - struct p7580_drv_file starts with mgr/job_fctx/job_dev in the
+ *    same order as GEM's struct p7580_file_priv, so GEM's ioctl
+ *    helpers (CREATE_BO/MMAP_BO/WAIT_BO/GET_PARAM/GET_BO_OFFSET)
+ *    work unchanged on our file state.
+ */
+#ifndef PANFROST7580_DRV_H
+#define PANFROST7580_DRV_H
+
+#include <linux/atomic.h>
+#include <linux/mutex.h>
+#include <linux/list.h>
+#include <drm_syncobj.h>		/* 0003 */
+#include <drm_sched.h>			/* 0004 */
+#include "panfrost7580_gem.h"
+#include "panfrost7580_job.h"
+#include "panfrost7580_mmu.h"
+#include "panfrost7580_power.h"
+#include "pf7580_devfreq.h"
+
+/* One GPU address space on this part (all slots share it). */
+#define P7580_DRV_AS_NR		0u
+
+/* Bound-BO record: one per BO mapped into the context tables, so the
+ * remove/unload path can unmap + invalidate before tearing down. */
+struct p7580_drv_bo {
+	struct list_head node;
+	struct drm_gem_object *obj;	/* referenced while bound */
+	/* gpu31-iova: IOVA + size of the live mapping (for the
+	 * overlap detector + fault-time identity; stable while the
+	 * entry is linked under bo_lock). */
+	uint64_t iova;
+	size_t size;
+};
+
+struct p7580_drv {
+	/* MUST be first: GEM uses dev->dev_private as struct p7580_dev *. */
+	struct p7580_dev gd;
+	struct device *dev;
+	void __iomem *regs;
+	int irq_job;
+	int irq_mmu;
+	int irq_gpu;
+	struct p7580_job_dev jd;	/* job slots */
+	struct p7580_mmu mmu;		/* GPU page tables */
+	struct pf7580_power *power;	/* clocks/regulator/PM */
+	struct pf7580_dvfs *dvfs;	/* devfreq (may be NULL) */
+	struct mutex bo_lock;		/* serialises bo_list */
+	struct list_head bo_list;
+	atomic_t pm_ref;		/* live-job runtime-PM refs (see submit.c) */
+};
+
+/* Per-file state. Leading layout mirrors GEM's struct p7580_file_priv
+ * (mgr, job_fctx, job_dev) so GEM's ioctl helpers work unchanged. */
+struct p7580_drv_file {
+	struct drm_syncobj_manager mgr;	/* == p7580_file_priv.mgr */
+	struct p7580_file_ctx *job_fctx;	/* == p7580_file_priv.job_fctx */
+	struct p7580_job_dev *job_dev;	/* == p7580_file_priv.job_dev */
+	struct p7580_drv *drv;
+	struct drm_sched_entity entity[P7580_NUM_JOB_SLOTS];
+	uint32_t next_seqno;
+	int entities_live;
+};
+
+struct p7580_submit;
+struct drm_file;
+struct drm_device;
+
+/* submit.c entry points. */
+int p7580_drv_sched_ensure(void);
+int p7580_drv_file_init(struct p7580_drv_file *df, struct p7580_drv *drv);
+void p7580_drv_file_fini(struct p7580_drv_file *df);
+
+/* Full SUBMIT dispatch (submit.c): staged kernel-memory args. */
+int p7580_drv_submit(struct p7580_drv *drv, struct drm_device *dev,
+		     struct drm_file *file_priv,
+		     const struct p7580_submit *args);
+
+/* Power-guard helpers (submit.c). p7580_drv_pm_get takes one
+ * runtime-PM ref for MMU/register access and fails closed (no MMIO
+ * after a failed get); p7580_drv_pm_put drops it. Live-job refs:
+ * armed at queue time, released in free_job, so the block cannot
+ * autosuspend between the ioctl and the async run_job worker. */
+int p7580_drv_pm_get(struct p7580_drv *drv);
+void p7580_drv_pm_put(struct p7580_drv *drv);
+
+/* MMU/GPU IRQ demux (main.c). */
+irqreturn_t p7580_drv_mmu_irq(int irq, void *arg);
+irqreturn_t p7580_drv_gpu_irq(int irq, void *arg);
+
+/* Teardown guards (submit.c: PM-held wrappers around MMIO teardown).
+ * postclose/remove MUST NOT touch the AS block / slot mask dark. */
+int p7580_drv_teardown_hold(struct p7580_drv *drv);
+void p7580_drv_teardown_release(struct p7580_drv *drv);
+/* Unmap + invalidate one BO's IOVA range (MMU-table writes are
+ * CPU-side and safe dark; the invalidate MMIO needs power). */
+int p7580_drv_unmap_bo(struct p7580_drv *drv, struct drm_gem_object *obj,
+		       int invalidate);
+/* gpu31-iova: free-time GPU unmap (submit.c; called from GEM free
+ * BEFORE iova_free). Clears leaf PTEs + PM-held TLB invalidate +
+ * bo_list unlink + DMA unbind. */
+void p7580_gem_gpu_unmap(struct drm_gem_object *obj);
+/* gpu31-iova: register the map/unmap trace budget with the jobs
+ * slice iova_arm knob (submit.c; called at probe/remove). */
+void p7580_drv_register_iova_trace(unsigned int *budget);
+/* gpu31-iova: fault-time mapping resolver + trace budget shared
+ * with main.c probe (defined in submit.c; non-static for the TU
+ * boundary). */
+int p7580_drv_iova_resolve(void *priv, char *buf, size_t len,
+			   const uint32_t *handles, const uint64_t *addrs,
+			   const uint32_t *sizes, uint32_t n);
+extern unsigned int p7580_iova_trace;
+
+#endif /* PANFROST7580_DRV_H */
diff -u '--exclude=.git' -Naur a/drivers/gpu/drm/panfrost/panfrost7580_gem.c b/drivers/gpu/drm/panfrost/panfrost7580_gem.c
--- a/drivers/gpu/drm/panfrost/panfrost7580_gem.c	1969-12-31 19:00:00.000000000 -0500
+++ b/drivers/gpu/drm/panfrost/panfrost7580_gem.c	2026-11-21 00:00:00.000000000 -0500
@@ -0,0 +1,1295 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * panfrost7580_gem.c - BO alloc/import/export/mmap for the T720 port.
+ *
+ * v5.2 reference: panfrost_gem.c (96 LOC): CREATE via drm_gem_shmem_create,
+ * MMAP via drm_gem_mmap + drm_gem_shmem_mmap, WAIT via dma_resv_wait_timeout,
+ * GET_PARAM/GET_BO_OFFSET trivially. Adapted to 3.10:
+ *
+ *  - drm_gem_shmem_* does not exist: SHMEM path mirrors drm_gem_object_init's
+ *    own shmem_file_setup + shmem_read_mapping_page per page (mm/shmem.c).
+ *    CREATE_BO allocates SHMEM (general BOs carry no contiguity
+ *    requirement, so Mesa's 16 MiB tiler heap succeeds where CMA/swiotlb
+ *    fails ENOMEM). The CMA path (drm_gem_object_init + dma_alloc_attrs
+ *    WRITE_COMBINE + drm_gem_create_mmap_offset, exynos/drm_gem_cma shape)
+ *    is retained for WC scanout sharing only, never CREATE_BO. CMA uses
+ *    plain WRITE_COMBINE only (arm64 dma-mapping honours exactly this
+ *    attr; NO_KERNEL_MAPPING is ignored by the arm64 backend and
+ *    FORCE_CONTIGUOUS is a display-side mistaken carry-over, so neither
+ *    is set here).
+ *  - CPU mmap is IMMEDIATE (exynos_drm_gem_mmap_buffer /
+ *    drm_gem_cma_mmap shape): pgprot_writecombine + dma_mmap_attrs
+ *    for CMA (plain WRITE_COMBINE only), remap_pfn_range per page
+ *    for SHMEM/imported. Fault-driven vm_insert_mixed cannot work:
+ *    drm_gem_mmap() sets VM_PFNMAP and installs driver->gem_vm_ops
+ *    itself (EINVAL when that table is NULL); clearing PFNMAP for
+ *    VM_MIXEDMAP + swapping in a second ops table breaks the core
+ *    contract (mmap -EINVAL, never faults). The fault helper stays
+ *    for reference only. WC/cached prot selection is exynos
+ *    update_vm_cache_attr shape.
+ *  - WAIT_BO mirrors v5.2 panfrost_wait_bo: dma_resv_wait_timeout on the
+ *    embedded 0002 resv (locked inside the shim; no outer lock needed).
+ *    Timeout arrives in jiffies (caller converts ns via nsecs_to_jiffies).
+ *  - PRIME export mirrors 3.10 drm_gem_map_dma_buf (drm_prime.c:67-82):
+ *    get_sg_table + dma_map_sg; the dma_buf_ops are the stock
+ *    drm_gem_prime_dmabuf_ops via drm_gem_prime_export. Import mirrors
+ *    drm_gem_prime_import (attach + map + import_sg_table) but keeps
+ *    ATTACHMENT-BACKED sharing (review F1 on the display patch:
+ *    never import-by-copy). import_sg_table builds a SHMEM-backed BO
+ *    whose sgt IS the live exporter attachment mapping (drm_prime.c:500
+ *    passes exactly this pointer in); free tears it down with
+ *    drm_prime_gem_destroy (unmap + detach + put). vmap holds one GEM
+ *    object reference per live CPU mapping (review F2), released in
+ *    vunmap; the NULL check there rejects foreign pointers.
+ *  - The driver-private IOVA allocator is a per-device drm_mm owned by
+ *    struct p7580_dev (header): create/fini init/takedown it, and alloc
+ *    inserts each BO's embedded drm_mm_node (free removes the node, so
+ *    the range is really returned). Ranges are PAGE_SHIFT units like
+ *    every 3.10 drm_mm caller (drm_gem.c, ttm_bo.c).
+ *
+ * SHIM-CALLSITES are marked 0001/0002 (fence/resv). 0003/0004 (syncobj/
+ * sched) belong to the jobs slice; this file only exposes the embedded
+ * resv for SUBMIT to lock. <drm/drm.h> (not "drm.h") resolves through
+ * -I include/uapi like the rest of the tree.
+ */
+
+#include <linux/device.h>
+#include <linux/dma-mapping.h>
+#include <linux/dma-attrs.h>
+#include <linux/dma-buf.h>
+#include <linux/highmem.h>
+#include <linux/jiffies.h>
+#include <linux/mm.h>
+#include <linux/mutex.h>
+#include <linux/scatterlist.h>
+#include <linux/shmem_fs.h>
+#include <linux/vmalloc.h>
+#include <linux/sched.h>
+#include <asm/cacheflush.h>	/* __dma_{map,unmap}_area for COHERENCY_NONE */
+
+
+#include <drm/drmP.h>
+#include <drm/drm.h>
+
+#include <linux/dma-fence.h>		/* 0001 */
+#include <linux/dma-resv.h>		/* 0002 */
+
+#include "panfrost7580_gem.h"
+
+struct p7580_bo *to_p7580_bo(struct drm_gem_object *obj)
+{
+	return container_of(obj, struct p7580_bo, base);
+}
+
+/* ------------------------------------------------------------------ */
+/* COHERENCY_NONE data sync (the model: who maintains which alias).   */
+/*                                                                     */
+/* This SoC is COHERENCY_NONE (kbase forces system_coherency NONE; no  */
+/* ACE; DT has no system-coherency property). The GPU reads/writes     */
+/* DRAM directly through its own MMU; the CPU reaches the same         */
+/* physical pages through two aliases the architecture does NOT keep   */
+/* coherent for us:                                                    */
+/*                                                                     */
+/*  (a) kernel linear map (page_address / kmap): d-cacheable. Every    */
+/*      CPU touch installs lines here.                                 */
+/*  (b) userspace WC mmap (MT_NORMAL_NC, pgprot_writecombine): never   */
+/*      cached, so no alias lines — but writes may sit in the store    */
+/*      buffer/combining buffer until drained.                         */
+/*  (c) the GPU port: reads/writes DRAM, bypassing the CPU caches.     */
+/*                                                                     */
+/* Correct discipline is the stock non-coherent DMA-API order, per     */
+/* page, with the device pointer carried so the backend can pick the   */
+/* swiotlb vs direct path (arm64 3.10: non-coherent swiotlb ops;       */
+/* dma_map == cache maintenance):                                     */
+/*                                                                     */
+/*  - SUBMIT (CPU -> GPU): CPU writes the descriptor/payloads into     */
+/*    (a)/(b), then dma_sync_single_for_device(dev, dma, PAGE_SIZE,    */
+/*    DMA_BIDIRECTIONAL) drains CPU lines to the point the GPU reads   */
+/*    (PoC/RAM). The GPU PTW tables already follow this                */
+/*    (p7580_sync_pt: sync after every table write).                   */
+/*  - COMPLETION (GPU -> CPU): BEFORE the job fence signals,           */
+/*    dma_sync_single_for_cpu(dev, dma, PAGE_SIZE,                     */
+/*    DMA_BIDIRECTIONAL) invalidates CPU lines for the range the GPU  */
+/*    wrote, so a userspace wait returning implies visible data and   */
+/*    the next CPU read (kmap/vmap/mmap fault) misses to DRAM and     */
+/*    observes GPU bytes. gpu31-coherency-race: the old order ran the  */
+/*    invalidate after the signal (free_job) and was racy.            */
+/*                                                                     */
+/* Why not flush_dcache_page(): on arm64 it only clears PG_dcache_clean  */
+/* (flush.c: flush_dcache_page is a flag clear for the icache-alias    */
+/* case), i.e. a no-op for GPU-written data, and there is no HIGHMEM   */
+/* on arm64 to make the old PageHighMem gate meaningful. The correct   */
+/* primitive is the DMA sync (equivalently __dma_unmap_area, which is  */
+/* exactly what the arm64 sync_single_for_cpu backend calls before the */
+/* swiotlb sync: dma-mapping.c __swiotlb_sync_single_for_cpu ->        */
+/* __dma_unmap_area(phys_to_virt(dma_to_phys(dev, dma)), size, dir) +  */
+/* swiotlb_sync_single_for_cpu).                                       */
+/*                                                                     */
+/* Lifetime: pages are SHMEM-owned (shmem_read_mapping_page refs are   */
+/* the pin; the private filp is never exposed so ftruncate cannot drop */
+/* them). A BO additionally holds one bind-time DMA mapping covering   */
+/* its pages while GPU-bound (built at bind, torn down at unbind,      */
+/* DMA_BIDIRECTIONAL so the same mapping serves job upload and         */
+/* writeback; SKIP_CPU_SYNC is never set). sync_for_device runs at     */
+/* SUBMIT (before the job is queued) and sync_for_cpu runs BEFORE the   */
+/* fence signals (pre-signal helper in IRQ/timedout/recover context,   */
+/* plus a belt-and-braces repeat in free_job: no MMIO, no sleeps,      */
+/* no locks — same constraints as the old hook). dma_addr per page is  */
+/* cached in the BO (identity on this tree is asserted, not assumed:   */
+/* a non-identity dma_addr is carried verbatim, so sync still hits the */
+/* right bus address; PTEs must come from p7580_bo_dma_addr, never     */
+/* from page_to_phys directly).                                        */
+/* ------------------------------------------------------------------ */
+/* Pre-signal completion invalidate (gpu31-coherency-race): walk the
+ * job's owned BO pointers and run p7580_gem_job_done_sync on each
+ * (dma_sync_single_for_cpu per bound SHMEM page; CMA/imported and
+ * never-bound BOs no-op inside). The caller holds one ref per
+ * pointer (SUBMIT transfers the lookup refs onto job->bos), so the
+ * objects cannot vanish mid-walk; this helper takes no refs and
+ * drops none.
+ *
+ * Context contract: safe wherever dma_sync_single_for_cpu is safe.
+ * That path is cache maintenance plus a cheap swiotlb identity
+ * check: on this tree __swiotlb_sync_single_for_cpu is
+ * __dma_unmap_area (dcache-line dc ops + dsb, no locks, no MMIO,
+ * no sleeps, no allocations) followed by swiotlb_sync_single_for_cpu
+ * (direct-DRAM fast path: identity mapping -> dma_mark_clean only;
+ * the spinlocked bounce-copy leg runs only for real swiotlb bounce
+ * buffers, which streaming dma_map_page never produces here).
+ * dma-debug is compiled out on the j7elte defconfig
+ * (# CONFIG_DMA_API_DEBUG is not set), so debug_dma_sync_* is a
+ * global_disable-gated no-op. Safe under IRQ-off spinlock and inside
+ * dma_fence callbacks.
+ *
+ * Why locked-region / fence-callback safe: the BO list (job->bos,
+ * bo_count) is private to the retiring job, the per-BO dma_addrs /
+ * sync_dev are stable while GPU-bound (set at bind, cleared only at
+ * unbind/free, both ordered after fence retirement), and the walk
+ * touches no scheduler/resv/syncobj state. A NULL entry is skipped;
+ * NULL job/bos is a no-op. */
+void p7580_gem_job_bos_pre_signal_sync(void **bos, unsigned int bo_count)
+{
+	unsigned int i;
+
+	if (!bos || !bo_count)
+		return;
+	for (i = 0; i < bo_count; i++) {
+		struct drm_gem_object *obj =
+			(struct drm_gem_object *)bos[i];
+
+		if (!obj)
+			continue;
+		p7580_gem_job_done_sync(obj);
+	}
+}
+
+void p7580_gem_job_done_sync(struct drm_gem_object *obj)
+{
+	struct p7580_bo *bo = to_p7580_bo(obj);
+	unsigned int i;
+
+	/* CMA (dma_alloc_attrs coherent) never needs CPU-side sync. */
+	if (bo->backing != P7580_BO_SHMEM || !bo->pages)
+		return;
+	if (!bo->sync_dev || !bo->dma_addrs)
+		return;
+	for (i = 0; i < bo->nr_pages; i++) {
+		if (!bo->pages[i])
+			continue;
+		dma_sync_single_for_cpu(bo->sync_dev, bo->dma_addrs[i],
+					PAGE_SIZE, DMA_BIDIRECTIONAL);
+	}
+}
+/* DEBUG-ONLY (gpu31-gpuwrite, strip before cutover): kernel-side word
+ * readback. Guardrail: reuse the completion maintenance -- call
+ * p7580_gem_job_done_sync first (same invalidate the pre-signal IRQ
+ * path runs; dma_sync_single_for_cpu per bound SHMEM page), then read
+ * one u32 via the kernel linear map (kmap_atomic single-arg on this
+ * !HIGHMEM arm64 tree). Never-bound CMA/imported follow
+ * job_done_sync's no-op rules; unmapped pages fail ENOENT. No MMIO,
+ * no sleeps, no locks. */
+int p7580_gem_debug_read_word(struct drm_gem_object *obj, uint32_t offset,
+			      uint32_t *out)
+{
+	struct p7580_bo *bo = to_p7580_bo(obj);
+	unsigned int idx;
+	struct page *pg;
+	void *kv;
+	uint32_t w;
+
+	if (!obj || !out)
+		return -EINVAL;
+	if (offset + sizeof(w) > obj->size)
+		return -EINVAL;
+	p7580_gem_job_done_sync(obj);
+	idx = offset >> PAGE_SHIFT;
+	if (idx >= bo->nr_pages || !bo->pages || !bo->pages[idx])
+		return -ENOENT;
+	pg = bo->pages[idx];
+	kv = kmap_atomic(pg);
+	w = *(uint32_t *)((char *)kv + (offset & (PAGE_SIZE - 1)));
+	kunmap_atomic(kv);
+	*out = w;
+	return 0;
+}
+
+/* Bind: dma_map the SHMEM pages for GPU access (before the AS0        */
+/* page-table walk). Idempotent: already-bound BOs return 0 without    */
+/* remapping. On non-identity trees the returned dma_addr is the bus   */
+/* address the GPU must use; callers MUST program PTEs from            */
+/* p7580_bo_dma_addr, never from page_to_phys. Maps                   */
+/* DMA_BIDIRECTIONAL (single mapping covers both directions; never     */
+/* SKIP_CPU_SYNC). Partial-failure unwind unmaps what was mapped. */
+int p7580_gem_dma_bind(struct drm_gem_object *obj, struct device *dev)
+{
+	struct p7580_bo *bo = to_p7580_bo(obj);
+	unsigned int i;
+
+	if (!dev || bo->backing != P7580_BO_SHMEM || !bo->pages)
+		return 0;
+	if (bo->dma_addrs)
+		return 0;
+	bo->dma_addrs = kcalloc(bo->nr_pages, sizeof(*bo->dma_addrs),
+				GFP_KERNEL);
+	if (!bo->dma_addrs)
+		return -ENOMEM;
+	for (i = 0; i < bo->nr_pages; i++) {
+		dma_addr_t d = dma_map_page(dev, bo->pages[i], 0, PAGE_SIZE,
+					    DMA_BIDIRECTIONAL);
+
+		if (dma_mapping_error(dev, d)) {
+			while (i--)
+				dma_unmap_page(dev, bo->dma_addrs[i],
+					       PAGE_SIZE, DMA_BIDIRECTIONAL);
+			kfree(bo->dma_addrs);
+			bo->dma_addrs = NULL;
+			return -ENOMEM;
+		}
+		bo->dma_addrs[i] = d;
+	}
+	bo->sync_dev = dev;
+	return 0;
+}
+
+/* SUBMIT-side drain: push CPU-written bytes to the point the GPU      */
+/* reads. Runs after the CPU fills descriptors/payloads and before    */
+/* the job is queued (fence not yet armed). Unbound BOs are a no-op.  */
+void p7580_gem_submit_sync(struct drm_gem_object *obj)
+{
+	struct p7580_bo *bo = to_p7580_bo(obj);
+	unsigned int i;
+
+	if (bo->backing != P7580_BO_SHMEM || !bo->pages || !bo->sync_dev ||
+	    !bo->dma_addrs)
+		return;
+	for (i = 0; i < bo->nr_pages; i++) {
+		if (!bo->pages[i])
+			continue;
+		dma_sync_single_for_device(bo->sync_dev, bo->dma_addrs[i],
+					   PAGE_SIZE, DMA_BIDIRECTIONAL);
+	}
+}
+
+/* gpu31-iova (stale-TLB lifetime fix): free-time GPU unmap.
+ * p7580_gem_free_object calls p7580_gem_gpu_unmap (driver snapshot,
+ * submit.c: PM-held TLB invalidate + bo_list unlink + ref drop)
+ * BEFORE iova_free returns the range and before pages are released.
+ * p7580_gem_mmu_register_notify is a link-compat no-op (an earlier
+ * draft registered a callback; the landed design links directly so
+ * GEM never dereferences driver state). */
+void p7580_gem_mmu_register_notify(void (*fn)(void *, struct drm_gem_object *,
+					      unsigned long, unsigned int),
+				   void *priv)
+{
+	(void)fn;
+	(void)priv;
+}
+
+/* Unbind: tear down the bind-time DMA mapping (MMU-unmap/teardown     */
+/* path, file-close, free). Safe on unbound BOs. */
+void p7580_gem_dma_unbind(struct drm_gem_object *obj)
+{
+	struct p7580_bo *bo = to_p7580_bo(obj);
+	unsigned int i;
+
+	if (!bo->dma_addrs || !bo->sync_dev)
+		return;
+	for (i = 0; i < bo->nr_pages; i++)
+		dma_unmap_page(bo->sync_dev, bo->dma_addrs[i], PAGE_SIZE,
+			       DMA_BIDIRECTIONAL);
+	kfree(bo->dma_addrs);
+	bo->dma_addrs = NULL;
+	bo->sync_dev = NULL;
+}
+
+/* DMA address for one BO page (bind-time mapping when present,        */
+/* page_to_phys fallback for the never-bound path). Callers program    */
+/* GPU PTEs from this, never from page_to_phys directly. */
+phys_addr_t p7580_bo_dma_addr(struct drm_gem_object *obj, unsigned int idx)
+{
+	struct p7580_bo *bo = to_p7580_bo(obj);
+
+	if (idx >= bo->nr_pages)
+		return 0;
+	if (bo->dma_addrs && bo->sync_dev)
+		return (phys_addr_t)bo->dma_addrs[idx];
+	if (bo->pages && bo->pages[idx])
+		return (phys_addr_t)page_to_phys(bo->pages[idx]);
+	return 0;
+}
+
+
+/* Per-device IOVA allocator (struct p7580_dev, header). Units: the
+ * drm_mm window is addressed in PAGES (init with the byte window
+ * shifted by PAGE_SHIFT; node .start is therefore a PFN and the byte
+ * GPU address is node.start << PAGE_SHIFT). Raw byte init would place
+ * every BO near 0x2000000000, past the 4 GiB window -- MMAP_BO via
+ * the GEM offset manager kept working, so open/CREATE/GET_BO all
+ * passed while only the GPU alias was wrong (gpu31-mmap.md).
+ * ------------------------------------------------------------------ */
+
+int p7580_dev_init(struct p7580_dev *gd, struct device *dev)
+{
+	int ret;
+
+	if (!gd || !dev)
+		return -EINVAL;
+	gd->dev = dev;
+	mutex_init(&gd->iova_lock);
+	ret = drm_mm_init(&gd->iova_mm, P7580_IOVA_START >> PAGE_SHIFT,
+			  P7580_IOVA_SIZE >> PAGE_SHIFT);
+	if (ret) {
+		gd->dev = NULL;
+		return ret;
+	}
+	return 0;
+}
+
+void p7580_dev_fini(struct p7580_dev *gd)
+{
+	if (!gd)
+		return;
+	drm_mm_takedown(&gd->iova_mm);
+	gd->dev = NULL;
+}
+
+static int p7580_iova_alloc(struct p7580_dev *gd, struct p7580_bo *bo)
+{
+	unsigned long npages = bo->base.size >> PAGE_SHIFT;
+	struct drm_mm_node *hole;
+
+	mutex_lock(&gd->iova_lock);
+	hole = drm_mm_search_free(&gd->iova_mm, npages, 0, false);
+	if (!hole) {
+		mutex_unlock(&gd->iova_lock);
+		return -ENOSPC;
+	}
+	/* Canonical 3.10 insert: the node is preallocated in the BO
+	 * (F-GEM2); drm_mm_insert_node links it and consumes the hole.
+	 * Mirrors drm_gem_create_mmap_offset's search/insert pair. */
+	memset(&bo->iova_node, 0, sizeof(bo->iova_node));
+	if (drm_mm_insert_node(&gd->iova_mm, &bo->iova_node, npages, 0)) {
+		mutex_unlock(&gd->iova_lock);
+		return -ENOSPC;
+	}
+	bo->iova = bo->iova_node.start << PAGE_SHIFT;
+	bo->iova_valid = 1;
+	mutex_unlock(&gd->iova_lock);
+	return 0;
+}
+
+static void p7580_iova_free(struct p7580_dev *gd, struct p7580_bo *bo)
+{
+	if (!bo->iova_valid)
+		return;
+	/* F-GEM2: remove the node so the range is really returned
+	 * (drm_mm_remove_node re-links the hole; plain remove is the
+	 * non-sleeping path, correct under the free hook's lock). */
+	mutex_lock(&gd->iova_lock);
+	drm_mm_remove_node(&bo->iova_node);
+	mutex_unlock(&gd->iova_lock);
+	bo->iova_valid = 0;
+}
+
+/* ------------------------------------------------------------------ */
+/* CMA backing                                                        */
+/* ------------------------------------------------------------------ */
+
+static int p7580_cma_alloc(struct drm_device *dev, struct p7580_bo *bo,
+			   size_t size)
+{
+	DEFINE_DMA_ATTRS(attrs);
+	void *vaddr;
+	dma_addr_t paddr;
+
+	size = round_up(size, PAGE_SIZE);
+	/* WRITE_COMBINE is the only attr the arm64 backend honours
+	 * (arch/arm64/mm/dma-mapping.c -> MT_NORMAL_NC). NO_KERNEL_MAPPING
+	 * would be silently ignored; FORCE_CONTIGUOUS belongs to a later
+	 * DMA API. Plain WC matches the display CMA delta (0001). */
+	dma_set_attr(DMA_ATTR_WRITE_COMBINE, &attrs);
+	vaddr = dma_alloc_attrs(dev->dev, size, &paddr, GFP_KERNEL, &attrs);
+	if (!vaddr)
+		return -ENOMEM;
+	bo->cma_vaddr = vaddr;
+	bo->cma_paddr = paddr;
+	return 0;
+}
+
+static void p7580_cma_free(struct drm_device *dev, struct p7580_bo *bo)
+{
+	DEFINE_DMA_ATTRS(attrs);
+
+	if (!bo->cma_vaddr)
+		return;
+	dma_set_attr(DMA_ATTR_WRITE_COMBINE, &attrs);
+	dma_free_attrs(dev->dev, bo->base.size, bo->cma_vaddr,
+		       bo->cma_paddr, &attrs);
+	bo->cma_vaddr = NULL;
+}
+
+/* ------------------------------------------------------------------ */
+/* SHMEM backing (private page array, no shmem helper in 3.10)        */
+/*                                                                     */
+/* Pages come from shmem_read_mapping_page: each returned page holds   */
+/* exactly one reference, and that reference IS the pin -- the free   */
+/* hook drops it with one put_page per page, and the private filp is  */
+/* never exposed to userspace so ftruncate cannot drop pages under    */
+/* us. No get_page, no sg, no dma_map lives in this file: GPU mapping */
+/* (phys -> IOVA) is the owning driver's map_bo step (p7580_drv_map_bo in */
+/* the driver snapshot; contract in the create comment below), which reads */
+/* p7580_bo_page_phys and programs the Mali LPAE tables, with dma_sync */
+/* maintenance for COHERENCY_NONE. */
+/* ------------------------------------------------------------------ */
+
+static int p7580_shmem_alloc(struct drm_device *dev, struct p7580_bo *bo,
+			     size_t size)
+{
+	unsigned int nr = size >> PAGE_SHIFT;
+	struct file *filp;
+	struct page **pages;
+	unsigned int i;
+
+	(void)dev;
+	filp = shmem_file_setup("drm mm object", size, VM_NORESERVE);
+	if (IS_ERR(filp))
+		return PTR_ERR(filp);
+
+	pages = kcalloc(nr, sizeof(*pages), GFP_KERNEL);
+	if (!pages) {
+		fput(filp);
+		return -ENOMEM;
+	}
+
+	for (i = 0; i < nr; i++) {
+		struct page *page = shmem_read_mapping_page(
+				filp->f_mapping, i);
+		if (IS_ERR(page)) {
+			int err = PTR_ERR(page);
+			while (i--)
+				put_page(pages[i]);
+			kfree(pages);
+			fput(filp);
+			return err;
+		}
+		pages[i] = page;
+	}
+
+	bo->shmem_filp = filp;
+	bo->pages = pages;
+	bo->nr_pages = nr;
+	return 0;
+}
+
+static void p7580_shmem_free(struct p7580_bo *bo)
+{
+	unsigned int i;
+
+	if (!bo->pages && !bo->shmem_filp)
+		return;
+	/* NOTE: sgt/import teardown is NOT here: imported BOs store the
+	 * live exporter mapping in bo->sgt and free handles it via
+	 * drm_prime_gem_destroy. Local SHMEM BOs never set bo->sgt. */
+	if (bo->pages) {
+		for (i = 0; i < bo->nr_pages; i++)
+			if (bo->pages[i])
+				put_page(bo->pages[i]);
+		kfree(bo->pages);
+		bo->pages = NULL;
+		bo->nr_pages = 0;
+	}
+	if (bo->shmem_filp) {
+		fput(bo->shmem_filp);
+		bo->shmem_filp = NULL;
+	}
+}
+
+/* ------------------------------------------------------------------ */
+/* Create / free                                                      */
+/* ------------------------------------------------------------------ */
+
+int p7580_gem_create(struct p7580_dev *gd, struct drm_device *dev,
+		     size_t size, unsigned int backing,
+		     unsigned int cache_attr, struct drm_gem_object **out)
+{
+	struct p7580_bo *bo;
+	int ret;
+
+	if (!gd || !dev || !size || !out)
+		return -EINVAL;
+	size = round_up(size, PAGE_SIZE);
+	/* No driver-side size cap: SHMEM pages come from the page cache,
+	 * so a 16 MiB tiler heap is 4096 ordinary pages, not one 16 MiB
+	 * dma_alloc_attrs call (which fails ENOMEM on this board: the
+	 * shipping defconfig reserves no CMA area, and 8+ MiB coherent
+	 * allocations fall through to swiotlb). Only the IOVA window
+	 * bounds the BO (P7580_IOVA_SIZE, ~4 GiB minus 32 MiB). CMA is
+	 * kept only for explicit WC scanout (create_with_handle);
+	 * CREATE_BO never selects it. */
+	if (backing != P7580_BO_CMA && backing != P7580_BO_SHMEM)
+		return -EINVAL;
+	bo = kzalloc(sizeof(*bo), GFP_KERNEL);
+	if (!bo)
+		return -ENOMEM;
+
+	bo->backing = backing;
+	bo->cache_attr = cache_attr;
+
+	if (backing == P7580_BO_CMA) {
+		ret = drm_gem_object_init(dev, &bo->base, size);
+		if (ret)
+			goto err_bo;
+		ret = p7580_cma_alloc(dev, bo, size);
+		if (ret)
+			goto err_obj;
+	} else {
+		ret = drm_gem_private_object_init(dev, &bo->base, size);
+		if (ret)
+			goto err_bo;
+		ret = p7580_shmem_alloc(dev, bo, size);
+		if (ret)
+			goto err_obj;
+		/* F-GEM4: no extra get_page() here. shmem_read_mapping_page
+		 * already returns each page with a reference held; that ref
+		 * IS the lifetime pin (paired with the single put_page()
+		 * per page in p7580_shmem_free). The private filp is never
+		 * exposed to userspace so ftruncate cannot drop pages
+		 * under us, and i915 (i915_gem.c:4322/4383) relies on the
+		 * same single-ref ownership. The old second pin leaked one
+		 * page per SHMEM page per BO after fput. */
+	}
+	dma_resv_init(&bo->resv);			/* 0002 */
+
+	ret = drm_gem_create_mmap_offset(&bo->base);
+	if (ret)
+		goto err_resv;
+
+	ret = p7580_iova_alloc(gd, bo);
+	if (ret)
+		goto err_offset;
+
+	*out = &bo->base;
+	return 0;
+
+err_offset:
+	drm_gem_free_mmap_offset(&bo->base);
+err_resv:
+	dma_resv_fini(&bo->resv);			/* 0002 */
+err_obj:
+	drm_gem_object_release(&bo->base);
+	if (backing == P7580_BO_CMA)
+		p7580_cma_free(dev, bo);
+	else
+		p7580_shmem_free(bo);
+err_bo:
+	kfree(bo);
+	return ret;
+}
+
+/* ------------------------------------------------------------------ */
+/* GPU page-table mapping hook (for DriverAssemble / jobs SUBMIT).    */
+/*                                                                    */
+/* GEM allocates an IOVA per BO at create/import but never programs   */
+/* the Mali page tables itself. The owning driver maps BOs into the   */
+/* per-context tables with this hook, then lets jobs SUBMIT pin each  */
+/* referenced BO (dma_resv lock discipline per the 0002 plain-mutex)  */
+/* before p7580_job_hw_submit reads the job descriptor. Unmap runs    */
+/* before free; the context teardown walker is p7580_mmu_teardown()   */
+/* (iommu/panfrost7580_mmu.h, F-MMU5), wired to file-close/remove.     */
+/*                                                                    */
+/* Contract (mirrors the review's `driver/` landing checklist;            */
+/* gpu31-coherency adds bind/submit-sync/completion-sync):                */
+/*  - bind: p7580_gem_dma_bind(obj, dev->dev) once before the first     */
+/*    map (dma_map_page per page, BIDIRECTIONAL, never SKIP_CPU_SYNC).  */
+/*  - map: for each page index 0..npages-1, p7580_mmu_map(mmu,          */
+/*    bo->iova + idx*PAGE_SIZE, p7580_bo_dma_addr(obj, idx),            */
+/*    P7580_PROT_RD|WR, memattr), where the addr is the bind-time bus   */
+/*    address (cma_paddr + idx*PAGE_SIZE for CMA; the sg walk for        */
+/*    imported; the dma_addrs cache — never page_to_phys — for SHMEM);  */
+/*    then p7580_mmu_invalidate(regs, as_nr, iova>>12, npages, sync=0)  */
+/*    (FLUSH_PT via the fixed F-MMU1 LOCK-region encoding) and          */
+/*    p7580_mmu_program_as(regs, as_nr, pgd_dma, memattr_lo/hi)         */
+/*    once per context (code/gpu31/iommu/panfrost7580_mmu.h, pf7580     */
+/*    lock/encode helpers in code/gpu31/mmu/pf7580_as.h).               */
+/*  - submit: p7580_gem_submit_sync(obj) per BO after the CPU fills     */
+/*    descriptors/payloads, before queueing.                            */
+/*  - completion: p7580_gem_job_bos_pre_signal_sync(bos, n) in the IRQ  */
+/*    handler before dma_fence_signal (and on the timedout/recover      */
+/*    paths before their signals), then p7580_gem_job_done_sync(obj)    */
+/*    per BO in free_job as the belt-and-braces ref-drop leg.          */
+/*  - unmap: p7580_mmu_unmap(mmu, bo->iova + idx*PAGE_SIZE) per page,   */
+/*    then invalidate the same range; p7580_gem_dma_unbind(obj); the    */
+/*    caller frees child tables with p7580_mmu_free_table after the    */
+/*    parent entry is cleared.                                          */
+/*  - locking: resv lock (0002) around pin/map, MMU-HW lock around    */
+/*    program/invalidate (pf7580_as_* takes it), reset_lock ordering  */
+/*    per job.c:28-34. Fault recovery signals done_fence (F-JOB4).    */
+/* Caller-visible helpers:                                            */
+
+/* Mapping-hook bodies: declared in the header, defined here (see the
+ * header contract for the DriverAssemble map/unmap sequence). */
+unsigned int p7580_bo_npages(struct drm_gem_object *obj)
+{
+	return to_p7580_bo(obj)->base.size >> PAGE_SHIFT;
+}
+
+phys_addr_t p7580_bo_page_phys(struct drm_gem_object *obj,
+			       unsigned int idx, int *ok);
+
+int p7580_gem_create_with_handle(struct p7580_dev *gd,
+				 struct drm_file *file_priv,
+				 struct drm_device *dev, size_t size,
+				 unsigned int backing,
+				 unsigned int cache_attr,
+				 uint32_t *handle)
+{
+	struct drm_gem_object *obj;
+	int ret;
+
+	ret = p7580_gem_create(gd, dev, size, backing, cache_attr, &obj);
+	if (ret)
+		return ret;
+
+	ret = drm_gem_handle_create(file_priv, obj, handle);
+	if (ret) {
+		drm_gem_object_unreference_unlocked(obj);
+		return ret;
+	}
+
+	/* Handle holds the reference now. */
+	drm_gem_object_unreference_unlocked(obj);
+	return 0;
+}
+
+/* Forward: frees one live BO's GPU mapping before its IOVA is
+ * recycled (p7580_gem_free_object below). Defined in the driver
+ * snapshot (submit.c, PM-held TLB invalidate + bo_list drop); the
+ * linker resolves it inside panfrost7580. Keeps this TU decoupled
+ * from drv/mmu structs (same opaque-void discipline as the
+ * pre-signal-sync helper above). */
+void p7580_gem_gpu_unmap(struct drm_gem_object *obj);
+void p7580_gem_free_object(struct drm_gem_object *obj)
+{
+	struct p7580_bo *bo = to_p7580_bo(obj);
+	struct p7580_dev *gd;
+	struct drm_device *dev = obj->dev;
+
+	/* gpu31-iova: unmap GPU PTEs + flush TLB BEFORE the IOVA is
+	 * reusable. p7580_gem_gpu_unmap walks the driver's bo_list
+	 * entry: leaf-clear (CPU-side, PM-safe), PM-held TLB
+	 * invalidate, bo_list unlink + ref drop, DMA unbind. After
+	 * this the IOVA range is unmapped everywhere; iova_free
+	 * below only then returns it to the allocator. Never-bound
+	 * BOs (never on bo_list) no-op inside; their DMA mapping is
+	 * still torn down here (existing leg below is then a no-op).
+	 * Notifier-hook variant removed: direct link instead. */
+	p7580_gem_gpu_unmap(obj);
+
+	gd = dev->dev_private;
+	if (gd)
+		p7580_iova_free(gd, bo);
+
+	if (bo->backing == P7580_BO_SHMEM && bo->dma_addrs && bo->sync_dev) {
+		/* Tear down the bind-time DMA mapping before the pages go
+		 * away. dev->dev is the platform device (never NULL on the
+		 * bound path; guard anyway: free must never crash). */
+		if (dev && dev->dev)
+			p7580_gem_dma_unbind(obj);
+		else {
+			kfree(bo->dma_addrs);
+			bo->dma_addrs = NULL;
+			bo->sync_dev = NULL;
+		}
+	}
+	if (obj->import_attach) {
+		/* Imported: sgt is the live exporter mapping; the core
+		 * helper unmaps + detaches + drops our dma_buf ref
+		 * (drm_prime.c:467-479). */
+		drm_prime_gem_destroy(obj, bo->sgt);
+		bo->sgt = NULL;
+	}
+	/* Importer-held dma_buf refs die inside drm_prime_gem_destroy
+	 * (dma_buf_put); bo->imported_dmabuf only exists to keep the
+	 * pointer visible to debug paths. */
+	bo->imported_dmabuf = NULL;
+	if (WARN_ON(bo->vmap_count != 0))
+		bo->vmap_count = 0;
+
+	if (obj->map_list.map)
+		drm_gem_free_mmap_offset(obj);
+	drm_gem_object_release(obj);
+
+	dma_resv_fini(&bo->resv);			/* 0002 */
+
+	if (bo->backing == P7580_BO_CMA)
+		p7580_cma_free(dev, bo);
+	else
+		p7580_shmem_free(bo);
+	kfree(bo);
+}
+
+/* ------------------------------------------------------------------ */
+/* CPU mmap (fault-driven, mirrors exynos_drm_gem_fault/map_buf)      */
+/* ------------------------------------------------------------------ */
+
+/* exynos convert_to_vm_err_msg, verbatim incl. the -EINTR -> NOPAGE arm
+ * (-EAGAIN comes from shmem_getpage while the page is under reclaim and
+ * is equally transient, so it joins the retry arm). */
+static unsigned int p7580_fault_err(int ret)
+{
+	switch (ret) {
+	case 0:
+	case -ERESTARTSYS:
+	case -EINTR:
+	case -EAGAIN:
+		return VM_FAULT_NOPAGE;
+	case -ENOMEM:
+		return VM_FAULT_OOM;
+	default:
+		return VM_FAULT_SIGBUS;
+	}
+}
+
+static int p7580_map_page(struct p7580_bo *bo, struct vm_area_struct *vma,
+			  unsigned long f_vaddr, pgoff_t page_offset)
+{
+	struct scatterlist *sgl;
+	unsigned long pfn;
+	unsigned int i;
+
+	if (page_offset >= (bo->base.size >> PAGE_SHIFT))
+		return -EINVAL;
+
+	if (bo->backing == P7580_BO_CMA) {
+		pfn = __phys_to_pfn(bo->cma_paddr) + page_offset;
+	} else if (bo->sgt) {
+		/* Imported: walk the live attachment mapping exactly like
+		 * exynos_drm_gem_map_buf (sg lengths, not page index). */
+		sgl = bo->sgt->sgl;
+		for_each_sg(bo->sgt->sgl, sgl, bo->sgt->nents, i) {
+			if (page_offset < (sgl->length >> PAGE_SHIFT))
+				break;
+			page_offset -= (sgl->length >> PAGE_SHIFT);
+		}
+		if (!sgl)
+			return -EINVAL;
+		pfn = __phys_to_pfn(sg_phys(sgl)) + page_offset;
+	} else {
+		struct page *page = bo->pages[page_offset];
+
+		pfn = page_to_pfn(page);
+	}
+	return vm_insert_mixed(vma, f_vaddr, pfn);
+}
+
+int p7580_gem_fault(struct vm_area_struct *vma, struct vm_fault *vmf)
+{
+	struct drm_gem_object *obj = vma->vm_private_data;
+	struct p7580_bo *bo = to_p7580_bo(obj);
+	struct drm_device *dev = obj->dev;
+	unsigned long f_vaddr;
+	pgoff_t page_offset;
+	int ret;
+
+	page_offset = ((unsigned long)vmf->virtual_address -
+		       vma->vm_start) >> PAGE_SHIFT;
+	f_vaddr = (unsigned long)vmf->virtual_address;
+
+	mutex_lock(&dev->struct_mutex);
+	ret = p7580_map_page(bo, vma, f_vaddr, page_offset);
+	mutex_unlock(&dev->struct_mutex);
+	return p7580_fault_err(ret);
+}
+
+/* gem_vm_ops for this driver (exynos shape: fault/open/close from the
+ * core). Published to the core as driver->gem_vm_ops in main.c
+ * (non-static: referenced from another TU). */
+const struct vm_operations_struct p7580_gem_vm_ops = {
+	.fault = p7580_gem_fault,
+	.open = drm_gem_vm_open,
+	.close = drm_gem_vm_close,
+};
+
+/* Driver .fops mmap (GEM path): resolve the fake offset to the BO via
+ * drm_gem_mmap, then map the pages IMMEDIATELY (no fault round trip).
+ * Fault-driven vm_insert_mixed cannot work here: drm_gem_mmap() on
+ * 3.10 sets VM_PFNMAP|VM_DONTEXPAND, installs driver->gem_vm_ops
+ * itself, and rejects VM_MIXEDMAP vmas/-EINVALs when that table is
+ * NULL -- clearing PFNMAP/adding MIXEDMAP and swapping in a second
+ * ops table after the fact breaks the core's contract (mmap() returns
+ * -EINVAL without ever faulting; dmesg silent). The working shape on
+ * this tree is exynos_drm_gem_mmap_buffer/drm_gem_cma_mmap:
+ * pgprot_writecombine (WC, exynos update_vm_cache_attr shape), then
+ * one dma_mmap_attrs() for the CMA page (arm32 arm_dma_mmap backend
+ * treats vma->vm_pgoff as the page index into the buffer, so reset it
+ * to 0 -- the GEM fake key >> PAGE_SHIFT is NOT a buffer index;
+ * exynos mmap_buffer avoids this via a fresh vma at pgoff 0 and
+ * drm_gem_cma_mmap via remap_pfn_range which ignores pgoff) or one
+ * remap_pfn_range() per SHMEM/imported page with the same prot +
+ * size check. KMS dumb mmap keeps its own entry point.
+ *
+ * Temporary entry/exit pr_info (mmap2 ticket): prints the fake pgoff
+ * installed by drm_gem_mmap and the final return code, so silicon
+ * dmesg proves whether the handler ran and where it failed. */
+int p7580_gem_mmap(struct file *filp, struct vm_area_struct *vma)
+{
+	struct drm_gem_object *obj;
+	struct p7580_bo *bo;
+	struct scatterlist *sgl;
+	unsigned long vm_size, pfn, off, fake_pgoff;
+	unsigned int i, npages;
+	int ret;
+
+	fake_pgoff = vma->vm_pgoff;
+	pr_info("p7580_gem_mmap: enter pgoff=0x%lx len=0x%lx\n",
+		fake_pgoff, vma->vm_end - vma->vm_start);
+	ret = drm_gem_mmap(filp, vma);
+	if (ret) {
+		pr_info("p7580_gem_mmap: drm_gem_mmap failed rc=%d pgoff=0x%lx\n",
+			ret, fake_pgoff);
+		return ret;
+	}
+	/* The fake offset key served its purpose (BO lookup); from here
+	 * on vma describes a byte range inside THIS BO, starting at 0. */
+	vma->vm_pgoff = 0;
+
+	obj = vma->vm_private_data;
+	bo = to_p7580_bo(obj);
+	npages = obj->size >> PAGE_SHIFT;
+	vm_size = vma->vm_end - vma->vm_start;
+
+	if (vm_size > obj->size) {
+		ret = -EINVAL;
+		goto err_close;
+	}
+
+	/* WC default (covers both SHMEM CREATE_BO and CMA scanout), cached
+	 * opt-in (exynos update_vm_cache_attr shape). COHERENCY_NONE: WC is
+	 * MT_NORMAL_NC, so no CPU cache lines exist to flush on either
+	 * path; the GPU PTW side is synced by the driver's map_bo
+	 * dma_sync maintenance, not here. */
+	if (bo->cache_attr & P7580_GEM_CACHABLE)
+		vma->vm_page_prot = vm_get_page_prot(vma->vm_flags);
+	else if ((bo->cache_attr & P7580_GEM_WC) ||
+		 !(bo->cache_attr & P7580_GEM_CACHABLE))
+		vma->vm_page_prot =
+			pgprot_writecombine(vm_get_page_prot(vma->vm_flags));
+
+	if (bo->backing == P7580_BO_CMA && !bo->sgt) {
+		DEFINE_DMA_ATTRS(attrs);
+		dma_set_attr(DMA_ATTR_WRITE_COMBINE, &attrs);
+		ret = dma_mmap_attrs(obj->dev->dev, vma, bo->cma_vaddr,
+				     bo->cma_paddr, obj->size, &attrs);
+		pr_info("p7580_gem_mmap: dma_mmap_attrs rc=%d size=0x%zx paddr=0x%llx\n",
+			ret, obj->size, (unsigned long long)bo->cma_paddr);
+		if (ret)
+			goto err_close;
+		return 0;
+	}
+
+	if (bo->sgt) {
+		off = 0;
+		for_each_sg(bo->sgt->sgl, sgl, bo->sgt->nents, i) {
+			unsigned long chunk = (unsigned long)sgl->length;
+			if (chunk > vm_size - off)
+				chunk = vm_size - off;
+			pfn = __phys_to_pfn(sg_phys(sgl));
+			ret = remap_pfn_range(vma, vma->vm_start + off, pfn,
+					chunk, vma->vm_page_prot);
+			if (ret)
+				goto err_close;
+			off += sgl->length;
+			if (off >= vm_size)
+				break;
+		}
+		return 0;
+	}
+
+	if (!bo->pages) {
+		ret = -ENODEV;
+		goto err_close;
+	}
+	for (i = 0; i < npages; i++) {
+		if ((unsigned long)(i + 1) * PAGE_SIZE > vm_size)
+			break;
+		pfn = page_to_pfn(bo->pages[i]);
+		ret = remap_pfn_range(vma, vma->vm_start + (i << PAGE_SHIFT),
+				      pfn, PAGE_SIZE, vma->vm_page_prot);
+		if (ret)
+			goto err_close;
+	}
+	pr_info("p7580_gem_mmap: ok obj_size=0x%zx vm=0x%lx\n",
+		obj->size, vm_size);
+	return 0;
+
+err_close:
+	pr_info("p7580_gem_mmap: fail rc=%d vm=0x%lx obj=0x%zx\n",
+		ret, vm_size, obj->size);
+	drm_gem_vm_close(vma);
+	return ret;
+}
+
+/* ------------------------------------------------------------------ */
+/* WAIT_BO (mirrors v5.2 panfrost_wait_bo on the 0002 resv shim)      */
+/* ------------------------------------------------------------------ */
+
+/* Driver wait helper behind the WAIT_BO ioctl. timeout is jiffies;
+ * the 0002 shim locks resv->lock internally and handles the excl +
+ * shared fence set (shared only when wait_all). */
+long p7580_gem_wait(struct drm_device *dev, struct drm_file *file_priv,
+		    uint32_t handle, long timeout_jiffies, int wait_all)
+{
+	struct drm_gem_object *obj;
+	struct p7580_bo *bo;
+	long ret;
+
+	obj = drm_gem_object_lookup(dev, file_priv, handle);
+	if (!obj)
+		return -ENOENT;
+	bo = to_p7580_bo(obj);
+	ret = dma_resv_wait_timeout(&bo->resv, wait_all, true,
+				    timeout_jiffies);
+	drm_gem_object_unreference_unlocked(obj);
+	return ret;
+}
+
+/* ------------------------------------------------------------------ */
+/* PRIME (real attachment-backed sharing; never import-by-copy)       */
+/* ------------------------------------------------------------------ */
+
+/* GPU page-table mapping hook bodies (declared above create so the
+ * contract comment lives next to the create path; DriverAssemble
+ * includes this header for the prototypes). */
+
+phys_addr_t p7580_bo_page_phys(struct drm_gem_object *obj,
+			       unsigned int idx, int *ok)
+{
+	struct p7580_bo *bo = to_p7580_bo(obj);
+	unsigned int npages = bo->base.size >> PAGE_SHIFT;
+	struct scatterlist *sgl;
+	unsigned int off = idx;
+	unsigned int i;
+
+	if (idx >= npages) {
+		if (ok)
+			*ok = 0;
+		return 0;
+	}
+	if (bo->backing == P7580_BO_CMA) {
+		if (ok)
+			*ok = 1;
+		return (phys_addr_t)bo->cma_paddr + ((phys_addr_t)idx <<
+						     PAGE_SHIFT);
+	}
+	if (bo->sgt && !bo->pages) {
+		for_each_sg(bo->sgt->sgl, sgl, bo->sgt->nents, i) {
+			if (off < (sgl->length >> PAGE_SHIFT)) {
+				if (ok)
+					*ok = 1;
+				return (phys_addr_t)sg_phys(sgl) +
+				       ((phys_addr_t)off << PAGE_SHIFT);
+			}
+			off -= (sgl->length >> PAGE_SHIFT);
+		}
+		if (ok)
+			*ok = 0;
+		return 0;
+	}
+	if (bo->pages && bo->pages[idx]) {
+		/* gpu31-coherency: prefer the bind-time bus address (PTEs
+		 * must carry the dma_map result, not page_to_phys, so a
+		 * non-identity tree still programs the right address).
+		 * Never-bound BOs fall back to page_to_phys (identity). */
+		if (ok)
+			*ok = 1;
+		return p7580_bo_dma_addr(obj, idx);
+	}
+	if (ok)
+		*ok = 0;
+	return 0;
+}
+
+/* Driver .gem_prime_get_sg_table: fresh table per call (the core's
+ * map path frees it after dma_map_sg; caching it here would
+ * double-free). CMA is a single entry; SHMEM/imported walk the page
+ * array via the helper (which uses sg_alloc_table_from_pages). */
+struct sg_table *p7580_gem_prime_get_sg_table(struct drm_gem_object *obj)
+{
+	struct p7580_bo *bo = to_p7580_bo(obj);
+	struct sg_table *sgt;
+
+	if (bo->backing == P7580_BO_CMA) {
+		sgt = kzalloc(sizeof(*sgt), GFP_KERNEL);
+		if (!sgt)
+			return ERR_PTR(-ENOMEM);
+		if (sg_alloc_table(sgt, 1, GFP_KERNEL)) {
+			kfree(sgt);
+			return ERR_PTR(-ENOMEM);
+		}
+		sg_set_buf(sgt->sgl, bo->cma_vaddr, obj->size);
+		return sgt;
+	}
+
+	if (bo->sgt && obj->import_attach)
+		/* Re-export of an imported BO: hand out the live
+		 * attachment mapping (exynos dmabuf.c shape: the exporter's
+		 * map_dma_buf owns the table). */
+		return bo->sgt;
+
+	if (!bo->pages)
+		return ERR_PTR(-ENODEV);
+	/* drm_prime_pages_to_sg builds the table with
+	 * sg_alloc_table_from_pages (present, scatterlist.h:237). */
+	return drm_prime_pages_to_sg(bo->pages, bo->nr_pages);
+}
+
+/* Driver .gem_prime_import_sg_table: wrap the exporter's live mapping.
+ * The core (drm_prime.c:500) passes exactly the pointer its
+ * dma_buf_map_attachment returned, and our free path hands that same
+ * pointer to drm_prime_gem_destroy -- so store it, do NOT copy it.
+ * No page allocation happens here (review F1). */
+struct drm_gem_object *p7580_gem_prime_import_sg_table(
+		struct drm_device *dev, size_t size, struct sg_table *sgt)
+{
+	struct p7580_bo *bo;
+	int ret;
+
+	size = round_up(size, PAGE_SIZE);
+	if (!sgt || !size)
+		return ERR_PTR(-EINVAL);
+
+	bo = kzalloc(sizeof(*bo), GFP_KERNEL);
+	if (!bo)
+		return ERR_PTR(-ENOMEM);
+
+	ret = drm_gem_private_object_init(dev, &bo->base, size);
+	if (ret) {
+		kfree(bo);
+		return ERR_PTR(ret);
+	}
+
+	bo->backing = P7580_BO_SHMEM;
+	bo->cache_attr = P7580_GEM_WC;
+	bo->sgt = sgt;
+
+	dma_resv_init(&bo->resv);			/* 0002 */
+
+	ret = drm_gem_create_mmap_offset(&bo->base);
+	if (ret) {
+		dma_resv_fini(&bo->resv);
+		drm_gem_object_release(&bo->base);
+		kfree(bo);
+		return ERR_PTR(ret);
+	}
+
+	/* F-GEM2: same per-device IOVA allocator as create (never the
+	 * GEM mmap-offset manager). Imported BOs carry the exporter's
+	 * attachment mapping in bo->sgt; the node owns the new range
+	 * and free removes it. */
+	if (dev->dev_private) {
+		struct p7580_dev *gd = dev->dev_private;
+		unsigned long npages = size >> PAGE_SHIFT;
+		struct drm_mm_node *hole;
+		int alloc_ret = -ENOSPC;
+
+		mutex_lock(&gd->iova_lock);
+		hole = drm_mm_search_free(&gd->iova_mm, npages, 0, false);
+		if (hole) {
+			memset(&bo->iova_node, 0, sizeof(bo->iova_node));
+			if (!drm_mm_insert_node(&gd->iova_mm, &bo->iova_node,
+						npages, 0)) {
+				bo->iova = bo->iova_node.start << PAGE_SHIFT;
+				bo->iova_valid = 1;
+				alloc_ret = 0;
+			}
+		}
+		mutex_unlock(&gd->iova_lock);
+		if (alloc_ret) {
+			drm_gem_free_mmap_offset(&bo->base);
+			dma_resv_fini(&bo->resv);
+			drm_gem_object_release(&bo->base);
+			kfree(bo);
+			return ERR_PTR(alloc_ret);
+		}
+	}
+
+	return &bo->base;
+}
+
+/* Driver .gem_prime_vmap: one GEM reference per live CPU mapping
+ * (review F2). The vaddrs slots record them so vunmap can tell a
+ * foreign pointer from ours. CMA returns the coherent kernel address
+ * (still pinned by the ref); SHMEM/imported vmaps the page array. */
+void *p7580_gem_prime_vmap(struct drm_gem_object *obj)
+{
+	struct p7580_bo *bo = to_p7580_bo(obj);
+	void *vaddr = NULL;
+	unsigned int i;
+
+	if (bo->vmap_count >= P7580_VMAP_MAX)
+		return NULL;
+	for (i = 0; i < P7580_VMAP_MAX; i++)
+		if (!bo->vaddrs[i])
+			break;
+	if (i >= P7580_VMAP_MAX)
+		return NULL;
+
+	drm_gem_object_reference(obj);
+	if (bo->backing == P7580_BO_CMA) {
+		vaddr = bo->cma_vaddr;
+	} else if (bo->pages) {
+		vaddr = vmap(bo->pages, bo->nr_pages, VM_MAP,
+			     pgprot_writecombine(PAGE_KERNEL));
+	} else if (bo->sgt) {
+		/* Imported local re-export path: no local page array;
+		 * map the attachment pages transiently. */
+		struct page **pages;
+		unsigned int np = obj->size >> PAGE_SHIFT;
+		struct scatterlist *sgl;
+		unsigned int pg = 0, j;
+
+		pages = kmalloc_array(np, sizeof(*pages), GFP_KERNEL);
+		if (pages) {
+			for_each_sg(bo->sgt->sgl, sgl, bo->sgt->nents, j) {
+				struct page *p = sg_page(sgl);
+				unsigned int n = sgl->length >> PAGE_SHIFT;
+
+				while (n-- && pg < np)
+					pages[pg++] = p++;
+			}
+			if (pg == np)
+				vaddr = vmap(pages, np, VM_MAP,
+					     pgprot_writecombine(PAGE_KERNEL));
+			kfree(pages);
+		}
+	}
+	if (!vaddr) {
+		drm_gem_object_unreference(obj);
+		return NULL;
+	}
+	bo->vaddrs[i] = vaddr;
+	bo->vmap_count++;
+	return vaddr;
+}
+
+/* Driver .gem_prime_vunmap: drop the pin taken in vmap. Unknown
+ * pointers are rejected (caller bug) instead of unmapping blindly. */
+void p7580_gem_prime_vunmap(struct drm_gem_object *obj, void *vaddr)
+{
+	struct p7580_bo *bo = to_p7580_bo(obj);
+	unsigned int i;
+
+	if (!vaddr)
+		return;
+	for (i = 0; i < P7580_VMAP_MAX; i++) {
+		if (bo->vaddrs[i] == vaddr)
+			break;
+	}
+	if (i >= P7580_VMAP_MAX) {
+		WARN_ON(1);
+		return;
+	}
+	if (bo->backing != P7580_BO_CMA || bo->pages || bo->sgt)
+		if (!(bo->backing == P7580_BO_CMA && !bo->pages &&
+		      !bo->sgt))
+			vunmap(vaddr);
+	bo->vaddrs[i] = NULL;
+	bo->vmap_count--;
+	drm_gem_object_unreference(obj);
+}
+
+/* Driver .gem_prime_export: stock core helper (dma_buf ops +
+ * get_sg_table -> dma_map_sg). */
+struct dma_buf *p7580_gem_prime_export(struct drm_device *dev,
+				       struct drm_gem_object *obj, int flags)
+{
+	return drm_gem_prime_export(dev, obj, flags);
+}
+
+/* Driver .gem_prime_import: entry point the core calls for
+ * PRIME_FD_TO_HANDLE. Self-imports (dma_buf->priv is a GEM object from
+ * this dev, i.e. our own export) bump the GEM ref instead of wrapping
+ * a new object (core drm_gem_prime_import fast path, drm_prime.c:
+ * 273-288). The core helper is static in drm_prime.c, so the check
+ * below is by construction: only GEM exports of THIS driver carry a
+ * (dev, gem_prime_import) pair that routes back here. Cross-device
+ * GEM dma_bufs land in the attach path like any foreign exporter. */
+struct drm_gem_object *p7580_gem_prime_import(struct drm_device *dev,
+					     struct dma_buf *dma_buf)
+{
+	struct drm_gem_object *obj;
+	struct dma_buf_attachment *attach;
+	struct sg_table *sgt;
+	int ret;
+
+	if (!dev->driver->gem_prime_import_sg_table)
+		return ERR_PTR(-EINVAL);
+
+	if (!dma_buf || !dma_buf->ops)
+		return ERR_PTR(-EINVAL);
+
+	if (dma_buf->priv) {
+		obj = dma_buf->priv;
+		if (obj->dev == dev &&
+		    dev->driver->gem_prime_import == p7580_gem_prime_import) {
+			drm_gem_object_reference(obj);
+			return obj;
+		}
+	}
+
+	attach = dma_buf_attach(dma_buf, dev->dev);
+	if (IS_ERR(attach))
+		return ERR_PTR(PTR_ERR(attach));
+
+	/* Attachment-backed import: the core's fd lookup already holds
+	 * the dma_buf (dma_buf_get in PRIME_FD_TO_HANDLE before this
+	 * runs). Take the explicit import ref so detach/put in free
+	 * cannot race the exporter's release (cf. drm_gem_prime_import's
+	 * get_dma_buf). */
+	get_dma_buf(dma_buf);
+
+	sgt = dma_buf_map_attachment(attach, DMA_BIDIRECTIONAL);
+	if (IS_ERR_OR_NULL(sgt)) {
+		ret = PTR_ERR(sgt);
+		goto fail_detach;
+	}
+
+	obj = dev->driver->gem_prime_import_sg_table(dev, dma_buf->size, sgt);
+	if (IS_ERR(obj)) {
+		ret = PTR_ERR(obj);
+		goto fail_unmap;
+	}
+
+	to_p7580_bo(obj)->sgt = sgt;
+	to_p7580_bo(obj)->imported_dmabuf = dma_buf;
+	obj->import_attach = attach;
+	return obj;
+
+fail_unmap:
+	dma_buf_unmap_attachment(attach, sgt, DMA_BIDIRECTIONAL);
+fail_detach:
+	dma_buf_detach(dma_buf, attach);
+	dma_buf_put(dma_buf);
+	return ERR_PTR(ret);
+}
+
diff -u '--exclude=.git' -Naur a/drivers/gpu/drm/panfrost/panfrost7580_gem.h b/drivers/gpu/drm/panfrost/panfrost7580_gem.h
--- a/drivers/gpu/drm/panfrost/panfrost7580_gem.h	1969-12-31 19:00:00.000000000 -0500
+++ b/drivers/gpu/drm/panfrost/panfrost7580_gem.h	2026-11-21 00:00:00.000000000 -0500
@@ -0,0 +1,232 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * panfrost_gem.h - GEM object model for the Mali-T720 panfrost port
+ * (Exynos 7580 / Nura 3.10.108, j7elte).
+ *
+ * v5.2 reference: drivers/gpu/drm/panfrost/panfrost_gem.{c,h} (96/30 LOC)
+ * against drm_gem_shmem_helper. This tree has NO shmem helper
+ * (gpu31-target.md D5: reuse the present 272-line drm_gem_cma_helper),
+ * so the port below is a clean-room CMA implementation with a private
+ * page-array shmem path. DrmCore's drm_compat_310.h only wires fops;
+ * it does NOT own BO structs or ioctl bodies (agreed split).
+ *
+ * BO model (mirrors v5.2 panfrost_gem_object layout adapted to 3.10):
+ *  - embedded struct drm_gem_object (handle + mmap-offset machinery);
+ *  - backing selector: CMA (dma_alloc_attrs, contiguous, scanout-safe)
+ *    or SHMEM (shmem file + per-page array, import/vmap friendly).
+ *    The selector is P7580_BO_* (private, never on the UAPI wire;
+ *    v5.2 UAPI has no BO flags and CREATE_BO.flags must stay zero).
+ *  - embedded struct dma_resv (0002 shim type; see p7580_bo.resv):
+ *    SUBMIT reserves it, WAIT_BO polls it; BO free path releases it.
+ *    The field is transparent here because the integrator applies the
+ *    0001/0002 backport series BEFORE this driver (series/0002), so
+ *    <linux/dma-resv.h> exists at driver build time. The KINC check in
+ *    the Makefile stages exactly those headers and fails loudly if
+ *    the layout ever drifts.
+ *  - IOVA node: per-BO struct drm_mm_node linked into the per-device
+ *    drm_mm (P7580_IOVA_START/SIZE window); GET_BO_OFFSET and the MMU
+ *    slice read bo->iova (nonzero guaranteed: v5.2 CREATE_BO UAPI
+ *    requires a nonzero offset and the T720 treats IOVA 0 as
+ *    unmapped). Carrying the node (not a bare start/size pair) lets
+ *    free return the range via drm_mm_remove_node; the mutex in
+ *    struct p7580_dev owns the allocator (3.10 drm_mm has no
+ *    per-mm lock of its own).
+ *
+ * Lifetime: CMA path uses drm_gem_object_init + dma_alloc_attrs
+ * (WRITE_COMBINE via dma_attrs, same as the display CMA delta);
+ * SHMEM path uses drm_gem_private_object_init + its own shmem file
+ * (same shmem_file_setup("drm mm object") pattern drm_gem_object_init
+ * uses) + shmem_read_mapping_page per page. PRIME import holds one
+ * dma_buf_get() ref (released in free). vmap pins with the core's own
+ * fault-grab reference (see vunmap): while any vmap is live the GEM
+ * refcount is held, so free cannot race the mapping (review F2 on the
+ * display PRIME patch); the vaddr counting lives in the core, sized by
+ * P7580_VMAP_MAX. No import-by-copy anywhere (review F1).
+ */
+#ifndef PANFROST7580_GEM_H
+#define PANFROST7580_GEM_H
+
+/* F-GEM1 (gpu31-driver-review): the BO embeds the real struct dma_resv
+ * from the 0002 backport header instead of an opaque pad + layout
+ * BUILD_BUG_ONs. The 0001/0002 series is a build prerequisite of this
+ * driver (series/0001-0002 applied first; Makefile KINC stages them),
+ * so the field tracks shim growth automatically. */
+#include <linux/dma-resv.h>
+#include <linux/types.h>
+#include <linux/mutex.h>
+#include <linux/scatterlist.h>
+
+struct device;
+
+#define P7580_BO_CMA		0u
+#define P7580_BO_SHMEM		1u
+
+/* IOVA window in BYTES: 32 MiB .. 4 GiB, T720 legacy 32-bit window
+ * (panfrost v5.2: PFN 0x8000..0x100000, see panfrost_mmu_map_io_region;
+ *  T720 VA bits unread until M0 runs on silicon, gpu-panfrost.md R3).
+ * Units: the drm_mm allocator counts PAGES, so p7580_dev_init passes
+ * these shifted by PAGE_SHIFT; node.start is a PFN and IOVA bytes are
+ * node.start << PAGE_SHIFT. Do NOT pass raw bytes to drm_mm_init. */
+#define P7580_IOVA_START	(32u << 20)
+#define P7580_IOVA_SIZE		((4ull << 30) - P7580_IOVA_START)
+
+/* CPU-cache attribute for the fault handler (matches exynos update flags). */
+#define P7580_GEM_WC		(1u << 0)
+#define P7580_GEM_CACHABLE	(1u << 1)
+
+/* Max concurrent vmaps per BO. The core pins each vmap with one GEM
+ * reference; the count lets vunmap know when the last mapping went
+ * away. 8 is plenty (importer + CPU writer + fault path + scanout). */
+#define P7580_VMAP_MAX		8u
+
+struct p7580_bo {
+	struct drm_gem_object base;
+	/* 0002 reservation object: SUBMIT locks it, WAIT_BO waits on
+	 * it, prime import shares it with the exporter. Real type
+	 * (linux/dma-resv.h) at build time; see file header. */
+	struct dma_resv resv;
+	/* IOVA allocation state: node linked into the per-device
+	 * drm_mm while valid (iova_valid), start cached for the
+	 * GET_BO_OFFSET fast path. */
+	struct drm_mm_node iova_node;
+	unsigned long iova;
+	int iova_valid;
+	unsigned int backing;
+	unsigned int cache_attr;
+	/* CMA backing. sg table is built on demand by
+	 * p7580_gem_prime_get_sg_table (never cached here). */
+	void *cma_vaddr;
+	dma_addr_t cma_paddr;
+	/* SHMEM backing. */
+	struct file *shmem_filp;
+	struct page **pages;
+	unsigned int nr_pages;
+	/* PRIME import state: set only on the importer. sgt is the live
+	 * exporter attachment mapping (unmapped + detached in free via
+	 * drm_prime_gem_destroy); the dma_buf ref is the get_dma_buf()
+	 * taken at import. Non-imported BOs leave both NULL. */
+	struct sg_table *sgt;
+	struct dma_buf *imported_dmabuf;
+	/* vmap pin: GEM references held while CPU mappings are live;
+	 * count mirrors them (p7580_gem_prime_vmap/vunmap). */
+	void *vaddrs[P7580_VMAP_MAX];
+	unsigned int vmap_count;
+	/* COHERENCY_NONE DMA sync state (gpu31-coherency): bind-time
+	 * dma_map of the SHMEM pages for GPU access. dma_addrs[i] is
+	 * the bus address programmed into the GPU PTE (identity on
+	 * this tree, carried verbatim otherwise); sync_dev is the
+	 * platform device the mapping belongs to. Both set by
+	 * p7580_gem_dma_bind, cleared by p7580_gem_dma_unbind/free.
+	 * NULL/NULL on never-bound and CMA/imported BOs. */
+	dma_addr_t *dma_addrs;
+	struct device *sync_dev;
+};
+/* Per-device GEM state: IOVA allocator + the lock that serialises it
+ * (the driver allocates this in probe and stores it in dev_private;
+ * the GEM helpers below take it by pointer so they stay testable). */
+struct p7580_dev {
+	struct device *dev;
+	struct drm_mm iova_mm;
+	struct mutex iova_lock;
+};
+
+struct p7580_bo *to_p7580_bo(struct drm_gem_object *obj);
+
+int p7580_dev_init(struct p7580_dev *gd, struct device *dev);
+void p7580_dev_fini(struct p7580_dev *gd);
+
+int p7580_gem_create(struct p7580_dev *gd, struct drm_device *dev,
+		     size_t size, unsigned int backing,
+		     unsigned int cache_attr, struct drm_gem_object **out);
+int p7580_gem_create_with_handle(struct p7580_dev *gd,
+				 struct drm_file *file_priv,
+				 struct drm_device *dev, size_t size,
+				 unsigned int backing,
+				 unsigned int cache_attr,
+				 uint32_t *handle);
+void p7580_gem_free_object(struct drm_gem_object *obj);
+int p7580_gem_fault(struct vm_area_struct *vma, struct vm_fault *vmf);
+/* Published to the core as driver->gem_vm_ops (main.c); defined in
+ * panfrost7580_gem.c. Must stay non-NULL: drm_gem_mmap() -EINVALs when
+ * the driver table is NULL. */
+extern const struct vm_operations_struct p7580_gem_vm_ops;
+int p7580_gem_mmap(struct file *filp, struct vm_area_struct *vma);
+long p7580_gem_wait(struct drm_device *dev, struct drm_file *file_priv,
+		    uint32_t handle, long timeout_jiffies, int wait_all);
+
+/* GPU page-table mapping hook (for DriverAssemble / jobs SUBMIT).
+ * GEM allocates an IOVA per BO at create/import but never programs the
+ * Mali page tables itself. The owning driver maps BOs into the
+ * per-context tables with these helpers, then lets jobs SUBMIT pin each
+ * referenced BO (dma_resv lock discipline per the 0002 plain-mutex)
+ * before p7580_job_hw_submit reads the job descriptor. Unmap runs
+ * before free; the context teardown walker is p7580_mmu_teardown()
+ * (iommu/panfrost7580_mmu.h, F-MMU5), wired to file-close/remove.
+ *  - bind (new, gpu31-coherency): p7580_gem_dma_bind(obj, dev) once
+ *    before the first map; then per page 0..npages-1, p7580_mmu_map(mmu,
+ *    bo->iova + idx*PAGE_SIZE, p7580_bo_dma_addr(obj, idx),
+ *    P7580_PROT_RD|WR, memattr); then p7580_mmu_invalidate(regs,
+ *    as_nr, iova>>12, npages, sync=0) and p7580_mmu_program_as once
+ *    per context (iommu/panfrost7580_mmu.h, lock/encode in
+ *    mmu/pf7580_as.h). PTEs MUST come from p7580_bo_dma_addr (the
+ *    bind-time bus address), never page_to_phys/sg_phys directly.
+ *  - submit: p7580_gem_submit_sync(obj) per BO after the CPU fills
+ *    descriptors/payloads, before queueing (drains CPU lines to the
+ *    point the GPU reads).
+ *  - completion: p7580_gem_job_done_sync(obj) per BO in free_job
+ *    (invalidates CPU lines so reads see GPU bytes).
+ *  - unbind/free: p7580_mmu_unmap per page + invalidate, then
+ *    p7580_gem_dma_unbind(obj) before pages are released. */
+unsigned int p7580_bo_npages(struct drm_gem_object *obj);
+phys_addr_t p7580_bo_page_phys(struct drm_gem_object *obj,
+			       unsigned int idx, int *ok);
+/* COHERENCY_NONE data sync (gpu31-coherency): per-page DMA-API order.
+ * Bind maps the SHMEM pages (dma_map_page, BIDIRECTIONAL) and caches
+ * the bus addresses; SUBMIT drains CPU writes (sync_for_device);
+ * completion invalidates CPU lines (sync_for_cpu) so the next CPU
+ * read sees GPU bytes; unbind tears the mapping down. CMA/imported
+ * BOs are no-ops everywhere. job_done_sync runs in free_job context
+ * (no MMIO, no sleeps, no locks); the pre-signal wrapper below runs
+ * the same maintenance in IRQ / fence-callback context before the
+ * fence signals. PTEs must come from p7580_bo_dma_addr. */
+/* Pre-signal variant of the completion invalidate (gpu31-coherency-race):
+ * runs job_done_sync on each owned BO WITHOUT dropping refs. Called with
+ * the job's bos/bo_count (opaque void so this header stays drm-free)
+ * BEFORE the done-fence is signalled, so a userspace wait returning
+ * implies visible data. Same IRQ-off-spinlock / fence-callback safety
+ * as job_done_sync (cache maintenance only, no MMIO/sleeps/locks).
+ * free_job keeps its post-signal job_done_sync + unref walk as the
+ * ref-drop leg. */
+void p7580_gem_job_bos_pre_signal_sync(void **bos, unsigned int bo_count);
+void p7580_gem_job_done_sync(struct drm_gem_object *obj);
+int p7580_gem_dma_bind(struct drm_gem_object *obj, struct device *dev);
+void p7580_gem_submit_sync(struct drm_gem_object *obj);
+void p7580_gem_dma_unbind(struct drm_gem_object *obj);
+phys_addr_t p7580_bo_dma_addr(struct drm_gem_object *obj, unsigned int idx);
+/* gpu31-iova: free-time GPU unmap (driver snapshot, submit.c).
+ * Called from p7580_gem_free_object before iova_free; clears the
+ * BO's leaf PTEs + PM-held TLB invalidate + bo_list unlink + DMA
+ * unbind. Never-bound BOs no-op. Register hook is link-compat. */
+void p7580_gem_gpu_unmap(struct drm_gem_object *obj);
+void p7580_gem_mmu_register_notify(void (*fn)(void *, struct drm_gem_object *,
+					      unsigned long, unsigned int),
+				   void *priv);
+/* DEBUG-ONLY (gpu31-gpuwrite, strip before cutover): kernel-side word
+ * readback of a BO page after completion. Reuses p7580_gem_job_done_sync
+ * (same invalidate the pre-signal IRQ path runs) then reads one u32 via
+ * kmap. No new maintenance implementation; CMA/imported-never-bound BOs
+ * follow the same no-op rules as job_done_sync. offset is a byte offset. */
+int p7580_gem_debug_read_word(struct drm_gem_object *obj, uint32_t offset,
+			      uint32_t *out);
+struct sg_table *p7580_gem_prime_get_sg_table(struct drm_gem_object *obj);
+struct drm_gem_object *p7580_gem_prime_import_sg_table(
+		struct drm_device *dev, size_t size, struct sg_table *sgt);
+void *p7580_gem_prime_vmap(struct drm_gem_object *obj);
+void p7580_gem_prime_vunmap(struct drm_gem_object *obj, void *vaddr);
+struct dma_buf *p7580_gem_prime_export(struct drm_device *dev,
+				       struct drm_gem_object *obj, int flags);
+struct drm_gem_object *p7580_gem_prime_import(struct drm_device *dev,
+					      struct dma_buf *dma_buf);
+
+#endif /* PANFROST7580_GEM_H */
+
diff -u '--exclude=.git' -Naur a/drivers/gpu/drm/panfrost/panfrost7580_ioctl.c b/drivers/gpu/drm/panfrost/panfrost7580_ioctl.c
--- a/drivers/gpu/drm/panfrost/panfrost7580_ioctl.c	1969-12-31 19:00:00.000000000 -0500
+++ b/drivers/gpu/drm/panfrost/panfrost7580_ioctl.c	2026-11-21 00:00:00.000000000 -0500
@@ -0,0 +1,372 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * panfrost7580_ioctl.c - six v5.2 ioctl handlers on the GEM core.
+ *
+ * Userspace contract (gpu31-target.md H1, byte-identical v5.2 UAPI):
+ * SUBMIT=0x00, WAIT_BO=0x01, CREATE_BO=0x02, MMAP_BO=0x03,
+ * GET_PARAM=0x04, GET_BO_OFFSET=0x05. GET_PARAM answers only
+ * DRM_PANFROST_PARAM_GPU_PROD_ID (upstream rejects the rest with
+ * -EINVAL; modern-Mesa probes of extra params are handled Mesa-side).
+ * CREATE_BO.flags is reserved-zero (reject nonzero, v5.2 has no flags).
+ *
+ * SUBMIT validates here and dispatches to the jobs slice
+ * (code/gpu31/jobs/panfrost7580_job.h: p7580_job_submit(), whose
+ * signature is mirrored below so this file -c compiles standalone).
+ * The jobs core resolves in-syncobjs (0003 find_fence), reserves the
+ * BO resvs (0002), submits to the sched entity (0004), and installs
+ * the out-sync fence (0003 replace_fence). User pointers (in_syncs,
+ * bo_handles) are copied in with copy_from_user into a stack-capped
+ * staging buffer (64 + 16 entries max); oversized counts are -EINVAL,
+ * short/failing copies are -EFAULT. No direct user dereference.
+ *
+ * File-private state (p7580_file_priv, header): per-fd 0003 syncobj
+ * manager (init on open, fini on postclose) + opaque jobs per-fd
+ * context (allocated by the jobs slice on first SUBMIT, freed by it
+ * on postclose). GEM owns neither the syncobj entries nor the sched
+ * entities; it only wires the lifetimes.
+ *
+ * SHIM-CALLSITES: 0002 (dma_resv wait via p7580_gem_wait), 0003
+ * (syncobj manager init/fini via driver_priv).
+ */
+
+#include <linux/device.h>
+#include <linux/dma-mapping.h>
+#include <linux/jiffies.h>
+#include <linux/mutex.h>
+#include <linux/slab.h>
+#include <linux/time.h>
+#include <linux/uaccess.h>
+
+#include <drm/drmP.h>
+#include <drm/drm.h>
+
+#include "drm_syncobj.h"		/* 0003 (staged by Makefile) */
+#include "panfrost7580_gem.h"
+#include "panfrost7580_ioctl.h"
+#include "panfrost_drm.h"
+/* ABI gate (gpu31-abialign): v5.2/Mesa-20.3 wire sizes + offsets. The
+ * 3.10 core keys copy_from/to_user on the driver's own _IOC_SIZE, so
+ * any field/size drift silently mis-copies userspace. Fail the build
+ * instead. See also the mirror asserts in panfrost7580_syncobj.c. */
+#include <linux/bug.h>
+/* get_param is the Mesa handshake: identical on v5.2 and Mesa 20.3. */
+static inline void p7580_abi_check_get_param(void)
+{
+	BUILD_BUG_ON(sizeof(struct drm_panfrost_get_param) != 16);
+	BUILD_BUG_ON(__builtin_offsetof(struct drm_panfrost_get_param,
+					param) != 0);
+	BUILD_BUG_ON(__builtin_offsetof(struct drm_panfrost_get_param,
+					pad) != 4);
+	BUILD_BUG_ON(__builtin_offsetof(struct drm_panfrost_get_param,
+					value) != 8);
+	BUILD_BUG_ON(DRM_PANFROST_PARAM_GPU_PROD_ID != 0);
+}
+/* SUBMIT is the 40-byte v5.2 shape (no jm_ctx_handle/pad tail). */
+static inline void p7580_abi_check_submit(void)
+{
+	BUILD_BUG_ON(sizeof(struct drm_panfrost_submit) != 40);
+	BUILD_BUG_ON(__builtin_offsetof(struct drm_panfrost_submit, jc) != 0);
+	BUILD_BUG_ON(__builtin_offsetof(struct drm_panfrost_submit,
+					in_syncs) != 8);
+	BUILD_BUG_ON(__builtin_offsetof(struct drm_panfrost_submit,
+					in_sync_count) != 16);
+	BUILD_BUG_ON(__builtin_offsetof(struct drm_panfrost_submit,
+					out_sync) != 20);
+	BUILD_BUG_ON(__builtin_offsetof(struct drm_panfrost_submit,
+					bo_handles) != 24);
+	BUILD_BUG_ON(__builtin_offsetof(struct drm_panfrost_submit,
+					bo_handle_count) != 32);
+	BUILD_BUG_ON(__builtin_offsetof(struct drm_panfrost_submit,
+					requirements) != 36);
+}
+
+
+/* Jobs-slice SUBMIT core (code/gpu31/jobs/panfrost7580_job.h shape,
+ * mirrored locally so this file -c compiles without the jobs tree).
+ * Canonical fields (jobs/panfrost7580_jm_hw.h struct p7580_submit):
+ * jc/in_syncs/in_sync_count/out_sync/bo_handles/bo_handle_count/
+ * requirements -- u64 user pointers staged to kernel arrays below. */
+struct p7580_job_dev;
+struct p7580_file_ctx;
+struct p7580_submit {
+	uint64_t jc;
+	uint64_t in_syncs;
+	uint32_t in_sync_count;
+	uint32_t out_sync;
+	uint64_t bo_handles;
+	uint32_t bo_handle_count;
+	uint32_t requirements;
+};
+/* p7580_submit mirror pin (kept after the definition: C needs the
+ * complete type for sizeof). */
+static inline void p7580_abi_check_submit_mirror(void)
+{
+	BUILD_BUG_ON(sizeof(struct p7580_submit) != 40);
+}
+int p7580_job_submit(struct p7580_job_dev *jd, struct p7580_file_ctx *fctx,
+		     const struct p7580_submit *args);
+
+/* DrmCore owns the manager storage; GEM only borrows it via driver_priv.
+ * job_fctx is owned by the jobs slice (opaque pointer here). */
+struct p7580_file_priv {
+	struct drm_syncobj_manager mgr;
+	struct p7580_file_ctx *job_fctx;
+	struct p7580_job_dev *job_dev;
+};
+
+int p7580_file_priv_init(struct drm_device *dev, struct drm_file *file_priv)
+{
+	struct p7580_file_priv *priv;
+
+	(void)dev;
+	priv = kzalloc(sizeof(*priv), GFP_KERNEL);
+	if (!priv)
+		return -ENOMEM;
+	drm_syncobj_manager_init(&priv->mgr);
+	file_priv->driver_priv = priv;
+	return 0;
+}
+
+void p7580_file_priv_fini(struct drm_device *dev, struct drm_file *file_priv)
+{
+	struct p7580_file_priv *priv = file_priv->driver_priv;
+
+	(void)dev;
+	if (!priv)
+		return;
+	/* Jobs context (sched entities) is freed by the jobs slice's
+	 * own postclose leg; GEM only drops the pointer here. */
+	priv->job_fctx = NULL;
+	priv->job_dev = NULL;
+	drm_syncobj_manager_fini(&priv->mgr);
+	file_priv->driver_priv = NULL;
+	kfree(priv);
+}
+
+/* T720 product ID (MIDGARD T720 = 0x720, same decode as kbase gpuprops). */
+#define P7580_GPU_PROD_ID		0x720u
+
+/* Caps mirrored from the jobs slice (p7580_submit limits): counts above
+ * these are -EINVAL before any copy_from_user runs. */
+#define P7580_SUBMIT_BO_MAX		64u
+#define P7580_SUBMIT_IN_SYNC_MAX	16u
+
+int panfrost_ioctl_get_param(struct drm_device *dev, void *data,
+			     struct drm_file *file_priv)
+{
+	struct drm_panfrost_get_param *args = data;
+
+	(void)dev;
+	(void)file_priv;
+	/* ABI gate: run the build-time checks on every call path so a
+	 * header drift cannot slip past an unbuilt TU. Cheap (constant). */
+	p7580_abi_check_get_param();
+	/* Mesa 20.3 panfrost_query_raw zeroes the struct, sets param, and
+	 * issues the IOWR(0x44/16 B) ioctl; non-PROD_ID probes arrive with
+	 * pad == 0 and must fail -EINVAL (NOT success-with-garbage): the
+	 * caller asserts !required and falls back to compiled-in defaults.
+	 * Upstream v5.2 panfrost_ioctl_get_param has the identical gate. */
+	if (args->param != DRM_PANFROST_PARAM_GPU_PROD_ID)
+		return -EINVAL;
+	if (args->pad)
+		return -EINVAL;
+	args->value = P7580_GPU_PROD_ID;
+	args->pad = 0;
+	return 0;
+}
+
+int panfrost_ioctl_create_bo(struct drm_device *dev, void *data,
+			     struct drm_file *file_priv)
+{
+	struct drm_panfrost_create_bo *args = data;
+	struct p7580_dev *gd = dev->dev_private;
+	struct drm_gem_object *obj;
+	struct p7580_bo *bo;
+	uint32_t handle;
+	int ret;
+
+	if (args->flags)
+		return -EINVAL;
+	if (!args->size)
+		return -EINVAL;
+
+	/* SHMEM for general BOs (upstream panfrost uses drm_gem_shmem;
+	 * CMA carries no size beyond the display window and fails 8 MiB+
+	 * via dma_alloc_attrs -> swiotlb ENOMEM, blocking Mesa's 16 MiB
+	 * tiler heap. CMA stays available for explicit WC scanout only,
+	 * selected via p7580_gem_create_with_handle, never here). */
+	ret = p7580_gem_create(gd, dev, args->size, P7580_BO_SHMEM,
+			       P7580_GEM_WC, &obj);
+	if (ret)
+		return ret;
+	ret = drm_gem_handle_create(file_priv, obj, &handle);
+	if (ret) {
+		drm_gem_object_unreference_unlocked(obj);
+		return ret;
+	}
+	/* Handle holds the reference now. */
+	drm_gem_object_unreference_unlocked(obj);
+
+	bo = to_p7580_bo(obj);
+	args->handle = handle;
+	args->offset = (uint64_t)bo->iova;
+	return 0;
+}
+
+int panfrost_ioctl_mmap_bo(struct drm_device *dev, void *data,
+			   struct drm_file *file_priv)
+{
+	struct drm_panfrost_mmap_bo *args = data;
+	struct drm_gem_object *obj;
+	unsigned long fake_offset;
+
+	if (args->flags)
+		return -EINVAL;
+
+	/* drm_gem_object_lookup takes the reference internally (no
+	 * outer struct_mutex needed; lookup is idr + kref_get). */
+	obj = drm_gem_object_lookup(dev, file_priv, args->handle);
+	if (!obj)
+		return -ENOENT;
+	/* Same fake-offset encoding as drm_gem_cma_dumb_map_offset:
+	 * map_list.hash.key << PAGE_SHIFT (drm_gem_cma_helper.c). */
+	fake_offset = (unsigned long)obj->map_list.hash.key << PAGE_SHIFT;
+	drm_gem_object_unreference_unlocked(obj);
+
+	args->offset = (uint64_t)fake_offset;
+	return 0;
+}
+
+int panfrost_ioctl_get_bo_offset(struct drm_device *dev, void *data,
+				 struct drm_file *file_priv)
+{
+	struct drm_panfrost_get_bo_offset *args = data;
+	struct drm_gem_object *obj;
+	struct p7580_bo *bo;
+
+	if (args->pad)
+		return -EINVAL;
+
+	obj = drm_gem_object_lookup(dev, file_priv, args->handle);
+	if (!obj)
+		return -ENOENT;
+	bo = to_p7580_bo(obj);
+	args->offset = (uint64_t)bo->iova;
+	drm_gem_object_unreference_unlocked(obj);
+	return 0;
+}
+
+int panfrost_ioctl_wait_bo(struct drm_device *dev, void *data,
+			   struct drm_file *file_priv)
+{
+	struct drm_panfrost_wait_bo *args = data;
+	struct timespec now;
+	int64_t remain_ns;
+	long timeout;
+
+	if (args->pad)
+		return -EINVAL;
+	/* F-IO2: v5.2 timeout_ns is ABSOLUTE (CLOCK_MONOTONIC). Convert
+	 * to a relative jiffies budget via the monotonic clock; a past
+	 * or zero stamp stays non-blocking (0), matching the old
+	 * <= 0 arm. ktime_get_ts is the 3.10 spelling (no ktime_get_ns
+	 * export used in-tree on this kernel). */
+	ktime_get_ts(&now);
+	remain_ns = (int64_t)args->timeout_ns -
+		    ((int64_t)now.tv_sec * 1000000000LL + now.tv_nsec);
+	if (remain_ns <= 0)
+		timeout = 0;
+	else if ((uint64_t)remain_ns > (uint64_t)LONG_MAX)
+		timeout = LONG_MAX;
+	else
+		timeout = nsecs_to_jiffies((uint64_t)remain_ns);
+
+	timeout = p7580_gem_wait(dev, file_priv, args->handle, timeout, 1);
+	if (timeout < 0)
+		return (int)timeout;
+	return 0;
+}
+/* DEBUG-ONLY (gpu31-gpuwrite, strip before cutover): kernel-side BO
+ * word readback after completion. Same maintenance as the pre-signal
+ * IRQ path (p7580_gem_debug_read_word calls p7580_gem_job_done_sync),
+ * so the kernel view cannot reproduce the userspace-alias ambiguity.
+ * Plain static enable: always on while the ticket is open; the cutover
+ * deletes this function + its 0xCF route. No MMIO, no sleeps. */
+struct p7580_debug_read_bo {
+	uint32_t handle;
+	uint32_t offset;	/* byte offset of the u32 to read */
+	uint32_t value;		/* OUT: u32 at that offset */
+	uint32_t pad;		/* must be zero */
+};
+int panfrost_debug_read_bo(struct drm_device *dev, void *data,
+			   struct drm_file *file_priv)
+{
+	struct p7580_debug_read_bo *args = data;
+	struct drm_gem_object *obj;
+	uint32_t v = 0;
+	int ret;
+
+	if (args->pad)
+		return -EINVAL;
+	obj = drm_gem_object_lookup(dev, file_priv, args->handle);
+	if (!obj)
+		return -ENOENT;
+	ret = p7580_gem_debug_read_word(obj, args->offset, &v);
+	drm_gem_object_unreference_unlocked(obj);
+	if (ret)
+		return ret;
+	args->value = v;
+	return 0;
+}
+
+/* SUBMIT: validate-only in this slice is over -- full dispatch goes to
+ * the jobs core, with user arrays staged on the stack first. */
+int panfrost_ioctl_submit(struct drm_device *dev, void *data,
+			  struct drm_file *file_priv)
+{
+	struct drm_panfrost_submit *args = data;
+	struct p7580_file_priv *priv = file_priv->driver_priv;
+	uint32_t bo_handles[P7580_SUBMIT_BO_MAX];
+	uint32_t in_syncs[P7580_SUBMIT_IN_SYNC_MAX];
+	struct p7580_submit staged;
+
+	p7580_abi_check_submit();
+	p7580_abi_check_submit_mirror();
+	if (!args->jc || (args->jc & 7u))
+		return -EINVAL;
+	if (args->requirements & ~PANFROST_JD_REQ_FS)
+		return -EINVAL;
+	if (args->in_sync_count > P7580_SUBMIT_IN_SYNC_MAX ||
+	    args->bo_handle_count > P7580_SUBMIT_BO_MAX)
+		return -EINVAL;
+	if (!priv || !priv->job_dev || !priv->job_fctx)
+		return -ENODEV;
+
+	/* Stage user arrays locally; the jobs core never touches
+	 * userspace. in_syncs/bo_handles are u32 arrays (Mesa winsys
+	 * passes __u64 pointers to u32 storage). */
+	if (args->bo_handle_count) {
+		if (!args->bo_handles ||
+		    copy_from_user(bo_handles, (void __user *)(uintptr_t)
+				   args->bo_handles,
+				   args->bo_handle_count * sizeof(uint32_t)))
+			return -EFAULT;
+	}
+	if (args->in_sync_count) {
+		if (!args->in_syncs ||
+		    copy_from_user(in_syncs, (void __user *)(uintptr_t)
+				   args->in_syncs,
+				   args->in_sync_count * sizeof(uint32_t)))
+			return -EFAULT;
+	}
+
+	staged.jc = args->jc;
+	staged.in_syncs = (uint64_t)(uintptr_t)in_syncs;
+	staged.in_sync_count = args->in_sync_count;
+	staged.out_sync = args->out_sync;
+	staged.bo_handles = (uint64_t)(uintptr_t)bo_handles;
+	staged.bo_handle_count = args->bo_handle_count;
+	staged.requirements = args->requirements;
+
+	return p7580_job_submit(priv->job_dev, priv->job_fctx, &staged);
+}
diff -u '--exclude=.git' -Naur a/drivers/gpu/drm/panfrost/panfrost7580_ioctl.h b/drivers/gpu/drm/panfrost/panfrost7580_ioctl.h
--- a/drivers/gpu/drm/panfrost/panfrost7580_ioctl.h	1969-12-31 19:00:00.000000000 -0500
+++ b/drivers/gpu/drm/panfrost/panfrost7580_ioctl.h	2026-11-21 00:00:00.000000000 -0500
@@ -0,0 +1,52 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * panfrost7580_ioctl.h - v5.2 UAPI handler prototypes for the T720 port.
+ *
+ * v5.2 reference: panfrost_drv.c:329-340 ioctl table, handlers in
+ * panfrost_gem.c/panfrost_job.c/panfrost_device.c. The table itself
+ * (DRM_IOCTL_DEF rows, DRM_RENDER_ALLOW mapping) is owned by G31_DrmCore
+ * (panfrost_ioctls_310.h); this header declares the six handler bodies
+ * implemented in panfrost7580_ioctl.c so DrmCore can reference them.
+ * Prototypes use the 3.10 drm_ioctl_t signature
+ * (int fn(struct drm_device *, void *, struct drm_file *)).
+ *
+ * File-private state behind struct drm_file->driver_priv
+ * (p7580_file_priv): per-fd syncobj manager (0003 series header) + the
+ * jobs-slice per-fd context (opaque here; owned by the jobs slice).
+ * Allocated on first ioctl that needs it, freed in the driver's
+ * .postclose hook. The real struct drm_syncobj_manager comes from
+ * drivers/gpu/drm/drm_syncobj.h (staged by the Makefile's kcheck);
+ * this header needs only the pointer width, so it forward-declares
+ * and keeps -Wall clean.
+ */
+
+#ifndef PANFROST7580_IOCTL_H
+#define PANFROST7580_IOCTL_H
+
+struct drm_device;
+struct drm_file;
+
+int panfrost_ioctl_submit(struct drm_device *dev, void *data,
+			  struct drm_file *file_priv);
+int panfrost_ioctl_wait_bo(struct drm_device *dev, void *data,
+			   struct drm_file *file_priv);
+int panfrost_ioctl_create_bo(struct drm_device *dev, void *data,
+			     struct drm_file *file_priv);
+int panfrost_ioctl_mmap_bo(struct drm_device *dev, void *data,
+			   struct drm_file *file_priv);
+int panfrost_ioctl_get_param(struct drm_device *dev, void *data,
+			     struct drm_file *file_priv);
+int panfrost_ioctl_get_bo_offset(struct drm_device *dev, void *data,
+				 struct drm_file *file_priv);
+/* DEBUG-ONLY (gpu31-gpuwrite, strip before cutover): kernel-side BO
+ * word readback after completion. Routed via the syncobj fops
+ * dispatcher (nr 0xCF), NOT the six-ioctl driver table. Takes a
+ * handle + byte offset, returns the u32 at that offset after the
+ * same completion invalidate the pre-signal IRQ path runs. */
+int panfrost_debug_read_bo(struct drm_device *dev, void *data,
+			   struct drm_file *file_priv);
+
+int p7580_file_priv_init(struct drm_device *dev, struct drm_file *file_priv);
+void p7580_file_priv_fini(struct drm_device *dev, struct drm_file *file_priv);
+
+#endif /* PANFROST7580_IOCTL_H */
diff -u '--exclude=.git' -Naur a/drivers/gpu/drm/panfrost/panfrost7580_jm_hw.h b/drivers/gpu/drm/panfrost/panfrost7580_jm_hw.h
--- a/drivers/gpu/drm/panfrost/panfrost7580_jm_hw.h	1969-12-31 19:00:00.000000000 -0500
+++ b/drivers/gpu/drm/panfrost/panfrost7580_jm_hw.h	2026-11-21 00:00:00.000000000 -0500
@@ -0,0 +1,258 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * panfrost7580_jm_hw.h - Midgard job-manager hardware interface for the
+ * T720 (Exynos 7580, j7elte) panfrost port. Pure-C (host-testable): only
+ * fixed-width types, no kernel or shim dependencies.
+ *
+ * Provenance (all values cross-checked, kbase == mainline panfrost):
+ *  [KT] Nura 3.10.108 drivers/gpu/arm/t7xx/r15p0/mali_midg_regmap.h
+ *  [ML] mainline v5.2 drivers/gpu/drm/panfrost/panfrost_regs.h
+ *  [KB] Nura 3.10.108 backend/gpu/mali_kbase_jm_hw.c (submit sequence)
+ *  [V5] mainline v5.2 drivers/gpu/drm/panfrost/panfrost_job.c (submit seq)
+ *
+ * T720 specifics baked in here (from KT hwconfig tables + live device):
+ *  - 3 job slots (gpu-verify: js_present 0x7; BASE_JM_MAX_NR_SLOTS 3)
+ *  - BASE_HW_FEATURE list for t72x has NO FLUSH_REDUCTION, NO
+ *    JOBCHAIN_DISAMBIGUATION, NO PROTECTED_MODE (features.h:72-84)
+ *  - BASE_HW_ISSUE list for t72x HAS 10649 (issues.h:566-581), so
+ *    JS_CONFIG_START_MMU is always set (same as [KB]:118 and [V5])
+ */
+#ifndef PANFROST7580_JM_HW_H
+#define PANFROST7580_JM_HW_H
+
+#ifdef __KERNEL__
+#include <linux/types.h>
+#else
+#include <stdint.h>
+#endif
+
+/* 3 slots on Midgard; T720 MP2 reports js_present == 0x7 (gpu-verify). */
+#define P7580_JM_MAX_SLOTS	3u
+
+/* ------------------------------------------------------------------ */
+/* Job control block. [KT] JOB_CONTROL_BASE 0x1000 (:199), JOB_SLOT0   */
+/* 0x800 (:210), stride 0x80 (JOB_SLOT_REG :227); [ML] JS_BASE 0x1800,  */
+/* JS_SLOT_STRIDE 0x80. Both give slot n base = 0x1800 + n*0x80.        */
+/* ------------------------------------------------------------------ */
+#define P7580_JOB_INT_RAWSTAT	0x1000u
+#define P7580_JOB_INT_CLEAR	0x1004u
+#define P7580_JOB_INT_MASK	0x1008u
+#define P7580_JOB_INT_STAT	0x100Cu
+
+#define P7580_JS_BASE		0x1800u
+#define P7580_JS_STRIDE		0x0080u
+
+/* Current (RO) view. */
+#define P7580_JS_HEAD_LO	0x00u
+#define P7580_JS_HEAD_HI	0x04u
+#define P7580_JS_TAIL_LO	0x08u
+#define P7580_JS_TAIL_HI	0x0Cu
+#define P7580_JS_COMMAND	0x20u
+#define P7580_JS_STATUS		0x24u
+
+/* NEXT (RW) view: what the driver programs before START. */
+#define P7580_JS_HEAD_NEXT_LO	0x40u
+#define P7580_JS_HEAD_NEXT_HI	0x44u
+#define P7580_JS_AFF_NEXT_LO	0x50u
+#define P7580_JS_AFF_NEXT_HI	0x54u
+#define P7580_JS_CONFIG_NEXT	0x58u
+#define P7580_JS_COMMAND_NEXT	0x60u
+#define P7580_JS_FLUSH_ID_NEXT	0x70u
+
+#define P7580_JS_REG(n, r) \
+	(P7580_JS_BASE + ((uint32_t)(n) * P7580_JS_STRIDE) + (r))
+
+/* IRQ demux. [ML] MK_JS_MASK / JOB_INT_MASK_{DONE,ERR}. */
+#define P7580_MK_JS_MASK(j)	(0x10001u << (j))
+#define P7580_JOB_DONE_BIT(j)	(1u << (j))
+#define P7580_JOB_ERR_BIT(j)	(1u << ((j) + 16))
+
+/* JS_COMMAND values. [KT]:385-392, [ML] identical. */
+#define P7580_JS_CMD_NOP	0x00u
+#define P7580_JS_CMD_START	0x01u
+#define P7580_JS_CMD_SOFT_STOP	0x02u
+#define P7580_JS_CMD_HARD_STOP	0x03u
+
+/* JS_CONFIG bits. [KT]:408-418, [ML] identical. */
+#define P7580_JS_CFG_START_FLUSH_CLEAN		(1u << 8)
+#define P7580_JS_CFG_START_FLUSH_CLEAN_INV	(3u << 8)
+#define P7580_JS_CFG_START_MMU			(1u << 10)
+#define P7580_JS_CFG_JOB_CHAIN_FLAG		(1u << 11)
+#define P7580_JS_CFG_END_FLUSH_CLEAN		(1u << 12)
+#define P7580_JS_CFG_END_FLUSH_CLEAN_INV	(3u << 12)
+#define P7580_JS_CFG_ENABLE_FLUSH_REDUCTION	(1u << 14)
+#define P7580_JS_CFG_DISABLE_DESC_WR_BK		(1u << 15)
+#define P7580_JS_CFG_THREAD_PRI(n)		((uint32_t)(n) << 16)
+
+/* GPU-level reset used by fault recovery. [KT]:452-460, [ML] GPU_CMD. */
+#define P7580_GPU_CMD			0x0030u
+#define P7580_GPU_CMD_SOFT_RESET	0x01u
+#define P7580_GPU_CMD_HARD_RESET	0x02u
+#define P7580_GPU_INT_RAWSTAT		0x0020u
+#define P7580_GPU_INT_CLEAR		0x0024u
+#define P7580_GPU_IRQ_RESET_COMPLETED	(1u << 8)
+
+/* ------------------------------------------------------------------ */
+/* Timeouts. SHIM-5S is the drm_sched shim's hardcoded dispatch        */
+/* timeout (0004 pump: msecs_to_jiffies(5000)); JOB_TIMEOUT_MS must     */
+/* stay in sync with it until the one-line wiring to sched->timeout    */
+/* lands (see jobs report). 3 s matches kbase's soft-job default       */
+/* (mali_kbase_config_defaults.h:185) and the reset default (:210).    */
+/* ------------------------------------------------------------------ */
+#define P7580_JOB_TIMEOUT_MS	5000u
+#define P7580_RESET_TIMEOUT_MS	3000u
+
+/* Slot for a submit. Matches mainline v5.2 panfrost_job_get_slot
+ * (drivers/gpu/drm/panfrost/panfrost_job.c:102-122): FS -> JS0
+ * (fragment); everything else -> JS1 (vertex/tiler). ONLY_COMPUTE ->
+ * JS2 is kernel-internal (never on the v5.2 UAPI wire).
+ *
+ * Mesa 20.3 emits two submits per batch: the vertex/tiler chain with
+ * requirements == 0 and the fragment job with PANFROST_JD_REQ_FS.
+ * The chain (WRITE_VALUE type 2, VERTEX type 5, TILER type 7) must
+ * run on JS1: on this 3-slot part a vertex/tiler chain dispatched on
+ * JS0 faults (slot 0 ERR storm, fragment slot cannot run tiler work),
+ * and every later submit faults behind it. Requirement-less therefore
+ * means JS1 -- never JS0 (gpu31-mesa-render: 120/120 Mesa submits ERR
+ * on slot 0 with req==0 routed to JS0; WRITE_VALUE alone on JS0 is
+ * DONE, proving the slot, not the job, rejects the chain). NULL jobs
+ * run on any slot, so the selftest pattern/submit tests are unaffected
+ * by the routing (they only assert fence completion). */
+#define P7580_SLOT_FRAGMENT	0
+#define P7580_SLOT_VERTEX_TILER	1
+#define P7580_SLOT_COMPUTE	2
+
+/* Requirements bits (v5.2 UAPI, panfrost_drm.h). */
+#define P7580_JD_REQ_FS		(1u << 0)
+/* Kernel-internal routing only (never on the UAPI wire at v5.2). */
+#define P7580_JD_REQ_ONLY_COMPUTE	(1u << 10)
+
+static inline int p7580_job_slot(uint32_t requirements)
+{
+	if (requirements & P7580_JD_REQ_FS)
+		return P7580_SLOT_FRAGMENT;
+	if (requirements & P7580_JD_REQ_ONLY_COMPUTE)
+		return P7580_SLOT_COMPUTE;
+	return P7580_SLOT_VERTEX_TILER;
+}
+
+/*
+ * JS_CONFIG_NEXT value for one submit on this SoC.
+ *
+ * Mirrors [KB] kbase_job_hw_submit (:102-131) minus the features T720
+ * lacks: no FLUSH_REDUCTION, no PROTECTED_MODE write-back disable, no
+ * JOBCHAIN_DISAMBIGUATION toggle (not in base_hw_features_t72x), no
+ * SKIP_CACHE_* (v5.2 UAPI cannot express them). START_MMU is set
+ * because t72x carries BASE_HW_ISSUE_10649 ([KB]:117-118, [V5] too).
+ * as_nr occupies the low bits exactly as kbase lays it down (:102).
+ */
+static inline uint32_t p7580_js_config(uint32_t as_nr)
+{
+	return (as_nr & 0xFu) |
+		P7580_JS_CFG_START_FLUSH_CLEAN_INV |
+		P7580_JS_CFG_END_FLUSH_CLEAN_INV |
+		P7580_JS_CFG_START_MMU |
+		P7580_JS_CFG_THREAD_PRI(8);
+}
+
+/* ------------------------------------------------------------------ */
+/* JS_STATUS fault decode. [KT]:418-451.                               */
+/* ------------------------------------------------------------------ */
+struct p7580_js_fault {
+	uint32_t code;
+	const char *name;
+};
+
+static const struct p7580_js_fault p7580_js_faults[] = {
+	{ 0x02u, "INTERRUPTED" },
+	{ 0x03u, "STOPPED" },
+	{ 0x04u, "TERMINATED" },
+	{ 0x40u, "CONFIG_FAULT" },
+	{ 0x41u, "POWER_FAULT" },
+	{ 0x42u, "READ_FAULT" },
+	{ 0x43u, "WRITE_FAULT" },
+	{ 0x44u, "AFFINITY_FAULT" },
+	{ 0x48u, "BUS_FAULT" },
+	{ 0x50u, "INSTR_INVALID_PC" },
+	{ 0x51u, "INSTR_INVALID_ENC" },
+	{ 0x52u, "INSTR_TYPE_MISMATCH" },
+	{ 0x53u, "INSTR_OPERAND_FAULT" },
+	{ 0x54u, "INSTR_TLS_FAULT" },
+	{ 0x55u, "INSTR_BARRIER_FAULT" },
+	{ 0x56u, "INSTR_ALIGN_FAULT" },
+	{ 0x58u, "DATA_INVALID_FAULT" },
+	{ 0x59u, "TILE_RANGE_FAULT" },
+	{ 0x5Au, "ADDRESS_RANGE_FAULT" },
+	{ 0x60u, "OUT_OF_MEMORY" },
+	{ 0x7Fu, "UNKNOWN" },
+};
+
+static inline const char *p7580_js_status_name(uint32_t status)
+{
+	unsigned int i;
+
+	for (i = 0; i < sizeof(p7580_js_faults) /
+			sizeof(p7580_js_faults[0]); i++) {
+		if (p7580_js_faults[i].code == status)
+			return p7580_js_faults[i].name;
+	}
+	return (status < 0x40u) ? "NO_EXCEPTION" : "RESERVED_FAULT";
+}
+
+/* True for fault codes that mean the slot chain is dead and the       */
+/* resume/recovery path must run (vs benign STOPPED/TERMINATED).       */
+static inline int p7580_js_status_is_fault(uint32_t status)
+{
+	return status >= 0x40u;
+}
+
+/* ------------------------------------------------------------------ */
+/* Job descriptor header (what job->jc points at). [KT]                */
+/* mali_kbase_defs.h:1689-1712, "identical for all GPU archs". 32      */
+/* bytes: 4 + 4 + 8 + 2 (bitfield bytes) + 2 + 2 + 2 + 8.               */
+/* ------------------------------------------------------------------ */
+struct p7580_job_desc {
+	uint32_t exception_status;
+	uint32_t first_incomplete_task;
+	uint64_t fault_pointer;
+	uint8_t job_descriptor_size : 1;
+	uint8_t job_type : 7;
+	uint8_t job_barrier : 1;
+	uint8_t _reserved_01 : 1;
+	uint8_t _reserved_1 : 1;
+	uint8_t _reserved_02 : 1;
+	uint8_t _reserved_03 : 1;
+	uint8_t _reserved_2 : 1;
+	uint8_t _reserved_04 : 1;
+	uint8_t _reserved_05 : 1;
+	uint16_t job_index;
+	uint16_t job_dependency_index_1;
+	uint16_t job_dependency_index_2;
+	union {
+		uint64_t _64;
+		uint32_t _32;
+	} next_job;
+};
+
+/* v5.2 SUBMIT ioctl argument, layout kept byte-identical so stock     */
+/* Mesa panfrost_dri.so is the unmodified userspace (gpu31-target).    */
+struct p7580_submit {
+	uint64_t jc;
+	uint64_t in_syncs;
+	uint32_t in_sync_count;
+	uint32_t out_sync;
+	uint64_t bo_handles;
+	uint32_t bo_handle_count;
+	uint32_t requirements;
+};
+
+/* SUBMIT jc rule (v5.2: nonzero, 8-byte aligned GPU address). Shared by */
+/* the GEM validate stub and p7580_job_submit_args so the two can never  */
+/* disagree (F-JOB1: the jobs copy had the align test inverted). Pure-C  */
+/* so the host unit test exercises the exact kernel predicate.           */
+static inline int p7580_jc_valid(uint64_t jc)
+{
+	return jc != 0 && (jc & 7u) == 0;
+}
+
+#endif /* PANFROST7580_JM_HW_H */
diff -u '--exclude=.git' -Naur a/drivers/gpu/drm/panfrost/panfrost7580_job.c b/drivers/gpu/drm/panfrost/panfrost7580_job.c
--- a/drivers/gpu/drm/panfrost/panfrost7580_job.c	1969-12-31 19:00:00.000000000 -0500
+++ b/drivers/gpu/drm/panfrost/panfrost7580_job.c	2026-11-21 00:00:00.000000000 -0500
@@ -0,0 +1,1439 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * panfrost7580_job.c - job slot management and SUBMIT path for the
+ * Mali-T720 MP2 (Exynos 7580, j7elte), Nura 3.10.108 panfrost port.
+ *
+ * Mirrors upstream v5.2 panfrost_job.c structure (slot select, hw
+ * submit, IRQ demux, timeout recovery) adapted to 3.10 + the T720:
+ *
+ *  v5.2 construct              | this port
+ *  ----------------------------+------------------------------------
+ *  NUM_JOB_SLOTS (features)    | P7580_NUM_JOB_SLOTS = 3 (js_present 0x7)
+ *  FLUSH_REDUCTION cfg/flush_id| dropped (not in t72x feature list)
+ *  JOBCHAIN_DISAMBIGUATION     | dropped (not in t72x feature list)
+ *  10649 START_MMU             | always set (t72x issue list HAS 10649)
+ *  pm_runtime get/put          | dropped (vendor pd-g3d notifier owns
+ *                              | power; M0 already resolves clocks)
+ *  devfreq record_transition   | hook point left for G31_Power (no-op here)
+ *  reservation_object (ww)     | backport dma_resv (plain mutex, 0002)
+ *  drm_syncobj (timeline)      | backport binary syncobj (0003)
+ *  drm_sched full ops          | backport FIFO shim ops (0004):
+ *                              | run_job/timedout_job/free_job only
+ *  resubmit_jobs/karma/stop    | dropped (shim has no stop/resubmit)
+ *                              | recovery restarts slots directly
+ *
+ * SHIM-CALLSITES: every call into the 0001-0004 shims below is marked
+ * with the patch number so G31_Sched/G31_DrmCore can re-verify them
+ * against the landed tree at integration.
+ * Locking: hw_lock (spinlock, IRQ-safe) serialises the HEAD/CONFIG/
+ * COMMAND sequence per slot and the in_flight[] slot assignment. The
+ * IRQ handler only touches in_flight/done_fence under that lock and
+ * never sleeps. timedout_job and p7580_job_recover run in process
+ * context (shim timeout workqueue): they take reset_lock, then
+ * hw_lock only for register pokes.
+ *
+ * Fences: each job owns exactly one ref (job->done_fence), which IS
+ * the 0004 arm-time completion fence (sched_job->fence, same pointer,
+ * shared ref): allocated once by the sched alloc_fence hook before
+ * queueing, installed on out_sync during SUBMIT, and signaled by the
+ * JOB_INT handler (or the fault-recovery path, F-JOB4). p7580_job_run
+ * binds it (never creates a second fence). job->render_done_fence is a
+ * non-owning alias of the same fence for the legacy out_sync leg; only
+ * done_fence is ever signaled or put. Fault recovery signals done_fence
+ * exactly once so waiters never hang (see p7580_job_recover).
+ */
+#include <linux/io.h>
+#include <linux/interrupt.h>
+#include <linux/spinlock.h>
+#include <linux/mutex.h>
+#include <linux/slab.h>
+#include <linux/jiffies.h>
+#include <linux/delay.h>
+#include <linux/log2.h>
+#include <linux/debugfs.h>
+#include <linux/seq_file.h>
+#include <linux/uaccess.h>
+
+/* At integration these resolve to the landed backport files:
+ *  drivers/base/{dma-fence,dma-resv}.{c,h} (0001/0002) and
+ *  drivers/gpu/drm/{drm_syncobj,drm_sched}.{c,h} (0003/0004).
+ * The -I$(STAGE)/drivers/gpu/drm form below matches the staged dir. */
+#include <linux/dma-fence.h>		/* 0001 */
+#include <linux/dma-resv.h>		/* 0002 */
+#include <drm_syncobj.h>		/* 0003 */
+#include <drm_sched.h>			/* 0004 */
+
+#include "panfrost7580_job.h"
+#include "panfrost7580_mmu.h"
+
+/* GEM completion invalidate (gem/panfrost7580_gem.c): pre-signal walk
+ * over the job's owned BO pointers. Declared here (not via gem.h) so
+ * this TU stays decoupled from the GEM BO struct layout; the linker
+ * resolves it inside the panfrost7580 module. Takes opaque void**
+ * (job->bos) + count; no refs taken or dropped. IRQ-safe. */
+void p7580_gem_job_bos_pre_signal_sync(void **bos, unsigned int bo_count);
+
+/* ------------------------------------------------------------------ */
+/* Bounded job-lifecycle tracing + always-on ERR diagnostics (errtrace). */
+/*                                                                     */
+/* p7580_job_trace = number of SUBMITs to trace from load (0 = off).   */
+/* Each traced job prints at most 4 lines: dispatch (slot, jc, cfg     */
+/* actually written to CONFIG_NEXT), post-start (RAWSTAT + JS_STATUS), */
+/* IRQ (JOB_INT_STAT bits), and fence-signal (which slot retired). The */
+/* trace budget lives in jd->trace_left and is consumed under hw_lock, */
+/* so the log volume is bounded even at Mesa frame rates (~3000 jobs/s */
+/* would otherwise spam dmesg into a DoS). Dumps use pr_info so they   */
+/* survive the default loglevel.                                       */
+/*                                                                     */
+/* ERR discipline (independent of the budget): ANY non-zero JS_STATUS  */
+/* (>= 0x40 fault) observed in the IRQ ERR leg, the DONE leg (ERR bit */
+/* set alongside DONE), or the timedout path prints a pr_err           */
+/* p7580_job: ERR line immediately, plus the HEAD/TAIL and JOB_INT     */
+/* state. Timeouts print a pr_err line too. Those lines always print   */
+/* -- the fault detail is never budget-suppressed. Normal-path lines   */
+/* (dispatch/post-start/IRQ-DONE/fence-signal) keep the old gate:      */
+/* silent once trace_left hits 0.                                      */
+/*                                                                     */
+/* Debug knobs (debugfs, armable at any time):                          */
+/*   /sys/kernel/debug/p7580/trace_arm  write N: trace_arm=N,           */
+/*     trace_left=N (re-arms the bounded trace; 0 stops it).           */
+/*   /sys/kernel/debug/p7580/dump       read: last dispatch jc/cfg/    */
+/*     as/affinity/seq + live per-slot STATUS/HEAD/TAIL +              */
+/*     JOB_INT_STAT/RAWSTAT/MASK (seq_file; safe after a fault).       */
+/* ------------------------------------------------------------------ */
+
+/* Default: trace the first 8 jobs (covers egltest startup + frames).
+ * Plain static (NOT module_param_named): the integrator's object rule
+ * defines KBUILD_MODNAME at Image link time, but the slice-level
+ * -fsyntax-only / -c checks compile this file standalone without it.
+ * Runtime tuning is the jd->trace_left budget (seeded from this). */
+#define P7580_JOB_TRACE_DEFAULT	8u
+static unsigned int p7580_job_trace = P7580_JOB_TRACE_DEFAULT;
+
+/* Always-on ERR line (+ optional ERR-MAP): prints regardless of
+ * trace_left. HEAD/TAIL are read by the caller under hw_lock and
+ * passed in to keep this helper lock-agnostic. gpu31-iova: when the
+ * faulting job carried a BO snapshot the driver-registered resolver
+ * hook renders it into a second pr_err line (recycled-IOVA alias
+ * decidable from dmesg alone); NULL hook/snapshot keeps the
+ * historic single-line form. */
+static void p7580_job_err_pin(int slot, uint32_t js_status,
+			      uint32_t job_int_stat, uint32_t rawstat,
+			      uint64_t head, uint64_t tail,
+			      unsigned int seqno, uint64_t jc,
+			      const uint32_t *sw,
+			      uint32_t cfg,
+			      int (*resolve)(void *priv, char *buf,
+					     size_t len,
+					     const uint32_t *handles,
+					     const uint64_t *addrs,
+					     const uint32_t *sizes, uint32_t n),
+			      void *resolve_priv,
+			      const uint32_t *handles,
+			      const uint64_t *addrs,
+			      const uint32_t *sizes, uint32_t n)
+{
+	char map[256];
+	int mlen = 0;
+
+	pr_err("p7580_job: ERR slot=%d js_status=0x%08x (%s) stat=0x%08x rawstat=0x%08x head=0x%llx tail=0x%llx seq=%u jc=0x%llx cfg=0x%08x sw=%08x %08x %08x %08x %08x %08x %08x %08x\n",
+		slot, js_status, p7580_js_status_name(js_status),
+		job_int_stat, rawstat,
+		(unsigned long long)head, (unsigned long long)tail,
+		seqno, (unsigned long long)jc, cfg,
+		sw ? sw[0] : 0, sw ? sw[1] : 0, sw ? sw[2] : 0, sw ? sw[3] : 0,
+		sw ? sw[4] : 0, sw ? sw[5] : 0, sw ? sw[6] : 0, sw ? sw[7] : 0);
+	if (resolve && handles && addrs && sizes && n) {
+		mlen = resolve(resolve_priv, map, sizeof(map),
+			       handles, addrs, sizes, n);
+		if (mlen > 0) {
+			map[sizeof(map) - 1] = '\0';
+			pr_err("p7580_job: ERR-MAP slot=%d seq=%u nbos=%u %s\n",
+				slot, seqno, n, map);
+		}
+	}
+}
+
+/* ------------------------------------------------------------------ */
+
+static inline void p7580_writel(struct p7580_job_dev *jd, uint32_t reg,
+				uint32_t val)
+{
+	writel(val, jd->regs + reg);
+}
+
+static inline uint32_t p7580_readl(struct p7580_job_dev *jd, uint32_t reg)
+{
+	return readl(jd->regs + reg);
+}
+/* gpu31-iova: fault-time mapping resolver registration (process
+ * context, before faults). The driver registers a hook that renders
+ * the faulting job's {handle,iova,size} snapshot into the ERR pin;
+ * the hook runs in IRQ context (no GEM dereference, no sleeping
+ * locks, no MMIO - the jobs slice never dereferences GEM objects
+ * itself). NULL fn clears. Under hw_lock (same lock as the ERR
+ * legs, so registration races no in-flight pin). */
+void p7580_job_set_iova_resolver(struct p7580_job_dev *jd,
+				 int (*fn)(void *priv, char *buf, size_t len,
+					   const uint32_t *handles,
+					   const uint64_t *addrs,
+					   const uint32_t *sizes, uint32_t n),
+				 void *priv)
+{
+	unsigned long flags;
+
+	if (!jd)
+		return;
+	spin_lock_irqsave(&jd->hw_lock, flags);
+	jd->iova_resolve = fn;
+	jd->iova_resolve_priv = priv;
+	spin_unlock_irqrestore(&jd->hw_lock, flags);
+}
+
+static inline void p7580_js_write(struct p7580_job_dev *jd, int slot,
+				  uint32_t off, uint32_t val)
+{
+	p7580_writel(jd, P7580_JS_REG(slot, off), val);
+}
+
+static inline uint32_t p7580_js_read(struct p7580_job_dev *jd, int slot,
+				     uint32_t off)
+{
+	return p7580_readl(jd, P7580_JS_REG(slot, off));
+}
+
+/* ------------------------------------------------------------------ */
+/* Job fence: one ordered context per slot, monotonic seqno.           */
+/* Mirrors v5.2 panfrost_fence_create (queue/emit_seqno/fence_context) */
+/* on top of the 0001 fence ops (enable_signaling/signaled/wait/      */
+/* release contract, release() calls dma_fence_release_base()).       */
+/* ------------------------------------------------------------------ */
+
+struct p7580_fence {
+	struct dma_fence base;
+	uint64_t seqno;
+	int slot;
+};
+
+static inline struct p7580_fence *to_p7580_fence(struct dma_fence *f)
+{
+	return container_of(f, struct p7580_fence, base);
+}
+
+static const char *p7580_fence_driver(struct dma_fence *f)
+{
+	(void)f;
+	return "panfrost7580";
+}
+
+static const char *p7580_fence_timeline(struct dma_fence *f)
+{
+	struct p7580_fence *pf = to_p7580_fence(f);
+
+	switch (pf->slot) {
+	case 0:
+		return "panfrost7580-js-0";
+	case 1:
+		return "panfrost7580-js-1";
+	case 2:
+		return "panfrost7580-js-2";
+	default:
+		return NULL;
+	}
+}
+
+static bool p7580_fence_enable_signaling(struct dma_fence *f)
+{
+	/* No SW-arm needed: HW IRQ is the signal source. Report "already
+	 * signaled during arming" only if the bit is already set, which
+	 * the 0001 add_callback re-checks. */
+	return dma_fence_is_signaled(f);
+}
+
+static bool p7580_fence_signaled(struct dma_fence *f)
+{
+	/* Bit test only; the IRQ sets the bit via dma_fence_signal(). */
+	return !!test_bit(DMA_FENCE_FLAG_SIGNALED_BIT, &f->flags);
+}
+
+static void p7580_fence_release(struct dma_fence *f)
+{
+	struct p7580_fence *pf = to_p7580_fence(f);
+
+	dma_fence_release_base(f);	/* 0001: frees waiter queue */
+	kfree(pf);
+}
+
+static const struct dma_fence_ops p7580_fence_ops = {
+	.get_driver_name = p7580_fence_driver,
+	.get_timeline_name = p7580_fence_timeline,
+	.enable_signaling = p7580_fence_enable_signaling,
+	.signaled = p7580_fence_signaled,
+	.wait = NULL,			/* 0001 default poll path */
+	.release = p7580_fence_release,
+};
+
+/* Caller must hold no locks; returns ERR_PTR on OOM. seqno_out is the
+ * per-slot emit counter owned by the sched slice (jd->emit_seqno). */
+static struct dma_fence *p7580_fence_create(struct p7580_job_dev *jd,
+					    int slot, uint64_t *seqno_out)
+{
+	struct p7580_fence *pf;
+
+	pf = kzalloc(sizeof(*pf), GFP_KERNEL);
+	if (!pf)
+		return ERR_PTR(-ENOMEM);
+
+	pf->slot = slot;
+	pf->seqno = ++(*seqno_out);
+
+	/* 0001 provides dma_fence_init (F1/F2 fixed): centralised
+	 * kref/completion/cb_list/cb_lock/flags + ops/context/seqno. */
+	dma_fence_init(&pf->base, &p7580_fence_ops,
+		       jd->fence_ctx[slot], (unsigned)pf->seqno);
+	return &pf->base;
+}
+
+static void p7580_job_debugfs_init(struct p7580_job_dev *jd);
+static void p7580_job_debugfs_fini(struct p7580_job_dev *jd);
+
+/* ------------------------------------------------------------------ */
+/* Device init/fini                                                   */
+/* ------------------------------------------------------------------ */
+
+int p7580_job_dev_init(struct p7580_job_dev *jd, void __iomem *regs,
+		       uint32_t js_present, uint64_t shader_present,
+		       dma_addr_t pgd_dma, void *pm_dev,
+		       int (*pm_get)(void *dev), void (*pm_put)(void *dev))
+{
+	int i;
+	uint32_t mask = 0;
+
+	if (!jd || !regs)
+		return -EINVAL;
+
+	jd->regs = regs;
+	jd->js_present = js_present;
+	jd->shader_present = shader_present;
+	jd->pgd_dma = pgd_dma;
+	jd->pm_dev = pm_dev;
+	jd->pm_get = pm_get;
+	jd->pm_put = pm_put;
+	spin_lock_init(&jd->hw_lock);
+	mutex_init(&jd->reset_lock);
+	/* Arm-time fence timelines (gpu31-armfence): one dma-fence
+	 * context per slot + zeroed per-slot emit seqno, so the first
+	 * SUBMIT's alloc_fence hands out a valid (context, seqno).
+	 * dma_fence_context_alloc never fails (monotonic counter). */
+	for (i = 0; i < P7580_NUM_JOB_SLOTS; i++) {
+		jd->fence_ctx[i] = dma_fence_context_alloc(1);
+		jd->emit_seqno[i] = 0;
+	}
+	/* Snapshot the module param once: later writes change the param
+	 * but not an already-probed device (bounded by construction).
+	 * trace_arm is the re-armable source: the debugfs knob rewrites
+	 * both fields, so a re-arm survives budget exhaustion. */
+	jd->trace_left = p7580_job_trace;
+	jd->trace_arm = p7580_job_trace;
+	jd->last.valid = 0;
+	jd->dbg_dir = NULL;
+	jd->chain_mode = 0;
+	for (i = 0; i < P7580_NUM_JOB_SLOTS; i++) {
+		jd->in_flight[i] = NULL;
+		mask |= P7580_MK_JS_MASK(i);
+	}
+
+	/* Clear any stale slot IRQs (both views: CLEAR drains RAWSTAT via
+	 * the in-tree CLEAR semantics), then unmask DONE+ERR for present
+	 * slots. Per [KT] mali_midg_regmap.h:203-206 RAWSTAT is the latch
+	 * and STAT the masked AND delivered view, so an unmasked STAT is a
+	 * subset of RAWSTAT; this read-back proves CLEAR actually drained
+	 * before the first START (bounded: two extra reads at probe). */
+	p7580_writel(jd, P7580_JOB_INT_CLEAR, mask);
+	p7580_writel(jd, P7580_JOB_INT_MASK, mask & (js_present | (js_present << 16)));
+	pr_info("p7580_job: irq-arm rawstat=0x%08x stat=0x%08x mask=0x%08x js_present=0x%x\n",
+		p7580_readl(jd, P7580_JOB_INT_RAWSTAT),
+		p7580_readl(jd, P7580_JOB_INT_STAT),
+		p7580_readl(jd, P7580_JOB_INT_MASK), js_present);
+	/* Debug knobs (debugfs, armable at any time): p7580/trace_arm
+	 * (write N re-arms) + p7580/dump (read last-job + slot regs).
+	 * debugfs returns ERR_PTR(-ENODEV) when disabled: IS_ERR_OR_NULL
+	 * keeps the driver alive on non-debug builds. */
+	p7580_job_debugfs_init(jd);
+	return 0;
+}
+
+void p7580_job_dev_fini(struct p7580_job_dev *jd)
+{
+	if (!jd)
+		return;
+	p7580_job_debugfs_fini(jd);
+	/* Mask everything; the IRQ handler is freed by the caller. */
+	p7580_writel(jd, P7580_JOB_INT_MASK, 0);
+}
+
+/* Re-arm after GPU reset / runtime resume: CLEAR any bits latched
+ * while dark, then unmask DONE+ERR for present slots. Caller must
+ * hold power (probe/dev_init, resume path, recover path all do).
+ * Same CLEAR+MASK pair as dev_init without touching in_flight. */
+void p7580_job_dev_rearm(struct p7580_job_dev *jd)
+{
+	uint32_t mask = 0;
+	int i;
+
+	if (!jd)
+		return;
+	for (i = 0; i < P7580_NUM_JOB_SLOTS; i++)
+		mask |= P7580_MK_JS_MASK(i);
+	p7580_writel(jd, P7580_JOB_INT_CLEAR, mask);
+	p7580_writel(jd, P7580_JOB_INT_MASK,
+		     mask & (jd->js_present | (jd->js_present << 16)));
+}
+
+/* Idle when no slot has a queued command and no job is in flight. */
+int p7580_job_is_idle(struct p7580_job_dev *jd)
+{
+	int i;
+
+	if (!jd)
+		return 1;
+	for (i = 0; i < P7580_NUM_JOB_SLOTS; i++) {
+		if (p7580_js_read(jd, i, P7580_JS_COMMAND_NEXT))
+			return 0;
+		if (jd->in_flight[i])
+			return 0;
+	}
+	return 1;
+}
+
+/* ------------------------------------------------------------------ */
+/* HW submit: NEXT-view programming + START. Must be called with      */
+/* preemption-safe context; takes hw_lock internally. Mirrors [KB]    */
+/* kbase_job_hw_submit and [V5] panfrost_job_hw_submit with the T720  */
+/* cfg from p7580_js_config() (no FLUSH_REDUCTION / no flush_id).     */
+/* ------------------------------------------------------------------ */
+
+void p7580_job_hw_submit(struct p7580_job_dev *jd,
+			 struct p7580_submit_job *job)
+{
+	unsigned long flags;
+	uint32_t cfg;
+	int slot = job->slot;
+	uint32_t lo = (uint32_t)(job->jc & 0xFFFFFFFFu);
+	uint32_t hi = (uint32_t)(job->jc >> 32);
+
+	/* COMMAND_NEXT must be free: a stuck slot means recovery, not a
+	 * second submit on top. */
+	if (WARN_ON(p7580_js_read(jd, slot, P7580_JS_COMMAND_NEXT)))
+		return;
+
+	spin_lock_irqsave(&jd->hw_lock, flags);
+
+	p7580_js_write(jd, slot, P7580_JS_HEAD_NEXT_LO, lo);
+	p7580_js_write(jd, slot, P7580_JS_HEAD_NEXT_HI, hi);
+
+	p7580_js_write(jd, slot, P7580_JS_AFF_NEXT_LO,
+		       (uint32_t)(job->affinity & 0xFFFFFFFFu));
+	p7580_js_write(jd, slot, P7580_JS_AFF_NEXT_HI,
+		       (uint32_t)(job->affinity >> 32));
+
+	cfg = p7580_js_config(job->as_nr);
+	/* Chain-bit experiment variant A (gpu31-lastjob): when the
+	 * chain head's descriptor bit0 (job_descriptor_size/chain
+	 * marker) is set, honour it in CONFIG_NEXT. T720 has no
+	 * JOBCHAIN_DISAMBIGUATION HW, but kbase still programs the
+	 * CHAIN bit from the atom; mode 1 mirrors that. Gated by the
+	 * chain_mode knob (0 = off, stock 0x83700 behaviour). */
+	if (jd->chain_mode == 1 && (job->desc[4] & 0x1u))
+		cfg |= P7580_JS_CFG_JOB_CHAIN_FLAG;
+	p7580_js_write(jd, slot, P7580_JS_CONFIG_NEXT, cfg);
+
+	jd->in_flight[slot] = job;
+	/* Last-dispatch snapshot (always, not budget-gated): the ERR /
+	 * timeout / dump paths report the faulting job from here, so
+	 * fault detail survives budget exhaustion. Under hw_lock. The
+	 * sw[] copy is 8 plain u32 stores, IRQ-safe (no GEM deref). */
+	jd->last.valid = 1;
+	jd->last.slot = (unsigned int)slot;
+	jd->last.seqno = job->seqno;
+	jd->last.jc = job->jc;
+	jd->last.cfg = cfg;
+	jd->last.as_nr = job->as_nr;
+	jd->last.affinity = job->affinity;
+	jd->last.sw[0] = job->desc[0];
+	jd->last.sw[1] = job->desc[1];
+	jd->last.sw[2] = job->desc[2];
+	jd->last.sw[3] = job->desc[3];
+	jd->last.sw[4] = job->desc[4];
+	jd->last.sw[5] = job->desc[5];
+	jd->last.sw[6] = job->desc[6];
+	jd->last.sw[7] = job->desc[7];
+
+	/* GO. One wmb() before START: the HEAD/AFFINITY/CONFIG writes
+	 * must be visible to the JM before the command latches (same
+	 * order kbase_job_hw_submit uses; the lock alone is not a
+	 * device-store barrier on this weakly-ordered SoC). */
+	wmb();
+	p7580_js_write(jd, slot, P7580_JS_COMMAND_NEXT, P7580_JS_CMD_START);
+	/* One-shot RAWSTAT/JS_STATUS snapshot right after START (numeric,
+	 * unconditional for the first 8 dispatches only, then silent):
+	 * proves whether the slot latched the command or faulted
+	 * synchronously even if no IRQ ever arrives. Bounded: the same
+	 * jobtrace budget as the dispatch line. */
+
+	/* Bounded dispatch trace: slot, HEAD jc, and the CONFIG_NEXT
+	 * value actually written (START_MMU/FLUSH bits visible), one
+	 * line per traced job. Consumes one budget unit; IRQ + fence
+	 * prints below consume their own units, so one job costs <= 3. */
+	if (jd->trace_left) {
+		uint32_t rawstat, js_status;
+		jd->trace_left--;
+		rawstat = p7580_readl(jd, P7580_JOB_INT_RAWSTAT);
+		js_status = p7580_readl(jd, P7580_JS_REG(slot, P7580_JS_STATUS));
+		pr_info("p7580_job: dispatch slot=%d jc=0x%llx cfg=0x%08x as=%u aff=0x%llx seq=%u sw=%08x %08x %08x %08x %08x %08x %08x %08x chain_mode=%u\n",
+			slot, (unsigned long long)job->jc, cfg, job->as_nr,
+			(unsigned long long)job->affinity, job->seqno,
+			job->desc[0], job->desc[1], job->desc[2], job->desc[3],
+			job->desc[4], job->desc[5], job->desc[6], job->desc[7],
+			jd->chain_mode);
+		pr_info("p7580_job: post-start slot=%d rawstat=0x%08x js_status=0x%08x (%s)\n",
+			slot, rawstat, js_status,
+			p7580_js_status_name(js_status));
+	}
+
+	spin_unlock_irqrestore(&jd->hw_lock, flags);
+}
+/* ------------------------------------------------------------------ */
+/* IRQ handler: demux JOB_INT_STAT per slot. IRQ context: no sleeps,  */
+/* no mutexes, only spinlock + cache maintenance + fence signal +     */
+/* JOB_INT_CLEAR.                                                      */
+/*                                                                     */
+/* DONE(j): invalidate the job's BOs (pre-signal sync), then signal   */
+/*   job->done_fence (wakes sched retirement + any WAIT_BO waiters);  */
+/*   clear in_flight under hw_lock. A userspace wait returning thus   */
+/*   implies visible data (gpu31-coherency-race): the CPU invalidate   */
+/*   that used to run in free_job now runs here, before the signal.   */
+/* ERR(j): freeze the chain with COMMAND_NEXT=NOP (kbase/panfrost     */
+/*   shape) so a faulted job cannot re-issue; the timeout/recovery   */
+/*   path (process context) reads STATUS/HEAD/TAIL and resets. Here  */
+/*   just CLEAR the sticky bit(s) so the line deasserts.              */
+/*                                                                     */
+/* Completion condition (jobabi §4/§7): IRQ fires iff the slot's DONE */
+/* or ERR bit is set in JOB_INT_STAT (masked view of RAWSTAT). The   */
+/* dispatched job completes when this handler observes               */
+/* STAT & MK_JS_MASK(slot) with the DONE bit set, clears the slot    */
+/* bit(s), syncs the BOs, and dma_fence_signal()s the in-flight      */
+/* fence -- the 5 s timeout (timedout_job -> recover) only fires     */
+/* when no IRQ arrives.                                               */
+/* ------------------------------------------------------------------ */
+
+int p7580_job_irq(int irq, struct p7580_job_dev *jd)
+{
+	uint32_t status, rawstat;
+	int j;
+
+	(void)irq;
+	if (!jd)
+		return 0;	/* IRQ_NONE; int kept for request_irq shape */
+
+	rawstat = p7580_readl(jd, P7580_JOB_INT_RAWSTAT);
+	status = p7580_readl(jd, P7580_JOB_INT_STAT);
+	if (!status)
+		return 0;	/* IRQ_NONE */
+	/* Bounded entry probe (numeric, unconditional): proves the line
+	 * fired and whether RAWSTAT ever latched without STAT (mask
+	 * wrong) versus neither latched (slot never executed). */
+	pr_info("p7580_job: irq-enter rawstat=0x%08x stat=0x%08x\n",
+		rawstat, status);
+
+	for (j = 0; j < P7580_NUM_JOB_SLOTS; j++) {
+		uint32_t m = P7580_MK_JS_MASK(j);
+		uint32_t js_status;
+		int sig = 0;
+
+		/* Loop on the union of the masked (STAT) and raw
+		 * (RAWSTAT) views: if MASK ever wrongly excludes a
+		 * completed slot, RAWSTAT still demuxes it here instead
+		 * of timing out. Matches kbase_job_done's RAWSTAT tail
+		 * re-check (jm_hw.c:442-455). CLEAR drains both views. */
+		if (!((status | rawstat) & m))
+			continue;
+
+		p7580_writel(jd, P7580_JOB_INT_CLEAR, m);
+
+		if ((status | rawstat) & P7580_JOB_ERR_BIT(j)) {
+			/* Fault path: freeze the chain (NOP) so the slot
+			 * cannot re-issue; recovery runs in process
+			 * context (timedout_job -> recover). */
+			p7580_js_write(jd, j, P7580_JS_COMMAND_NEXT,
+				       P7580_JS_CMD_NOP);
+		}
+
+		if ((status | rawstat) & P7580_JOB_DONE_BIT(j)) {
+			struct p7580_submit_job *job;
+			unsigned long flags;
+			uint32_t head_lo, head_hi, tail_lo, tail_hi;
+			uint64_t head, tail;
+			unsigned int seq = 0;
+			uint64_t jc = 0;
+			const uint32_t *swp = NULL;
+			uint32_t lcfg = 0;
+			const uint32_t *eh = NULL;
+			const uint64_t *ea = NULL;
+			const uint32_t *ez = NULL;
+			uint32_t en = 0;
+
+			spin_lock_irqsave(&jd->hw_lock, flags);
+			job = jd->in_flight[j];
+			jd->in_flight[j] = NULL;
+			/* Bounded IRQ trace: raw STAT bits plus the slot
+			 * STATUS register, so DONE vs ERR vs silent-skip
+			 * is decidable from dmesg. Skipped jobs print
+			 * nothing here (no IRQ fires); executed jobs print
+			 * this line. */
+			js_status = p7580_readl(jd, P7580_JS_REG(j, P7580_JS_STATUS));
+			head_lo = p7580_readl(jd, P7580_JS_REG(j, P7580_JS_HEAD_LO));
+			head_hi = p7580_readl(jd, P7580_JS_REG(j, P7580_JS_HEAD_HI));
+			tail_lo = p7580_readl(jd, P7580_JS_REG(j, P7580_JS_TAIL_LO));
+			tail_hi = p7580_readl(jd, P7580_JS_REG(j, P7580_JS_TAIL_HI));
+			head = ((uint64_t)head_hi << 32) | head_lo;
+			tail = ((uint64_t)tail_hi << 32) | tail_lo;
+			if (job) {
+				seq = job->seqno;
+				jc = job->jc;
+				swp = job->desc;
+				/* gpu31-iova: snapshot stamped at SUBMIT
+				 * while the job owned refs; the resolver
+				 * renders it without touching GEM. */
+				eh = job->iova_handles;
+				ea = job->iova_addrs;
+				ez = job->iova_sizes;
+				en = job->iova_bo_count;
+			} else if (jd->last.valid &&
+				   jd->last.slot == (unsigned int)j) {
+				seq = jd->last.seqno;
+				jc = jd->last.jc;
+				swp = jd->last.sw;
+			}
+			if (jd->last.valid &&
+			    jd->last.slot == (unsigned int)j)
+				lcfg = jd->last.cfg;
+			/* ERR alongside DONE: always pin (never budgeted).
+			 * JS_STATUS can latch a fault code even when the
+			 * DONE bit also set (short chain / sticky bit). */
+			if (p7580_js_status_is_fault(js_status))
+				p7580_job_err_pin(j, js_status, status,
+						  rawstat, head, tail,
+						  seq, jc, swp, lcfg,
+						  jd->iova_resolve,
+						  jd->iova_resolve_priv,
+						  eh, ea, ez, en);
+			if (jd->trace_left) {
+				jd->trace_left--;
+				pr_info("p7580_job: irq slot=%d stat=0x%08x js_status=0x%08x (%s) has_job=%d\n",
+					j, status, js_status,
+					p7580_js_status_name(js_status),
+					job != NULL);
+			}
+			spin_unlock_irqrestore(&jd->hw_lock, flags);
+			/* Coherency-race fix: invalidate the job's BOs BEFORE
+			 * the fence signals, so any waiter woken by the
+			 * signal (WAIT_BO dma_resv_wait, syncobj WAIT,
+			 * sched finish_cb) observes GPU-written bytes.
+			 * p7580_gem_job_bos_pre_signal_sync walks
+			 * job->bos/bo_count with dma_sync_single_for_cpu per
+			 * bound SHMEM page (no MMIO, no sleeps, no locks:
+			 * dcache-line ops + dsb only, IRQ-safe; the swiotlb
+			 * leg is the identity fast path). free_job keeps a
+			 * second (post-signal) job_done_sync + unref walk --
+			 * belt and braces for waiters that attach after the
+			 * free (mmap/CPU reads), and for paths where the
+			 * IRQ never fires (recover signals instead; see
+			 * timedout/recover below). */
+			if (job && job->bo_count && job->bos)
+				p7580_gem_job_bos_pre_signal_sync(job->bos,
+								  job->bo_count);
+			if (job && job->done_fence) {
+				sig = dma_fence_signal((struct dma_fence *)job->done_fence); /* 0001 */
+				/* Bounded fence-signal trace: 0 = first
+				 * signal (normal retire), -EINVAL =
+				 * already signaled (IRQ/timeout race,
+				 * idempotent by design). */
+				if (jd->trace_left) {
+					unsigned long f;
+
+					spin_lock_irqsave(&jd->hw_lock, f);
+					if (jd->trace_left) {
+						jd->trace_left--;
+						pr_info("p7580_job: fence signal slot=%d seq=%u sig_rc=%d\n",
+							j, job->seqno, sig);
+					}
+					spin_unlock_irqrestore(&jd->hw_lock, f);
+				}
+			}
+		} else if ((status | rawstat) & P7580_JOB_ERR_BIT(j)) {
+			/* ERR without DONE: ALWAYS pin (never budgeted) so
+			 * faults are visible even when no fence retires
+			 * here (recovery signals it in process context).
+			 * The bounded irq-err trace stays for the
+			 * budget-gated startup detail. */
+			unsigned long flags;
+			uint32_t es;
+			uint32_t head_lo, head_hi, tail_lo, tail_hi;
+			uint64_t head, tail;
+			unsigned int seq = 0;
+			uint64_t jc = 0;
+			const uint32_t *swp = NULL;
+			uint32_t lcfg = 0;
+			const uint32_t *eh = NULL;
+			const uint64_t *ea = NULL;
+			const uint32_t *ez = NULL;
+			uint32_t en = 0;
+
+			spin_lock_irqsave(&jd->hw_lock, flags);
+			es = p7580_readl(jd, P7580_JS_REG(j, P7580_JS_STATUS));
+			head_lo = p7580_readl(jd, P7580_JS_REG(j, P7580_JS_HEAD_LO));
+			head_hi = p7580_readl(jd, P7580_JS_REG(j, P7580_JS_HEAD_HI));
+			tail_lo = p7580_readl(jd, P7580_JS_REG(j, P7580_JS_TAIL_LO));
+			tail_hi = p7580_readl(jd, P7580_JS_REG(j, P7580_JS_TAIL_HI));
+			head = ((uint64_t)head_hi << 32) | head_lo;
+			tail = ((uint64_t)tail_hi << 32) | tail_lo;
+			if (jd->in_flight[j]) {
+				seq = jd->in_flight[j]->seqno;
+				jc = jd->in_flight[j]->jc;
+				swp = jd->in_flight[j]->desc;
+				eh = jd->in_flight[j]->iova_handles;
+				ea = jd->in_flight[j]->iova_addrs;
+				ez = jd->in_flight[j]->iova_sizes;
+				en = jd->in_flight[j]->iova_bo_count;
+			} else if (jd->last.valid &&
+				   jd->last.slot == (unsigned int)j) {
+				seq = jd->last.seqno;
+				jc = jd->last.jc;
+				swp = jd->last.sw;
+			}
+			if (jd->last.valid &&
+			    jd->last.slot == (unsigned int)j)
+				lcfg = jd->last.cfg;
+			p7580_job_err_pin(j, es, status, rawstat,
+					  head, tail, seq, jc,
+					  swp, lcfg,
+					  jd->iova_resolve,
+					  jd->iova_resolve_priv,
+					  eh, ea, ez, en);
+			if (jd->trace_left) {
+				jd->trace_left--;
+				pr_info("p7580_job: irq-err slot=%d stat=0x%08x js_status=0x%08x (%s)\n",
+					j, status, es,
+					p7580_js_status_name(es));
+			}
+			spin_unlock_irqrestore(&jd->hw_lock, flags);
+		}
+		status &= ~m;
+	}
+	return 1;	/* IRQ_HANDLED */
+}
+
+/* ------------------------------------------------------------------ */
+/* Scheduler backend (0004 ops: alloc_fence / run_job / timedout_job  */
+/* / free_job). The 0004 shim also supports add_dependency via fence   */
+/* callbacks; in_sync + implicit BO fences are attached as shim        */
+/* dependencies by the SUBMIT path before drm_sched_job_submit().     */
+/* Arm-time contract (gpu31-armfence): alloc_fence runs once per job  */
+/* at arm time (before queueing); the fence it returns IS             */
+/* sched_job->fence (installed on out_sync during SUBMIT). run_job    */
+/* binds that same fence onto the submit job (one shared ref, never  */
+/* a second allocation) and programs the slot; the IRQ / timeout      */
+/* paths signal it.                                                   */
+/* ------------------------------------------------------------------ */
+
+/* Allocate the job's completion fence (0004 alloc_fence hook): one
+ * ordered-context fence per slot submission, monotonic per-slot seqno.
+ * This is the ONLY fence allocation for the job; run_job binds the
+ * returned fence instead of creating another one. */
+struct dma_fence *p7580_job_alloc_fence(struct p7580_job_dev *jd,
+					int slot, uint64_t *seqno_out)
+{
+	return p7580_fence_create(jd, slot, seqno_out);
+}
+
+void *p7580_job_run(struct p7580_job_dev *jd, struct p7580_submit_job *job)
+{
+	struct dma_fence *fence = (struct dma_fence *)job->done_fence;
+
+	/* Bind the arm-time fence: the sched job's fence (already on
+	 * out_sync since SUBMIT) becomes this submit job's done_fence
+	 * (one shared ref, no second allocation). A NULL bind means
+	 * arm failed closed: fail the dispatch (F4 path frees it). */
+	if (!fence)
+		return ERR_PTR(-ENODATA);
+	dma_fence_get(fence);			/* 0001: void, NULL-safe */
+	job->done_fence = fence;
+
+	p7580_job_hw_submit(jd, job);
+	/* Non-owning alias: consumers (sched/out-sync) must take their
+	 * own ref (e.g. syncobj replace takes one). Under the arm-time
+	 * contract this aliases the same fence installed at SUBMIT. */
+	job->render_done_fence = fence;
+	return fence;
+}
+
+void p7580_job_free(struct p7580_submit_job *job)
+{
+	uint32_t i;
+
+	if (!job)
+		return;
+	if (job->in_fences) {
+		for (i = 0; i < job->in_fence_count; i++)
+			dma_fence_put((struct dma_fence *)job->in_fences[i]); /* 0001 */
+		kfree(job->in_fences);
+	}
+	/* done_fence owns the single run_job ref; render_done_fence is
+	 * only an alias (F-JOB3), so clear it without putting. */
+	job->render_done_fence = NULL;
+	if (job->done_fence) {
+		dma_fence_put((struct dma_fence *)job->done_fence); /* 0001 */
+		job->done_fence = NULL;
+	}
+	kfree(job->bos);
+	kfree(job->bo_handles);
+	kfree(job->iova_handles);
+	kfree(job->iova_addrs);
+	kfree(job->iova_sizes);
+	job->bos = NULL;
+	job->bo_handles = NULL;
+	job->iova_handles = NULL;
+	job->iova_addrs = NULL;
+	job->iova_sizes = NULL;
+	job->iova_bo_count = 0;
+	kfree(job);
+}
+/*
+ * Timeout: the per-job delayed_work in the 0004 shim fires when the
+ * done_fence has not signaled within P7580_JOB_TIMEOUT_MS of dispatch.
+ * Runs in process context (workqueue), so it may sleep for reset.
+ * Spurious if the IRQ just signaled -> bail out.
+ *
+ * SUBMIT-DEADLOCK FIX: after recovery, signal this job's own fence if
+ * it is still pending. Recovery latches jd->in_flight[slot], which may
+ * be a *different* (newer) job than the one that timed out -- e.g. the
+ * stuck slot swallowed a START (hw_submit WARN_ON bail leaves the new
+ * fence unsignaled and the job out of flight). Without this, that fence
+ * never signals: no second timeout re-arms it and its finish_cb never
+ * fires. The signal is bounded (one timeout period + one recovery) and
+ * idempotent (guarded by is_signaled, same F-JOB4 precedent); the 0001
+ * fence carries no error state, so a plain signal marks completion and
+ * the fault status stays in the kernel log for the Mesa retry decision.
+ */
+void p7580_job_timedout(struct p7580_job_dev *jd,
+			struct p7580_submit_job *job)
+{
+	struct dma_fence *f = (struct dma_fence *)job->done_fence;
+	uint32_t status;
+	int slot = job->slot;
+
+	if (f && dma_fence_is_signaled(f)) /* 0001 */
+		return;
+
+	status = p7580_js_read(jd, slot, P7580_JS_STATUS);
+	/* Always-on timeout line (never budgeted): slot + JS_STATUS +
+	 * JOB_INT views + HEAD/TAIL + last-dispatch jc, so a silent
+	 * slot (no IRQ at all) is still diagnosable after the budget
+	 * is out. Process context: plain reads, no lock needed for
+	 * the registers; last snapshot is stable (only hw_submit under
+	 * hw_lock writes it, and this slot is stuck). */
+	{
+		uint32_t t_stat, t_raw;
+		uint32_t h_lo, h_hi, t_lo, t_hi;
+		uint64_t head, tail;
+
+		t_stat = p7580_readl(jd, P7580_JOB_INT_STAT);
+		t_raw = p7580_readl(jd, P7580_JOB_INT_RAWSTAT);
+		h_lo = p7580_readl(jd, P7580_JS_REG(slot, P7580_JS_HEAD_LO));
+		h_hi = p7580_readl(jd, P7580_JS_REG(slot, P7580_JS_HEAD_HI));
+		t_lo = p7580_readl(jd, P7580_JS_REG(slot, P7580_JS_TAIL_LO));
+		t_hi = p7580_readl(jd, P7580_JS_REG(slot, P7580_JS_TAIL_HI));
+		head = ((uint64_t)h_hi << 32) | h_lo;
+		tail = ((uint64_t)t_hi << 32) | t_lo;
+		pr_err("p7580_job: TIMEOUT slot=%d js_status=0x%08x (%s) stat=0x%08x rawstat=0x%08x head=0x%llx tail=0x%llx seq=%u jc=0x%llx cfg=0x%08x sw=%08x %08x %08x %08x %08x %08x %08x %08x\n",
+			slot, status, p7580_js_status_name(status),
+			t_stat, t_raw,
+			(unsigned long long)head, (unsigned long long)tail,
+			job->seqno, (unsigned long long)job->jc,
+			(jd->last.valid && jd->last.slot == (unsigned int)slot) ? jd->last.cfg : 0,
+			job->desc[0], job->desc[1], job->desc[2], job->desc[3],
+			job->desc[4], job->desc[5], job->desc[6], job->desc[7]);
+		/* gpu31-iova: same mapping line as the ERR pin (process
+		 * context here, but the hook is IRQ-safe anyway). */
+		if (jd->iova_resolve && job->iova_handles &&
+		    job->iova_addrs && job->iova_sizes &&
+		    job->iova_bo_count) {
+			char tmap[256];
+			int tlen = jd->iova_resolve(
+				jd->iova_resolve_priv, tmap, sizeof(tmap),
+				job->iova_handles, job->iova_addrs,
+				job->iova_sizes, job->iova_bo_count);
+			if (tlen > 0) {
+				tmap[sizeof(tmap) - 1] = '\0';
+				pr_err("p7580_job: ERR-MAP slot=%d seq=%u nbos=%u %s\n",
+					slot, job->seqno,
+					job->iova_bo_count, tmap);
+			}
+		}
+	}
+	p7580_job_recover(jd, slot, status);
+
+	/* Bounded-completion guarantee: recovery signals the job latched in
+	 * in_flight[slot], which may differ from this timed-out job (see
+	 * above). If ours is still pending, sync its BOs first, then signal
+	 * it here so its finish_cb/syncobj/WAIT_BO waiters wake within one
+	 * timeout plus one recovery instead of hanging forever, and with
+	 * visible data (same pre-signal order as the IRQ DONE path).
+	 * Idempotent: the IRQ or a concurrent recover may have signaled it
+	 * first. Process context here, but the helper is IRQ-safe anyway. */
+	f = (struct dma_fence *)job->done_fence;
+	if (f && !dma_fence_is_signaled(f)) { /* 0001 */
+		if (job->bo_count && job->bos)
+			p7580_gem_job_bos_pre_signal_sync(job->bos,
+							  job->bo_count);
+		dma_fence_signal(f); /* 0001 */
+	}
+}
+/* ------------------------------------------------------------------ */
+/* SUBMIT ioctl body. Steps (mirrors v5.2 panfrost_job_push, adapted  */
+/* to the 0002/0003/0004 shims):                                       */
+/*  1. validate jc/requirements/handles (8-byte jc align, slot legal) */
+/*  2. resolve in_sync handles -> fences (0003 find_fence)            */
+/*  3. attach fences as sched dependencies (0004 add_dependency)      */
+/*  4. reserve BOs, attach excl fence on completion (0002)            */
+/*  5. submit to per-slot entity (0004 job_alloc/arm/submit): the arm */
+/*     allocates the completion fence, installed on out_sync below    */
+/*  6. install arm-time out_sync fence (0003 replace_fence)            */
+/*                                                                    */
+/* BO lookup / resv lock / syncobj table live in the GEM + DrmCore    */
+/* slices; this file takes them as callbacks so -c compiles standalone.*/
+/* ------------------------------------------------------------------ */
+
+struct p7580_submit_ctx {
+	/* GEM slice: handle -> (resv + vm mapping). */
+	int (*bo_reserve)(void *priv, uint32_t handle, void **resv);
+	void *priv;
+	/* DrmCore slice: syncobj handle -> fence. */
+	struct dma_fence *(*sync_find)(void *priv, uint32_t handle);
+	int (*sync_replace)(void *priv, uint32_t handle,
+			    struct dma_fence *fence);
+	void *sync_priv;
+	/* Sched slice: alloc + add_dependency + submit on slot entity. */
+	int (*sched_submit)(void *priv, int slot,
+			    struct p7580_submit_job *job);
+	void *sched_priv;
+	/* MMU slice: validate that jc is mapped for as_nr. */
+	int (*jc_validate)(void *priv, uint64_t jc, uint32_t as_nr);
+	void *mm_priv;
+};
+
+int p7580_job_submit_args(struct p7580_job_dev *jd, struct p7580_file_ctx *fc,
+			  const struct p7580_submit *args,
+			  struct p7580_submit_ctx *ops)
+{
+	struct p7580_submit_job *job;
+	uint32_t i;
+	int slot, ret;
+
+	if (!jd || !fc || !args || !ops)
+		return -EINVAL;
+
+	/* 1. validate (F-JOB1: single shared predicate; jc must be
+	 * nonzero and 8-byte aligned). */
+	if (!p7580_jc_valid(args->jc))
+		return -EINVAL;
+	if (args->requirements & ~(P7580_JD_REQ_FS |
+				   P7580_JD_REQ_ONLY_COMPUTE))
+		return -EINVAL;
+	if (args->in_sync_count > P7580_MAX_IN_SYNCS)
+		return -EINVAL;
+	if (args->bo_handle_count > P7580_MAX_SUBMIT_BOS)
+		return -EINVAL;
+
+	slot = p7580_job_slot(args->requirements);
+	if (slot < 0 || slot >= P7580_NUM_JOB_SLOTS)
+		return -EINVAL;
+	if (!(jd->js_present & (1u << slot)))
+		return -ENODEV;
+
+	job = kzalloc(sizeof(*job), GFP_KERNEL);
+	if (!job)
+		return -ENOMEM;
+
+	job->seqno = fc->next_seqno++;
+	job->slot = slot;
+	job->jc = args->jc;
+	job->requirements = args->requirements;
+	job->as_nr = 0;	/* single address space; Mmu slice owns numbering */
+	job->affinity = jd->shader_present;
+
+	/* MMU slice validates the descriptor address before HW sees it. */
+	if (ops->jc_validate) {
+		ret = ops->jc_validate(ops->mm_priv, job->jc, job->as_nr);
+		if (ret) {
+			kfree(job);
+			return ret;
+		}
+	}
+
+	/* 2. explicit in-fences. The ioctl layer stages plain u32 arrays
+	 * into kernel memory first (copy_from_user there); by the time
+	 * this runs, args->in_syncs points at kernel memory local to the
+	 * caller, so plain indexed loads apply and no __user dereference
+	 * happens here (F-JOB2). */
+	if (args->in_sync_count) {
+		const uint32_t *hs =
+			(const uint32_t *)(uintptr_t)args->in_syncs;
+
+		job->in_fences = kcalloc(args->in_sync_count,
+					 sizeof(*job->in_fences), GFP_KERNEL);
+		if (!job->in_fences) {
+			kfree(job);
+			return -ENOMEM;
+		}
+		for (i = 0; i < args->in_sync_count; i++) {
+			struct dma_fence *f;
+
+			if (!ops->sync_find) {
+				ret = -ENOSYS;
+				goto err;
+			}
+			f = ops->sync_find(ops->sync_priv, hs[i]);
+			if (!f) {
+				ret = -ENOENT;
+				goto err;
+			}
+			job->in_fences[job->in_fence_count++] = f;
+		}
+	}
+
+	/* 3-5. BO reserve + sched submit (delegated to GEM/Sched; the    */
+	/* dependency/fence wiring contract is asserted by the host unit */
+	/* test in job_test.c). */
+	if (args->bo_handle_count) {
+		const uint32_t *uh =
+			(const uint32_t *)(uintptr_t)args->bo_handles;
+
+		job->bo_handles = kcalloc(args->bo_handle_count,
+					  sizeof(*job->bo_handles),
+					  GFP_KERNEL);
+		if (!job->bo_handles) {
+			ret = -ENOMEM;
+			goto err;
+		}
+		/* Plain copy: already kernel memory staged by the ioctl
+		 * layer (F-JOB2); no userspace access here. */
+		for (i = 0; i < args->bo_handle_count; i++)
+			job->bo_handles[i] = uh[i];
+		job->bo_count = args->bo_handle_count;
+		if (ops->bo_reserve) {
+			for (i = 0; i < job->bo_count; i++) {
+				void *resv;
+				ret = ops->bo_reserve(ops->priv,
+						      job->bo_handles[i],
+						      &resv);
+				if (ret)
+					goto err;
+			}
+		}
+	}
+
+	if (!ops->sched_submit) {
+		ret = -ENOSYS;
+		goto err;
+	}
+	ret = ops->sched_submit(ops->sched_priv, slot, job);
+	if (ret)
+		goto err;
+
+	/* 6. out-sync: install the arm-time fence (sched_job->fence is
+	 * already allocated at arm time, before queueing). render alias
+	 * is fine: replace takes its own ref on the fence. */
+	if (args->out_sync && ops->sync_replace) {
+		ret = ops->sync_replace(ops->sync_priv, args->out_sync,
+					(struct dma_fence *)job->render_done_fence);
+		if (ret)
+			goto err;
+	}
+
+	return 0;
+
+err:
+	p7580_job_free(job);
+	return ret;
+}
+/* Legacy name kept for the report/ioctl table. */
+int p7580_job_submit(struct p7580_job_dev *jd, struct p7580_file_ctx *fctx,
+		     const struct p7580_submit *args)
+{
+	(void)jd;
+	(void)fctx;
+	(void)args;
+	return -ENOSYS;	/* needs GEM/Sched/MMU callbacks: use submit_args */
+}
+
+/* ------------------------------------------------------------------ */
+/* Fault recovery, process context ONLY (never the IRQ handler).       */
+/* Serialises concurrent slot faults with reset_lock. The faulting    */
+/* job's done_fence is signaled exactly once here (F-JOB4): the IRQ    */
+/* path signals only DONE fences, so a faulted job would otherwise     */
+/* hang its WAIT_BO/sched-retirement waiters until the sched timeout   */
+/* re-entered recovery and still never signaled. dma_fence_signal is   */
+/* idempotent (second call returns -EINVAL), and the is_signaled      */
+/* check skips a job that completed between the fault latch and        */
+/* reset_lock. The 0001 fence carries no error state, so a plain      */
+/* signal marks completion; the fault status stays in the kernel log   */
+/* path for the retry decision (Mesa re-submits the batch).           */
+/* ------------------------------------------------------------------ */
+
+int p7580_job_recover(struct p7580_job_dev *jd, int fault_slot,
+		      uint32_t status)
+{
+	int i, ret = 0;
+	unsigned long end;
+	struct p7580_submit_job *fault_job = NULL;
+
+	if (!jd || fault_slot < 0 || fault_slot >= P7580_NUM_JOB_SLOTS)
+		return -EINVAL;
+
+	mutex_lock(&jd->reset_lock);
+	/* Latch the faulting in-flight job under hw_lock while the slot  */
+	/* is stopped: afterwards the IRQ cannot complete it into a late */
+	/* DONE signal, and a concurrent timedout_job for the same slot  */
+	/* serialises on reset_lock, so the signal below fires once. */
+	spin_lock_irq(&jd->hw_lock);
+	fault_job = jd->in_flight[fault_slot];
+	/* 1. stop the faulting slot. MULTIPLE_FAULT (GPU IRQ bit 7) is  */
+	/* read by the caller from GPU_INT_STAT; here every present slot */
+	/* that still shows a pending command is hard-stopped too. */
+	p7580_js_write(jd, fault_slot, P7580_JS_COMMAND_NEXT,
+		       P7580_JS_CMD_HARD_STOP);
+	for (i = 0; i < P7580_NUM_JOB_SLOTS; i++) {
+		if (i != fault_slot &&
+		    p7580_js_read(jd, i, P7580_JS_COMMAND_NEXT))
+			p7580_js_write(jd, i, P7580_JS_COMMAND_NEXT,
+				       P7580_JS_CMD_HARD_STOP);
+	}
+	/* Out of flight: a late DONE bit cannot signal the same fence. */
+	jd->in_flight[fault_slot] = NULL;
+	spin_unlock_irq(&jd->hw_lock);
+
+	/* 2. wait for slots to drain (sleep: workqueue context). */
+	end = jiffies + msecs_to_jiffies(P7580_RESET_TIMEOUT_MS);
+	for (i = 0; i < P7580_NUM_JOB_SLOTS; i++) {
+		while (p7580_js_read(jd, i, P7580_JS_COMMAND_NEXT)) {
+			if (time_after(jiffies, end)) {
+				ret = -ETIMEDOUT;
+				break;
+			}
+			msleep(1);
+		}
+	}
+
+	/* 3. GPU reset. Prefer SOFT; HARD if RAWSTAT never completes. */
+	p7580_writel(jd, P7580_GPU_CMD, P7580_GPU_CMD_SOFT_RESET);
+	end = jiffies + msecs_to_jiffies(P7580_RESET_TIMEOUT_MS);
+	while (!(p7580_readl(jd, P7580_GPU_INT_RAWSTAT) &
+		 P7580_GPU_IRQ_RESET_COMPLETED)) {
+		if (time_after(jiffies, end)) {
+			p7580_writel(jd, P7580_GPU_CMD,
+				     P7580_GPU_CMD_HARD_RESET);
+			break;
+		}
+		msleep(1);
+	}
+	p7580_writel(jd, P7580_GPU_INT_CLEAR, P7580_GPU_IRQ_RESET_COMPLETED);
+
+	/* 4. re-arm the slot IRQs the handler demuxes. Order mirrors
+	 * kbase_pm_clock_on (mali_kbase_pm_driver.c: MMU first, then
+	 * JOB unmask last at :1109): TRANSTAB + MEMATTR + TRANSCFG(0) +
+	 * UPDATE rebind AS0 BEFORE CLEAR+unmask, so the first post-reset
+	 * job fetches its descriptor through valid tables. Mainline
+	 * panfrost_device_resume runs the same order (gpu_soft_reset ->
+	 * power_on -> mmu_enable(0) -> job_enable_interrupts). */
+	p7580_mmu_program_as(jd->regs, 0, jd->pgd_dma,
+			     P7580_MEMATTR_KBASE_LO, P7580_MEMATTR_KBASE_HI);
+	p7580_job_dev_rearm(jd);
+
+	mutex_unlock(&jd->reset_lock);
+
+	/* 5. fault accounting (F-JOB4): signal exactly once so waiters  */
+	/* do not hang. Skip an already-signaled fence: the IRQ won the */
+	/* race and the job completed (its pre-signal sync already ran). */
+	/* Sync-before-signal here too: a faulted batch may still have */
+	/* completed some BO writes before faulting, and waiters must */
+	/* not observe torn/stale lines just because the retire path */
+	/* was recovery instead of DONE. */
+	if (fault_job && fault_job->done_fence &&
+	    !dma_fence_is_signaled( /* 0001 */
+		    (struct dma_fence *)fault_job->done_fence)) {
+		if (fault_job->bo_count && fault_job->bos)
+			p7580_gem_job_bos_pre_signal_sync(fault_job->bos,
+							  fault_job->bo_count);
+		dma_fence_signal( /* 0001 */
+			(struct dma_fence *)fault_job->done_fence);
+	}
+	(void)status;
+	return ret;
+}
+
+/* ------------------------------------------------------------------ */
+/* Debug knobs (errtrace): re-armable budget + last-job dump.          */
+/*                                                                     */
+/* trace_arm file: writing N sets both trace_arm and trace_left under  */
+/* hw_lock, so tracing restarts immediately for the next N job-events */
+/* (dispatch/post-start/IRQ/fence-signal lines). DEFINE_SIMPLE_ATTRIBUTE */
+/* keeps this to two get/set callbacks; the inode private is the      */
+/* struct p7580_job_dev (data arg of debugfs_create_file).            */
+/*                                                                     */
+/* dump file: single_open seq_file rendering the last-dispatch         */
+/* snapshot (slot/jc/cfg/as/affinity/seq) plus live per-slot           */
+/* STATUS/HEAD/TAIL and the JOB_INT_STAT/RAWSTAT/MASK views. Takes a   */
+/* runtime-PM ref via the jd->pm_get/put hooks wired at dev_init, so   */
+/* a read while autosuspended takes the snapshot-only (dark-marked)    */
+/* view instead of hitting a dark bus. No locks beyond a short         */
+/* hw_lock for the snapshot copy; register reads run outside the lock */
+/* (same discipline as the IRQ handler's register block).              */
+/* ------------------------------------------------------------------ */
+
+void p7580_job_trace_arm(struct p7580_job_dev *jd, unsigned int n)
+{
+	unsigned long flags;
+
+	if (!jd)
+		return;
+	spin_lock_irqsave(&jd->hw_lock, flags);
+	jd->trace_arm = n;
+	jd->trace_left = n;
+	spin_unlock_irqrestore(&jd->hw_lock, flags);
+	pr_info("p7580_job: trace re-armed to %u\n", n);
+}
+
+void p7580_job_chain_set(struct p7580_job_dev *jd, unsigned int mode)
+{
+	unsigned long flags;
+
+	if (!jd)
+		return;
+	if (mode > 2)
+		mode = 0;
+	spin_lock_irqsave(&jd->hw_lock, flags);
+	jd->chain_mode = mode;
+	spin_unlock_irqrestore(&jd->hw_lock, flags);
+	pr_info("p7580_job: chain_mode set to %u\n", mode);
+}
+
+int p7580_job_dump_show(struct p7580_job_dev *jd, struct seq_file *m)
+{
+	unsigned long flags;
+	struct p7580_job_last last;
+	uint32_t job_stat, job_raw, job_mask;
+	int i, pm = -ENODEV;
+
+	if (!jd || !m)
+		return -EINVAL;
+	/* Take a PM ref so the MMIO below never hits a dark bus: the
+	 * block autosuspends after PF7580_AUTOSUSPEND_MS, and a debugfs
+	 * read in process context is the normal dark victim (external
+	 * abort on the first JOB_INT read). get failure (or no PM hooks
+	 * wired yet) degrades to the snapshot-only view rather than
+	 * hanging the reader. */
+	if (jd->pm_get && jd->pm_dev)
+		pm = jd->pm_get(jd->pm_dev);
+	/* Snapshot the last dispatch under hw_lock, then read the live
+	 * registers outside it (MMIO reads must not hold a spinlock
+	 * across a dark bus). */
+	spin_lock_irqsave(&jd->hw_lock, flags);
+	last = jd->last;
+	spin_unlock_irqrestore(&jd->hw_lock, flags);
+
+	if (!pm) {
+		job_stat = p7580_readl(jd, P7580_JOB_INT_STAT);
+		job_raw = p7580_readl(jd, P7580_JOB_INT_RAWSTAT);
+		job_mask = p7580_readl(jd, P7580_JOB_INT_MASK);
+	} else {
+		job_stat = 0xdead0000u;
+		job_raw = 0xdead0000u;
+		job_mask = 0xdead0000u;
+	}
+
+	if (!last.valid) {
+		seq_printf(m, "no job yet (trace_arm=%u trace_left=%u stat=0x%08x rawstat=0x%08x mask=0x%08x%s)\n",
+			   jd->trace_arm, jd->trace_left,
+			   job_stat, job_raw, job_mask,
+			   pm ? " dark" : "");
+		if (!pm)
+			jd->pm_put(jd->pm_dev);
+		return 0;
+	}
+	seq_printf(m, "last slot=%u seq=%u jc=0x%llx cfg=0x%08x as=%u aff=0x%llx (trace_arm=%u trace_left=%u%s)\n",
+		   last.slot, last.seqno, (unsigned long long)last.jc,
+		   last.cfg, last.as_nr, (unsigned long long)last.affinity,
+		   jd->trace_arm, jd->trace_left, pm ? " dark" : "");
+	seq_printf(m, "sw %08x %08x %08x %08x %08x %08x %08x %08x\n",
+		   last.sw[0], last.sw[1], last.sw[2], last.sw[3],
+		   last.sw[4], last.sw[5], last.sw[6], last.sw[7]);
+	seq_printf(m, "job_int stat=0x%08x rawstat=0x%08x mask=0x%08x js_present=0x%x pgd=0x%llx\n",
+		   job_stat, job_raw, job_mask, jd->js_present,
+		   (unsigned long long)jd->pgd_dma);
+	for (i = 0; i < P7580_NUM_JOB_SLOTS; i++) {
+		uint32_t st, h_lo, h_hi, t_lo, t_hi;
+		uint64_t head, tail;
+
+		if (!pm) {
+			st = p7580_readl(jd, P7580_JS_REG(i, P7580_JS_STATUS));
+			h_lo = p7580_readl(jd, P7580_JS_REG(i, P7580_JS_HEAD_LO));
+			h_hi = p7580_readl(jd, P7580_JS_REG(i, P7580_JS_HEAD_HI));
+			t_lo = p7580_readl(jd, P7580_JS_REG(i, P7580_JS_TAIL_LO));
+			t_hi = p7580_readl(jd, P7580_JS_REG(i, P7580_JS_TAIL_HI));
+		} else {
+			st = 0xdead0000u;
+			h_lo = h_hi = t_lo = t_hi = 0xdead0000u;
+		}
+		head = ((uint64_t)h_hi << 32) | h_lo;
+		tail = ((uint64_t)t_hi << 32) | t_lo;
+		seq_printf(m, "slot%d status=0x%08x (%s) head=0x%llx tail=0x%llx\n",
+			   i, st, p7580_js_status_name(st),
+			   (unsigned long long)head,
+			   (unsigned long long)tail);
+	}
+	if (!pm)
+		jd->pm_put(jd->pm_dev);
+	return 0;
+}
+
+static int p7580_job_trace_get(void *data, u64 *val)
+{
+	struct p7580_job_dev *jd = data;
+
+	if (!jd || !val)
+		return -EINVAL;
+	*val = jd->trace_left;
+	return 0;
+}
+
+static int p7580_job_trace_set(void *data, u64 val)
+{
+	p7580_job_trace_arm(data, (unsigned int)val);
+	return 0;
+}
+
+DEFINE_SIMPLE_ATTRIBUTE(p7580_job_trace_fops, p7580_job_trace_get,
+			p7580_job_trace_set, "%llu\n");
+
+/* gpu31-iova: re-armable budget for the driver's map/unmap trace
+ * (p7580_iova_trace in submit.c). Same shape as trace_arm: write N
+ * re-arms, 0 stops. Registered by the driver (owns the counter);
+ * the jobs slice only owns the fops + registration helper so the
+ * knob appears beside trace_arm in the same debugfs dir. NULL-safe:
+ * get returns 0/empty when no counter is registered yet. */
+static unsigned int *p7580_job_iova_budget;
+
+static int p7580_job_iova_arm_get(void *data, u64 *val)
+{
+	(void)data;
+	if (!val)
+		return -EINVAL;
+	*val = p7580_job_iova_budget ? *p7580_job_iova_budget : 0;
+	return 0;
+}
+
+static int p7580_job_iova_arm_set(void *data, u64 val)
+{
+	(void)data;
+	if (p7580_job_iova_budget)
+		*p7580_job_iova_budget = (unsigned int)val;
+	pr_info("p7580_job: iova trace re-armed to %llu\n", val);
+	return 0;
+}
+
+DEFINE_SIMPLE_ATTRIBUTE(p7580_job_iova_arm_fops, p7580_job_iova_arm_get,
+			p7580_job_iova_arm_set, "%llu\n");
+
+void p7580_job_register_iova_budget(unsigned int *budget)
+{
+	p7580_job_iova_budget = budget;
+}
+
+static int p7580_job_chain_get(void *data, u64 *val)
+{
+	struct p7580_job_dev *jd = data;
+
+	if (!jd || !val)
+		return -EINVAL;
+	*val = jd->chain_mode;
+	return 0;
+}
+
+static int p7580_job_chain_set_k(void *data, u64 val)
+{
+	p7580_job_chain_set(data, (unsigned int)val);
+	return 0;
+}
+
+DEFINE_SIMPLE_ATTRIBUTE(p7580_job_chain_fops, p7580_job_chain_get,
+			p7580_job_chain_set_k, "%llu\n");
+
+static int p7580_job_dump_show_seq(struct seq_file *m, void *v)
+{
+	struct p7580_job_dev *jd = m->private;
+
+	(void)v;
+	return p7580_job_dump_show(jd, m);
+}
+
+static int p7580_job_dump_open(struct inode *inode, struct file *file)
+{
+	return single_open(file, p7580_job_dump_show_seq, inode->i_private);
+}
+
+static const struct file_operations p7580_job_dump_fops = {
+	.owner = THIS_MODULE,
+	.open = p7580_job_dump_open,
+	.read = seq_read,
+	.llseek = seq_lseek,
+	.release = single_release,
+};
+
+static void p7580_job_debugfs_init(struct p7580_job_dev *jd)
+{
+	struct dentry *dir, *f;
+
+	if (!jd)
+		return;
+	dir = debugfs_create_dir("p7580", NULL);
+	if (IS_ERR_OR_NULL(dir))
+		return;
+	jd->dbg_dir = dir;
+	f = debugfs_create_file("trace_arm", 0600, dir, jd,
+				&p7580_job_trace_fops);
+	if (IS_ERR_OR_NULL(f))
+		pr_info("p7580_job: trace_arm knob unavailable\n");
+	/* gpu31-iova: re-arms the driver map/unmap trace budget. */
+	f = debugfs_create_file("iova_arm", 0600, dir, jd,
+				&p7580_job_iova_arm_fops);
+	if (IS_ERR_OR_NULL(f))
+		pr_info("p7580_job: iova_arm knob unavailable\n");
+	f = debugfs_create_file("chain_mode", 0600, dir, jd,
+				&p7580_job_chain_fops);
+	if (IS_ERR_OR_NULL(f))
+		pr_info("p7580_job: chain_mode knob unavailable\n");
+	f = debugfs_create_file("dump", 0400, dir, jd,
+				&p7580_job_dump_fops);
+	if (IS_ERR_OR_NULL(f))
+		pr_info("p7580_job: dump knob unavailable\n");
+}
+
+static void p7580_job_debugfs_fini(struct p7580_job_dev *jd)
+{
+	if (!jd || !jd->dbg_dir)
+		return;
+	debugfs_remove_recursive((struct dentry *)jd->dbg_dir);
+	jd->dbg_dir = NULL;
+}
diff -u '--exclude=.git' -Naur a/drivers/gpu/drm/panfrost/panfrost7580_job.h b/drivers/gpu/drm/panfrost/panfrost7580_job.h
--- a/drivers/gpu/drm/panfrost/panfrost7580_job.h	1969-12-31 19:00:00.000000000 -0500
+++ b/drivers/gpu/drm/panfrost/panfrost7580_job.h	2026-11-21 00:00:00.000000000 -0500
@@ -0,0 +1,289 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * panfrost7580_job.h - submit-path state for the T720 panfrost port.
+ *
+ * Submitter: one open-file context owns one drm_sched_entity per job
+ * slot (NUM_JOB_SLOTS == P7580_JM_MAX_SLOTS == 3); one sched_job per
+ * SUBMIT ioctl batch; run_job programs the slot and returns the
+ * in-flight fence; JOB_INT IRQ completion signals it; timedout_job
+ * runs the slot reset + GPU resume path.
+ *
+ * The in-tree build (with __KERNEL__) sees real lock types; the host
+ * unit test (__KERNEL__ unset) sees opaque placeholders so jm_hw.h
+ * stays pure-C.
+ */
+#ifdef __KERNEL__
+#include <linux/io.h>
+#include <linux/types.h>
+#include <linux/dma-mapping.h>
+#else
+#define __iomem
+#include <stdint.h>
+#endif
+
+#ifndef PANFROST7580_JOB_H
+#define PANFROST7580_JOB_H
+
+#include "panfrost7580_jm_hw.h"
+
+#ifdef __KERNEL__
+#include <linux/types.h>
+#include <linux/dma-mapping.h>
+#include <linux/spinlock.h>
+#include <linux/mutex.h>
+#endif
+
+/* ------------------------------------------------------------------ */
+/* Driver topology                                                    */
+/* ------------------------------------------------------------------ */
+#define P7580_NUM_JOB_SLOTS	P7580_JM_MAX_SLOTS
+#define P7580_MAX_IN_SYNCS	16u	/* cap on SUBMIT in_sync_count */
+#define P7580_MAX_SUBMIT_BOS	64u	/* cap on SUBMIT bo_handle_count */
+
+/* Per-submit job: mirrors v5.2 struct panfrost_job (panfrost_job.h). */
+struct p7580_submit_job {
+	/* Atom identity for logs/dumps: SUBMIT order per file context. */
+	uint32_t seqno;
+
+	/* Routing + HW program. */
+	int slot;			/* 0..2, from requirements */
+	uint64_t jc;			/* GPU address of job descriptor */
+	uint32_t requirements;		/* PANFROST_JD_REQ_* */
+	uint32_t as_nr;			/* address space bound to slot */
+	uint64_t affinity;		/* shader-present mask */
+	uint32_t flush_id;		/* recorded, unused (no FLUSH_REDUCTION) */
+	uint32_t out_sync;		/* syncobj handle for the arm-time fence
+					 * (0 = none; validated at SUBMIT,
+					 * installed from sched_job->fence
+					 * during the ioctl) */
+	/* SUBMIT-time chain-head descriptor snapshot (gpu31-lastjob,
+	 * extended gpu31-submitsnap): the 8 words at jc, read from the
+	 * mapped descriptor BO before submit-sync (same invalidate the
+	 * completion path runs, so the snapshot sees CPU bytes).
+	 * desc[4] carries bit0 (job_descriptor_size) + type + index
+	 * for the chain_mode/dispatch consumer, desc[5] the dep pair;
+	 * the ERR/TIMEOUT/dispatch/PTEWALK lines print all 8 words
+	 * next to the fault-time bytes for the working-vs-faulting
+	 * discriminator. All zeros when the submit-time snapshot was
+	 * unavailable (cross-page jc, unmapped page, jc outside every
+	 * submitted BO). */
+	uint32_t desc[8];
+	/* gpu31-iova: BO identity snapshot for fault-time mapping dump.
+	 * Stamped at SUBMIT (stable handles + IOVA/size while the job
+	 * owns refs): iova_bo_count entries of {handle, iova, size}.
+	 * The ERR pin walks them via the driver's resolver hook (no
+	 * GEM dereference in IRQ context). */
+	uint32_t *iova_handles;
+	uint64_t *iova_addrs;
+	uint32_t *iova_sizes;
+	uint32_t iova_bo_count;
+	/* Fences. done_fence owns the arm-time fence ref and is signaled
+	 * by the JOB_INT handler (or the fault-recovery path, F-JOB4).
+	 * Under the 0004 arm-time contract done_fence IS sched_job->fence
+	 * (same pointer, shared ref); render_done_fence is kept only as a
+	 * non-owning alias for the legacy out_sync leg (F-JOB3: never
+	 * put twice). in_fences are explicit SUBMIT deps (owned here). */
+	void *done_fence;
+	void *render_done_fence;
+	void **in_fences;
+	uint32_t in_fence_count;
+	/* BO reservation set (file-private handles + resv pointers). */
+	uint32_t *bo_handles;
+	uint32_t bo_count;
+	/* Dispatch context stamped at SUBMIT (probenumeric): the async
+	 * run_job/timedout_job/free_job workers must NOT re-derive the
+	 * file state from the entity pointer (container_of(ent, ...,
+	 * entity[0]) breaks under container layouts -- int14 retired
+	 * without run_job because df came back wrong). Opaque void* so
+	 * this header stays drm-free; submit.c casts to struct
+	 * p7580_drv_file / struct p7580_drv. */
+	void *file_priv;
+	void *drv_priv;
+	/* Monotonic run_job entry count (probenumeric): incremented as
+	 * the first statement of p7580_drv_run_job, printed by free_job
+	 * as ran=N. Proves call order even if a print is lost. */
+	unsigned int run_seq;
+	/* Owned BO object pointers for the completion retire path
+	 * (F-JT2 + gpu31-coherency-race): SUBMIT stores one referenced
+	 * pointer per handle here (opaque void* so this header stays
+	 * drm-free); the IRQ handler pre-signal-syncs them with
+	 * p7580_gem_job_bos_pre_signal_sync before the fence signals,
+	 * and the driver's free_job walks them with
+	 * p7580_gem_job_done_sync and drops the refs before
+	 * p7580_job_free releases the array. NULL when the job
+	 * references no BOs. */
+	void **bos;
+};
+
+/* Per-file submit context: one sched entity per slot. */
+struct p7580_file_ctx {
+	uint32_t next_seqno;
+	void *sched_entity[P7580_NUM_JOB_SLOTS];
+	void *syncobj_mgr;		/* backport drm_syncobj_manager */
+};
+/* Last-job snapshot: what the ERR pins and the dump knob report. */
+/* Updated (under hw_lock) at every hw_submit dispatch for the next */
+/* OUTCOME print (DONE/ERR/timeout), so the fault register capture */
+/* follows the faulting submit even after the 8-job startup budget */
+/* is exhausted. Plain data: no pointers, no locks, seq_file-safe. */
+struct p7580_job_last {
+	unsigned int valid;	/* 0 until the first dispatch */
+	unsigned int slot;	/* job->slot at dispatch */
+	unsigned int seqno;	/* job->seqno at dispatch */
+	uint64_t jc;		/* GPU address latched to HEAD_NEXT */
+	uint32_t cfg;		/* CONFIG_NEXT value actually written */
+	uint32_t as_nr;		/* job->as_nr at dispatch */
+	uint64_t affinity;	/* job->affinity at dispatch */
+	uint32_t sw[8];		/* SUBMIT-time descriptor words */
+};
+#ifdef __KERNEL__
+struct p7580_job_dev {
+	void __iomem *regs;
+	uint32_t js_present;		/* from GPU_JS_PRESENT @probe */
+	uint64_t shader_present;	/* affinity source */
+	dma_addr_t pgd_dma;		/* AS0 root (set by probe; recover
+					 * rebinds it after GPU reset) */
+	struct p7580_submit_job *in_flight[P7580_NUM_JOB_SLOTS];
+	spinlock_t hw_lock;		/* serialises HEAD/CONFIG/COMMAND */
+	struct mutex reset_lock;	/* serialises fault recovery */
+	unsigned int fence_ctx[P7580_NUM_JOB_SLOTS];
+	uint64_t emit_seqno[P7580_NUM_JOB_SLOTS];
+	/* Job-lifecycle trace budget: decremented (under hw_lock) on each
+	 * dispatch / IRQ / fence-signal print, so the log stays bounded.
+	 * trace_arm is the re-armable source the trace_arm debugfs knob
+	 * writes: p7580_job_trace_arm() copies trace_arm into trace_left,
+	 * so Main/phone can re-arm tracing at any time (echo N >
+	 * .../p7580/trace_arm). Seed: P7580_JOB_TRACE_DEFAULT. */
+	unsigned int trace_left;
+	unsigned int trace_arm;
+	/* Last dispatch snapshot: rewritten (under hw_lock) at every
+	 * hw_submit, so the ERR/timeout paths always identify the
+	 * faulting job's slot/jc/cfg even after the budget is out. */
+	struct p7580_job_last last;
+	/* debugfs dir handle (drivers/gpu/drm/panfrost/p7580): owned by
+	 * job.c, created at dev_init, removed at dev_fini. Opaque void*
+	 * so this header stays dentry-free under -fsyntax-only. */
+	void *dbg_dir;
+	/* PM device + get/put hooks (driver-owned) so the dump path can
+	 * take a runtime-PM ref before touching JOB_INT/JS registers:
+	 * without it a dump read while autosuspended hits a dark bus
+	 * (external abort). Opaque void pointer plus int-returning
+	 * hooks, so this header stays device/PM-free under
+	 * -fsyntax-only. Wired by p7580_job_dev_init. */
+	void *pm_dev;
+	int (*pm_get)(void *dev);
+	void (*pm_put)(void *dev);
+	/* Chain-bit experiment (gpu31-lastjob): runtime switch, no
+	 * rebuild needed to A/B. 0 = off (both variants disabled,
+	 * submit bytes untouched); 1 = variant A (set JS_CONFIG
+	 * JOB_CHAIN_FLAG when the chain head's descriptor bit0 is
+	 * set); 2 = variant B (clear descriptor bit0, next stays
+	 * NULL, before submit-sync). Wired to the chain_mode debugfs
+	 * knob below; defaults to 0. Plain data, no locks beyond the
+	 * hw_lock writers already hold on the dispatch path. */
+	unsigned int chain_mode;
+	/* gpu31-iova: fault-time mapping resolver (ERR-pin dump).
+	 * Registered by the driver at probe; runs in IRQ context
+	 * (snapshot arrays only: no GEM dereference, no sleeping
+	 * locks, no MMIO). NULL when unregistered. */
+	int (*iova_resolve)(void *priv, char *buf, size_t len,
+			    const uint32_t *handles, const uint64_t *addrs,
+			    const uint32_t *sizes, uint32_t n);
+	void *iova_resolve_priv;
+};
+#else
+struct p7580_job_dev {
+	void *regs;
+	uint32_t js_present;
+	uint64_t shader_present;
+	struct p7580_submit_job *in_flight[P7580_NUM_JOB_SLOTS];
+	void *hw_lock;
+	void *reset_lock;
+	void *sched[P7580_NUM_JOB_SLOTS];
+	void *fence_ctx;
+};
+#endif
+
+/* ------------------------------------------------------------------ */
+/* Entry points implemented in panfrost7580_job.c (in-tree names in    */
+/* comments so the integrator can map them to drm_driver hooks).       */
+/* ------------------------------------------------------------------ */
+#ifdef __KERNEL__
+int p7580_job_dev_init(struct p7580_job_dev *jd, void __iomem *regs,
+		       uint32_t js_present, uint64_t shader_present,
+		       dma_addr_t pgd_dma, void *pm_dev,
+		       int (*pm_get)(void *dev), void (*pm_put)(void *dev));
+#else
+#include <stdint.h>
+typedef uint64_t p7580_dma_addr_t;
+int p7580_job_dev_init(struct p7580_job_dev *jd, void *regs,
+		       uint32_t js_present, uint64_t shader_present,
+		       p7580_dma_addr_t pgd_dma);
+#endif
+void p7580_job_dev_fini(struct p7580_job_dev *jd);
+/* Debug knobs (errtrace): re-arm the trace budget (copies N into both
+ * trace_arm and trace_left under hw_lock; N=0 stops tracing). Dump
+ * renders the last-dispatch snapshot + live slot registers into buf
+ * (seq_file show; returns 0, prints "no job yet" when !valid). */
+void p7580_job_trace_arm(struct p7580_job_dev *jd, unsigned int n);
+/* gpu31-iova: map/unmap trace budget knob (iova_arm). The counter
+ * lives in the driver (submit.c); this registers its address so the
+ * debugfs write path can re-arm it. NULL unregisters. */
+void p7580_job_register_iova_budget(unsigned int *budget);
+/* Chain-bit experiment knob (gpu31-lastjob): write 0/1/2 selects the
+ * variant (0 off, 1 = A set cfg CHAIN flag on desc-bit0, 2 = B clear
+ * desc bit0 via the driver's pre-submit word patch). Applied on the
+ * dispatch path under hw_lock; no rebuild needed to A/B. */
+void p7580_job_chain_set(struct p7580_job_dev *jd, unsigned int mode);
+struct seq_file;
+int p7580_job_dump_show(struct p7580_job_dev *jd, struct seq_file *m);
+/* CLEAR + unmask after reset/resume (power held by caller). */
+void p7580_job_dev_rearm(struct p7580_job_dev *jd);
+/* Program HEAD_NEXT/AFFINITY_NEXT/CONFIG_NEXT + COMMAND_NEXT=START.   */
+void p7580_job_hw_submit(struct p7580_job_dev *jd,
+			 struct p7580_submit_job *job);
+/* JOB_INT handler: demux DONE/ERR per slot (IRQ context). */
+int p7580_job_irq(int irq, struct p7580_job_dev *jd);
+
+/* Scheduler backend: alloc_fence / run_job / timedout_job / free_job.
+ * alloc_fence allocates the arm-time completion fence (the job's ONLY
+ * fence); run_job binds that same fence and programs the slot. */
+struct dma_fence;
+struct dma_fence *p7580_job_alloc_fence(struct p7580_job_dev *jd,
+					int slot, uint64_t *seqno_out);
+void *p7580_job_run(struct p7580_job_dev *jd,
+		    struct p7580_submit_job *job);
+void p7580_job_timedout(struct p7580_job_dev *jd,
+			struct p7580_submit_job *job);
+void p7580_job_free(struct p7580_submit_job *job);
+
+/* SUBMIT ioctl body: validate -> resolve syncobj deps -> reserve BOs  */
+/* -> sched submit -> install out-sync fence. args->in_syncs/bo_handles */
+/* must point at KERNEL-staged u32 arrays (the ioctl layer copies with  */
+/* copy_from_user first); this function never touches userspace         */
+/* (F-JOB2: do not pass __user pointers here). */
+int p7580_job_submit(struct p7580_job_dev *jd, struct p7580_file_ctx *fctx,
+		     const struct p7580_submit *args);
+
+/* Fault recovery: stop slots, GPU soft reset, resume (non-IRQ ctx). */
+int p7580_job_recover(struct p7580_job_dev *jd, int fault_slot,
+		      uint32_t status);
+
+/* gpu31-iova: fault-time mapping resolver. The driver registers a hook
+ * (+priv) that the ERR pin calls in IRQ context to render the faulting
+ * job's {handle,iova,size} snapshot (stamped at SUBMIT) into the pin
+ * line; NULL hook (or NULL job snapshot) prints the jc-only form. The
+ * hook must be IRQ-safe: no GEM dereference, no locks that sleep, no
+ * MMIO - the driver resolves from its bo_list snapshot. Process
+ * context (dump_show) may reuse the same hook with a bigger buffer. */
+void p7580_job_set_iova_resolver(struct p7580_job_dev *jd,
+				 int (*fn)(void *priv, char *buf, size_t len,
+					   const uint32_t *handles,
+					   const uint64_t *addrs,
+					   const uint32_t *sizes, uint32_t n),
+				 void *priv);
+
+/* Idle check for suspend/close paths. */
+int p7580_job_is_idle(struct p7580_job_dev *jd);
+
+#endif /* PANFROST7580_JOB_H */
