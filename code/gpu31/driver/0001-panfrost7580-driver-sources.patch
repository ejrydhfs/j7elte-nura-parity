+#include <linux/pm_runtime.h>
+#include <linux/slab.h>
+
+#include <drm/drmP.h>
+#include <drm/drm.h>
+
+#include <linux/dma-fence.h>		/* 0001 */
+#include <linux/dma-resv.h>		/* 0002 */
+#include <drm_syncobj.h>		/* 0003 */
+#include <drm_sched.h>			/* 0004 */
+
+#include "panfrost_drm.h"
+#include "panfrost7580_gem.h"
+#include "panfrost7580_ioctl.h"
+#include "panfrost7580_jm_hw.h"
+#include "panfrost7580_job.h"
+#include "panfrost7580_mmu.h"
+#include "panfrost7580_power.h"
+#include "panfrost7580_syncobj.h"
+#include "pf7580_devfreq.h"
+#include "panfrost7580_drv.h"
+
+/* ------------------------------------------------------------------ */
+/* MMU/GPU IRQ handlers (JOB_INT demux lives in the jobs slice)      */
+/* ------------------------------------------------------------------ */
+
+/* MMU_INT_STAT lives at MMU base + 0x0C (pf7580_as.h layout); reuse
+ * the mmu slice's AS offsets: MMU base = regs + 0x2000. Cleared via
+ * MMU_INT_CLEAR (+0x04), masked via MMU_INT_MASK (+0x08). */
+#define P7580_MMU_BASE_OFF	0x2000u
+#define P7580_MMU_INT_CLEAR	0x04u
+#define P7580_MMU_INT_MASK	0x08u
+#define P7580_MMU_INT_STAT	0x0Cu
+
+irqreturn_t p7580_drv_mmu_irq(int irq, void *arg)
+{
+	struct p7580_drv *drv = arg;
+	u32 stat;
+
+	(void)irq;
+	if (!drv)
+		return IRQ_NONE;
+
+	stat = readl(drv->regs + P7580_MMU_BASE_OFF + P7580_MMU_INT_STAT);
+	if (!stat)
+		return IRQ_NONE;
+
+	/* Log the faulting AS (decode via the mmu slice), clear, keep
+	 * going: recovery runs in process context (timedout path). */
+	{
+		unsigned int as;
+
+		for (as = 0; as < 4; as++) {
+			u32 bit = (1u << as) | (1u << (as + 16));
+
+			if (stat & bit) {
+				u32 fst = readl(drv->regs +
+						P7580_MMU_AS_BASE +
+						as * P7580_MMU_AS_STRIDE +
+						P7580_AS_FAULTSTATUS);
+				dev_err(drv->dev,
+					"panfrost7580: MMU fault AS%u: %s/%s stat %08x\n",
+					as, p7580_mmu_fault_code(fst),
+					p7580_mmu_fault_atype(fst), fst);
+			}
+		}
+	}
+	writel(stat, drv->regs + P7580_MMU_BASE_OFF + P7580_MMU_INT_CLEAR);
+	return IRQ_HANDLED;
+}
+
+/* GPU_INT_RAWSTAT 0x020 / CLEAR 0x024 (jobs jm_hw.h P7580_JOB_INT_* is
+ * the JOB block at 0x1000; the GPU block is separate). MULTIPLE_FAULT
+ * is bit 7 (kbase); RESET_COMPLETED bit 8 (power slice). */
+#define P7580_GPU_IRQ_MULTI_FAULT	(1u << 7)
+
+irqreturn_t p7580_drv_gpu_irq(int irq, void *arg)
+{
+	struct p7580_drv *drv = arg;
+	u32 stat;
+
+	(void)irq;
+	if (!drv)
+		return IRQ_NONE;
+
+	stat = readl(drv->regs + P7580_GPU_INT_RAWSTAT);
+	if (!stat)
+		return IRQ_NONE;
+
+	if (stat & P7580_GPU_IRQ_MULTI_FAULT)
+		dev_err(drv->dev,
+			"panfrost7580: GPU MULTIPLE_FAULT %08x\n", stat);
+	writel(stat, drv->regs + P7580_GPU_INT_CLEAR);
+	return IRQ_HANDLED;
+}
+
+static irqreturn_t p7580_drv_job_irq(int irq, void *arg)
+{
+	struct p7580_drv *drv = arg;
+
+	if (!drv)
+		return IRQ_NONE;
+	return p7580_job_irq(irq, &drv->jd) ? IRQ_HANDLED : IRQ_NONE;
+}
+
+/* ------------------------------------------------------------------ */
+/* DRM driver hooks                                                   */
+/* ------------------------------------------------------------------ */
+
+static int p7580_drv_load(struct drm_device *dev, unsigned long flags)
+{
+	(void)dev;
+	(void)flags;
+	return 0;
+}
+
+static int p7580_drv_unload(struct drm_device *dev)
+{
+	(void)dev;
+	return 0;
+}
+
+static int p7580_drv_open(struct drm_device *dev, struct drm_file *file_priv)
+{
+	struct p7580_drv *drv = dev->dev_private;
+	struct p7580_drv_file *df;
+	int ret;
+
+	df = kzalloc(sizeof(*df), GFP_KERNEL);
+	if (!df)
+		return -ENOMEM;
+	ret = p7580_drv_file_init(df, drv);
+	if (ret) {
+		kfree(df);
+		return ret;
+	}
+	file_priv->driver_priv = df;
+	return 0;
+}
+
+static void p7580_drv_preclose(struct drm_device *dev,
+			       struct drm_file *file_priv)
+{
+	(void)dev;
+	(void)file_priv;
+}
+
+static void p7580_drv_postclose(struct drm_device *dev,
+				struct drm_file *file_priv)
+{
+	struct drm_device *ddev = dev;
+	struct p7580_drv *drv;
+	struct p7580_drv_file *df = file_priv->driver_priv;
+	int pm_held = 0;
+
+	(void)dev;
+	if (!df)
+		return;
+	/* Close-after-idle is the observed watchdog path: the fd dies
+	 * while the block is runtime-suspended, and entity fini +
+	 * queued-job retirement touches HEAD/START/RESET below. Hold
+	 * one PM ref across file_fini (which takes its own inner hold
+	 * for the entity walk; nesting gets is refcounted, both must
+	 * be put). On get failure the block is dark: workers fail
+	 * closed via their own arms and fini still flushes CPU-side
+	 * state so nothing leaks. */
+	drv = (ddev && ddev->dev_private) ? ddev->dev_private : NULL;
+	if (!drv)
+		drv = df->drv;
+	if (drv && p7580_drv_teardown_hold(drv))
+		pm_held = 1;
+	file_priv->driver_priv = NULL;
+	p7580_drv_file_fini(df);
+	kfree(df);
+	if (pm_held)
+		p7580_drv_teardown_release(drv);
+}
+
+static void p7580_drv_lastclose(struct drm_device *dev)
+{
+	(void)dev;
+}
+
+/* SUBMIT override: full dispatch through the jobs/sched/MMU path.
+ * The ioctl's copy_from_user staging lives in GEM's
+ * panfrost_ioctl_submit; but that helper targets GEM's own job_dev /
+ * job_fctx pairing. Our file state carries the same layout plus the
+ * driver pointer + sched entities, so dispatch here instead: stage
+ * the user arrays locally, then run p7580_drv_submit (validate ->
+ * reserve -> MMU-map -> sched -> out-sync). GEM's helper is not
+ * called. */
+int panfrost_ioctl_submit_override(struct drm_device *dev, void *data,
+				   struct drm_file *file_priv);
+
+/* Generic syncobj surface (syncobj.c): fops-routed, NOT in the
+ * driver ioctl table (3.10 core table owns nr >= 0xA0). */
+long panfrost_syncobj_ioctl(struct file *filp, unsigned int cmd,
+			    unsigned long arg);
+#ifdef CONFIG_COMPAT
+long panfrost_syncobj_compat_ioctl(struct file *filp, unsigned int cmd,
+				    unsigned long arg);
+#endif
+
+/* fops: render-minor-only mmap via the GEM fault path. */
+static const struct file_operations p7580_drv_fops = {
+	.owner = THIS_MODULE,
+	.open = drm_open,
+	.release = drm_release,
+	.unlocked_ioctl = panfrost_syncobj_ioctl,
+#ifdef CONFIG_COMPAT
+	.compat_ioctl = panfrost_syncobj_compat_ioctl,
+#else
+	.compat_ioctl = NULL,
+#endif
+	.mmap = p7580_gem_mmap,
+	.poll = drm_poll,
+	.read = drm_read,
+	.llseek = noop_llseek,
+};
+
+/* Legacy 3.10 rows: DRM_IOCTL_DEF_DRV takes (ioctl, func, flags).
+ * SUBMIT keeps DRM_AUTH (legacy gate); the Mode-B core change makes
+ * the render node always-authenticated and denies DRM_MASTER ioctls
+ * on it, so user-space Mesa works unprivileged while modeset stays
+ * card0-only. All six are DRM_UNLOCKED (v5.2 DRM_RENDER_ALLOW). */
+static struct drm_ioctl_desc p7580_drv_ioctls[] = {
+	DRM_IOCTL_DEF_DRV(PANFROST_SUBMIT, panfrost_ioctl_submit_override,
+			  DRM_AUTH | DRM_UNLOCKED),
+	DRM_IOCTL_DEF_DRV(PANFROST_WAIT_BO, panfrost_ioctl_wait_bo,
+			  DRM_UNLOCKED),
+	DRM_IOCTL_DEF_DRV(PANFROST_CREATE_BO, panfrost_ioctl_create_bo,
+			  DRM_UNLOCKED),
+	DRM_IOCTL_DEF_DRV(PANFROST_MMAP_BO, panfrost_ioctl_mmap_bo,
+			  DRM_UNLOCKED),
+	DRM_IOCTL_DEF_DRV(PANFROST_GET_PARAM, panfrost_ioctl_get_param,
+			  DRM_UNLOCKED),
+	DRM_IOCTL_DEF_DRV(PANFROST_GET_BO_OFFSET,
+			  panfrost_ioctl_get_bo_offset, DRM_UNLOCKED),
+};
+
+static struct drm_driver p7580_drm_driver = {
+	.driver_features = DRIVER_GEM | DRIVER_PRIME | DRIVER_RENDER_ONLY,
+	.load = p7580_drv_load,
+	.unload = p7580_drv_unload,
+	.open = p7580_drv_open,
+	.preclose = p7580_drv_preclose,
+	.postclose = p7580_drv_postclose,
+	.lastclose = p7580_drv_lastclose,
+	.gem_free_object = p7580_gem_free_object,
+	.gem_vm_ops = &p7580_gem_vm_ops,
+	.prime_handle_to_fd = drm_gem_prime_handle_to_fd,
+	.prime_fd_to_handle = drm_gem_prime_fd_to_handle,
+	.gem_prime_export = p7580_gem_prime_export,
+	.gem_prime_import = p7580_gem_prime_import,
+	.gem_prime_get_sg_table = p7580_gem_prime_get_sg_table,
+	.gem_prime_import_sg_table = p7580_gem_prime_import_sg_table,
+	.gem_prime_vmap = p7580_gem_prime_vmap,
+	.gem_prime_vunmap = p7580_gem_prime_vunmap,
+	.ioctls = p7580_drv_ioctls,
+	.num_ioctls = 0,	/* filled at probe (DRM_ARRAY_SIZE) */
+	.fops = &p7580_drv_fops,
+	.name = "panfrost7580",
+	.desc = "Mali-T720 render-only (Exynos 7580)",
+	.date = "20261119",
+	.major = 1,
+	.minor = 0,
+	.patchlevel = 0,
+};
+
+/* ------------------------------------------------------------------ */
+/* Power management (delegates to the power + devfreq slices)         */
+/* ------------------------------------------------------------------ */
+
+static int p7580_drv_runtime_suspend(struct device *dev)
+{
+	struct platform_device *pdev = to_platform_device(dev);
+	struct drm_device *ddev = platform_get_drvdata(pdev);
+	struct p7580_drv *drv;
+
+	if (!ddev)
+		return 0;
+	drv = ddev->dev_private;
+	/* Do not gate the clocks while a job owns the block: run_job /
+	 * recover touch HEAD/START/RESET registers asynchronously, and
+	 * every live job holds its own PM ref — but a stray extra
+	 * suspend (autosuspend racing queue, teardown ordering) must
+	 * still refuse rather than darken the block under MMIO.
+	 * -EBUSY tells the PM core to retry after the job retires
+	 * (its free_job put lets the next suspend succeed). */
+	if (drv && !p7580_job_is_idle(&drv->jd))
+		return -EBUSY;
+	if (drv && drv->dvfs)
+		pf7580_dvfs_suspend(drv->dvfs);
+	if (drv && drv->power)
+		return pf7580_runtime_suspend(drv->power);
+	return 0;
+}
+
+static int p7580_drv_runtime_resume(struct device *dev)
+{
+	struct platform_device *pdev = to_platform_device(dev);
+	struct drm_device *ddev = platform_get_drvdata(pdev);
+	struct p7580_drv *drv;
+	int ret;
+
+	if (!ddev)
+		return 0;
+	drv = ddev->dev_private;
+	if (drv && drv->power) {
+		ret = pf7580_runtime_resume(drv->power);
+		if (ret)
+			return ret;
+	}
+	/* Resume re-arms what reset + power-off lost (mainline
+	 * panfrost_device_resume order: soft_reset -> power_on ->
+	 * mmu_enable(0) -> job_enable_interrupts; kbase_pm_clock_on:
+	 * MMU reprogram, then JOB unmask last). AS0 TRANSTAB/MEMATTR
+	 * first so descriptor fetch faults nowhere, then CLEAR stale
+	 * slot bits and unmask DONE+ERR for present slots. Powered by
+	 * the resume above; safe to touch MMIO here. */
+	if (drv) {
+		p7580_mmu_program_as(drv->regs, P7580_DRV_AS_NR,
+				     drv->mmu.root_dma,
+				     P7580_MEMATTR_KBASE_LO,
+				     P7580_MEMATTR_KBASE_HI);
+		p7580_job_dev_rearm(&drv->jd);
+	}
+	if (drv && drv->dvfs)
+		pf7580_dvfs_resume(drv->dvfs);
+	return 0;
+}
+
+static int p7580_drv_pm_suspend(struct device *dev)
+{
+	struct platform_device *pdev = to_platform_device(dev);
+	struct drm_device *ddev = platform_get_drvdata(pdev);
+	struct p7580_drv *drv;
+
+	if (!ddev)
+		return 0;
+	drv = ddev->dev_private;
+	/* Suspend devfreq polling before the clock gates (devfreq slice:
+	 * monitor must stop while runtime PM gates aclk_g3d). */
+	if (drv && drv->dvfs)
+		pf7580_dvfs_suspend(drv->dvfs);
+	if (drv && drv->power)
+		return pf7580_pm_suspend(dev, drv->power);
+	return 0;
+}
+
+static int p7580_drv_pm_resume(struct device *dev)
+{
+	struct platform_device *pdev = to_platform_device(dev);
+	struct drm_device *ddev = platform_get_drvdata(pdev);
+	struct p7580_drv *drv;
+	int ret;
+
+	if (!ddev)
+		return 0;
+	drv = ddev->dev_private;
+	if (drv && drv->power) {
+		/* Power slice: unconditional full power-on (pd-g3d was
+		 * off, so GPU state is lost); genpd sequencing stays in
+		 * the power slice. */
+		ret = pf7580_pm_resume(dev, drv->power);
+		if (ret)
+			return ret;
+	}
+	if (drv && drv->dvfs)
+		pf7580_dvfs_resume(drv->dvfs);
+	return 0;
+}
+
+static const struct dev_pm_ops p7580_drv_pm_ops = {
+	SET_SYSTEM_SLEEP_PM_OPS(p7580_drv_pm_suspend, p7580_drv_pm_resume)
+	SET_RUNTIME_PM_OPS(p7580_drv_runtime_suspend,
+			   p7580_drv_runtime_resume, NULL)
+};
+
+/* ------------------------------------------------------------------ */
+/* Probe / remove                                                     */
+/* ------------------------------------------------------------------ */
+
+static const struct of_device_id p7580_of_match[] = {
+	{ .compatible = "arm,mali-t720" },
+	/* Stock DT carries only "arm,mali"; match it SoC-gated by the
+	 * reg address check below (0x11400000). Refusing other arm,mali
+	 * SoCs here keeps this driver off foreign boards. */
+	{ .compatible = "arm,mali" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, p7580_of_match);
+
+/* GPU feature registers (MIDGARD, kbase mali_midg_regmap.h). */
+#define P7580_GPU_ID			0x000u
+#define P7580_GPU_L2_FEATURES		0x02Cu
+#define P7580_GPU_CORE_FEATURES		0x030u
+#define P7580_GPU_JS_PRESENT		0x01Cu
+#define P7580_GPU_SHADER_PRESENT_LO	0x100u
+
+/* PM wrappers for the jobs-slice dump path (void-arg, device-direct):
+ * the jobs slice never includes pm_runtime.h; these live in the driver
+ * TU where pm_runtime is available. get returns 0 when MMIO is allowed
+ * (pm_runtime_get_sync's 1 = already active is normalised to 0),
+ * negative errno dark; put drops the ref. */
+static int p7580_job_pm_get_void(void *dev)
+{
+	int ret;
+
+	if (!dev)
+		return -ENODEV;
+	ret = pm_runtime_get_sync((struct device *)dev);
+	if (ret < 0) {
+		pm_runtime_put_noidle((struct device *)dev);
+		return ret;
+	}
+	return 0;
+}
+
+static void p7580_job_pm_put_void(void *dev)
+{
+	if (!dev)
+		return;
+	pm_runtime_mark_last_busy((struct device *)dev);
+	pm_runtime_put_autosuspend((struct device *)dev);
+}
+
+static int p7580_drv_probe(struct platform_device *pdev)
+{
+	struct resource *mem;
+	void __iomem *regs;
+	struct p7580_drv *drv;
+	u32 js_present, shader_present;
+	int ret;
+
+	if (!pdev->dev.of_node)
+		return -ENODEV;
+
+	/* Stock reg resource must be 0x11400000/0x5000 (refuse foreign
+	 * arm,mali SoCs that share the bare compatible). */
+	mem = platform_get_resource(pdev, IORESOURCE_MEM, 0);
+	if (!mem || mem->start != 0x11400000u || resource_size(mem) < 0x5000u)
+		return -ENODEV;
+
+	regs = devm_ioremap_resource(&pdev->dev, mem);
+	if (IS_ERR(regs))
+		return PTR_ERR(regs);
+
+	/* IRQs by INDEX (0/1/2 = job/mmu/gpu); names ignored (kbase ABI). */
+	drv = devm_kzalloc(&pdev->dev, sizeof(*drv), GFP_KERNEL);
+	if (!drv)
+		return -ENOMEM;
+	drv->dev = &pdev->dev;
+	drv->regs = regs;
+	mutex_init(&drv->bo_lock);
+	INIT_LIST_HEAD(&drv->bo_list);
+
+	drv->irq_job = platform_get_irq(pdev, 0);
+	drv->irq_mmu = platform_get_irq(pdev, 1);
+	drv->irq_gpu = platform_get_irq(pdev, 2);
+	if (drv->irq_job < 0 || drv->irq_mmu < 0 || drv->irq_gpu < 0)
+		return -ENODEV;
+
+	/* Power FIRST (F-SUB1): no register below is touched before the
+	 * domain/clocks are up. pf7580_power_probe runs the stock
+	 * sequence (clk_get x6 -> regulator -> autosuspend 50 ms ->
+	 * get_sync [genpd + SOFT_RESET + cores L2->shader->tiler] ->
+	 * put_autosuspend) and leaves the block powered on return. */
+	ret = pf7580_power_probe(&pdev->dev, regs, &drv->power);
+	if (ret)
+		return ret;
+	/* Keep the block awake for the rest of probe (present-reg read,
+	 * program_as, job_dev_init below are all MMIO). Balanced at the
+	 * end of probe (or on any error leg after this point). */
+	ret = pm_runtime_get_sync(&pdev->dev);
+	if (ret < 0) {
+		pm_runtime_put_noidle(&pdev->dev);
+		goto err_power;
+	}
+	atomic_set(&drv->pm_ref, 0);
+
+	/* Present bits (MMIO: powered by the get above). */
+	js_present = readl(regs + P7580_GPU_JS_PRESENT);
+	shader_present = readl(regs + P7580_GPU_SHADER_PRESENT_LO);
+	js_present &= 0x7u;
+	if (!js_present) {
+		ret = -ENODEV;
+		goto err_pm;
+	}
+
+	/* GEM allocator (IOVA window; no MMIO). */
+	ret = p7580_dev_init(&drv->gd, &pdev->dev);
+	if (ret)
+		goto err_pm;
+
+	/* One GPU address space, programmed now (MMIO: powered). */
+	ret = p7580_mmu_alloc(&pdev->dev, &drv->mmu);
+	if (ret)
+		goto err_gem;
+	p7580_mmu_program_as(regs, P7580_DRV_AS_NR, drv->mmu.root_dma,
+			     P7580_MEMATTR_KBASE_LO, P7580_MEMATTR_KBASE_HI);
+
+	/* Job slots (JOB_INT_CLEAR/MASK writes: powered). Recover
+	 * rebinds this same root after every GPU reset, so stash it on
+	 * the job device here (single AS0 on this part). */
+	drv->jd.pgd_dma = drv->mmu.root_dma;
+	ret = p7580_job_dev_init(&drv->jd, regs, js_present,
+				 ((u64)0 << 32) | shader_present,
+				 drv->mmu.root_dma, &pdev->dev,
+				 p7580_job_pm_get_void, p7580_job_pm_put_void);
+	if (ret)
+		goto err_mmu;
+	/* R1: warm up the shared sched workqueue at probe so the first
+	 * open never constructs kernel threads under the opener's
+	 * mutex. Failure here is non-fatal: the first open retries
+	 * via p7580_drv_sched_ensure inside file_init. */
+	/* gpu31-iova: fault-time mapping dump (ERR-MAP) + map/unmap
+	 * trace re-arm (iova_arm). Resolver renders the faulting
+	 * job's SUBMIT-time snapshot; IRQ-safe (no GEM deref). */
+	p7580_job_set_iova_resolver(&drv->jd, p7580_drv_iova_resolve,
+				     drv);
+	p7580_drv_register_iova_trace(&p7580_iova_trace);
+	ret = p7580_drv_sched_ensure();
+	if (ret)
+		goto err_mmu;
+
+	/* Devfreq (optional: continues degraded-but-alive without it). */
+	if (pf7580_dvfs_init(&pdev->dev, drv->power, &drv->dvfs))
+		drv->dvfs = NULL;
+
+	/* IRQs (shared lines tolerated on this SoC). */
+	ret = devm_request_irq(&pdev->dev, drv->irq_job, p7580_drv_job_irq,
+			       IRQF_SHARED, "panfrost7580-job", drv);
+	if (ret)
+		goto err_dvfs;
+	ret = devm_request_irq(&pdev->dev, drv->irq_mmu, p7580_drv_mmu_irq,
+			       IRQF_SHARED, "panfrost7580-mmu", drv);
+	if (ret)
+		goto err_dvfs;
+	ret = devm_request_irq(&pdev->dev, drv->irq_gpu, p7580_drv_gpu_irq,
+			       IRQF_SHARED, "panfrost7580-gpu", drv);
+	if (ret)
+		goto err_dvfs;
+
+	/* DRM attach (render-minor-only; no modeset). The 3.10 core
+	 * allocates struct drm_device internally (drm_get_platform_dev);
+	 * recover it from the driver list, publish our state on
+	 * dev_private, and stash the drm device for remove/PM. */
+	p7580_drm_driver.num_ioctls = DRM_ARRAY_SIZE(p7580_drv_ioctls);
+	platform_set_drvdata(pdev, NULL);
+	{
+		int drm_ret;
+		struct drm_device *ddev;
+		struct list_head *pos;
+
+		drm_ret = drm_platform_init(&p7580_drm_driver, pdev);
+		if (drm_ret)
+			goto err_dvfs;
+		if (list_empty(&p7580_drm_driver.device_list)) {
+			drm_platform_exit(&p7580_drm_driver, pdev);
+			ret = -ENODEV;
+			goto err_dvfs;
+		}
+		pos = p7580_drm_driver.device_list.next;
+		ddev = list_entry(pos, struct drm_device, driver_item);
+		ddev->dev_private = drv;
+		platform_set_drvdata(pdev, ddev);
+	}
+
+	/* Probe MMIO is done (IRQs installed, no register touched after
+	 * this): release the probe power hold; the block idle-suspends
+	 * after PF7580_AUTOSUSPEND_MS. Later MMIO re-takes it per-path. */
+	pm_runtime_mark_last_busy(&pdev->dev);
+	pm_runtime_put_autosuspend(&pdev->dev);
+	return 0;
+
+err_dvfs:
+	if (drv->dvfs) {
+		pf7580_dvfs_fini(drv->dvfs);
+		drv->dvfs = NULL;
+	}
+err_mmu:
+	p7580_mmu_free(&drv->mmu);
+err_gem:
+	p7580_dev_fini(&drv->gd);
+err_pm:
+	/* Balance the probe power hold (get_sync after power_probe);
+	 * the block may then idle-suspend before power_remove below. */
+	pm_runtime_mark_last_busy(&pdev->dev);
+	pm_runtime_put_autosuspend(&pdev->dev);
+err_power:
+	/* power_remove force-resumes, suspends synchronously, and
+	 * disables runtime PM: the single teardown for every leg
+	 * after power_probe (probe-failure or remove path shape). */
+	if (drv->power) {
+		pf7580_power_remove(drv->power);
+		drv->power = NULL;
+	}
+	return ret;
+}
+
+static int p7580_drv_remove(struct platform_device *pdev)
+{
+	struct drm_device *ddev = platform_get_drvdata(pdev);
+	struct p7580_drv *drv;
+	struct p7580_drv_bo *e, *tmp;
+
+	if (ddev)
+		drv = ddev->dev_private;
+	else
+		drv = NULL;
+
+	if (drv) {
+		int pm_held = 0;
+
+		/* Mask the slot IRQs first: no new DONE/ERR demux (MMIO
+		 * read/CLEAR) can run while we tear the tables down. */
+		p7580_job_dev_fini(&drv->jd);
+		/* Hold the block awake for the invalidate() MMIO below
+		 * (teardown_hold/teardown_release pair; fail-closed on
+		 * dark: skip the TLB flush but still free table memory
+		 * and the IOVA range). */
+		if (p7580_drv_teardown_hold(drv)) {
+			pm_held = 1;
+		} else {
+			dev_warn(drv->dev,
+				 "panfrost7580: remove with GPU dark;"
+				 " skipping TLB invalidate\n");
+		}
+		/* Unmap every bound BO before freeing the tables. */
+		mutex_lock(&drv->bo_lock);
+		list_for_each_entry_safe(e, tmp, &drv->bo_list, node) {
+			p7580_drv_unmap_bo(drv, e->obj, pm_held);
+			list_del(&e->node);
+			drm_gem_object_unreference(e->obj);
+			kfree(e);
+		}
+		mutex_unlock(&drv->bo_lock);
+		if (pm_held)
+			p7580_drv_teardown_release(drv);
+
+		if (drv->dvfs) {
+			pf7580_dvfs_fini(drv->dvfs);
+			drv->dvfs = NULL;
+		}
+		p7580_mmu_free(&drv->mmu);
+		p7580_dev_fini(&drv->gd);
+		if (drv->power) {
+			pf7580_power_remove(drv->power);
+			drv->power = NULL;
+		}
+	}
+
+	drm_platform_exit(&p7580_drm_driver, pdev);
+	platform_set_drvdata(pdev, NULL);
+	return 0;
+}
+
+static struct platform_driver p7580_platform_driver = {
+	.probe = p7580_drv_probe,
+	.remove = p7580_drv_remove,
+	.driver = {
+		.name = "panfrost7580",
+		.owner = THIS_MODULE,
+		.of_match_table = of_match_ptr(p7580_of_match),
+		.pm = &p7580_drv_pm_ops,
+	},
+};
+
+module_platform_driver(p7580_platform_driver);
+
+MODULE_AUTHOR("gpu31");
+MODULE_DESCRIPTION("panfrost7580 render-only DRM driver (Mali-T720, Exynos 7580)");
+MODULE_LICENSE("GPL v2");
+MODULE_ALIAS("platform:panfrost7580");
diff -u '--exclude=.git' -Naur a/drivers/gpu/drm/panfrost/panfrost7580_mmu.c b/drivers/gpu/drm/panfrost/panfrost7580_mmu.c
--- a/drivers/gpu/drm/panfrost/panfrost7580_mmu.c	1969-12-31 19:00:00.000000000 -0500
+++ b/drivers/gpu/drm/panfrost/panfrost7580_mmu.c	2026-11-21 00:00:00.000000000 -0500
@@ -0,0 +1,447 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * panfrost7580_mmu.c - Mali-T720 GPU-MMU programming, Exynos 7580 / 3.10.108.
+ *
+ * No exynos-sysmmu / IOMMU-API use: the Mali MMU *is* the IOMMU for GPU
+ * virtual addresses. Pages are dma_map_page()d (identity dma==phys on this
+ * arm64 tree) and their DMA addresses are written into the GPU's own LPAE
+ * tables; each update is followed by dma_sync_single_for_device() because
+ * the GPU is observed non-coherent (COHERENCY_NONE).
+ *
+ * Mirrors the proven kbase paths:
+ *  alloc/free  <- kbase_mmu_alloc_pgd (mali_kbase_mmu.c:386-428)
+ *  maintenance <- kbase_mmu_sync_pgd  (mali_kbase_mmu.c:78-87)
+ *  AS program  <- kbase_mmu_hw_configure + mmu_get_as_setup
+ *                 (mali_kbase_mmu_hw_direct.c:242-288,
+ *                  mali_kbase_mmu_mode_lpae.c:76-103, ACE branch dropped)
+ *  entries     <- entry_set_ate/pte/invalidate
+ *                 (mali_kbase_mmu_mode_lpae.c:174-189)
+ */
+
+#include <linux/delay.h>
+#include <linux/device.h>
+#include <linux/dma-mapping.h>
+#include <linux/errno.h>
+#include <linux/highmem.h>
+#include <linux/io.h>
+#include <linux/mm.h>
+#include <linux/slab.h>
+
+#include "panfrost7580_mmu.h"
+
+#define P7580_IDX_MASK		0x1FFu
+#define P7580_ADDR_MASK		(~(u64)0xFFFULL)
+
+static u64 p7580_index(u64 iova, unsigned int level)
+{
+	return (iova >> (P7580_MMU_ADDR_SHIFT +
+			 (P7580_MMU_LEVELS - 1 - level) * 9)) & P7580_IDX_MASK;
+}
+
+static u64 *p7580_kmap_dma(dma_addr_t dma)
+{
+	return kmap(pfn_to_page(PFN_DOWN(dma)));
+}
+
+static void p7580_kunmap_dma(void *cpu)
+{
+	kunmap(cpu);
+}
+
+/* Encode LOCKADDR for [iova, iova+size): page-aligned base with the
+ * pow2-rounded page count folded into bits 5:0 as (10 + fls(pages)).
+ * Byte-identical twin of pf7580_lock_region() in mmu/pf7580_as.h and
+ * mali_lock_region() in userspace mali_mmu.h (one encoder, F-MMU1/4).
+ * Saturates at width 63 for ranges above 2^53 bytes (the LOCK(0,~0UL)
+ * full-TLB shape included). */
+static unsigned int p7580_fls32(u32 x)
+{
+	return x ? 32 - __builtin_clz(x) : 0;
+}
+
+static u64 p7580_lock_region(u64 iova, u64 size)
+{
+	u64 pages, region;
+	unsigned int w;
+
+	if (!size) {
+		pages = 1;
+	} else {
+		pages = (size + 4095ULL) >> 12;
+		if (!pages)
+			pages = ~0ULL;
+	}
+
+	if (pages > (1ULL << (P7580_LOCK_MAX_W - 10))) {
+		w = P7580_LOCK_MAX_W;
+	} else {
+		u32 p = (u32)pages;
+
+		w = 10 + p7580_fls32(p);
+		if (p != (1u << (w - 11)))
+			w += 1;
+		if (w < P7580_LOCK_MIN_W)
+			w = P7580_LOCK_MIN_W;
+		if (w > P7580_LOCK_MAX_W)
+			w = P7580_LOCK_MAX_W;
+	}
+
+	region = iova & ~4095ULL;
+	region |= w;
+	return region;
+}
+/* Sync one page-table page so the non-coherent GPU PTW reads fresh data. */
+static void p7580_sync_pt(struct device *dev, dma_addr_t dma)
+{
+	dma_sync_single_for_device(dev, dma, PAGE_SIZE, DMA_TO_DEVICE);
+}
+
+int p7580_mmu_alloc(struct device *dev, struct p7580_mmu *mmu)
+{
+	struct page *p;
+	u64 *tbl;
+	unsigned int i;
+
+	if (!dev || !mmu)
+		return -EINVAL;
+
+	p = alloc_page(GFP_KERNEL | __GFP_ZERO);
+	if (!p)
+		return -ENOMEM;
+
+	mmu->root_dma = dma_map_page(dev, p, 0, PAGE_SIZE,
+				     DMA_BIDIRECTIONAL);
+	if (dma_mapping_error(dev, mmu->root_dma)) {
+		__free_page(p);
+		return -ENOMEM;
+	}
+
+	/* Same guarantee kbase relies on (mali_kbase_mem_pool.c:211:
+	 * WARN_ON(dma_addr != page_to_phys(p))): an identity mapping, so
+	 * the GPU PTE can carry the DMA address. Page tables written back
+	 * below are also covered by this; fail loudly if it ever moves. */
+	if (mmu->root_dma != (dma_addr_t)page_to_phys(p)) {
+		dev_warn(dev, "panfrost7580: DMA address is not identity-mapped\n");
+		dma_unmap_page(dev, mmu->root_dma, PAGE_SIZE,
+			       DMA_BIDIRECTIONAL);
+		__free_page(p);
+		return -EIO;
+	}
+
+	mmu->dev = dev;
+	tbl = p7580_kmap_dma(mmu->root_dma);
+	/* Mark every entry invalid; 0x2 == ENTRY_IS_INVAL (lpae.c:186-189). */
+	for (i = 0; i < P7580_MMU_ENTRIES; i++)
+		tbl[i] = P7580_PTE_TYPE_INVAL;
+	p7580_sync_pt(dev, mmu->root_dma);
+	p7580_kunmap_dma(tbl);
+
+	return 0;
+}
+
+void p7580_mmu_free_table(struct device *dev, dma_addr_t table_dma)
+{
+	struct page *p;
+
+	if (!dev || !table_dma)
+		return;
+	p = pfn_to_page(PFN_DOWN(table_dma));
+	dma_unmap_page(dev, table_dma, PAGE_SIZE, DMA_BIDIRECTIONAL);
+	__free_page(p);
+}
+
+void p7580_mmu_free(struct p7580_mmu *mmu)
+{
+	/* Root only. Caller MUST have emptied the context first via
+	 * p7580_mmu_teardown() (recursive unmap+free walk, F-MMU5),
+	 * matching kbase's pool-free teardown. Leaks otherwise. */
+	if (!mmu || !mmu->dev || !mmu->root_dma)
+		return;
+	p7580_mmu_free_table(mmu->dev, mmu->root_dma);
+	mmu->dev = NULL;
+	mmu->root_dma = 0;
+}
+
+/* Recursive teardown helper: empty the level-`level` table at `dma`.
+ * Levels 0..2 hold PTEs to child tables: snapshot the child address,
+ * clear the parent entry first (no reader ever sees a dangling
+ * pointer), then recurse. Level-3 entries are leaves (ATE): only
+ * cleared — BO pages belong to GEM, never to the table pool. Frees
+ * every table except the root (level 0), which stays owned by
+ * p7580_mmu_free(). */
+static void p7580_teardown_level(struct device *dev, dma_addr_t dma,
+				 unsigned int level)
+{
+	u64 *cpu;
+	unsigned int i;
+
+	cpu = p7580_kmap_dma(dma);
+	for (i = 0; i < P7580_MMU_ENTRIES; i++) {
+		u64 e = cpu[i];
+		dma_addr_t child;
+
+		if ((e & P7580_PTE_TYPE_MASK) != P7580_PTE_TYPE_PTE)
+			continue;
+		child = e & P7580_ADDR_MASK;
+		cpu[i] = P7580_PTE_TYPE_INVAL;
+		p7580_sync_pt(dev, dma);
+		p7580_kunmap_dma(cpu);
+		p7580_teardown_level(dev, child, level + 1);
+		cpu = p7580_kmap_dma(dma);
+	}
+	p7580_sync_pt(dev, dma);
+	p7580_kunmap_dma(cpu);
+	if (level > 0)
+		p7580_mmu_free_table(dev, dma);
+}
+
+void p7580_mmu_teardown(struct p7580_mmu *mmu)
+{
+	/* Caller holds the MMU/table lock with the AS already unbound
+	 * (pf7580_as_disable / TRANSTAB 0 + UPDATE, waiting !ACTIVE),
+	 * so no PTW walk races this free. Wire to file-close/remove;
+	 * follow with p7580_mmu_free() for the root. */
+	if (!mmu || !mmu->dev || !mmu->root_dma)
+		return;
+	p7580_teardown_level(mmu->dev, mmu->root_dma, 0);
+}
+
+/* Allocate + attach one child table; table page identity-checked as root. */
+static int p7580_get_child(struct device *dev, u64 *entry, dma_addr_t *child)
+{
+	struct page *p;
+	u64 *tbl;
+	unsigned int i;
+	dma_addr_t dma;
+
+	if ((*entry & P7580_PTE_TYPE_MASK) == P7580_PTE_TYPE_PTE) {
+		*child = (*entry) & P7580_ADDR_MASK;
+		return 0;
+	}
+
+	p = alloc_page(GFP_KERNEL | __GFP_ZERO);
+	if (!p)
+		return -ENOMEM;
+
+	dma = dma_map_page(dev, p, 0, PAGE_SIZE, DMA_BIDIRECTIONAL);
+	if (dma_mapping_error(dev, dma)) {
+		__free_page(p);
+		return -ENOMEM;
+	}
+	if (dma != (dma_addr_t)page_to_phys(p)) {
+		dev_warn(dev, "panfrost7580: child PT not identity-mapped\n");
+		dma_unmap_page(dev, dma, PAGE_SIZE, DMA_BIDIRECTIONAL);
+		__free_page(p);
+		return -EIO;
+	}
+
+	tbl = p7580_kmap_dma(dma);
+	for (i = 0; i < P7580_MMU_ENTRIES; i++)
+		tbl[i] = P7580_PTE_TYPE_INVAL;
+	p7580_sync_pt(dev, dma);
+	p7580_kunmap_dma(tbl);
+
+	*entry = (dma & P7580_ADDR_MASK) | P7580_PTE_TYPE_PTE;
+	*child = dma;
+	return 1; /* parent entry changed -> caller syncs parent page */
+}
+
+int p7580_mmu_map(struct p7580_mmu *mmu, u64 iova, phys_addr_t paddr,
+		  unsigned int prot, unsigned int memattr_idx)
+{
+	dma_addr_t cur = 0;
+	unsigned int l;
+
+	if (!mmu || !mmu->dev || !mmu->root_dma)
+		return -EINVAL;
+	if ((iova & ~PAGE_MASK) || (paddr & ~PAGE_MASK))
+		return -EINVAL;
+	if (memattr_idx > 7)
+		return -EINVAL;
+
+	/* Walk levels 0..2, allocating child tables on demand. Each level
+	 * writes at most one entry into its parent page and syncs that
+	 * parent page so the non-coherent PTW sees it (kbase_mmu_sync_pgd
+	 * discipline, mali_kbase_mmu.c:78-87). */
+	cur = mmu->root_dma;
+	for (l = 0; l < P7580_MMU_LEVELS - 1; l++) {
+		u64 *pcpu = p7580_kmap_dma(cur);
+		u64 ei = p7580_index(iova, l);
+		u64 e = pcpu[ei];
+		dma_addr_t child = 0;
+		int rc = p7580_get_child(mmu->dev, &e, &child);
+
+		if (rc < 0) {
+			p7580_kunmap_dma(pcpu);
+			return rc;
+		}
+		if (rc > 0) {
+			pcpu[ei] = e;
+			p7580_sync_pt(mmu->dev, cur);
+		}
+		p7580_kunmap_dma(pcpu);
+		cur = child;
+	}
+
+	/* Level 3 leaf: 4 KiB ATE (ENTRY_IS_ATE, lpae.c:174-179). */
+	{
+		u64 *cpu = p7580_kmap_dma(cur);
+		u64 idx = p7580_index(iova, P7580_MMU_LEVELS - 1);
+		u64 leaf = (paddr & P7580_ADDR_MASK) | P7580_PTE_TYPE_ATE |
+			((u64)(memattr_idx & 0x7) << P7580_PTE_ATTR_SHIFT) |
+			P7580_PTE_AF_BIT;
+
+		if (prot & P7580_PROT_RD)
+			leaf |= P7580_PTE_RD_BIT;
+		if (prot & P7580_PROT_WR)
+			leaf |= P7580_PTE_WR_BIT;
+		if (prot & P7580_PROT_XN)
+			leaf |= P7580_PTE_NX_BIT;
+		cpu[idx] = leaf;
+		p7580_sync_pt(mmu->dev, cur);
+		p7580_kunmap_dma(cpu);
+	}
+
+	return 0;
+}
+
+void p7580_mmu_unmap(struct p7580_mmu *mmu, u64 iova)
+{
+	dma_addr_t cur;
+	unsigned int l;
+	u64 *cpu;
+
+	if (!mmu || !mmu->dev || !mmu->root_dma)
+		return;
+	if (iova & ~PAGE_MASK)
+		return;
+
+	cur = mmu->root_dma;
+	for (l = 0; l < P7580_MMU_LEVELS - 1; l++) {
+		u64 e;
+
+		cpu = p7580_kmap_dma(cur);
+		e = cpu[p7580_index(iova, l)];
+		p7580_kunmap_dma(cpu);
+		if ((e & P7580_PTE_TYPE_MASK) != P7580_PTE_TYPE_PTE)
+			return; /* nothing mapped on this path */
+		cur = e & P7580_ADDR_MASK;
+	}
+
+	cpu = p7580_kmap_dma(cur);
+	cpu[p7580_index(iova, P7580_MMU_LEVELS - 1)] = P7580_PTE_TYPE_INVAL;
+	p7580_sync_pt(mmu->dev, cur);
+	p7580_kunmap_dma(cpu);
+}
+
+void p7580_mmu_program_as(void __iomem *gpu_regs, unsigned int as_nr,
+			  dma_addr_t pgd_dma, u32 memattr_lo, u32 memattr_hi)
+{
+	void __iomem *as = gpu_regs + P7580_MMU_AS_BASE +
+		as_nr * P7580_MMU_AS_STRIDE;
+	u32 transtab_lo = (pgd_dma & P7580_TRANSTAB_ADDR_MASK) |
+		P7580_TRANSTAB_FLAGS;
+	u32 transtab_hi = (u32)((u64)pgd_dma >> 32);
+
+	/* Order matches kbase_mmu_hw_configure (non-AArch64 branch):
+	 * TRANSTAB, MEMATTR, then AS_COMMAND_UPDATE. transcfg legacy 0. */
+	writel(transtab_lo, as + P7580_AS_TRANSTAB_LO);
+	writel(transtab_hi, as + P7580_AS_TRANSTAB_HI);
+	writel(memattr_lo, as + P7580_AS_MEMATTR_LO);
+	writel(memattr_hi, as + P7580_AS_MEMATTR_HI);
+	writel(P7580_TRANSCFG_LEGACY, as + P7580_AS_TRANSCFG_LO);
+	/* Ensure table/memattr writes are visible before UPDATE. */
+	wmb();
+	writel(P7580_AS_CMD_UPDATE, as + P7580_AS_COMMAND);
+}
+
+/* Poll AS_STATUS until no command is active (kbase wait_ready,
+ * mali_kbase_mmu_hw_direct.c:63-86; no kbdev here so the caller logs
+ * the -ETIMEDOUT and escalates to GPU reset). */
+static int p7580_as_wait_ready(void __iomem *as)
+{
+	/* Stepped poll (mmu/pf7580_as.h twin, F-MMU3): 10 us between
+	 * reads. The old tight loop held the caller in a hot readl
+	 * spin for ~10^5 iterations; on a wedged slot that is a
+	 * seconds-long atomic-context-style stall on the caller CPU. */
+	unsigned int i;
+
+	for (i = 0; i < P7580_AS_INACTIVE_MAX_LOOPS; i++) {
+		if (!(readl(as + P7580_AS_STATUS) & P7580_AS_STATUS_ACTIVE))
+			return 0;
+		udelay(P7580_AS_WAIT_STEP_US);
+	}
+	return -ETIMEDOUT;
+}
+
+int p7580_mmu_invalidate(void __iomem *gpu_regs, unsigned int as_nr,
+			 u64 vpfn, u32 nr, int sync)
+{
+	void __iomem *as;
+	u64 lock_addr;
+	int ret;
+
+	if (!gpu_regs || !nr)
+		return -EINVAL;
+	as = gpu_regs + P7580_MMU_AS_BASE + as_nr * P7580_MMU_AS_STRIDE;
+
+	/* Caller holds the MMU-HW lock (see header contract). Sequence is
+	 * kbase_mmu_hw_do_operation (mali_kbase_mmu_hw_direct.c:298-348):
+	 * LOCK region -> op -> wait-ready -> UNLOCK. LOCKADDR carries the
+	 * width-encoded region for the whole [vpfn, vpfn+nr) range
+	 * (F-MMU1); wmb() makes it visible before LOCK (F-MMU2). */
+	lock_addr = p7580_lock_region(vpfn << PAGE_SHIFT,
+				      (u64)nr << PAGE_SHIFT);
+	writel((u32)(lock_addr & 0xFFFFFFFFUL), as + P7580_AS_LOCKADDR_LO);
+	writel((u32)((lock_addr >> 32) & 0xFFFFFFFFUL),
+	       as + P7580_AS_LOCKADDR_HI);
+	/* LOCKADDR must be visible before the LOCK command latches it
+	 * (table/memattr discipline in p7580_mmu_program_as above). */
+	wmb();
+	writel(P7580_AS_CMD_LOCK, as + P7580_AS_COMMAND);
+	writel(sync ? P7580_AS_CMD_FLUSH_MEM : P7580_AS_CMD_FLUSH_PT,
+	       as + P7580_AS_COMMAND);
+	ret = p7580_as_wait_ready(as);
+	/* UNLOCK flushes the MMU/uTLB so updated entries are re-read
+	 * (kbase BASE_HW_ISSUE_9630 note at :326-344). */
+	writel(P7580_AS_CMD_UNLOCK, as + P7580_AS_COMMAND);
+	return ret;
+}
+
+/* Single fault decoder (F-MMU4), byte-identical with pf7580_fault_exc/
+ * access in mmu/pf7580_as.h and mali_fault_exc/access_name in
+ * userspace mali_mmu.h: low byte 0xC0-0xC7 translation / 0xC8
+ * permission / 0xD0-0xD7 transtab bus / 0xD8 access flag. The old
+ * short-code mask (bits 5:3, 0x0..0x5 classes incl. ADDRESS_SIZE and
+ * MEMORY_ATTRIBUTES) described a different regmap naming and mislabelled
+ * silicon faults; it is retired. */
+const char *p7580_mmu_fault_code(u32 status)
+{
+	u32 e = status & P7580_FAULT_CODE_MASK;
+
+	if (e >= 0xC0u && e <= 0xC7u)
+		return "TRANSLATION_FAULT";
+	if (e == 0xC8u)
+		return "PERMISSION_FAULT";
+	if (e >= 0xD0u && e <= 0xD7u)
+		return "TRANSTAB_BUS_FAULT";
+	if (e == 0xD8u)
+		return "ACCESS_FLAG";
+	return "UNKNOWN";
+}
+
+/* Bits 9:8 access type; ATOMIC names UNKNOWN on this LPAE build
+ * (kbase access_type_name without CONFIG_MALI_GPU_MMU_AARCH64). */
+const char *p7580_mmu_fault_atype(u32 status)
+{
+	switch (status & P7580_FAULT_ATYPE_MASK) {
+	case (0x1u << 8):
+		return "EXECUTE";
+	case (0x2u << 8):
+		return "READ";
+	case (0x3u << 8):
+		return "WRITE";
+	default:
+		return "UNKNOWN";
+	}
+}
diff -u '--exclude=.git' -Naur a/drivers/gpu/drm/panfrost/panfrost7580_mmu.h b/drivers/gpu/drm/panfrost/panfrost7580_mmu.h
--- a/drivers/gpu/drm/panfrost/panfrost7580_mmu.h	1969-12-31 19:00:00.000000000 -0500
+++ b/drivers/gpu/drm/panfrost/panfrost7580_mmu.h	2026-11-21 00:00:00.000000000 -0500
@@ -0,0 +1,171 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * panfrost7580_mmu.h - Mali-T720 GPU-MMU programming for Exynos 7580 (j7elte).
+ *
+ * Decision (gpu31-iommu slice): the GPU does NOT use the Exynos system MMU /
+ * IOMMU API. The Mali-T720 has its own MMU; the driver programs
+ * AS_TRANSTAB / AS_MEMATTR / AS_TRANSCFG / AS_COMMAND itself and maps
+ * DMA-API addresses (dma_map_page identity: dma_addr == phys, asserted by
+ * kbase WARN_ON) directly into GPU page tables. No DT iommus property, no
+ * iommu_domain_alloc/attach, no drivers/iommu/exynos-* involvement.
+ *
+ * Provenance of every constant is cited as file:line in the Nura 3.10.108
+ * tree (KT) or mainline panfrost behaviour (ML).
+ */
+#ifndef PANFROST7580_MMU_H
+#define PANFROST7580_MMU_H
+
+#include <linux/types.h>
+
+struct device;
+struct page;
+
+/* 4 levels x 512 entries x 9 bits, 4 KiB granule (KT
+ * drivers/gpu/arm/t7xx/r15p0/mali_kbase_mmu_mode_lpae.c:25-35,
+ * mali_kbase_mmu.c:386-428 walk: vpfn >> ((3-level)*9), & 0x1FF). */
+#define P7580_MMU_LEVELS	4
+#define P7580_MMU_ENTRIES	512
+#define P7580_MMU_ADDR_SHIFT	12
+
+/* LPAE entry encoding (KT mali_kbase_mmu_mode_lpae.c:25-35). */
+#define P7580_PTE_TYPE_MASK	3ULL
+#define P7580_PTE_TYPE_ATE	1ULL
+#define P7580_PTE_TYPE_INVAL	2ULL
+#define P7580_PTE_TYPE_PTE	3ULL
+
+#define P7580_PTE_ATTR_SHIFT	2	/* bits 4:2: memattr index */
+#define P7580_PTE_RD_BIT	(1ULL << 6)
+#define P7580_PTE_WR_BIT	(1ULL << 7)
+#define P7580_PTE_SH_SHIFT	8	/* bits 9:8, 0 = non-shareable */
+#define P7580_PTE_AF_BIT	(1ULL << 10)
+#define P7580_PTE_NX_BIT	(1ULL << 54)
+
+/* AS register block: kbase MMU base 0x2000 (mali_midg_regmap.h:255) +
+ * AS0 0x400 (:263) == panfrost MMU_BASE 0x2400, stride 0x40 (:280). */
+#define P7580_MMU_AS_BASE	0x2400
+#define P7580_MMU_AS_STRIDE	0x40
+#define P7580_AS_TRANSTAB_LO	0x00
+#define P7580_AS_TRANSTAB_HI	0x04
+#define P7580_AS_MEMATTR_LO	0x08
+#define P7580_AS_MEMATTR_HI	0x0C
+#define P7580_AS_LOCKADDR_LO	0x10
+#define P7580_AS_LOCKADDR_HI	0x14
+#define P7580_AS_COMMAND	0x18
+#define P7580_AS_FAULTSTATUS	0x1C
+#define P7580_AS_FAULTADDR_LO	0x20
+#define P7580_AS_FAULTADDR_HI	0x24
+#define P7580_AS_STATUS		0x28
+#define P7580_AS_STATUS_ACTIVE	0x01
+#define P7580_AS_TRANSCFG_LO	0x30
+
+#define P7580_AS_CMD_UPDATE	0x01
+#define P7580_AS_CMD_LOCK	0x02
+#define P7580_AS_CMD_UNLOCK	0x03
+#define P7580_AS_CMD_FLUSH_PT	0x04
+#define P7580_AS_CMD_FLUSH_MEM	0x05
+/* AS_ACTIVE poll bound (KT mali_kbase_defs.h:1682
+ * KBASE_AS_INACTIVE_MAX_LOOPS) with the stepped shape of the
+ * mmu/pf7580_as.h twin (F-MMU3): 10 us between reads. */
+#define P7580_AS_INACTIVE_MAX_LOOPS 100000
+#define P7580_AS_WAIT_STEP_US	10
+
+/* Region-lock width limits (mali_kbase_mmu_hw_direct.c lock_region;
+ * shared with the pf7580_lock_region() twin in mmu/pf7580_as.h). */
+#define P7580_LOCK_MIN_W	11u
+#define P7580_LOCK_MAX_W	63u
+
+/* TRANSTAB value (KT mali_kbase_mmu_mode_lpae.c:89-97,
+ * mali_midg_regmap.h:321-326): pgd | TABLE(3) | READ_INNER(4).
+ * SHARE_OUTER is set only for COHERENCY_ACE; this SoC is COHERENCY_NONE
+ * (KT mali_kbase_core_linux.c:3577), so it is never set here. */
+#define P7580_TRANSTAB_FLAGS	(3u | (1u << 2))
+#define P7580_TRANSTAB_ADDR_MASK 0xfffff000u
+/* transcfg legacy 0 (KT mali_kbase_mmu_mode_lpae.c:99-103, both sides
+ * agree per gpu-panfrost.md 3.3; mainline panfrost writes LEGACY too). */
+#define P7580_TRANSCFG_LEGACY	0u
+
+/*
+ * AS_MEMATTR tables diverge (risk R4, gpu-panfrost.md 3.3):
+ * kbase LPAE indices 0..4 = 0x48,0x4F,0x4D,0x88,0x8D
+ *   (KT mali_midg_regmap.h:506-514, mali_kbase_mmu_mode_lpae.c:76-87)
+ * mainline ARM_MALI_LPAE indices 0..2 = 0x88,0x8D,0x88.
+ * Default to the kbase table (matches the shipping driver on this
+ * exact silicon); index 0 = implementation-defined caching, which is
+ * also kbase's default region policy.
+ */
+#define P7580_MEMATTR_KBASE_LO	0x884D4F48u
+#define P7580_MEMATTR_KBASE_HI	0x00008D88u
+#define P7580_MEMATTR_PANFROST	0x00888D88u
+#define P7580_MEMATTR_IDX_DEFAULT 0u
+
+/* Fault status decode (KT mali_midg_regmap.h:341-353). Single decoder
+ * (F-MMU4), byte-identical with pf7580_fault_exc/access in
+ * mmu/pf7580_as.h: low byte 0xC0-0xC7 translation / 0xC8 permission /
+ * 0xD0-0xD7 transtab bus / 0xD8 access flag; bits 9:8 access type with
+ * ATOMIC unnamed on this LPAE build (UNKNOWN). */
+#define P7580_FAULT_CODE_MASK	(0xFFu)
+#define P7580_FAULT_ATYPE_MASK	(0x3u << 8)
+
+/* Locking contract (mirrors kbase: mmu_lock serialises table walks,
+ * mmu_hw_mutex serialises AS register programming):
+ * - alloc/free/map/unmap: caller MUST hold the driver's MMU/table lock.
+ *   No internal locking is provided (same as kbase_mmu_* paths, which
+ *   assert lockdep_assert_held on entry).
+ * - program_as/invalidate: caller MUST hold the driver's MMU-HW lock
+ *   (serialises AS_LOCKADDR/LOCK/UNLOCK/FLUSH sequences against
+ *   concurrent AS programming and IRQ-driven recovery).
+ * One GPU address space binding. Page tables come from the kernel page
+ * allocator via dma_map_page (identity on this arm64 tree: dma == phys);
+ * explicit dma_sync_single_for_device after every update because the
+ * system is COHERENCY_NONE (KT mali_kbase_mmu.c:78-87). */
+struct p7580_mmu {
+	struct device *dev;
+	dma_addr_t root_dma;
+};
+
+/* prot bits for p7580_mmu_map(): */
+#define P7580_PROT_RD		(1u << 0)
+#define P7580_PROT_WR		(1u << 1)
+#define P7580_PROT_XN		(1u << 2)
+
+int p7580_mmu_alloc(struct device *dev, struct p7580_mmu *mmu);
+/* Free one child table page (dma_unmap + __free_page) after its parent
+ * entry has been cleared. Exported for the M2/M3 teardown walker; NOT
+ * for general use. */
+void p7580_mmu_free_table(struct device *dev, dma_addr_t table_dma);
+/* Free the root only; caller MUST have emptied the context first via
+ * p7580_mmu_teardown() (recursive unmap+free walk, F-MMU5), matching
+ * kbase's pool-free teardown. Leaks otherwise. */
+void p7580_mmu_free(struct p7580_mmu *mmu);
+/* Recursively clear every mapping and free every child table of this
+ * context (F-MMU5; caller holds the MMU/table lock with the AS already
+ * unbound via pf7580_as_disable/program-off). Level-3 leaves are only
+ * cleared, never freed (BO pages belong to GEM). Call p7580_mmu_free()
+ * afterwards for the root. Wire to file-close/remove; otherwise every
+ * process exit leaks page tables. */
+void p7580_mmu_teardown(struct p7580_mmu *mmu);
+/* Map one 4 KiB page (both addresses 4K-aligned). memattr_idx 0..7.
+ * May allocate up to 3 child tables (GFP_KERNEL, may sleep). */
+int p7580_mmu_map(struct p7580_mmu *mmu, u64 iova, phys_addr_t paddr,
+		  unsigned int prot, unsigned int memattr_idx);
+void p7580_mmu_unmap(struct p7580_mmu *mmu, u64 iova);
+/* Invalidate GPU TLBs for [vpfn, vpfn+nr) in address space as_nr.
+ * LOCK region -> op (FLUSH_PT async / FLUSH_MEM sync+drain) -> wait-ready
+ * -> UNLOCK, mirroring kbase_mmu_hw_do_operation
+ * (mali_kbase_mmu_hw_direct.c:298-348). The LOCKADDR carries the
+ * width-encoded region for the whole range (F-MMU1), programmed under
+ * wmb() so it is visible before LOCK (F-MMU2); sync != 0 drains prior
+ * accesses (kbase sync path); sync == 0 is the map/unmap fast path.
+ * Returns 0 on ready, -ETIMEDOUT if the AS fails to go ready (caller
+ * escalates to GPU reset, as kbase does at mali_kbase_mmu.c:873-886). */
+int p7580_mmu_invalidate(void __iomem *gpu_regs, unsigned int as_nr,
+			 u64 vpfn, u32 nr, int sync);
+/* Program address space as_nr off a GPU register base (gpu regs + offsets
+ * above); issues AS_COMMAND_UPDATE. Caller holds the MMU-HW lock. */
+void p7580_mmu_program_as(void __iomem *gpu_regs, unsigned int as_nr,
+			  dma_addr_t pgd_dma, u32 memattr_lo, u32 memattr_hi);
+/* Human-readable fault status, for the MMU IRQ handler log path. */
+const char *p7580_mmu_fault_code(u32 status);
+const char *p7580_mmu_fault_atype(u32 status);
+
+#endif /* PANFROST7580_MMU_H */
diff -u '--exclude=.git' -Naur a/drivers/gpu/drm/panfrost/panfrost7580_power.c b/drivers/gpu/drm/panfrost/panfrost7580_power.c
--- a/drivers/gpu/drm/panfrost/panfrost7580_power.c	1969-12-31 19:00:00.000000000 -0500
+++ b/drivers/gpu/drm/panfrost/panfrost7580_power.c	2026-11-21 00:00:00.000000000 -0500
@@ -0,0 +1,524 @@
+/*
+ * panfrost7580_power.c - PM / clock / reset sequencing for Mali-T720
+ *                        (Exynos 7580, j7elte) panfrost-class driver.
+ *
+ * Exact sequences are cloned field-by-field from the stock kbase backend
+ * that already drives this SoC (r15p0 platform/exynos), then trimmed to the
+ * subset a render-only DRM driver needs. Register offsets come from
+ * mali_midg_regmap.h; every non-obvious number cites its source below.
+ *
+ * PROBE order (fail-stop, unwind in reverse):
+ *   1. clk_get x6 by DT clock-name (gpu_exynos7580.c: gpu_get_clock).
+ *      No regulator_get here yet: stay out of the PMIC until the clock
+ *      framework has validated the CMU handles.
+ *   2. regulator_get(NULL, "vdd_g3d") (gpu_exynos7580.c: gpu_regulator_init).
+ *      NULL device is mandatory: stock DT has no vdd_g3d-supply phandle.
+ *      Then regulator_enable() (reference #1; rail itself is always-on).
+ *   3. Voltage check: read aclk_g3d rate, map to the OPP table, and vote
+ *      that voltage so the rail matches whatever the CMU left behind.
+ *   4. mux select write (gpu_get_clock tail: 0x1 to MUX_SEL_G3D0).
+ *   5. Runtime PM bring-up (kbase: pm_runtime_enable + autosuspend 50 ms,
+ *      gpu_validate_attrib_data; kbase additionally does
+ *      pm_suspend_ignore_children which a DRM driver must NOT copy because
+ *      child GEM fences must still wake the parent):
+ *        pm_runtime_set_autosuspend_delay(dev, PF7580_AUTOSUSPEND_MS);
+ *        pm_runtime_use_autosuspend(dev);
+ *        pm_runtime_enable(dev);
+ *   6. pm_runtime_get_sync(): vendor genpd powers pd-g3d
+ *      (OPTION 0x1, G3D magic 0xFFFFF0CF to base+0x10, CONFIGURATION write,
+ *      STATUS poll, pm_domains.c: exynos_pd_power), then our runtime-resume
+ *      callback runs: clock + SOFT_RESET + cores.
+ *   7. pm_runtime_put_autosuspend(): let the block idle-suspend after
+ *      PF7580_AUTOSUSPEND_MS like kbase's pm_schedule_suspend(delay_time).
+ *
+ * RUNTIME RESUME order (= power on):
+ *   clock on -> SOFT_RESET (+HARD_RESET fallback) -> cores on
+ *   (L2 -> shader -> tiler). This is kbase kbase_pm_power_up +
+ *   kbase_pm_init_hw collapsed to the Midgard-mandatory subset, with the
+ *   Exynos wrappings (pd-g3d, aclk_g3d, vdd_g3d) spelled out.
+ *
+ * RUNTIME SUSPEND order (= power off), mirroring kbase pm_callback_runtime_off:
+ *   cores off (READY==0 poll) -> aclk_g3d disable.
+ *   genpd then drops pd-g3d itself. NEVER regulator_disable(vdd_g3d) here:
+ *   the s2mpu03 driver ignores BUCK4 disable while g3d_en=1 anyway
+ *   (s2mpu03.c: s2m_disable_regmap "disregard BUCK4 disable"), so calling it
+ *   only corrupts the consumer refcount with zero hardware effect; and
+ *   kbase's gpu_regulator_disable is likewise only called at module term,
+ *   never on the runtime path.
+ *
+ * PMIC sync (why the driver does nothing special): at s2mpu03 probe with
+ * g3d_en=1 the PMIC driver writes B4CTRL1[7:6]=00 (GPIO control of BUCK4),
+ * LDO_EFUSE[4]=1 and L10CTRL[7:6]=00 (BUCK4/LDO10 tracking, s2mpu03.c probe).
+ * On 7580 j7elte the DT comments out buck4en_pin/buck4en_addr, so no GPIO
+ * toggling happens and the sync bits just keep LDO10 tracking the (static)
+ * BUCK4 output. The rail is regulator-always-on + boot-on, so the GPU driver
+ * never enables/disables it around power transitions; it only votes voltage
+ * (pf7580_set_voltage). See docs/reports/gpu31-power.md "BUCK4/LDO10".
+ *
+ * LDO10 BUG CLASS (documented, not worked around in code): LDO10 DT node is
+ * regulator-always-on with NO regulator-boot-on and NO consumer in this
+ * tree. Any future driver that regulator_get("vdd_ldo10") + enable/disable
+ * around GPU jobs will fight the PMIC sync bits: while BUCK4/LDO10 tracking
+ * is armed, LDO10's enable field is slaved to BUCK4, so an I2C disable is
+ * either ignored (rail stays up, refcount corrupted) or races the tracker
+ * (rail glitches while the GPU reads descriptors). Rule: never claim
+ * vdd_ldo10 from GPU code; leave the rail to its current always-on state.
+ */
+
+#include <linux/module.h>
+#include <linux/platform_device.h>
+#include <linux/of.h>
+#include <linux/io.h>
+#include <linux/clk.h>
+#include <linux/err.h>
+#include <linux/delay.h>
+#include <linux/pm_runtime.h>
+#include <linux/regulator/consumer.h>
+
+#include "panfrost7580_power.h"
+
+/* Poll (val & mask) == want, 10 us steps. kbase RESET_TIMEOUT is 100 ms;
+ * keep the same ceiling so a wedged GPU fails probe instead of hanging boot
+ * (kbase gpu_power_set_reg()'s infinite spin is deliberately NOT copied). */
+#define PF7580_RESET_TIMEOUT_US	100000
+#define PF7580_POLL_STEP_US	10
+#define PF7580_CORE_TIMEOUT_US	100000
+
+static int pf7580_poll(void __iomem *regs, u32 reg, u32 mask, u32 want,
+		       unsigned long timeout_us)
+{
+	unsigned long waited = 0;
+	u32 val;
+
+	while (waited < timeout_us) {
+		val = readl(regs + reg);
+		if ((val & mask) == want)
+			return 0;
+		udelay(PF7580_POLL_STEP_US);
+		waited += PF7580_POLL_STEP_US;
+	}
+	return -ETIMEDOUT;
+}
+
+int pf7580_opp_voltage(int mhz)
+{
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(pf7580_opps); i++) {
+		if (pf7580_opps[i].mhz == mhz)
+			return pf7580_opps[i].uv;
+	}
+	return -EINVAL;
+}
+
+/* Claim all six stock clocks in kbase gpu_get_clock order; fatal on the
+ * first failure with earlier claims released (kbase unwind order). */
+static int pf7580_claim_clks(struct pf7580_power *p)
+{
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(p->clks); i++) {
+		p->clks[i] = clk_get(p->dev, pf7580_clk_names[i]);
+		if (IS_ERR_OR_NULL(p->clks[i])) {
+			int ret = p->clks[i] ? (int)PTR_ERR(p->clks[i]) :
+				-ENODEV;
+			dev_err(p->dev, "pf7580: clk_get(%s) failed: %d\n",
+				pf7580_clk_names[i], ret);
+			p->clks[i] = NULL;
+			while (i-- > 0) {
+				clk_put(p->clks[i]);
+				p->clks[i] = NULL;
+			}
+			return ret;
+		}
+	}
+	p->fout_g3d_pll = p->clks[1];
+	p->aclk_g3d = p->clks[2];
+	p->mout_g3d = p->clks[3];
+	p->aclk_g3d_400 = p->clks[5];
+	return 0;
+}
+
+static void pf7580_put_clks(struct pf7580_power *p)
+{
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(p->clks); i++) {
+		if (p->clks[i]) {
+			clk_put(p->clks[i]);
+			p->clks[i] = NULL;
+		}
+	}
+	p->fout_g3d_pll = p->aclk_g3d = p->mout_g3d = p->aclk_g3d_400 = NULL;
+}
+
+/* aclk_g3d on, guarded like kbase gpu_clock_on: refuse when the caller has
+ * not established that the domain is up (runtime-PM resumed), skip when
+ * already enabled (clk_g3d_status). The caller holds p->lock. */
+static int pf7580_clk_on_locked(struct pf7580_power *p, bool domain_on)
+{
+	int ret;
+
+	if (!domain_on)
+		return -EPERM;
+	if (p->clock_enabled)
+		return 0;
+	ret = clk_prepare_enable(p->aclk_g3d);
+	if (ret) {
+		dev_err(p->dev, "pf7580: aclk_g3d enable failed: %d\n", ret);
+		return ret;
+	}
+	p->clock_enabled = true;
+	return 0;
+}
+
+static void pf7580_clk_off_locked(struct pf7580_power *p)
+{
+	if (!p->clock_enabled)
+		return;
+	clk_disable_unprepare(p->aclk_g3d);
+	p->clock_enabled = false;
+}
+
+/*
+ * SOFT_RESET then wait RESET_COMPLETED; on timeout issue HARD_RESET once and
+ * wait again. Mirrors kbase_pm_reset_do_normal (SOFT first, HARD fallback,
+ * RESET_COMPLETED poll) minus the waitqueue: polling is fine at resume
+ * context and keeps this helper callable without kbase's pm state machine.
+ * Caller must hold p->lock with the clock on and the domain up.
+ */
+static int pf7580_soft_reset_locked(struct pf7580_power *p)
+{
+	int ret;
+
+	writel(PF7580_GPU_COMMAND_SOFT_RESET, p->regs + PF7580_GPU_COMMAND);
+	writel(PF7580_RESET_COMPLETED, p->regs + PF7580_GPU_IRQ_MASK);
+	ret = pf7580_poll(p->regs, PF7580_GPU_IRQ_RAWSTAT,
+			  PF7580_RESET_COMPLETED, PF7580_RESET_COMPLETED,
+			  PF7580_RESET_TIMEOUT_US);
+	if (!ret)
+		goto done;
+
+	dev_warn(p->dev, "pf7580: SOFT_RESET timed out, trying HARD_RESET\n");
+	writel(PF7580_GPU_COMMAND_HARD_RESET, p->regs + PF7580_GPU_COMMAND);
+	ret = pf7580_poll(p->regs, PF7580_GPU_IRQ_RAWSTAT,
+			  PF7580_RESET_COMPLETED, PF7580_RESET_COMPLETED,
+			  PF7580_RESET_TIMEOUT_US);
+	if (ret)
+		dev_err(p->dev, "pf7580: HARD_RESET timed out\n");
+done:
+	writel(PF7580_RESET_COMPLETED, p->regs + PF7580_GPU_IRQ_CLEAR);
+	writel(0, p->regs + PF7580_GPU_IRQ_MASK);
+	return ret;
+}
+
+/*
+ * Cores on, L2 -> shader -> tiler (kbase core_type_to_reg order and
+ * panfrost_gpu_power_on order agree: L2 first, then L1s). Each stage polls
+ * its READY bits; a stage that does not come ready fails the power-up.
+ * present_* are the *_PRESENT bitmaps read before PWRON. Caller holds lock,
+ * clock on, reset complete.
+ */
+static int pf7580_cores_on_locked(struct pf7580_power *p,
+				  u32 shader_present, u32 tiler_present,
+				  u32 l2_present)
+{
+	int ret;
+
+	writel(l2_present, p->regs + PF7580_L2_PWRON_LO);
+	writel(0, p->regs + PF7580_L2_PWRON_HI);
+	ret = pf7580_poll(p->regs, PF7580_L2_READY_LO, l2_present,
+			  l2_present, PF7580_CORE_TIMEOUT_US);
+	if (ret) {
+		dev_err(p->dev, "pf7580: L2 PWRON timed out (want %08x)\n",
+			l2_present);
+		return ret;
+	}
+
+	writel(shader_present, p->regs + PF7580_SHADER_PWRON_LO);
+	writel(0, p->regs + PF7580_SHADER_PWRON_HI);
+	ret = pf7580_poll(p->regs, PF7580_SHADER_READY_LO, shader_present,
+			  shader_present, PF7580_CORE_TIMEOUT_US);
+	if (ret) {
+		dev_err(p->dev, "pf7580: shader PWRON timed out (want %08x)\n",
+			shader_present);
+		return ret;
+	}
+
+	writel(tiler_present, p->regs + PF7580_TILER_PWRON_LO);
+	writel(0, p->regs + PF7580_TILER_PWRON_HI);
+	ret = pf7580_poll(p->regs, PF7580_TILER_READY_LO, tiler_present,
+			  tiler_present, PF7580_CORE_TIMEOUT_US);
+	if (ret) {
+		dev_err(p->dev, "pf7580: tiler PWRON timed out (want %08x)\n",
+			tiler_present);
+		return ret;
+	}
+	return 0;
+}
+
+/* Cores off in reverse (tiler -> shader -> L2), polling READY==0. Used on
+ * the runtime-suspend path; kbase likewise powers cores down before
+ * clock-off while the domain is still up. */
+static void pf7580_cores_off_locked(struct pf7580_power *p)
+{
+	int ret;
+
+	writel(0, p->regs + PF7580_TILER_PWRON_LO);
+	writel(0, p->regs + PF7580_TILER_PWRON_HI);
+	ret = pf7580_poll(p->regs, PF7580_TILER_READY_LO, 0xFFFFFFFF, 0,
+			  PF7580_CORE_TIMEOUT_US);
+	if (ret)
+		dev_warn(p->dev, "pf7580: tiler did not idle on power-off\n");
+
+	writel(0, p->regs + PF7580_SHADER_PWRON_LO);
+	writel(0, p->regs + PF7580_SHADER_PWRON_HI);
+	ret = pf7580_poll(p->regs, PF7580_SHADER_READY_LO, 0xFFFFFFFF, 0,
+			  PF7580_CORE_TIMEOUT_US);
+	if (ret)
+		dev_warn(p->dev, "pf7580: shaders did not idle on power-off\n");
+
+	writel(0, p->regs + PF7580_L2_PWRON_LO);
+	writel(0, p->regs + PF7580_L2_PWRON_HI);
+	ret = pf7580_poll(p->regs, PF7580_L2_READY_LO, 0xFFFFFFFF, 0,
+			  PF7580_CORE_TIMEOUT_US);
+	if (ret)
+		dev_warn(p->dev, "pf7580: L2 did not idle on power-off\n");
+}
+
+int pf7580_runtime_resume(struct pf7580_power *p)
+{
+	u32 shader_present, tiler_present, l2_present;
+	int ret;
+
+	if (!p)
+		return -ENODEV;
+
+	mutex_lock(&p->lock);
+
+	/* 1. functional clock (kbase gpu_control_enable_clock). */
+	ret = pf7580_clk_on_locked(p, true);
+	if (ret)
+		goto out;
+
+	/* 2. reset the block (kbase kbase_pm_init_hw reset leg). */
+	ret = pf7580_soft_reset_locked(p);
+	if (ret)
+		goto err_clk;
+
+	/* 3. cores on L2 -> shader -> tiler with READY polls. */
+	shader_present = readl(p->regs + PF7580_SHADER_PRESENT_LO);
+	tiler_present = readl(p->regs + PF7580_TILER_PRESENT_LO);
+	l2_present = readl(p->regs + PF7580_L2_PRESENT_LO);
+	ret = pf7580_cores_on_locked(p, shader_present, tiler_present,
+				     l2_present);
+	if (ret)
+		goto err_clk;
+
+	mutex_unlock(&p->lock);
+	return 0;
+
+err_clk:
+	pf7580_clk_off_locked(p);
+out:
+	mutex_unlock(&p->lock);
+	return ret;
+}
+
+int pf7580_runtime_suspend(struct pf7580_power *p)
+{
+	if (!p)
+		return -ENODEV;
+
+	mutex_lock(&p->lock);
+	pf7580_cores_off_locked(p);
+	pf7580_clk_off_locked(p);
+	mutex_unlock(&p->lock);
+	return 0;
+}
+
+int pf7580_pm_suspend(struct device *dev, struct pf7580_power *p)
+{
+	/* Already idle-suspended: nothing to gate, genpd handles the rest. */
+	if (pm_runtime_suspended(dev))
+		return 0;
+	return pf7580_runtime_suspend(p);
+}
+
+int pf7580_pm_resume(struct device *dev, struct pf7580_power *p)
+{
+	(void)dev;
+	/* After system suspend pd-g3d was off, so GPU state is lost:
+	 * always run the full power-on path. */
+	return pf7580_runtime_resume(p);
+}
+
+int pf7580_set_rate(struct pf7580_power *p, unsigned long rate_hz)
+{
+	unsigned long cur;
+	int ret;
+
+	if (!p)
+		return -ENODEV;
+
+	mutex_lock(&p->lock);
+	if (!p->clock_enabled) {
+		ret = -EAGAIN;
+		goto out;
+	}
+
+	cur = clk_get_rate(p->aclk_g3d);
+	if (cur == rate_hz) {
+		ret = 0;
+		goto out;
+	}
+
+	/* Park on the safe clock, re-rate the PLL, switch back
+	 * (kbase gpu_set_clock). */
+	ret = clk_prepare_enable(p->aclk_g3d_400);
+	if (ret)
+		goto out;
+	ret = clk_set_parent(p->mout_g3d, p->aclk_g3d_400);
+	if (ret)
+		goto out_park;
+	ret = clk_set_rate(p->fout_g3d_pll, rate_hz);
+	if (ret)
+		goto out_park;
+	ret = clk_set_parent(p->mout_g3d, p->fout_g3d_pll);
+out_park:
+	clk_disable_unprepare(p->aclk_g3d_400);
+out:
+	mutex_unlock(&p->lock);
+	return ret;
+}
+
+int pf7580_set_voltage(struct pf7580_power *p, int uv)
+{
+	int cur, ret;
+
+	if (!p)
+		return -ENODEV;
+
+	mutex_lock(&p->lock);
+	if (!p->clock_enabled) {
+		ret = -EAGAIN;
+		goto out;
+	}
+	cur = regulator_get_voltage(p->vdd_g3d);
+	if (cur == uv) {
+		ret = 0;
+		goto out;
+	}
+	ret = regulator_set_voltage(p->vdd_g3d, uv, uv);
+	if (ret)
+		dev_err(p->dev, "pf7580: vdd_g3d %d uV failed: %d\n", uv, ret);
+out:
+	mutex_unlock(&p->lock);
+	return ret;
+}
+
+int pf7580_power_probe(struct device *dev, void __iomem *regs,
+		       struct pf7580_power **out)
+{
+	struct pf7580_power *p;
+	unsigned long rate;
+	int uv, ret;
+
+	if (!dev || !regs || !out)
+		return -EINVAL;
+
+	p = devm_kzalloc(dev, sizeof(*p), GFP_KERNEL);
+	if (!p)
+		return -ENOMEM;
+	p->dev = dev;
+	p->regs = regs;
+	mutex_init(&p->lock);
+
+	/* 1. clocks, by stock DT clock-name (kbase gpu_get_clock order). */
+	ret = pf7580_claim_clks(p);
+	if (ret)
+		goto err;
+
+	/* 2. regulator by global name: stock DT has no vdd_g3d-supply. */
+	p->vdd_g3d = regulator_get(NULL, "vdd_g3d");
+	if (IS_ERR_OR_NULL(p->vdd_g3d)) {
+		ret = p->vdd_g3d ? PTR_ERR(p->vdd_g3d) : -ENODEV;
+		dev_err(dev, "pf7580: regulator_get(vdd_g3d) failed: %d\n",
+			ret);
+		p->vdd_g3d = NULL;
+		goto err;
+	}
+	ret = regulator_enable(p->vdd_g3d);
+	if (ret) {
+		dev_err(dev, "pf7580: vdd_g3d enable failed: %d\n", ret);
+		goto err_reg;
+	}
+
+	/* 3. voltage must match the rate the CMU left behind. */
+	rate = clk_get_rate(p->aclk_g3d);
+	uv = pf7580_opp_voltage((int)(rate / 1000000));
+	if (uv < 0) {
+		dev_warn(dev, "pf7580: boot rate %lu Hz has no OPP entry\n",
+			 rate);
+	} else {
+		ret = regulator_set_voltage(p->vdd_g3d, uv, uv);
+		if (ret) {
+			dev_err(dev, "pf7580: boot voltage %d uV failed: %d\n",
+				uv, ret);
+			goto err_vol;
+		}
+	}
+
+	/* 4. runtime PM: 50 ms autosuspend like kbase, then power the block.
+	 * The vendor bus notifier already attached us to pd-g3d, so the
+	 * get_sync below sequences the domain (genpd) + our resume callback
+	 * (clock + reset + cores) in one call. */
+	pm_runtime_set_autosuspend_delay(dev, PF7580_AUTOSUSPEND_MS);
+	pm_runtime_use_autosuspend(dev);
+	pm_runtime_enable(dev);
+
+	ret = pm_runtime_get_sync(dev);
+	if (ret < 0) {
+		dev_err(dev, "pf7580: initial power-up failed: %d\n", ret);
+		pm_runtime_put_noidle(dev);
+		goto err_pm;
+	}
+	pm_runtime_put_autosuspend(dev);
+
+	*out = p;
+	return 0;
+
+err_pm:
+	pm_runtime_disable(dev);
+err_vol:
+	regulator_disable(p->vdd_g3d);
+err_reg:
+	regulator_put(p->vdd_g3d);
+	p->vdd_g3d = NULL;
+err:
+	pf7580_put_clks(p);
+	devm_kfree(dev, p);
+	return ret;
+}
+
+void pf7580_power_remove(struct pf7580_power *p)
+{
+	struct device *dev;
+
+	if (!p)
+		return;
+	dev = p->dev;
+
+	pm_runtime_get_sync(dev);
+	pf7580_runtime_suspend(p);
+	pm_runtime_put_noidle(dev);
+	pm_runtime_disable(dev);
+
+	if (p->vdd_g3d) {
+		regulator_disable(p->vdd_g3d);
+		regulator_put(p->vdd_g3d);
+		p->vdd_g3d = NULL;
+	}
+	pf7580_put_clks(p);
+	devm_kfree(dev, p);
+}
diff -u '--exclude=.git' -Naur a/drivers/gpu/drm/panfrost/panfrost7580_power.h b/drivers/gpu/drm/panfrost/panfrost7580_power.h
--- a/drivers/gpu/drm/panfrost/panfrost7580_power.h	1969-12-31 19:00:00.000000000 -0500
+++ b/drivers/gpu/drm/panfrost/panfrost7580_power.h	2026-11-21 00:00:00.000000000 -0500
@@ -0,0 +1,201 @@
+/*
+ * panfrost7580_power.h - PM / clock / reset sequencing for Mali-T720
+ *                        (Exynos 7580, j7elte) panfrost-class driver.
+ *
+ * Provenance (all read from the shared 3.10.108 tree, never modified):
+ *  - clocks / regulator / DVFS order: drivers/gpu/arm/t7xx/r15p0/
+ *    platform/exynos/{gpu_exynos7580.c,gpu_control.c,gpu_dvfs_api.c,
+ *    gpu_notifier.c,mali_kbase_platform.h}
+ *  - power-domain attach + on/off sequencing:
+ *    arch/arm64/mach-exynos/pm_domains.c
+ *  - PMIC BUCK4/LDO10 sync: drivers/regulator/s2mpu03.c,
+ *    arch/arm64/boot/dts/exynos7580-j7elte_rev06.dts
+ *  - reset / PWRON register map:
+ *    drivers/gpu/arm/t7xx/r15p0/mali_midg_regmap.h
+ *
+ * Stock-DT invariants this code relies on (stock dt.img is never rebuilt,
+ * so these are load-bearing, not advisory):
+ *  - mali@0x11400000 carries clock-names fin_pll, fout_g3d_pll, aclk_g3d,
+ *    mout_g3d, dout_aclk_g3d, aclk_g3d_400 and
+ *    samsung,power-domain = <&pd_g3d>. There is NO vdd_g3d-supply property,
+ *    so the regulator MUST be claimed with regulator_get(NULL, "vdd_g3d")
+ *    (global name lookup, exactly as kbase does). A dev-based
+ *    regulator_get(dev, "vdd_g3d") fails on the stock DT.
+ *  - s2mpu03 DT has g3d_en = <1>; BUCK4/vdd_g3d is regulator-always-on +
+ *    regulator-boot-on. The GPU driver only manages its own consumer
+ *    refcount / voltage vote, never the rail itself.
+ *  - There are NO clocks named sclk_g3d / gate_pclk on 7580 G3D
+ *    (drivers/clk/samsung/clk-exynos7580.c GATE() list: aclk and pclk gates only,
+ *    all CLK_IGNORE_UNUSED). Do NOT clk_get() those names; probe would fail.
+ *
+ * Wiring for the owning driver (dev_pm_ops stays with the driver so that
+ * drvdata ownership never collides with this helper):
+ *
+ *	static int drv_runtime_suspend(struct device *dev)
+ *	{ return pf7580_runtime_suspend(drv_to_power(dev)); }
+ *	static int drv_runtime_resume(struct device *dev)
+ *	{ return pf7580_runtime_resume(drv_to_power(dev)); }
+ *	static int drv_suspend(struct device *dev)
+ *	{ return pf7580_pm_suspend(dev, drv_to_power(dev)); }
+ *	static int drv_resume(struct device *dev)
+ *	{ return pf7580_pm_resume(dev, drv_to_power(dev)); }
+ *	static const struct dev_pm_ops drv_pm_ops = {
+ *		SET_SYSTEM_SLEEP_PM_OPS(drv_suspend, drv_resume)
+ *		SET_RUNTIME_PM_OPS(drv_runtime_suspend, drv_runtime_resume,
+ *				   NULL)
+ *	};
+ */
+
+#ifndef PANFROST7580_POWER_H
+#define PANFROST7580_POWER_H
+
+#include <linux/types.h>
+
+struct device;
+
+/* Autosuspend idle delay (ms). Matches kbase default: platform
+ * runtime_pm_delay_time is 50 when the attribute is 0
+ * (mali_kbase_platform.c: gpu_validate_attrib_data). */
+#define PF7580_AUTOSUSPEND_MS	50
+
+/* Reset / IRQ register map (mali_midg_regmap.h). */
+#define PF7580_GPU_COMMAND		0x030
+#define PF7580_GPU_COMMAND_SOFT_RESET	0x01
+#define PF7580_GPU_COMMAND_HARD_RESET	0x02
+#define PF7580_GPU_IRQ_RAWSTAT		0x020
+#define PF7580_GPU_IRQ_CLEAR		0x024
+#define PF7580_GPU_IRQ_MASK		0x028
+#define PF7580_RESET_COMPLETED		(1u << 8)
+
+/* Core power registers (mali_midg_regmap.h). */
+#define PF7580_SHADER_PRESENT_LO	0x100
+#define PF7580_SHADER_PRESENT_HI	0x104
+#define PF7580_TILER_PRESENT_LO		0x110
+#define PF7580_TILER_PRESENT_HI		0x114
+#define PF7580_L2_PRESENT_LO		0x120
+#define PF7580_L2_PRESENT_HI		0x124
+#define PF7580_SHADER_READY_LO		0x140
+#define PF7580_SHADER_READY_HI		0x144
+#define PF7580_TILER_READY_LO		0x150
+#define PF7580_TILER_READY_HI		0x154
+#define PF7580_L2_READY_LO		0x160
+#define PF7580_L2_READY_HI		0x164
+#define PF7580_SHADER_PWRON_LO		0x180
+#define PF7580_SHADER_PWRON_HI		0x184
+#define PF7580_TILER_PWRON_LO		0x190
+#define PF7580_TILER_PWRON_HI		0x194
+#define PF7580_L2_PWRON_LO		0x1A0
+#define PF7580_L2_PWRON_HI		0x1A4
+
+/* Stock 7580 DVFS operating points actually programmed by kbase
+ * (gpu_exynos7580.c: gpu_dvfs_table_default[]): { clock MHz, voltage uV }.
+ * Rail limits are 600000..1300000 uV (BUCK4 DT node); the driver must stay
+ * inside the rows below, never the rail extremes. */
+struct pf7580_opp {
+	int mhz;
+	int uv;
+};
+
+static const struct pf7580_opp pf7580_opps[] = {
+	{ 800, 1100000 },
+	{ 734, 1100000 },
+	{ 668, 1100000 },
+	{ 534, 1000000 },
+	{ 440, 1000000 },
+	{ 350, 1000000 },
+	{ 266,  900000 },
+	{ 160,  900000 },
+};
+
+struct pf7580_power {
+	struct device	*dev;
+	void __iomem	*regs;
+	struct clk	*clks[6];	/* parallel to pf7580_clk_names */
+	struct clk	*aclk_g3d;	/* == clks[2], functional clock */
+	struct clk	*mout_g3d;	/* == clks[3], re-rate parking mux */
+	struct clk	*fout_g3d_pll;	/* == clks[1], rate knob */
+	struct clk	*aclk_g3d_400;	/* == clks[5], safe parking clock */
+	struct regulator *vdd_g3d;	/* BUCK4, global lookup "vdd_g3d" */
+	struct mutex	lock;		/* serialises power/clk/voltage */
+	bool		clock_enabled;	/* aclk_g3d prepare_enable state */
+};
+
+/* Stock DT clock-names in clk_get order (kbase gpu_get_clock). Index 2/3/1/5
+ * are aliased above; 0 (fin_pll) and 4 (dout_aclk_g3d) are get-only. */
+static const char * const pf7580_clk_names[6] = {
+	"fin_pll", "fout_g3d_pll", "aclk_g3d",
+	"mout_g3d", "dout_aclk_g3d", "aclk_g3d_400",
+};
+
+/*
+ * Probe: claim clocks + regulator, park the G3D mux, enable runtime PM,
+ * power the block through the exact stock sequence, and idle-suspend.
+ * regs must already be ioremapped by the caller (IORESOURCE_MEM,0 =
+ * 0x11400000/0x5000). The power domain needs NO driver code: the vendor
+ * bus notifier (pm_domains.c: exynos_pm_notifier_call, BUS_NOTIFY_BIND_DRIVER)
+ * already added this device to pd-g3d from samsung,power-domain, so
+ * pm_runtime_get_sync() below powers pd-g3d via genpd automatically.
+ * Returns 0 with *out filled, or a negative errno (clocks/regulator are
+ * released again on failure, mirroring kbase gpu_get_clock unwind order).
+ */
+int pf7580_power_probe(struct device *dev, void __iomem *regs,
+		       struct pf7580_power **out);
+
+/* Remove: cancel runtime PM, force the block off synchronously, release
+ * clocks + regulator. The domain itself is detached by the vendor bus
+ * notifier on unbind; never touch PMU CONFIGURATION here. */
+void pf7580_power_remove(struct pf7580_power *p);
+
+/*
+ * Runtime PM callbacks (owning driver wires these into dev_pm_ops):
+ *  - suspend: cores off (L2/shader/tiler PWRON=0 + READY==0 poll),
+ *    aclk_g3d disable. genpd then drops pd-g3d.
+ *  - resume: aclk_g3d enable, SOFT_RESET (+HARD_RESET fallback),
+ *    cores on L2 -> shader -> tiler with READY polls,
+ *    boot OPP voltage check.
+ * Both are best-effort on the suspend path (dev_warn + still gate the
+ * clock) and strict on probe/resume.
+ */
+int pf7580_runtime_suspend(struct pf7580_power *p);
+int pf7580_runtime_resume(struct pf7580_power *p);
+
+/*
+ * System-sleep callbacks:
+ *  - suspend: if the device is not already runtime-suspended, run the
+ *    runtime-suspend path so the clock is gated before the SoC sleeps.
+ *    No PM notifier is used: this tree's genpd owns domain sequencing and
+ *    a second notifier (like kbase's gpu_pm_notifier) would double-drive it
+ *    under a DRM driver that already has dev_pm_ops.
+ *  - resume: full power-on (clock + reset + cores), unconditionally: after
+ *    system suspend the GPU state is lost (pd-g3d was off).
+ */
+int pf7580_pm_suspend(struct device *dev, struct pf7580_power *p);
+int pf7580_pm_resume(struct device *dev, struct pf7580_power *p);
+
+/*
+ * Re-rate fout_g3d_pll with the stock parking dance (kbase gpu_set_clock):
+ * enable aclk_g3d_400 -> parent mout_g3d to it -> set_rate -> parent back ->
+ * disable parking clock. Caller must hold a runtime-PM reference across the
+ * call; refuses with -EAGAIN when the clock is gated, -EPERM when called
+ * with the domain off is reported by the caller checking power state first.
+ * Voltage ordering is the CALLER's job (GPU_SET_CLK_VOL rule, dvfs_api.c):
+ * scaling up: pf7580_set_voltage() first, then pf7580_set_rate();
+ * scaling down: pf7580_set_rate() first, then pf7580_set_voltage().
+ * Reversing the up-order browns out the 534->668 / 668->800 steps, which
+ * cross the 1.00 V -> 1.10 V corner (see docs/reports/gpu31-power.md F4).
+ */
+int pf7580_set_rate(struct pf7580_power *p, unsigned long rate_hz);
+
+/*
+ * Vote a voltage on vdd_g3d. No-op when already at target; refuses with
+ * -EAGAIN while the clock is gated (mirrors kbase gpu_set_voltage's
+ * power-off guard: programming VSEL with the domain dark applies on the
+ * next power-up at an uncontrolled point of the sequence).
+ */
+int pf7580_set_voltage(struct pf7580_power *p, int uv);
+
+/* Look up the stock voltage for a clock rate (MHz); used at probe/resume to
+ * make sure the rail matches the rate the bootloader/CMU left behind. */
+int pf7580_opp_voltage(int mhz);
+
+#endif /* PANFROST7580_POWER_H */
diff -u '--exclude=.git' -Naur a/drivers/gpu/drm/panfrost/panfrost7580_submit.c b/drivers/gpu/drm/panfrost/panfrost7580_submit.c
--- a/drivers/gpu/drm/panfrost/panfrost7580_submit.c	1969-12-31 19:00:00.000000000 -0500
+++ b/drivers/gpu/drm/panfrost/panfrost7580_submit.c	2026-11-21 00:00:00.000000000 -0500
@@ -0,0 +1,1612 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * panfrost7580_drv.c - render-minor-only platform driver for Mali-T720
+ * (Exynos 7580, j7elte) on Nura 3.10.108.
+ *
+ * Binds the stock node (never edited):
+ *   mali@0x11400000, compatible "arm,mali",
+ *   reg 0x11400000/0x5000, IRQs (index order) job/mmu/gpu = SPI
+ *   282/283/281, 6 clocks (fin_pll, fout_g3d_pll, aclk_g3d, mout_g3d,
+ *   dout_aclk_g3d, aclk_g3d_400), power-domain <&pd_g3d> (0x60).
+ *
+ * Registers one DRM device with NO modeset (driver_features has no
+ * DRIVER_MODESET) and DRIVER_RENDER_ONLY set, so the 3.10 core
+ * allocates ONLY the render minor (no primary, no controlD); no
+ * /dev/dri/cardN appears and /dev/fb0 + fbdev X stay untouched.
+ *
+ * Six v5.2 ioctls (0x00 SUBMIT, 0x01 WAIT_BO, 0x02 CREATE_BO,
+ * 0x03 MMAP_BO, 0x04 GET_PARAM, 0x05 GET_BO_OFFSET), byte-identical to
+ * Linux v5.2 include/uapi/drm/panfrost_drm.h. SUBMIT programs the job
+ * slots via the jobs slice; power/clocks/regulator via the power
+ * slice; DVFS via the devfreq slice.
+ *
+ * Probe order: ioremap -> present regs -> power -> devfreq ->
+ * GEM/MM -> IRQs -> DRM attach. Remove unwinds in reverse.
+ */
+
+#include <linux/highmem.h>
+#include <linux/mm.h>
+#include <linux/dma-mapping.h>
+#include <linux/err.h>
+#include <linux/interrupt.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/of_device.h>
+#include <linux/platform_device.h>
+#include <linux/pm_runtime.h>
+#include <linux/uaccess.h>
+#include <linux/slab.h>
+
+#include <drm/drmP.h>
+#include <drm/drm.h>
+
+#include <linux/dma-fence.h>		/* 0001 */
+#include <linux/dma-resv.h>		/* 0002 */
+#include <drm_syncobj.h>		/* 0003 */
+#include <drm_sched.h>			/* 0004 */
+#include <linux/bug.h>			/* opsfix: BUILD_BUG_ON */
+
+#include "panfrost_drm.h"
+#include "panfrost7580_gem.h"
+#include "panfrost7580_ioctl.h"
+#include "panfrost7580_jm_hw.h"
+#include "panfrost7580_job.h"
+#include "panfrost7580_mmu.h"
+#include "panfrost7580_power.h"
+#include "pf7580_devfreq.h"
+#include "panfrost7580_drv.h"
+
+/* ------------------------------------------------------------------ */
+/* SUBMIT glue: staged ioctl (kernel-memory arrays) -> jobs core      */
+/* ------------------------------------------------------------------ */
+
+/*
+ * p7580_drv_submit - validate + reserve + sched-dispatch one SUBMIT.
+ *
+ * @drv:   device state (job slots, MMU, GEM allocator).
+ * @dev:   DRM device (GEM lookups + dev_private == &drv->gd).
+ * @file_priv: caller DRM file (BO handles + out-sync scope).
+ * @args:  staged SUBMIT (in_syncs/bo_handles point at KERNEL memory
+ *         staged by panfrost_ioctl_submit via copy_from_user).
+ *
+ * Steps (mirrors v5.2 panfrost_job_push on the 0001-0004 shims):
+ *  1. validate jc/requirements/counts (shared p7580_jc_valid +
+ *     P7580_MAX_* caps; slot legal + present).
+ *  2. resolve in_sync handles -> fences (0003 find_fence, ref held).
+ *  3. look up + pin every BO (GEM ref held), reserve each resv
+ *     (0002 plain mutex), map unmapped pages into AS 0 and track them
+ *     on drv->bo_list for the remove/unload unmap walk.
+ *  4. sched job alloc on the slot entity + deps (in-fences, implicit
+ *     excl fences) + submit; out-sync install (0003 replace_fence).
+ * Errors drop every taken ref and release every taken lock; the
+ * caller (ioctl) never touches userspace here.
+ *
+ * Power contract (F-SUB1): the caller (the SUBMIT ioctl override below)
+ * holds one runtime-PM ref across this call for the synchronous
+ * MMU-map + sched-queue leg. The async leg is covered separately: one
+ * extra live-job ref is armed just before drm_sched_job_submit and
+ * released in p7580_drv_free_job after the job retires, so the block
+ * cannot autosuspend between the ioctl return and the run_job worker
+ * (or the timeout/recover path) touching HEAD/START/RESET registers.
+ * p7580_drv_pm_put is only ever called for a ref this file took via
+ * p7580_drv_pm_get (never balances someone else's get).
+ */
+/* Live-job helpers (defined after the backend ops; free_job calls release). */
+static void p7580_drv_job_pm_arm(struct p7580_drv *drv);
+static void p7580_drv_job_pm_release(struct p7580_drv *drv);
+
+/* Scheduler backend ops for the 0004 shim. The sched job owner IS
+ * the submit job; the file state is recovered from the entity. */
+static struct drm_sched p7580_drv_sched;
+static int p7580_drv_sched_live;
+static DEFINE_MUTEX(p7580_drv_sched_lock);
+
+/* Bounded SUBMIT/run_job trace (schedtrace): ST-IOCTL/ST-QUEUE see
+ * the ioctl entry and the 0004 queue handoff; ST-RUN/ST-PMGET see
+ * the async worker entry and the run_job PM re-get verdict.
+ * Shared budget: first 8 SUBMITs print (0 = off). Plain static
+ * (NOT module_param_named): the integrator's object rule defines
+ * KBUILD_MODNAME at Image link time, but slice-level -fsyntax-only
+ * checks compile this file standalone (same reason job.c keeps
+ * p7580_job_trace a plain static). Racy dec under concurrent
+ * ioctls overshoots by at most a line or two; harmless. */
+static unsigned int p7580_sched_trace = 8;
+
+/* Bounded SUBMIT error attribution (gpu31-multidep): every early
+ * error return in p7580_drv_submit routes its errno through here so
+ * the next silicon assert carries stage + errno instead of a bare
+ * ioctl rc. Shares the ST budget discipline (first 8 SUBMITs print).
+ * stage is a short verb: validate/in_sync/bo/job/ops/dep/queue/
+ * out_sync. */
+static long p7580_submit_err(const char *stage, long err)
+{
+	if (p7580_sched_trace && err) {
+		p7580_sched_trace--;
+		pr_info("p7580_sched: submit_err stage=%s rc=%ld\n", stage, err);
+	}
+	return err;
+}
+
+/* gpu31-iova: dedicated budget for the map/unmap trace (map prints
+ * once per fresh bind, unmap once per free-time unbind; the fault
+ * path re-arms via trace_arm like the job trace). Raised by the
+ * debugfs iova_arm knob (jobs slice); 0 stops it. */
+unsigned int p7580_iova_trace = 64;
+
+static unsigned int p7580_drv_run_seq = 0;
+
+static struct dma_fence *p7580_drv_run_job(struct drm_sched_job *sched_job)
+{
+	struct p7580_submit_job *job = sched_job ? sched_job->owner : NULL;
+	struct drm_sched_entity *ent = sched_job ? sched_job->entity : NULL;
+	struct p7580_drv_file *df;
+	struct p7580_drv *drv;
+	int slot;
+
+	/* ST-RUN (entry): first statement -- before any deref/derivation.
+	 * Numeric (%lu) so kptr_restrict cannot censor it. Proves the
+	 * 0004 pump called OUR run_job; per-guard bail prints below name
+	 * the exact reject. runexp= is our own address (no symbol lookup
+	 * needed); ST-OPS run= must equal it. */
+	if (p7580_sched_trace) {
+		p7580_sched_trace--;
+		pr_info("p7580_sched: run job=%lu ent=%lu owner=%lu ops=%lu runexp=%lu\n",
+			(unsigned long)sched_job, (unsigned long)ent,
+			(unsigned long)(sched_job ? sched_job->owner : NULL),
+			(unsigned long)(sched_job ? sched_job->ops : NULL),
+			(unsigned long)&p7580_drv_run_job);
+	}
+	if (!sched_job || !job) {
+		if (p7580_sched_trace) {
+			p7580_sched_trace--;
+			pr_info("p7580_sched: run_bail NULLJOB job=%lu\n",
+				(unsigned long)sched_job);
+		}
+		return ERR_PTR(-EINVAL);
+	}
+	/* Monotonic entry stamp: free_job prints ran=N so the
+	 * dispatch->retire order is provable even if a print is lost. */
+	job->run_seq = ++p7580_drv_run_seq;
+
+	/* Probenumeric: trust the SUBMIT-stamped file/driver pointers on
+	 * the job (stamped next to slot at queue time); the entity-pointer
+	 * container_of math is fallback-only (range-checked) for jobs
+	 * queued before this Stamp existed. ent itself is used only for
+	 * the fallback -- never trusted blindly. */
+	df = (struct p7580_drv_file *)job->file_priv;
+	drv = (struct p7580_drv *)job->drv_priv;
+	slot = job->slot;
+	if (slot < 0 || slot >= P7580_NUM_JOB_SLOTS || !df || !drv) {
+		struct p7580_drv_file *edf;
+		if (p7580_sched_trace) {
+			p7580_sched_trace--;
+			pr_info("p7580_sched: run_fallback seq=%u slot=%d sslot=%d\n",
+				job->seqno, slot, sched_job->slot);
+		}
+		edf = ent ? container_of(ent, struct p7580_drv_file, entity[0]) : NULL;
+		if (edf && ent >= &edf->entity[0] &&
+		    ent < &edf->entity[P7580_NUM_JOB_SLOTS]) {
+			if (!df)
+				df = edf;
+			if (!drv)
+				drv = df->drv;
+			if (slot < 0 || slot >= P7580_NUM_JOB_SLOTS)
+				slot = (int)(ent - &edf->entity[0]);
+		}
+	}
+	if (slot < 0 || slot >= P7580_NUM_JOB_SLOTS) {
+		if (p7580_sched_trace) {
+			p7580_sched_trace--;
+			pr_info("p7580_sched: run_bail BADSLOT seq=%u slot=%d\n",
+				job->seqno, slot);
+		}
+		return ERR_PTR(-EINVAL);
+	}
+	job->slot = slot;
+	if (!df || (ent && (ent < &df->entity[0] ||
+			    ent >= &df->entity[P7580_NUM_JOB_SLOTS]))) {
+		/* ent outside the stamped df: trust the stamp, distrust ent. */
+		if (p7580_sched_trace) {
+			p7580_sched_trace--;
+			pr_info("p7580_sched: run_bail BADENT seq=%u ent=%lu df=%lu\n",
+				job->seqno, (unsigned long)ent,
+				(unsigned long)df);
+		}
+		if (!df)
+			return ERR_PTR(-ENODEV);
+	}
+	if (!drv)
+		drv = df->drv;
+	if (!drv) {
+		if (p7580_sched_trace) {
+			p7580_sched_trace--;
+			pr_info("p7580_sched: run_bail NODRV seq=%u slot=%d df=%lu\n",
+				job->seqno, slot, (unsigned long)df);
+		}
+		return ERR_PTR(-ENODEV);
+	}
+	/* Async worker context (0004 wq): the ioctl's synchronous PM
+	 * ref is long gone (returned) and the live-job ref only
+	 * guarantees the block was continuously powered since queue
+	 * time -- it cannot resurrect a block that suspended despite
+	 * that (get/put counting bug elsewhere) or that failed
+	 * resume. Re-get here so HEAD/AFFINITY/CONFIG/START writes
+	 * below never hit a dark block; fail the job (ERR_PTR, freed
+	 * by the 0004 F4 path) instead of hanging the bus. */
+	/* ST-RUN (dispatched): slot + jc the job will program. */
+	if (p7580_sched_trace) {
+		p7580_sched_trace--;
+		pr_info("p7580_sched: run_job seq=%u slot=%d sslot=%d jc=0x%llx owner=%lu\n",
+			job->seqno, slot, sched_job->slot,
+			(unsigned long long)job->jc, (unsigned long)job);
+	}
+	if (p7580_drv_pm_get(drv) < 0) {
+		/* ST-PMGET (fail): dark block (negative errno only;
+		 * pm_runtime_get_sync returns 1 when already active,
+		 * which the helper normalises to 0 = powered), job
+		 * failed closed. */
+		if (p7580_sched_trace) {
+			p7580_sched_trace--;
+			pr_info("p7580_sched: pm_get FAIL seq=%u slot=%d\n",
+				job->seqno, slot);
+		}
+		return ERR_PTR(-EIO);
+	}
+	/* ST-PMGET (held): re-get succeeded, HEAD/START writes allowed. */
+	if (p7580_sched_trace) {
+		p7580_sched_trace--;
+		pr_info("p7580_sched: pm_get HELD seq=%u slot=%d\n",
+			job->seqno, slot);
+	}
+	{
+		/* Arm-time fence (gpu31-armfence): bind sched_job->fence
+		 * (allocated at arm time, already on out_sync since
+		 * SUBMIT) as this job's done_fence (one shared ref) and
+		 * program the slot. No out_sync work here: the install
+		 * happened during the ioctl. */
+		struct dma_fence *armed = sched_job->fence;
+		struct dma_fence *fence;
+
+		if (!armed)
+			return ERR_PTR(-ENODATA);
+		/* Bind the arm-time fence: one shared ref, never a
+		 * second allocation (the shim pump verifies pointer
+		 * identity on return). */
+		job->done_fence = armed;
+		dma_fence_get(armed);
+		p7580_job_hw_submit(&drv->jd, job);
+		fence = armed;
+		/* Non-owning alias for the legacy out_sync leg. */
+		job->render_done_fence = fence;
+
+		/* gpu31-instrtype: publish this job's fence as the exclusive
+		 * (write) fence on every submitted BO. Later submits of the
+		 * same BOs take it as an implicit sched dependency at queue
+		 * time (get_excl leg), which serialises batches sharing
+		 * pool/scratch/heap BOs. Without this, two live batches can
+		 * write the same pool BO concurrently while Mesa recycles
+		 * it (IOVA-identical submits), and the GPU reads a torn
+		 * chain/FBD -> INSTR_TYPE_MISMATCH/DATA_INVALID_FAULT on
+		 * the victim slot. Locking: the 0002 shim locks resv->lock
+		 * inside add_excl (never take it here: same
+		 * SUBMIT-DEADLOCK rule as the get_excl leg). Fences that
+		 * retire in the same dispatch batch still share the older
+		 * excl until this stamp lands; deps are taken on the
+		 * latest *unsignaled* fence, so a retired excl does not
+		 * gate. */
+		{
+			struct p7580_submit_job *rj = job;
+			uint32_t k;
+
+			for (k = 0; k < rj->bo_count; k++) {
+				struct drm_gem_object *o =
+					(struct drm_gem_object *)rj->bos[k];
+
+				if (!o)
+					continue;
+				dma_resv_add_excl_fence(
+					&to_p7580_bo(o)->resv,
+					fence);
+			}
+		}
+		p7580_drv_pm_put(drv);
+		return fence;
+	}
+}
+
+/* gpu31-ptewalk: fault-time AS0 page-table walk for the faulting jc.
+ * Bounded, PM-held, process-context only (timedout workqueue before
+ * recover tears state down): walk the 4-level LPAE tables from
+ * drv->mmu.root_dma over at most 4 kmap/kunmap pairs and report the
+ * leaf PTE for jc, then compare it against the owning BO's current
+ * page (BO identity from the faulting job's SUBMIT-time snapshot via
+ * its referenced object pointers). Prints one pr_err line:
+ * leaf phys vs BO page phys + the first 32 descriptor bytes re-read
+ * from the leaf's physical page via kmap in the same handler.
+ * MATCH => GPU-side stale fetch (TLB/cache, not tables);
+ * MISMATCH => page-table/IOVA lifetime bug. Pure CPU reads + the
+ * BO's own dma mapping; never touches the TLB. Skips dark (fails
+ * closed: PM get failed) and never sleeps beyond kmap/kunmap on
+ * lowmem table pages (same discipline as the GEM debug-read leg).
+ * Bounded: one page walk + one 32-B re-read, always. */
+static noinline void p7580_drv_ptewalk_pin(struct p7580_drv *drv,
+					    struct p7580_submit_job *job)
+{
+	dma_addr_t cur;
+	unsigned int l;
+	u64 e = 0;
+	u64 jc;
+	u64 jc_page;
+	unsigned int slot;
+	unsigned int seq;
+	u64 leaf_pte = 0;
+	phys_addr_t leaf_phys = 0;
+	struct drm_gem_object *owner = NULL;
+	struct p7580_bo *owner_bo = NULL;
+	struct drm_gem_object *live_obj = NULL;
+	struct p7580_bo *live_bo = NULL;
+	u64 live_iova = 0;
+	size_t live_size = 0;
+	u64 snap_iova = 0;
+	size_t snap_size = 0;
+	unsigned long owner_iova = 0;
+	unsigned int owner_npages = 0;
+	unsigned int page_idx = 0;
+	unsigned int page_off = 0;
+	phys_addr_t bo_phys = 0;
+	int bo_ok = 0;
+	u32 pw[128];
+	unsigned int wi;
+	int have_bytes = 0;
+
+	pr_err("p7580_job: TMD-WALKER drv=%lu job=%lu\n",
+	       (unsigned long)drv, (unsigned long)job);
+	if (!drv || !job)
+		return;
+	if (!drv->mmu.root_dma)
+		return;
+	jc = job->jc;
+	slot = (unsigned int)job->slot;
+	seq = job->seqno;
+	jc_page = jc & PAGE_MASK;
+	cur = drv->mmu.root_dma;
+	for (l = 0; l < 3; l++) {
+		u64 *cpu;
+		struct page *pg;
+		unsigned int shift = 12 + (3 - l) * 9;
+		unsigned int idx = (unsigned int)((jc_page >> shift) & 0x1FFu);
+
+		pg = pfn_to_page((unsigned long)(cur >> PAGE_SHIFT));
+		cpu = kmap(pg);
+		e = cpu[idx];
+		kunmap(pg);
+		if ((e & 3ULL) != 3ULL) {
+			pr_err("p7580_job: PTEWALK slot=%d seq=%u jc=0x%llx level=%u UNMAPPED\n",
+			       slot, seq, (unsigned long long)jc, l);
+			return;
+		}
+		cur = (dma_addr_t)(e & ~(u64)0xFFFULL);
+	}
+	{
+		u64 *cpu;
+		struct page *pg;
+		unsigned int idx = (unsigned int)((jc_page >> 12) & 0x1FFu);
+
+		pg = pfn_to_page((unsigned long)(cur >> PAGE_SHIFT));
+		cpu = kmap(pg);
+		e = cpu[idx];
+		kunmap(pg);
+	}
+	if ((e & 3ULL) != 1ULL) {
+		pr_err("p7580_job: PTEWALK slot=%d seq=%u jc=0x%llx leaf=0x%llx NOT-LEAF\n",
+		       slot, seq, (unsigned long long)jc,
+		       (unsigned long long)e);
+		return;
+	}
+	leaf_pte = e;
+	leaf_phys = (phys_addr_t)(e & ~(u64)0xFFFULL);
+	/* Owner resolution, two views. (1) SUBMIT-time snapshot: jc
+	 * inside one submitted BO's IOVA. The job's bos[] array holds
+	 * one referenced pointer per handle (F-JT2, stable across
+	 * close); safe to dereference here in process context while
+	 * the job owns the refs. (2) Live view: scan drv->bo_list
+	 * under bo_lock for an IOVA range containing jc, taking a GEM
+	 * ref while linked. Snapshot-miss + live-hit (int29 NO-OWNER
+	 * with jc inside an ERR-MAP range) means a stale snapshot,
+	 * not an unmapped jc; miss + miss means genuinely unowned. */
+	if (job->bos && job->bo_count) {
+		unsigned int i;
+
+		for (i = 0; i < job->bo_count; i++) {
+			struct drm_gem_object *o =
+				(struct drm_gem_object *)job->bos[i];
+			struct p7580_bo *b;
+
+			if (!o)
+				continue;
+			b = to_p7580_bo(o);
+			if (b && b->iova_valid && jc >= b->iova &&
+			    jc + 32 <= b->iova + b->base.size) {
+				owner = o;
+				owner_bo = b;
+				snap_iova = b->iova;
+				snap_size = b->base.size;
+				break;
+			}
+		}
+	}
+	mutex_lock(&drv->bo_lock);
+	{
+		struct p7580_drv_bo *le;
+
+		list_for_each_entry(le, &drv->bo_list, node) {
+			if (jc >= le->iova && jc + 32 <= le->iova + le->size) {
+				drm_gem_object_reference(le->obj);
+				live_obj = le->obj;
+				live_iova = le->iova;
+				live_size = le->size;
+				break;
+			}
+		}
+	}
+	mutex_unlock(&drv->bo_lock);
+	if (live_obj)
+		live_bo = to_p7580_bo(live_obj);
+	/* Fall back to the live owner when the snapshot missed, so the
+	 * MATCH/MISMATCH comparison still runs against the BO that is
+	 * actually bound at fault time. */
+	if (!owner && live_bo) {
+		owner = live_obj;
+		owner_bo = live_bo;
+	}
+	if (owner && owner_bo) {
+		owner_iova = owner_bo->iova;
+		owner_npages = p7580_bo_npages(owner);
+		page_idx = (unsigned int)((jc - owner_bo->iova) >> PAGE_SHIFT);
+		page_off = (unsigned int)((jc - owner_bo->iova) & (PAGE_SIZE - 1));
+		bo_phys = p7580_bo_dma_addr(owner, page_idx);
+		bo_ok = (bo_phys != 0);
+	} else {
+		page_off = (unsigned int)(jc & (PAGE_SIZE - 1));
+	}
+	/* Unconditional GPU-view dump (gpu31-jddecode): 128 words
+	 * (512 B) at leaf_phys + page_off, re-read from the leaf's
+	 * physical page via kmap in the same handler: the 32-B header
+	 * (w0..w7), the fragment payload (bounds + framebuffer pointer,
+	 * w8..w15) and the following 448 B of pool bytes. Runs even
+	 * with NO-OWNER (page_off is then the jc offset within its
+	 * page). The JD body (64-B FRAGMENT_JOB) never crosses a page
+	 * (pool allocs are 64-B aligned); if the 512-B window would
+	 * cross, the in-page prefix is dumped and the line is marked
+	 * JD-TRUNC (word count in jd_words). */
+	if (page_off + 32 > PAGE_SIZE) {
+		pr_err("p7580_job: PTEWALK slot=%d seq=%u jc=0x%llx leaf_phys=0x%llx bo_phys=0x%llx CROSS-PAGE snap=0x%llx/0x%zx live=0x%llx/0x%zx\n",
+		       slot, seq, (unsigned long long)jc,
+		       (unsigned long long)leaf_phys,
+		       (unsigned long long)bo_phys,
+		       (unsigned long long)snap_iova, snap_size,
+		       (unsigned long long)live_iova, live_size);
+		if (live_obj)
+			drm_gem_object_unreference_unlocked(live_obj);
+		return;
+	} else {
+		void *kv;
+		struct page *ppg =
+			pfn_to_page((unsigned long)(leaf_phys >> PAGE_SHIFT));
+		unsigned int jd_words =
+			(PAGE_SIZE - page_off) >> 2;
+
+		if (jd_words > 128)
+			jd_words = 128;
+		kv = kmap(ppg);
+		for (wi = 0; wi < jd_words; wi++)
+			pw[wi] = ((u32 *)((char *)kv + page_off))[wi];
+		for (; wi < 128; wi++)
+			pw[wi] = 0;
+		kunmap(ppg);
+		have_bytes = 1;
+		pr_err("p7580_job: JDBODY slot=%d seq=%u jc=0x%llx words=%u %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x\n",
+		       slot, seq, (unsigned long long)jc, jd_words,
+		       pw[0], pw[1], pw[2], pw[3],
+		       pw[4], pw[5], pw[6], pw[7],
+		       pw[8], pw[9], pw[10], pw[11],
+		       pw[12], pw[13], pw[14], pw[15]);
+		pr_err("p7580_job: JDBODY slot=%d seq=%u jc=0x%llx +64 %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x\n",
+		       slot, seq, (unsigned long long)jc,
+		       pw[16], pw[17], pw[18], pw[19],
+		       pw[20], pw[21], pw[22], pw[23],
+		       pw[24], pw[25], pw[26], pw[27],
+		       pw[28], pw[29], pw[30], pw[31]);
+		pr_err("p7580_job: JDBODY slot=%d seq=%u jc=0x%llx +128 %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x\n",
+		       slot, seq, (unsigned long long)jc,
+		       pw[32], pw[33], pw[34], pw[35],
+		       pw[36], pw[37], pw[38], pw[39],
+		       pw[40], pw[41], pw[42], pw[43],
+		       pw[44], pw[45], pw[46], pw[47]);
+	}
+	if (have_bytes && owner && owner_bo) {
+		pr_err("p7580_job: PTEWALK slot=%d seq=%u jc=0x%llx leaf=0x%llx leaf_phys=0x%llx bo_phys=0x%llx %s snap=0x%llx/0x%zx live=0x%llx/0x%zx iova=0x%lx npages=%u w=%08x %08x %08x %08x %08x %08x %08x %08x sw=%08x %08x %08x %08x %08x %08x %08x %08x\n",
+		       slot, seq, (unsigned long long)jc,
+		       (unsigned long long)leaf_pte,
+		       (unsigned long long)leaf_phys,
+		       (unsigned long long)bo_phys,
+		       (bo_ok && leaf_phys == bo_phys) ? "MATCH" : "MISMATCH",
+		       (unsigned long long)snap_iova, snap_size,
+		       (unsigned long long)live_iova, live_size,
+		       owner_iova, owner_npages,
+		       pw[0], pw[1], pw[2], pw[3],
+		       pw[4], pw[5], pw[6], pw[7],
+		       job->desc[0], job->desc[1], job->desc[2], job->desc[3],
+		       job->desc[4], job->desc[5], job->desc[6], job->desc[7]);
+	} else {
+		pr_err("p7580_job: PTEWALK slot=%d seq=%u jc=0x%llx leaf=0x%llx leaf_phys=0x%llx NO-OWNER snap=0x%llx/0x%zx live=0x%llx/0x%zx w=%08x %08x %08x %08x %08x %08x %08x %08x sw=%08x %08x %08x %08x %08x %08x %08x %08x\n",
+		       slot, seq, (unsigned long long)jc,
+		       (unsigned long long)leaf_pte,
+		       (unsigned long long)leaf_phys,
+		       (unsigned long long)snap_iova, snap_size,
+		       (unsigned long long)live_iova, live_size,
+		       pw[0], pw[1], pw[2], pw[3],
+		       pw[4], pw[5], pw[6], pw[7],
+		       job->desc[0], job->desc[1], job->desc[2], job->desc[3],
+		       job->desc[4], job->desc[5], job->desc[6], job->desc[7]);
+	}
+	if (live_obj)
+		drm_gem_object_unreference_unlocked(live_obj);
+}
+
+static void p7580_drv_timedout_job(struct drm_sched_job *sched_job)
+{
+	struct p7580_submit_job *job = sched_job ? sched_job->owner : NULL;
+	struct p7580_drv_file *df = job ?
+		(struct p7580_drv_file *)job->file_priv : NULL;
+	struct p7580_drv *drv = job ?
+		(struct p7580_drv *)job->drv_priv : NULL;
+	void *f;
+	int pmraw;
+
+	if (!drv && df)
+		drv = df->drv;
+	if (!drv)
+		return;
+	/* Timeout workqueue (process context): the recover path below
+	 * re-touches COMMAND_NEXT/GPU_CMD/INT registers. The live-job
+	 * ref keeps the block powered, but re-get here so a dark block
+	 * (suspend racing the timeout) fails closed instead of hanging
+	 * the bus.
+	 *
+	 * Close guarantee (gpu31-close-fix): the fence ALWAYS signals
+	 * on this path, even when recovery is skipped dark. The sched
+	 * close wait (entity_fini -> wait_idle) terminates only because
+	 * retirement is unconditional: skipping the signal here would
+	 * leave job_count elevated forever and wedge every close behind
+	 * a pending job (the int7 CLOSE watchdog signature). Signalling
+	 * is CPU-only (fence callbacks + completion), never MMIO, so it
+	 * is safe dark. p7580_job_timedout already signals the job's own
+	 * fence on the same terms after recovery; this covers the dark
+	 * early-return so both exits retire. */
+	pmraw = p7580_drv_pm_get(drv);
+	pr_err("p7580_job: TMD-ENTER sched_job=%lu job=%lu drv=%lu pmraw=%d\n",
+	       (unsigned long)sched_job, (unsigned long)job,
+	       (unsigned long)drv, pmraw);
+	if (pmraw < 0) {
+		f = job ? job->done_fence : NULL;
+		if (f && !dma_fence_is_signaled((struct dma_fence *)f))
+			dma_fence_signal((struct dma_fence *)f);
+		return;
+	}
+	/* gpu31-ptewalk: decisive fault-time read. Runs BEFORE recover
+	 * tears state down (p7580_job_timedout -> recover rebinds AS0)
+	 * in the same PM-held window: PT walk vs BO page comparison. */
+	pr_err("p7580_job: TMD-PREWALK job=%lu drv=%lu\n",
+	       (unsigned long)job, (unsigned long)drv);
+	p7580_drv_ptewalk_pin(drv, job);
+	p7580_job_timedout(&drv->jd, job);
+	p7580_drv_pm_put(drv);
+}
+
+static void p7580_drv_free_job(struct drm_sched_job *sched_job)
+{
+	struct p7580_submit_job *job = sched_job ? sched_job->owner : NULL;
+	struct p7580_drv_file *df = job ?
+		(struct p7580_drv_file *)job->file_priv : NULL;
+	struct p7580_drv *drv = job ?
+		(struct p7580_drv *)job->drv_priv : NULL;
+	uint32_t i;
+
+	if (!drv && df)
+		drv = df->drv;
+	/* F-JT2 + gpu31-coherency: completion-side DMA sync. free_job
+	 * runs on finish_work strictly after the fence signal (0004:
+	 * cancel timeout, put fence, THEN free_job), so every
+	 * referenced BO is post-GPU-write here. Walk the job's owned
+	 * BO pointers (referenced at SUBMIT, stored on job->bos) and
+	 * retire each via p7580_gem_job_done_sync
+	 * (dma_sync_single_for_cpu per bound SHMEM page; CMA/imported
+	 * and never-bound BOs no-op inside), then drop the job's refs.
+	 * No MMIO, never sleeps, no locks: safe beside the PM release
+	 * below. */
+	if (job && job->bo_count && job->bos) {
+		for (i = 0; i < job->bo_count; i++) {
+			struct drm_gem_object *obj =
+				(struct drm_gem_object *)job->bos[i];
+
+			if (!obj)
+				continue;
+			p7580_gem_job_done_sync(obj);
+			drm_gem_object_unreference_unlocked(obj);
+			job->bos[i] = NULL;
+		}
+	}
+	/* ST-RETIRE: finish_work reached free_job (fence already
+	 * signalled by the 0004 retire path); proves the full
+	 * queue -> dispatch -> retire chain completed. Numeric (%lu)
+	 * so kptr_restrict cannot censor it. ran=N is the run_job
+	 * entry count stamped on the job (order provable even if the
+	 * ST-RUN print was lost); sslot= is the carried sched slot. */
+	if (p7580_sched_trace) {
+		p7580_sched_trace--;
+		pr_info("p7580_sched: retire seq=%u slot=%d sslot=%d ran=%u owner=%lu\n",
+			job ? job->seqno : 0, job ? job->slot : -1,
+			sched_job ? sched_job->slot : -1,
+			job ? job->run_seq : 0, (unsigned long)job);
+	}
+	p7580_job_free(job);
+	/* Balances p7580_drv_job_pm_arm() at queue time: the async
+	 * leg is over (retired or run_job dispatch failure), drop
+	 * the job-lifetime power hold so the block can idle-suspend.
+	 * Completion-IRQ safety: the IRQ handler only reads STAT +
+	 * CLEARs + signals the fence (finish path) — it runs strictly
+	 * before fence signal, and free_job runs strictly after
+	 * (finish_work: cancel timeout, put fence, THEN free_job), so
+	 * no IRQ demux MMIO can run after this put suspends the block.
+	 * Timeout/recover MMIO likewise precedes free_job (timeout
+	 * work calls timedout_job, then the fence signals, then
+	 * finish_work calls free_job). df->drv is stable here:
+	 * file_fini (entity teardown) waits for queued jobs via the
+	 * 0004 fini/flush path before the file state (and its drv
+	 * back-pointer) is freed. */
+	if (drv)
+		p7580_drv_job_pm_release(drv);
+}
+
+/* Arm-time fence allocator (0004 alloc_fence hook): one fence per
+ * SUBMIT, allocated before queueing so out_sync is live at ioctl
+ * return. Context: per-slot ordered timeline; seqno: per-slot emit
+ * counter shared with the jobs slice. dma_fence_init + NOT signaled
+ * (completion comes from the JOB_INT IRQ or the timeout path). */
+static struct dma_fence *p7580_drv_alloc_fence(struct drm_sched_job *sched_job)
+{
+	struct p7580_submit_job *job = sched_job ? sched_job->owner : NULL;
+	struct p7580_drv *drv;
+
+	if (!sched_job || !job)
+		return NULL;
+	if (job->slot < 0 || job->slot >= P7580_NUM_JOB_SLOTS)
+		return NULL;
+	/* Dispatch context was stamped at SUBMIT (file_priv/drv_priv);
+	 * same pattern as run_job/timedout_job/free_job. */
+	drv = (struct p7580_drv *)job->drv_priv;
+	if (!drv)
+		return NULL;
+	return p7580_job_alloc_fence(&drv->jd, job->slot,
+				     &drv->jd.emit_seqno[job->slot]);
+}
+
+static const struct drm_sched_backend_ops p7580_drv_sched_ops = {
+	.run_job = p7580_drv_run_job,
+	.alloc_fence = p7580_drv_alloc_fence,
+	.timedout_job = p7580_drv_timedout_job,
+	.free_job = p7580_drv_free_job,
+};
+
+/* Probenumeric: strong run_job address for the shim ST-OPS cross-check.
+ * The 0004 TU declares p7580_drv_run_job_addr() (weak default -> NULL);
+ * this strong definition wins the link and returns our run_job, so
+ * silicon compares ST-OPS run= against runexp= with no symbol lookup. */
+drm_sched_run_fn p7580_drv_run_job_addr(void)
+{
+	return p7580_drv_run_job;
+}
+
+/* Opsfix: the 0004 shim header is the single authoritative struct
+ * definition (both TUs include <drm_sched.h> via -Idrivers/gpu/drm).
+ * Silicon ST-OPS showed ops=NULL despite a correct store + correct call
+ * site; if either TU ever drifts, the build breaks here instead of
+ * retiring the job silently. Values (arm64 3.10): ops=24 slot=232 ran=236
+ * (see docs/reports/gpu31-opsfix). File-scope pin: a noinline probe
+ * the linker keeps, so /proc/kallsyms + ST-OPS dmesg can be compared
+ * against these exact numbers. */
+static void __maybe_unused p7580_drv_sched_layout_pin(void)
+{
+	BUILD_BUG_ON(offsetof(struct drm_sched_job, ops) != 24);
+	BUILD_BUG_ON(offsetof(struct drm_sched_job, slot) != 232);
+	BUILD_BUG_ON(offsetof(struct drm_sched_job, ran) != 236);
+}
+
+/* Power guard (F-SUB1). Every MMIO site in this file runs under a
+ * p7580_drv_pm_get/put pair; the get fails closed (caller must touch
+ * no register afterwards). pm_runtime_get_sync may return 1 (already
+ * active) or 0 (resumed now): both mean powered, and this helper
+ * normalises both to 0. Only a negative errno means dark, and only
+ * then does the caller take the dark path (all callers test
+ * `< 0`, never truthiness, so 1 can never take the dark early-return).
+ * Returns 0 powered, negative errno dark. */
+int p7580_drv_pm_get(struct p7580_drv *drv)
+{
+	int ret;
+
+	if (!drv || !drv->dev)
+		return -ENODEV;
+	ret = pm_runtime_get_sync(drv->dev);
+	if (ret < 0) {
+		/* Resume failed (clock/reset/cores): the GPU is dark;
+		 * programming HEAD/START now would wedge the slot with
+		 * no IRQ ever coming (unbounded fence wait). put_noidle
+		 * balances the failed get without re-entering resume. */
+		pm_runtime_put_noidle(drv->dev);
+		return ret;
+	}
+	/* Normalise pm_runtime_get_sync's 1 (already active) to 0:
+	 * 0 and 1 both mean powered. */
+	return 0;
+}
+
+void p7580_drv_pm_put(struct p7580_drv *drv)
+{
+	if (!drv || !drv->dev)
+		return;
+	pm_runtime_mark_last_busy(drv->dev);
+	pm_runtime_put_autosuspend(drv->dev);
+}
+/* Live-job ref: armed at queue time, released in free_job. Paired
+ * get/put around the whole async job lifetime (queue -> run ->
+ * retire, including the timeout/recover path which re-touches
+ * COMMAND_NEXT/RESET registers). atomic_t pm_ref counts them so a
+ * leaked (never-freed) job is visible in sysfs/debug rather than
+ * silently pinning the power domain on. */
+static void p7580_drv_job_pm_arm(struct p7580_drv *drv)
+{
+	atomic_inc(&drv->pm_ref);
+	/* Second get: first is the ioctl's synchronous leg. */
+	(void)p7580_drv_pm_get(drv);
+}
+
+static void p7580_drv_job_pm_release(struct p7580_drv *drv)
+{
+	atomic_dec(&drv->pm_ref);
+	p7580_drv_pm_put(drv);
+}
+
+/* Teardown hold (F-SUB1 teardown leg): one PM ref across a whole
+ * unmap/invalidate/mask walk so the AS block cannot suspend mid-walk.
+ * Returns 1 if power is held (MMIO allowed), 0 if the block is dark
+ * (caller must skip MMIO but still free CPU-side table/memory). Puts
+ * are balanced 1:1 via teardown_release; never balances another
+ * leg's ref. */
+/* gpu31-iova: register the map/unmap trace budget with the jobs
+ * slice so the iova_arm debugfs knob (jobs debugfs_init) re-arms it.
+ * Called once at probe; NULL at remove releases it. */
+void p7580_drv_register_iova_trace(unsigned int *budget)
+{
+	p7580_job_register_iova_budget(budget);
+}
+
+int p7580_drv_teardown_hold(struct p7580_drv *drv)
+{
+	return p7580_drv_pm_get(drv) == 0;
+}
+
+void p7580_drv_teardown_release(struct p7580_drv *drv)
+{
+	p7580_drv_pm_put(drv);
+}
+
+/* Unmap one BO's IOVA range. Table writes (p7580_mmu_unmap) are
+ * CPU-side dma_sync + kmap and safe while dark; only the TLB
+ * invalidate is MMIO. When invalidate == 0 (dark block) the caller
+ * skips the TLB flush: stale entries die with the context teardown
+ * (AS unbound + root freed at remove; idle suspend preserves no GPU
+ * state that a later resume could misread because resume always
+ * re-programs TRANSTAB + invalidates before the next job). */
+int p7580_drv_unmap_bo(struct p7580_drv *drv, struct drm_gem_object *obj,
+		       int invalidate)
+{
+	struct p7580_bo *bo = to_p7580_bo(obj);
+	unsigned int npages = p7580_bo_npages(obj);
+	unsigned int i;
+
+	for (i = 0; i < npages; i++)
+		p7580_mmu_unmap(&drv->mmu, bo->iova +
+				((u64)i << PAGE_SHIFT));
+	if (invalidate)
+		p7580_mmu_invalidate(drv->regs, P7580_DRV_AS_NR,
+				     bo->iova >> PAGE_SHIFT, npages, 1);
+	/* gpu31-coherency: tear down the bind-time DMA mapping now the
+	 * PTEs no longer reference the pages. CPU-side only, safe dark. */
+	p7580_gem_dma_unbind(obj);
+	return 0;
+}
+
+/* gpu31-iova: free-time GPU unmap (called from GEM free BEFORE the
+ * IOVA range is recycled). Clears the BO's leaf PTEs, flushes the TLB
+ * for the exact range under a PM-held window, unlinks the bo_list
+ * entry (dropping its ref), then tears down the DMA mapping. Order:
+ * leaves + TLB flush happen while the IOVA node is still linked, so
+ * the range is unmapped everywhere before iova_free reuses it.
+ * Never-bound BOs (no bo_list entry) no-op after the DMA unbind.
+ * Dark block: leaves still cleared + list/DMA torn down CPU-side;
+ * the TLB flush is skipped and re-covered by resume (TRANSTAB +
+ * invalidate before the next job). Runs under dev->struct_mutex from
+ * gem_free_object: takes bo_lock (leaf; same order as map_bo) and at
+ * most one PM get/put; never sleeps beyond those. */
+void p7580_gem_gpu_unmap(struct drm_gem_object *obj)
+{
+	struct drm_device *ddev;
+	struct p7580_drv *drv;
+	struct p7580_bo *bo;
+	unsigned long iova = 0;
+	unsigned int npages = 0;
+	int found = 0;
+	int pm_held = 0;
+
+	if (!obj)
+		return;
+	bo = to_p7580_bo(obj);
+	ddev = obj->dev;
+	if (!ddev)
+		goto out_dma;
+	drv = ddev->dev_private ? ddev->dev_private : NULL;
+	if (!drv)
+		goto out_dma;
+	/* Snapshot the range under bo_lock; unlink the entry now so a
+	 * concurrent submit re-mapping the same object re-adds cleanly
+	 * (map_bo re-checks under the same lock). */
+	mutex_lock(&drv->bo_lock);
+	{
+		struct p7580_drv_bo *e, *tmp;
+
+		list_for_each_entry_safe(e, tmp, &drv->bo_list, node) {
+			if (e->obj != obj)
+				continue;
+			iova = (unsigned long)bo->iova;
+			npages = p7580_bo_npages(obj);
+			list_del(&e->node);
+			mutex_unlock(&drv->bo_lock);
+			drm_gem_object_unreference(e->obj);
+			kfree(e);
+			found = 1;
+			goto out_unmap;
+		}
+	}
+	mutex_unlock(&drv->bo_lock);
+out_dma:
+	/* Never bound (or driver gone): only the DMA mapping can exist. */
+	p7580_gem_dma_unbind(obj);
+	return;
+out_unmap:
+	if (!found || !npages)
+		goto out_dma;
+	/* Leaf-clear is CPU-side (dma_sync + kmap) and PM-safe. */
+	{
+		unsigned int i;
+
+		for (i = 0; i < npages; i++)
+			p7580_mmu_unmap(&drv->mmu, iova +
+					((u64)i << PAGE_SHIFT));
+	}
+	/* TLB invalidate needs the AS block powered; hold one PM ref
+	 * for the window (fail-closed dark: resume re-programs +
+	 * invalidates before the next job, same contract as the
+	 * remove-walk dark leg). wmb() before the invalidate is inside
+	 * p7580_mmu_invalidate (LOCKADDR latch barrier, F-MMU2). */
+	pm_held = p7580_drv_teardown_hold(drv);
+	if (pm_held)
+		p7580_mmu_invalidate(drv->regs, P7580_DRV_AS_NR,
+				     iova >> PAGE_SHIFT, npages, 1);
+	if (pm_held)
+		p7580_drv_teardown_release(drv);
+	p7580_gem_dma_unbind(obj);
+	/* gpu31-iova trace: one line per free-time unmap (never-bound
+	 * BOs return via out_dma and print nothing). */
+	if (p7580_iova_trace) {
+		p7580_iova_trace--;
+		pr_info("p7580_iova: unmap obj=%lu iova=0x%lx npages=%u dark=%d\n",
+			(unsigned long)obj, iova, npages, !pm_held);
+	}
+}
+
+
+
+int p7580_drv_sched_ensure(void)
+{
+	int ret = 0;
+
+	mutex_lock(&p7580_drv_sched_lock);
+	if (!p7580_drv_sched_live) {
+		ret = drm_sched_init(&p7580_drv_sched,
+				     &p7580_drv_sched_ops,
+				     msecs_to_jiffies(P7580_JOB_TIMEOUT_MS),
+				     "panfrost7580");
+		if (!ret)
+			p7580_drv_sched_live = 1;
+	}
+	mutex_unlock(&p7580_drv_sched_lock);
+	return ret;
+}
+
+/* Per-file entities on the shared scheduler workqueue. */
+int p7580_drv_file_init(struct p7580_drv_file *df, struct p7580_drv *drv)
+{
+	int i, ret;
+
+	if (!df || !drv)
+		return -EINVAL;
+	/* R1: the shared sched workqueue does not exist until the first
+	 * ensure. drm_sched_entity_init takes sched->lock, so running it
+	 * against a never-initialised (zeroed) sched wedges the opener.
+	 * Ensure here so open stays O(1) with no waits on the fast path
+	 * (ensure only inits once; later opens hit the live flag). */
+	ret = p7580_drv_sched_ensure();
+	if (ret)
+		return ret;
+	df->drv = drv;
+	df->next_seqno = 0;
+	df->entities_live = 0;
+	drm_syncobj_manager_init(&df->mgr);
+	df->job_fctx = NULL;
+	df->job_dev = &drv->jd;
+	for (i = 0; i < P7580_NUM_JOB_SLOTS; i++) {
+		ret = drm_sched_entity_init(&df->entity[i],
+					    &p7580_drv_sched);
+		if (ret) {
+			while (--i >= 0)
+				drm_sched_entity_fini(&p7580_drv_sched,
+						      &df->entity[i]);
+			drm_syncobj_manager_fini(&df->mgr);
+			return ret;
+		}
+	}
+	df->entities_live = 1;
+	return 0;
+}
+
+void p7580_drv_file_fini(struct p7580_drv_file *df)
+{
+	struct p7580_drv *drv;
+	int pm_held = 0;
+	int i;
+
+	if (!df)
+		return;
+	drv = df->drv;
+	/* Teardown can run while runtime-suspended (close after idle):
+	 * entity fini retires queued jobs whose free_job drops the
+	 * live-job PM ref, and the 0004 fini/flush path runs the
+	 * retirement workqueue. Hold one PM ref across the walk so a
+	 * concurrent run_job/timeout worker (still covered by its own
+	 * re-get) and the fini flush both see a powered block. The
+	 * free_job puts below are per-job refs, NOT this hold: this
+	 * hold is released once, after the last entity is torn down.
+	 * On get failure the block is already dark: MMIO inside fini
+	 * (there is none directly) is skipped by the workers'
+	 * fail-closed arms, and the CPU-side list flush below still
+	 * runs so no job/fence leaks. */
+	/* Bounded close (gpu31-close-fix): the hold below is a single
+	 * pm_runtime_get_sync. Its only unbounded phase is waiting out a
+	 * concurrent suspend/resume transition, which is itself bounded
+	 * (runtime_suspend/resume callbacks poll READY with 100 us steps
+	 * and 100 ms caps; no step sleeps unbounded). The entity loop
+	 * then cancels queued jobs synchronously and waits BOUNDED for
+	 * dispatched jobs (0004 wait_idle: one timeout + 8 s margin),
+	 * whose retirement is unconditional (timedout_job always signals
+	 * the fence, even dark). Syncobj fini last: it drops manager refs
+	 * without waiting on any fence, so no waiter can be wedged by
+	 * teardown order. Double fini is safe (entities_live guards the
+	 * loop, manager drain of an empty idr is a no-op). */
+	if (drv && p7580_drv_teardown_hold(drv))
+		pm_held = 1;
+	if (df->entities_live) {
+		for (i = 0; i < P7580_NUM_JOB_SLOTS; i++)
+			drm_sched_entity_fini(&p7580_drv_sched,
+					      &df->entity[i]);
+		df->entities_live = 0;
+	}
+	drm_syncobj_manager_fini(&df->mgr);
+	if (pm_held)
+		p7580_drv_teardown_release(drv);
+	df->drv = NULL;
+	df->job_dev = NULL;
+}
+
+/* gpu31-iova: IRQ-safe fault-time mapping resolver (registered on
+ * struct p7580_job_dev at probe). Renders the faulting job's SUBMIT-
+ * time {handle,iova,size} snapshot as "h<H>=0x<IOVA>/0x<SZ> ..." into
+ * buf (or counts when buf is NULL, snprintf-style). IRQ context: only
+ * the snapshot arrays + snprintf, no GEM dereference, no locks, no
+ * MMIO. Truncates at the buffer end (always NUL-terminated); returns
+ * the full untruncated length so the caller can size its buffer. */
+int p7580_drv_iova_resolve(void *priv, char *buf, size_t len,
+				  const uint32_t *handles,
+				  const uint64_t *addrs,
+				  const uint32_t *sizes, uint32_t n)
+{
+	(void)priv;
+	if (!handles || !addrs || !sizes || !n)
+		return 0;
+	{
+		size_t off = 0;
+		uint32_t i;
+		int w;
+
+		for (i = 0; i < n; i++) {
+			if (!buf || off >= len)
+				w = snprintf(NULL, 0, "%s%u=0x%llx/0x%x",
+					       i ? " " : "h",
+					       handles[i],
+					       (unsigned long long)addrs[i],
+					       sizes[i]);
+			else
+				w = snprintf(buf + off, len - off,
+					     "%s%u=0x%llx/0x%x",
+					     i ? " " : "h",
+					     handles[i],
+					     (unsigned long long)addrs[i],
+					     sizes[i]);
+			if (w < 0)
+				return (int)off;
+			off += (size_t)w;
+			if (buf && off >= len) {
+				buf[len - 1] = '\0';
+				break;
+			}
+		}
+		return (int)off;
+	}
+}
+
+/* Map one BO's pages into AS 0 if not yet bound; track on bo_list.
+ * Caller (p7580_drv_submit) holds a runtime-PM ref: the invalidate()
+ * below is MMIO on the AS block and MUST NOT run while the power
+ * domain/clocks are dark (F-SUB1 bus-hang). */
+static int p7580_drv_map_bo(struct p7580_drv *drv, struct drm_gem_object *obj)
+{
+	struct p7580_bo *bo = to_p7580_bo(obj);
+	unsigned int npages = p7580_bo_npages(obj);
+	unsigned int i;
+
+	mutex_lock(&drv->bo_lock);
+	{
+		struct p7580_drv_bo *e;
+
+		list_for_each_entry(e, &drv->bo_list, node) {
+			if (e->obj == obj) {
+				mutex_unlock(&drv->bo_lock);
+				return 0;
+			}
+			/* gpu31-iova: live-overlap detector. Two distinct
+			 * live BOs must never cover the same IOVA: that
+			 * means an IOVA was recycled while still mapped
+			 * (the stale-TLB signature). Always-on WARN. */
+			if (bo->iova < e->iova + e->size &&
+			    e->iova < bo->iova + bo->base.size)
+				pr_warn("p7580_iova: OVERLAP obj=%lu iova=0x%llx size=0x%zx vs obj=%lu iova=0x%llx size=0x%zx\n",
+					(unsigned long)obj,
+					(unsigned long long)bo->iova,
+					bo->base.size,
+					(unsigned long)e->obj,
+					(unsigned long long)e->iova,
+					e->size);
+		}
+	}
+	mutex_unlock(&drv->bo_lock);
+
+	/* gpu31-coherency: bind-time dma_map before the AS0 walk so PTEs
+	 * carry bus addresses (p7580_bo_page_phys routes SHMEM through
+	 * the dma_addrs cache) and completion sync has a mapping. */
+	{
+		int bret = p7580_gem_dma_bind(obj, drv->dev);
+
+		if (bret)
+			return bret;
+	}
+
+	/* gpu31-iova: IOVA-reuse fence. A recycled range can only reach
+	 * here after p7580_gem_gpu_unmap cleared its leaves on free;
+	 * still, invalidate the range BEFORE writing new leaves so any
+	 * TLB entry surviving a dark free (flush skipped, resume pending)
+	 * or a racing PTW is purged first. Barrier order: invalidate
+	 * (purge old) -> map (write new) -> invalidate (publish new),
+	 * matching the kbase LOCK/FLUSH/UPDATE discipline. */
+	p7580_mmu_invalidate(drv->regs, P7580_DRV_AS_NR,
+			     bo->iova >> PAGE_SHIFT, npages, 1);
+	for (i = 0; i < npages; i++) {
+		int ok = 0;
+		phys_addr_t phys = p7580_bo_page_phys(obj, i, &ok);
+		int ret;
+
+		if (!ok)
+			return -EFAULT;
+		ret = p7580_mmu_map(&drv->mmu, bo->iova +
+				    ((u64)i << PAGE_SHIFT),
+				    phys, P7580_PROT_RD | P7580_PROT_WR,
+				    P7580_MEMATTR_IDX_DEFAULT);
+		if (ret)
+			return ret;
+	}
+	p7580_mmu_invalidate(drv->regs, P7580_DRV_AS_NR,
+			     bo->iova >> PAGE_SHIFT, npages, 0);
+
+	{
+		struct p7580_drv_bo *e = kzalloc(sizeof(*e), GFP_KERNEL);
+
+		if (!e)
+			return -ENOMEM;
+		mutex_lock(&drv->bo_lock);
+		drm_gem_object_reference(obj);
+		e->obj = obj;
+		e->iova = bo->iova;
+		e->size = bo->base.size;
+		list_add_tail(&e->node, &drv->bo_list);
+		mutex_unlock(&drv->bo_lock);
+	}
+	/* gpu31-iova trace: one line per fresh map (already-bound BOs
+	 * return early above and print nothing). Own budget so the
+	 * 8-line job budget is never starved. */
+	if (p7580_iova_trace) {
+		p7580_iova_trace--;
+		pr_info("p7580_iova: map obj=%lu iova=0x%llx size=0x%zx npages=%u\n",
+			(unsigned long)obj, (unsigned long long)bo->iova,
+			bo->base.size, npages);
+	}
+	return 0;
+}
+
+int p7580_drv_submit(struct p7580_drv *drv, struct drm_device *dev,
+		     struct drm_file *file_priv,
+		     const struct p7580_submit *args)
+{
+	struct p7580_drv_file *df = file_priv->driver_priv;
+	struct drm_gem_object *objs[P7580_MAX_SUBMIT_BOS];
+	uint32_t hsave[P7580_MAX_SUBMIT_BOS];
+	struct dma_fence *inf[P7580_MAX_IN_SYNCS];
+	struct p7580_submit_job *job;
+	struct drm_sched_entity *entity;
+	struct drm_sched_job *sched_job;
+	unsigned int i, nr = 0, nf = 0;
+	int slot, ret;
+
+	if (!drv || !dev || !file_priv || !args || !df)
+		return (int)p7580_submit_err("validate", -EINVAL);
+	if (!p7580_jc_valid(args->jc))
+		return (int)p7580_submit_err("validate", -EINVAL);
+	if (args->requirements & ~(P7580_JD_REQ_FS |
+				   P7580_JD_REQ_ONLY_COMPUTE))
+		return (int)p7580_submit_err("validate", -EINVAL);
+	if (args->in_sync_count > P7580_MAX_IN_SYNCS ||
+	    args->bo_handle_count > P7580_MAX_SUBMIT_BOS)
+		return (int)p7580_submit_err("validate", -EINVAL);
+
+	/* ST-IOCTL: ioctl reached the driver with a valid envelope. */
+	if (p7580_sched_trace) {
+		p7580_sched_trace--;
+		pr_info("p7580_sched: ioctl jc=0x%llx req=0x%x bo=%u in=%u out=%u\n",
+			(unsigned long long)args->jc, args->requirements,
+			args->bo_handle_count, args->in_sync_count,
+			args->out_sync);
+	}
+
+	slot = p7580_job_slot(args->requirements);
+	if (slot < 0 || slot >= P7580_NUM_JOB_SLOTS)
+		return (int)p7580_submit_err("validate", -EINVAL);
+	if (!(drv->jd.js_present & (1u << slot)))
+		return (int)p7580_submit_err("validate", -ENODEV);
+
+	ret = p7580_drv_sched_ensure();
+	if (ret)
+		return ret;
+	entity = &df->entity[slot];
+
+	/* 1. in-fences (referenced; put on every exit path). */
+	if (args->in_sync_count) {
+		const uint32_t *hs =
+			(const uint32_t *)(uintptr_t)args->in_syncs;
+
+		for (i = 0; i < args->in_sync_count; i++) {
+			struct drm_syncobj *s =
+				drm_syncobj_find(&df->mgr, hs[i]);
+			struct dma_fence *f;
+
+			if (!s) {
+ret = (int)p7580_submit_err("in_sync", -ENOENT);
+				goto err_inf;
+			}
+			f = drm_syncobj_find_fence(s);
+			drm_syncobj_put(s);
+			if (!f) {
+				/* Empty syncobj: already signaled (0003). */
+				continue;
+			}
+			inf[nf++] = f;
+		}
+	}
+
+	/* 2. BO lookup + map into AS 0 (referenced; unref on exit). */
+	if (args->bo_handle_count) {
+		const uint32_t *uh =
+			(const uint32_t *)(uintptr_t)args->bo_handles;
+
+		for (i = 0; i < args->bo_handle_count; i++) {
+			struct drm_gem_object *obj =
+				drm_gem_object_lookup(dev, file_priv,
+						      uh[i]);
+
+			if (!obj) {
+ret = (int)p7580_submit_err("bo", -ENOENT);
+				goto err_objs;
+			}
+			objs[nr++] = obj;
+			hsave[nr - 1] = uh[i];
+			ret = p7580_drv_map_bo(drv, obj);
+			if (ret)
+				goto err_objs;
+			/* gpu31-coherency: CPU fills descriptors/payloads
+			 * before SUBMIT (ioctl copy / mmap writes); drain
+			 * those lines to the point the GPU reads now that
+			 * the BO is bound. Before the job is queued. */
+			p7580_gem_submit_sync(obj);
+		}
+	}
+
+	/* 3. job + sched dispatch. */
+	job = kzalloc(sizeof(*job), GFP_KERNEL);
+	if (!job) {
+ret = (int)p7580_submit_err("job", -ENOMEM);
+		goto err_objs;
+	}
+	job->seqno = df->next_seqno++;
+	job->slot = slot;
+	/* Probenumeric: stamp the dispatch context on the job so the async
+	 * workers never re-derive it from the entity pointer (int14: df
+	 * came back wrong -> ENODEV before ST-RUN). Entity math survives
+	 * in run_job only as a range-checked fallback. */
+	job->file_priv = df;
+	job->drv_priv = drv;
+	job->run_seq = 0;
+	job->jc = args->jc;
+	job->requirements = args->requirements;
+	job->as_nr = P7580_DRV_AS_NR;
+	job->affinity = drv->jd.shader_present;
+	/* SUBMIT-time descriptor snapshot (gpu31-lastjob, extended
+	 * gpu31-submitsnap, corrected gpu31-jddecode): the 8 words at
+	 * jc, read from the mapped BO before submit-sync. Owner lookup
+	 * uses the live drv->bo_list (same scan the fault-time PTEWALK
+	 * pin uses) instead of the submit-local objs[]/iova_valid view:
+	 * the PTEWALK live scan demonstrably hits (live= range) on
+	 * jobs whose objs[]-based snapshot missed (snap=0x0/0x0), so
+	 * the snapshot now resolves the same way the fault path does.
+	 * Variant B (chain_mode==2) clears descriptor bit0 in the
+	 * snapshot consumed at dispatch; the stored BO bytes are
+	 * patched too (via vmap + submit-sync re-drain), next pointer
+	 * stays NULL. Mode 0/1 snapshot only. Stays zero when the
+	 * snapshot is unavailable (cross-page jc, unmapped page, jc
+	 * outside every bound BO, or BO pages unavailable). */
+	{
+		struct p7580_bo *jbo = NULL;
+		struct drm_gem_object *jobj = NULL;
+		mutex_lock(&drv->bo_lock);
+		{
+			struct p7580_drv_bo *le;
+
+			list_for_each_entry(le, &drv->bo_list, node) {
+				if (args->jc >= le->iova &&
+				    args->jc + 32 <= le->iova + le->size) {
+					drm_gem_object_reference(le->obj);
+					jobj = le->obj;
+					break;
+				}
+			}
+		}
+		mutex_unlock(&drv->bo_lock);
+		if (jobj)
+			jbo = to_p7580_bo(jobj);
+		if (jbo && jbo->pages) {
+			uint32_t off = (uint32_t)(args->jc - jbo->iova);
+			unsigned int idx = off >> PAGE_SHIFT;
+			unsigned int poff = off & (PAGE_SIZE - 1);
+			if (idx < jbo->nr_pages && jbo->pages[idx] &&
+			    poff + 32 <= PAGE_SIZE) {
+				void *kv;
+				unsigned int wi;
+				/* Same invalidate the completion path
+				 * runs, so the snapshot sees CPU bytes. */
+				p7580_gem_job_done_sync(&jbo->base);
+				kv = kmap_atomic(jbo->pages[idx]);
+				for (wi = 0; wi < 8; wi++)
+					job->desc[wi] =
+						*(uint32_t *)((char *)kv +
+							poff + wi * 4);
+				if (drv->jd.chain_mode == 2) {
+					job->desc[4] &= ~0x1u;
+					*(uint32_t *)((char *)kv + poff + 16) =
+						job->desc[4];
+				}
+				kunmap_atomic(kv);
+				if (drv->jd.chain_mode == 2)
+					p7580_gem_submit_sync(&jbo->base);
+			}
+		}
+		if (jobj)
+			drm_gem_object_unreference_unlocked(jobj);
+	}
+	/* F-JT1 stash: SUBMIT-time sched_job->fence is still NULL, so
+	 * validate the handle now (-ENOENT preserved) and let the
+	 * async run_job install the real fence on this handle. */
+	if (args->out_sync) {
+		struct drm_syncobj *vs =
+			drm_syncobj_find(&df->mgr, args->out_sync);
+
+		if (!vs) {
+			p7580_job_free(job);
+ret = (int)p7580_submit_err("out_sync", -ENOENT);
+			goto err_objs;
+		}
+		drm_syncobj_put(vs);
+		job->out_sync = args->out_sync;
+	}
+	/* F-JT2 own: transfer one lookup ref per BO onto the job so
+	 * free_job can retire HIGHMEM SHMEM pages without a
+	 * file/handle lookup (stable across close; no locks).
+	 * gpu31-jddecode: stamp bo_count here — every consumer of
+	 * bos[] (submit snapshot owner check, PTEWALK snapshot scan,
+	 * pre-signal sync, excl publish, free_job unref) keys off
+	 * bo_count, and without this stamp all of them silently
+	 * no-op (sw stayed zero, excl never published). */
+	if (nr) {
+		job->bos = kcalloc(nr, sizeof(*job->bos), GFP_KERNEL);
+		if (!job->bos) {
+			p7580_job_free(job);
+ret = (int)p7580_submit_err("job", -ENOMEM);
+			goto err_objs;
+		}
+		for (i = 0; i < nr; i++)
+			job->bos[i] = objs[i];
+		job->bo_count = nr;
+	}
+	/* gpu31-iova: BO identity snapshot for the ERR-pin mapping dump.
+	 * Stamped at SUBMIT while the job owns refs (stable handles +
+	 * IOVA/size); the ERR pin renders it via the resolver hook (no
+	 * GEM dereference in IRQ context). Freed in p7580_job_free. */
+	if (nr) {
+		job->iova_handles = kcalloc(nr, sizeof(*job->iova_handles),
+					    GFP_KERNEL);
+		job->iova_addrs = kcalloc(nr, sizeof(*job->iova_addrs),
+					  GFP_KERNEL);
+		job->iova_sizes = kcalloc(nr, sizeof(*job->iova_sizes),
+					  GFP_KERNEL);
+		if (!job->iova_handles || !job->iova_addrs ||
+		    !job->iova_sizes) {
+			p7580_job_free(job);
+ret = (int)p7580_submit_err("job", -ENOMEM);
+			goto err_objs;
+		}
+		for (i = 0; i < nr; i++) {
+			struct p7580_bo *sbo = to_p7580_bo(objs[i]);
+
+			job->iova_handles[i] = hsave[i];
+			job->iova_addrs[i] = sbo->iova;
+			job->iova_sizes[i] = (uint32_t)sbo->base.size;
+		}
+		job->iova_bo_count = nr;
+	}
+
+	sched_job = drm_sched_job_alloc(entity, &p7580_drv_sched_ops, job);
+	if (!sched_job) {
+		p7580_job_free(job);
+ret = (int)p7580_submit_err("job", -ENOMEM);
+		goto err_objs;
+	}
+
+/* Opsfix call-site guard: the int13 silicon trace showed ST-OPS
+ * ops=0/run=0 despite this exact call passing
+ * &p7580_drv_sched_ops. A NULL entity or a store that does not
+ * round-trip means a stale .o / duplicate shim copy won the link,
+ * never a real NULL-ops job: fail the ioctl, do not queue. */
+BUILD_BUG_ON(offsetof(struct drm_sched_job, ops) != 24);
+if (!entity || sched_job->entity != entity ||
+    sched_job->ops != &p7580_drv_sched_ops || !sched_job->ops->run_job ||
+    !sched_job->ops->alloc_fence) {
+		drm_sched_job_cleanup(sched_job);
+		p7580_job_free(job);
+		kfree(sched_job);
+ret = (int)p7580_submit_err("ops", -EFAULT);
+		goto err_objs;
+	}
+	/* Pumpfix: carry the SUBMIT-chosen slot on the sched job so the
+	 * async run_job never re-derives it from the entity pointer
+	 * (container layouts shift the index; int12 derived 0 for a
+	 * slot-1 submit and bailed before ST-RUN). */
+	sched_job->slot = slot;
+	/* Arm-time fence (gpu31-armfence): allocate job->fence BEFORE
+	 * queueing so the out_sync install below hands Mesa a live
+	 * fence. Fails closed: NULL fence keeps the old run_job-time
+	 * NULL-install shape (job still runs; waiters see no fence). */
+	drm_sched_job_arm(sched_job);
+
+	for (i = 0; i < nf; i++) {
+		if (!dma_fence_is_signaled(inf[i])) {
+			ret = drm_sched_job_add_dependency(sched_job,
+							   inf[i]);
+			if (ret) {
+				ret = (int)p7580_submit_err("dep", ret);
+				drm_sched_job_cleanup(sched_job);
+				kfree(sched_job);
+				goto err_job_bos;
+			}
+		}
+	}
+	/* Implicit BO excl fences as deps (unsignaled only). */
+	for (i = 0; i < nr; i++) {
+		struct p7580_bo *bo = to_p7580_bo(objs[i]);
+		struct dma_fence *f;
+
+		/* 0002 get_excl locks resv->lock internally: never take it here
+		 * (plain non-recursive mutex self-deadlocks the submitter in D
+		 * state; SUBMIT-DEADLOCK FIX). */
+		f = dma_resv_get_excl(&bo->resv);
+		if (f) {
+			if (!dma_fence_is_signaled(f))
+				ret = drm_sched_job_add_dependency(sched_job,
+								   f);
+			dma_fence_put(f);
+			if (ret) {
+				ret = (int)p7580_submit_err("dep", ret);
+				drm_sched_job_cleanup(sched_job);
+				kfree(sched_job);
+				goto err_job_bos;
+			}
+		}
+	}
+
+	/* Arm the job-lifetime power hold BEFORE the job is visible
+	 * to the async worker: from drm_sched_job_submit on, run_job
+	 * may touch HEAD/START at any moment. The ioctl's synchronous
+	 * ref (held by our caller) covers the map + queue legs; this
+	 * second ref covers queue -> retire. Queue failure below never
+	 * publishes the job, so unwind the arm there. */
+	p7580_drv_job_pm_arm(drv);
+	ret = drm_sched_job_submit(sched_job);
+	/* ST-QUEUE: 0004 accepted (0) or refused (ret) the job. */
+	if (p7580_sched_trace) {
+		p7580_sched_trace--;
+		pr_info("p7580_sched: queued seq=%u slot=%d submit_rc=%d\n",
+			job->seqno, slot, ret);
+	}
+	if (ret) {
+		ret = (int)p7580_submit_err("queue", ret);
+		p7580_drv_job_pm_release(drv);
+		drm_sched_job_cleanup(sched_job);
+		kfree(sched_job);
+		goto err_job_bos;
+	}
+
+	/* 4. out-sync install (takes its own ref). The fence is armed
+	 * above, before queueing: installing it HERE (during the ioctl)
+	 * is the whole fix -- Mesa holds a live fence at SUBMIT return
+	 * and cannot recycle the batch BO while the GPU still reads
+	 * it. Arm-fail-closed: a NULL fence installs nothing (the job
+	 * still runs). The handle was validated before queueing, so a
+	 * missing handle here is -ENOENT on a handle closed under us. */
+	if (args->out_sync) {
+		struct dma_fence *fence = sched_job->fence;
+		struct drm_syncobj *s;
+
+		s = drm_syncobj_find(&df->mgr, args->out_sync);
+		if (!s) {
+ret = (int)p7580_submit_err("out_sync", -ENOENT);
+			goto err_out;
+		}
+		if (fence)
+			ret = drm_syncobj_replace_fence(s, fence);
+		drm_syncobj_put(s);
+		if (ret)
+			goto err_out;
+	}
+
+	/* Success: the job owns one ref per BO now (job->bos);
+	 * drop only the in-fence refs here. bo_list holds its own
+	 * refs from map_bo; free_job drops the job's refs after
+	 * the completion retire walk. */
+	for (i = 0; i < nf; i++)
+		dma_fence_put(inf[i]);
+	return 0;
+
+err_out:
+	/* Submitted but out-sync failed: the job still runs (and
+	 * still owns its BO refs); report. */
+	for (i = 0; i < nf; i++)
+		dma_fence_put(inf[i]);
+	return ret;
+
+err_job_bos:
+	/* Job owns one ref per BO (transferred at dispatch) but was
+	 * never published: p7580_job_free releases the pointer array
+	 * (canon, no unref — refs are still ours in objs[]). */
+	p7580_job_free(job);
+	job = NULL;
+err_objs:
+	for (i = 0; i < nr; i++)
+		drm_gem_object_unreference_unlocked(objs[i]);
+err_inf:
+	for (i = 0; i < nf; i++)
+		dma_fence_put(inf[i]);
+	return ret;
+}
+
+/* SUBMIT ioctl override (wired in main.c's table instead of GEM's
+ * panfrost_ioctl_submit). Stages user arrays with copy_from_user, then
+ * runs p7580_drv_submit. Caps mirror the jobs slice (64 BOs / 16 syncs).
+ * Must stay in sync with jobs/panfrost7580_jm_hw.h struct p7580_submit
+ * (the staged local). */
+int panfrost_ioctl_submit_override(struct drm_device *dev, void *data,
+				   struct drm_file *file_priv)
+{
+	struct drm_panfrost_submit *args = data;
+	struct p7580_drv_file *df = file_priv->driver_priv;
+	struct p7580_drv *drv;
+	uint32_t bo_handles[P7580_MAX_SUBMIT_BOS];
+	uint32_t in_syncs[P7580_MAX_IN_SYNCS];
+	struct p7580_submit staged;
+
+	if (!df || !df->drv)
+		return -ENODEV;
+	drv = df->drv;
+	if (!p7580_jc_valid(args->jc))
+		return -EINVAL;
+	if (args->requirements & ~PANFROST_JD_REQ_FS)
+		return -EINVAL;
+	if (args->in_sync_count > P7580_MAX_IN_SYNCS ||
+	    args->bo_handle_count > P7580_MAX_SUBMIT_BOS)
+		return -EINVAL;
+
+	if (args->bo_handle_count) {
+		if (!args->bo_handles ||
+		    copy_from_user(bo_handles, (void __user *)(uintptr_t)
+				   args->bo_handles,
+				   args->bo_handle_count * sizeof(uint32_t)))
+			return -EFAULT;
+	}
+	if (args->in_sync_count) {
+		if (!args->in_syncs ||
+		    copy_from_user(in_syncs, (void __user *)(uintptr_t)
+				   args->in_syncs,
+				   args->in_sync_count * sizeof(uint32_t)))
+			return -EFAULT;
+	}
+
+	staged.jc = args->jc;
+	staged.in_syncs = (uint64_t)(uintptr_t)in_syncs;
+	staged.in_sync_count = args->in_sync_count;
+	staged.out_sync = args->out_sync;
+	staged.bo_handles = (uint64_t)(uintptr_t)bo_handles;
+	staged.bo_handle_count = args->bo_handle_count;
+	staged.requirements = args->requirements;
+
+	/* Under runtime PM the GPU must be awake for the synchronous
+	 * MMU-map + queue leg. p7580_drv_submit arms a second,
+	 * job-lifetime ref before the job is visible to the async
+	 * worker, so dropping this ref on return is safe: the block
+	 * stays powered until free_job releases the job's own ref.
+	 * Fail closed: no MMIO (not even map_bo) after a failed get. */
+	{
+		int ret = p7580_drv_pm_get(drv);
+
+		if (ret < 0)
+			return ret;
+		ret = p7580_drv_submit(drv, dev, file_priv, &staged);
+		p7580_drv_pm_put(drv);
+		return ret;
+	}
+}
+
diff -u '--exclude=.git' -Naur a/drivers/gpu/drm/panfrost/panfrost7580_syncobj.c b/drivers/gpu/drm/panfrost/panfrost7580_syncobj.c
--- a/drivers/gpu/drm/panfrost/panfrost7580_syncobj.c	1969-12-31 19:00:00.000000000 -0500
+++ b/drivers/gpu/drm/panfrost/panfrost7580_syncobj.c	2026-11-21 00:00:00.000000000 -0500
@@ -0,0 +1,859 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * panfrost7580_syncobj.c - generic DRM syncobj ioctl bodies for the
+ * T720 port (Exynos 7580, Nura 3.10.108, j7elte).
+ *
+ * Context (see the header): Mesa 20.3.5 panfrost asserts on
+ * drmSyncobjCreate (pan_context.c:1632-1633). The 3.10 core exposes
+ * no core SYNCOBJ rows, and the driver-private table only serves
+ * nr < DRM_COMMAND_END (0xA0); the generic syncobj numbers
+ * (0xBF-0xC5) always fall through to the core table, where a NULL
+ * func returns -EINVAL (drm_drv.c:401-435). So this file registers
+ * NOTHING in the driver's ioctl table. Instead the driver's fops
+ * .unlocked_ioctl/.compat_ioctl point at panfrost_syncobj_ioctl,
+ * which routes the seven syncobj numbers here and forwards
+ * everything else to drm_ioctl() unchanged.
+ *
+ * errno contract (what Mesa/libdrm expect; same as mainline):
+ *  - CREATE: unknown flags bits -> -EINVAL (mainline rejects
+ *    anything but CREATE_SIGNALED at once: the check is
+ *    flags & ~DRM_SYNCOBJ_CREATE_SIGNALED).
+ *  - CREATE_SIGNALED: installs a signaled fence so a first WAIT
+ *    returns 0 instead of blocking forever. 3.10 has no pre-signaled
+ *    fence type, so an already-signaled private fence is used
+ *    (dma_fence_init + dma_fence_signal, released on replace).
+ *  - DESTROY of an unknown handle -> -ENOENT (0003 shim contract;
+ *    matches mainline ENOENT-on-stale-handle).
+ *  - WAIT: unknown flag bits -> -EINVAL; timeout is ABSOLUTE
+ *    CLOCK_MONOTONIC ns (drm_syncobj_wait in the 20.x libdrm wrapper
+ *    passes the absolute stamp straight through). Past/zero stamp is
+ *    non-blocking (0 jiffies). count==0 or NULL handles -> -EINVAL.
+ *    WAIT_ALL(all fences signaled -> 0) and WAIT_ANY(first signaled
+ *    index in first_signaled, still 0; none signaled in budget ->
+ *    -ETIME, matching the shim's dma_fence_wait_timeout -ETIME).
+ *    WAIT_FOR_SUBMIT/WAIT_AVAILABLE need the timeline/eventfd code
+ *    the 0003 shim deliberately omits -> -EINVAL (never silently
+ *    ignored: Mesa would hang on an un-waited submit fence).
+ *  - RESET of an unknown handle -> -ENOENT; NULL fence is already
+ *    the signaled state, so reset keeps fence NULL and returns 0.
+ *  - SIGNAL: unknown handle -> -ENOENT; the installed fence is a
+ *    private already-signaled fence (see CREATE_SIGNALED). Signaling
+ *    an already-signaled (or empty) syncobj is a no-op 0 -- Mesa
+ *    re-signals without checking.
+ *  - HANDLE_TO_FD/FD_TO_HANDLE tolerate bit 0 (libdrm 2.4.134 sets
+ *    EXPORT/IMPORT_SYNC_FILE unconditionally; no sync_file.c on 3.10
+ *    but the plain-fence anon-inode fd satisfies Mesa's snapshot use)
+ *    and reject all other unknown bits (TIMELINE bit 1 included).
+ *  - copy_from_user/copy_to_user faults -> -EFAULT (the 3.10 core
+ *    copies the fixed struct, NOT the pointed-to handle array; the
+ *    array is copied here).
+ *  - no driver_priv (open did not run) -> -ENODEV.
+ *
+ * Locking: the 0003 manager serialises the idr; each syncobj
+ * serialises its own fence pointer. WAIT snapshots fence refs under
+ * the manager then sleeps unlocked. The anon-inode export holds a
+ * fence ref for the file's lifetime (released in syncobj_file_release).
+ *
+ * SHIM-CALLSITES: 0003 (manager create/destroy/find, replace_fence,
+ * find_fence). 0001 (dma_fence_init/signal/wait_timeout/get/put via
+ * the 0003 wrappers). No 0002/0004 use.
+ */
+
+#include <linux/anon_inodes.h>
+#include <linux/device.h>
+#include <linux/dma-mapping.h>
+#include <linux/file.h>
+#include <linux/jiffies.h>
+#include <linux/ktime.h>
+#include <linux/mutex.h>
+#include <linux/slab.h>
+#include <linux/time.h>
+#include <linux/uaccess.h>
+
+#include <drm/drmP.h>
+#include <drm/drm.h>
+
+#include <linux/dma-fence.h>		/* 0001 (staged by Makefile) */
+#include "drm_syncobj.h"		/* 0003 (staged by Makefile) */
+#include "panfrost7580_syncobj.h"
+
+/* ---- UAPI payload mirrors (3.10-era sizes, byte-identical wire) ---- */
+/* v5.2/20.x drm.h: SYNCOBJ ioctls are core numbers, NOT driver-private:
+ * CREATE 0xBF, DESTROY 0xC0, HANDLE_TO_FD 0xC1, FD_TO_HANDLE 0xC2,
+ * WAIT 0xC3, RESET 0xC4, SIGNAL 0xC5 (DRM_IOWR). The _IOC_NR (low 8
+ * bits) is what drm_ioctl dispatches on; the core table has no rows
+ * there, so our fops dispatcher catches them first. */
+#define P7580_SYNCOBJ_NR_CREATE		0xBFu
+#define P7580_SYNCOBJ_NR_DESTROY	0xC0u
+#define P7580_SYNCOBJ_NR_HANDLE_TO_FD	0xC1u
+#define P7580_SYNCOBJ_NR_FD_TO_HANDLE	0xC2u
+#define P7580_SYNCOBJ_NR_WAIT		0xC3u
+#define P7580_SYNCOBJ_NR_RESET		0xC4u
+#define P7580_SYNCOBJ_NR_SIGNAL		0xC5u
+/* DEBUG-ONLY (gpu31-gpuwrite, strip before cutover): kernel BO word
+ * readback route. 0xCF sits above the syncobj 0xBF-0xC5 block and
+ * below DRM_COMMAND_BASE 0x40-space driver numbers: no collision
+ * with either table; the six-ioctl driver table is untouched. */
+#define P7580_DEBUG_READ_BO_NR		0xCFu
+
+#define P7580_SYNCOBJ_CREATE_SIGNALED	(1u << 0)
+
+#define P7580_SYNCOBJ_WAIT_ALL		(1u << 0)
+#define P7580_SYNCOBJ_WAIT_FOR_SUBMIT	(1u << 1)
+#define P7580_SYNCOBJ_WAIT_AVAILABLE	(1u << 2)
+/* Bits the 20.x WAIT struct defines but this binary subset cannot
+ * honour: deadline hint (needs fence deadlines, absent in 0001). */
+#define P7580_SYNCOBJ_WAIT_DEADLINE	(1u << 3)
+
+struct p7580_syncobj_create {
+	__u32 handle;
+	__u32 flags;
+};
+
+struct p7580_syncobj_destroy {
+	__u32 handle;
+	__u32 pad;
+};
+
+struct p7580_syncobj_handle {
+	__u32 handle;
+	__u32 flags;
+	__s32 fd;
+	__u32 pad;
+};
+
+struct p7580_syncobj_wait {
+	__u64 handles;
+	__s64 timeout_nsec;	/* absolute CLOCK_MONOTONIC */
+	__u32 count_handles;
+	__u32 flags;
+	__u32 first_signaled;
+	__u32 pad;
+};
+
+struct p7580_syncobj_array {
+	__u64 handles;
+	__u32 count_handles;
+	__u32 pad;
+};
+/* DEBUG-ONLY (gpu31-gpuwrite, strip before cutover): 16 B payload
+ * mirror of struct p7580_debug_read_bo (ioctl.c): handle + byte
+ * offset + OUT value + zero pad. Same 16 B shape discipline as the
+ * syncobj structs. */
+struct p7580_debug_read_bo {
+	__u32 handle;
+	__u32 offset;
+	__u32 value;
+	__u32 pad;
+};
+int panfrost_debug_read_bo(struct drm_device *dev, void *data,
+			   struct drm_file *file_priv);
+
+/* ABI gate (gpu31-abialign, both TUs): Mesa 20.3 bundles the 20.x
+ * drm.h syncobj shapes (verified on-device 2026-11-20 from
+ * /data/mesabuild/mesa20/include/drm-uapi/drm.h + disassembled
+ * libdrm.so.2.134.0 wrappers):
+ *   CREATE 8 B  IOWR(0xBF), DESTROY 8 B (v5.2-era: IOWR, current is
+ *   IOWR too -- the old IOW comment in pf7580.c predates the check),
+ *   HANDLE 16 B IOWR(0xC1/0xC2, NO point field),
+ *   WAIT   32 B IOWR(0xC3, NO deadline_nsec tail),
+ *   ARRAY  16 B IOWR(0xC4/0xC5).
+ * The 3.10 core keys copy_from/to_user on OUR asize (the dispatcher's
+ * asize table below), so the struct MUST stay 16/32 B: a 24/40 B
+ * current-header struct would over-copy into the stack buffer. The
+ * dispatcher ALSO keys on _IOC_NR only (not _IOC_SIZE), so a 24 B
+ * HANDLE_TO_FD from libdrm 2.4.134 lands here with usize=24; the
+ * handler reads only the first 16 B and ignores the point tail.
+ * ioctl direction (client pf7580.c asserts the same): CREATE+WAIT are
+ * IOWR, DESTROY is IOWR on the wire the kernel serves (20.x drm.h says
+ * DRM_IOWR for all three; the legacy IOW DESTROY encoding aliases the
+ * same _IOC_NR so dispatch is unaffected, but new code MUST use IOWR).
+ * Flag contract: SYNC_FILE bits (HTOF/FTOH bit 0) need sync_file.c
+ * (absent on 3.10) and are the ONLY rejected HTOF/FTOH bits; WAIT
+ * rejects FOR_SUBMIT/AVAILABLE/DEADLINE. See the handle_to_fd body for
+ * why SYNC_FILE is silently tolerated on plain-fence exports. */
+#include <linux/bug.h>
+/* Bit 0 doubles as the only valid HTOF/FTOH flag on BOTH the 20.x
+ * header (EXPORT/IMPORT_SYNC_FILE) and mainline (TIMELINE is bit 1). */
+#define P7580_SYNCOBJ_HTOF_EXPORT_SYNC_FILE	(1u << 0)
+#define P7580_SYNCOBJ_FTOH_IMPORT_SYNC_FILE	(1u << 0)
+static inline void p7580_syncobj_abi_check(void)
+{
+	BUILD_BUG_ON(sizeof(struct p7580_syncobj_create) != 8);
+	BUILD_BUG_ON(sizeof(struct p7580_syncobj_destroy) != 8);
+	BUILD_BUG_ON(sizeof(struct p7580_syncobj_handle) != 16);
+	BUILD_BUG_ON(__builtin_offsetof(struct p7580_syncobj_handle,
+					handle) != 0);
+	BUILD_BUG_ON(__builtin_offsetof(struct p7580_syncobj_handle,
+					flags) != 4);
+	BUILD_BUG_ON(__builtin_offsetof(struct p7580_syncobj_handle,
+					fd) != 8);
+	BUILD_BUG_ON(__builtin_offsetof(struct p7580_syncobj_handle,
+					pad) != 12);
+	BUILD_BUG_ON(sizeof(struct p7580_syncobj_wait) != 32);
+	BUILD_BUG_ON(__builtin_offsetof(struct p7580_syncobj_wait,
+					handles) != 0);
+	BUILD_BUG_ON(__builtin_offsetof(struct p7580_syncobj_wait,
+					timeout_nsec) != 8);
+	BUILD_BUG_ON(__builtin_offsetof(struct p7580_syncobj_wait,
+					count_handles) != 16);
+	BUILD_BUG_ON(__builtin_offsetof(struct p7580_syncobj_wait,
+					flags) != 20);
+	BUILD_BUG_ON(__builtin_offsetof(struct p7580_syncobj_wait,
+					first_signaled) != 24);
+	BUILD_BUG_ON(__builtin_offsetof(struct p7580_syncobj_wait,
+					pad) != 28);
+	BUILD_BUG_ON(sizeof(struct p7580_syncobj_array) != 16);
+	BUILD_BUG_ON(P7580_SYNCOBJ_CREATE_SIGNALED !=
+		     (1u << 0));
+	BUILD_BUG_ON(P7580_SYNCOBJ_WAIT_ALL != (1u << 0));
+	BUILD_BUG_ON(P7580_SYNCOBJ_WAIT_FOR_SUBMIT != (1u << 1));
+	BUILD_BUG_ON(P7580_SYNCOBJ_WAIT_AVAILABLE != (1u << 2));
+	BUILD_BUG_ON(P7580_SYNCOBJ_HTOF_EXPORT_SYNC_FILE != (1u << 0));
+	BUILD_BUG_ON(P7580_SYNCOBJ_FTOH_IMPORT_SYNC_FILE != (1u << 0));
+	/* DEBUG-ONLY (gpu31-gpuwrite): 16 B readback payload pin. */
+	BUILD_BUG_ON(sizeof(struct p7580_debug_read_bo) != 16);
+	BUILD_BUG_ON(__builtin_offsetof(struct p7580_debug_read_bo,
+					handle) != 0);
+	BUILD_BUG_ON(__builtin_offsetof(struct p7580_debug_read_bo,
+					offset) != 4);
+	BUILD_BUG_ON(__builtin_offsetof(struct p7580_debug_read_bo,
+					value) != 8);
+	BUILD_BUG_ON(__builtin_offsetof(struct p7580_debug_read_bo,
+					pad) != 12);
+	BUILD_BUG_ON(P7580_DEBUG_READ_BO_NR != 0xCFu);
+}
+
+/* The manager lives first in driver_priv (GEM p7580_file_priv and the
+ * driver's p7580_drv_file share the layout: mgr, ...). */
+static struct drm_syncobj_manager *p7580_sync_mgr(struct drm_file *fp)
+{
+	struct drm_syncobj_manager *mgr;
+
+	if (!fp)
+		return NULL;
+	mgr = (struct drm_syncobj_manager *)fp->driver_priv;
+	return mgr;
+}
+
+/* A pre-signaled fence: 0001 has no timeline/signaled constructor, so
+ * init a private fence and signal it once. Ops mirror the submit-job
+ * fence backend contract (release via release_base). The table is
+ * writable static (NOT const): dma_fence_init BUGs on a NULL release,
+ * so the hook must be assignable at definition time, and a const
+ * table would take a .rodata write on first CREATE_SIGNALED/SIGNAL. */
+static void p7580_sync_signaled_release(struct dma_fence *fence)
+{
+	dma_fence_release_base(fence);
+	kfree(fence);
+}
+
+static struct dma_fence_ops p7580_sync_signaled_ops = {
+	.get_driver_name = NULL,
+	.get_timeline_name = NULL,
+	.enable_signaling = NULL,
+	.signaled = NULL,
+	.wait = NULL,
+	.release = p7580_sync_signaled_release,
+};
+
+static struct dma_fence *p7580_sync_signaled_fence(void)
+{
+	struct dma_fence *f;
+
+	f = kzalloc(sizeof(*f), GFP_KERNEL);
+	if (!f)
+		return NULL;
+	dma_fence_init(f, &p7580_sync_signaled_ops,
+		       dma_fence_context_alloc(1), 1);
+	dma_fence_signal(f);
+	return f;
+}
+
+int panfrost_syncobj_create(struct drm_device *dev, void *data,
+			    struct drm_file *file_priv)
+{
+	struct p7580_syncobj_create *args = data;
+	struct drm_syncobj_manager *mgr = p7580_sync_mgr(file_priv);
+	struct drm_syncobj *s;
+	u32 handle;
+	int ret;
+
+	(void)dev;
+	p7580_syncobj_abi_check();
+	if (!mgr)
+		return -ENODEV;
+	/* Mainline rejects any unknown bit at once (flags & ~SIGNALED). */
+	if (args->flags & ~P7580_SYNCOBJ_CREATE_SIGNALED)
+		return -EINVAL;
+	ret = drm_syncobj_create(mgr, &handle);
+	if (ret)
+		return ret;
+	if (args->flags & P7580_SYNCOBJ_CREATE_SIGNALED) {
+		struct dma_fence *f = p7580_sync_signaled_fence();
+
+		if (!f) {
+			drm_syncobj_destroy(mgr, handle);
+			return -ENOMEM;
+		}
+		s = drm_syncobj_find(mgr, handle);
+		if (!s) {
+			dma_fence_put(f);
+			drm_syncobj_destroy(mgr, handle);
+			return -ENOENT;
+		}
+		ret = drm_syncobj_replace_fence(s, f);
+		drm_syncobj_put(s);
+		/* replace takes its own ref. */
+		dma_fence_put(f);
+		if (ret) {
+			drm_syncobj_destroy(mgr, handle);
+			return ret;
+		}
+	}
+	args->handle = handle;
+	return 0;
+}
+
+int panfrost_syncobj_destroy(struct drm_device *dev, void *data,
+			     struct drm_file *file_priv)
+{
+	struct p7580_syncobj_destroy *args = data;
+	struct drm_syncobj_manager *mgr = p7580_sync_mgr(file_priv);
+
+	(void)dev;
+	if (!mgr)
+		return -ENODEV;
+	if (args->pad)
+		return -EINVAL;
+	/* Unknown handle -> -ENOENT (0003 contract, mainline parity). */
+	return drm_syncobj_destroy(mgr, args->handle);
+}
+
+/* ---- FD export/import: plain-fence anon_inode transport ---- */
+/* 3.10 has no sync_file.c, so HANDLE_TO_FD exports the CURRENT fence
+ * (snapshot ref at export time; later replaces do not follow the fd).
+ * Bit 0 (EXPORT/IMPORT_SYNC_FILE) is tolerated (see handler bodies);
+ * all other flag bits are -EINVAL. */
+
+struct p7580_syncobj_export {
+	struct dma_fence *fence;	/* ref held for the file */
+};
+
+static int p7580_syncobj_file_release(struct inode *inode, struct file *filp)
+{
+	struct p7580_syncobj_export *ex = filp->private_data;
+
+	(void)inode;
+	if (ex) {
+		dma_fence_put(ex->fence);
+		kfree(ex);
+	}
+	return 0;
+}
+
+static const struct file_operations p7580_syncobj_file_fops = {
+	.owner = THIS_MODULE,
+	.release = p7580_syncobj_file_release,
+};
+
+int panfrost_syncobj_handle_to_fd(struct drm_device *dev, void *data,
+				  struct drm_file *file_priv)
+{
+	struct p7580_syncobj_handle *args = data;
+	struct drm_syncobj_manager *mgr = p7580_sync_mgr(file_priv);
+	struct drm_syncobj *s;
+	struct dma_fence *f;
+	struct p7580_syncobj_export *ex;
+	int fd;
+
+	(void)dev;
+	p7580_syncobj_abi_check();
+	if (!mgr)
+		return -ENODEV;
+	if (args->pad)
+		return -EINVAL;
+	/* Mesa 20.3 libdrm 2.4.134 unconditionally sets bit 0
+	 * (EXPORT_SYNC_FILE) in drmSyncobjExportSyncFile/HandleToFD
+	 * (disassembled: stp w1=handle,w2=-1 + mov w1=#1 for the flag
+	 * word; pan_screen.c panfrost_fence_create calls ExportSyncFile
+	 * so EVERY fence snapshot -- and therefore every glFinish/
+	 * ReadPixels flush -- goes through here). There is no sync_file
+	 * layer on 3.10, but the plain-fence anon-inode fd we install
+	 * satisfies the only thing Mesa does with it: import the fence
+	 * into a fresh syncobj. Rejecting bit 0 broke all draws (3x
+	 * EINVAL per flush, SUBMIT never reached). So: tolerate bit 0,
+	 * reject every OTHER unknown bit (TIMELINE bit 1 included --
+	 * the 0003 shim has no timeline points, and silently dropping
+	 * them would hang Mesa on a fence we never signalled). */
+	if (args->flags & ~P7580_SYNCOBJ_HTOF_EXPORT_SYNC_FILE)
+		return -EINVAL;
+	s = drm_syncobj_find(mgr, args->handle);
+	if (!s)
+		return -ENOENT;
+	f = drm_syncobj_find_fence(s);
+	drm_syncobj_put(s);
+	if (!f)
+		return -EINVAL;	/* NULL fence: nothing to export */
+	ex = kzalloc(sizeof(*ex), GFP_KERNEL);
+	if (!ex) {
+		dma_fence_put(f);
+		return -ENOMEM;
+	}
+	ex->fence = f;	/* fd owns this ref now */
+	fd = anon_inode_getfd("syncobj", &p7580_syncobj_file_fops, ex,
+			      O_CLOEXEC);
+	if (fd < 0) {
+		dma_fence_put(f);
+		kfree(ex);
+		return fd;
+	}
+	args->fd = fd;
+	return 0;
+}
+
+int panfrost_syncobj_fd_to_handle(struct drm_device *dev, void *data,
+				  struct drm_file *file_priv)
+{
+	struct p7580_syncobj_handle *args = data;
+	struct drm_syncobj_manager *mgr = p7580_sync_mgr(file_priv);
+	struct file *filp;
+	struct p7580_syncobj_export *ex;
+	struct drm_syncobj *s;
+	u32 handle;
+	int ret;
+
+	(void)dev;
+	if (!mgr)
+		return -ENODEV;
+	if (args->pad)
+		return -EINVAL;
+	/* Mirror HANDLE_TO_FD: libdrm drmSyncobjImportSyncFile sets bit 0
+	 * (IMPORT_SYNC_FILE); tolerate it, reject the rest (TIMELINE bit 1
+	 * included). A foreign sync_file fd (real sync_file.c file) still
+	 * fails the f_op check below -- we only snapshot fences from fds
+	 * this driver exported. */
+	if (args->flags & ~P7580_SYNCOBJ_FTOH_IMPORT_SYNC_FILE)
+		return -EINVAL;
+	if (args->fd < 0)
+		return -EINVAL;
+	filp = fget((unsigned int)args->fd);
+	if (!filp)
+		return -EINVAL;
+	/* Only fds this driver exported carry a fence; anything else
+	 * (eventfd, pipe, foreign sync_file) is -EINVAL, never a
+	 * blind pointer dereference. */
+	if (filp->f_op != &p7580_syncobj_file_fops) {
+		fput(filp);
+		return -EINVAL;
+	}
+	ex = filp->private_data;
+	if (!ex || !ex->fence) {
+		fput(filp);
+		return -EINVAL;
+	}
+	ret = drm_syncobj_create(mgr, &handle);
+	if (ret) {
+		fput(filp);
+		return ret;
+	}
+	s = drm_syncobj_find(mgr, handle);
+	if (!s) {
+		fput(filp);
+		drm_syncobj_destroy(mgr, handle);
+		return -ENOENT;
+	}
+	/* Import snapshots the CURRENT fence of the fd (same non-sync_file
+	 * limit as export: later fence replaces on the source syncobj do
+	 * not propagate through the fd). */
+	ret = drm_syncobj_replace_fence(s, ex->fence);
+	drm_syncobj_put(s);
+	fput(filp);
+	if (ret) {
+		drm_syncobj_destroy(mgr, handle);
+		return ret;
+	}
+	args->handle = handle;
+	return 0;
+}
+
+int panfrost_syncobj_wait(struct drm_device *dev, void *data,
+			  struct drm_file *file_priv)
+{
+	struct p7580_syncobj_wait *args = data;
+	struct drm_syncobj_manager *mgr = p7580_sync_mgr(file_priv);
+	struct drm_syncobj **syncs = NULL;
+	struct dma_fence **fences = NULL;
+	uint32_t count, i;
+	struct timespec now;
+	int64_t remain_ns;
+	long timeout;
+	int ret = 0;
+
+	(void)dev;
+	if (!mgr)
+		return -ENODEV;
+	count = args->count_handles;
+	if (!count || !args->handles)
+		return -EINVAL;
+	/* WAIT_FOR_SUBMIT/WAIT_AVAILABLE need the timeline/eventfd code
+	 * the 0003 shim omits; deadline needs 0001 fence deadlines.
+	 * Reject (never ignore): Mesa would hang on a fence we never
+	 * waited for. WAIT_ALL vs ANY is honoured below. */
+	if (args->flags & ~(P7580_SYNCOBJ_WAIT_ALL))
+		return -EINVAL;
+	/* Absolute -> relative: same shape as WAIT_BO (ktime_get_ts is
+	 * the 3.10 spelling). Past stamp stays non-blocking. */
+	ktime_get_ts(&now);
+	remain_ns = (int64_t)args->timeout_nsec -
+		    ((int64_t)now.tv_sec * 1000000000LL + now.tv_nsec);
+	if (remain_ns <= 0)
+		timeout = 0;
+	else if ((uint64_t)remain_ns > (uint64_t)LONG_MAX)
+		timeout = LONG_MAX;
+	else
+		timeout = nsecs_to_jiffies((uint64_t)remain_ns);
+
+	/* Snapshot syncobj + fence refs under the manager, sleep after.
+	 * Caps mirror SUBMIT (64 BOs / 16 in-syncs): 64 handles max. */
+	if (count > 64)
+		return -EINVAL;
+	syncs = kcalloc(count, sizeof(*syncs), GFP_KERNEL);
+	if (!syncs)
+		return -ENOMEM;
+	fences = kcalloc(count, sizeof(*fences), GFP_KERNEL);
+	if (!fences) {
+		kfree(syncs);
+		return -ENOMEM;
+	}
+	for (i = 0; i < count; i++) {
+		uint32_t h;
+
+		if (copy_from_user(&h,
+				   (void __user *)(uintptr_t)args->handles +
+				   i * sizeof(h), sizeof(h))) {
+			ret = -EFAULT;
+			count = i;
+			goto out_put_syncs;
+		}
+		syncs[i] = drm_syncobj_find(mgr, h);
+		if (!syncs[i]) {
+			ret = -ENOENT;
+			count = i;
+			goto out_put_syncs;
+		}
+		/* NULL fence == already signaled (0003 contract): no
+		 * fence ref, counted as signaled below. */
+		fences[i] = drm_syncobj_find_fence(syncs[i]);
+	}
+	if (args->flags & P7580_SYNCOBJ_WAIT_ALL) {
+		for (i = 0; i < args->count_handles; i++) {
+			long r;
+
+			if (!fences[i])
+				continue;
+			r = dma_fence_wait_timeout(fences[i], true,
+						   timeout);
+			if (r < 0) {
+				ret = (int)r;
+				goto out_put_all;
+			}
+			/* r == 0 is ambiguous: non-blocking probe on a
+			 * pending fence (timeout == 0) also yields 0
+			 * (0001 maps helper-0 to 0 when no budget was
+			 * given). Only a signaled fence counts: re-test
+			 * and time out otherwise, or a WAIT_ALL poll on
+			 * a pending fence would falsely report success. */
+			if (!dma_fence_is_signaled(fences[i])) {
+				ret = -ETIME;
+				goto out_put_all;
+			}
+			/* Chained budget: each fence consumes from what
+			 * the previous one left (0001 returns remaining;
+			 * 0 with budget left means signaled now). */
+			timeout = r;
+		}
+		args->first_signaled = 0;
+	} else {
+		/* ANY: poll without consuming the whole budget on the
+		 * first unsignaled fence. Zero-timeout test first, then
+		 * bounded wait on each in turn with the remaining
+		 * budget split evenly (binary-subset approximation). */
+		uint32_t n = args->count_handles;
+
+		for (i = 0; i < n; i++) {
+			if (!fences[i] ||
+			    dma_fence_is_signaled(fences[i])) {
+				args->first_signaled = i;
+				goto out_put_all;
+			}
+		}
+		if (timeout == 0) {
+			ret = -ETIME;
+			goto out_put_all;
+		}
+		for (i = 0; i < n; i++) {
+			long r = dma_fence_wait_timeout(fences[i], true,
+							timeout / (n - i));
+
+			if (r < 0 && r != -ETIME) {
+				ret = (int)r;
+				goto out_put_all;
+			}
+			/* r >= 0: signaled with remaining budget (or a
+			 * 0-budget hit exactly at signal). r == 0 with an
+			 * unsignaled fence is the non-blocking probe
+			 * outcome: fall through to the -ETIME below. */
+			if (r >= 0) {
+				if (!fences[i] ||
+				    dma_fence_is_signaled(fences[i])) {
+					args->first_signaled = i;
+					ret = 0;
+					goto out_put_all;
+				}
+			}
+		}
+		ret = -ETIME;
+	}
+out_put_all:
+	count = args->count_handles;
+out_put_syncs:
+	for (i = 0; i < count; i++) {
+		dma_fence_put(fences[i]);
+		if (syncs[i])
+			drm_syncobj_put(syncs[i]);
+	}
+	kfree(fences);
+	kfree(syncs);
+	return ret;
+}
+
+int panfrost_syncobj_reset(struct drm_device *dev, void *data,
+			   struct drm_file *file_priv)
+{
+	struct p7580_syncobj_array *args = data;
+	struct drm_syncobj_manager *mgr = p7580_sync_mgr(file_priv);
+	uint32_t i, count = args->count_handles;
+
+	(void)dev;
+	if (!mgr)
+		return -ENODEV;
+	if (!count || !args->handles)
+		return -EINVAL;
+	if (count > 64)
+		return -EINVAL;
+	for (i = 0; i < count; i++) {
+		uint32_t h;
+		struct drm_syncobj *s;
+
+		if (copy_from_user(&h,
+				   (void __user *)(uintptr_t)args->handles +
+				   i * sizeof(h), sizeof(h)))
+			return -EFAULT;
+		s = drm_syncobj_find(mgr, h);
+		if (!s)
+			return -ENOENT;
+		/* Binary reset: drop the fence (NULL == signaled in the
+		 * 0003 contract, but Mesa only resets after WAIT, so the
+		 * next SUBMIT re-installs via replace_fence anyway). */
+		drm_syncobj_replace_fence(s, NULL);
+		drm_syncobj_put(s);
+	}
+	return 0;
+}
+
+int panfrost_syncobj_signal(struct drm_device *dev, void *data,
+			    struct drm_file *file_priv)
+{
+	struct p7580_syncobj_array *args = data;
+	struct drm_syncobj_manager *mgr = p7580_sync_mgr(file_priv);
+	uint32_t i, count = args->count_handles;
+
+	(void)dev;
+	if (!mgr)
+		return -ENODEV;
+	if (!count || !args->handles)
+		return -EINVAL;
+	if (count > 64)
+		return -EINVAL;
+	for (i = 0; i < count; i++) {
+		uint32_t h;
+		struct drm_syncobj *s;
+		struct dma_fence *f;
+		int ret;
+
+		if (copy_from_user(&h,
+				   (void __user *)(uintptr_t)args->handles +
+				   i * sizeof(h), sizeof(h)))
+			return -EFAULT;
+		s = drm_syncobj_find(mgr, h);
+		if (!s)
+			return -ENOENT;
+		/* Already-signaled (or empty) is a no-op 0. */
+		f = drm_syncobj_find_fence(s);
+		if (!f || dma_fence_is_signaled(f)) {
+			dma_fence_put(f);
+			drm_syncobj_put(s);
+			continue;
+		}
+		dma_fence_put(f);
+		f = p7580_sync_signaled_fence();
+		if (!f) {
+			drm_syncobj_put(s);
+			return -ENOMEM;
+		}
+		ret = drm_syncobj_replace_fence(s, f);
+		dma_fence_put(f);
+		drm_syncobj_put(s);
+		if (ret)
+			return ret;
+	}
+	return 0;
+}
+
+/* ---- fops dispatcher (main.c wires .unlocked_ioctl here) ---- */
+
+static long p7580_syncobj_dispatch(struct drm_device *dev, void *kdata,
+				   struct drm_file *file_priv,
+				   unsigned int nr)
+{
+	switch (nr) {
+	case P7580_SYNCOBJ_NR_CREATE:
+		return panfrost_syncobj_create(dev, kdata, file_priv);
+	case P7580_SYNCOBJ_NR_DESTROY:
+		return panfrost_syncobj_destroy(dev, kdata, file_priv);
+	case P7580_SYNCOBJ_NR_HANDLE_TO_FD:
+		return panfrost_syncobj_handle_to_fd(dev, kdata, file_priv);
+	case P7580_SYNCOBJ_NR_FD_TO_HANDLE:
+		return panfrost_syncobj_fd_to_handle(dev, kdata, file_priv);
+	case P7580_SYNCOBJ_NR_WAIT:
+		return panfrost_syncobj_wait(dev, kdata, file_priv);
+	case P7580_SYNCOBJ_NR_RESET:
+		return panfrost_syncobj_reset(dev, kdata, file_priv);
+	case P7580_SYNCOBJ_NR_SIGNAL:
+		return panfrost_syncobj_signal(dev, kdata, file_priv);
+	case P7580_DEBUG_READ_BO_NR:
+		/* DEBUG-ONLY (gpu31-gpuwrite): kernel BO word readback.
+		 * Not a syncobj number and not a driver-table number:
+		 * handled here at the fops layer only. */
+		return panfrost_debug_read_bo(dev, kdata, file_priv);
+	default:
+		return -ENOENT;	/* not a syncobj number: caller forwards */
+	}
+}
+
+/* Same copy discipline as drm_ioctl (drm_drv.c:444-490): fixed-size
+ * struct is kernel-copied; only the pointed-to handle arrays are
+ * copied in the handlers. asize>usize zero-pads (older libdrm with a
+ * shorter WAIT struct keeps working); usize>asize truncates (newer
+ * libdrm with a LONGER struct: 24 B HANDLE with point tail, 40 B WAIT
+ * with deadline_nsec -- the extra tail bytes are NOT copied in, so
+ * the handler never sees them, and the copy_to_user writes back only
+ * usize... see below). Copy-back is capped at asize (never usize):
+ * with a 24 B userspace HANDLE, blindly writing 24 B back would leak
+ * 8 B of stack past our 16 B struct into userspace. */
+static long p7580_syncobj_do(struct file *filp, unsigned int cmd,
+			     unsigned long arg)
+{
+	struct drm_file *file_priv = filp->private_data;
+	struct drm_device *dev;
+	unsigned int nr = _IOC_NR(cmd);
+	unsigned int usize = _IOC_SIZE(cmd);
+	char stack_kdata[128];
+	char *kdata = stack_kdata;
+	unsigned int asize;
+	long ret;
+
+	if (!file_priv)
+		return -EINVAL;
+	dev = file_priv->minor->dev;
+	if (!dev)
+		return -ENODEV;
+	if (drm_device_is_unplugged(dev))
+		return -ENODEV;
+	switch (nr) {
+	case P7580_SYNCOBJ_NR_CREATE:
+		asize = sizeof(struct p7580_syncobj_create);
+		break;
+	case P7580_SYNCOBJ_NR_DESTROY:
+		asize = sizeof(struct p7580_syncobj_destroy);
+		break;
+	case P7580_SYNCOBJ_NR_HANDLE_TO_FD:
+	case P7580_SYNCOBJ_NR_FD_TO_HANDLE:
+		asize = sizeof(struct p7580_syncobj_handle);
+		break;
+	case P7580_SYNCOBJ_NR_WAIT:
+		asize = sizeof(struct p7580_syncobj_wait);
+		break;
+	case P7580_SYNCOBJ_NR_RESET:
+	case P7580_SYNCOBJ_NR_SIGNAL:
+		asize = sizeof(struct p7580_syncobj_array);
+		break;
+	case P7580_DEBUG_READ_BO_NR:
+		asize = sizeof(struct p7580_debug_read_bo);
+		break;
+	default:
+		return drm_ioctl(filp, cmd, arg);
+	}
+	if (asize > sizeof(stack_kdata)) {
+		kdata = kmalloc(asize, GFP_KERNEL);
+		if (!kdata)
+			return -ENOMEM;
+	}
+	if (asize > usize)
+		memset(kdata + usize, 0, asize - usize);
+	if (cmd & IOC_IN) {
+		/* Truncate: copy at most asize (our struct); a longer
+		 * userspace struct (24 B HANDLE, 40 B WAIT) leaves its
+		 * tail in userspace, untouched. */
+		unsigned int cpin = usize < asize ? usize : asize;
+
+		if (copy_from_user(kdata, (void __user __force *)arg,
+				   cpin) != 0) {
+			ret = -EFAULT;
+			goto out;
+		}
+		if (cpin < asize)
+			memset(kdata + cpin, 0, asize - cpin);
+	} else {
+		memset(kdata, 0, asize);
+	}
+	ret = p7580_syncobj_dispatch(dev, kdata, file_priv, nr);
+	if (ret == -ENOENT)
+		ret = drm_ioctl(filp, cmd, arg);
+	else if ((cmd & IOC_OUT) && ret == 0) {
+		/* Cap the write-back at asize: never leak stack past our
+		 * struct into a longer userspace struct's tail. */
+		unsigned int cpout = usize < asize ? usize : asize;
+
+		if (copy_to_user((void __user __force *)arg, kdata,
+				 cpout) != 0)
+			ret = -EFAULT;
+	}
+out:
+	if (kdata != stack_kdata)
+		kfree(kdata);
+	return ret;
+}
+
+long panfrost_syncobj_ioctl(struct file *filp, unsigned int cmd,
+			    unsigned long arg)
+{
+	unsigned int nr = _IOC_NR(cmd);
+
+	/* Fast path: driver-private numbers never reach us with extra
+	 * work -- straight to the core. */
+	if ((nr >= DRM_COMMAND_BASE) && (nr < DRM_COMMAND_END))
+		return drm_ioctl(filp, cmd, arg);
+	return p7580_syncobj_do(filp, cmd, arg);
+}
+
+#ifdef CONFIG_COMPAT
+long panfrost_syncobj_compat_ioctl(struct file *filp, unsigned int cmd,
+				   unsigned long arg)
+{
+	/* Payload structs are width-clean (no pointers, only u32/__u64/
+	 * __s32); compat32 handling is identical. */
+	return panfrost_syncobj_ioctl(filp, cmd, arg);
+}
+#endif
