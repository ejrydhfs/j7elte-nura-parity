+++ b/drivers/gpu/drm/panfrost/panfrost7580_gem.h	2026-11-19 10:48:44.308252315 -0500
@@ -0,0 +1,176 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * panfrost_gem.h - GEM object model for the Mali-T720 panfrost port
+ * (Exynos 7580 / Nura 3.10.108, j7elte).
+ *
+ * v5.2 reference: drivers/gpu/drm/panfrost/panfrost_gem.{c,h} (96/30 LOC)
+ * against drm_gem_shmem_helper. This tree has NO shmem helper
+ * (gpu31-target.md D5: reuse the present 272-line drm_gem_cma_helper),
+ * so the port below is a clean-room CMA implementation with a private
+ * page-array shmem path. DrmCore's drm_compat_310.h only wires fops;
+ * it does NOT own BO structs or ioctl bodies (agreed split).
+ *
+ * BO model (mirrors v5.2 panfrost_gem_object layout adapted to 3.10):
+ *  - embedded struct drm_gem_object (handle + mmap-offset machinery);
+ *  - backing selector: CMA (dma_alloc_attrs, contiguous, scanout-safe)
+ *    or SHMEM (shmem file + per-page array, import/vmap friendly).
+ *    The selector is P7580_BO_* (private, never on the UAPI wire;
+ *    v5.2 UAPI has no BO flags and CREATE_BO.flags must stay zero).
+ *  - embedded struct dma_resv (0002 shim type; see p7580_bo.resv):
+ *    SUBMIT reserves it, WAIT_BO polls it; BO free path releases it.
+ *    The field is transparent here because the integrator applies the
+ *    0001/0002 backport series BEFORE this driver (series/0002), so
+ *    <linux/dma-resv.h> exists at driver build time. The KINC check in
+ *    the Makefile stages exactly those headers and fails loudly if
+ *    the layout ever drifts.
+ *  - IOVA node: per-BO struct drm_mm_node linked into the per-device
+ *    drm_mm (P7580_IOVA_START/SIZE window); GET_BO_OFFSET and the MMU
+ *    slice read bo->iova (nonzero guaranteed: v5.2 CREATE_BO UAPI
+ *    requires a nonzero offset and the T720 treats IOVA 0 as
+ *    unmapped). Carrying the node (not a bare start/size pair) lets
+ *    free return the range via drm_mm_remove_node; the mutex in
+ *    struct p7580_dev owns the allocator (3.10 drm_mm has no
+ *    per-mm lock of its own).
+ *
+ * Lifetime: CMA path uses drm_gem_object_init + dma_alloc_attrs
+ * (WRITE_COMBINE via dma_attrs, same as the display CMA delta);
+ * SHMEM path uses drm_gem_private_object_init + its own shmem file
+ * (same shmem_file_setup("drm mm object") pattern drm_gem_object_init
+ * uses) + shmem_read_mapping_page per page. PRIME import holds one
+ * dma_buf_get() ref (released in free). vmap pins with the core's own
+ * fault-grab reference (see vunmap): while any vmap is live the GEM
+ * refcount is held, so free cannot race the mapping (review F2 on the
+ * display PRIME patch); the vaddr counting lives in the core, sized by
+ * P7580_VMAP_MAX. No import-by-copy anywhere (review F1).
+ */
+#ifndef PANFROST7580_GEM_H
+#define PANFROST7580_GEM_H
+
+/* F-GEM1 (gpu31-driver-review): the BO embeds the real struct dma_resv
+ * from the 0002 backport header instead of an opaque pad + layout
+ * BUILD_BUG_ONs. The 0001/0002 series is a build prerequisite of this
+ * driver (series/0001-0002 applied first; Makefile KINC stages them),
+ * so the field tracks shim growth automatically. */
+#include <linux/dma-resv.h>
+#include <linux/types.h>
+#include <linux/mutex.h>
+#include <linux/scatterlist.h>
+
+struct device;
+
+#define P7580_BO_CMA		0u
+#define P7580_BO_SHMEM		1u
+
+/* IOVA window in BYTES: 32 MiB .. 4 GiB, T720 legacy 32-bit window
+ * (panfrost v5.2: PFN 0x8000..0x100000, see panfrost_mmu_map_io_region;
+ *  T720 VA bits unread until M0 runs on silicon, gpu-panfrost.md R3).
+ * Units: the drm_mm allocator counts PAGES, so p7580_dev_init passes
+ * these shifted by PAGE_SHIFT; node.start is a PFN and IOVA bytes are
+ * node.start << PAGE_SHIFT. Do NOT pass raw bytes to drm_mm_init. */
+#define P7580_IOVA_START	(32u << 20)
+#define P7580_IOVA_SIZE		((4ull << 30) - P7580_IOVA_START)
+
+/* CPU-cache attribute for the fault handler (matches exynos update flags). */
+#define P7580_GEM_WC		(1u << 0)
+#define P7580_GEM_CACHABLE	(1u << 1)
+
+/* Max concurrent vmaps per BO. The core pins each vmap with one GEM
+ * reference; the count lets vunmap know when the last mapping went
+ * away. 8 is plenty (importer + CPU writer + fault path + scanout). */
+#define P7580_VMAP_MAX		8u
+
+struct p7580_bo {
+	struct drm_gem_object base;
+	/* 0002 reservation object: SUBMIT locks it, WAIT_BO waits on
+	 * it, prime import shares it with the exporter. Real type
+	 * (linux/dma-resv.h) at build time; see file header. */
+	struct dma_resv resv;
+	/* IOVA allocation state: node linked into the per-device
+	 * drm_mm while valid (iova_valid), start cached for the
+	 * GET_BO_OFFSET fast path. */
+	struct drm_mm_node iova_node;
+	unsigned long iova;
+	int iova_valid;
+	unsigned int backing;
+	unsigned int cache_attr;
+	/* CMA backing. sg table is built on demand by
+	 * p7580_gem_prime_get_sg_table (never cached here). */
+	void *cma_vaddr;
+	dma_addr_t cma_paddr;
+	/* SHMEM backing. */
+	struct file *shmem_filp;
+	struct page **pages;
+	unsigned int nr_pages;
+	/* PRIME import state: set only on the importer. sgt is the live
+	 * exporter attachment mapping (unmapped + detached in free via
+	 * drm_prime_gem_destroy); the dma_buf ref is the get_dma_buf()
+	 * taken at import. Non-imported BOs leave both NULL. */
+	struct sg_table *sgt;
+	struct dma_buf *imported_dmabuf;
+	/* vmap pin: GEM references held while CPU mappings are live;
+	 * count mirrors them (p7580_gem_prime_vmap/vunmap). */
+	void *vaddrs[P7580_VMAP_MAX];
+	unsigned int vmap_count;
+};
+
+/* Per-device GEM state: IOVA allocator + the lock that serialises it
+ * (the driver allocates this in probe and stores it in dev_private;
+ * the GEM helpers below take it by pointer so they stay testable). */
+struct p7580_dev {
+	struct device *dev;
+	struct drm_mm iova_mm;
+	struct mutex iova_lock;
+};
+
+struct p7580_bo *to_p7580_bo(struct drm_gem_object *obj);
+
+int p7580_dev_init(struct p7580_dev *gd, struct device *dev);
+void p7580_dev_fini(struct p7580_dev *gd);
+
+int p7580_gem_create(struct p7580_dev *gd, struct drm_device *dev,
+		     size_t size, unsigned int backing,
+		     unsigned int cache_attr, struct drm_gem_object **out);
+int p7580_gem_create_with_handle(struct p7580_dev *gd,
+				 struct drm_file *file_priv,
+				 struct drm_device *dev, size_t size,
+				 unsigned int backing,
+				 unsigned int cache_attr,
+				 uint32_t *handle);
+void p7580_gem_free_object(struct drm_gem_object *obj);
+int p7580_gem_fault(struct vm_area_struct *vma, struct vm_fault *vmf);
+/* Published to the core as driver->gem_vm_ops (main.c); defined in
+ * panfrost7580_gem.c. Must stay non-NULL: drm_gem_mmap() -EINVALs when
+ * the driver table is NULL. */
+extern const struct vm_operations_struct p7580_gem_vm_ops;
+int p7580_gem_mmap(struct file *filp, struct vm_area_struct *vma);
+long p7580_gem_wait(struct drm_device *dev, struct drm_file *file_priv,
+		    uint32_t handle, long timeout_jiffies, int wait_all);
+
+/* GPU page-table mapping hook (for DriverAssemble / jobs SUBMIT).
+ * GEM allocates an IOVA per BO at create/import but never programs the
+ * Mali page tables itself. The owning driver maps BOs into the
+ * per-context tables with these helpers, then lets jobs SUBMIT pin each
+ * referenced BO (dma_resv lock discipline per the 0002 plain-mutex)
+ * before p7580_job_hw_submit reads the job descriptor. Unmap runs
+ * before free; the context teardown walker is p7580_mmu_teardown()
+ * (iommu/panfrost7580_mmu.h, F-MMU5), wired to file-close/remove.
+ *  - map: for each page 0..npages-1, p7580_mmu_map(mmu,
+ *    bo->iova + idx*PAGE_SIZE, phys, P7580_PROT_RD|WR, memattr), where
+ *    phys comes from p7580_bo_page_phys; then p7580_mmu_invalidate(regs,
+ *    as_nr, iova>>12, npages, sync=0) and p7580_mmu_program_as once
+ *    per context (iommu/panfrost7580_mmu.h, lock/encode in
+ *    mmu/pf7580_as.h). Unmap/invalidate per page before free. */
+unsigned int p7580_bo_npages(struct drm_gem_object *obj);
+phys_addr_t p7580_bo_page_phys(struct drm_gem_object *obj,
+			       unsigned int idx, int *ok);
+struct sg_table *p7580_gem_prime_get_sg_table(struct drm_gem_object *obj);
+struct drm_gem_object *p7580_gem_prime_import_sg_table(
+		struct drm_device *dev, size_t size, struct sg_table *sgt);
+void *p7580_gem_prime_vmap(struct drm_gem_object *obj);
+void p7580_gem_prime_vunmap(struct drm_gem_object *obj, void *vaddr);
+struct dma_buf *p7580_gem_prime_export(struct drm_device *dev,
+				       struct drm_gem_object *obj, int flags);
+struct drm_gem_object *p7580_gem_prime_import(struct drm_device *dev,
+					      struct dma_buf *dma_buf);
+
+#endif /* PANFROST7580_GEM_H */
diff -u '--exclude=.git' -Naur a/drivers/gpu/drm/panfrost/panfrost7580_ioctl.c b/drivers/gpu/drm/panfrost/panfrost7580_ioctl.c
--- a/drivers/gpu/drm/panfrost/panfrost7580_ioctl.c	1969-12-31 19:00:00.000000000 -0500
+++ b/drivers/gpu/drm/panfrost/panfrost7580_ioctl.c	2026-11-19 10:48:44.310309097 -0500
@@ -0,0 +1,288 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * panfrost7580_ioctl.c - six v5.2 ioctl handlers on the GEM core.
+ *
+ * Userspace contract (gpu31-target.md H1, byte-identical v5.2 UAPI):
+ * SUBMIT=0x00, WAIT_BO=0x01, CREATE_BO=0x02, MMAP_BO=0x03,
+ * GET_PARAM=0x04, GET_BO_OFFSET=0x05. GET_PARAM answers only
+ * DRM_PANFROST_PARAM_GPU_PROD_ID (upstream rejects the rest with
+ * -EINVAL; modern-Mesa probes of extra params are handled Mesa-side).
+ * CREATE_BO.flags is reserved-zero (reject nonzero, v5.2 has no flags).
+ *
+ * SUBMIT validates here and dispatches to the jobs slice
+ * (code/gpu31/jobs/panfrost7580_job.h: p7580_job_submit(), whose
+ * signature is mirrored below so this file -c compiles standalone).
+ * The jobs core resolves in-syncobjs (0003 find_fence), reserves the
+ * BO resvs (0002), submits to the sched entity (0004), and installs
+ * the out-sync fence (0003 replace_fence). User pointers (in_syncs,
+ * bo_handles) are copied in with copy_from_user into a stack-capped
+ * staging buffer (64 + 16 entries max); oversized counts are -EINVAL,
+ * short/failing copies are -EFAULT. No direct user dereference.
+ *
+ * File-private state (p7580_file_priv, header): per-fd 0003 syncobj
+ * manager (init on open, fini on postclose) + opaque jobs per-fd
+ * context (allocated by the jobs slice on first SUBMIT, freed by it
+ * on postclose). GEM owns neither the syncobj entries nor the sched
+ * entities; it only wires the lifetimes.
+ *
+ * SHIM-CALLSITES: 0002 (dma_resv wait via p7580_gem_wait), 0003
+ * (syncobj manager init/fini via driver_priv).
+ */
+
+#include <linux/device.h>
+#include <linux/dma-mapping.h>
+#include <linux/jiffies.h>
+#include <linux/mutex.h>
+#include <linux/slab.h>
+#include <linux/time.h>
+#include <linux/uaccess.h>
+
+#include <drm/drmP.h>
+#include <drm/drm.h>
+
+#include "drm_syncobj.h"		/* 0003 (staged by Makefile) */
+#include "panfrost7580_gem.h"
+#include "panfrost7580_ioctl.h"
+#include "panfrost_drm.h"
+
+/* Jobs-slice SUBMIT core (code/gpu31/jobs/panfrost7580_job.h shape,
+ * mirrored locally so this file -c compiles without the jobs tree).
+ * Canonical fields (jobs/panfrost7580_jm_hw.h struct p7580_submit):
+ * jc/in_syncs/in_sync_count/out_sync/bo_handles/bo_handle_count/
+ * requirements -- u64 user pointers staged to kernel arrays below. */
+struct p7580_job_dev;
+struct p7580_file_ctx;
+struct p7580_submit {
+	uint64_t jc;
+	uint64_t in_syncs;
+	uint32_t in_sync_count;
+	uint32_t out_sync;
+	uint64_t bo_handles;
+	uint32_t bo_handle_count;
+	uint32_t requirements;
+};
+int p7580_job_submit(struct p7580_job_dev *jd, struct p7580_file_ctx *fctx,
+		     const struct p7580_submit *args);
+
+/* DrmCore owns the manager storage; GEM only borrows it via driver_priv.
+ * job_fctx is owned by the jobs slice (opaque pointer here). */
+struct p7580_file_priv {
+	struct drm_syncobj_manager mgr;
+	struct p7580_file_ctx *job_fctx;
+	struct p7580_job_dev *job_dev;
+};
+
+int p7580_file_priv_init(struct drm_device *dev, struct drm_file *file_priv)
+{
+	struct p7580_file_priv *priv;
+
+	(void)dev;
+	priv = kzalloc(sizeof(*priv), GFP_KERNEL);
+	if (!priv)
+		return -ENOMEM;
+	drm_syncobj_manager_init(&priv->mgr);
+	file_priv->driver_priv = priv;
+	return 0;
+}
+
+void p7580_file_priv_fini(struct drm_device *dev, struct drm_file *file_priv)
+{
+	struct p7580_file_priv *priv = file_priv->driver_priv;
+
+	(void)dev;
+	if (!priv)
+		return;
+	/* Jobs context (sched entities) is freed by the jobs slice's
+	 * own postclose leg; GEM only drops the pointer here. */
+	priv->job_fctx = NULL;
+	priv->job_dev = NULL;
+	drm_syncobj_manager_fini(&priv->mgr);
+	file_priv->driver_priv = NULL;
+	kfree(priv);
+}
+
+/* T720 product ID (MIDGARD T720 = 0x720, same decode as kbase gpuprops). */
+#define P7580_GPU_PROD_ID		0x720u
+
+/* Caps mirrored from the jobs slice (p7580_submit limits): counts above
+ * these are -EINVAL before any copy_from_user runs. */
+#define P7580_SUBMIT_BO_MAX		64u
+#define P7580_SUBMIT_IN_SYNC_MAX	16u
+
+int panfrost_ioctl_get_param(struct drm_device *dev, void *data,
+			     struct drm_file *file_priv)
+{
+	struct drm_panfrost_get_param *args = data;
+
+	(void)dev;
+	(void)file_priv;
+	if (args->pad)
+		return -EINVAL;
+	if (args->param != DRM_PANFROST_PARAM_GPU_PROD_ID)
+		return -EINVAL;
+	args->value = P7580_GPU_PROD_ID;
+	args->pad = 0;
+	return 0;
+}
+
+int panfrost_ioctl_create_bo(struct drm_device *dev, void *data,
+			     struct drm_file *file_priv)
+{
+	struct drm_panfrost_create_bo *args = data;
+	struct p7580_dev *gd = dev->dev_private;
+	struct drm_gem_object *obj;
+	struct p7580_bo *bo;
+	uint32_t handle;
+	int ret;
+
+	if (args->flags)
+		return -EINVAL;
+	if (!args->size)
+		return -EINVAL;
+
+	/* SHMEM for general BOs (upstream panfrost uses drm_gem_shmem;
+	 * CMA carries no size beyond the display window and fails 8 MiB+
+	 * via dma_alloc_attrs -> swiotlb ENOMEM, blocking Mesa's 16 MiB
+	 * tiler heap. CMA stays available for explicit WC scanout only,
+	 * selected via p7580_gem_create_with_handle, never here). */
+	ret = p7580_gem_create(gd, dev, args->size, P7580_BO_SHMEM,
+			       P7580_GEM_WC, &obj);
+	if (ret)
+		return ret;
+	ret = drm_gem_handle_create(file_priv, obj, &handle);
+	if (ret) {
+		drm_gem_object_unreference_unlocked(obj);
+		return ret;
+	}
+	/* Handle holds the reference now. */
+	drm_gem_object_unreference_unlocked(obj);
+
+	bo = to_p7580_bo(obj);
+	args->handle = handle;
+	args->offset = (uint64_t)bo->iova;
+	return 0;
+}
+
+int panfrost_ioctl_mmap_bo(struct drm_device *dev, void *data,
+			   struct drm_file *file_priv)
+{
+	struct drm_panfrost_mmap_bo *args = data;
+	struct drm_gem_object *obj;
+	unsigned long fake_offset;
+
+	if (args->flags)
+		return -EINVAL;
+
+	/* drm_gem_object_lookup takes the reference internally (no
+	 * outer struct_mutex needed; lookup is idr + kref_get). */
+	obj = drm_gem_object_lookup(dev, file_priv, args->handle);
+	if (!obj)
+		return -ENOENT;
+	/* Same fake-offset encoding as drm_gem_cma_dumb_map_offset:
+	 * map_list.hash.key << PAGE_SHIFT (drm_gem_cma_helper.c). */
+	fake_offset = (unsigned long)obj->map_list.hash.key << PAGE_SHIFT;
+	drm_gem_object_unreference_unlocked(obj);
+
+	args->offset = (uint64_t)fake_offset;
+	return 0;
+}
+
+int panfrost_ioctl_get_bo_offset(struct drm_device *dev, void *data,
+				 struct drm_file *file_priv)
+{
+	struct drm_panfrost_get_bo_offset *args = data;
+	struct drm_gem_object *obj;
+	struct p7580_bo *bo;
+
+	if (args->pad)
+		return -EINVAL;
+
+	obj = drm_gem_object_lookup(dev, file_priv, args->handle);
+	if (!obj)
+		return -ENOENT;
+	bo = to_p7580_bo(obj);
+	args->offset = (uint64_t)bo->iova;
+	drm_gem_object_unreference_unlocked(obj);
+	return 0;
+}
+
+int panfrost_ioctl_wait_bo(struct drm_device *dev, void *data,
+			   struct drm_file *file_priv)
+{
+	struct drm_panfrost_wait_bo *args = data;
+	struct timespec now;
+	int64_t remain_ns;
+	long timeout;
+
+	if (args->pad)
+		return -EINVAL;
+	/* F-IO2: v5.2 timeout_ns is ABSOLUTE (CLOCK_MONOTONIC). Convert
+	 * to a relative jiffies budget via the monotonic clock; a past
+	 * or zero stamp stays non-blocking (0), matching the old
+	 * <= 0 arm. ktime_get_ts is the 3.10 spelling (no ktime_get_ns
+	 * export used in-tree on this kernel). */
+	ktime_get_ts(&now);
+	remain_ns = (int64_t)args->timeout_ns -
+		    ((int64_t)now.tv_sec * 1000000000LL + now.tv_nsec);
+	if (remain_ns <= 0)
+		timeout = 0;
+	else if ((uint64_t)remain_ns > (uint64_t)LONG_MAX)
+		timeout = LONG_MAX;
+	else
+		timeout = nsecs_to_jiffies((uint64_t)remain_ns);
+
+	timeout = p7580_gem_wait(dev, file_priv, args->handle, timeout, 1);
+	if (timeout < 0)
+		return (int)timeout;
+	return 0;
+}
+
+/* SUBMIT: validate-only in this slice is over -- full dispatch goes to
+ * the jobs core, with user arrays staged on the stack first. */
+int panfrost_ioctl_submit(struct drm_device *dev, void *data,
+			  struct drm_file *file_priv)
+{
+	struct drm_panfrost_submit *args = data;
+	struct p7580_file_priv *priv = file_priv->driver_priv;
+	uint32_t bo_handles[P7580_SUBMIT_BO_MAX];
+	uint32_t in_syncs[P7580_SUBMIT_IN_SYNC_MAX];
+	struct p7580_submit staged;
+
+	if (!args->jc || (args->jc & 7u))
+		return -EINVAL;
+	if (args->requirements & ~PANFROST_JD_REQ_FS)
+		return -EINVAL;
+	if (args->in_sync_count > P7580_SUBMIT_IN_SYNC_MAX ||
+	    args->bo_handle_count > P7580_SUBMIT_BO_MAX)
+		return -EINVAL;
+	if (!priv || !priv->job_dev || !priv->job_fctx)
+		return -ENODEV;
+
+	/* Stage user arrays locally; the jobs core never touches
+	 * userspace. in_syncs/bo_handles are u32 arrays (Mesa winsys
+	 * passes __u64 pointers to u32 storage). */
+	if (args->bo_handle_count) {
+		if (!args->bo_handles ||
+		    copy_from_user(bo_handles, (void __user *)(uintptr_t)
+				   args->bo_handles,
+				   args->bo_handle_count * sizeof(uint32_t)))
+			return -EFAULT;
+	}
+	if (args->in_sync_count) {
+		if (!args->in_syncs ||
+		    copy_from_user(in_syncs, (void __user *)(uintptr_t)
+				   args->in_syncs,
+				   args->in_sync_count * sizeof(uint32_t)))
+			return -EFAULT;
+	}
+
+	staged.jc = args->jc;
+	staged.in_syncs = (uint64_t)(uintptr_t)in_syncs;
+	staged.in_sync_count = args->in_sync_count;
+	staged.out_sync = args->out_sync;
+	staged.bo_handles = (uint64_t)(uintptr_t)bo_handles;
+	staged.bo_handle_count = args->bo_handle_count;
+	staged.requirements = args->requirements;
+
+	return p7580_job_submit(priv->job_dev, priv->job_fctx, &staged);
+}
diff -u '--exclude=.git' -Naur a/drivers/gpu/drm/panfrost/panfrost7580_ioctl.h b/drivers/gpu/drm/panfrost/panfrost7580_ioctl.h
--- a/drivers/gpu/drm/panfrost/panfrost7580_ioctl.h	1969-12-31 19:00:00.000000000 -0500
+++ b/drivers/gpu/drm/panfrost/panfrost7580_ioctl.h	2026-11-19 10:48:44.312487265 -0500
@@ -0,0 +1,45 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * panfrost7580_ioctl.h - v5.2 UAPI handler prototypes for the T720 port.
+ *
+ * v5.2 reference: panfrost_drv.c:329-340 ioctl table, handlers in
+ * panfrost_gem.c/panfrost_job.c/panfrost_device.c. The table itself
+ * (DRM_IOCTL_DEF rows, DRM_RENDER_ALLOW mapping) is owned by G31_DrmCore
+ * (panfrost_ioctls_310.h); this header declares the six handler bodies
+ * implemented in panfrost7580_ioctl.c so DrmCore can reference them.
+ * Prototypes use the 3.10 drm_ioctl_t signature
+ * (int fn(struct drm_device *, void *, struct drm_file *)).
+ *
+ * File-private state behind struct drm_file->driver_priv
+ * (p7580_file_priv): per-fd syncobj manager (0003 series header) + the
+ * jobs-slice per-fd context (opaque here; owned by the jobs slice).
+ * Allocated on first ioctl that needs it, freed in the driver's
+ * .postclose hook. The real struct drm_syncobj_manager comes from
+ * drivers/gpu/drm/drm_syncobj.h (staged by the Makefile's kcheck);
+ * this header needs only the pointer width, so it forward-declares
+ * and keeps -Wall clean.
+ */
+
+#ifndef PANFROST7580_IOCTL_H
+#define PANFROST7580_IOCTL_H
+
+struct drm_device;
+struct drm_file;
+
+int panfrost_ioctl_submit(struct drm_device *dev, void *data,
+			  struct drm_file *file_priv);
+int panfrost_ioctl_wait_bo(struct drm_device *dev, void *data,
+			   struct drm_file *file_priv);
+int panfrost_ioctl_create_bo(struct drm_device *dev, void *data,
+			     struct drm_file *file_priv);
+int panfrost_ioctl_mmap_bo(struct drm_device *dev, void *data,
+			   struct drm_file *file_priv);
+int panfrost_ioctl_get_param(struct drm_device *dev, void *data,
+			     struct drm_file *file_priv);
+int panfrost_ioctl_get_bo_offset(struct drm_device *dev, void *data,
+				 struct drm_file *file_priv);
+
+int p7580_file_priv_init(struct drm_device *dev, struct drm_file *file_priv);
+void p7580_file_priv_fini(struct drm_device *dev, struct drm_file *file_priv);
+
+#endif /* PANFROST7580_IOCTL_H */
diff -u '--exclude=.git' -Naur a/drivers/gpu/drm/panfrost/panfrost7580_jm_hw.h b/drivers/gpu/drm/panfrost/panfrost7580_jm_hw.h
--- a/drivers/gpu/drm/panfrost/panfrost7580_jm_hw.h	1969-12-31 19:00:00.000000000 -0500
+++ b/drivers/gpu/drm/panfrost/panfrost7580_jm_hw.h	2026-11-19 10:48:44.314844648 -0500
@@ -0,0 +1,244 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * panfrost7580_jm_hw.h - Midgard job-manager hardware interface for the
+ * T720 (Exynos 7580, j7elte) panfrost port. Pure-C (host-testable): only
+ * fixed-width types, no kernel or shim dependencies.
+ *
+ * Provenance (all values cross-checked, kbase == mainline panfrost):
+ *  [KT] Nura 3.10.108 drivers/gpu/arm/t7xx/r15p0/mali_midg_regmap.h
+ *  [ML] mainline v5.2 drivers/gpu/drm/panfrost/panfrost_regs.h
+ *  [KB] Nura 3.10.108 backend/gpu/mali_kbase_jm_hw.c (submit sequence)
+ *  [V5] mainline v5.2 drivers/gpu/drm/panfrost/panfrost_job.c (submit seq)
+ *
+ * T720 specifics baked in here (from KT hwconfig tables + live device):
+ *  - 3 job slots (gpu-verify: js_present 0x7; BASE_JM_MAX_NR_SLOTS 3)
+ *  - BASE_HW_FEATURE list for t72x has NO FLUSH_REDUCTION, NO
+ *    JOBCHAIN_DISAMBIGUATION, NO PROTECTED_MODE (features.h:72-84)
+ *  - BASE_HW_ISSUE list for t72x HAS 10649 (issues.h:566-581), so
+ *    JS_CONFIG_START_MMU is always set (same as [KB]:118 and [V5])
+ */
+#ifndef PANFROST7580_JM_HW_H
+#define PANFROST7580_JM_HW_H
+
+#ifdef __KERNEL__
+#include <linux/types.h>
+#else
+#include <stdint.h>
+#endif
+
+/* 3 slots on Midgard; T720 MP2 reports js_present == 0x7 (gpu-verify). */
+#define P7580_JM_MAX_SLOTS	3u
+
+/* ------------------------------------------------------------------ */
+/* Job control block. [KT] JOB_CONTROL_BASE 0x1000 (:199), JOB_SLOT0   */
+/* 0x800 (:210), stride 0x80 (JOB_SLOT_REG :227); [ML] JS_BASE 0x1800,  */
+/* JS_SLOT_STRIDE 0x80. Both give slot n base = 0x1800 + n*0x80.        */
+/* ------------------------------------------------------------------ */
+#define P7580_JOB_INT_RAWSTAT	0x1000u
+#define P7580_JOB_INT_CLEAR	0x1004u
+#define P7580_JOB_INT_MASK	0x1008u
+#define P7580_JOB_INT_STAT	0x100Cu
+
+#define P7580_JS_BASE		0x1800u
+#define P7580_JS_STRIDE		0x0080u
+
+/* Current (RO) view. */
+#define P7580_JS_HEAD_LO	0x00u
+#define P7580_JS_HEAD_HI	0x04u
+#define P7580_JS_TAIL_LO	0x08u
+#define P7580_JS_TAIL_HI	0x0Cu
+#define P7580_JS_COMMAND	0x20u
+#define P7580_JS_STATUS		0x24u
+
+/* NEXT (RW) view: what the driver programs before START. */
+#define P7580_JS_HEAD_NEXT_LO	0x40u
+#define P7580_JS_HEAD_NEXT_HI	0x44u
+#define P7580_JS_AFF_NEXT_LO	0x50u
+#define P7580_JS_AFF_NEXT_HI	0x54u
+#define P7580_JS_CONFIG_NEXT	0x58u
+#define P7580_JS_COMMAND_NEXT	0x60u
+#define P7580_JS_FLUSH_ID_NEXT	0x70u
+
+#define P7580_JS_REG(n, r) \
+	(P7580_JS_BASE + ((uint32_t)(n) * P7580_JS_STRIDE) + (r))
+
+/* IRQ demux. [ML] MK_JS_MASK / JOB_INT_MASK_{DONE,ERR}. */
+#define P7580_MK_JS_MASK(j)	(0x10001u << (j))
+#define P7580_JOB_DONE_BIT(j)	(1u << (j))
+#define P7580_JOB_ERR_BIT(j)	(1u << ((j) + 16))
+
+/* JS_COMMAND values. [KT]:385-392, [ML] identical. */
+#define P7580_JS_CMD_NOP	0x00u
+#define P7580_JS_CMD_START	0x01u
+#define P7580_JS_CMD_SOFT_STOP	0x02u
+#define P7580_JS_CMD_HARD_STOP	0x03u
+
+/* JS_CONFIG bits. [KT]:408-418, [ML] identical. */
+#define P7580_JS_CFG_START_FLUSH_CLEAN		(1u << 8)
+#define P7580_JS_CFG_START_FLUSH_CLEAN_INV	(3u << 8)
+#define P7580_JS_CFG_START_MMU			(1u << 10)
+#define P7580_JS_CFG_JOB_CHAIN_FLAG		(1u << 11)
+#define P7580_JS_CFG_END_FLUSH_CLEAN		(1u << 12)
+#define P7580_JS_CFG_END_FLUSH_CLEAN_INV	(3u << 12)
+#define P7580_JS_CFG_ENABLE_FLUSH_REDUCTION	(1u << 14)
+#define P7580_JS_CFG_DISABLE_DESC_WR_BK		(1u << 15)
+#define P7580_JS_CFG_THREAD_PRI(n)		((uint32_t)(n) << 16)
+
+/* GPU-level reset used by fault recovery. [KT]:452-460, [ML] GPU_CMD. */
+#define P7580_GPU_CMD			0x0030u
+#define P7580_GPU_CMD_SOFT_RESET	0x01u
+#define P7580_GPU_CMD_HARD_RESET	0x02u
+#define P7580_GPU_INT_RAWSTAT		0x0020u
+#define P7580_GPU_INT_CLEAR		0x0024u
+#define P7580_GPU_IRQ_RESET_COMPLETED	(1u << 8)
+
+/* ------------------------------------------------------------------ */
+/* Timeouts. SHIM-5S is the drm_sched shim's hardcoded dispatch        */
+/* timeout (0004 pump: msecs_to_jiffies(5000)); JOB_TIMEOUT_MS must     */
+/* stay in sync with it until the one-line wiring to sched->timeout    */
+/* lands (see jobs report). 3 s matches kbase's soft-job default       */
+/* (mali_kbase_config_defaults.h:185) and the reset default (:210).    */
+/* ------------------------------------------------------------------ */
+#define P7580_JOB_TIMEOUT_MS	5000u
+#define P7580_RESET_TIMEOUT_MS	3000u
+
+/* Slot for a submit. [V5] panfrost_job_get_slot: FS -> JS0, else JS1. */
+/* JS2 (compute) is wired but idle: v5.2 UAPI has no compute-only bit. */
+#define P7580_SLOT_FRAGMENT	0
+#define P7580_SLOT_VERTEX_TILER	1
+#define P7580_SLOT_COMPUTE	2
+
+/* Requirements bits (v5.2 UAPI, panfrost_drm.h). */
+#define P7580_JD_REQ_FS		(1u << 0)
+/* Kernel-internal routing only (never on the UAPI wire at v5.2). */
+#define P7580_JD_REQ_ONLY_COMPUTE	(1u << 10)
+
+static inline int p7580_job_slot(uint32_t requirements)
+{
+	if (requirements & P7580_JD_REQ_FS)
+		return P7580_SLOT_FRAGMENT;
+	if (requirements & P7580_JD_REQ_ONLY_COMPUTE)
+		return P7580_SLOT_COMPUTE;
+	return P7580_SLOT_VERTEX_TILER;
+}
+
+/*
+ * JS_CONFIG_NEXT value for one submit on this SoC.
+ *
+ * Mirrors [KB] kbase_job_hw_submit (:102-131) minus the features T720
+ * lacks: no FLUSH_REDUCTION, no PROTECTED_MODE write-back disable, no
+ * JOBCHAIN_DISAMBIGUATION toggle (not in base_hw_features_t72x), no
+ * SKIP_CACHE_* (v5.2 UAPI cannot express them). START_MMU is set
+ * because t72x carries BASE_HW_ISSUE_10649 ([KB]:117-118, [V5] too).
+ * as_nr occupies the low bits exactly as kbase lays it down (:102).
+ */
+static inline uint32_t p7580_js_config(uint32_t as_nr)
+{
+	return (as_nr & 0xFu) |
+		P7580_JS_CFG_START_FLUSH_CLEAN_INV |
+		P7580_JS_CFG_END_FLUSH_CLEAN_INV |
+		P7580_JS_CFG_START_MMU |
+		P7580_JS_CFG_THREAD_PRI(8);
+}
+
+/* ------------------------------------------------------------------ */
+/* JS_STATUS fault decode. [KT]:418-451.                               */
+/* ------------------------------------------------------------------ */
+struct p7580_js_fault {
+	uint32_t code;
+	const char *name;
+};
+
+static const struct p7580_js_fault p7580_js_faults[] = {
+	{ 0x02u, "INTERRUPTED" },
+	{ 0x03u, "STOPPED" },
+	{ 0x04u, "TERMINATED" },
+	{ 0x40u, "CONFIG_FAULT" },
+	{ 0x41u, "POWER_FAULT" },
+	{ 0x42u, "READ_FAULT" },
+	{ 0x43u, "WRITE_FAULT" },
+	{ 0x44u, "AFFINITY_FAULT" },
+	{ 0x48u, "BUS_FAULT" },
+	{ 0x50u, "INSTR_INVALID_PC" },
+	{ 0x51u, "INSTR_INVALID_ENC" },
+	{ 0x52u, "INSTR_TYPE_MISMATCH" },
+	{ 0x53u, "INSTR_OPERAND_FAULT" },
+	{ 0x54u, "INSTR_TLS_FAULT" },
+	{ 0x55u, "INSTR_BARRIER_FAULT" },
+	{ 0x56u, "INSTR_ALIGN_FAULT" },
+	{ 0x58u, "DATA_INVALID_FAULT" },
+	{ 0x59u, "TILE_RANGE_FAULT" },
+	{ 0x5Au, "ADDRESS_RANGE_FAULT" },
+	{ 0x60u, "OUT_OF_MEMORY" },
+	{ 0x7Fu, "UNKNOWN" },
+};
+
+static inline const char *p7580_js_status_name(uint32_t status)
+{
+	unsigned int i;
+
+	for (i = 0; i < sizeof(p7580_js_faults) /
+			sizeof(p7580_js_faults[0]); i++) {
+		if (p7580_js_faults[i].code == status)
+			return p7580_js_faults[i].name;
+	}
+	return (status < 0x40u) ? "NO_EXCEPTION" : "RESERVED_FAULT";
+}
+
+/* True for fault codes that mean the slot chain is dead and the       */
+/* resume/recovery path must run (vs benign STOPPED/TERMINATED).       */
+static inline int p7580_js_status_is_fault(uint32_t status)
+{
+	return status >= 0x40u;
+}
+
+/* ------------------------------------------------------------------ */
+/* Job descriptor header (what job->jc points at). [KT]                */
+/* mali_kbase_defs.h:1689-1712, "identical for all GPU archs". 32      */
+/* bytes: 4 + 4 + 8 + 2 (bitfield bytes) + 2 + 2 + 2 + 8.               */
+/* ------------------------------------------------------------------ */
+struct p7580_job_desc {
+	uint32_t exception_status;
+	uint32_t first_incomplete_task;
+	uint64_t fault_pointer;
+	uint8_t job_descriptor_size : 1;
+	uint8_t job_type : 7;
+	uint8_t job_barrier : 1;
+	uint8_t _reserved_01 : 1;
+	uint8_t _reserved_1 : 1;
+	uint8_t _reserved_02 : 1;
+	uint8_t _reserved_03 : 1;
+	uint8_t _reserved_2 : 1;
+	uint8_t _reserved_04 : 1;
+	uint8_t _reserved_05 : 1;
+	uint16_t job_index;
+	uint16_t job_dependency_index_1;
+	uint16_t job_dependency_index_2;
+	union {
+		uint64_t _64;
+		uint32_t _32;
+	} next_job;
+};
+
+/* v5.2 SUBMIT ioctl argument, layout kept byte-identical so stock     */
+/* Mesa panfrost_dri.so is the unmodified userspace (gpu31-target).    */
+struct p7580_submit {
+	uint64_t jc;
+	uint64_t in_syncs;
+	uint32_t in_sync_count;
+	uint32_t out_sync;
+	uint64_t bo_handles;
+	uint32_t bo_handle_count;
+	uint32_t requirements;
+};
+
+/* SUBMIT jc rule (v5.2: nonzero, 8-byte aligned GPU address). Shared by */
+/* the GEM validate stub and p7580_job_submit_args so the two can never  */
+/* disagree (F-JOB1: the jobs copy had the align test inverted). Pure-C  */
+/* so the host unit test exercises the exact kernel predicate.           */
+static inline int p7580_jc_valid(uint64_t jc)
+{
+	return jc != 0 && (jc & 7u) == 0;
+}
+
+#endif /* PANFROST7580_JM_HW_H */
diff -u '--exclude=.git' -Naur a/drivers/gpu/drm/panfrost/panfrost7580_job.c b/drivers/gpu/drm/panfrost/panfrost7580_job.c
--- a/drivers/gpu/drm/panfrost/panfrost7580_job.c	1969-12-31 19:00:00.000000000 -0500
+++ b/drivers/gpu/drm/panfrost/panfrost7580_job.c	2026-11-19 11:15:00.000000000 -0500
@@ -0,0 +1,704 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * panfrost7580_job.c - job slot management and SUBMIT path for the
+ * Mali-T720 MP2 (Exynos 7580, j7elte), Nura 3.10.108 panfrost port.
+ *
+ * Mirrors upstream v5.2 panfrost_job.c structure (slot select, hw
+ * submit, IRQ demux, timeout recovery) adapted to 3.10 + the T720:
+ *
+ *  v5.2 construct              | this port
+ *  ----------------------------+------------------------------------
+ *  NUM_JOB_SLOTS (features)    | P7580_NUM_JOB_SLOTS = 3 (js_present 0x7)
+ *  FLUSH_REDUCTION cfg/flush_id| dropped (not in t72x feature list)
+ *  JOBCHAIN_DISAMBIGUATION     | dropped (not in t72x feature list)
+ *  10649 START_MMU             | always set (t72x issue list HAS 10649)
+ *  pm_runtime get/put          | dropped (vendor pd-g3d notifier owns
+ *                              | power; M0 already resolves clocks)
+ *  devfreq record_transition   | hook point left for G31_Power (no-op here)
+ *  reservation_object (ww)     | backport dma_resv (plain mutex, 0002)
+ *  drm_syncobj (timeline)      | backport binary syncobj (0003)
+ *  drm_sched full ops          | backport FIFO shim ops (0004):
+ *                              | run_job/timedout_job/free_job only
+ *  resubmit_jobs/karma/stop    | dropped (shim has no stop/resubmit)
+ *                              | recovery restarts slots directly
+ *
+ * SHIM-CALLSITES: every call into the 0001-0004 shims below is marked
+ * with the patch number so G31_Sched/G31_DrmCore can re-verify them
+ * against the landed tree at integration.
+ * Locking: hw_lock (spinlock, IRQ-safe) serialises the HEAD/CONFIG/
+ * COMMAND sequence per slot and the in_flight[] slot assignment. The
+ * IRQ handler only touches in_flight/done_fence under that lock and
+ * never sleeps. timedout_job and p7580_job_recover run in process
+ * context (shim timeout workqueue): they take reset_lock, then
+ * hw_lock only for register pokes.
+ *
+ * Fences: each job owns exactly one ref (job->done_fence), created in
+ * p7580_job_run. job->render_done_fence is a non-owning alias of the
+ * same fence handed to the sched/out-sync paths; only done_fence is
+ * ever signaled or put. Fault recovery signals done_fence exactly
+ * once so waiters never hang (see p7580_job_recover).
+ */
+#include <linux/io.h>
+#include <linux/interrupt.h>
+#include <linux/spinlock.h>
+#include <linux/mutex.h>
+#include <linux/slab.h>
+#include <linux/jiffies.h>
+#include <linux/delay.h>
+#include <linux/log2.h>
+
+/* At integration these resolve to the landed backport files:
+ *  drivers/base/{dma-fence,dma-resv}.{c,h} (0001/0002) and
+ *  drivers/gpu/drm/{drm_syncobj,drm_sched}.{c,h} (0003/0004).
+ * The -I$(STAGE)/drivers/gpu/drm form below matches the staged dir. */
+#include <linux/dma-fence.h>		/* 0001 */
+#include <linux/dma-resv.h>		/* 0002 */
+#include <drm_syncobj.h>		/* 0003 */
+#include <drm_sched.h>			/* 0004 */
+
+#include "panfrost7580_job.h"
+
+/* ------------------------------------------------------------------ */
+/* Register access                                                    */
+/* ------------------------------------------------------------------ */
+
+static inline void p7580_writel(struct p7580_job_dev *jd, uint32_t reg,
+				uint32_t val)
+{
+	writel(val, jd->regs + reg);
+}
+
+static inline uint32_t p7580_readl(struct p7580_job_dev *jd, uint32_t reg)
+{
+	return readl(jd->regs + reg);
+}
+
+static inline void p7580_js_write(struct p7580_job_dev *jd, int slot,
+				  uint32_t off, uint32_t val)
+{
+	p7580_writel(jd, P7580_JS_REG(slot, off), val);
+}
+
+static inline uint32_t p7580_js_read(struct p7580_job_dev *jd, int slot,
+				     uint32_t off)
+{
+	return p7580_readl(jd, P7580_JS_REG(slot, off));
+}
+
+/* ------------------------------------------------------------------ */
+/* Job fence: one ordered context per slot, monotonic seqno.           */
+/* Mirrors v5.2 panfrost_fence_create (queue/emit_seqno/fence_context) */
+/* on top of the 0001 fence ops (enable_signaling/signaled/wait/      */
+/* release contract, release() calls dma_fence_release_base()).       */
+/* ------------------------------------------------------------------ */
+
+struct p7580_fence {
+	struct dma_fence base;
+	uint64_t seqno;
+	int slot;
+};
+
+static inline struct p7580_fence *to_p7580_fence(struct dma_fence *f)
+{
+	return container_of(f, struct p7580_fence, base);
+}
+
+static const char *p7580_fence_driver(struct dma_fence *f)
+{
+	(void)f;
+	return "panfrost7580";
+}
+
+static const char *p7580_fence_timeline(struct dma_fence *f)
+{
+	struct p7580_fence *pf = to_p7580_fence(f);
+
+	switch (pf->slot) {
+	case 0:
+		return "panfrost7580-js-0";
+	case 1:
+		return "panfrost7580-js-1";
+	case 2:
+		return "panfrost7580-js-2";
+	default:
+		return NULL;
+	}
+}
+
+static bool p7580_fence_enable_signaling(struct dma_fence *f)
+{
+	/* No SW-arm needed: HW IRQ is the signal source. Report "already
+	 * signaled during arming" only if the bit is already set, which
+	 * the 0001 add_callback re-checks. */
+	return dma_fence_is_signaled(f);
+}
+
+static bool p7580_fence_signaled(struct dma_fence *f)
+{
+	/* Bit test only; the IRQ sets the bit via dma_fence_signal(). */
+	return !!test_bit(DMA_FENCE_FLAG_SIGNALED_BIT, &f->flags);
+}
+
+static void p7580_fence_release(struct dma_fence *f)
+{
+	struct p7580_fence *pf = to_p7580_fence(f);
+
+	dma_fence_release_base(f);	/* 0001: frees waiter queue */
+	kfree(pf);
+}
+
+static const struct dma_fence_ops p7580_fence_ops = {
+	.get_driver_name = p7580_fence_driver,
+	.get_timeline_name = p7580_fence_timeline,
+	.enable_signaling = p7580_fence_enable_signaling,
+	.signaled = p7580_fence_signaled,
+	.wait = NULL,			/* 0001 default poll path */
+	.release = p7580_fence_release,
+};
+
+/* Caller must hold no locks; returns ERR_PTR on OOM. seqno_out is the
+ * per-slot emit counter owned by the sched slice (jd->emit_seqno). */
+static struct dma_fence *p7580_fence_create(struct p7580_job_dev *jd,
+					    int slot, uint64_t *seqno_out)
+{
+	struct p7580_fence *pf;
+
+	pf = kzalloc(sizeof(*pf), GFP_KERNEL);
+	if (!pf)
+		return ERR_PTR(-ENOMEM);
+
+	pf->slot = slot;
+	pf->seqno = ++(*seqno_out);
+
+	/* REVIEW-FIX (gpu31-review 0001 F1/F2): the landed 0001 has no
+	 * dma_fence_init and its struct keeps a dangling lock pointer;
+	 * until G31_Sched lands the F1/F2 fix, init the fields by hand
+	 * exactly as the fixed helper will: kref, completion, cb_list,
+	 * cb_lock, cleared flags, ops/context/seqno. Nothing here
+	 * dereferences fence->lock. */
+	kref_init(&pf->base.refcount);
+	init_completion(&pf->base.completion);
+	INIT_LIST_HEAD(&pf->base.cb_list);
+	spin_lock_init(&pf->base.cb_lock);
+	pf->base.flags = 0;
+	pf->base.ops = &p7580_fence_ops;
+	pf->base.context = jd->fence_ctx[slot];
+	pf->base.seqno = (unsigned)pf->seqno;
+	return &pf->base;
+}
+
+/* ------------------------------------------------------------------ */
+/* Device init/fini                                                   */
+/* ------------------------------------------------------------------ */
+
+int p7580_job_dev_init(struct p7580_job_dev *jd, void __iomem *regs,
+		       uint32_t js_present, uint64_t shader_present)
+{
+	int i;
+	uint32_t mask = 0;
+
+	if (!jd || !regs)
+		return -EINVAL;
+
+	jd->regs = regs;
+	jd->js_present = js_present;
+	jd->shader_present = shader_present;
+	spin_lock_init(&jd->hw_lock);
+	mutex_init(&jd->reset_lock);
+	for (i = 0; i < P7580_NUM_JOB_SLOTS; i++) {
+		jd->in_flight[i] = NULL;
+		mask |= P7580_MK_JS_MASK(i);
+	}
+
+	/* Clear any stale slot IRQs, then arm DONE+ERR for present slots. */
+	p7580_writel(jd, P7580_JOB_INT_CLEAR, mask);
+	p7580_writel(jd, P7580_JOB_INT_MASK, mask & (js_present | (js_present << 16)));
+	return 0;
+}
+
+void p7580_job_dev_fini(struct p7580_job_dev *jd)
+{
+	if (!jd)
+		return;
+	/* Mask everything; the IRQ handler is freed by the caller. */
+	p7580_writel(jd, P7580_JOB_INT_MASK, 0);
+}
+
+/* Idle when no slot has a queued command and no job is in flight. */
+int p7580_job_is_idle(struct p7580_job_dev *jd)
+{
+	int i;
+
+	if (!jd)
+		return 1;
+	for (i = 0; i < P7580_NUM_JOB_SLOTS; i++) {
+		if (p7580_js_read(jd, i, P7580_JS_COMMAND_NEXT))
+			return 0;
+		if (jd->in_flight[i])
+			return 0;
+	}
+	return 1;
+}
+
+/* ------------------------------------------------------------------ */
+/* HW submit: NEXT-view programming + START. Must be called with      */
+/* preemption-safe context; takes hw_lock internally. Mirrors [KB]    */
+/* kbase_job_hw_submit and [V5] panfrost_job_hw_submit with the T720  */
+/* cfg from p7580_js_config() (no FLUSH_REDUCTION / no flush_id).     */
+/* ------------------------------------------------------------------ */
+
+void p7580_job_hw_submit(struct p7580_job_dev *jd,
+			 struct p7580_submit_job *job)
+{
+	unsigned long flags;
+	uint32_t cfg;
+	int slot = job->slot;
+	uint32_t lo = (uint32_t)(job->jc & 0xFFFFFFFFu);
+	uint32_t hi = (uint32_t)(job->jc >> 32);
+
+	/* COMMAND_NEXT must be free: a stuck slot means recovery, not a
+	 * second submit on top. */
+	if (WARN_ON(p7580_js_read(jd, slot, P7580_JS_COMMAND_NEXT)))
+		return;
+
+	spin_lock_irqsave(&jd->hw_lock, flags);
+
+	p7580_js_write(jd, slot, P7580_JS_HEAD_NEXT_LO, lo);
+	p7580_js_write(jd, slot, P7580_JS_HEAD_NEXT_HI, hi);
+
+	p7580_js_write(jd, slot, P7580_JS_AFF_NEXT_LO,
+		       (uint32_t)(job->affinity & 0xFFFFFFFFu));
+	p7580_js_write(jd, slot, P7580_JS_AFF_NEXT_HI,
+		       (uint32_t)(job->affinity >> 32));
+
+	cfg = p7580_js_config(job->as_nr);
+	p7580_js_write(jd, slot, P7580_JS_CONFIG_NEXT, cfg);
+
+	jd->in_flight[slot] = job;
+
+	/* GO. */
+	p7580_js_write(jd, slot, P7580_JS_COMMAND_NEXT, P7580_JS_CMD_START);
+
+	spin_unlock_irqrestore(&jd->hw_lock, flags);
+}
+
+/* ------------------------------------------------------------------ */
+/* IRQ handler: demux JOB_INT_STAT per slot. IRQ context: no sleeps,  */
+/* no mutexes, only spinlock + fence signal + JOB_INT_CLEAR.          */
+/*                                                                    */
+/* DONE(j): signal job->done_fence (wakes sched retirement + any     */
+/*   WAIT_BO waiters); clear in_flight under hw_lock.                 */
+/* ERR(j): leave COMMAND_NEXT programmed; the timeout/recovery path  */
+/*   (process context) reads STATUS/HEAD/TAIL and resets. Here just   */
+/*   CLEAR the sticky bit so the line deasserts.                      */
+/* ------------------------------------------------------------------ */
+
+int p7580_job_irq(int irq, struct p7580_job_dev *jd)
+{
+	uint32_t status;
+	int j;
+
+	(void)irq;
+	if (!jd)
+		return 0;	/* IRQ_NONE; int kept for request_irq shape */
+
+	status = p7580_readl(jd, P7580_JOB_INT_STAT);
+	if (!status)
+		return 0;	/* IRQ_NONE */
+
+	for (j = 0; j < P7580_NUM_JOB_SLOTS; j++) {
+		uint32_t m = P7580_MK_JS_MASK(j);
+
+		if (!(status & m))
+			continue;
+
+		p7580_writel(jd, P7580_JOB_INT_CLEAR, m);
+
+		if (status & P7580_JOB_ERR_BIT(j)) {
+			/* Fault path: record only; recovery runs in
+			 * process context (timedout_job). */
+			p7580_js_write(jd, j, P7580_JS_COMMAND_NEXT,
+				       P7580_JS_CMD_NOP);
+		}
+
+		if (status & P7580_JOB_DONE_BIT(j)) {
+			struct p7580_submit_job *job;
+			unsigned long flags;
+
+			spin_lock_irqsave(&jd->hw_lock, flags);
+			job = jd->in_flight[j];
+			jd->in_flight[j] = NULL;
+			spin_unlock_irqrestore(&jd->hw_lock, flags);
+
+			if (job && job->done_fence)
+				dma_fence_signal((struct dma_fence *)job->done_fence); /* 0001 */
+		}
+		status &= ~m;
+	}
+	return 1;	/* IRQ_HANDLED */
+}
+
+/* ------------------------------------------------------------------ */
+/* Scheduler backend (0004 ops: run_job / timedout_job / free_job).   */
+/* The 0004 shim also supports add_dependency via fence callbacks;    */
+/* in_sync + implicit BO fences are attached as shim dependencies by  */
+/* the SUBMIT path before drm_sched_job_submit().                    */
+/* ------------------------------------------------------------------ */
+
+void *p7580_job_run(struct p7580_job_dev *jd, struct p7580_submit_job *job)
+{
+	struct dma_fence *fence;
+
+	fence = p7580_fence_create(jd, job->slot, &jd->emit_seqno[job->slot]);
+	if (IS_ERR(fence))
+		return fence;
+
+	/* One ref per job, owned by done_fence. render_done_fence is a
+	 * non-owning alias (F-JOB3: never put a second time). Dropping a
+	 * stale previous fence here keeps submit_args (which starts with
+	 * NULL fences) and re-run paths under the same rule. */
+	if (job->done_fence && job->done_fence != fence)
+		dma_fence_put((struct dma_fence *)job->done_fence); /* 0001 */
+	dma_fence_get(fence);			/* 0001: void, NULL-safe */
+	job->done_fence = fence;
+
+	p7580_job_hw_submit(jd, job);
+	/* Non-owning alias: consumers (sched/out-sync) must take their
+	 * own ref (e.g. syncobj replace takes one). */
+	job->render_done_fence = fence;
+	return fence;
+}
+
+void p7580_job_free(struct p7580_submit_job *job)
+{
+	uint32_t i;
+
+	if (!job)
+		return;
+	if (job->in_fences) {
+		for (i = 0; i < job->in_fence_count; i++)
+			dma_fence_put((struct dma_fence *)job->in_fences[i]); /* 0001 */
+		kfree(job->in_fences);
+	}
+	/* done_fence owns the single run_job ref; render_done_fence is
+	 * only an alias (F-JOB3), so clear it without putting. */
+	job->render_done_fence = NULL;
+	if (job->done_fence) {
+		dma_fence_put((struct dma_fence *)job->done_fence); /* 0001 */
+		job->done_fence = NULL;
+	}
+	kfree(job->bo_handles);
+	kfree(job);
+}
+/*
+ * Timeout: the per-job delayed_work in the 0004 shim fires when the
+ * done_fence has not signaled within P7580_JOB_TIMEOUT_MS of dispatch.
+ * Runs in process context (workqueue), so it may sleep for reset.
+ * Spurious if the IRQ just signaled -> bail out.
+ *
+ * SUBMIT-DEADLOCK FIX: after recovery, signal this job's own fence if
+ * it is still pending. Recovery latches jd->in_flight[slot], which may
+ * be a *different* (newer) job than the one that timed out -- e.g. the
+ * stuck slot swallowed a START (hw_submit WARN_ON bail leaves the new
+ * fence unsignaled and the job out of flight). Without this, that fence
+ * never signals: no second timeout re-arms it and its finish_cb never
+ * fires. The signal is bounded (one timeout period + one recovery) and
+ * idempotent (guarded by is_signaled, same F-JOB4 precedent); the 0001
+ * fence carries no error state, so a plain signal marks completion and
+ * the fault status stays in the kernel log for the Mesa retry decision.
+ */
+void p7580_job_timedout(struct p7580_job_dev *jd,
+			struct p7580_submit_job *job)
+{
+	struct dma_fence *f = (struct dma_fence *)job->done_fence;
+	uint32_t status;
+	int slot = job->slot;
+
+	if (f && dma_fence_is_signaled(f)) /* 0001 */
+		return;
+
+	status = p7580_js_read(jd, slot, P7580_JS_STATUS);
+	p7580_job_recover(jd, slot, status);
+
+	/* Bounded-completion guarantee: recovery signals the job latched in
+	 * in_flight[slot], which may differ from this timed-out job (see
+	 * above). If ours is still pending, signal it here so its
+	 * finish_cb/syncobj/WAIT_BO waiters wake within one timeout plus
+	 * one recovery instead of hanging forever. Idempotent: the IRQ or
+	 * a concurrent recover may have signaled it first. */
+	f = (struct dma_fence *)job->done_fence;
+	if (f && !dma_fence_is_signaled(f)) /* 0001 */
+		dma_fence_signal(f); /* 0001 */
+}
+/* ------------------------------------------------------------------ */
+/* SUBMIT ioctl body. Steps (mirrors v5.2 panfrost_job_push, adapted  */
+/* to the 0002/0003/0004 shims):                                       */
+/*  1. validate jc/requirements/handles (8-byte jc align, slot legal) */
+/*  2. resolve in_sync handles -> fences (0003 find_fence)            */
+/*  3. attach fences as sched dependencies (0004 add_dependency)      */
+/*  4. reserve BOs, attach excl fence on completion (0002)            */
+/*  5. submit to per-slot entity (0004 job_alloc/submit)              */
+/*  6. install out_sync fence (0003 replace_fence)                    */
+/*                                                                    */
+/* BO lookup / resv lock / syncobj table live in the GEM + DrmCore    */
+/* slices; this file takes them as callbacks so -c compiles standalone.*/
+/* ------------------------------------------------------------------ */
+
+struct p7580_submit_ctx {
+	/* GEM slice: handle -> (resv + vm mapping). */
+	int (*bo_reserve)(void *priv, uint32_t handle, void **resv);
+	void *priv;
+	/* DrmCore slice: syncobj handle -> fence. */
+	struct dma_fence *(*sync_find)(void *priv, uint32_t handle);
+	int (*sync_replace)(void *priv, uint32_t handle,
+			    struct dma_fence *fence);
+	void *sync_priv;
+	/* Sched slice: alloc + add_dependency + submit on slot entity. */
+	int (*sched_submit)(void *priv, int slot,
+			    struct p7580_submit_job *job);
+	void *sched_priv;
+	/* MMU slice: validate that jc is mapped for as_nr. */
+	int (*jc_validate)(void *priv, uint64_t jc, uint32_t as_nr);
+	void *mm_priv;
+};
+
+int p7580_job_submit_args(struct p7580_job_dev *jd, struct p7580_file_ctx *fc,
+			  const struct p7580_submit *args,
+			  struct p7580_submit_ctx *ops)
+{
+	struct p7580_submit_job *job;
+	uint32_t i;
+	int slot, ret;
+
+	if (!jd || !fc || !args || !ops)
+		return -EINVAL;
+
+	/* 1. validate (F-JOB1: single shared predicate; jc must be
+	 * nonzero and 8-byte aligned). */
+	if (!p7580_jc_valid(args->jc))
+		return -EINVAL;
+	if (args->requirements & ~(P7580_JD_REQ_FS |
+				   P7580_JD_REQ_ONLY_COMPUTE))
+		return -EINVAL;
+	if (args->in_sync_count > P7580_MAX_IN_SYNCS)
+		return -EINVAL;
+	if (args->bo_handle_count > P7580_MAX_SUBMIT_BOS)
+		return -EINVAL;
+
+	slot = p7580_job_slot(args->requirements);
+	if (slot < 0 || slot >= P7580_NUM_JOB_SLOTS)
+		return -EINVAL;
+	if (!(jd->js_present & (1u << slot)))
+		return -ENODEV;
+
+	job = kzalloc(sizeof(*job), GFP_KERNEL);
+	if (!job)
+		return -ENOMEM;
+
+	job->seqno = fc->next_seqno++;
+	job->slot = slot;
+	job->jc = args->jc;
+	job->requirements = args->requirements;
+	job->as_nr = 0;	/* single address space; Mmu slice owns numbering */
+	job->affinity = jd->shader_present;
+
+	/* MMU slice validates the descriptor address before HW sees it. */
+	if (ops->jc_validate) {
+		ret = ops->jc_validate(ops->mm_priv, job->jc, job->as_nr);
+		if (ret) {
+			kfree(job);
+			return ret;
+		}
+	}
+
+	/* 2. explicit in-fences. The ioctl layer stages plain u32 arrays
+	 * into kernel memory first (copy_from_user there); by the time
+	 * this runs, args->in_syncs points at kernel memory local to the
+	 * caller, so plain indexed loads apply and no __user dereference
+	 * happens here (F-JOB2). */
+	if (args->in_sync_count) {
+		const uint32_t *hs =
+			(const uint32_t *)(uintptr_t)args->in_syncs;
+
+		job->in_fences = kcalloc(args->in_sync_count,
+					 sizeof(*job->in_fences), GFP_KERNEL);
+		if (!job->in_fences) {
+			kfree(job);
+			return -ENOMEM;
+		}
+		for (i = 0; i < args->in_sync_count; i++) {
+			struct dma_fence *f;
+
+			if (!ops->sync_find) {
+				ret = -ENOSYS;
+				goto err;
+			}
+			f = ops->sync_find(ops->sync_priv, hs[i]);
+			if (!f) {
+				ret = -ENOENT;
+				goto err;
+			}
+			job->in_fences[job->in_fence_count++] = f;
+		}
+	}
+
+	/* 3-5. BO reserve + sched submit (delegated to GEM/Sched; the    */
+	/* dependency/fence wiring contract is asserted by the host unit */
+	/* test in job_test.c). */
+	if (args->bo_handle_count) {
+		const uint32_t *uh =
+			(const uint32_t *)(uintptr_t)args->bo_handles;
+
+		job->bo_handles = kcalloc(args->bo_handle_count,
+					  sizeof(*job->bo_handles),
+					  GFP_KERNEL);
+		if (!job->bo_handles) {
+			ret = -ENOMEM;
+			goto err;
+		}
+		/* Plain copy: already kernel memory staged by the ioctl
+		 * layer (F-JOB2); no userspace access here. */
+		for (i = 0; i < args->bo_handle_count; i++)
+			job->bo_handles[i] = uh[i];
+		job->bo_count = args->bo_handle_count;
+		if (ops->bo_reserve) {
+			for (i = 0; i < job->bo_count; i++) {
+				void *resv;
+				ret = ops->bo_reserve(ops->priv,
+						      job->bo_handles[i],
+						      &resv);
+				if (ret)
+					goto err;
+			}
+		}
+	}
+
+	if (!ops->sched_submit) {
+		ret = -ENOSYS;
+		goto err;
+	}
+	ret = ops->sched_submit(ops->sched_priv, slot, job);
+	if (ret)
+		goto err;
+
+	/* 6. out-sync. */
+	if (args->out_sync && ops->sync_replace) {
+		/* Alias is fine: replace takes its own ref on the fence. */
+		ret = ops->sync_replace(ops->sync_priv, args->out_sync,
+					(struct dma_fence *)job->render_done_fence);
+		if (ret)
+			goto err;
+	}
+
+	return 0;
+
+err:
+	p7580_job_free(job);
+	return ret;
+}
+/* Legacy name kept for the report/ioctl table. */
+int p7580_job_submit(struct p7580_job_dev *jd, struct p7580_file_ctx *fctx,
+		     const struct p7580_submit *args)
+{
+	(void)jd;
+	(void)fctx;
+	(void)args;
+	return -ENOSYS;	/* needs GEM/Sched/MMU callbacks: use submit_args */
+}
+
+/* ------------------------------------------------------------------ */
+/* Fault recovery, process context ONLY (never the IRQ handler).       */
+/* Serialises concurrent slot faults with reset_lock. The faulting    */
+/* job's done_fence is signaled exactly once here (F-JOB4): the IRQ    */
+/* path signals only DONE fences, so a faulted job would otherwise     */
+/* hang its WAIT_BO/sched-retirement waiters until the sched timeout   */
+/* re-entered recovery and still never signaled. dma_fence_signal is   */
+/* idempotent (second call returns -EINVAL), and the is_signaled      */
+/* check skips a job that completed between the fault latch and        */
+/* reset_lock. The 0001 fence carries no error state, so a plain      */
+/* signal marks completion; the fault status stays in the kernel log   */
+/* path for the retry decision (Mesa re-submits the batch).           */
+/* ------------------------------------------------------------------ */
+
+int p7580_job_recover(struct p7580_job_dev *jd, int fault_slot,
+		      uint32_t status)
+{
+	uint32_t raw;
+	int i, ret = 0;
+	unsigned long end;
+	struct p7580_submit_job *fault_job = NULL;
+
+	if (!jd || fault_slot < 0 || fault_slot >= P7580_NUM_JOB_SLOTS)
+		return -EINVAL;
+
+	mutex_lock(&jd->reset_lock);
+	/* Latch the faulting in-flight job under hw_lock while the slot  */
+	/* is stopped: afterwards the IRQ cannot complete it into a late */
+	/* DONE signal, and a concurrent timedout_job for the same slot  */
+	/* serialises on reset_lock, so the signal below fires once. */
+	spin_lock_irq(&jd->hw_lock);
+	fault_job = jd->in_flight[fault_slot];
+	/* 1. stop the faulting slot. MULTIPLE_FAULT (GPU IRQ bit 7) is  */
+	/* read by the caller from GPU_INT_STAT; here every present slot */
+	/* that still shows a pending command is hard-stopped too. */
+	p7580_js_write(jd, fault_slot, P7580_JS_COMMAND_NEXT,
+		       P7580_JS_CMD_HARD_STOP);
+	for (i = 0; i < P7580_NUM_JOB_SLOTS; i++) {
+		if (i != fault_slot &&
+		    p7580_js_read(jd, i, P7580_JS_COMMAND_NEXT))
+			p7580_js_write(jd, i, P7580_JS_COMMAND_NEXT,
+				       P7580_JS_CMD_HARD_STOP);
+	}
+	/* Out of flight: a late DONE bit cannot signal the same fence. */
+	jd->in_flight[fault_slot] = NULL;
+	spin_unlock_irq(&jd->hw_lock);
+
+	/* 2. wait for slots to drain (sleep: workqueue context). */
+	end = jiffies + msecs_to_jiffies(P7580_RESET_TIMEOUT_MS);
+	for (i = 0; i < P7580_NUM_JOB_SLOTS; i++) {
+		while (p7580_js_read(jd, i, P7580_JS_COMMAND_NEXT)) {
+			if (time_after(jiffies, end)) {
+				ret = -ETIMEDOUT;
+				break;
+			}
+			msleep(1);
+		}
+	}
+
+	/* 3. GPU reset. Prefer SOFT; HARD if RAWSTAT never completes. */
+	p7580_writel(jd, P7580_GPU_CMD, P7580_GPU_CMD_SOFT_RESET);
+	end = jiffies + msecs_to_jiffies(P7580_RESET_TIMEOUT_MS);
+	while (!(p7580_readl(jd, P7580_GPU_INT_RAWSTAT) &
+		 P7580_GPU_IRQ_RESET_COMPLETED)) {
+		if (time_after(jiffies, end)) {
+			p7580_writel(jd, P7580_GPU_CMD,
+				     P7580_GPU_CMD_HARD_RESET);
+			break;
+		}
+		msleep(1);
+	}
+	p7580_writel(jd, P7580_GPU_INT_CLEAR, P7580_GPU_IRQ_RESET_COMPLETED);
+
+	/* 4. re-arm the slot IRQs the handler demuxes. The MMU slice   */
+	/* re-programs AS_TRANSTAB before this returns (integrator      */
+	/* wires the call between reset and re-arm). */
+	raw = 0;
+	for (i = 0; i < P7580_NUM_JOB_SLOTS; i++)
+		raw |= P7580_MK_JS_MASK(i);
+	p7580_writel(jd, P7580_JOB_INT_CLEAR, raw);
+	p7580_writel(jd, P7580_JOB_INT_MASK,
+		     raw & (jd->js_present | (jd->js_present << 16)));
+
+	mutex_unlock(&jd->reset_lock);
+
+	/* 5. fault accounting (F-JOB4): signal exactly once so waiters  */
+	/* do not hang. Skip an already-signaled fence: the IRQ won the */
+	/* race and the job completed. */
+	if (fault_job && fault_job->done_fence &&
+	    !dma_fence_is_signaled( /* 0001 */
+		    (struct dma_fence *)fault_job->done_fence))
+		dma_fence_signal( /* 0001 */
+			(struct dma_fence *)fault_job->done_fence);
+	(void)status;
+	return ret;
+}
diff -u '--exclude=.git' -Naur a/drivers/gpu/drm/panfrost/panfrost7580_job.h b/drivers/gpu/drm/panfrost/panfrost7580_job.h
--- a/drivers/gpu/drm/panfrost/panfrost7580_job.h	1969-12-31 19:00:00.000000000 -0500
+++ b/drivers/gpu/drm/panfrost/panfrost7580_job.h	2026-11-19 10:48:44.319089866 -0500
@@ -0,0 +1,138 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * panfrost7580_job.h - submit-path state for the T720 panfrost port.
+ *
+ * Submitter: one open-file context owns one drm_sched_entity per job
+ * slot (NUM_JOB_SLOTS == P7580_JM_MAX_SLOTS == 3); one sched_job per
+ * SUBMIT ioctl batch; run_job programs the slot and returns the
+ * in-flight fence; JOB_INT IRQ completion signals it; timedout_job
+ * runs the slot reset + GPU resume path.
+ *
+ * The in-tree build (with __KERNEL__) sees real lock types; the host
+ * unit test (__KERNEL__ unset) sees opaque placeholders so jm_hw.h
+ * stays pure-C.
+ */
+#ifdef __KERNEL__
+#include <linux/io.h>
+#else
+#define __iomem
+#include <stdint.h>
+#endif
+
+#ifndef PANFROST7580_JOB_H
+#define PANFROST7580_JOB_H
+
+#include "panfrost7580_jm_hw.h"
+
+#ifdef __KERNEL__
+#include <linux/types.h>
+#include <linux/spinlock.h>
+#include <linux/mutex.h>
+#endif
+
+/* ------------------------------------------------------------------ */
+/* Driver topology                                                    */
+/* ------------------------------------------------------------------ */
+#define P7580_NUM_JOB_SLOTS	P7580_JM_MAX_SLOTS
+#define P7580_MAX_IN_SYNCS	16u	/* cap on SUBMIT in_sync_count */
+#define P7580_MAX_SUBMIT_BOS	64u	/* cap on SUBMIT bo_handle_count */
+
+/* Per-submit job: mirrors v5.2 struct panfrost_job (panfrost_job.h). */
+struct p7580_submit_job {
+	/* Atom identity for logs/dumps: SUBMIT order per file context. */
+	uint32_t seqno;
+
+	/* Routing + HW program. */
+	int slot;			/* 0..2, from requirements */
+	uint64_t jc;			/* GPU address of job descriptor */
+	uint32_t requirements;		/* PANFROST_JD_REQ_* */
+	uint32_t as_nr;			/* address space bound to slot */
+	uint64_t affinity;		/* shader-present mask */
+	uint32_t flush_id;		/* recorded, unused (no FLUSH_REDUCTION) */
+
+	/* Fences. done_fence owns the run_job ref and is signaled by the
+	 * JOB_INT handler (or the fault-recovery path, F-JOB4);
+	 * render_done_fence is a non-owning alias of the same fence
+	 * handed to out_sync/sched (F-JOB3: never put twice).
+	 * in_fences are explicit SUBMIT deps (owned here). */
+	void *done_fence;
+	void *render_done_fence;
+	void **in_fences;
+	uint32_t in_fence_count;
+
+	/* BO reservation set (file-private handles + resv pointers). */
+	uint32_t *bo_handles;
+	uint32_t bo_count;
+};
+
+/* Per-file submit context: one sched entity per slot. */
+struct p7580_file_ctx {
+	uint32_t next_seqno;
+	void *sched_entity[P7580_NUM_JOB_SLOTS];
+	void *syncobj_mgr;		/* backport drm_syncobj_manager */
+};
+
+#ifdef __KERNEL__
+struct p7580_job_dev {
+	void __iomem *regs;
+	uint32_t js_present;		/* from GPU_JS_PRESENT @probe */
+	uint64_t shader_present;	/* affinity source */
+	struct p7580_submit_job *in_flight[P7580_NUM_JOB_SLOTS];
+	spinlock_t hw_lock;		/* serialises HEAD/CONFIG/COMMAND */
+	struct mutex reset_lock;	/* serialises fault recovery */
+	unsigned int fence_ctx[P7580_NUM_JOB_SLOTS];
+	uint64_t emit_seqno[P7580_NUM_JOB_SLOTS];
+};
+#else
+struct p7580_job_dev {
+	void *regs;
+	uint32_t js_present;
+	uint64_t shader_present;
+	struct p7580_submit_job *in_flight[P7580_NUM_JOB_SLOTS];
+	void *hw_lock;
+	void *reset_lock;
+	void *sched[P7580_NUM_JOB_SLOTS];
+	void *fence_ctx;
+};
+#endif
+
+/* ------------------------------------------------------------------ */
+/* Entry points implemented in panfrost7580_job.c (in-tree names in    */
+/* comments so the integrator can map them to drm_driver hooks).       */
+/* ------------------------------------------------------------------ */
+#ifdef __KERNEL__
+int p7580_job_dev_init(struct p7580_job_dev *jd, void __iomem *regs,
+		       uint32_t js_present, uint64_t shader_present);
+#else
+int p7580_job_dev_init(struct p7580_job_dev *jd, void *regs,
+		       uint32_t js_present, uint64_t shader_present);
+#endif
+/* Program HEAD_NEXT/AFFINITY_NEXT/CONFIG_NEXT + COMMAND_NEXT=START.   */
+void p7580_job_hw_submit(struct p7580_job_dev *jd,
+			 struct p7580_submit_job *job);
+/* JOB_INT handler: demux DONE/ERR per slot (IRQ context). */
+int p7580_job_irq(int irq, struct p7580_job_dev *jd);
+
+/* Scheduler backend: run_job / timedout_job / free_job. */
+void *p7580_job_run(struct p7580_job_dev *jd,
+		    struct p7580_submit_job *job);
+void p7580_job_timedout(struct p7580_job_dev *jd,
+			struct p7580_submit_job *job);
+void p7580_job_free(struct p7580_submit_job *job);
+
+/* SUBMIT ioctl body: validate -> resolve syncobj deps -> reserve BOs  */
+/* -> sched submit -> install out-sync fence. args->in_syncs/bo_handles */
+/* must point at KERNEL-staged u32 arrays (the ioctl layer copies with  */
+/* copy_from_user first); this function never touches userspace         */
+/* (F-JOB2: do not pass __user pointers here). */
+int p7580_job_submit(struct p7580_job_dev *jd, struct p7580_file_ctx *fctx,
+		     const struct p7580_submit *args);
+
+/* Fault recovery: stop slots, GPU soft reset, resume (non-IRQ ctx). */
+int p7580_job_recover(struct p7580_job_dev *jd, int fault_slot,
+		      uint32_t status);
+
+/* Idle check for suspend/close paths. */
+int p7580_job_is_idle(struct p7580_job_dev *jd);
+
+#endif /* PANFROST7580_JOB_H */
