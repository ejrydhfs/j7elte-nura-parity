+/* Valid flags for drm_panfrost_create_bo (modern uapi; 1.1 and later).
+ * PANFROST_BO_NOEXEC/HEAP are hints to the kernel: this driver always backs
+ * CREATE_BO with pre-faulted SHMEM, so they are accepted and recorded only.
+ * PANFROST_BO_WB_MMAP is accepted for ABI completeness (WC is the default
+ * mapping; the flag is a no-op here). */
+#define PANFROST_BO_NOEXEC	1
+#define PANFROST_BO_HEAP	2
+#define PANFROST_BO_WB_MMAP	4
