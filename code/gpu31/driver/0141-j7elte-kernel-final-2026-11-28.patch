diff -u -Naur a/drivers/base/dma-buf.c b/drivers/base/dma-buf.c
--- a/drivers/base/dma-buf.c
+++ b/drivers/base/dma-buf.c
@@ -77,7 +77,34 @@
 	return dmabuf->ops->mmap(dmabuf, vma);
 }
 
+/* 3.10 has no dma_buf llseek: lseek(exported_fd, 0, SEEK_END) failed, so
+ * importers that size the buffer that way (Mesa's panfrost
+ * panfrost_bo_create -> lseek -> bo->size) got SIZE_MAX and passed -1 as
+ * the mmap length (ENOMEM before any syscall).  Backport of the upstream
+ * dma-buf SEEK_END support: f_pos is only used for SEEK_CUR, and SEEK_END
+ * is the buffer size. */
+static loff_t dma_buf_llseek(struct file *file, loff_t offset, int whence)
+{
+	struct dma_buf *dmabuf = file->private_data;
+	loff_t base;
+
+	if (!dmabuf)
+		return -EINVAL;
+
+	if (whence == SEEK_SET)
+		base = 0;
+	else if (whence == SEEK_CUR)
+		base = file->f_pos;
+	else if (whence == SEEK_END)
+		base = dmabuf->size;
+	else
+		return -EINVAL;
+
+	return base + offset;
+}
+
 static const struct file_operations dma_buf_fops = {
+	.llseek		= dma_buf_llseek,
 	.release	= dma_buf_release,
 	.mmap		= dma_buf_mmap_internal,
 };
@@ -155,6 +182,16 @@
 	dmabuf->exp_name = exp_name;
 
 	file = anon_inode_getfile("dmabuf", &dma_buf_fops, dmabuf, flags);
+	if (IS_ERR(file)) {
+		kfree(dmabuf);
+		return ERR_CAST(file);
+	}
+	/* anon_inode_getfile() allocates the file through alloc_file() and so
+	 * does not set FMODE_LSEEK (only do_dentry_open() does).  vfs_llseek()
+	 * gates on that bit before calling f_op->llseek, so without this every
+	 * lseek() on a dma-buf fd returns ESPIPE even though
+	 * dma_buf_fops.llseek is wired. */
+	file->f_mode |= FMODE_LSEEK;
 
 	dmabuf->file = file;
 
diff -u -Naur a/drivers/base/dma-fence.c b/drivers/base/dma-fence.c
--- a/drivers/base/dma-fence.c
+++ b/drivers/base/dma-fence.c
@@ -0,0 +1,253 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * dma-fence minimal subset implementation for Nura 3.10.108.
+ *
+ * Mirrors drivers/dma-buf/dma-fence.c (mainline) minus array/chain/debugfs.
+ * Locking: cb_lock protects cb_list and flags. signal_locked()
+ * drains the waiter list with the lock held (callbacks run under the lock,
+ * same as mainline fence callbacks) then completes.
+ *
+ * Review fixes (gpu31-review §1): dma_fence_init() centralises setup (F1);
+ * the vestigial lock pointer / status word / reserved default_work are
+ * gone from the struct (F2); default_wait returns the remaining budget
+ * so chained waits do not get overlong budgets (F3).
+ */
+
+#include <linux/dma-fence.h>
+#include <linux/slab.h>
+#include <linux/jiffies.h>
+#include <linux/sched.h>
+#include <linux/module.h>
+
+/* Global fence-context allocator: backport of dma_fence_context_alloc(). */
+static unsigned dma_fence_context_counter = 1;
+static DEFINE_SPINLOCK(dma_fence_context_lock);
+
+unsigned dma_fence_context_alloc(unsigned num)
+{
+	unsigned context;
+
+	spin_lock(&dma_fence_context_lock);
+	context = dma_fence_context_counter;
+	dma_fence_context_counter += num;
+	spin_unlock(&dma_fence_context_lock);
+
+	return context;
+}
+EXPORT_SYMBOL(dma_fence_context_alloc);
+
+/**
+ * dma_fence_init - prepare an embedded fence before first use.
+ *
+ * Fills in refcount/completion/cb_list/cb_lock/flags plus the ops,
+ * context and seqno, so backends can no longer ship a half-initialised
+ * fence. BUGs on a NULL fence, NULL ops or a NULL release hook: a fence
+ * without release() cannot be freed by dma_fence_put().
+ */
+void dma_fence_init(struct dma_fence *fence,
+		    const struct dma_fence_ops *ops,
+		    unsigned context, unsigned seqno)
+{
+	BUG_ON(!fence || !ops || !ops->release);
+
+	kref_init(&fence->refcount);
+	init_completion(&fence->completion);
+	INIT_LIST_HEAD(&fence->cb_list);
+	spin_lock_init(&fence->cb_lock);
+	fence->flags = 0;
+	fence->ops = ops;
+	fence->context = context;
+	fence->seqno = seqno;
+	fence->timestamp = ktime_set(0, 0);
+}
+EXPORT_SYMBOL(dma_fence_init);
+
+/**
+ * dma_fence_release_base - default teardown used by backend release().
+ *
+ * Only the refcount owner (fence->ops->release) calls this; it runs
+ * exactly once when the last reference drops. Callers must not hold
+ * cb_lock. A non-empty cb_list here means a waiter leaked (fired
+ * callbacks always unlink before running), hence the WARN.
+ */
+void dma_fence_release_base(struct dma_fence *fence)
+{
+	WARN_ON(!list_empty(&fence->cb_list));
+}
+EXPORT_SYMBOL(dma_fence_release_base);
+
+int dma_fence_signal_locked(struct dma_fence *fence)
+{
+	struct dma_fence_cb *cur, *tmp;
+
+	lockdep_assert_held(&fence->cb_lock);
+
+	if (test_and_set_bit(DMA_FENCE_FLAG_SIGNALED_BIT, &fence->flags))
+		return -EINVAL;
+
+	fence->timestamp = ktime_get();
+
+	list_for_each_entry_safe(cur, tmp, &fence->cb_list, node) {
+		list_del_init(&cur->node);
+		cur->func(fence, cur);
+	}
+	INIT_LIST_HEAD(&fence->cb_list);
+
+	complete_all(&fence->completion);
+
+	return 0;
+}
+EXPORT_SYMBOL(dma_fence_signal_locked);
+
+int dma_fence_signal(struct dma_fence *fence)
+{
+	unsigned long flags;
+	int ret;
+
+	if (!fence)
+		return -EINVAL;
+
+	spin_lock_irqsave(&fence->cb_lock, flags);
+	ret = dma_fence_signal_locked(fence);
+	spin_unlock_irqrestore(&fence->cb_lock, flags);
+
+	return ret;
+}
+EXPORT_SYMBOL(dma_fence_signal);
+
+signed long dma_fence_default_wait(struct dma_fence *fence, bool intr,
+				   signed long timeout)
+{
+	signed long ret = timeout ? timeout : 1;
+
+	/* gpu31-fpssplit: mainline returns a POSITIVE remainder for an
+	 * already-signaled fence, including a 0-jiffy poll
+	 * (timeout ? timeout : 1). Returning the bare budget made a
+	 * 0-jiffy poll of an IDLE fence look like a timeout, and the
+	 * WAIT_BO handler (rightly) maps 0 to -ETIMEDOUT -- see
+	 * dma_fence_wait_timeout below. */
+	if (test_bit(DMA_FENCE_FLAG_SIGNALED_BIT, &fence->flags))
+		return ret;
+
+	if (intr) {
+		ret = wait_for_completion_interruptible_timeout(
+				&fence->completion, timeout);
+		if (ret <= 0)
+			return timeout ? -ETIME : 0;
+	} else {
+		ret = wait_for_completion_timeout(&fence->completion,
+						  timeout);
+		if (ret <= 0)
+			return timeout ? -ETIME : 0;
+	}
+
+	return ret;
+}
+EXPORT_SYMBOL(dma_fence_default_wait);
+
+signed long dma_fence_wait_timeout(struct dma_fence *fence, bool intr,
+				   signed long timeout)
+{
+	signed long ret;
+
+	if (WARN_ON(!fence))
+		return -EINVAL;
+
+	/* gpu31-fpssplit: a signaled fence is ready even for a non-blocking
+	 * (0-jiffy) poll. Upstream's default_wait contract is "remaining
+	 * budget, minimum 1" -- returning `timeout` here returned 0 for the
+	 * poll, which the 0002 resv shim cannot tell apart from "budget ran
+	 * out". Mesa's BO-cache fetch is exactly that poll
+	 * (panfrost_bo_wait(bo, 0, RW)); with 0 it could never reuse a BO
+	 * whose fence had long signaled, so every frame allocated and freed
+	 * a full BO set (measured: 5.2 ms/frame system time, Shmem
+	 * +1.8 MB/frame, 155 -> 101 fps). */
+	if (test_bit(DMA_FENCE_FLAG_SIGNALED_BIT, &fence->flags))
+		return timeout ? timeout : 1;
+
+	if (fence->ops->wait)
+		ret = fence->ops->wait(fence, intr, timeout);
+	else
+		ret = dma_fence_default_wait(fence, intr, timeout);
+
+	return ret;
+}
+EXPORT_SYMBOL(dma_fence_wait_timeout);
+
+/**
+ * dma_fence_add_callback - register @func on @fence; runs immediately if
+ * already signaled. Mirrors the mainline return contract: 0 queued,
+ * -ENOENT already signaled (func NOT called), -EINVAL on bad args.
+ */
+int dma_fence_add_callback(struct dma_fence *fence, struct dma_fence_cb *cb,
+			   dma_fence_func_t func)
+{
+	unsigned long flags;
+	int ret = 0;
+
+	if (WARN_ON(!fence || !func))
+		return -EINVAL;
+
+	spin_lock_irqsave(&fence->cb_lock, flags);
+
+	if (dma_fence_is_signaled_locked(fence)) {
+		ret = -ENOENT;
+		goto out;
+	}
+
+	if (!list_empty(&cb->node)) {
+		ret = -EBUSY;
+		goto out;
+	}
+
+	cb->func = func;
+	if (!fence->ops->enable_signaling ||
+	    !fence->ops->enable_signaling(fence)) {
+		list_add_tail(&cb->node, &fence->cb_list);
+	} else {
+		/* Backend already signaled during arming; re-check. */
+		if (dma_fence_is_signaled_locked(fence))
+			ret = -ENOENT;
+		else
+			list_add_tail(&cb->node, &fence->cb_list);
+	}
+out:
+	spin_unlock_irqrestore(&fence->cb_lock, flags);
+	return ret;
+}
+EXPORT_SYMBOL(dma_fence_add_callback);
+
+bool dma_fence_remove_callback(struct dma_fence *fence,
+			       struct dma_fence_cb *cb)
+{
+	unsigned long flags;
+	bool ret = false;
+
+	/* NULL fence (no dependency attached) detaches nothing. The
+	 * close path calls this for every queued job, most of which
+	 * carry no dep; without the guard the first dep-less close
+	 * would dereference NULL. */
+	if (!fence || !cb)
+		return false;
+	spin_lock_irqsave(&fence->cb_lock, flags);
+	if (!list_empty(&cb->node)) {
+		list_del_init(&cb->node);
+		ret = true;
+	}
+	spin_unlock_irqrestore(&fence->cb_lock, flags);
+
+	return ret;
+}
+EXPORT_SYMBOL(dma_fence_remove_callback);
+
+void dma_fence_enable_sw_signaling(struct dma_fence *fence)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&fence->cb_lock, flags);
+	if (!test_and_set_bit(DMA_FENCE_FLAG_ENABLE_SIGNAL_BIT,
+			       &fence->flags) && fence->ops->enable_signaling)
+		fence->ops->enable_signaling(fence);
+	spin_unlock_irqrestore(&fence->cb_lock, flags);
+}
+EXPORT_SYMBOL(dma_fence_enable_sw_signaling);
diff -u -Naur a/drivers/base/dma-resv.c b/drivers/base/dma-resv.c
--- a/drivers/base/dma-resv.c
+++ b/drivers/base/dma-resv.c
@@ -0,0 +1,307 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * dma-resv minimal shim implementation (Nura 3.10.108).
+ * Plain-mutex locking replaces mainline's ww_mutex; fence replacement is
+ * done under resv->lock so readers holding the lock see a stable set.
+ *
+ * Review fixes (gpu31-review §2): every entry point takes resv->lock,
+ * so concurrent SUBMIT vs BO_WAIT can no longer tear the pointer set
+ * (F1); wait paths dma_fence_get() each waited fence under the lock
+ * and sleep only on the pinned copy, so add_excl/add_shared can no
+ * longer free a fence out from under a waiter (F2).
+ */
+
+#include <linux/dma-resv.h>
+#include <linux/module.h>
+
+int dma_resv_reserve_shared(struct dma_resv *obj, unsigned int num_fences)
+{
+	struct dma_resv_list *new_list, *old_list;
+	unsigned max;
+	int ret = 0;
+
+	if (!obj)
+		return -EINVAL;
+
+	mutex_lock(&obj->lock);
+	old_list = obj->fence_shared;
+	max = old_list ? old_list->shared_max : 0;
+	if (old_list && old_list->shared_count + num_fences <= max)
+		goto out;
+
+	max += max(num_fences, 4u);
+	new_list = kmalloc(sizeof(*new_list) + max * sizeof(*new_list->shared),
+			   GFP_KERNEL);
+	if (!new_list) {
+		ret = -ENOMEM;
+		goto out;
+	}
+
+	new_list->shared_count = old_list ? old_list->shared_count : 0;
+	new_list->shared_max = max;
+	if (old_list)
+		memcpy(new_list->shared, old_list->shared,
+		       old_list->shared_count * sizeof(*old_list->shared));
+
+	kfree(old_list);
+	obj->fence_shared = new_list;
+out:
+	mutex_unlock(&obj->lock);
+	return ret;
+}
+EXPORT_SYMBOL(dma_resv_reserve_shared);
+
+void dma_resv_add_shared_fence(struct dma_resv *obj, struct dma_fence *fence)
+{
+	struct dma_resv_list *fobj;
+
+	BUG_ON(!obj);
+
+	mutex_lock(&obj->lock);
+	fobj = obj->fence_shared;
+	BUG_ON(!fobj || fobj->shared_count >= fobj->shared_max);
+
+	dma_fence_get(fence);
+	fobj->shared[fobj->shared_count++] = fence;
+	mutex_unlock(&obj->lock);
+}
+EXPORT_SYMBOL(dma_resv_add_shared_fence);
+
+void dma_resv_add_excl_fence(struct dma_resv *obj, struct dma_fence *fence)
+{
+	struct dma_fence *old;
+	unsigned i;
+
+	BUG_ON(!obj);
+
+	mutex_lock(&obj->lock);
+	old = obj->fence_excl;
+
+	dma_fence_get(fence);
+
+	/* An exclusive fence retires all older shared fences. */
+	if (obj->fence_shared) {
+		for (i = 0; i < obj->fence_shared->shared_count; ++i)
+			dma_fence_put(obj->fence_shared->shared[i]);
+		obj->fence_shared->shared_count = 0;
+	}
+
+	obj->fence_excl = fence;
+	mutex_unlock(&obj->lock);
+
+	dma_fence_put(old);
+}
+EXPORT_SYMBOL(dma_resv_add_excl_fence);
+
+struct dma_fence *dma_resv_get_excl(struct dma_resv *obj)
+{
+	struct dma_fence *fence;
+
+	mutex_lock(&obj->lock);
+	fence = obj->fence_excl;
+	dma_fence_get(fence);
+	mutex_unlock(&obj->lock);
+
+	return fence;
+}
+EXPORT_SYMBOL(dma_resv_get_excl);
+
+bool dma_resv_test_signaled(struct dma_resv *obj, bool test_all)
+{
+	struct dma_resv_list *fobj;
+	struct dma_fence **shared = NULL;
+	struct dma_fence *excl;
+	unsigned i, count = 0;
+	bool sig_excl, ret = true;
+
+	mutex_lock(&obj->lock);
+	excl = obj->fence_excl;
+	dma_fence_get(excl);
+	fobj = obj->fence_shared;
+	if (fobj && fobj->shared_count) {
+		count = fobj->shared_count;
+		shared = kmalloc(count * sizeof(*shared), GFP_KERNEL);
+		if (shared) {
+			for (i = 0; i < count; ++i)
+				dma_fence_get(fobj->shared[i]);
+			memcpy(shared, fobj->shared,
+			       count * sizeof(*shared));
+		}
+	}
+	mutex_unlock(&obj->lock);
+
+	sig_excl = !excl || dma_fence_is_signaled(excl);
+	dma_fence_put(excl);
+	if (!sig_excl || !test_all) {
+		ret = sig_excl;
+		goto out;
+	}
+
+	if (!count)
+		goto out;
+
+	if (!shared) {
+		ret = false;
+		goto out;
+	}
+
+	for (i = 0; i < count; ++i) {
+		if (!dma_fence_is_signaled(shared[i])) {
+			ret = false;
+			break;
+		}
+	}
+out:
+	if (shared) {
+		for (i = 0; i < count; ++i)
+			dma_fence_put(shared[i]);
+		kfree(shared);
+	}
+	return ret;
+}
+EXPORT_SYMBOL(dma_resv_test_signaled);
+
+long dma_resv_wait_timeout(struct dma_resv *obj, bool wait_all, bool intr,
+			   long timeout)
+{
+	struct dma_fence *pinned[8];
+	struct dma_fence **extra = NULL;
+	struct dma_fence *excl;
+	unsigned i, nshared = 0, nwait;
+	/* gpu31-fpssplit: an object with no fences is idle; a 0-jiffy
+	 * poll must return a positive remainder (mainline:
+	 * timeout ? timeout : 1), not 0 (= timed out). */
+	long ret = timeout ? timeout : 1;
+
+	mutex_lock(&obj->lock);
+	excl = obj->fence_excl;
+	dma_fence_get(excl);
+	if (obj->fence_shared)
+		nshared = obj->fence_shared->shared_count;
+	/* Wait at most 8 shared fences directly; heap-pin any overflow. */
+	nwait = nshared > ARRAY_SIZE(pinned) ? ARRAY_SIZE(pinned) : nshared;
+	for (i = 0; i < nwait; ++i) {
+		pinned[i] = obj->fence_shared->shared[i];
+		dma_fence_get(pinned[i]);
+	}
+	if (nshared > nwait) {
+		extra = kmalloc((nshared - nwait) * sizeof(*extra),
+				GFP_KERNEL);
+		if (!extra) {
+			/* OOM under lock: drop pins, report, no sleep. */
+			for (i = 0; i < nwait; ++i)
+				dma_fence_put(pinned[i]);
+			dma_fence_put(excl);
+			mutex_unlock(&obj->lock);
+			return -ENOMEM;
+		}
+		for (i = nwait; i < nshared; ++i)
+			dma_fence_get(obj->fence_shared->shared[i]);
+		memcpy(extra, &obj->fence_shared->shared[nwait],
+		       (nshared - nwait) * sizeof(*extra));
+	}
+	mutex_unlock(&obj->lock);
+
+	if (excl) {
+		ret = dma_fence_wait_timeout(excl, intr, timeout);
+		dma_fence_put(excl);
+		if (ret <= 0 || !wait_all)
+			goto out;
+		timeout = ret;
+	}
+
+	for (i = 0; i < nwait && timeout > 0; ++i)
+		timeout = dma_fence_wait_timeout(pinned[i], intr, timeout);
+	for (i = 0; extra && i < nshared - nwait && timeout > 0; ++i)
+		timeout = dma_fence_wait_timeout(extra[i], intr, timeout);
+	/* gpu31-fpssplit: a resv with no fence is idle, so a 0-jiffy poll
+	 * keeps the positive remainder from above; a waited fence set
+	 * reports the remaining budget (0 = timed out). */
+	if (excl || nshared)
+		ret = timeout;
+out:
+	for (i = 0; i < nwait; ++i)
+		dma_fence_put(pinned[i]);
+	if (extra) {
+		for (i = 0; i < nshared - nwait; ++i)
+			dma_fence_put(extra[i]);
+		kfree(extra);
+	}
+	return ret;
+}
+EXPORT_SYMBOL(dma_resv_wait_timeout);
+
+/**
+ * dma_resv_copy_fences - copy the fence set from @src to @dst.
+ *
+ * Takes both reservation locks in increasing address order so two
+ * concurrent copies in opposite directions serialize instead of
+ * ABBA-deadlocking. @dst's old fences are dropped; every copied
+ * pointer carries a fresh reference.
+ */
+int dma_resv_copy_fences(struct dma_resv *dst, struct dma_resv *src)
+{
+	struct dma_resv_list *new_list = NULL;
+	struct dma_resv *first, *second;
+	struct dma_fence *new_excl = NULL;
+	unsigned count = 0;
+	int ret = 0;
+
+	if (!dst || !src)
+		return -EINVAL;
+	if (dst == src)
+		return 0;
+
+	first = dst < src ? dst : src;
+	second = dst < src ? src : dst;
+
+	mutex_lock(&first->lock);
+	if (second != first)
+		mutex_lock(&second->lock);
+
+	if (src->fence_shared)
+		count = src->fence_shared->shared_count;
+	if (count) {
+		new_list = kmalloc(sizeof(*new_list) +
+				   count * sizeof(*new_list->shared),
+				   GFP_KERNEL);
+		if (!new_list) {
+			ret = -ENOMEM;
+			goto out;
+		}
+		new_list->shared_count = count;
+		new_list->shared_max = count;
+		memcpy(new_list->shared, src->fence_shared->shared,
+		       count * sizeof(*new_list->shared));
+		for (count = 0; count < new_list->shared_count; ++count)
+			dma_fence_get(new_list->shared[count]);
+	}
+	new_excl = src->fence_excl;
+	dma_fence_get(new_excl);
+
+	dma_fence_put(dst->fence_excl);
+	if (dst->fence_shared) {
+		for (count = 0; count < dst->fence_shared->shared_count;
+		     ++count)
+			dma_fence_put(dst->fence_shared->shared[count]);
+		kfree(dst->fence_shared);
+	}
+	dst->fence_shared = new_list;
+	dst->fence_excl = new_excl;
+	new_list = NULL;
+	new_excl = NULL;
+out:
+	if (second != first)
+		mutex_unlock(&second->lock);
+	mutex_unlock(&first->lock);
+	if (new_list) {
+		unsigned i;
+
+		for (i = 0; i < new_list->shared_count; ++i)
+			dma_fence_put(new_list->shared[i]);
+		kfree(new_list);
+	}
+	dma_fence_put(new_excl);
+	return ret;
+}
+EXPORT_SYMBOL(dma_resv_copy_fences);
