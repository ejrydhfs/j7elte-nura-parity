+			} else {
+				return false;
+			}
+		} else {
+			return drm_mode_object_find(property->dev, value,
+						    property->values[0]) != NULL;
+		}
+	}
+
+	for (i = 0; i < property->num_values; i++)
+		if (property->values[i] == value)
+			return true;
+	return false;
+}
+EXPORT_SYMBOL(drm_property_change_valid_get);
