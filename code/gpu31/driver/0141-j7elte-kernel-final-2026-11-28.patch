diff -u -Naur a/drivers/gpu/drm/drm_syncobj.c b/drivers/gpu/drm/drm_syncobj.c
--- a/drivers/gpu/drm/drm_syncobj.c
+++ b/drivers/gpu/drm/drm_syncobj.c
@@ -0,0 +1,175 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * drm_syncobj minimal subset implementation (Nura 3.10.108).
+ * Binary-payload only. No timeline points, no sync_file fd passing.
+ */
+
+#include "drm_syncobj.h"
+#include <linux/slab.h>
+#include <linux/module.h>
+
+void drm_syncobj_manager_init(struct drm_syncobj_manager *mgr)
+{
+	idr_init(&mgr->idr);
+	mutex_init(&mgr->lock);
+}
+EXPORT_SYMBOL(drm_syncobj_manager_init);
+
+/* Close semantics (gpu31-close-fix): fini drops every manager reference
+ * without ever waiting on a fence. A syncobj whose fence is still pending
+ * (in-flight job at close) simply loses the manager's owner ref here; the
+ * fence itself is owned by the job/sched retirement path and signals (or
+ * is freed) independently. Any concurrent WAIT snapshots its own fence ref
+ * under mgr->lock before sleeping, so dropping the idr entry cannot free
+ * a fence out from under a waiter. Double fini is safe (empty drain). */
+void drm_syncobj_manager_fini(struct drm_syncobj_manager *mgr)
+{
+	struct drm_syncobj *syncobj;
+	int id;
+
+	if (!mgr)
+		return;
+
+	/*
+	 * Drain via idr_get_next (review F1): idr_for_each_entry is not
+	 * safe against removal of the current entry, so look up the
+	 * lowest remaining id, remove it, and repeat until empty.
+	 * Safe under mgr->lock; each removed entry drops its owner ref.
+	 */
+	for (;;) {
+		mutex_lock(&mgr->lock);
+		id = 0;
+		syncobj = idr_get_next(&mgr->idr, &id);
+		if (syncobj)
+			idr_remove(&mgr->idr, id);
+		mutex_unlock(&mgr->lock);
+		if (!syncobj)
+			break;
+		drm_syncobj_put(syncobj);
+	}
+	idr_destroy(&mgr->idr);
+}
+EXPORT_SYMBOL(drm_syncobj_manager_fini);
+
+int drm_syncobj_create(struct drm_syncobj_manager *mgr, u32 *handle)
+{
+	struct drm_syncobj *syncobj;
+	int ret;
+
+	syncobj = kzalloc(sizeof(*syncobj), GFP_KERNEL);
+	if (!syncobj)
+		return -ENOMEM;
+
+	kref_init(&syncobj->refcount);
+	mutex_init(&syncobj->lock);
+	syncobj->fence = NULL;
+
+	idr_preload(GFP_KERNEL);
+	mutex_lock(&mgr->lock);
+	ret = idr_alloc(&mgr->idr, syncobj, 1, 0, GFP_NOWAIT);
+	mutex_unlock(&mgr->lock);
+	idr_preload_end();
+
+	if (ret < 0) {
+		kfree(syncobj);
+		return ret;
+	}
+
+	*handle = (u32)ret;
+	return 0;
+}
+EXPORT_SYMBOL(drm_syncobj_create);
+
+int drm_syncobj_destroy(struct drm_syncobj_manager *mgr, u32 handle)
+{
+	struct drm_syncobj *syncobj;
+
+	mutex_lock(&mgr->lock);
+	syncobj = idr_find(&mgr->idr, (int)handle);
+	if (syncobj)
+		idr_remove(&mgr->idr, (int)handle);
+	mutex_unlock(&mgr->lock);
+
+	if (!syncobj)
+		return -ENOENT;
+
+	drm_syncobj_put(syncobj);
+	return 0;
+}
+EXPORT_SYMBOL(drm_syncobj_destroy);
+
+struct drm_syncobj *drm_syncobj_find(struct drm_syncobj_manager *mgr,
+				     u32 handle)
+{
+	struct drm_syncobj *syncobj;
+
+	mutex_lock(&mgr->lock);
+	syncobj = idr_find(&mgr->idr, (int)handle);
+	drm_syncobj_get(syncobj);
+	mutex_unlock(&mgr->lock);
+
+	return syncobj;
+}
+EXPORT_SYMBOL(drm_syncobj_find);
+
+void drm_syncobj_free(struct kref *kref)
+{
+	struct drm_syncobj *syncobj =
+		container_of(kref, struct drm_syncobj, refcount);
+
+	dma_fence_put(syncobj->fence);
+	kfree(syncobj);
+}
+EXPORT_SYMBOL(drm_syncobj_free);
+
+int drm_syncobj_replace_fence(struct drm_syncobj *syncobj,
+			      struct dma_fence *fence)
+{
+	struct dma_fence *old;
+
+	if (!syncobj)
+		return -EINVAL;
+
+	dma_fence_get(fence);
+
+	mutex_lock(&syncobj->lock);
+	old = syncobj->fence;
+	syncobj->fence = fence;
+	mutex_unlock(&syncobj->lock);
+
+	dma_fence_put(old);
+	return 0;
+}
+EXPORT_SYMBOL(drm_syncobj_replace_fence);
+
+struct dma_fence *drm_syncobj_find_fence(struct drm_syncobj *syncobj)
+{
+	struct dma_fence *fence;
+
+	if (!syncobj)
+		return NULL;
+
+	mutex_lock(&syncobj->lock);
+	fence = syncobj->fence;
+	dma_fence_get(fence);
+	mutex_unlock(&syncobj->lock);
+
+	return fence;
+}
+EXPORT_SYMBOL(drm_syncobj_find_fence);
+
+int drm_syncobj_wait(struct drm_syncobj *syncobj, bool intr, long timeout)
+{
+	struct dma_fence *fence;
+	long ret;
+
+	fence = drm_syncobj_find_fence(syncobj);
+	if (!fence)
+		return 0;	/* NULL fence == already signaled (mainline) */
+
+	ret = dma_fence_wait_timeout(fence, intr, timeout);
+	dma_fence_put(fence);
+
+	return ret < 0 ? (int)ret : 0;
+}
+EXPORT_SYMBOL(drm_syncobj_wait);
diff -u -Naur a/drivers/gpu/drm/drm_syncobj.h b/drivers/gpu/drm/drm_syncobj.h
--- a/drivers/gpu/drm/drm_syncobj.h
+++ b/drivers/gpu/drm/drm_syncobj.h
@@ -0,0 +1,79 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * drm_syncobj minimal subset for Nura 3.10.108 panfrost backport.
+ *
+ * What this provides: the syncobj handle layer panfrost SUBMIT consumes --
+ * per-file handle table (CREATE/DESTROY), point lookup by handle,
+ * fence replace/query (binary payload only), WAIT (block on the current
+ * fence), and FD export/import plumbing stubs wired to dma-fence
+ * (syncobj->fence is a plain dma_fence pointer + refcount, no
+ * struct file backing -- 3.10 has no sync_file.h).
+ *
+ * Panfrost ioctl mapping: DRM_PANFROST_SUBMIT takes in-syncobj handles
+ * (resolved to fences via drm_syncobj_find_fence) and an out-syncobj
+ * handle (completed via drm_syncobj_replace_fence). Mesa panfrost
+ *winsys passes one syncobj per batch; WAIT_SEM-style chained payloads
+ * are NOT needed and are omitted.
+ *
+ * What this deliberately OMITs vs mainline (~800 LOC): timeline
+ * (TIMELINE_SIGNAL/WAIT/QUERY) payloads, drm_syncobj timeline points,
+ * eventfd/SYNCOBJ_WAIT_FOR_SUBMIT support, and the syncobj->file fd
+ * lifecycle (sync_file.c does not exist in 3.10 -- FD import/export
+ * here resolves the fence synchronously instead of passing struct file).
+ *
+ * Depends on patch 01 (dma-fence). Uses idr_alloc/idr_find/idr_remove
+ * (idr.h, verified present) and mutex (mutex.h). DRM_SYNCOBJ ioctls
+ * reuse the 3.10 driver-private range via struct drm_driver ioctls --
+ * see the .rst section below; no core drm.h changes are made.
+ */
+#ifndef _DRM_SYNCOBJ_BACKPORT_H
+#define _DRM_SYNCOBJ_BACKPORT_H
+
+#include <linux/dma-fence.h>
+#include <linux/idr.h>
+#include <linux/mutex.h>
+
+struct drm_syncobj {
+	struct kref refcount;
+	struct dma_fence *fence;
+	struct mutex lock;		/* guards fence replace/query */
+};
+
+/**
+ * struct drm_syncobj_manager - per-drm_file handle table for syncobjs.
+ * One instance per open file; handles are small ints local to the fd.
+ */
+struct drm_syncobj_manager {
+	struct idr idr;
+	struct mutex lock;
+};
+
+void drm_syncobj_manager_init(struct drm_syncobj_manager *mgr);
+void drm_syncobj_manager_fini(struct drm_syncobj_manager *mgr);
+
+int drm_syncobj_create(struct drm_syncobj_manager *mgr, u32 *handle);
+int drm_syncobj_destroy(struct drm_syncobj_manager *mgr, u32 handle);
+struct drm_syncobj *drm_syncobj_find(struct drm_syncobj_manager *mgr,
+				     u32 handle);
+
+static inline void drm_syncobj_get(struct drm_syncobj *syncobj)
+{
+	if (syncobj)
+		kref_get(&syncobj->refcount);
+}
+
+void drm_syncobj_free(struct kref *kref);
+
+static inline void drm_syncobj_put(struct drm_syncobj *syncobj)
+{
+	if (syncobj)
+		kref_put(&syncobj->refcount, drm_syncobj_free);
+}
+
+/* fence payload ops (binary syncobj only) */
+int drm_syncobj_replace_fence(struct drm_syncobj *syncobj,
+			      struct dma_fence *fence);
+struct dma_fence *drm_syncobj_find_fence(struct drm_syncobj *syncobj);
+int drm_syncobj_wait(struct drm_syncobj *syncobj, bool intr, long timeout);
+
+#endif /* _DRM_SYNCOBJ_BACKPORT_H */
diff -u -Naur a/drivers/gpu/drm/exynos7580/Kconfig b/drivers/gpu/drm/exynos7580/Kconfig
--- a/drivers/gpu/drm/exynos7580/Kconfig
+++ b/drivers/gpu/drm/exynos7580/Kconfig
@@ -0,0 +1,24 @@
+config DRM_EXYNOS7580
+	tristate "DRM/KMS support for Samsung Exynos 7580 (DECON + MIPI DSIM)"
+	depends on DRM && OF && ARM64 && ARCH_EXYNOS && EXYNOS7580_DISPLAY_KMS && EXYNOS_IOVMM_V6
+	select DRM_KMS_HELPER
+	select DRM_KMS_CMA_HELPER
+	select VIDEOMODE_HELPERS
+	help
+	  DRM/KMS driver for the Samsung Exynos 7580 display subsystem:
+	  the DECON display controller, the MIPI DSIM master/D-PHY and the
+	  ea8061 720x1280 panel found on the Galaxy J7 (j7elte).
+
+	  Provides a single CRTC with one primary plane, a DSI encoder and
+	  connector, CMA backed dumb buffers and fbdev emulation.  Only the
+	  EXYNOS7580_DISPLAY_KMS choice may select it.
+
+	  Built in (=y) it binds the DECON node at late_initcall, after the
+	  vendor DSIM/panel driver, and the vendor fbdev driver binds only at
+	  late_initcall_sync when this probe fails.  Built as a module (=m,
+	  int53) the vendor fbdev driver always binds at boot; the module is
+	  never auto-loaded (no modules.alias on the device) and is brought
+	  up by hand after unbinding the vendor driver:
+
+	    echo 14830000.decon_fb > /sys/bus/platform/drivers/decon/unbind
+	    insmod exynos-drm7580.ko
diff -u -Naur a/drivers/gpu/drm/exynos7580/Makefile b/drivers/gpu/drm/exynos7580/Makefile
--- a/drivers/gpu/drm/exynos7580/Makefile
+++ b/drivers/gpu/drm/exynos7580/Makefile
@@ -0,0 +1,21 @@
+#
+# Samsung Exynos 7580 DECON DRM/KMS driver
+#
+# The window/register/DSIM low-level code and the ea8061 panel description are
+# shared with the vendor fbdev driver (it stays built in as the
+# late_initcall_sync fallback), so its directory is on the include path.
+#
+ccflags-y += -I$(srctree)/drivers/video/exynos/decon_7580
+# int64: no .eh_frame PREL32 relocations in the loadable module (3.10 arm64
+# module loader cannot apply them); irrelevant for the built-in image.
+ccflags-y += -fno-asynchronous-unwind-tables -fno-unwind-tables
+
+obj-$(CONFIG_DRM_EXYNOS7580) += exynos-drm7580.o
+exynos-drm7580-y := \
+	exynos_drm7580_main.o \
+	exynos_drm7580_crtc.o \
+	exynos_drm7580_plane.o \
+	exynos_drm7580_dsi.o \
+	exynos_drm7580_dmabuf.o \
+	exynos_drm7580_fence.o \
+	exynos_drm7580_fbdev.o
diff -u -Naur a/drivers/gpu/drm/exynos7580/exynos_drm7580.h b/drivers/gpu/drm/exynos7580/exynos_drm7580.h
--- a/drivers/gpu/drm/exynos7580/exynos_drm7580.h
+++ b/drivers/gpu/drm/exynos7580/exynos_drm7580.h
@@ -0,0 +1,136 @@
+/* SPDX-License-Identifier: GPL-2.0
+ *
+ * gpu31-kms: contract between the DECON KMS slices (M1/M2).
+ *
+ * This header is the ONLY shared interface. Each slice implements the
+ * functions declared for it in its own source file and MUST NOT define or
+ * reference anything else from a sibling's file. Assembly is done by the
+ * integration seat.
+ *
+ * Ownership
+ *   exynos_drm7580_main.c     KmsBoot? -> see slice map (probe/bind/card0)
+ *   exynos_drm7580_crtc.c     DeconCrtc  : crtc, mode_set, link enable, PM
+ *   exynos_drm7580_plane.c    DeconPlane : primary/overlay planes, formats
+ *   exynos_drm7580_dsi.c      DsiEncoder : encoder + connector
+ *   exynos_drm7580_dmabuf.c   KmsDmabuf  : dma-buf import -> GEM/framebuffer
+ *   exynos_drm7580_fence.c    KmsFence   : vblank -> fence, flip events
+ *   exynos_drm7580_fbdev.c    KmsFbdev   : drm_fb_helper emulation on KMS
+ *
+ * Binding rules (from KmsCoexist, non-negotiable)
+ *   - match only "samsung,exynos5-decon_driver"; never the dsim node;
+ *     never add DT compatibles (the DT payload stays stock).
+ *   - late_initcall, not module_platform_driver.
+ *   - register card0 via drm_platform_init; on any failure return an error so
+ *     the vendor fbdev driver (late_initcall_sync) binds instead.
+ */
+#ifndef __EXYNOS_DRM7580_H__
+#define __EXYNOS_DRM7580_H__
+
+#include <drm/drmP.h>
+#include <drm/drm_crtc.h>	/* 3.10 keeps connector/encoder decls here */
+
+/* Bit flags for exynos7580_connector_state()/debug. */
+#define EXYNOS7580_MAX_PLANES		3
+
+/* Opaque handle to the vendor DECON window engine (DeconApi contract). */
+struct decon_kms_dev;
+
+/* 3.10 has no embedded drm_device (drm_dev_alloc arrived in 3.13):
+ * drm_platform_init() allocates the drm_device itself, so our state hangs off
+ * drm->dev_private and we must NEVER container_of() a drm_device. */
+struct exynos7580_device {
+	struct drm_device	*drm;	/* owned by drm_platform_init(), not us */
+	struct device		*dev;
+	struct decon_kms_dev	*decon;
+
+	struct drm_crtc		crtc;
+	struct drm_plane	planes[EXYNOS7580_MAX_PLANES];
+	unsigned int		num_planes;
+	/* Framebuffers currently programmed into DECON.  The atomic state
+	 * drops its reference as soon as the next commit swaps in, but the
+	 * hardware keeps scanning the old buffer out when we skip a frame,
+	 * so the driver must keep it alive until it is really replaced. */
+	struct drm_framebuffer	*last_fb[EXYNOS7580_MAX_PLANES];
+	/* Copy of the last complete frame.  KWin gets its buffer back as soon
+	 * as the flip event is sent, so the buffer still being scanned out can
+	 * be rewritten (and cleared by the next failed render).  This copy is
+	 * what the plane code programs instead. */
+	void			*shadow;
+	size_t			shadow_size;
+	unsigned int		shadow_pitch;
+
+	struct drm_encoder	encoder;
+	struct drm_connector	connector;
+};
+
+static inline struct exynos7580_device *to_exynos7580(struct drm_device *drm)
+{
+	return drm->dev_private;
+}
+
+/* ---- DeconCrtc ---------------------------------------------------------- */
+/* Registers the single CRTC (atomic helper funcs). Returns 0 or -errno. */
+int exynos7580_crtc_init(struct exynos7580_device *ex);
+/* Called from the CRTC's mode_set/commit path; owns the DSI link enable and
+ * the DECON pm_runtime reference (DsiPanel/DispPower contracts). */
+int exynos7580_crtc_enable_link(struct exynos7580_device *ex);
+void exynos7580_crtc_disable_link(struct exynos7580_device *ex);
+/* mode_config funcs (KmsAssemble: folded in from 0200's local declarations).
+ * atomic_check validates the whole state; atomic_commit arms the flip and
+ * runs the CRTC/plane tail. Both are implemented by the CRTC slice. */
+int exynos7580_atomic_check(struct drm_device *drm,
+			    struct drm_atomic_state *state);
+int exynos7580_atomic_commit(struct drm_device *drm,
+			     struct drm_atomic_state *state, bool async);
+
+/* ---- DeconPlane --------------------------------------------------------- */
+/* Registers primary + overlay planes bound to the vendor window API. */
+int exynos7580_planes_init(struct exynos7580_device *ex);
+/* Atomic plane update path; returns 0, -EINVAL or -ENOSPC (window shortage). */
+int exynos7580_plane_atomic_update(struct drm_plane *plane,
+				   struct drm_plane_state *state);
+void exynos7580_plane_atomic_disable(struct drm_plane *plane,
+				     struct drm_plane_state *state);
+
+/* ---- DsiEncoder --------------------------------------------------------- */
+/* Registers the DSI encoder + connector (DSI type = 16, see M0 UAPI). */
+int exynos7580_dsi_init(struct exynos7580_device *ex);
+/* Connector helper: fills the single supported mode from the panel timings. */
+int exynos7580_dsi_get_modes(struct drm_connector *connector);
+
+/* ---- KmsDmabuf ---------------------------------------------------------- */
+/* Imports a dma-buf fd as a GEM object usable as a scanout fb. */
+struct drm_gem_object *exynos7580_gem_prime_import(struct drm_device *drm,
+						   struct dma_buf *dma_buf);
+/* Creates a DRM framebuffer from a GEM handle (ADDFB2 path). */
+struct drm_framebuffer *exynos7580_fb_create(struct drm_device *drm,
+					     struct drm_file *file,
+					     struct drm_mode_fb_cmd2 *mode_cmd);
+/* Scanout DMA address of `plane` in `fb` (imported or CMA). Returns 0 and
+ * writes *addr, or -EINVAL/-ENODEV. Implemented by KmsDmabuf; used by
+ * DeconPlane (windows) and KmsFbdev (fb0). */
+int exynos7580_fb_scanout(struct drm_framebuffer *fb, unsigned int plane,
+			  dma_addr_t *addr);
+
+/* ---- KmsFence ----------------------------------------------------------- */
+/* Arms flip events for the pending commit (vblank-armed, from M0 helper). */
+void exynos7580_commit_tail(struct drm_atomic_state *state);
+/* Page-flip/cursor event completion on vblank; called from the vblank IRQ. */
+void exynos7580_vblank_irq(struct drm_device *drm, unsigned int pipe);
+
+/* ---- KmsFbdev ----------------------------------------------------------- */
+/* drm_fb_helper emulation on KMS; returns 0 or -errno. */
+int exynos7580_fbdev_init(struct exynos7580_device *ex);
+/* Tear fb0 down (idempotent); ->unload() calls it before mode_config_cleanup. */
+void exynos7580_fbdev_fini(void);
+
+#endif /* __EXYNOS_DRM7580_H__ */
+
+extern unsigned int exynos7580_dump_fb;
+void exynos7580_dump_scanout(struct drm_framebuffer *fb);
+bool exynos7580_fb_is_blank(struct drm_framebuffer *fb);
+/* Copy rows between a scanout framebuffer and the driver's shadow frame. */
+bool exynos7580_fb_shadow_read(struct drm_framebuffer *fb, void *shadow,
+			       unsigned int pitch);
+bool exynos7580_fb_shadow_write(struct drm_framebuffer *fb, const void *shadow,
+				unsigned int pitch, size_t shadow_size);
diff -u -Naur a/drivers/gpu/drm/exynos7580/exynos_drm7580_crtc.c b/drivers/gpu/drm/exynos7580/exynos_drm7580_crtc.c
--- a/drivers/gpu/drm/exynos7580/exynos_drm7580_crtc.c
+++ b/drivers/gpu/drm/exynos7580/exynos_drm7580_crtc.c
@@ -0,0 +1,783 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * exynos_drm7580_crtc.c - DECON KMS CRTC, link enable and modeset plumbing
+ *
+ * Part of the exynos7580 DECON DRM/KMS subdriver (slice DeconCrtc of
+ * docs/reports/decon-kms-plan.md).  One CRTC, no cursor plane, no scaler.
+ *
+ * OWNERSHIP CONTRACT (cited by the integration seat and by DeconPlane)
+ * ---------------------------------------------------------------
+ * 1. DeconPlane owns the single decon_kms_commit() of an atomic commit: it
+ *    builds wins[] from the committed plane states in its last-plane hook,
+ *    which runs inside commit_planes, i.e. between atomic_begin() and
+ *    atomic_flush() and before exynos7580_commit_tail() arms the flip event.
+ *    This file NEVER commits a frame; atomic_flush() only re-asserts the link.
+ * 2. This file owns the fallible display bring-up.  It runs in
+ *    mode_config.funcs.atomic_commit() BEFORE drm_atomic_helper_swap_state(),
+ *    because the M0 helper ignores crtc_funcs->mode_set()'s return value
+ *    (drm_atomic_helper.c, crtc_set_mode()): a DSI/panel failure there could
+ *    not abort the commit.  crtc_funcs->mode_set() then just re-asserts the
+ *    (idempotent) link, which keeps the documented ordering "link before
+ *    decon_reg_init()" (docs/reports/decon-kms-dsi.md 2.3).
+ * 3. atomic_check() requires the primary plane to be part of any commit that
+ *    activates the CRTC or needs a modeset, so a plane-driven commit cannot
+ *    miss the frame that starts scanout.
+ *
+ * ATOMIC COMMIT ORDER (agreed with KmsFence, see docs/reports/decon-kms-crtc.md)
+ *   a. this file: enable_link() for every CRTC that becomes active
+ *      (pm_runtime_get + DSIM s_stream(1) + decon_reg_init/reg_start)
+ *   b. drm_atomic_helper_prepare_planes()
+ *   c. drm_atomic_helper_swap_state()
+ *   d. exynos7580_commit_tail() (KmsFence): pre/commit/post planes, event
+ *      arming at the next vblank, wait, cleanup, free(state)
+ * Non-blocking and async requests run the same tail (M1 is synchronous).
+ *
+ * LOCKING (why the order below cannot deadlock)
+ * ---------------------------------------------
+ * 3.10 has no ww_mutex; M0 serialises atomic commits with the single
+ * drm_device.mode_config.mutex (drm_modeset_lock_all(), taken by the ioctl
+ * layer before atomic_check/atomic_commit and held across them).
+ *
+ *   mode_config.mutex  ->  crtc_lock  ->  decon->output_lock -> decon->mutex
+ *
+ * - mode_config.mutex is only ever taken by DRM core callers *above* this
+ *   file; nothing here takes it, so it can never be acquired while crtc_lock
+ *   or a DECON lock is held: the outer edge of the graph is acyclic.
+ * - crtc_lock (file scope) protects the link/modeset bookkeeping.  It is
+ *   taken in enable_link()/disable_link()/atomic_check() only, and the only
+ *   locks taken inside it are the vendor ones via decon_kms_enable/disable()
+ *   (output_lock); no DRM lock and no callback into DRM is made under it.
+ * - decon->output_lock serialises the window API (taken by decon_enable(),
+ *   decon_disable() and decon_kms_commit()), decon->mutex is pm_runtime's.
+ *   The vendor code never calls back into DRM, so both are leaves.
+ * The order is therefore a strict hierarchy with no cycle, and no path takes
+ * crtc_lock while holding a DECON lock (the vendor callbacks under
+ * output_lock never reach this file).
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License version 2 as
+ * published by the Free Software Foundation.
+ */
+
+#include <drm/drmP.h>
+#include <drm/drm_atomic.h>
+#include <drm/drm_atomic_helper.h>
+#include <drm/drm_crtc_helper.h>
+
+#include <linux/exynos_decon_kms.h>
+
+#include "exynos_drm7580.h"
+
+/*
+ * Link/power bookkeeping of the single CRTC.
+ *
+ * DECON is a single-instance driver (decon_api.h layer B resolves every
+ * register call through one global context) and this header gives the CRTC no
+ * private pointer of its own, so the state of the one CRTC lives here.
+ *
+ * @on:                  DSI link + DECON are enabled and programmed.
+ * @needs_full_modeset:  set whenever the DECON lost its register state (link
+ *                       off, i.e. after any pm_runtime cycle).  DispPower 5.1:
+ *                       nothing saves DECON state across a power cycle, so the
+ *                       next commit must re-run decon_reg_init()/reg_start().
+ */
+struct exynos7580_crtc_link {
+	bool	on;
+	bool	needs_full_modeset;
+};
+
+static struct exynos7580_crtc_link crtc_link;
+static DEFINE_MUTEX(crtc_lock);
+
+static struct exynos7580_device *crtc_to_ex(struct drm_crtc *crtc)
+{
+	return to_exynos7580(crtc->dev);
+}
+
+/* ------------------------------------------------------------------------ */
+/* link / power                                                             */
+/* ------------------------------------------------------------------------ */
+
+int exynos7580_crtc_enable_link(struct exynos7580_device *ex)
+{
+	int ret;
+
+	if (!ex || !ex->decon)
+		return -ENODEV;
+
+	mutex_lock(&crtc_lock);
+
+	if (crtc_link.on) {
+		/* The link is up, so whatever asked for a full modeset has been
+		 * satisfied already; a stale flag must not leak into the next
+		 * atomic_check(). */
+		if (crtc_link.needs_full_modeset) {
+			pr_info("exynos7580_crtc_enable_link: link already on, clearing stale needs_full_modeset\n");
+			crtc_link.needs_full_modeset = false;
+		}
+		mutex_unlock(&crtc_lock);
+		return 0;
+	}
+
+	/*
+	 * DispPower 6.4 order: take the DECON runtime reference first (pd_disp
+	 * + CMU_DISP are one resource), then the DSIM link and the panel, then
+	 * the DECON controller.  decon_kms_enable() is the vendor
+	 * decon_enable() sequence and its only fallible step is the DSIM
+	 * s_stream(1) call, so its error is what a failed modeset reports.
+	 */
+	ret = decon_kms_power_get(ex->decon);
+	if (ret < 0) {
+		DRM_ERROR("DECON power get failed: %d\n", ret);
+		mutex_unlock(&crtc_lock);
+		return ret;
+	}
+
+	ret = decon_kms_enable(ex->decon);
+	if (ret) {
+		DRM_ERROR("DECON enable (DSI link) failed: %d\n", ret);
+		decon_kms_power_put(ex->decon);
+		mutex_unlock(&crtc_lock);
+		return ret;
+	}
+
+	crtc_link.on = true;
+	/* DispPower 5.1 is satisfied: DECON was re-initialised by
+	 * decon_kms_enable() above, so the next commit no longer needs a full
+	 * modeset.  Clearing here (and not only in crtc->mode_set) also covers
+	 * the atomic_commit() enable path, which never calls mode_set(). */
+	crtc_link.needs_full_modeset = false;
+
+	mutex_unlock(&crtc_lock);
+
+	pr_info("exynos7580_crtc_enable_link: link on, needs_full_modeset cleared\n");
+
+	return 0;
+}
+
+void exynos7580_crtc_disable_link(struct exynos7580_device *ex)
+{
+	if (!ex || !ex->decon)
+		return;
+
+	/*
+	 * Called twice per modeset-off: once from the encoder's ->disable
+	 * (drm_crtc_helper.c:288-294) and once from the CRTC's ->disable
+	 * (:296-306).  Both decon_kms_disable() and this guard are idempotent.
+	 */
+	mutex_lock(&crtc_lock);
+
+	if (!crtc_link.on) {
+		mutex_unlock(&crtc_lock);
+		return;
+	}
+
+	pr_info("exynos7580_crtc_disable_link: disabling link state (by %s)\n",
+		current->comm);
+	decon_kms_disable(ex->decon);	/* s_stream(0) then reg_stop, vendor order */
+	decon_kms_power_put(ex->decon);
+
+	crtc_link.on = false;
+	crtc_link.needs_full_modeset = true;
+
+	mutex_unlock(&crtc_lock);
+
+	DRM_DEBUG_KMS("DECON link disabled\n");
+}
+
+/* ------------------------------------------------------------------------ */
+/* helpers                                                                  */
+/* ------------------------------------------------------------------------ */
+
+/*
+ * Does this commit have to bring the DECON up (and therefore has to be a full
+ * modeset)?  True when the CRTC becomes active or its mode changes.
+ */
+static bool exynos7580_crtc_enabling(struct drm_crtc_state *state,
+				     struct drm_crtc_state *old)
+{
+	if (!state->active || !state->enable)
+		return false;
+	if (!old || !old->active)
+		return true;
+
+	return state->mode_changed;
+}
+
+/* Is @primary part of this atomic commit? */
+static bool exynos7580_crtc_state_has_plane(struct drm_atomic_state *astate,
+					    struct drm_plane *plane)
+{
+	int i, n = astate->dev->mode_config.num_total_plane;
+
+	for (i = 0; i < n; i++)
+		if (astate->planes[i] == plane)
+			return true;
+
+	return false;
+}
+
+/* ------------------------------------------------------------------------ */
+/* crtc helper funcs                                                        */
+/* ------------------------------------------------------------------------ */
+
+static bool exynos7580_crtc_mode_fixup(struct drm_crtc *crtc,
+				       const struct drm_display_mode *mode,
+				       struct drm_display_mode *adjusted_mode)
+{
+	/*
+	 * There is no scaler: DECON scans out exactly the timing the DSIM/panel
+	 * was programmed with (decon->lcd_info, filled by the vendor DSIM
+	 * subdev).  The DRM mode is informational for the DECON side, so any
+	 * mode the connector accepted is passed through unchanged.
+	 */
+	drm_mode_copy(adjusted_mode, mode);
+
+	return true;
+}
+
+static int exynos7580_crtc_mode_set(struct drm_crtc *crtc,
+				    struct drm_display_mode *mode,
+				    struct drm_display_mode *adjusted_mode,
+				    int x, int y,
+				    struct drm_framebuffer *old_fb)
+{
+	struct exynos7580_device *ex = crtc_to_ex(crtc);
+	int idx = drm_crtc_index(crtc);
+	int ret;
+
+	DRM_DEBUG_KMS("[CRTC:%d] modeset %ux%u@%u\n", crtc->base.id,
+		      adjusted_mode->hdisplay, adjusted_mode->vdisplay,
+		      drm_mode_vrefresh(adjusted_mode));
+
+	drm_vblank_pre_modeset(crtc->dev, idx);
+
+	/*
+	 * The fallible step, before any window register is touched:
+	 * pm_runtime_get_sync -> DSIM s_stream(1) (rails, D-PHY, panel reset
+	 * and init) -> iovmm_activate -> decon_reg_init -> decon_reg_start.
+	 * Normal commits already did this in atomic_commit(); this call is the
+	 * idempotent re-assert that keeps the documented link-before-reg_init
+	 * ordering for every legacy/helper path too.
+	 */
+	ret = exynos7580_crtc_enable_link(ex);
+	if (ret) {
+		DRM_ERROR("[CRTC:%d] DSI link enable failed: %d\n",
+			  crtc->base.id, ret);
+		drm_vblank_post_modeset(crtc->dev, idx);
+		return ret;
+	}
+
+	mutex_lock(&crtc_lock);
+	crtc_link.needs_full_modeset = false;
+	mutex_unlock(&crtc_lock);
+
+	drm_vblank_post_modeset(crtc->dev, idx);
+
+	return 0;
+}
+
+static void exynos7580_crtc_enable(struct drm_crtc *crtc)
+{
+	struct exynos7580_device *ex = crtc_to_ex(crtc);
+
+	/* commit_post_planes(): the modeset already ran in mode_set(). */
+	if (exynos7580_crtc_enable_link(ex))
+		DRM_ERROR("[CRTC:%d] link enable failed\n", crtc->base.id);
+}
+
+static void exynos7580_crtc_disable(struct drm_crtc *crtc)
+{
+	struct exynos7580_device *ex = crtc_to_ex(crtc);
+
+	/*
+	 * Drop the vblank reference/armed events before the pipe goes away
+	 * (3.10 API: there is no drm_crtc_vblank_off()).  KmsFence armed any
+	 * pending flip event with drm_vblank_get(); drm_vblank_off() makes the
+	 * core drop those references so a disable cannot leave the vblank
+	 * machinery on.
+	 */
+	pr_info("[CRTC:%d] crtc_disable by %s\n", crtc->base.id, current->comm);
+	drm_vblank_off(crtc->dev, drm_crtc_index(crtc));
+
+	/* Encoder ->disable already ran (s_stream(0)); this is idempotent. */
+	exynos7580_crtc_disable_link(ex);
+}
+
+static void exynos7580_crtc_dpms(struct drm_crtc *crtc, int mode)
+{
+	/* Legacy/helper fallback only; the atomic path uses enable/disable. */
+	pr_info("[CRTC:%d] dpms mode=%d by %s\n", crtc->base.id, mode,
+		current->comm);
+	if (mode == DRM_MODE_DPMS_ON)
+		exynos7580_crtc_enable(crtc);
+	else
+		exynos7580_crtc_disable(crtc);
+}
+
+static int exynos7580_crtc_atomic_check(struct drm_crtc *crtc,
+					struct drm_crtc_state *state)
+{
+	struct drm_atomic_state *astate = state->state;
+	bool modeset;
+
+	if (WARN_ON(!astate))
+		return -EINVAL;
+
+	/* "active without enabled" is a core error, checked before us, but a
+	 * CRTC cannot be enabled without being active either. */
+	if (state->enable && !state->active)
+		return -EINVAL;
+
+	if (!state->active)
+		return 0;
+
+	/*
+	 * int91: the link flags are only a hint for THIS commit.  The old code
+	 * forced mode_changed whenever needs_full_modeset was set and never
+	 * cleared it outside crtc->mode_set(), so a stale flag turned every
+	 * later plane-only commit into a full modeset and drm_atomic_check_only()
+	 * rejected it with -EINVAL when the client (KWin) did not pass
+	 * DRM_MODE_ATOMIC_ALLOW_MODESET.
+	 *
+	 * Decide from the real transition:
+	 *  - activating (inactive -> active): the commit already calls
+	 *    enable_link() (exynos7580_crtc_enabling()), so no forcing;
+	 *  - mode/active change: already a full modeset;
+	 *  - link really off while staying active (disable/pm cycle): DECON
+	 *    registers are gone, so this commit must re-init the pipe.  Only
+	 *    legal with ALLOW_MODESET; without it the commit cannot be served
+	 *    safely and is rejected (the log names link_off);
+	 *  - link on: a stale needs_full_modeset cannot force anything; the
+	 *    next enable_link()/mode_set() clears it.
+	 */
+	{
+		bool link_on, needs, activating, forced = false;
+
+		mutex_lock(&crtc_lock);
+		link_on = crtc_link.on;
+		needs = crtc_link.needs_full_modeset;
+		mutex_unlock(&crtc_lock);
+
+		activating = state->active && state->enable &&
+			     (!crtc->state || !crtc->state->active);
+		modeset = state->mode_changed || state->active_changed ||
+			  activating;
+
+		if (!modeset && needs && !link_on) {
+			if (!astate->allow_modeset) {
+				pr_info("[CRTC:%d] atomic_check: link_off plane-only commit without ALLOW_MODESET -> -EINVAL (needs_full_modeset=%d link_on=%d)\n",
+					crtc->base.id, needs, link_on);
+				return -EINVAL;
+			}
+			state->mode_changed = true;
+			modeset = true;
+			forced = true;
+		}
+		pr_info("[CRTC:%d] atomic_check: needs_full_modeset=%d link_on=%d activating=%d mode_changed=%d active_changed=%d allow_modeset=%d modeset=%d%s\n",
+			crtc->base.id, needs, link_on, activating,
+			state->mode_changed, state->active_changed,
+			astate->allow_modeset, modeset,
+			forced ? " (forced: link_off)" : "");
+	}
+
+	/*
+	 * DeconPlane commits the frame from its last plane hook, so a commit
+	 * that activates the CRTC but carries no plane would leave the pipe
+	 * running with no window and no frame ever programmed.  Every real
+	 * client (modetest -s, kmscube, KWin) sends the primary plane with the
+	 * modeset; reject the pathological case instead of scanning out black.
+	 */
+	if (modeset && !exynos7580_crtc_state_has_plane(astate, crtc->primary)) {
+		DRM_DEBUG_KMS("[CRTC:%d] modeset without the primary plane\n",
+			      crtc->base.id);
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
+static void exynos7580_crtc_atomic_begin(struct drm_crtc *crtc)
+{
+	/*
+	 * The DECON commit engine opens and closes the window shadow protection
+	 * itself (decon_export_update_regs() -> __decon_update_regs()), so there
+	 * is nothing to protect here.
+	 */
+	DRM_DEBUG_KMS("[CRTC:%d] frame begin\n", crtc->base.id);
+}
+
+static void exynos7580_crtc_atomic_flush(struct drm_crtc *crtc)
+{
+	struct exynos7580_device *ex = crtc_to_ex(crtc);
+
+	/*
+	 * No decon_kms_commit() here - DeconPlane issued it from
+	 * commit_planes(), which runs between atomic_begin() and this hook.
+	 * Only re-assert the link so a commit that was not a modeset cannot
+	 * leave the pipe disabled (e.g. after a failed earlier enable) and log
+	 * the frame for bring-up.
+	 */
+	if (crtc->state && crtc->state->active && exynos7580_crtc_enable_link(ex))
+		DRM_ERROR("[CRTC:%d] link re-assert failed\n", crtc->base.id);
+
+	DRM_DEBUG_KMS("[CRTC:%d] frame flush\n", crtc->base.id);
+}
+
+/*
+ * int69: the 3.10 fbdev path calls these unconditionally:
+ *   - drm_fb_helper_setcmap() ends with crtc_funcs->load_lut(crtc);
+ *   - drm_fb_helper_restore_lut_atomic()/drm_mode_gamma_set_ioctl() use
+ *     crtc->funcs->gamma_set (the ioctl rejects a NULL one, the restore path
+ *     checks it, but a no-op makes both harmless).
+ * The fbdev palette is a pseudo-palette in truecolor mode, so there is no
+ * hardware LUT to program: both are logging no-ops.
+ */
+static void exynos7580_crtc_load_lut(struct drm_crtc *crtc)
+{
+	DRM_DEBUG_KMS("load_lut (no HW LUT, pseudo-palette only)\n");
+}
+
+static void exynos7580_crtc_gamma_set(struct drm_crtc *crtc, u16 *r,
+				      u16 *g, u16 *b, uint32_t start,
+				      uint32_t size)
+{
+	DRM_DEBUG_KMS("gamma_set start=%u size=%u (no HW LUT)\n", start, size);
+}
+
+static const struct drm_crtc_helper_funcs exynos7580_crtc_helper_funcs = {
+	.dpms		= exynos7580_crtc_dpms,
+	.load_lut	= exynos7580_crtc_load_lut,
+	.mode_fixup	= exynos7580_crtc_mode_fixup,
+	.mode_set	= exynos7580_crtc_mode_set,
+	.disable	= exynos7580_crtc_disable,
+	.enable		= exynos7580_crtc_enable,
+	.atomic_check	= exynos7580_crtc_atomic_check,
+	.atomic_begin	= exynos7580_crtc_atomic_begin,
+	.atomic_flush	= exynos7580_crtc_atomic_flush,
+};
+
+/* ------------------------------------------------------------------------ */
+/* crtc funcs                                                               */
+/* ------------------------------------------------------------------------ */
+
+static int exynos7580_crtc_page_flip(struct drm_crtc *crtc,
+				     struct drm_framebuffer *fb,
+				     struct drm_pending_vblank_event *event)
+{
+	struct drm_device *dev = crtc->dev;
+	struct drm_plane *plane = crtc->primary;
+	struct drm_modeset_acquire_ctx ctx;
+	struct drm_atomic_state *state;
+	struct drm_crtc_state *crtc_state;
+	struct drm_plane_state *plane_state;
+	int ret;
+
+	/*
+	 * A local acquire context, not the legacy global one: the global
+	 * context never drops the per-object modeset locks after a successful
+	 * commit, so the first flip worked and the second one blocked forever
+	 * in drm_atomic_get_crtc_state().  This mirrors the atomic ioctl and
+	 * releases every lock it took when it returns.
+	 */
+	drm_modeset_acquire_init(&ctx, 0);
+
+retry:
+	state = drm_atomic_state_alloc(dev);
+	if (!state) {
+		ret = -ENOMEM;
+		goto out;
+	}
+	state->acquire_ctx = &ctx;
+
+	crtc_state = drm_atomic_get_crtc_state(state, crtc);
+	if (IS_ERR(crtc_state)) {
+		ret = PTR_ERR(crtc_state);
+		goto fail;
+	}
+	crtc_state->event = event;
+
+	plane_state = drm_atomic_get_plane_state(state, plane);
+	if (IS_ERR(plane_state)) {
+		ret = PTR_ERR(plane_state);
+		goto fail;
+	}
+	ret = drm_atomic_set_crtc_for_plane(plane_state, crtc);
+	if (ret)
+		goto fail;
+	drm_atomic_set_fb_for_plane(plane_state, fb);
+
+	/* Full-frame source/destination from the current mode. */
+	{
+		struct drm_display_mode *mode = &crtc->state->mode;
+
+		plane_state->src_x = 0;
+		plane_state->src_y = 0;
+		plane_state->src_w = mode->hdisplay << 16;
+		plane_state->src_h = mode->vdisplay << 16;
+		plane_state->crtc_x = 0;
+		plane_state->crtc_y = 0;
+		plane_state->crtc_w = mode->hdisplay;
+		plane_state->crtc_h = mode->vdisplay;
+	}
+
+	pr_info("exynos7580_page_flip: state=%p crtc event=%p fb=%p\n",
+		state, crtc_state->event, fb);
+
+	crtc->fb = fb;	/* legacy pre-check in drm_mode_page_flip_ioctl */
+
+	ret = drm_atomic_async_commit(state);
+	if (ret == -EDEADLK) {
+		drm_atomic_state_clear(state);
+		drm_modeset_backoff(&ctx);
+		goto retry;
+	}
+	if (ret)
+		goto fail;
+
+	plane->fb = plane->state->fb;
+	crtc->fb = plane->state->fb;
+	drm_modeset_drop_locks(&ctx);
+	drm_modeset_acquire_fini(&ctx);
+	return 0;
+
+fail:
+	drm_atomic_state_free(state);
+out:
+	drm_modeset_drop_locks(&ctx);
+	drm_modeset_acquire_fini(&ctx);
+	return ret;
+}
+
+static void exynos7580_crtc_destroy(struct drm_crtc *crtc)
+{
+	drm_crtc_cleanup(crtc);
+}
+
+static const struct drm_crtc_funcs exynos7580_crtc_funcs = {
+	.set_config		= drm_atomic_helper_set_config,
+	.page_flip		= exynos7580_crtc_page_flip,
+	.reset			= drm_atomic_helper_crtc_reset,
+	.atomic_duplicate_state	= drm_atomic_helper_crtc_duplicate_state,
+	.atomic_destroy_state	= drm_atomic_helper_crtc_destroy_state,
+	.gamma_set		= exynos7580_crtc_gamma_set,
+	.destroy		= exynos7580_crtc_destroy,
+};
+
+/* ------------------------------------------------------------------------ */
+/* init                                                                     */
+/* ------------------------------------------------------------------------ */
+
+int exynos7580_crtc_init(struct exynos7580_device *ex)
+{
+	struct drm_device *drm;
+	struct drm_crtc *crtc;
+	int ret;
+
+	if (!ex || !ex->drm)
+		return -EINVAL;
+	if (!ex->decon)
+		return -ENODEV;
+
+	/*
+	 * The primary plane must exist before the CRTC: drm_crtc_init_with_planes()
+	 * links them and derives possible_crtcs.  exynos7580_planes_init() is
+	 * therefore required to run first (integration order, documented).
+	 */
+	if (!ex->num_planes)
+		return -EINVAL;
+
+	drm = ex->drm;
+	crtc = &ex->crtc;
+
+	crtc_link.on = false;
+	crtc_link.needs_full_modeset = true;
+
+	ret = drm_crtc_init_with_planes(drm, crtc, &ex->planes[0], NULL,
+					&exynos7580_crtc_funcs);
+	if (ret) {
+		DRM_ERROR("drm_crtc_init_with_planes failed: %d\n", ret);
+		return ret;
+	}
+
+	drm_crtc_helper_add(crtc, &exynos7580_crtc_helper_funcs);
+
+	/*
+	 * int80: the legacy gamma ioctls require a non-zero gamma_size;
+	 * without it drm_mode_gamma_set_ioctl returns -EINVAL ("failed to set
+	 * gamma: Invalid argument").  The CRTC has no hardware LUT (truecolor),
+	 * so a 256-entry software store is enough for the ioctl to succeed and
+	 * .gamma_set/.load_lut stay no-ops.
+	 */
+	if (!crtc->gamma_size) {
+		crtc->gamma_size = 256;
+		crtc->gamma_store = kzalloc(crtc->gamma_size * 3 * sizeof(u16),
+					    GFP_KERNEL);
+	}
+
+	/*
+	 * drm_mode_config_reset() normally allocates the initial CRTC state; do
+	 * it here as well so a driver that never calls it cannot crash the
+	 * atomic helpers on a NULL crtc->state.
+	 */
+	if (!crtc->state)
+		drm_atomic_helper_crtc_reset(crtc);
+	if (!crtc->state)
+		return -ENOMEM;
+
+	DRM_INFO("DECON CRTC registered (index %d, atomic)\n",
+		 drm_crtc_index(crtc));
+
+	return 0;
+}
+
+/* ------------------------------------------------------------------------ */
+/* drm_device mode_config ops                                               */
+/* ------------------------------------------------------------------------ */
+
+/*
+ * These two are the drivers' mode_config.funcs.atomic_check/atomic_commit.
+ * They are the only symbols this file exports beyond the header contract:
+ * the header assigns the CRTC to this file but has no accessor for the
+ * mode_config function table, which the main slice has to fill (it also owns
+ * fb_create).  Reported to the integration seat; no header edit was made.
+ */
+
+/* int90 diagnostic: one line per plane/crtc in a commit state. */
+static void exynos7580_dump_atomic_state(const char *where,
+					 struct drm_device *drm,
+					 struct drm_atomic_state *state)
+{
+	int i;
+
+	pr_info("exynos7580_atomic[%s]: state=%p allow_modeset=%d nplanes=%d ncrtcs=%d by %s\n",
+		where, state, state->allow_modeset,
+		drm->mode_config.num_total_plane, drm->mode_config.num_crtc,
+		current->comm);
+	for (i = 0; i < drm->mode_config.num_total_plane; i++) {
+		struct drm_plane *p = state->planes[i];
+		struct drm_plane_state *ps = state->plane_states[i];
+
+		if (!p)
+			continue;
+		pr_info("  plane[%d] id=%d crtc=%p fb=%p fmt=0x%08x src=(0x%x,0x%x,0x%x,0x%x) dst=%ux%u%+d%+d\n",
+			i, p->base.id, ps->crtc, ps->fb,
+			ps->fb ? ps->fb->pixel_format : 0,
+			ps->src_x, ps->src_y, ps->src_w, ps->src_h,
+			ps->crtc_w, ps->crtc_h, ps->crtc_x, ps->crtc_y);
+	}
+	for (i = 0; i < drm->mode_config.num_crtc; i++) {
+		struct drm_crtc *c = state->crtcs[i];
+		struct drm_crtc_state *cs = state->crtc_states[i];
+
+		if (!c)
+			continue;
+		pr_info("  crtc[%d] id=%d active=%d enable=%d mode_changed=%d active_changed=%d planes_changed=%d mode_blob=%p\n",
+			i, c->base.id, cs->active, cs->enable,
+			cs->mode_changed, cs->active_changed,
+			cs->planes_changed, cs->mode_blob);
+	}
+}
+
+int exynos7580_atomic_check(struct drm_device *drm,
+			    struct drm_atomic_state *state)
+{
+	int ret;
+
+	exynos7580_dump_atomic_state("check-enter", drm, state);
+	ret = drm_atomic_helper_check(drm, state);
+	pr_info("exynos7580_atomic_check: drm_atomic_helper_check rc=%d\n", ret);
+	if (ret)
+		exynos7580_dump_atomic_state("check-failed", drm, state);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(exynos7580_atomic_check);
+
+int exynos7580_atomic_commit(struct drm_device *drm,
+			     struct drm_atomic_state *state, bool async)
+{
+	struct exynos7580_device *ex = to_exynos7580(drm);
+	int i, ret;
+
+	if (WARN_ON(!ex || !ex->decon))
+		return -ENODEV;
+
+	exynos7580_dump_atomic_state("commit-enter", drm, state);
+
+	/*
+	 * Step (a): bring the display up before the software state is swapped,
+	 * so a failing DSI link / panel init aborts the commit cleanly and
+	 * userspace can report it.  Every later step can no longer fail.
+	 */
+	for (i = 0; i < drm->mode_config.num_crtc; i++) {
+		struct drm_crtc *crtc = state->crtcs[i];
+		struct drm_crtc_state *cs = state->crtc_states[i];
+
+		if (!crtc || !cs)
+			continue;
+		if (!exynos7580_crtc_enabling(cs, crtc->state))
+			continue;
+
+		ret = exynos7580_crtc_enable_link(ex);
+		pr_info("exynos7580_atomic_commit: enable_link rc=%d\n", ret);
+		if (ret) {
+			DRM_ERROR("commit aborted: DECON/DSI bring-up failed: %d\n",
+				  ret);
+			return ret;
+		}
+	}
+
+	/* Step (b) */
+	ret = drm_atomic_helper_prepare_planes(drm, state);
+	pr_info("exynos7580_atomic_commit: prepare_planes rc=%d\n", ret);
+	if (ret) {
+		exynos7580_dump_atomic_state("prepare-failed", drm, state);
+		return ret;
+	}
+
+	/* Step (c) */
+	drm_atomic_helper_swap_state(drm, state);
+	pr_info("exynos7580_atomic_commit: swap_state done\n");
+
+	/*
+	 * Step (d): KmsFence's complete tail (pre/commit/post planes, flip event
+	 * arming at the next vblank, wait, cleanup and drm_atomic_state_free).
+	 * M1 is synchronous: a NONBLOCK/PAGE_FLIP_EVENT request gets exactly the
+	 * same tail and is completed by the event, which is what KWin requires.
+	 */
+	pr_info("exynos7580_atomic_commit: async=%d crtc->fb=%p primary->state->fb=%p by %s\n",
+		async, drm->mode_config.crtc_list.next ?
+			container_of(drm->mode_config.crtc_list.next,
+				     struct drm_crtc, head)->fb : NULL,
+		drm->mode_config.crtc_list.next ?
+			container_of(drm->mode_config.crtc_list.next,
+				     struct drm_crtc, head)->primary->state ?
+			container_of(drm->mode_config.crtc_list.next,
+				     struct drm_crtc, head)->primary->state->fb : NULL : NULL,
+		current->comm);
+	exynos7580_commit_tail(state);
+	pr_info("exynos7580_atomic_commit: commit_tail done\n");
+
+	/*
+	 * int82: the 3.10 legacy fields are still consulted by the core:
+	 * drm_mode_page_flip_ioctl() returns -EBUSY when crtc->fb is NULL, and
+	 * drm_crtc_helper paths read crtc->fb.  The atomic commit path does not
+	 * maintain them, so sync them here (plane->fb is handled by the
+	 * helper's page_flip TODO; do it for all cases).
+	 */
+	{
+		struct drm_crtc *c;
+
+		list_for_each_entry(c, &drm->mode_config.crtc_list, head) {
+			struct drm_plane *p = c->primary;
+
+			if (p && p->state) {
+				p->fb = p->state->fb;
+				c->fb = p->state->fb;
+			}
+		}
+	}
+
+	return 0;
+}
+EXPORT_SYMBOL_GPL(exynos7580_atomic_commit);
diff -u -Naur a/drivers/gpu/drm/exynos7580/exynos_drm7580_dmabuf.c b/drivers/gpu/drm/exynos7580/exynos_drm7580_dmabuf.c
--- a/drivers/gpu/drm/exynos7580/exynos_drm7580_dmabuf.c
+++ b/drivers/gpu/drm/exynos7580/exynos_drm7580_dmabuf.c
@@ -0,0 +1,973 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * gpu31-kms: dma-buf import and framebuffer creation for the DECON KMS device.
+ *
+ * KmsDmabuf slice of docs/reports/decon-kms-plan.md (M2: "dma-buf import into
+ * KMS ... GBM allocation from panfrost exported to KMS").  This file implements
+ * the three entry points the shared contract header assigns to it:
+ *
+ *   exynos7580_gem_prime_import()  dma-buf fd -> GEM object (DRM_PRIME)
+ *   exynos7580_fb_create()         ADDFB2 -> framebuffer wrapping that GEM
+ *   exynos7580_fb_scanout()        framebuffer -> DECON IOVA, for the plane
+ *
+ * The driver's GEM backend is the CMA helper (exynos_drm7580_main.c:
+ * .gem_free_object = drm_gem_cma_free_object, .dumb_create =
+ * drm_gem_cma_dumb_create), so every object this file produces is a
+ * struct drm_gem_cma_object:
+ *
+ *   - imported dma-buf: a wrapper with base.import_attach set and the
+ *     exporter's sg table in base.driver_private.  The helper's free path is
+ *     made import-aware by patches/drm-kms/0005-core-drm-gem-cma-import-free.patch
+ *     (this tree's drm_gem_cma_free_object predates PRIME import and would
+ *     otherwise dma_free_attrs() the exporter's pages).
+ *   - dumb buffer: the genuine CMA object drm_gem_cma_dumb_create() made.
+ *
+ * drm_gem_prime_import() itself is not called: it requires
+ * dev->driver->gem_prime_import_sg_table, which is not part of this driver's
+ * contract.  The attach/map/object sequence below is the same code with the
+ * wrapper allocation inlined.
+ *
+ * Why iovmm_map() and not ion_iovmm_map(): ion_iovmm_map() BUG_ON()s on a
+ * dma-buf whose ops are not ION's (drivers/staging/android/ion/ion.c:2643),
+ * so a panfrost/GEM buffer imported through it panics the kernel.  iovmm_map()
+ * is the generic exynos primitive ion_iovmm_map() itself calls
+ * (include/linux/exynos_iovmm.h:47) and is exporter-agnostic.
+ *
+ * IOVA vs DMA address: a DECON window register takes an address in the DECON
+ * device's SYSMMU/IOVMM domain (the vendor path maps through ion_iovmm_map;
+ * exynos-iovmm-v6.c uses IOVA_START_V6 == 0x10000000).  A dma-buf's
+ * sg_dma_address() and a CMA object's paddr are DMA-direct/physical addresses
+ * and are NOT usable as window addresses, so exynos7580_fb_scanout() returns
+ * only properly iovmm_map()ed addresses.
+ *
+ * Modifiers: this tree's UAPI is 3.10 ADDFB2 (struct drm_mode_fb_cmd2 has no
+ * modifiers[]/DRM_MODE_FB_MODIFIERS); the driver advertises no IN_FORMATS, so
+ * every non-zero mode_cmd->flags value is rejected here.
+ */
+
+#include <linux/dma-buf.h>
+#include <linux/module.h>
+#include <linux/err.h>
+#include <linux/slab.h>
+#include <linux/exynos_iovmm.h>
+
+#include <drm/drmP.h>
+#include <drm/drm_crtc.h>
+#include <drm/drm_crtc_helper.h>
+#include <drm/drm_gem_cma_helper.h>
+#include <drm/drm_fb_cma_helper.h>
+#include <drm/drm_fourcc.h>
+
+#include "exynos_drm7580.h"
+#include <linux/dma-buf.h>
+#include <linux/module.h>
+
+unsigned int exynos7580_dump_fb;
+module_param(exynos7580_dump_fb, uint, 0644);
+MODULE_PARM_DESC(exynos7580_dump_fb,
+	"1 = log three scanout pixels of the next committed frame, then clear");
+
+/*
+ * Sample the pixels the DECON is about to scan out.  The buffer is an
+ * imported dma-buf (panfrost GBM), so map it through the exporter instead of
+ * assuming any CPU address.
+ */
+static void exynos7580_dump_pixels(struct drm_framebuffer *fb, const char *tag)
+{
+	struct drm_gem_object *obj;
+	void *map;
+	const u32 ys[6] = { 10, 28, 45, 100, 640, 1200 };
+	unsigned int pitch, i;
+
+	if (!fb || !fb->pitches[0])
+		return;
+	obj = drm_fb_cma_get_gem_obj(fb, 0);
+	if (!obj || !obj->import_attach || !obj->import_attach->dmabuf) {
+		pr_info("scanout-dump[%s]: no imported dmabuf\n", tag);
+		return;
+	}
+	if (dma_buf_begin_cpu_access(obj->import_attach->dmabuf, 0,
+				     obj->size, DMA_FROM_DEVICE)) {
+		pr_info("scanout-dump[%s]: begin_cpu_access failed\n", tag);
+		return;
+	}
+	map = dma_buf_vmap(obj->import_attach->dmabuf);
+	if (!map) {
+		pr_info("scanout-dump[%s]: vmap failed\n", tag);
+		dma_buf_end_cpu_access(obj->import_attach->dmabuf, 0,
+				       obj->size, DMA_FROM_DEVICE);
+		return;
+	}
+	pitch = fb->pitches[0];
+	for (i = 0; i < 6; i++) {
+		unsigned int y = ys[i] < fb->height ? ys[i] : fb->height - 1;
+		u32 px = ((const u32 *)((const u8 *)map + y * pitch))[360];
+		pr_info("scanout-dump[%s]: %ux%u y=%u px=%08x\n",
+			tag, fb->width, fb->height, y, px);
+	}
+	/* Coarse 6x10 grid: enough to see whether the scanned frame is the
+	 * wallpaper, a dark UI, or a clear frame. */
+	{
+		unsigned int gy, gx;
+		for (gy = 0; gy < 6; gy++) {
+			u32 row[10];
+			unsigned int yy = (fb->height * (gy * 2 + 1)) / 12;
+			const u32 *line = (const u32 *)((const u8 *)map + yy * pitch);
+			for (gx = 0; gx < 10; gx++)
+				row[gx] = line[(fb->width * (gx * 2 + 1)) / 20];
+			pr_info("grid[%s] %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x\n",
+				tag, row[0], row[1], row[2], row[3], row[4],
+				row[5], row[6], row[7], row[8], row[9]);
+		}
+	}
+	dma_buf_vunmap(obj->import_attach->dmabuf, map);
+	dma_buf_end_cpu_access(obj->import_attach->dmabuf, 0, obj->size,
+			       DMA_FROM_DEVICE);
+}
+
+static struct drm_framebuffer *exynos7580_dump_late_fb;
+static void exynos7580_dump_late_fn(struct work_struct *w)
+{
+	if (exynos7580_dump_late_fb) {
+		exynos7580_dump_pixels(exynos7580_dump_late_fb, "t200ms");
+		drm_framebuffer_unreference(exynos7580_dump_late_fb);
+		exynos7580_dump_late_fb = NULL;
+	}
+}
+static DECLARE_DELAYED_WORK(exynos7580_dump_late_work, exynos7580_dump_late_fn);
+
+/*
+ * Sample the frame twice: right after the commit returns and again 200 ms
+ * later.  This tree's struct dma_buf carries no reservation object, so there
+ * is nothing to wait on directly; the two samples distinguish "rendering
+ * finishes late" from "rendering never completes".
+ */
+void exynos7580_dump_scanout(struct drm_framebuffer *fb)
+{
+	if (!fb)
+		return;
+	exynos7580_dump_fb = 0;
+	exynos7580_dump_pixels(fb, "t0");
+	drm_framebuffer_reference(fb);
+	exynos7580_dump_late_fb = fb;
+	schedule_delayed_work(&exynos7580_dump_late_work, msecs_to_jiffies(200));
+}
+EXPORT_SYMBOL_GPL(exynos7580_dump_scanout);
+
+/**
+ * exynos7580_fb_is_blank() - is the whole scanout buffer zero?
+ *
+ * A panfrost job that faults leaves KWin's buffer untouched (all zeroes,
+ * alpha included).  Programming that frame makes the panel flash black for
+ * one refresh; the plane code uses this to keep the previous frame instead.
+ * The check is a cheap vmap of four rows, not a full scan.
+ */
+bool exynos7580_fb_is_blank(struct drm_framebuffer *fb)
+{
+	struct drm_gem_object *obj;
+	void *map;
+	u32 seen[4] = { 0, 0, 0, 0 };
+	unsigned int nseen = 0, y, x, i, total = 0, dark = 0;
+	bool blank, dup;
+
+	if (!fb || !fb->pitches[0] || !fb->height)
+		return false;
+	obj = drm_fb_cma_get_gem_obj(fb, 0);
+	if (!obj || !obj->import_attach || !obj->import_attach->dmabuf)
+		return false;
+	if (dma_buf_begin_cpu_access(obj->import_attach->dmabuf, 0,
+				     obj->size, DMA_FROM_DEVICE))
+		return false;
+	map = dma_buf_vmap(obj->import_attach->dmabuf);
+	if (!map) {
+		dma_buf_end_cpu_access(obj->import_attach->dmabuf, 0,
+				       obj->size, DMA_FROM_DEVICE);
+		return false;
+	}
+	/*
+	 * An unrendered KWin frame is a clear colour or two (00000000 /
+	 * ff000000 / ff161616) plus whatever the status bar draws on top of
+	 * it, so counting colours alone lets a mostly-black frame through.
+	 * Count near-black samples as well: 90% of the panel at (or below)
+	 * 0x0f per channel is a clear frame, not a picture.
+	 */
+	for (y = 0; y < fb->height; y++) {
+		const u32 *row = (const u32 *)((const u8 *)map + y * fb->pitches[0]);
+
+		for (x = 0; x < fb->width; x += 4) {
+			u32 cur = row[x];
+
+			total++;
+			if ((cur & 0x00f0f0f0u) == 0)
+				dark++;
+			if (nseen == 4)
+				continue;
+			dup = false;
+			for (i = 0; i < nseen; i++)
+				if (seen[i] == cur) {
+					dup = true;
+					break;
+				}
+			if (!dup)
+				seen[nseen++] = cur;
+		}
+	}
+	dma_buf_vunmap(obj->import_attach->dmabuf, map);
+	dma_buf_end_cpu_access(obj->import_attach->dmabuf, 0, obj->size,
+			       DMA_FROM_DEVICE);
+	/*
+	 * A clear frame is one or two uniform values (00000000 / ff000000 /
+	 * ff161616 / ff616161).  A dark theme with a panel is *three or more*
+	 * colours and must not be mistaken for a clear frame: rejecting it
+	 * freezes the panel on the shadow image.  The dark count is kept in
+	 * the log for diagnosis only.
+	 */
+	blank = (nseen <= 2);
+	pr_info("exynos7580: fb %u blank=%d colours=%u dark=%u/%u %08x %08x %08x %08x\n",
+		fb->base.id, blank, nseen, dark, total,
+		seen[0], seen[1], seen[2], seen[3]);
+	return blank;
+}
+EXPORT_SYMBOL_GPL(exynos7580_fb_is_blank);
+
+/*
+ * Shadow frame copies.
+ *
+ * KWin's buffer is released to it as soon as the flip event is sent (this
+ * stack sends it at commit time), so a buffer still being scanned out can be
+ * rewritten by the compositor's next frame - and that frame may be the clear
+ * one produced when a panfrost job fails.  The panel then goes black even
+ * though the driver never programmed a blank frame.  These helpers let the
+ * plane code keep a complete frame and put it into the buffer it is about to
+ * program, so client buffer recycling cannot black the panel.
+ */
+static int exynos7580_fb_cpu_map(struct drm_framebuffer *fb,
+				 struct dma_buf **out, void **map,
+				 enum dma_data_direction dir)
+{
+	struct drm_gem_object *obj;
+	struct dma_buf *db;
+	void *m;
+
+	if (!fb || !fb->pitches[0] || !fb->height)
+		return -EINVAL;
+	obj = drm_fb_cma_get_gem_obj(fb, 0);
+	if (!obj)
+		return -ENODEV;
+	if (!obj->import_attach || !obj->import_attach->dmabuf) {
+		/* CMA/dumb buffer: the kernel mapping is permanent. */
+		*out = NULL;
+		*map = to_drm_gem_cma_obj(obj)->vaddr;
+		return *map ? 0 : -ENOMEM;
+	}
+	db = obj->import_attach->dmabuf;
+	if (dma_buf_begin_cpu_access(db, 0, obj->size, dir))
+		return -EIO;
+	m = dma_buf_vmap(db);
+	if (!m) {
+		dma_buf_end_cpu_access(db, 0, obj->size, dir);
+		return -ENOMEM;
+	}
+	*out = db;
+	*map = m;
+	return 0;
+}
+
+static void exynos7580_fb_cpu_unmap(struct drm_framebuffer *fb,
+				    struct dma_buf *db, void *map,
+				    enum dma_data_direction dir)
+{
+	struct drm_gem_object *obj;
+
+	if (!db)
+		return;
+	obj = drm_fb_cma_get_gem_obj(fb, 0);
+	dma_buf_vunmap(db, map);
+	if (obj)
+		dma_buf_end_cpu_access(db, 0, obj->size, dir);
+}
+
+bool exynos7580_fb_shadow_read(struct drm_framebuffer *fb, void *shadow,
+			       unsigned int pitch)
+{
+	struct dma_buf *db;
+	void *map;
+	unsigned int y, n;
+
+	if (exynos7580_fb_cpu_map(fb, &db, &map, DMA_FROM_DEVICE))
+		return false;
+	n = min(fb->pitches[0], pitch);
+	for (y = 0; y < fb->height; y++)
+		memcpy((u8 *)shadow + y * pitch,
+		       (const u8 *)map + y * fb->pitches[0], n);
+	exynos7580_fb_cpu_unmap(fb, db, map, DMA_FROM_DEVICE);
+	return true;
+}
+EXPORT_SYMBOL_GPL(exynos7580_fb_shadow_read);
+
+bool exynos7580_fb_shadow_write(struct drm_framebuffer *fb, const void *shadow,
+				unsigned int pitch, size_t shadow_size)
+{
+	struct dma_buf *db;
+	void *map;
+	unsigned int y, rows, n;
+
+	if (!pitch || !shadow_size)
+		return false;
+	if (exynos7580_fb_cpu_map(fb, &db, &map, DMA_TO_DEVICE))
+		return false;
+	n = min(fb->pitches[0], pitch);
+	/* Never read past the shadow: it can be smaller than this frame when
+	 * a small (cursor) buffer was the last one cached. */
+	rows = min(fb->height, (unsigned int)(shadow_size / pitch));
+	for (y = 0; y < rows; y++)
+		memcpy((u8 *)map + y * fb->pitches[0],
+		       (const u8 *)shadow + y * pitch, n);
+	exynos7580_fb_cpu_unmap(fb, db, map, DMA_TO_DEVICE);
+	return true;
+}
+EXPORT_SYMBOL_GPL(exynos7580_fb_shadow_write);
+
+
+/* DECON windows are programmed with SYSMMU/IOVMM addresses; iovmm_map() only
+ * exists with one of these, and the display does not work without it. */
+#if !IS_ENABLED(CONFIG_EXYNOS_IOVMM) && !IS_ENABLED(CONFIG_EXYNOS_IOVMM_V6)
+#error "exynos_drm7580_dmabuf.c requires CONFIG_EXYNOS_IOVMM_V6"
+#endif
+
+
+/*
+ * How many fbdev (foreign CMA) framebuffers may have a cached DECON mapping.
+ * fbdev registers exactly one (fb0); the other slots only exist so an fb0 that
+ * is re-created after a failed probe/recovery does not exhaust the cache.
+ */
+#define EXYNOS7580_FOREIGN_MAPS		4
+
+/*
+ * ---------- framebuffer mode validation (pure, host-unit-tested) ----------
+ *
+ * The block between the BEGIN/END markers is compiled verbatim on the build
+ * host by code/gpu31/kms/tools/dmabuf/check.c (extracted with awk), so keep it
+ * free of kernel types, helpers and side effects.  The fourcc values are the
+ * DRM_FORMAT_* constants from include/uapi/drm/drm_fourcc.h, written out so
+ * this block needs no include.
+ */
+/* ---- BEGIN exynos7580_fb_check ---- */
+struct exy7580_fb_desc {
+	unsigned int	pixel_format;	/* DRM_FORMAT_* */
+	unsigned int	width;
+	unsigned int	height;
+	unsigned int	flags;		/* drm_mode_fb_cmd2.flags */
+	unsigned int	handles[4];
+	unsigned int	pitches[4];
+	unsigned int	offsets[4];
+	unsigned long long size;	/* bytes of the GEM object */
+	unsigned int	max_width;
+	unsigned int	max_height;
+};
+
+/* Bytes per pixel of an RGB format the DECON shim can program; 0 = no. */
+static unsigned int exy7580_format_bpp(unsigned int fourcc)
+{
+	switch (fourcc) {
+	case 0x34325258:	/* DRM_FORMAT_XRGB8888 */
+	case 0x34324258:	/* DRM_FORMAT_XBGR8888 */
+	case 0x34325852:	/* DRM_FORMAT_RGBX8888 */
+	case 0x34325842:	/* DRM_FORMAT_BGRX8888 */
+	case 0x34325241:	/* DRM_FORMAT_ARGB8888 */
+	case 0x34324241:	/* DRM_FORMAT_ABGR8888 */
+	case 0x34324152:	/* DRM_FORMAT_RGBA8888 */
+	case 0x34324142:	/* DRM_FORMAT_BGRA8888 */
+		return 32;
+	case 0x36314752:	/* DRM_FORMAT_RGB565 */
+	case 0x35314152:	/* DRM_FORMAT_RGBA5551 */
+		return 16;
+	default:
+		return 0;
+	}
+}
+
+/*
+ * exy7580_fb_check() - validate an ADDFB2 request for DECON scanout
+ *
+ * Only single-plane RGB formats are accepted: the primary/overlay windows
+ * scan out one buffer and the M2 userspace (KWin/kmscube) uses XRGB8888 or
+ * ARGB8888.  Planar YUV is left to a later change that also teaches the
+ * plane about the second IOVA plane (the plane slice already tolerates
+ * addr[1] == 0 for NV12/NV21 interleaved buffers).
+ *
+ * DECON hardware limits enforced here (see decon_core.c:1500-1600 and
+ * decon_validate_x_alignment()): a window must be at least 128 bytes wide,
+ * the stride must be whole pixels, and the buffer must hold the whole
+ * (stride, height) extent starting at the requested offset.
+ */
+static int exy7580_fb_check(const struct exy7580_fb_desc *d)
+{
+	unsigned int bpp, cpp, i;
+	unsigned long long stride, need;
+
+	if (!d)
+		return -EINVAL;
+
+	/* No modifiers, no interlace: this driver advertises neither. */
+	if (d->flags)
+		return -EINVAL;
+
+	if (!d->handles[0])
+		return -EINVAL;
+	for (i = 1; i < 4; i++)
+		if (d->handles[i] || d->pitches[i] || d->offsets[i])
+			return -EINVAL;
+
+	bpp = exy7580_format_bpp(d->pixel_format);
+	if (!bpp)
+		return -EINVAL;
+
+	if (!d->width || !d->height || !d->max_width || !d->max_height)
+		return -EINVAL;
+	if (d->width > d->max_width || d->height > d->max_height)
+		return -EINVAL;
+
+	cpp = bpp / 8;
+	stride = (unsigned long long)d->width * cpp;
+	if (stride < 128)		/* DECON: window < 128 bytes is -EINVAL */
+		return -EINVAL;
+
+	if (!d->pitches[0] || d->pitches[0] < stride)
+		return -EINVAL;
+	if (d->pitches[0] % cpp || d->offsets[0] % cpp)
+		return -EINVAL;
+
+	if (d->offsets[0] >= d->size)
+		return -EINVAL;
+	need = (unsigned long long)d->pitches[0] * (d->height - 1) +
+	       stride + d->offsets[0];
+	if (need > d->size)
+		return -EINVAL;
+
+	return 0;
+}
+/* ---- END exynos7580_fb_check ---- */
+
+/* ---------- our framebuffer object ---------- */
+
+/*
+ * Private framebuffer.  The GEM reference is held from fb_create() until
+ * exynos7580_fb_destroy(), so an imported dma-buf's attachment (and the sg
+ * table our IOVA mappings are built from) outlives every cached mapping.
+ */
+struct exynos7580_fb {
+	struct drm_framebuffer		fb;
+	struct drm_gem_cma_object	*cma;
+	dma_addr_t			scanout[4];	/* per plane, 0 = unmapped */
+};
+
+static inline struct exynos7580_fb *to_exynos7580_fb(struct drm_framebuffer *fb)
+{
+	return container_of(fb, struct exynos7580_fb, fb);
+}
+
+/*
+ * Serialises IOVA map creation against fb destruction and the foreign-fb
+ * cache.  iovmm_map()/iovmm_unmap() may sleep (iommu_map), so this is a mutex.
+ */
+static DEFINE_MUTEX(exynos7580_scanout_lock);
+
+#if IS_ENABLED(CONFIG_DRM_KMS_CMA_HELPER)
+struct exynos7580_foreign_map {
+	struct drm_framebuffer	*fb;
+	unsigned int		plane;
+	dma_addr_t		addr;
+};
+
+static struct exynos7580_foreign_map
+			exynos7580_foreign_maps[EXYNOS7580_FOREIGN_MAPS];
+#endif
+
+static void exynos7580_fb_destroy(struct drm_framebuffer *fb)
+{
+	struct exynos7580_fb *efb = to_exynos7580_fb(fb);
+	unsigned int i;
+
+	mutex_lock(&exynos7580_scanout_lock);
+	for (i = 0; i < ARRAY_SIZE(efb->scanout); i++) {
+		if (!efb->scanout[i])
+			continue;
+		iovmm_unmap(fb->dev->dev, efb->scanout[i]);
+		efb->scanout[i] = 0;
+	}
+	mutex_unlock(&exynos7580_scanout_lock);
+
+	drm_framebuffer_cleanup(fb);
+	drm_gem_object_unreference_unlocked(&efb->cma->base);
+	kfree(efb);
+}
+
+static int exynos7580_fb_create_handle(struct drm_framebuffer *fb,
+				       struct drm_file *file,
+				       unsigned int *handle)
+{
+	struct exynos7580_fb *efb = to_exynos7580_fb(fb);
+
+	return drm_gem_handle_create(file, &efb->cma->base, handle);
+}
+
+/*
+ * The DECON is not a rendering engine and there is no cache to flush: the
+ * dma-buf exporter's map_dma_buf() already performed the cache maintenance
+ * when the attachment was mapped DMA_BIDIRECTIONAL in the import.
+ */
+static int exynos7580_fb_dirty(struct drm_framebuffer *fb,
+			       struct drm_file *file, unsigned int flags,
+			       unsigned int color, struct drm_clip_rect *clips,
+			       unsigned int num_clips)
+{
+	return 0;
+}
+
+static const struct drm_framebuffer_funcs exynos7580_fb_funcs = {
+	.destroy	= exynos7580_fb_destroy,
+	.create_handle	= exynos7580_fb_create_handle,
+	.dirty		= exynos7580_fb_dirty,
+};
+
+/* ---------- scanout address resolution ---------- */
+
+/* Has a mapping for @plane been made already?  Returns 1 and the address. */
+static int exynos7580_scanout_cached(struct exynos7580_fb *efb,
+				     unsigned int plane, dma_addr_t *addr)
+{
+	int cached;
+
+	mutex_lock(&exynos7580_scanout_lock);
+	cached = efb->scanout[plane] != 0;
+	if (cached)
+		*addr = efb->scanout[plane];
+	mutex_unlock(&exynos7580_scanout_lock);
+
+	return cached;
+}
+
+/*
+ * exynos7580_map_plane() - map an sg list into the DECON IOVMM domain
+ *
+ * The mapping is cached in the framebuffer and released in
+ * exynos7580_fb_destroy(): KWin creates one fb per buffer, and the fb
+ * reference held by the atomic state keeps the mapping alive until the commit
+ * that stops scanning it has completed.
+ */
+static int exynos7580_map_plane(struct drm_framebuffer *fb, unsigned int plane,
+				struct sg_table *sgt, dma_addr_t *addr)
+{
+	struct exynos7580_fb *efb = to_exynos7580_fb(fb);
+	struct exynos7580_device *ex = to_exynos7580(fb->dev);
+	dma_addr_t iova;
+	size_t size;
+	int ret = 0;
+
+	if (!ex || !ex->dev || !sgt || !sgt->sgl)
+		return -ENODEV;
+
+	size = (size_t)fb->pitches[plane] * fb->height;
+
+	mutex_lock(&exynos7580_scanout_lock);
+	if (efb->scanout[plane]) {
+		*addr = efb->scanout[plane];
+		goto out;
+	}
+
+	iova = iovmm_map(ex->dev, sgt->sgl, fb->offsets[plane], size,
+			 DMA_TO_DEVICE, 0);
+	if (IS_ERR_VALUE(iova)) {
+		DRM_ERROR("iovmm_map() of %ux%u fb failed: %d\n",
+			  fb->width, fb->height, (int)iova);
+		ret = -ENODEV;
+		goto out;
+	}
+
+	efb->scanout[plane] = iova;
+	*addr = iova;
+out:
+	mutex_unlock(&exynos7580_scanout_lock);
+	return ret;
+}
+
+/*
+ * exynos7580_own_scanout() - address of a plane of one of our framebuffers
+ *
+ * Two backing kinds share the framebuffer type:
+ *   - an imported dma-buf: the exporter's sg table is in base.driver_private
+ *     (see exynos7580_gem_prime_import()), already mapped on the DECON device
+ *     with DMA_BIDIRECTIONAL;
+ *   - a dumb buffer (drm_gem_cma_dumb_create): physically contiguous CMA
+ *     memory, described by a one-entry sg table built on the fly.
+ */
+static int exynos7580_own_scanout(struct drm_framebuffer *fb,
+				  unsigned int plane, dma_addr_t *addr)
+{
+	struct exynos7580_fb *efb = to_exynos7580_fb(fb);
+	struct drm_gem_object *obj = &efb->cma->base;
+	struct sg_table sgt;
+	int ret;
+
+	if (plane != 0)		/* only single-plane formats are accepted */
+		return -EINVAL;
+
+	if (exynos7580_scanout_cached(efb, plane, addr))
+		return 0;
+
+	if (obj->import_attach)
+		return exynos7580_map_plane(fb, plane, obj->driver_private,
+					    addr);
+
+	if (!efb->cma->vaddr)
+		return -ENODEV;
+
+	/*
+	 * cma->vaddr is only the CPU mapping; the IOMMU needs the backing
+	 * pages, so build one sg entry per page from paddr.  Using vaddr here
+	 * (sg_set_buf) maps vmalloc memory and the panel shows stripes.
+	 */
+	{
+		unsigned long pfn = PFN_DOWN(efb->cma->paddr);
+		unsigned int npages = DIV_ROUND_UP(obj->size + (efb->cma->paddr & ~PAGE_MASK),
+						   PAGE_SIZE);
+		unsigned int i;
+		struct scatterlist *sg;
+
+		ret = sg_alloc_table(&sgt, npages, GFP_KERNEL);
+		if (ret)
+			return -ENODEV;
+		for_each_sg(sgt.sgl, sg, npages, i)
+			sg_set_page(sg, pfn_to_page(pfn + i), PAGE_SIZE,
+				    i == 0 ? (efb->cma->paddr & ~PAGE_MASK) : 0);
+	}
+	ret = exynos7580_map_plane(fb, plane, &sgt, addr);
+	sg_free_table(&sgt);
+
+	return ret;
+}
+
+/*
+ * exynos7580_foreign_scanout() - address of a plane of an fbdev/CMA fb
+ *
+ * fb0 is a drm_fb_cma framebuffer over a drm_gem_cma_create() object, whose
+ * paddr is a DMA-direct address and must not be programmed into a window.
+ * Build a one-entry sg table over the CMA object (CMA memory is physically
+ * contiguous) and map it into the DECON IOVMM domain like any other buffer.
+ *
+ * The mapping is cached per (fb, plane) and pins the framebuffer with a
+ * reference: the CMA helper's fb has no destroy hook this file can extend, and
+ * fb0 lives for the whole driver lifetime.  Cache exhaustion is -ENODEV.
+ */
+static int exynos7580_foreign_scanout(struct drm_framebuffer *fb,
+				      unsigned int plane, dma_addr_t *addr)
+{
+#if IS_ENABLED(CONFIG_DRM_KMS_CMA_HELPER)
+	struct drm_gem_cma_object *cma;
+	struct exynos7580_device *ex;
+	struct sg_table sgt;
+	dma_addr_t iova;
+	size_t size;
+	unsigned int i, slot = EXYNOS7580_FOREIGN_MAPS;
+	int ret = 0;
+
+	if (plane >= 4 || !fb->pitches[plane])
+		return -EINVAL;
+
+	ex = to_exynos7580(fb->dev);
+	if (!ex || !ex->dev)
+		return -ENODEV;
+
+	cma = drm_fb_cma_get_gem_obj(fb, plane);
+	if (!cma || !cma->vaddr)
+		return -ENODEV;
+
+	size = (size_t)fb->pitches[plane] * fb->height;
+	if ((unsigned long long)fb->offsets[plane] + size > cma->base.size)
+		return -EINVAL;
+
+	mutex_lock(&exynos7580_scanout_lock);
+	for (i = 0; i < EXYNOS7580_FOREIGN_MAPS; i++) {
+		if (exynos7580_foreign_maps[i].fb == fb &&
+		    exynos7580_foreign_maps[i].plane == plane) {
+			*addr = exynos7580_foreign_maps[i].addr;
+			goto out;
+		}
+		if (!exynos7580_foreign_maps[i].fb &&
+		    slot == EXYNOS7580_FOREIGN_MAPS)
+			slot = i;
+	}
+	if (slot == EXYNOS7580_FOREIGN_MAPS) {
+		DRM_ERROR("no slot left to map CMA fb %d\n", fb->base.id);
+		ret = -ENODEV;
+		goto out;
+	}
+
+	/*
+	 * cma->vaddr is the CPU mapping, not the backing storage: building the
+	 * sg from it (sg_set_buf) maps the vmalloc range and the controller
+	 * then scans unrelated memory (visible as stripe garbage).  CMA memory
+	 * is physically contiguous, so build one sg entry per page from paddr.
+	 */
+	{
+		unsigned long pfn = PFN_DOWN(cma->paddr + fb->offsets[plane]);
+		unsigned int npages = DIV_ROUND_UP(size + (cma->paddr + fb->offsets[plane]) % PAGE_SIZE,
+						   PAGE_SIZE);
+		unsigned int i;
+		struct scatterlist *sg;
+
+		ret = sg_alloc_table(&sgt, npages, GFP_KERNEL);
+		if (ret) {
+			ret = -ENODEV;
+			goto out;
+		}
+		for_each_sg(sgt.sgl, sg, npages, i)
+			sg_set_page(sg, pfn_to_page(pfn + i), PAGE_SIZE,
+				    i == 0 ? (cma->paddr + fb->offsets[plane]) % PAGE_SIZE : 0);
+	}
+
+	iova = iovmm_map(ex->dev, sgt.sgl, 0, size, DMA_TO_DEVICE, 0);
+	sg_free_table(&sgt);
+	if (IS_ERR_VALUE(iova)) {
+		DRM_ERROR("iovmm_map() of CMA fb %d failed: %d\n",
+			  fb->base.id, (int)iova);
+		ret = -ENODEV;
+		goto out;
+	}
+
+	exynos7580_foreign_maps[slot].fb = fb;
+	exynos7580_foreign_maps[slot].plane = plane;
+	exynos7580_foreign_maps[slot].addr = iova;
+	drm_framebuffer_reference(fb);
+	*addr = iova;
+out:
+	mutex_unlock(&exynos7580_scanout_lock);
+	return ret;
+#else
+	return -ENODEV;
+#endif
+}
+
+/**
+ * exynos7580_fb_scanout - DMA address of a plane of @fb in the DECON IOVA space
+ * @fb: framebuffer (ours, or the fbdev CMA framebuffer)
+ * @plane: plane index inside @fb; only 0 is supported (single-plane formats)
+ * @addr: output, valid until @fb is destroyed
+ *
+ * Returns 0, -EINVAL for a bad fb/plane/geometry, or -ENODEV when no scanout
+ * address can be produced (not our fb and not a CMA fb, missing DECON device
+ * or IOVMM domain, iovmm_map() failure).
+ *
+ * Process context only: the first call may sleep in iovmm_map().
+ */
+int exynos7580_fb_scanout(struct drm_framebuffer *fb, unsigned int plane,
+			  dma_addr_t *addr)
+{
+	int ret;
+
+	pr_info("exynos7580_fb_scanout: fb=%p plane=%u fmt=0x%08x %ux%u pitch=%u\n",
+		fb, plane, fb ? fb->pixel_format : 0,
+		fb ? fb->width : 0, fb ? fb->height : 0,
+		(fb && plane < 4) ? fb->pitches[plane] : 0);
+
+	if (!fb || !addr)
+		return -EINVAL;
+	if (plane >= 4 || !fb->pitches[plane]) {
+		pr_info("exynos7580_fb_scanout: FAIL bad fb/plane=%u pitch=%u\n",
+			plane, fb->pitches[0]);
+		return -EINVAL;
+	}
+
+	if (fb->funcs == &exynos7580_fb_funcs)
+		ret = exynos7580_own_scanout(fb, plane, addr);
+	else
+		ret = exynos7580_foreign_scanout(fb, plane, addr);
+
+	pr_info("exynos7580_fb_scanout: fb=%p plane=%u rc=%d addr=0x%llx\n",
+		fb, plane, ret, (ret == 0) ? (unsigned long long)*addr : 0ULL);
+	return ret;
+}
+
+/* ---------- dma-buf import ---------- */
+
+/**
+ * exynos7580_gem_prime_import - import a dma-buf as a scanout-capable GEM
+ * @drm: DECON KMS device
+ * @dma_buf: buffer to import (one reference held by the caller)
+ *
+ * Called only through dev->driver->gem_prime_import (drm_gem_prime_fd_to_handle)
+ * for a dma-buf that is not already cached in the file's PRIME table.
+ *
+ * Object shape: struct drm_gem_cma_object with base.import_attach set and the
+ * exporter's mapped sg table in base.driver_private.  The driver's
+ * gem_free_object (drm_gem_cma_free_object(), made import-aware by the core
+ * patch in this slice) then calls drm_prime_gem_destroy(obj,
+ * obj->driver_private), which unmaps the attachment, detaches it and drops the
+ * dma-buf reference taken below - no unmap/detach happens in this file after a
+ * successful import.
+ *
+ * References: the returned object carries one GEM reference (from
+ * drm_gem_object_init); drm_gem_prime_fd_to_handle() turns that into a handle
+ * and unreferences it.  The attachment owns one dma_buf reference (get_dma_buf)
+ * until drm_prime_gem_destroy().
+ */
+struct drm_gem_object *exynos7580_gem_prime_import(struct drm_device *drm,
+						   struct dma_buf *dma_buf)
+{
+	struct drm_gem_cma_object *cma;
+	struct dma_buf_attachment *attach;
+	struct sg_table *sgt;
+	size_t size;
+	int ret;
+
+	pr_info("exynos7580_gem_prime_import: enter dma_buf=%p size=%zu by %s\n",
+		dma_buf, dma_buf ? dma_buf->size : 0, current->comm);
+
+	if (!drm || !drm->dev || !dma_buf || !dma_buf->size)
+		return ERR_PTR(-EINVAL);
+
+	attach = dma_buf_attach(dma_buf, drm->dev);
+	if (IS_ERR(attach))
+		return ERR_PTR(PTR_ERR(attach));
+
+	/* Reference owned by the attachment, dropped by the GEM free path. */
+	get_dma_buf(dma_buf);
+
+	/*
+	 * DMA_BIDIRECTIONAL: the exporter performs the cache maintenance for
+	 * the DECON device here; the same sg table is later handed to
+	 * iovmm_map(), which only builds SYSMMU page tables from it.
+	 */
+	sgt = dma_buf_map_attachment(attach, DMA_BIDIRECTIONAL);
+	if (IS_ERR_OR_NULL(sgt)) {
+		ret = sgt ? PTR_ERR(sgt) : -ENOMEM;
+		goto err_detach;
+	}
+
+	cma = kzalloc(sizeof(*cma), GFP_KERNEL);
+	if (!cma) {
+		ret = -ENOMEM;
+		goto err_unmap;
+	}
+
+	/* drm_gem_object_init() BUG_ON()s on a non-page-aligned size. */
+	size = PAGE_ALIGN(dma_buf->size);
+	ret = drm_gem_object_init(drm, &cma->base, size);
+	if (ret) {
+		kfree(cma);
+		goto err_unmap;
+	}
+
+	cma->vaddr = NULL;		/* exporter-owned pages, no CPU mapping */
+	cma->paddr = sg_dma_address(sgt->sgl);
+	cma->base.import_attach = attach;
+	cma->base.driver_private = sgt;
+
+	DRM_DEBUG_PRIME("imported %zu bytes, %d sg entries\n",
+			dma_buf->size, sgt->nents);
+	pr_info("exynos7580_gem_prime_import: ok obj=%p import_attach=%p sgt=%p\n",
+		&cma->base, attach, sgt);
+
+	return &cma->base;
+
+err_unmap:
+	dma_buf_unmap_attachment(attach, sgt, DMA_BIDIRECTIONAL);
+err_detach:
+	dma_buf_detach(dma_buf, attach);
+	dma_buf_put(dma_buf);
+
+	return ERR_PTR(ret);
+}
+
+/* ---------- framebuffer creation (ADDFB2) ---------- */
+
+/**
+ * exynos7580_fb_create - create a framebuffer from a GEM handle
+ * @drm: DECON KMS device
+ * @file: client that owns @mode_cmd->handles[]
+ * @mode_cmd: validated by the core for flags/width/height/pitch/handles;
+ *            re-checked here against the DECON's format and layout limits
+ *
+ * The handle names either an imported dma-buf (exynos7580_gem_prime_import())
+ * or one of the driver's CMA dumb buffers.  Both are struct drm_gem_cma_object,
+ * which is the only object type this driver's GEM backend creates.
+ *
+ * Returns the framebuffer (one client-visible reference, plus one held by the
+ * object table) or an ERR_PTR.
+ */
+struct drm_framebuffer *exynos7580_fb_create(struct drm_device *drm,
+					     struct drm_file *file,
+					     struct drm_mode_fb_cmd2 *mode_cmd)
+{
+	struct drm_gem_object *obj;
+	struct drm_gem_cma_object *cma;
+	struct exynos7580_fb *efb;
+	struct exy7580_fb_desc desc;
+	int i, ret;
+
+	if (!drm || !file || !mode_cmd)
+		return ERR_PTR(-EINVAL);
+
+	pr_info("exynos7580_fb_create: %ux%u fmt=%08x handles=%u,%u,%u,%u pitches=%u,%u offsets=%u,%u\n",
+		mode_cmd->width, mode_cmd->height, mode_cmd->pixel_format,
+		mode_cmd->handles[0], mode_cmd->handles[1],
+		mode_cmd->handles[2], mode_cmd->handles[3],
+		mode_cmd->pitches[0], mode_cmd->pitches[1],
+		mode_cmd->offsets[0], mode_cmd->offsets[1]);
+
+	obj = drm_gem_object_lookup(drm, file, mode_cmd->handles[0]);
+	if (!obj)
+		return ERR_PTR(-ENOENT);
+
+	if (obj->dev != drm) {
+		ret = -EINVAL;
+		goto err_obj;
+	}
+	cma = to_drm_gem_cma_obj(obj);
+
+	memset(&desc, 0, sizeof(desc));
+	desc.pixel_format = mode_cmd->pixel_format;
+	desc.width = mode_cmd->width;
+	desc.height = mode_cmd->height;
+	desc.flags = mode_cmd->flags;
+	for (i = 0; i < 4; i++) {
+		desc.handles[i] = mode_cmd->handles[i];
+		desc.pitches[i] = mode_cmd->pitches[i];
+		desc.offsets[i] = mode_cmd->offsets[i];
+	}
+	desc.size = obj->size;
+	desc.max_width = drm->mode_config.max_width ?: 4096;
+	desc.max_height = drm->mode_config.max_height ?: 4096;
+
+	ret = exy7580_fb_check(&desc);
+	if (ret)
+		goto err_obj;
+
+	if (obj->import_attach && !obj->driver_private) {
+		/* Wrapper without its sg table: never produced by our import. */
+		ret = -EINVAL;
+		goto err_obj;
+	}
+
+	efb = kzalloc(sizeof(*efb), GFP_KERNEL);
+	if (!efb) {
+		ret = -ENOMEM;
+		goto err_obj;
+	}
+
+	efb->cma = cma;
+	drm_helper_mode_fill_fb_struct(&efb->fb, mode_cmd);
+
+	ret = drm_framebuffer_init(drm, &efb->fb, &exynos7580_fb_funcs);
+	if (ret) {
+		kfree(efb);
+		goto err_obj;
+	}
+
+	return &efb->fb;
+
+err_obj:
+	drm_gem_object_unreference_unlocked(obj);
+	return ERR_PTR(ret);
+}
diff -u -Naur a/drivers/gpu/drm/exynos7580/exynos_drm7580_dsi.c b/drivers/gpu/drm/exynos7580/exynos_drm7580_dsi.c
--- a/drivers/gpu/drm/exynos7580/exynos_drm7580_dsi.c
+++ b/drivers/gpu/drm/exynos7580/exynos_drm7580_dsi.c
@@ -0,0 +1,431 @@
+/* SPDX-License-Identifier: GPL-2.0
+ *
+ * exynos_drm7580_dsi.c - MIPI-DSI encoder + connector of the DECON KMS driver
+ *
+ * Slice DsiEncoder (docs/reports/decon-kms-dsi.md).  Ownership, per that
+ * report: the DSI host (dsim_drv.c), the ea8061 panel, the board power/reset
+ * lists and the v4l2 subdev registration stay with the vendor drivers.  This
+ * file only creates the DRM encoder/connector pair and reads the panel
+ * timings from the DSIM subdev - exactly the lookup the vendor DECON driver
+ * does (decon-int_drv.c:203-227).  It never binds "samsung,exynos5-mipi-dsi",
+ * never ioremaps 0x14800000 and never touches DSIM registers, clocks,
+ * regulators or interrupts.
+ *
+ * Link ownership (decon-kms-dsi.md 2.3/2.4).  s_stream(1) is the only
+ * fallible step of a modeset, so it belongs to the CRTC's mode_set and stays
+ * there (exynos7580_crtc_enable_link, owned by DeconCrtc): DSIM -> panel up,
+ * then DECON reg_init, then reg_start from crtc->commit.  The reverse order is
+ * produced by the 3.10 helper itself: drm_helper_disable_unused_functions()
+ * disables unused encoders (drm_crtc_helper.c:288-294) *before* crtc->disable
+ * (:296-306), so ->disable here is the point where the link and the panel are
+ * taken down while the link is still in HS - the vendor order of
+ * decon_core.c:1059-1072.  The encoder itself never starts the link: its
+ * prepare/mode_set/commit hooks are omitted on purpose.
+ *
+ * The panel only ever runs one timing; the connector therefore exposes exactly
+ * one DRIVER|PREFERRED mode and ->mode_valid accepts nothing else.
+ */
+
+#include <linux/kernel.h>
+#include <linux/types.h>
+#include <linux/err.h>
+#include <linux/errno.h>
+#include <linux/of.h>
+
+#include <media/exynos_mc.h>
+/* struct decon_lcd + DSIM_IOC_GET_LCD_INFO (vendor, single source of truth) */
+#include "../../../video/exynos/decon_7580/dsim.h"
+
+#include <drm/drmP.h>
+#include <drm/drm_crtc.h>
+#include <drm/drm_crtc_helper.h>
+#include <drm/drm_atomic_helper.h>
+
+#include "exynos_drm7580.h"
+
+/* DECON_INT: the DECON output 0 is wired to DSIM 0 on this SoC. */
+#define EXYNOS7580_DSI_ID		0
+
+/* Board value of "disp-pll-clk" (exynos7580-j7elte_rev00.dts:1018), used if
+ * the DT property is missing.  DECON divides the PLL by 1 into vclk, so this
+ * is the pixel clock the porches have to be clocked with. */
+#define EXYNOS7580_DISP_PLL_HZ		64500000U
+
+/*
+ * Single-instance driver (one DSI output, one DECON), same assumption as the
+ * rest of the series.  The contract header has no private DSI storage in
+ * struct exynos7580_device, so the state lives here; it is written once in
+ * exynos7580_dsi_init() before the connector can be probed and is read-only
+ * afterwards (no locking needed).
+ */
+struct exynos7580_dsi {
+	struct exynos7580_device *ex;
+	struct v4l2_subdev	 *dsim_sd;
+	struct decon_lcd	  lcd;
+	struct drm_display_mode	  mode;
+	unsigned int		  pixclk_hz;
+	unsigned int		  htotal;
+	unsigned int		  vtotal;
+	bool			  ready;
+};
+
+static struct exynos7580_dsi dsi0;
+
+/* Map a DRM device back to our state; NULL if it is not this instance. */
+static struct exynos7580_dsi *exynos7580_dsi_from_drm(struct drm_device *drm)
+{
+	if (!dsi0.ready || dsi0.ex != to_exynos7580(drm))
+		return NULL;
+
+	return &dsi0;
+}
+
+/* ------------------------------------------------------------------------
+ * panel timing -> DRM mode
+ * ------------------------------------------------------------------------ */
+
+static int exynos7580_dsi_check_lcd(struct device *dev,
+				    const struct decon_lcd *lcd)
+{
+	if (lcd->mode != DECON_VIDEO_MODE) {
+		dev_err(dev, "exynos7580-dsi: panel is not in DSI video mode (%d), DECON KMS needs video mode\n",
+			lcd->mode);
+		return -EINVAL;
+	}
+	if (!lcd->xres || !lcd->yres) {
+		dev_err(dev, "exynos7580-dsi: panel has no resolution (%ux%u)\n",
+			lcd->xres, lcd->yres);
+		return -EINVAL;
+	}
+	/* hsa/vsa == 0 would make drm_mode_vrefresh()/crtcinfo guesswork and
+	 * the DSIM porch registers get "len - 1". */
+	if (!lcd->hsa || !lcd->vsa) {
+		dev_err(dev, "exynos7580-dsi: panel sync lengths are 0 (hsa %u vsa %u)\n",
+			lcd->hsa, lcd->vsa);
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
+/*
+ * The fbdev driver's pixclock (1e12/(xres*yres*60) = 55.3 MHz,
+ * decon_missing_pixclock()) ignores the porches and is not usable here: the
+ * mode is built from the panel porches and the real vclk (decon-kms-dsi.md
+ * 1.8).  clock is in kHz as the DRM ABI requires.
+ */
+static void exynos7580_dsi_build_mode(struct exynos7580_dsi *dsi)
+{
+	const struct decon_lcd *lcd = &dsi->lcd;
+	struct drm_display_mode *m = &dsi->mode;
+
+	dsi->htotal = lcd->xres + lcd->hfp + lcd->hsa + lcd->hbp;
+	dsi->vtotal = lcd->yres + lcd->vfp + lcd->vsa + lcd->vbp;
+
+	memset(m, 0, sizeof(*m));
+	m->clock	= dsi->pixclk_hz / 1000;
+	m->hdisplay	= lcd->xres;
+	m->hsync_start	= lcd->xres + lcd->hfp;
+	m->hsync_end	= m->hsync_start + lcd->hsa;
+	m->htotal	= dsi->htotal;
+	m->vdisplay	= lcd->yres;
+	m->vsync_start	= lcd->yres + lcd->vfp;
+	m->vsync_end	= m->vsync_start + lcd->vsa;
+	m->vtotal	= dsi->vtotal;
+	/* Video-mode DSI defines the frame by the porches alone; DSIM does not
+	 * transmit HSYNC/VSYNC polarity and the vendor fbdev path sets none. */
+	m->flags	= 0;
+	m->type		= DRM_MODE_TYPE_DRIVER | DRM_MODE_TYPE_PREFERRED;
+	m->vrefresh	= 0;	/* let drm_mode_vrefresh() derive it below */
+	drm_mode_set_name(m);
+	m->vrefresh	= drm_mode_vrefresh(m);
+}
+
+/* ------------------------------------------------------------------------
+ * encoder
+ * ------------------------------------------------------------------------ */
+
+/*
+ * Link + panel down.  Runs before the CRTC is stopped (drm_crtc_helper.c:288-
+ * 306), which is the vendor order: the panel-off DCS sequence needs the link
+ * still in HS, and DECON then underruns only for the few us until
+ * crtc->disable calls decon_reg_stop().
+ *
+ * The link state itself is owned by the CRTC slice, so this only delegates;
+ * exynos7580_crtc_disable_link() must be safe to call when the link is
+ * already down (s_stream(0) is idempotent by itself, dsim_drv.c:913-914).
+ */
+static void exynos7580_dsi_encoder_disable(struct drm_encoder *encoder)
+{
+	exynos7580_crtc_disable_link(to_exynos7580(encoder->dev));
+}
+
+/*
+ * int67: drm_atomic_helper's crtc_set_mode() calls encoder->funcs->mode_set()
+ * unconditionally (drivers/gpu/drm/drm_atomic_helper.c:753 in this tree), and
+ * this encoder had no such callback, so the first modeset jumped to NULL.
+ * The DSI link and DECON programming live in the CRTC (enable_link()), so the
+ * encoder hook is a logging no-op, as in the upstream drivers.
+ */
+static void
+exynos7580_dsi_encoder_mode_set(struct drm_encoder *encoder,
+				struct drm_display_mode *mode,
+				struct drm_display_mode *adjusted_mode)
+{
+	DRM_DEBUG_KMS("DSI encoder: mode_set %ux%u@%u (link handled by CRTC)\n",
+		      adjusted_mode->hdisplay, adjusted_mode->vdisplay,
+		      drm_mode_vrefresh(adjusted_mode));
+}
+
+/*
+ * The CRTC hands us the requested mode; reject anything but the panel timing
+ * and give the CRTC the exact values it must program into DECON and DSIM, so
+ * a userspace-supplied variant of the same mode cannot slip through.
+ */
+static bool
+exynos7580_dsi_encoder_mode_fixup(struct drm_encoder *encoder,
+				  const struct drm_display_mode *mode,
+				  struct drm_display_mode *adjusted_mode)
+{
+	struct exynos7580_dsi *dsi = exynos7580_dsi_from_drm(encoder->dev);
+
+	if (!dsi)
+		return false;
+	if (!drm_mode_equal(mode, &dsi->mode))
+		return false;
+
+	drm_mode_copy(adjusted_mode, &dsi->mode);
+	return true;
+}
+
+static const struct drm_encoder_helper_funcs exynos7580_dsi_encoder_helper_funcs = {
+	.disable	= exynos7580_dsi_encoder_disable,
+	.mode_fixup	= exynos7580_dsi_encoder_mode_fixup,
+	.mode_set	= exynos7580_dsi_encoder_mode_set,
+};
+
+static const struct drm_encoder_funcs exynos7580_dsi_encoder_funcs = {
+	/*
+	 * int69: drm_mode_config_cleanup() calls encoder->funcs->destroy()
+	 * unguarded, and it runs before the connectors/planes/CRTCs.
+	 */
+	.destroy	= drm_encoder_cleanup,
+};
+
+/* ------------------------------------------------------------------------
+ * connector
+ * ------------------------------------------------------------------------ */
+
+static enum drm_connector_status
+exynos7580_dsi_connector_detect(struct drm_connector *connector, bool force)
+{
+	/* Soldered panel: the vendor panel driver already ran the ID read at
+	 * probe time (ea8061_lcd_ctrl.c:769-840), and a panel that answered
+	 * "no" there is not something DRM can change by polling. */
+	if (!exynos7580_dsi_from_drm(connector->dev))
+		return connector_status_disconnected;
+
+	return connector_status_connected;
+}
+
+/*
+ * Exactly one mode, DRIVER|PREFERRED (KWin 6.8 needs a connected connector
+ * with >= 1 mode, decon-kms-req.md rows 17/22).  drm_mode_duplicate() copies
+ * the template so each probe hands out its own object.
+ */
+int exynos7580_dsi_get_modes(struct drm_connector *connector)
+{
+	struct exynos7580_dsi *dsi = exynos7580_dsi_from_drm(connector->dev);
+	struct drm_display_mode *mode;
+
+	if (!dsi)
+		return 0;
+
+	mode = drm_mode_duplicate(connector->dev, &dsi->mode);
+	if (!mode)
+		return 0;
+
+	mode->type = DRM_MODE_TYPE_DRIVER | DRM_MODE_TYPE_PREFERRED;
+	drm_mode_probed_add(connector, mode);
+
+	return 1;
+}
+
+static int
+exynos7580_dsi_connector_mode_valid(struct drm_connector *connector,
+				    struct drm_display_mode *mode)
+{
+	struct exynos7580_dsi *dsi = exynos7580_dsi_from_drm(connector->dev);
+
+	if (!dsi || !drm_mode_equal(mode, &dsi->mode))
+		return MODE_BAD;
+
+	return MODE_OK;
+}
+
+static struct drm_encoder *
+exynos7580_dsi_connector_best_encoder(struct drm_connector *connector)
+{
+	struct exynos7580_device *ex = to_exynos7580(connector->dev);
+
+	if (!exynos7580_dsi_from_drm(connector->dev))
+		return NULL;
+
+	return &ex->encoder;
+}
+
+static const struct drm_connector_helper_funcs exynos7580_dsi_connector_helper_funcs = {
+	.get_modes	= exynos7580_dsi_get_modes,
+	.mode_valid	= exynos7580_dsi_connector_mode_valid,
+	.best_encoder	= exynos7580_dsi_connector_best_encoder,
+};
+
+static const struct drm_connector_funcs exynos7580_dsi_connector_funcs = {
+	.dpms			= drm_atomic_helper_connector_dpms,
+	.reset			= drm_atomic_helper_connector_reset,
+	.detect			= exynos7580_dsi_connector_detect,
+	.fill_modes		= drm_helper_probe_single_connector_modes,
+	.atomic_duplicate_state	= drm_atomic_helper_connector_duplicate_state,
+	.atomic_destroy_state	= drm_atomic_helper_connector_destroy_state,
+	/* int69: mode_config_cleanup() calls destroy() unguarded. */
+	.destroy		= drm_connector_cleanup,
+	/*
+	 * no ->atomic_set_property: CRTC_ID is handled by the core
+	 * (drm_atomic.c:630) and the connector has no driver properties.  The
+	 * M0 helper drm_atomic_helper_connector_set_property() still carries
+	 * the 3.19 (connector, property, val) signature and does not fit this
+	 * 4.0 hook.
+	 */
+};
+
+/* ------------------------------------------------------------------------
+ * init
+ * ------------------------------------------------------------------------ */
+
+int exynos7580_dsi_init(struct exynos7580_device *ex)
+{
+	struct exynos7580_dsi *dsi = &dsi0;
+	struct drm_device *drm;
+	struct exynos_md *md;
+	struct v4l2_subdev *sd;
+	struct decon_lcd *lcd;
+	unsigned int hz, refresh_cHz;
+	int ret;
+
+	if (!ex || !ex->dev)
+		return -EINVAL;
+	if (!ex->crtc.base.id) {
+		dev_err(ex->dev, "exynos7580-dsi: CRTC must be registered first\n");
+		return -EINVAL;
+	}
+	if (dsi->ready)
+		return 0;
+
+	drm = ex->drm;
+
+	/* Same lookup as the vendor DECON driver (decon-int_drv.c:203-227):
+	 * the DSIM platform driver registers its v4l2 subdev into the media
+	 * device named "exynos-mdev". */
+	md = module_name_to_driver_data(MDEV_MODULE_NAME);
+	if (!md) {
+		dev_warn(ex->dev, "exynos7580-dsi: exynos-mdev is not probed yet\n");
+		return -EPROBE_DEFER;
+	}
+
+	sd = md->dsim_sd[EXYNOS7580_DSI_ID];
+	if (IS_ERR_OR_NULL(sd)) {
+		dev_warn(ex->dev, "exynos7580-dsi: DSI%d subdev is not registered yet\n",
+			 EXYNOS7580_DSI_ID);
+		return -EPROBE_DEFER;
+	}
+
+	/* The ioctl publishes the parsed lcd_info as the subdev hostdata. */
+	ret = v4l2_subdev_call(sd, core, ioctl, DSIM_IOC_GET_LCD_INFO, NULL);
+	if (ret) {
+		dev_err(ex->dev, "exynos7580-dsi: DSIM_IOC_GET_LCD_INFO failed (%d)\n",
+			ret);
+		return ret;
+	}
+
+	lcd = v4l2_get_subdev_hostdata(sd);
+	if (!lcd) {
+		dev_err(ex->dev, "exynos7580-dsi: DSIM subdev has no lcd info\n");
+		return -EINVAL;
+	}
+
+	/* Copy: the DSIM driver keeps ownership of its lcd_info. */
+	dsi->lcd = *lcd;
+
+	ret = exynos7580_dsi_check_lcd(ex->dev, &dsi->lcd);
+	if (ret)
+		return ret;
+
+	hz = EXYNOS7580_DISP_PLL_HZ;
+	of_property_read_u32(ex->dev->of_node, "disp-pll-clk", &hz);
+	if (!hz)
+		hz = EXYNOS7580_DISP_PLL_HZ;
+	dsi->pixclk_hz = hz;
+
+	exynos7580_dsi_build_mode(dsi);
+
+	ret = drm_encoder_init(drm, &ex->encoder, &exynos7580_dsi_encoder_funcs,
+			       DRM_MODE_ENCODER_DSI);
+	if (ret) {
+		dev_err(ex->dev, "exynos7580-dsi: failed to init DSI encoder (%d)\n",
+			ret);
+		return ret;
+	}
+
+	ex->encoder.possible_crtcs = drm_crtc_mask(&ex->crtc);
+	drm_encoder_helper_add(&ex->encoder,
+			       &exynos7580_dsi_encoder_helper_funcs);
+
+	ret = drm_connector_init(drm, &ex->connector,
+				 &exynos7580_dsi_connector_funcs,
+				 DRM_MODE_CONNECTOR_DSI);
+	if (ret) {
+		dev_err(ex->dev, "exynos7580-dsi: failed to init DSI connector (%d)\n",
+			ret);
+		return ret;
+	}
+
+	ex->connector.display_info.width_mm = dsi->lcd.width;
+	ex->connector.display_info.height_mm = dsi->lcd.height;
+	ex->connector.interlace_allowed = false;
+	ex->connector.doublescan_allowed = false;
+	ex->connector.polled = 0;		/* fixed panel, nothing to poll */
+	ex->connector.status = connector_status_connected;
+
+	drm_connector_helper_add(&ex->connector,
+				 &exynos7580_dsi_connector_helper_funcs);
+
+	ret = drm_mode_connector_attach_encoder(&ex->connector, &ex->encoder);
+	if (ret) {
+		dev_err(ex->dev, "exynos7580-dsi: failed to attach encoder (%d)\n",
+			ret);
+		return ret;
+	}
+
+	dsi->dsim_sd = sd;
+	dsi->ex = ex;
+	/* Publish last: detect()/get_modes() consult this, and the connector
+	 * can only be probed once the DRM device is registered. */
+	dsi->ready = true;
+
+	refresh_cHz = (unsigned int)((u64)dsi->pixclk_hz * 100 /
+				     ((u64)dsi->htotal * dsi->vtotal));
+
+	dev_info(ex->dev, "exynos7580-dsi: DSIM subdev %s, hs %u Mbps/lane, esc %u MHz\n",
+		 sd->name, dsi->lcd.hs_clk, dsi->lcd.esc_clk);
+	dev_info(ex->dev, "exynos7580-dsi: panel %ux%u (%ux%u mm), hbp/hfp/hsw %u/%u/%u, vbp/vfp/vsw %u/%u/%u\n",
+		 dsi->lcd.xres, dsi->lcd.yres, dsi->lcd.width, dsi->lcd.height,
+		 dsi->lcd.hbp, dsi->lcd.hfp, dsi->lcd.hsa,
+		 dsi->lcd.vbp, dsi->lcd.vfp, dsi->lcd.vsa);
+	dev_info(ex->dev, "exynos7580-dsi: mode %ux%u @ %u.%02u Hz (%u kHz, htotal %u, vtotal %u), encoder DSI(6) possible_crtcs 0x%x, connector DSI(16) connected%s\n",
+		 dsi->lcd.xres, dsi->lcd.yres, refresh_cHz / 100, refresh_cHz % 100,
+		 dsi->mode.clock, dsi->htotal, dsi->vtotal,
+		 ex->encoder.possible_crtcs,
+		 dsi->lcd.mic_enabled ? ", mic" : "");
+
+	return 0;
+}
diff -u -Naur a/drivers/gpu/drm/exynos7580/exynos_drm7580_fbdev.c b/drivers/gpu/drm/exynos7580/exynos_drm7580_fbdev.c
--- a/drivers/gpu/drm/exynos7580/exynos_drm7580_fbdev.c
+++ b/drivers/gpu/drm/exynos7580/exynos_drm7580_fbdev.c
@@ -0,0 +1,297 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * gpu31-kms: fbdev emulation (/dev/fb0) for the DECON KMS device.
+ *
+ * KmsFbdev slice of docs/reports/decon-kms-plan.md. The KMS image does not
+ * bind the vendor DECON fbdev driver (docs/reports/decon-kms-coexist.md), so
+ * the fb0 node that X11/nura-shell and the framebuffer console need is
+ * registered here, on top of card0, through drm_fbdev_cma:
+ *
+ *   /dev/fb0 -> drm_fb_cma framebuffer -> drm_gem_cma_create() CMA buffer
+ *
+ * The fb is sized from the mode the fb helper picks, i.e. the panel mode
+ * (720x1280) exposed by the DSI connector, so the virtual resolution is
+ * 720x1280 with a 2880 byte pitch at 32 bpp.
+ *
+ * Registration happens from the KMS probe and must complete there: if it
+ * fails, the probe fails, the DECON node stays unbound and the vendor fbdev
+ * driver registers its own fb0 at late_initcall_sync (the coexistence
+ * fallback). The whole emulation is optional: CONFIG_DRM_EXYNOS7580_FBDEV
+ * and the exynosdrm.fbdev parameter both switch it off.
+ */
+
+#include <linux/device.h>
+#include <linux/dma-mapping.h>
+#include <linux/err.h>
+#include <linux/fb.h>
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/types.h>
+#include <linux/exynos_decon_kms.h>
+
+#include <drm/drmP.h>
+#include <drm/drm_crtc.h>
+#include <drm/drm_fb_cma_helper.h>
+#include <drm/drm_fb_helper.h>
+
+#include "exynos_drm7580.h"
+
+/* Panel geometry fb0 must expose (see docs/reports/decon-kms-fbdev.md). */
+#define EXYNOS7580_FB0_WIDTH		720
+#define EXYNOS7580_FB0_HEIGHT		1280
+
+/* 32 bpp XRGB8888: the DECON primary window format fb0 is sized for. */
+#define EXYNOS7580_FB0_BPP		32
+
+static bool exynos7580_fbdev_enable = true;
+module_param_named(fbdev, exynos7580_fbdev_enable, bool, 0444);
+MODULE_PARM_DESC(fbdev, "Register /dev/fb0 on the DECON KMS device (default: 1)");
+
+static int exynos7580_fbdev_bpp = EXYNOS7580_FB0_BPP;
+module_param_named(fbdev_bpp, exynos7580_fbdev_bpp, int, 0444);
+MODULE_PARM_DESC(fbdev_bpp,
+		 "Preferred fb0 bits per pixel: 32, 24, 16, 15 or 8 (default: 32)");
+
+/*
+ * Handle of the single fbdev this driver owns. The contract header has no
+ * fbdev member, so it stays file-private; exynos7580_fbdev_fini() releases it
+ * explicitly from ->unload() (before the core frees the mode objects it points
+ * at), and the devres action is the fallback for a detach that never reaches
+ * ->unload().
+ */
+static struct drm_fbdev_cma *exynos7580_fbdev;
+
+static int exynos7580_fbdev_bpp_or_default(int bpp)
+{
+	switch (bpp) {
+	case 32:
+	case 24:
+	case 16:
+	case 15:
+	case 8:
+		return bpp;
+	default:
+		pr_warn("exynosdrm: unsupported fbdev_bpp=%d, using %d\n",
+			bpp, EXYNOS7580_FB0_BPP);
+		return EXYNOS7580_FB0_BPP;
+	}
+}
+
+/*
+ * The KMS image owns /dev/fb0 (the vendor DECON fbdev driver does not bind), so
+ * our fb has to be node 0. Identify it by its parent device: the helper calls
+ * framebuffer_alloc(0, drm->dev), so fb_info->device is the DECON platform
+ * device (drivers/video/fbsysfs.c:39-60).
+ *
+ * 3.10's drm_fbdev_cma_init() cannot report a failing register_framebuffer():
+ * it stores drm_fb_helper_initial_config()'s boolean result in an int and only
+ * tests for a negative value, so a failure looks like success. This check is
+ * what turns that into a probe failure.
+ */
+static struct fb_info *exynos7580_fb0(struct exynos7580_device *ex)
+{
+	struct fb_info *info = registered_fb[0];
+
+	if (!info || info->node != 0 || info->device != ex->dev)
+		return NULL;
+
+	return info;
+}
+
+/*
+ * Tear /dev/fb0 and the fb helper down. Must run from ->unload() before
+ * drm_mode_config_cleanup(): drm_fbdev_cma_fini() destroys the fbdev
+ * framebuffer (drm_framebuffer_cleanup() list_del, drm_fb_helper_fini()), so
+ * running it after the core freed the CRTCs/planes/framebuffers it points at
+ * dereferences dead mode objects. Idempotent: the devres action becomes a
+ * no-op once this has cleared the handle.
+ */
+void exynos7580_fbdev_fini(void)
+{
+	struct drm_fbdev_cma *fbdev = exynos7580_fbdev;
+
+	if (!fbdev)
+		return;
+
+	exynos7580_fbdev = NULL;
+	drm_fbdev_cma_fini(fbdev);
+}
+
+static void exynos7580_fbdev_devm_release(void *data)
+{
+	if (exynos7580_fbdev != data)
+		return;
+
+	exynos7580_fbdev_fini();
+}
+
+/*
+ * Program the CRTC so it actually scans fb0 out. drm_fb_helper only registers
+ * the fb (drm_fb_helper_single_fb_probe() stops at register_framebuffer()), and
+ * the KMS image runs without FRAMEBUFFER_CONSOLE, so nothing else would set a
+ * mode on the CRTC (docs/reports/decon-kms-coexist.md section 4.3 item 3).
+ *
+ * drm_fbdev_cma_restore_mode() takes the modeset locks itself and goes through
+ * drm_mode_set_config_internal() -> crtc->funcs->set_config(), which the CRTC
+ * slice points at drm_atomic_helper_set_config(). It cannot report errors, so
+ * the result is verified from the atomic state afterwards.
+ */
+static int exynos7580_fbdev_start_scanout(struct exynos7580_device *ex,
+					  struct drm_fbdev_cma *fbdev)
+{
+	struct drm_device *drm = ex->drm;
+	struct drm_framebuffer *fb;
+	struct fb_info *info;
+	dma_addr_t addr;
+	int ret;
+
+	if (list_empty(&drm->mode_config.fb_list)) {
+		dev_err(ex->dev, "fb helper did not create a framebuffer\n");
+		return -ENODEV;
+	}
+
+	fb = list_first_entry(&drm->mode_config.fb_list, struct drm_framebuffer, head);
+
+	pr_info("exynos7580_fbdev: restore_mode enter (mutex_locked=%d acquire_ctx=%p)\n",
+		mutex_is_locked(&drm->mode_config.mutex), drm->mode_config.acquire_ctx);
+	drm_fbdev_cma_restore_mode(fbdev);
+	pr_info("exynos7580_fbdev: restore_mode exit (mutex_locked=%d acquire_ctx=%p)\n",
+		mutex_is_locked(&drm->mode_config.mutex), drm->mode_config.acquire_ctx);
+
+	info = exynos7580_fb0(ex);
+	if (!info) {
+		dev_err(ex->dev, "fb0 was not registered\n");
+		return -ENODEV;
+	}
+
+	/*
+	 * int74: after drm_fbdev_cma_init() + restore_mode() the authoritative
+	 * state is the atomic one: crtc->state->active and
+	 * primary->state->fb.  crtc->primary->fb and state->enable are legacy
+	 * fields that the atomic commit path does not maintain, so the old
+	 * predicate failed on a pipe that was demonstrably scanning
+	 * (VIDINTCON0=0x8803, FRAME IRQ firing).
+	 */
+	if (!ex->crtc.state || !ex->crtc.state->active ||
+	    !ex->crtc.enabled ||
+	    !ex->crtc.primary || !ex->crtc.primary->state ||
+	    ex->crtc.primary->state->fb != fb) {
+		dev_err(ex->dev,
+			"CRTC does not scan fb0 out: crtc id=%u enabled=%d state=%p active=%d state->crtc=%p primary->state=%p primary->state->fb=%p legacy primary->fb=%p want=%p\n",
+			ex->crtc.base.id, ex->crtc.enabled, ex->crtc.state,
+			ex->crtc.state ? ex->crtc.state->active : -1,
+			ex->crtc.state ? ex->crtc.state->crtc : NULL,
+			ex->crtc.primary ? ex->crtc.primary->state : NULL,
+			ex->crtc.primary && ex->crtc.primary->state ?
+				ex->crtc.primary->state->fb : NULL,
+			ex->crtc.primary ? ex->crtc.primary->fb : NULL, fb);
+		/* int75: keep the reason at KERN_ERR in the persisted trace. */
+		pr_err("exynos7580: fbdev scanout failed: crtc id=%u enabled=%d active=%d primary->state->fb=%p want=%p\n",
+		       ex->crtc.base.id, ex->crtc.enabled,
+		       ex->crtc.state ? ex->crtc.state->active : -1,
+		       ex->crtc.primary && ex->crtc.primary->state ?
+				ex->crtc.primary->state->fb : NULL, fb);
+		/* int70: name the register state that made the check fail. */
+		decon_kms_log_state(ex->decon, "fbdev scanout failed");
+		return -EIO;
+	}
+
+	/*
+	 * The CRTC (and with it the DECON iovmm domain) is up now, so this is a
+	 * real mapping check: refuse a buffer the windows cannot scan out while
+	 * fb0 still looks healthy.
+	 */
+	ret = exynos7580_fb_scanout(fb, 0, &addr);
+	if (ret) {
+		dev_err(ex->dev, "fb0 buffer is not scannable: %d\n", ret);
+		return ret;
+	}
+
+	dev_info(ex->dev,
+		 "fb0: drmfb %ux%u-%u, virtual %ux%u, pitch %u, scanout IOVA 0x%llx\n",
+		 info->var.xres, info->var.yres, info->var.bits_per_pixel,
+		 info->var.xres_virtual, info->var.yres_virtual,
+		 info->fix.line_length, (unsigned long long)addr);
+
+	if (info->var.xres != EXYNOS7580_FB0_WIDTH ||
+	    info->var.yres != EXYNOS7580_FB0_HEIGHT ||
+	    info->var.xres_virtual != EXYNOS7580_FB0_WIDTH ||
+	    info->var.yres_virtual != EXYNOS7580_FB0_HEIGHT)
+		dev_warn(ex->dev,
+			 "fb0 is %ux%u (virtual %ux%u), expected %ux%u (virtual %ux%u)\n",
+			 info->var.xres, info->var.yres,
+			 info->var.xres_virtual, info->var.yres_virtual,
+			 EXYNOS7580_FB0_WIDTH, EXYNOS7580_FB0_HEIGHT,
+			 EXYNOS7580_FB0_WIDTH, EXYNOS7580_FB0_HEIGHT);
+
+	return 0;
+}
+
+int exynos7580_fbdev_init(struct exynos7580_device *ex)
+{
+	struct drm_device *drm;
+	struct drm_fbdev_cma *fbdev;
+	int ret;
+
+	/* 3.10 owns the drm_device; the contract hands us the pointer. */
+	if (!ex || !ex->dev || !ex->drm || !ex->drm->dev) {
+		pr_err("exynosdrm: fbdev init without a DRM device\n");
+		return -EINVAL;
+	}
+
+	drm = ex->drm;
+
+	if (!exynos7580_fbdev_enable) {
+		dev_info(ex->dev, "fb0 emulation disabled (exynosdrm.fbdev=0)\n");
+		return 0;
+	}
+
+	if (exynos7580_fbdev)
+		return -EBUSY;
+
+	if (!drm->mode_config.num_crtc || !drm->mode_config.num_connector) {
+		dev_err(ex->dev, "no CRTC or connector, not creating fb0\n");
+		return -ENODEV;
+	}
+
+	/*
+	 * fb0 mode sets and pans go through crtc->funcs->set_config(). An atomic
+	 * CRTC must point that op at drm_atomic_helper_set_config() and must
+	 * have its primary plane registered; without either the fb would exist
+	 * but never scan out, so fail the probe and let the vendor fbdev driver
+	 * take the DECON device instead of leaving a dead /dev/fb0 behind.
+	 */
+	if (!ex->crtc.funcs || !ex->crtc.funcs->set_config || !ex->crtc.primary) {
+		dev_err(ex->dev, "CRTC lacks an atomic set_config/primary plane, not creating fb0\n");
+		return -EINVAL;
+	}
+
+	fbdev = drm_fbdev_cma_init(drm,
+				   exynos7580_fbdev_bpp_or_default(exynos7580_fbdev_bpp),
+				   drm->mode_config.num_crtc,
+				   drm->mode_config.num_connector);
+	if (IS_ERR(fbdev)) {
+		ret = PTR_ERR(fbdev);
+		dev_err(ex->dev, "drm_fbdev_cma_init failed: %d\n", ret);
+		return ret;
+	}
+
+	exynos7580_fbdev = fbdev;
+
+	ret = exynos7580_fbdev_start_scanout(ex, fbdev);
+	if (ret)
+		goto err_fini;
+
+	ret = devm_add_action(ex->dev, exynos7580_fbdev_devm_release, fbdev);
+	if (ret) {
+		dev_err(ex->dev, "cannot register the fb0 release action: %d\n", ret);
+		goto err_fini;
+	}
+
+	return 0;
+
+err_fini:
+	exynos7580_fbdev = NULL;
+	drm_fbdev_cma_fini(fbdev);
+	return ret;
+}
diff -u -Naur a/drivers/gpu/drm/exynos7580/exynos_drm7580_fence.c b/drivers/gpu/drm/exynos7580/exynos_drm7580_fence.c
--- a/drivers/gpu/drm/exynos7580/exynos_drm7580_fence.c
+++ b/drivers/gpu/drm/exynos7580/exynos_drm7580_fence.c
@@ -0,0 +1,330 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * exynos_drm7580_fence.c - DECON KMS vblank/flip-event completion
+ *
+ * KmsFence slice of the DECON KMS driver (see exynos_drm7580.h).  This file
+ * owns the only two points where a commit meets the vblank interrupt:
+ *
+ *   exynos7580_commit_tail()  driver tail of an atomic commit; runs the M0
+ *                             helper stages and hands each pending flip
+ *                             event to the vblank core;
+ *   exynos7580_vblank_irq()   DECON frame-done interrupt; advances the DRM
+ *                             vblank counter and delivers armed events.
+ *
+ * ---------------------------------------------------------------------------
+ * The 3.10 vblank model used here
+ * ---------------------------------------------------------------------------
+ * This tree predates drm_crtc_vblank_*() and struct drm_vblank_crtc.  The
+ * primitives available (include/drm/drmP.h:1452-1464, drm_irq.c) are:
+ *
+ *   int  dev->num_crtcs                    number of initialised pipes
+ *   int  dev->driver->enable_vblank(dev, pipe)
+ *   int  dev->driver->disable_vblank(dev, pipe)
+ *   u32  dev->driver->get_vblank_counter(dev, pipe)
+ *   int  drm_vblank_get(dev, pipe)         take an interrupt reference;
+ *                                          pipe 0 -> 1 calls enable_vblank()
+ *   void drm_vblank_put(dev, pipe)         drop it; BUG_ON(refcount == 0)
+ *   u32  drm_vblank_count(dev, pipe)       cooked software frame counter
+ *   bool drm_handle_vblank(dev, pipe)      called from the IRQ: timestamp,
+ *                                          ++_vblank_count, wake
+ *                                          dev->vbl_queue[pipe], then send
+ *                                          every due event on
+ *                                          dev->vblank_event_list
+ *   void drm_send_vblank_event(dev, pipe, e)  send now; event_lock held
+ *   wait_queue_head_t *dev->vbl_queue[]    one wait queue per pipe
+ *   struct list_head dev->vblank_event_list  process-wide armed events
+ *   spinlock_t dev->event_lock             protects the list and the events
+ *
+ * There is no drm_crtc_arm_vblank_event() (upstream added it in v4.4), so
+ * exynos7580_arm_vblank_event() below is the minimal 3.10 equivalent: set
+ * ->pipe, sample the current counter, and queue the event.  The counter value
+ * only has to satisfy drm_handle_vblank_events()'s "too old" filter
+ *
+ *         if ((seq - e->event.sequence) > (1 << 23))
+ *                 continue;
+ *
+ * so sampling the *current* count means "deliver at the first vblank after
+ * arming", which for a synchronous DECON commit is exactly the vblank at
+ * which the newly latched frame is scanned out.
+ *
+ * ---------------------------------------------------------------------------
+ * Ordering against the DECON commit and the frame interrupt
+ * ---------------------------------------------------------------------------
+ * The DECON hardware commit (decon_kms_commit(), issued by the plane hooks in
+ * drm_atomic_helper_commit_planes()) is synchronous: it returns after the
+ * shadow registers were unprotected and the vendor driver waited for the
+ * frame interrupt that latches them.  exynos7580_commit_tail() therefore arms
+ * only after the frame is already programmed, i.e. the event cannot describe
+ * a frame that is still in the update kthread.
+ *
+ * The remaining race is arming vs. the very vblank interrupt.  Both paths
+ * serialize on dev->event_lock:
+ *   - the arm samples drm_vblank_count() and appends the event under it;
+ *   - drm_handle_vblank() samples the counter and sends due events under it.
+ * Whichever wins, the event is delivered on the first vblank at or after the
+ * arm: if the interrupt ran first, the sampled count is the new one and the
+ * event goes out on the next frame (one frame late, never lost); if the arm
+ * ran first, the interrupt delivers it immediately (never twice, because
+ * drm_handle_vblank_events() unlinks it under the same lock).
+ *
+ * If the plane slice ever switches to decon_kms_commit_async(), the tail MUST
+ * wait for that commit's completion before arming; otherwise the event can
+ * overtake the frame programming.
+ *
+ * ---------------------------------------------------------------------------
+ * Completion guarantees (no hang, exactly once)
+ * ---------------------------------------------------------------------------
+ * 1. An event is either queued on dev->vblank_event_list with exactly one
+ *    vblank reference held on its behalf, or sent immediately with no
+ *    reference.  The reference taken by drm_vblank_get() is dropped by
+ *    drm_handle_vblank_events() when the event is delivered, by drm_vblank_off()
+ *    when the pipe is switched off, and by drm_events_release() if the client
+ *    closes the file first (drm_fops.c:400-422).  It is never dropped twice.
+ * 2. crtc->state->event is cleared as soon as ownership passes to the core,
+ *    so the state destroy path cannot free a delivered event again.
+ * 3. No vblank available (dev->num_crtcs == 0, no ->enable_vblank hook, the
+ *    pipe is off, or enable_vblank() fails) => the event is sent immediately;
+ *    userspace is never left waiting for an interrupt that cannot happen.
+ * 4. A CRTC that goes inactive in this commit is completed immediately: its
+ *    disable hook has already called drm_vblank_off(), which also flushed any
+ *    event armed for the previous frame.
+ * 5. exynos7580_commit_tail() waits at most 50 ms for the flip vblank
+ *    (drm_atomic_helper_wait_for_vblanks()) and skips that wait entirely if
+ *    vblank was never initialised, so a dead pipe can delay but never hang the
+ *    commit.
+ */
+#include <linux/kernel.h>
+#include <linux/spinlock.h>
+#include <linux/types.h>
+
+#include <drm/drmP.h>
+#include <drm/drm_crtc.h>
+#include <drm/drm_crtc_helper.h>
+#include <drm/drm_atomic.h>
+#include <drm/drm_atomic_helper.h>
+
+#include "exynos_drm7580.h"
+
+/*
+ * exynos7580_vblank_available - can this pipe deliver a vblank event?
+ * @drm: DRM device
+ * @pipe: CRTC index
+ *
+ * This tree has no drm_crtc_vblank_get() that would do this check for us, and
+ * both drm_vblank_get() and dev->vbl_queue[] assume drm_vblank_init() ran and
+ * ->enable_vblank exists.  Checking up front lets the caller fall back to an
+ * immediate completion instead of dereferencing a NULL queue or hook.
+ */
+static bool exynos7580_vblank_available(struct drm_device *drm,
+					unsigned int pipe)
+{
+	if (!drm->num_crtcs || pipe >= (unsigned int)drm->num_crtcs)
+		return false;
+
+	if (!drm->driver || !drm->driver->enable_vblank)
+		return false;
+
+	return true;
+}
+
+/*
+ * exynos7580_arm_vblank_event - minimal drm_crtc_arm_vblank_event() (v4.4)
+ * @drm: DRM device
+ * @pipe: CRTC index the event belongs to
+ * @e: event to deliver on the next vblank
+ *
+ * The caller must hold dev->event_lock and a vblank reference on @pipe taken
+ * with drm_vblank_get(); drm_handle_vblank_events() consumes that reference
+ * when it sends the event.
+ */
+static void exynos7580_arm_vblank_event(struct drm_device *drm,
+					unsigned int pipe,
+					struct drm_pending_vblank_event *e)
+{
+	assert_spin_locked(&drm->event_lock);
+
+	e->pipe = pipe;
+	e->event.sequence = drm_vblank_count(drm, pipe);
+	list_add_tail(&e->base.link, &drm->vblank_event_list);
+}
+
+/*
+ * exynos7580_send_event_now - deliver an event without waiting for a vblank
+ * @drm: DRM device
+ * @pipe: CRTC index, or -1 when the counter must not be touched
+ * @e: event to deliver
+ *
+ * Used for every "no vblank will come" case.  Takes dev->event_lock itself;
+ * drm_send_vblank_event() requires it.
+ */
+static void exynos7580_send_event_now(struct drm_device *drm, int pipe,
+				      struct drm_pending_vblank_event *e)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&drm->event_lock, flags);
+	drm_send_vblank_event(drm, pipe, e);
+	spin_unlock_irqrestore(&drm->event_lock, flags);
+}
+
+/*
+ * exynos7580_complete_crtc_event - hand one commit's event to its owner
+ * @drm: DRM device
+ * @crtc: CRTC the state belongs to
+ * @state: the *new* CRTC state (crtc->state after swap_state)
+ *
+ * Called once per CRTC present in the commit, after the hardware commit ran.
+ * Exactly one of three things happens to a non-NULL event:
+ *
+ *   - the CRTC is going inactive: send now (no vblank will follow);
+ *   - vblank is unusable on this pipe: send now (never wait forever);
+ *   - otherwise: take a vblank reference and arm it for the next vblank.
+ *
+ * The event pointer is detached from the CRTC state before anything else so
+ * the atomic state teardown can never race a second completion.
+ */
+static void exynos7580_complete_crtc_event(struct drm_device *drm,
+					   struct drm_crtc *crtc,
+					   struct drm_crtc_state *state)
+{
+	struct drm_pending_vblank_event *e = state->event;
+	unsigned int pipe = drm_crtc_index(crtc);
+	unsigned long flags;
+
+	if (!e)
+		return;
+
+	pr_info("exynos7580_event: crtc pipe=%u event=%p\n", pipe, e);
+
+	/* Ownership moves to the core (or to userspace) right here. */
+	state->event = NULL;
+
+	/*
+	 * A disabling commit has already run the CRTC's disable hook, which
+	 * calls drm_vblank_off() and thus flushes anything armed before.  This
+	 * event describes the disable itself, so it completes now.
+	 */
+	if (!state->active) {
+		exynos7580_send_event_now(drm,
+			exynos7580_vblank_available(drm, pipe) ? (int)pipe : -1,
+			e);
+		return;
+	}
+
+	/*
+	 * int109: deliver immediately instead of arming for a vblank.
+	 *
+	 * The DECON frame interrupt is dead on this stack: /proc/interrupts
+	 * shows line 234 (14830000.decon_fb) frozen while the DSI line
+	 * advances at 60 Hz, so drm_handle_vblank() never runs and every
+	 * armed flip event is lost.  KWin then reports "Pageflip timed out"
+	 * and stops presenting even though the (synchronous) DECON commit
+	 * already latched the frame.
+	 *
+	 * The vendor commit ran decon_wait_for_vsync()/decon_update_regs()
+	 * before this point, so the scanout buffer is programmed; completing
+	 * the event here is what userspace needs to release its buffer.
+	 */
+	/*
+	 * int110: pipe -1, not pipe.  drm_send_vblank_event() stamps the event
+	 * from the pipe's vblank timestamp, which is never initialised on this
+	 * stack, so KWin logged "Got invalid timestamp (sec: 0, usec: 0)".
+	 * Passing -1 makes the core use getnstimeofday() instead.
+	 */
+	exynos7580_send_event_now(drm, -1, e);
+}
+
+/**
+ * exynos7580_commit_tail - commit an atomic state to DECON and complete it
+ * @state: atomic state whose old-state pointers were already swapped in
+ *
+ * This is the complete driver tail: the caller (the driver's
+ * mode_config.funcs.atomic_commit hook) must have run
+ * drm_atomic_helper_prepare_planes() and drm_atomic_helper_swap_state()
+ * already, and must not touch @state afterwards.  The required order is
+ *
+ *     1. fallible link/DECON enable          (driver, before prepare_planes)
+ *     2. drm_atomic_helper_prepare_planes()  (driver)
+ *     3. drm_atomic_helper_swap_state()      (driver)
+ *     4. exynos7580_commit_tail()            (this function)
+ *
+ * It must not be replaced by drm_atomic_helper_commit(): the M0 helper never
+ * arms crtc_state->event, so every flip would time out in userspace.
+ *
+ * Because the M0 atomic ioctl holds dev->mode_config.mutex for its whole run,
+ * tails are serialized, and because DECON commits are synchronous the frame
+ * is latched before the events below are armed.
+ *
+ * @state is freed before returning, including on the "vblank never comes"
+ * path.
+ */
+void exynos7580_commit_tail(struct drm_atomic_state *state)
+{
+	struct drm_device *drm;
+	int i;
+
+	if (!state)
+		return;
+
+	drm = state->dev;
+
+	/*
+	 * Hardware commit.  pre: disable the outputs that a modeset removes,
+	 * reprogram the CRTC mode and encoder routing; planes: every driver
+	 * atomic_update/atomic_disable (DECON window programming, one
+	 * synchronous decon_kms_commit()); post: enable the new outputs.
+	 */
+	drm_atomic_helper_commit_pre_planes(drm, state);
+	drm_atomic_helper_commit_planes(drm, state);
+	drm_atomic_helper_commit_post_planes(drm, state);
+
+	/*
+	 * Hardware is done: arm this commit's flip events for the first
+	 * vblank after the latched frame (the drm_atomic_helper_commit_hw_done()
+	 * slot of newer kernels, minus the commit-tracking objects this tree
+	 * does not have).
+	 */
+	for (i = 0; i < drm->mode_config.num_crtc; i++) {
+		struct drm_crtc *crtc = state->crtcs[i];
+
+		if (!crtc)
+			continue;
+
+		exynos7580_complete_crtc_event(drm, crtc, crtc->state);
+	}
+
+	/*
+	 * Wait one frame so the old framebuffers are really off screen before
+	 * cleanup_planes() drops them.  The helper uses
+	 * drm_vblank_get()/dev->vbl_queue[] with a 50 ms timeout and skips a
+	 * CRTC whose vblank cannot be enabled, so this cannot hang.
+	 */
+	if (drm->num_crtcs)
+		drm_atomic_helper_wait_for_vblanks(drm, state);
+
+	drm_atomic_helper_cleanup_planes(drm, state);
+	drm_atomic_state_free(state);
+}
+
+/**
+ * exynos7580_vblank_irq - DECON frame-done interrupt
+ * @drm: DRM device
+ * @pipe: CRTC index that completed a frame
+ *
+ * Runs in hard IRQ context (the vendor FRAME interrupt path); must not sleep.
+ * drm_handle_vblank() is the 3.10 name of the upstream
+ * drm_crtc_handle_vblank(): it timestamps the vblank, increments the cooked
+ * counter, wakes dev->vbl_queue[pipe] (wait_for_vblanks() users) and sends
+ * every armed event for @pipe, dropping each event's vblank reference.
+ *
+ * Spurious interrupts (pipe not initialised, vblank not enabled, redundant
+ * timestamps) are ignored by the core, so calling this unconditionally from
+ * the shared DECON interrupt is safe.
+ */
+void exynos7580_vblank_irq(struct drm_device *drm, unsigned int pipe)
+{
+	if (!drm || pipe >= (unsigned int)drm->num_crtcs)
+		return;
+
+	drm_handle_vblank(drm, pipe);
+}
diff -u -Naur a/drivers/gpu/drm/exynos7580/exynos_drm7580_main.c b/drivers/gpu/drm/exynos7580/exynos_drm7580_main.c
--- a/drivers/gpu/drm/exynos7580/exynos_drm7580_main.c
+++ b/drivers/gpu/drm/exynos7580/exynos_drm7580_main.c
@@ -0,0 +1,715 @@
+/*
+ * Samsung Exynos 7580 DECON DRM/KMS - driver registration, probe and bind
+ *
+ * This file is the integration point of the DECON KMS slices.  It owns:
+ *
+ *   - the drm_driver (DRIVER_ATOMIC | DRIVER_MODESET | DRIVER_GEM |
+ *     DRIVER_PRIME) and its DRIVER_NAME, which must stay "exynos": Mesa's
+ *     kmsro pairs /usr/lib/dri/exynos_dri.so with the render node by driver
+ *     name (docs/reports/decon-kms-req.md, requirement 2);
+ *   - the platform_driver that binds ONLY
+ *     "samsung,exynos5-decon_driver" (never the dsim node, never a new
+ *     compatible - the shipped dt.img is used unchanged);
+ *   - registration of card0 through drm_platform_init(), at late_initcall;
+ *   - the vblank plumbing (drm_vblank_init + get/enable/disable_vblank and
+ *     the DECON FRAME interrupt trampoline) that the fence slice arms flip
+ *     events from;
+ *   - the ordered construction of the subdriver objects
+ *     (planes -> crtc -> dsi encoder/connector -> fbdev) and their unwind.
+ *
+ * Binding rules (docs/reports/decon-kms-coexist.md 4.3):
+ *
+ *   - late_initcall, not module_platform_driver: level 7 in drivers/gpu/ is
+ *     after the vendor DSIM/panel driver (level 7 in drivers/video/), so the
+ *     panel is already lit when we probe, and it is before the vendor DECON
+ *     fbdev driver, which was moved to late_initcall_sync and is the fallback
+ *     when this probe returns an error;
+ *   - every failure path returns an error to the driver core and unwinds what
+ *     this file registered; it never marks the device bound, so the vendor
+ *     `decon` fbdev driver can attach and restore today's /dev/fb0 and X11;
+ *   - no device tree change.
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License version 2 as
+ * published by the Free Software Foundation.
+ */
+
+#include <linux/err.h>
+#include <linux/export.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/scatterlist.h>
+#include <linux/vmalloc.h>
+#include <linux/slab.h>
+
+#include <drm/drmP.h>
+#include <drm/drm_atomic.h>
+#include <drm/drm_crtc.h>
+#include <drm/drm_crtc_helper.h>
+#include <drm/drm_gem_cma_helper.h>
+
+#include <linux/exynos_decon_kms.h>
+
+#include "exynos_drm7580.h"
+
+#define DRIVER_NAME		"exynos"
+#define DRIVER_DESC		"Samsung Exynos 7580 DECON DRM/KMS"
+#define DRIVER_DATE		"20261123"
+#define DRIVER_MAJOR		1
+#define DRIVER_MINOR		0
+#define DRIVER_PATCHLEVEL	0
+
+/*
+ * The only node KMS may claim.  The DSIM node stays with the vendor
+ * dsim_drv.c (level 7, drivers/video/, linked first) and the KMS DSI encoder
+ * calls into it; claiming it here would take the panel away from both.
+ */
+#define DECON_COMPATIBLE	"samsung,exynos5-decon_driver"
+#define DSIM_COMPATIBLE		"samsung,exynos5-mipi-dsi"
+
+/* The DECON has one video pipe; the CRTC is created at index 0. */
+#define EXYNOS7580_PIPE		0
+
+/* The KMS device is a singleton: there is one decon_0 in the shipped DT. */
+static struct exynos7580_device *exynos7580_device;
+
+/*
+ * Vblank users of the single pipe.  The DECON FRAME interrupt has one handler
+ * owned by the vendor shim (decon_kms_register_vblank_cb()), so the DRM
+ * refcount is kept here instead of in struct exynos7580_device, whose layout
+ * is fixed by the shared contract header.
+ *
+ * The callback is installed once from ->load() and removed in the unwind and
+ * in ->unload(), never from enable_vblank()/disable_vblank(): the DRM core
+ * calls those with dev->vbl_lock held (spinlock, IRQs off, drm_irq.c
+ * drm_vblank_get/put), and decon_kms_register_vblank_cb() is documented as
+ * process context.
+ */
+static atomic_t exynos7580_vblank_users = ATOMIC_INIT(0);
+
+static const struct file_operations exynos7580_fops;
+
+/* ------------------------------------------------------------------------
+ * vblank / DRM_IRQ plumbing
+ *
+ * The vendor DECON driver owns the interrupt; decon_kms_register_vblank_cb()
+ * installs our callback on the FRAME interrupt and enables it while a callback
+ * is registered.  DRM only needs the three driver hooks below plus a
+ * drm_handle_vblank() call from the IRQ: get_vblank_counter() feeds
+ * drm_vblank_count() (the core accounts for missed interrupts), which is what
+ * drm_crtc_arm_vblank_event() in the fence slice timestamps its events with.
+ * ------------------------------------------------------------------------ */
+
+static u32 exynos7580_get_vblank_counter(struct drm_device *drm, int pipe)
+{
+	if (pipe != EXYNOS7580_PIPE)
+		return 0;
+
+	return drm_vblank_count(drm, pipe);
+}
+
+/*
+ * Runs in hard IRQ context on every frame-done interrupt of the DECON.
+ * Must not sleep and must not call back into the decon_kms API.
+ */
+static void exynos7580_vblank_isr(void *data)
+{
+	struct exynos7580_device *ex = data;
+
+	if (!ex || !ex->dev)
+		return;
+
+	drm_handle_vblank(ex->drm, EXYNOS7580_PIPE);
+	exynos7580_vblank_irq(ex->drm, EXYNOS7580_PIPE);
+}
+
+static int exynos7580_enable_vblank(struct drm_device *drm, int pipe)
+{
+	if (pipe != EXYNOS7580_PIPE)
+		return -EINVAL;
+	if (!to_exynos7580(drm))
+		return -ENODEV;
+
+	/* The FRAME interrupt is already armed from ->load(). */
+	atomic_inc(&exynos7580_vblank_users);
+	return 0;
+}
+
+static void exynos7580_disable_vblank(struct drm_device *drm, int pipe)
+{
+	if (pipe != EXYNOS7580_PIPE)
+		return;
+
+	atomic_dec(&exynos7580_vblank_users);
+}
+
+/* ------------------------------------------------------------------------
+ * PRIME export of CMA (dumb/scanout) buffers
+ *
+ * KWin creates its scanout buffers through CREATE_DUMB and then exports them
+ * with drmPrimeHandleToFD() for the GPU (docs/reports/decon-kms-req.md,
+ * requirement 21).  The generic 3.10 helper drm_gem_prime_export() needs the
+ * sg-table/vmap callbacks below; import of foreign buffers is the dmabuf
+ * slice's exynos7580_gem_prime_import(), see exynos_drm7580.h.
+ *
+ * These callbacks describe drm_gem_cma_object buffers.  That is exactly what
+ * CREATE_DUMB allocates here; a buffer imported from another exporter is not
+ * re-exported through this path by any supported user.
+ * ------------------------------------------------------------------------ */
+
+static struct sg_table *exynos7580_gem_prime_get_sg_table(
+					struct drm_gem_object *obj)
+{
+	struct drm_gem_cma_object *cma_obj = to_drm_gem_cma_obj(obj);
+	struct sg_table *sgt;
+	int ret;
+
+	sgt = kzalloc(sizeof(*sgt), GFP_KERNEL);
+	if (!sgt)
+		return ERR_PTR(-ENOMEM);
+
+	ret = sg_alloc_table(sgt, 1, GFP_KERNEL);
+	if (ret) {
+		kfree(sgt);
+		return ERR_PTR(ret);
+	}
+
+	/*
+	 * int111: sg_set_buf() would take virt_to_page(cma_obj->vaddr).  For a
+	 * multi-MB dma_alloc_coherent() buffer vaddr is vmalloc-mapped, so that
+	 * page is meaningless and the importer (panfrost via kmsro) maps
+	 * garbage into its address space -- the AS0 TRANSLATION_FAULT/READ
+	 * storm in dmesg.  Use the physical base that drm_gem_cma_object
+	 * already carries.
+	 */
+	pr_info("exynos7580_prime_get_sg_table: obj=%p import_attach=%p paddr=%pad vaddr=%p size=%zu\n",
+		obj, obj->import_attach, &cma_obj->paddr, cma_obj->vaddr, obj->size);
+	sg_set_page(sgt->sgl, phys_to_page(cma_obj->paddr), obj->size,
+		    cma_obj->paddr & ~PAGE_MASK);
+	sg_dma_address(sgt->sgl) = cma_obj->paddr;
+	sg_dma_len(sgt->sgl) = obj->size;
+
+	return sgt;
+}
+
+static void *exynos7580_gem_prime_vmap(struct drm_gem_object *obj)
+{
+	return to_drm_gem_cma_obj(obj)->vaddr;
+}
+
+static void exynos7580_gem_prime_vunmap(struct drm_gem_object *obj,
+					void *vaddr)
+{
+}
+
+/* ------------------------------------------------------------------------
+ * Atomic check/commit
+ *
+ * Both are implemented and exported by the CRTC slice
+ * (exynos_drm7580_crtc.c): the fallible DECON/DSI bring-up has to run before
+ * any plane state is prepared or swapped, and a NONBLOCK|PAGE_FLIP_EVENT
+ * request (KWin flips) must run the same tail as a blocking one, so the
+ * generic drm_atomic_helper_commit()/drm_atomic_helper_check() entry points
+ * are not used directly here.  The window programming itself (one
+ * decon_kms_commit() from the last plane hook) and the vblank-armed flip event
+ * are owned by the plane and fence slices.
+ *
+ * Declared here rather than in the contract header: the header is frozen for
+ * this slice, and KmsAssemble folds the two prototypes in when it assembles
+ * the series.
+ * ------------------------------------------------------------------------ */
+
+int exynos7580_atomic_check(struct drm_device *drm,
+			    struct drm_atomic_state *state);
+int exynos7580_atomic_commit(struct drm_device *drm,
+			     struct drm_atomic_state *state, bool async);
+
+static const struct drm_mode_config_funcs exynos7580_mode_config_funcs = {
+	.fb_create	= exynos7580_fb_create,
+	.atomic_check	= exynos7580_atomic_check,
+	.atomic_commit	= exynos7580_atomic_commit,
+};
+
+/* ------------------------------------------------------------------------
+ * Initial modeset
+ *
+ * The fbdev slice owns fb0 and the drm_fb_helper behind it; its
+ * exynos7580_fbdev_init() performs the coexist-mandated
+ * drm_modeset_lock_all() + drm_fb_helper_restore_fbdev_mode() sequence
+ * (through drm_fbdev_cma_restore_mode()) and returns an error when fb0 did
+ * not register or the CRTC does not scan it out.  Main cannot repeat that
+ * call: the helper is not part of the shared contract and the fence/plane
+ * slices own the commit path.  What main does own is the postcondition - a
+ * modeset that registered fb0 but left the CRTC inactive is a probe failure,
+ * because the vendor fallback would otherwise find its own fb0 already taken.
+ * ------------------------------------------------------------------------ */
+
+static int exynos7580_initial_modeset(struct exynos7580_device *ex,
+				      struct drm_device *drm)
+{
+	struct drm_plane *plane = ex->crtc.primary;
+	struct drm_plane_state *pstate;
+	struct drm_framebuffer *fb = NULL;
+	bool ok;
+	int ret = 0;
+
+	drm_modeset_lock_all(drm);
+
+	/*
+	 * int76: the postcondition must use the atomic state, not the legacy
+	 * crtc->state->enable / plane->fb fields (the atomic commit path does
+	 * not maintain them; int74 fixed the same mistake in the fbdev slice).
+	 * Log every field so a real mismatch is unambiguous.
+	 */
+	pstate = plane ? plane->state : NULL;
+	DRM_INFO("initial modeset state: crtc id=%u enabled=%d state=%p active=%d enable=%d planes_empty=%d primary=%p pstate=%p pstate->fb=%p legacy->fb=%p\n",
+		 ex->crtc.base.id, ex->crtc.enabled, ex->crtc.state,
+		 ex->crtc.state ? ex->crtc.state->active : -1,
+		 ex->crtc.state ? ex->crtc.state->enable : -1,
+		 list_empty(&drm->mode_config.plane_list), plane, pstate,
+		 pstate ? pstate->fb : NULL, plane ? plane->fb : NULL);
+
+	ok = ex->crtc.state && ex->crtc.state->active && ex->crtc.enabled &&
+	     pstate && pstate->fb;
+	if (!ok) {
+		if (list_empty(&drm->mode_config.fb_list)) {
+			DRM_ERROR("initial modeset: no framebuffer to attach\n");
+			ret = -EIO;
+		} else {
+			fb = list_first_entry(&drm->mode_config.fb_list,
+					      struct drm_framebuffer, head);
+		}
+	}
+	drm_modeset_unlock_all(drm);
+	if (ret || ok)
+		return ret;
+
+	/*
+	 * int76: if the fb_helper path did not leave the primary plane
+	 * attached to fb0, make the first frame explicit instead of failing:
+	 * allocate a state, attach the fb to the primary plane and commit it
+	 * through our atomic_commit (without the modeset locks held).
+	 */
+	{
+		struct drm_atomic_state *state = drm_atomic_state_alloc(drm);
+		struct drm_plane_state *sp;
+
+		if (!state)
+			return -ENOMEM;
+		sp = drm_atomic_get_plane_state(state, plane);
+		if (IS_ERR(sp)) {
+			ret = PTR_ERR(sp);
+			drm_atomic_state_free(state);
+			return ret;
+		}
+		drm_atomic_set_fb_for_plane(sp, fb);
+		DRM_INFO("initial modeset: explicit commit of fb %p on plane %p\n", fb, plane);
+		ret = drm_atomic_commit(state);
+		DRM_INFO("initial modeset: explicit commit ret=%d\n", ret);
+		if (ret)
+			return ret;
+	}
+
+	drm_modeset_lock_all(drm);
+	pstate = plane ? plane->state : NULL;
+	if (!ex->crtc.state || !ex->crtc.state->active || !ex->crtc.enabled ||
+	    !pstate || pstate->fb != fb) {
+		DRM_ERROR("initial modeset still inconsistent after the explicit commit: active=%d enabled=%d pstate->fb=%p want=%p\n",
+			  ex->crtc.state ? ex->crtc.state->active : -1,
+			  ex->crtc.enabled, pstate ? pstate->fb : NULL, fb);
+		ret = -EIO;
+	}
+	drm_modeset_unlock_all(drm);
+	return ret;
+}
+
+/* ------------------------------------------------------------------------
+ * load / unload
+ * ------------------------------------------------------------------------ */
+
+static int exynos7580_load(struct drm_device *drm, unsigned long flags)
+{
+	struct exynos7580_device *ex;
+	int ret;
+
+	/*
+	 * The DRM core allocates the drm_device (drm_platform_init() ->
+	 * drm_get_platform_dev()); we only keep a pointer to it and publish our
+	 * own state through dev_private, which is what to_exynos7580() reads.
+	 */
+	ex = platform_get_drvdata(drm->platformdev);
+	if (!ex)
+		return -ENODEV;
+
+	ex->drm = drm;
+	ex->dev = &drm->platformdev->dev;
+	drm->dev_private = ex;
+
+	drm_mode_config_init(drm);
+	/*
+	 * DECON's only hard limit is a 128-byte minimum stride, which
+	 * exy7580_fb_check() enforces per format.  A 32x32 ARGB hardware
+	 * cursor is exactly 128 bytes wide and must be accepted: KWin
+	 * aborts when its cursor framebuffer cannot be created.
+	 */
+	drm->mode_config.min_width = 32;
+	drm->mode_config.min_height = 32;
+	drm->mode_config.max_width = 2048;
+	drm->mode_config.max_height = 2048;
+	drm->mode_config.funcs = &exynos7580_mode_config_funcs;
+
+	ret = drm_vblank_init(drm, 1);
+	if (ret) {
+		DRM_ERROR("drm_vblank_init failed: %d\n", ret);
+		goto err_config;
+	}
+
+	/* Planes first: the CRTC is created around planes[0]. */
+	ret = exynos7580_planes_init(ex);
+	if (ret) {
+		DRM_ERROR("plane init failed: %d\n", ret);
+		goto err_vblank;
+	}
+
+	ret = exynos7580_crtc_init(ex);
+	if (ret) {
+		DRM_ERROR("CRTC init failed: %d\n", ret);
+		goto err_vblank;
+	}
+
+	/*
+	 * Allocate the per-object atomic states.  The reset callback of the
+	 * connector is called by hand after dsi_init() below:
+	 * drm_mode_config_reset() forces connector->status to unknown, and
+	 * only the DSI encoder knows the panel is connected.
+	 */
+	drm_mode_config_reset(drm);
+
+	dev_info(ex->dev, "exynos7580: load: dsi_init()\n");
+	ret = exynos7580_dsi_init(ex);
+	if (ret) {
+		DRM_ERROR("DSI encoder/connector init failed: %d\n", ret);
+		goto err_vblank;
+	}
+	if (!ex->connector.state && ex->connector.funcs->reset)
+		ex->connector.funcs->reset(&ex->connector);
+
+	/*
+	 * Arm the FRAME interrupt before the first commit: the initial modeset
+	 * below arms its flip event from vblank, so the counter must advance.
+	 */
+	dev_info(ex->dev, "exynos7580: load: registering DECON FRAME callback\n");
+	ret = decon_kms_register_vblank_cb(ex->decon, exynos7580_vblank_isr, ex);
+	if (ret) {
+		DRM_ERROR("failed to arm DECON FRAME interrupt: %d\n", ret);
+		goto err_vblank;
+	}
+
+	/*
+	 * Last fallible step: this registers /dev/fb0 and runs the initial
+	 * modeset.  exynos7580_fbdev_init() must leave no fb0 behind when it
+	 * fails (otherwise the vendor fallback would only get fb1).
+	 */
+	dev_info(ex->dev, "exynos7580: load: fbdev_init() (card0 fb0)\n");
+	ret = exynos7580_fbdev_init(ex);
+	if (ret) {
+		DRM_ERROR("fbdev init failed: %d\n", ret);
+		goto err_vblank;
+	}
+
+	dev_info(ex->dev, "exynos7580: load: initial modeset\n");
+	ret = exynos7580_initial_modeset(ex, drm);
+	if (ret) {
+		dev_err(ex->dev, "exynos7580: load: initial modeset failed (%d)\n", ret);
+		goto err_vblank;
+	}
+
+	DRM_INFO("exynos7580: %s bound, card0 ready (atomic)\n",
+		 DECON_COMPATIBLE);
+
+	return 0;
+
+err_vblank:
+	decon_kms_register_vblank_cb(ex->decon, NULL, NULL);
+	exynos7580_fbdev_fini();
+	drm_vblank_cleanup(drm);
+err_config:
+	drm_mode_config_cleanup(drm);
+	drm->dev_private = NULL;
+	ex->drm = NULL;
+	return ret;
+}
+
+static int exynos7580_unload(struct drm_device *drm)
+{
+	struct exynos7580_device *ex = drm->dev_private;
+
+	if (!ex)
+		return 0;
+
+	atomic_set(&exynos7580_vblank_users, 0);
+	decon_kms_register_vblank_cb(ex->decon, NULL, NULL);
+
+	/*
+	 * fb0 first: drm_fbdev_cma_fini() destroys the fb helper and its
+	 * private framebuffer, so it must not run after
+	 * drm_mode_config_cleanup() has freed the CRTCs/planes/framebuffers it
+	 * still points at (the devres action that used to do this runs after
+	 * ->unload()).
+	 */
+	exynos7580_fbdev_fini();
+
+	drm_vblank_cleanup(drm);
+	drm_mode_config_cleanup(drm);
+
+	if (ex->decon) {
+		decon_kms_put(ex->decon);
+		ex->decon = NULL;
+	}
+
+	vfree(ex->shadow);
+	ex->shadow = NULL;
+	ex->shadow_size = 0;
+
+	drm->dev_private = NULL;
+	ex->drm = NULL;
+
+	return 0;
+}
+
+/* ------------------------------------------------------------------------
+ * drm_driver
+ * ------------------------------------------------------------------------ */
+
+static struct drm_driver exynos7580_drm_driver = {
+	.driver_features	= DRIVER_ATOMIC | DRIVER_MODESET |
+				  DRIVER_GEM | DRIVER_PRIME,
+	.load			= exynos7580_load,
+	.unload			= exynos7580_unload,
+	.get_vblank_counter	= exynos7580_get_vblank_counter,
+	.enable_vblank		= exynos7580_enable_vblank,
+	.disable_vblank		= exynos7580_disable_vblank,
+	.gem_free_object	= drm_gem_cma_free_object,
+	.gem_vm_ops		= &drm_gem_cma_vm_ops,
+	.gem_prime_export	= drm_gem_prime_export,
+	.gem_prime_get_sg_table	= exynos7580_gem_prime_get_sg_table,
+	.gem_prime_vmap		= exynos7580_gem_prime_vmap,
+	.gem_prime_vunmap	= exynos7580_gem_prime_vunmap,
+	.gem_prime_import	= exynos7580_gem_prime_import,
+	/*
+	 * int84: DRM_PRIME alone does not fill DRM_CAP_PRIME; kmsro's first
+	 * allocation step is drmPrimeHandleToFD(card0, dumb_handle), so the
+	 * card0 drm_driver needs the two prime ioctl hooks as well (they were
+	 * missing, hence DRM_CAP_PRIME=0x0 on int83).
+	 */
+	.prime_handle_to_fd	= drm_gem_prime_handle_to_fd,
+	.prime_fd_to_handle	= drm_gem_prime_fd_to_handle,
+	.dumb_create		= drm_gem_cma_dumb_create,
+	.dumb_map_offset	= drm_gem_cma_dumb_map_offset,
+	.dumb_destroy		= drm_gem_cma_dumb_destroy,
+	.fops			= &exynos7580_fops,
+	.name			= DRIVER_NAME,
+	.desc			= DRIVER_DESC,
+	.date			= DRIVER_DATE,
+	.major			= DRIVER_MAJOR,
+	.minor			= DRIVER_MINOR,
+	.patchlevel		= DRIVER_PATCHLEVEL,
+};
+
+/*
+ * KWin opens card0 without O_NONBLOCK and reads DRM events from its main
+ * loop.  drm_read() then sleeps until an event arrives; on this driver the
+ * event queue can stay empty (no page-flip events), which wedges the
+ * compositor: it stops servicing Wayland/DBus clients entirely.
+ * Force non-blocking semantics for the read call so an empty queue returns
+ * -EAGAIN and the caller's poll() keeps working.
+ */
+static ssize_t exynos7580_read(struct file *filp, char __user *buffer,
+			       size_t count, loff_t *offset)
+{
+	struct drm_file *file_priv = filp->private_data;
+
+	/*
+	 * This tree's drm_read() has no O_NONBLOCK branch: it always sleeps
+	 * in wait_event_interruptible().  KWin reads DRM events from its main
+	 * loop and blocks there forever, so the compositor stops servicing
+	 * Wayland clients.  Return -EAGAIN when the queue is empty instead.
+	 */
+	if (!file_priv || list_empty(&file_priv->event_list))
+		return -EAGAIN;
+
+	return drm_read(filp, buffer, count, offset);
+}
+
+static const struct file_operations exynos7580_fops = {
+	.owner		= THIS_MODULE,
+	.open		= drm_open,
+	.release	= drm_release,
+	.unlocked_ioctl	= drm_ioctl,
+#ifdef CONFIG_COMPAT
+	.compat_ioctl	= drm_compat_ioctl,
+#endif
+	.poll		= drm_poll,
+	.read		= exynos7580_read,
+	.mmap		= drm_gem_cma_mmap,
+};
+
+/* ------------------------------------------------------------------------
+ * platform_driver / late_initcall bind
+ * ------------------------------------------------------------------------ */
+
+static int exynos7580_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct exynos7580_device *ex;
+	const struct decon_kms_caps *caps;
+	int ret;
+
+	/* Match the DECON node only, and never the dsim/panel nodes. */
+	if (!dev->of_node)
+		return -ENODEV;
+	if (!of_device_is_compatible(dev->of_node, DECON_COMPATIBLE))
+		return -ENODEV;
+	if (of_device_is_compatible(dev->of_node, DSIM_COMPATIBLE))
+		return -ENODEV;
+	if (!of_device_is_available(dev->of_node))
+		return -ENODEV;
+
+	ex = devm_kzalloc(dev, sizeof(*ex), GFP_KERNEL);
+	if (!ex)
+		return -ENOMEM;
+
+	ex->dev = dev;
+
+	dev_info(dev, "exynos7580: probe entry (DECON node %s), binding card0\n",
+		 of_node_full_name(dev->of_node));
+
+	/*
+	 * Hand-off with the vendor DECON core.  In KMS mode the vendor
+	 * decon_probe() does not run (this driver owns the device), so the
+	 * shim's decon_kms_get() stands the DECON up for us: clocks, SFR
+	 * mapping, runtime PM/iovmm and the panel hand-off.  If it cannot, the
+	 * probe fails here, before any DRM object exists.
+	 */
+	dev_info(dev, "exynos7580: probe: calling decon_kms_get()\n");
+	ex->decon = decon_kms_get(dev);
+	if (IS_ERR(ex->decon)) {
+		ret = PTR_ERR(ex->decon);
+		ex->decon = NULL;
+		dev_err(dev, "exynos7580: probe: decon_kms_get failed (%d)\n", ret);
+		if (ret == -ENODEV || ret == -EPROBE_DEFER) {
+			/* exynos-mdev / DSIM / panel not up yet: retry later. */
+			dev_info(dev, "exynos7580: DECON/DSIM not ready, deferring probe\n");
+			ret = -EPROBE_DEFER;
+		}
+		goto err_drvdata;
+	}
+	caps = decon_kms_caps(ex->decon);
+	dev_info(dev, "exynos7580: probe: decon_kms_get ok (%u windows, default %u)\n",
+		 caps ? caps->max_win : 0, caps ? caps->default_win : 0);
+	/*
+	 * Publish our own drvdata only now.  decon_kms_get() reads
+	 * platform_get_drvdata() and expects the vendor decon_device (or
+	 * NULL): installing struct exynos7580_device before the call made it
+	 * read a bogus kms_owned and reject the hand-off with -EBUSY
+	 * ("DECON already owned by the fbdev driver").
+	 */
+	platform_set_drvdata(pdev, ex);
+	dev_info(dev, "exynos7580: probe: decon ok, drvdata published\n");
+
+	dev_info(dev, "exynos7580: probe: calling drm_platform_init()\n");
+	ret = drm_platform_init(&exynos7580_drm_driver, pdev);
+	if (ret) {
+		dev_err(dev, "exynos7580: probe: drm_platform_init failed (%d)\n", ret);
+		goto err_decon;
+	}
+
+	exynos7580_device = ex;
+	dev_info(dev, "exynos7580: probe: success, card0 registered\n");
+
+	return 0;
+
+err_decon:
+	decon_kms_put(ex->decon);
+	ex->decon = NULL;
+err_drvdata:
+	platform_set_drvdata(pdev, NULL);
+	return ret;
+}
+
+static int exynos7580_remove(struct platform_device *pdev)
+{
+	exynos7580_device = NULL;
+
+	/*
+	 * drm_platform_exit() -> drm_put_dev() -> ->unload() releases the
+	 * CRTC/planes/connector, the vblank core and the DECON handle.
+	 */
+	drm_platform_exit(&exynos7580_drm_driver, pdev);
+
+	platform_set_drvdata(pdev, NULL);
+
+	return 0;
+}
+
+static const struct of_device_id exynos7580_drm_dt_match[] = {
+	{ .compatible = DECON_COMPATIBLE },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, exynos7580_drm_dt_match);
+
+static struct platform_driver exynos7580_drm_platform_driver = {
+	.probe	= exynos7580_probe,
+	.remove	= exynos7580_remove,
+	.driver	= {
+		.name		= "exynos7580-decon-drm",
+		.owner		= THIS_MODULE,
+		.of_match_table	= exynos7580_drm_dt_match,
+	},
+};
+
+/*
+ * Level 7: after the vendor DSIM/panel driver (late_initcall in
+ * drivers/video/, linked before drivers/gpu/), before the vendor DECON fbdev
+ * driver, which is late_initcall_sync in the KMS image and binds only if this
+ * probe returned an error.  Never module_platform_driver: that is level 6,
+ * before the panel exists.
+ */
+static int __init exynos7580_drm_init(void)
+{
+	return platform_driver_register(&exynos7580_drm_platform_driver);
+}
+
+#ifdef MODULE
+/*
+ * int53: built as a loadable module.  module_init is level 6, which is
+ * fine because nothing binds at boot: the module is only loaded by hand
+ * after the vendor fbdev driver has been unbound, i.e. after the panel
+ * driver and the vendor stack are fully up.  The built-in image keeps the
+ * level-7 late_initcall so the vendor fbdev fallback ordering is
+ * unchanged.
+ */
+static void __exit exynos7580_drm_exit(void)
+{
+	platform_driver_unregister(&exynos7580_drm_platform_driver);
+}
+
+module_init(exynos7580_drm_init);
+module_exit(exynos7580_drm_exit);
+#else
+/*
+ * int61: run at late_initcall_sync, after every late_initcall (the DSIM
+ * driver, the panel driver and exynos-mdev all register at late_initcall or
+ * earlier).  This is our driver, not the vendor DECON one, so the int58
+ * hazard (moving the *vendor* fbdev driver to sync) does not apply: if the
+ * panel/mdev is still absent the probe defers and the driver core retries.
+ */
+late_initcall_sync(exynos7580_drm_init);
+#endif
+
+MODULE_AUTHOR("gpu31-kms");
+MODULE_DESCRIPTION(DRIVER_DESC);
+MODULE_LICENSE("GPL");
+MODULE_VERSION("int129");
diff -u -Naur a/drivers/gpu/drm/exynos7580/exynos_drm7580_plane.c b/drivers/gpu/drm/exynos7580/exynos_drm7580_plane.c
--- a/drivers/gpu/drm/exynos7580/exynos_drm7580_plane.c
+++ b/drivers/gpu/drm/exynos7580/exynos_drm7580_plane.c
@@ -0,0 +1,725 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * exynos_drm7580_plane.c - DECON KMS primary/overlay planes
+ *
+ * Part of the exynos7580 DECON DRM/KMS subdriver.  The planes are thin
+ * translators: they validate one atomic plane state against the limits of the
+ * vendor window engine and hand a frame built of struct decon_kms_win
+ * descriptors to decon_kms_commit().  No DECON register is touched here.
+ *
+ * Window/plane assignment is fixed by the board DT and the vendor driver:
+ *
+ *   plane 0  primary   window 0  IDMA G0   (decon_fb default_win = 0)
+ *   plane 1  overlay   window 1  IDMA G1
+ *   plane 2  overlay   window 2  IDMA VG0  (only window with a YUV channel)
+ *
+ * The vendor exposes max_win = 3 on j7elte (exynos7580.dtsi:1145) although the
+ * DECON block itself has MAX_DECON_WIN = 7 (decon.h:45); planes_init() only
+ * registers what decon_kms_caps()->max_win allows and atomic_check() reports
+ * -ENOSPC for anything beyond it, which is the signal KWin uses to drop an
+ * overlay plane in its TEST_ONLY commit.
+ *
+ * zpos: M0's struct drm_plane_state (include/drm/drm_crtc.h) has no zpos or
+ * alpha field and the backport does not create the matching properties, so
+ * neither can be exposed to userspace.  Stacking order is nevertheless fixed
+ * and correct: window index == plane index, primary at the bottom.  Per-plane
+ * alpha is hardwired to 0xff ("no plane alpha"); per-pixel alpha is honoured
+ * for the ARGB formats through the DECON blender.
+ */
+
+#include <drm/drmP.h>
+#include <drm/drm_atomic.h>
+#include <drm/drm_atomic_helper.h>
+#include <drm/drm_crtc_helper.h>
+#include <drm/drm_plane_helper.h>
+
+#include <linux/exynos_decon_kms.h>
+
+#include "exynos_drm7580.h"
+
+#include <linux/module.h>
+#include <linux/vmalloc.h>
+static unsigned int exynos7580_fourcc32;
+module_param(exynos7580_fourcc32, uint, 0644);
+MODULE_PARM_DESC(exynos7580_fourcc32,
+	"DRM fourcc handed to DECON for 32-bpp windows (0 = compiled-in mapping)");
+
+/*
+ * Format description as the vendor DECON sees it.
+ *
+ * @bpp:    bits per pixel the vendor driver uses to pick WINCON_BPPMODE and
+ *          to size the "window width >= 128 bytes" check; 12 is the vendor
+ *          value for NV12/NV21 (decon_core.c:1568-1578, wincon():175-208).
+ * @planes: memory planes in the framebuffer (drm_format_num_planes()).
+ * @alpha:  the format carries an alpha channel the DECON blender can use
+ *          (decon_transp_length():425-451).
+ * @yuv:    YUV420 semi-planar, only reachable through the VG channel
+ *          (regs-decon.h:90-91, WINCON_BPPMODE_NV21/NV12).
+ *
+ * Only formats that decon_get_memory_plane_cnt() accepts and wincon() can
+ * encode are listed (decon_core.c:1369-1409, 175-208).
+ */
+struct exynos7580_format {
+	u32		fourcc;
+	unsigned int	bpp;
+	unsigned int	planes;
+	bool		alpha;
+	bool		yuv;
+};
+
+static const struct exynos7580_format exynos7580_formats[] = {
+	{ DRM_FORMAT_ARGB8888, 32, 1, true,  false },
+	{ DRM_FORMAT_XRGB8888, 32, 1, false, false },
+	{ DRM_FORMAT_RGB565,   16, 1, false, false },
+	{ DRM_FORMAT_NV12,     12, 2, false, true  },
+	{ DRM_FORMAT_NV21,     12, 2, false, true  },
+};
+
+/* Direct-colour planes (G0/G1): RGB only. */
+static const u32 exynos7580_rgb_formats[] = {
+	DRM_FORMAT_ARGB8888,
+	DRM_FORMAT_XRGB8888,
+	DRM_FORMAT_RGB565,
+};
+
+/* The VG channel additionally has the YUV420 converters. */
+static const u32 exynos7580_vg_formats[] = {
+	DRM_FORMAT_ARGB8888,
+	DRM_FORMAT_XRGB8888,
+	DRM_FORMAT_RGB565,
+	DRM_FORMAT_NV12,
+	DRM_FORMAT_NV21,
+};
+
+/*
+ * One DMA channel per window.  Window 0 must keep the channel the bootloader
+ * and the vendor driver left on it (G0): decon_kms_api.md recommends it and
+ * decon_api.h documents the same rule.  The three channels are distinct, which
+ * is what decon_reg_chmap_validate() requires (decon_core.c:1886-1900);
+ * decon_reg_config_win_channel() encodes G0/G1 as WINCHMAP 1/2 and the VG
+ * family as 0 (decon_reg_7580.c:320-346).
+ */
+static const enum decon_kms_idma exynos7580_plane_idma[] = {
+	DECON_KMS_IDMA_G0,
+	DECON_KMS_IDMA_G1,
+	DECON_KMS_IDMA_VG0,
+};
+
+static unsigned int exynos7580_plane_index(struct exynos7580_device *ex,
+					   struct drm_plane *plane)
+{
+	return plane - ex->planes;
+}
+
+static const struct exynos7580_format *
+exynos7580_format_lookup(u32 fourcc)
+{
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(exynos7580_formats); i++)
+		if (exynos7580_formats[i].fourcc == fourcc)
+			return &exynos7580_formats[i];
+
+	return NULL;
+}
+
+/*
+ * Geometry validation shared by atomic_check() and the commit gatherer.
+ * Every limit below is enforced by the vendor window code as well:
+ *
+ *  - no scaling: does_layer_need_scale() (decon_core.c:610-613) disables the
+ *    window when dst.w/h != src.w/h;
+ *  - dst.x/y must be non-negative and dst.w/h non-zero
+ *    (decon_set_win_buffer(), decon_core.c:1545-1552);
+ *  - a direct-colour window must be at least 128 bytes wide
+ *    (decon_core.c:1580-1586);
+ *  - src.f_w >= dst.w (decon_core.c:1588-1594);
+ *  - direct-colour x coordinates must be aligned to the 32-bit word
+ *    (decon_validate_x_alignment(), decon_core.c:551-568).
+ */
+static int exynos7580_check_rect(const struct exynos7580_format *fmt,
+				 const struct decon_kms_frame *src,
+				 const struct decon_kms_frame *dst)
+{
+	unsigned int align, width;
+
+	if (src->w == 0 || src->h == 0 || dst->w == 0 || dst->h == 0) {
+		pr_info("exynos7580_check_rect: FAIL zero size src=%ux%u dst=%ux%u\n",
+			src->w, src->h, dst->w, dst->h);
+		return -EINVAL;
+	}
+	if (src->x < 0 || src->y < 0 || dst->x < 0 || dst->y < 0) {
+		pr_info("exynos7580_check_rect: FAIL negative pos src=%+d%+d dst=%+d%+d\n",
+			src->x, src->y, dst->x, dst->y);
+		return -EINVAL;
+	}
+
+	/* The window engine cannot scale. */
+	if (src->w != dst->w || src->h != dst->h) {
+		pr_info("exynos7580_check_rect: FAIL scaling src=%ux%u dst=%ux%u\n",
+			src->w, src->h, dst->w, dst->h);
+		return -EINVAL;
+	}
+
+	if (src->f_w == 0 || src->f_h == 0) {
+		pr_info("exynos7580_check_rect: FAIL zero stride f_w=%u f_h=%u\n",
+			src->f_w, src->f_h);
+		return -EINVAL;
+	}
+	if (src->f_w < (u32)src->x + src->w ||
+	    src->f_h < (u32)src->y + src->h ||
+	    src->f_w < dst->w) {
+		pr_info("exynos7580_check_rect: FAIL outside fb src=%+d%+d %ux%u f=%ux%u dst_w=%u\n",
+			src->x, src->y, src->w, src->h,
+			src->f_w, src->f_h, dst->w);
+		return -EINVAL;
+	}
+
+	if (fmt->bpp > 12) {
+		width = dst->w * fmt->bpp / 8;
+		if (width < 128) {
+			pr_info("exynos7580_check_rect: FAIL width %u B < 128 (w=%u bpp=%u)\n",
+				width, dst->w, fmt->bpp);
+			return -EINVAL;
+		}
+
+		align = 32 / fmt->bpp;
+		if (align > 1 &&
+		    ((dst->x % align) || ((dst->x + dst->w) % align))) {
+			pr_info("exynos7580_check_rect: FAIL x align=%u x=%d w=%u\n",
+				align, dst->x, dst->w);
+			return -EINVAL;
+		}
+	}
+
+	return 0;
+}
+
+/*
+ * Translate one atomic plane state into a DECON window descriptor.
+ *
+ * @with_addr: resolve scanout addresses through exynos7580_fb_scanout().
+ *             atomic_check() passes false so that a TEST_ONLY commit never
+ *             touches the buffer mapping path; the commit gatherer passes
+ *             true.
+ */
+static int exynos7580_plane_state_to_win(struct exynos7580_device *ex,
+					 unsigned int win_idx,
+					 struct drm_plane_state *state,
+					 struct decon_kms_win *win,
+					 bool with_addr)
+{
+	const struct exynos7580_format *fmt;
+	struct drm_framebuffer *fb;
+	unsigned int i, nplanes;
+	int ret;
+
+	memset(win, 0, sizeof(*win));
+	win->state = DECON_KMS_WIN_DISABLED;
+
+	if (!state || !state->crtc || !state->fb)
+		return 0;
+
+	if (state->crtc != &ex->crtc) {
+		DRM_ERROR("[PLANE:%d] crtc %d is not the DECON crtc\n",
+			  state->plane->base.id, state->crtc->base.id);
+		return -EINVAL;
+	}
+
+	fb = state->fb;
+	fmt = exynos7580_format_lookup(fb->pixel_format);
+	if (!fmt) {
+		DRM_ERROR("[PLANE:%d] unsupported pixel format 0x%08x\n",
+			  state->plane->base.id, fb->pixel_format);
+		return -EINVAL;
+	}
+
+	if (fmt->yuv && win_idx != 2) {
+		DRM_ERROR("[PLANE:%d] YUV format on a non-VG window\n",
+			  state->plane->base.id);
+		return -EINVAL;
+	}
+
+	/* 16.16 fixed point: no fractional source position or size. */
+	if ((state->src_x | state->src_y | state->src_w | state->src_h) & 0xffff) {
+		pr_info("[PLANE:%d] FAIL fractional src=0x%x,0x%x,0x%x,0x%x (16.16)\n",
+			state->plane->base.id, state->src_x, state->src_y,
+			state->src_w, state->src_h);
+		return -EINVAL;
+	}
+
+	win->state = DECON_KMS_WIN_BUFFER;
+	win->fourcc = fb->pixel_format;
+	win->idma_type = exynos7580_plane_idma[win_idx];
+	win->blending = win_idx == 0 ? DECON_KMS_BLENDING_NONE :
+			(fmt->alpha ? DECON_KMS_BLENDING_PREMULT :
+				      DECON_KMS_BLENDING_NONE);
+	/*
+	 * A primary window without blending multiplies the pixel alpha in
+	 * anyway on this DECON revision: buffers whose alpha channel is zero
+	 * (EGL configs without alpha, e.g. KWin's GBM surfaces) then scan out
+	 * black.  Program the matching XRGB variant so alpha is ignored; the
+	 * byte layout is identical.
+	 */
+	/*
+	 * Diagnostic override: the DRM fourcc this driver hands the vendor
+	 * DECON decides the WINCON BPPMODE (decon_rgborder()) and therefore
+	 * the on-screen channel order.  Set to 0 for the compiled-in choice.
+	 */
+	if (exynos7580_fourcc32 && fmt->bpp == 32)
+		win->fourcc = exynos7580_fourcc32;
+
+	if (win->blending == DECON_KMS_BLENDING_NONE) {
+		switch (win->fourcc) {
+		/* Measured: ARGB buffers display correctly when DECON is
+		 * handed BGRX8888 (WINCON BPPMODE_XRGB8888); the previous
+		 * XRGB mapping complemented/shifted the channels. */
+		case DRM_FORMAT_ARGB8888: win->fourcc = DRM_FORMAT_BGRX8888; break;
+		case DRM_FORMAT_ABGR8888: win->fourcc = DRM_FORMAT_XBGR8888; break;
+		case DRM_FORMAT_RGBA8888: win->fourcc = DRM_FORMAT_RGBX8888; break;
+		case DRM_FORMAT_BGRA8888: win->fourcc = DRM_FORMAT_BGRX8888; break;
+		default: break;
+		}
+	}
+	win->plane_alpha = 0xff;
+	win->protection = false;
+
+	win->src.x = state->src_x >> 16;
+	win->src.y = state->src_y >> 16;
+	win->src.w = state->src_w >> 16;
+	win->src.h = state->src_h >> 16;
+	/*
+	 * The DECON works in pixels: src.f_w is the line stride of the buffer.
+	 * For NV12/NV21 the vendor bpp is 12, i.e. bytes == luma pixels, which
+	 * makes pitch[0] the Y stride in pixels exactly like the fbdev driver
+	 * does (decon_core.c:1670-1678).
+	 */
+	if (fb->pitches[0] % (fmt->bpp / 8)) {
+		DRM_ERROR("[PLANE:%d] pitch %u is not a whole number of pixels\n",
+			  state->plane->base.id, fb->pitches[0]);
+		return -EINVAL;
+	}
+	win->src.f_w = fb->pitches[0] / (fmt->bpp / 8);
+	win->src.f_h = fb->height;
+
+	win->dst.x = state->crtc_x;
+	win->dst.y = state->crtc_y;
+	win->dst.w = state->crtc_w;
+	win->dst.h = state->crtc_h;
+	win->dst.f_w = win->src.f_w;
+	win->dst.f_h = win->src.f_h;
+
+	ret = exynos7580_check_rect(fmt, &win->src, &win->dst);
+	if (ret) {
+		DRM_ERROR("[PLANE:%d] invalid %ux%u+%d+%d -> %ux%u+%d+%d\n",
+			  state->plane->base.id, win->src.w, win->src.h,
+			  win->src.x, win->src.y, win->dst.w, win->dst.h,
+			  win->dst.x, win->dst.y);
+		return ret;
+	}
+
+	if (!with_addr)
+		return 0;
+
+	nplanes = drm_format_num_planes(fb->pixel_format);
+	if (nplanes > ARRAY_SIZE(win->addr))
+		nplanes = ARRAY_SIZE(win->addr);
+
+	for (i = 0; i < nplanes; i++) {
+		dma_addr_t addr;
+
+		ret = exynos7580_fb_scanout(fb, i, &addr);
+		if (ret) {
+			if (i == 0) {
+				DRM_ERROR("[PLANE:%d] no scanout address: %d\n",
+					  state->plane->base.id, ret);
+				return ret;
+			}
+			/*
+			 * Semi-planar NV12/NV21 exported as one dma-buf: leave
+			 * addr[1] zero, the shim derives it from the luma
+			 * stride like decon_calc_plane_offset() does
+			 * (decon_core.c:1411-1431).
+			 */
+			win->addr[i] = 0;
+			continue;
+		}
+		win->addr[i] = addr;
+	}
+
+	return 0;
+}
+
+/*
+ * Program exactly one frame once the whole changeset has been translated.
+ *
+ * The atomic helper calls ->atomic_update()/->atomic_disable() for every plane
+ * in the changeset in ascending plane index (drm_atomic_helper_commit_planes(),
+ * drm_atomic_helper.c:1128-1190) and the new states are already installed in
+ * plane->state (swap_state() ran before commit_planes).  The plane with the
+ * highest index in the changeset therefore commits the complete frame, which
+ * keeps the "exactly one decon_kms_commit() per atomic commit" rule.
+ */
+static bool exynos7580_have_frame;
+static struct drm_atomic_state *exynos7580_last_commit_state;
+static unsigned int exynos7580_last_commit_count;
+
+/* Keep one linear copy of the last complete frame (reallocated if the
+ * geometry ever changes). */
+static void exynos7580_shadow_prepare(struct exynos7580_device *ex,
+				      struct drm_framebuffer *fb)
+{
+	size_t size;
+
+	if (!fb || !fb->pitches[0] || !fb->height)
+		return;
+	size = (size_t)fb->pitches[0] * fb->height;
+	if (ex->shadow && ex->shadow_size >= size &&
+	    ex->shadow_pitch == fb->pitches[0])
+		return;
+	vfree(ex->shadow);
+	ex->shadow = vmalloc(size);
+	if (!ex->shadow) {
+		ex->shadow_size = 0;
+		ex->shadow_pitch = 0;
+		return;
+	}
+	ex->shadow_size = size;
+	ex->shadow_pitch = fb->pitches[0];
+	pr_info("exynos7580: shadow frame %zu bytes pitch %u\n", size,
+		fb->pitches[0]);
+}
+
+static int exynos7580_plane_commit_frame(struct exynos7580_device *ex,
+					 struct drm_plane *plane,
+					 struct drm_plane_state *old_state)
+{
+	struct drm_atomic_state *astate = old_state ? old_state->state : NULL;
+	struct drm_plane_state *pstate = plane->state;
+	struct decon_kms_win wins[EXYNOS7580_MAX_PLANES];
+	unsigned int i, nplanes = ex->num_planes;
+	int ret;
+
+	/*
+	 * The CRTC is going inactive: its disable path stops the DECON, so
+	 * programming a frame here would touch a stopped pipe.
+	 */
+	if (!pstate || !pstate->crtc || !pstate->crtc->state)
+		return 0;
+	if (!pstate->crtc->state->active)
+		return 0;
+
+	/*
+	 * A later plane of this changeset commits the frame.  A NULL atomic
+	 * state means the transitional plane ioctl path (a single-plane
+	 * update), which commits right away.
+	 */
+	if (astate) {
+		for (i = drm_plane_index(plane) + 1;
+		     i < plane->dev->mode_config.num_total_plane; i++)
+			if (astate->planes[i])
+				return 0;
+
+		/* int80: a state must commit exactly one frame. */
+		if (astate == exynos7580_last_commit_state) {
+			exynos7580_last_commit_count++;
+			pr_err("exynos7580_plane_commit_frame: state %p commits again (%u)\n",
+			       astate, exynos7580_last_commit_count);
+		} else {
+			exynos7580_last_commit_state = astate;
+			exynos7580_last_commit_count = 1;
+		}
+	}
+
+	if (nplanes == 0 || nplanes > EXYNOS7580_MAX_PLANES)
+		return -ENOSPC;
+
+	for (i = 0; i < nplanes; i++) {
+		ret = exynos7580_plane_state_to_win(ex, i, ex->planes[i].state,
+						    &wins[i], true);
+		if (ret) {
+			/*
+			 * Legitimate states were accepted by atomic_check();
+			 * a failure here is a driver bug, so blank that window
+			 * instead of programming garbage.
+			 */
+			DRM_ERROR("[PLANE:%d] commit translation failed: %d\n",
+				  ex->planes[i].base.id, ret);
+			memset(&wins[i], 0, sizeof(wins[i]));
+			wins[i].state = DECON_KMS_WIN_DISABLED;
+		}
+	}
+
+	/*
+	 * Never program a frame the GPU has not filled in.  A panfrost job
+	 * that faults or is still running leaves the imported buffer zeroed
+	 * or only cleared, and scanning that out is the blue/black flashing.
+	 * The decision must be made BEFORE decon_kms_commit(): once the
+	 * DECON registers are written the frame is on the panel.
+	 *
+	 * Skipping alone is not enough.  KWin receives the flip event at
+	 * commit time, so the buffer that is still on screen is already back
+	 * in its swapchain and can be rewritten - including by the next
+	 * failed, cleared render.  Keep a driver copy of the last complete
+	 * frame and put that copy into the buffer being programmed.
+	 */
+	{
+		struct drm_framebuffer *pfb =
+			ex->planes[0].state ? ex->planes[0].state->fb : NULL;
+
+		if (pfb) {
+			bool blank = exynos7580_fb_is_blank(pfb);
+
+			if (!blank && pfb->width >= 320 && pfb->height >= 480) {
+				/* Cache only a real scanout frame, never the
+				 * 32x32 cursor buffer KWin may put on the
+				 * primary plane first. */
+				exynos7580_shadow_prepare(ex, pfb);
+				if (ex->shadow)
+					exynos7580_fb_shadow_read(pfb, ex->shadow,
+								  ex->shadow_pitch);
+			} else if (blank && exynos7580_have_frame && ex->shadow &&
+				   pfb->height <= ex->shadow_size / ex->shadow_pitch &&
+				   exynos7580_fb_shadow_write(pfb, ex->shadow,
+							      ex->shadow_pitch,
+							      ex->shadow_size)) {
+				pr_info("exynos7580: blank frame replaced from shadow\n");
+				blank = false;
+			}
+			if (blank && exynos7580_have_frame) {
+				pr_info("exynos7580: blank frame, keeping previous\n");
+				return 1;
+			}
+		}
+	}
+
+	ret = decon_kms_commit(ex->decon, wins, nplanes);
+	if (ret == -ETIMEDOUT) {
+		/*
+		 * The first program can miss its vsync (the arm/update pair may
+		 * consume the completion).  Program the same windows again so the
+		 * shadow update gets a fresh frame to latch on.
+		 */
+		int retry = decon_kms_commit(ex->decon, wins, nplanes);
+		pr_info("exynos7580_plane_commit_frame: vsync retry rc=%d\n", retry);
+		if (retry == -ETIMEDOUT) {
+			/* Registers are programmed; keep the frame either way. */
+			DRM_DEBUG_KMS("DECON commit: vsync never latched, frame kept\n");
+			ret = 0;
+		} else {
+			ret = retry;
+		}
+	}
+	/*
+	 * Pin the buffers that are now being scanned out.  A skipped frame
+	 * keeps last_fb[] untouched, which is exactly what keeps the panel
+	 * image valid while the compositor recycles its own references.
+	 */
+	if (!ret) {
+		for (i = 0; i < nplanes; i++) {
+			struct drm_framebuffer *fb = ex->planes[i].state ?
+						    ex->planes[i].state->fb : NULL;
+
+			if (fb)
+				drm_framebuffer_reference(fb);
+			if (ex->last_fb[i])
+				drm_framebuffer_unreference(ex->last_fb[i]);
+			ex->last_fb[i] = fb;
+		}
+		if (ex->planes[0].state && ex->planes[0].state->fb)
+			exynos7580_have_frame = true;
+	}
+
+	if (exynos7580_dump_fb && ex->planes[0].state &&
+	    ex->planes[0].state->fb)
+		exynos7580_dump_scanout(ex->planes[0].state->fb);
+
+	if (ret)
+		DRM_ERROR("DECON commit failed: %d\n", ret);
+
+	return ret;
+}
+
+static int exynos7580_plane_atomic_check(struct drm_plane *plane,
+					 struct drm_plane_state *state)
+{
+	struct exynos7580_device *ex = to_exynos7580(plane->dev);
+	const struct decon_kms_caps *caps =
+		ex->decon ? decon_kms_caps(ex->decon) : NULL;
+	struct decon_kms_win win;
+	unsigned int idx = exynos7580_plane_index(ex, plane);
+
+	pr_info("exynos7580_plane_atomic_check: plane=%d idx=%u crtc=%p fb=%p fmt=0x%08x src=(0x%x,0x%x,0x%x,0x%x) dst=%ux%u%+d%+d pitch=%u max_win=%u\n",
+		plane->base.id, idx, state->crtc, state->fb,
+		state->fb ? state->fb->pixel_format : 0,
+		state->src_x, state->src_y, state->src_w, state->src_h,
+		state->crtc_w, state->crtc_h, state->crtc_x, state->crtc_y,
+		state->fb ? state->fb->pitches[0] : 0,
+		caps ? caps->max_win : 0);
+
+	if (!state->crtc && !state->fb)
+		return 0;
+	if (!state->crtc || !state->fb) {
+		pr_info("exynos7580_plane_atomic_check: FAIL plane=%d crtc/fb half-set crtc=%p fb=%p\n",
+			plane->base.id, state->crtc, state->fb);
+		return -EINVAL;
+	}
+
+	/*
+	 * Window shortage: the plane exists but the vendor instance has fewer
+	 * windows than the DT advertised.  -ENOSPC makes KWin drop the plane
+	 * when it tests the atomic commit.
+	 */
+	if (!caps || idx >= caps->max_win) {
+		pr_warn("exynos7580_plane_atomic_check: plane=%d idx=%u beyond max_win=%u -> -ENOSPC\n",
+			plane->base.id, idx, caps ? caps->max_win : 0);
+		return -ENOSPC;
+	}
+
+	{
+		int ret = exynos7580_plane_state_to_win(ex, idx, state, &win,
+							false);
+
+		pr_info("exynos7580_plane_atomic_check: plane=%d state_to_win rc=%d win=%ux%u%+d%+d\n",
+			plane->base.id, ret, win.dst.w, win.dst.h,
+			win.dst.x, win.dst.y);
+		return ret;
+	}
+}
+
+int exynos7580_plane_atomic_update(struct drm_plane *plane,
+				   struct drm_plane_state *state)
+{
+	struct exynos7580_device *ex = to_exynos7580(plane->dev);
+	unsigned int idx = exynos7580_plane_index(ex, plane);
+	struct decon_kms_win win;
+	int ret;
+
+	/* @state is the old plane state; the new one is in plane->state. */
+	ret = exynos7580_plane_state_to_win(ex, idx, plane->state, &win, true);
+	if (ret) {
+		/*
+		 * -ENODEV/-EINVAL from the address resolver is final for this
+		 * fb (KmsDmabuf's exynos7580_fb_scanout()), not transient.  We
+		 * are past the point of no return in the atomic commit, so
+		 * report it and still latch the rest of the frame; the
+		 * gatherer below blanks this window.
+		 */
+		DRM_ERROR("[PLANE:%d] cannot build window: %d\n",
+			  plane->base.id, ret);
+	}
+
+	return exynos7580_plane_commit_frame(ex, plane, state);
+}
+
+void exynos7580_plane_atomic_disable(struct drm_plane *plane,
+				     struct drm_plane_state *state)
+{
+	struct exynos7580_device *ex = to_exynos7580(plane->dev);
+
+	exynos7580_plane_commit_frame(ex, plane, state);
+}
+
+static void exynos7580_plane_atomic_update_cb(struct drm_plane *plane,
+					      struct drm_plane_state *old_state)
+{
+	int ret;
+
+	ret = exynos7580_plane_atomic_update(plane, old_state);
+	if (ret)
+		DRM_ERROR("[PLANE:%d] atomic update failed: %d\n",
+			  plane->base.id, ret);
+}
+
+static void exynos7580_plane_atomic_disable_cb(struct drm_plane *plane,
+					       struct drm_plane_state *old_state)
+{
+	exynos7580_plane_atomic_disable(plane, old_state);
+}
+
+static void exynos7580_plane_destroy(struct drm_plane *plane)
+{
+	drm_plane_cleanup(plane);
+}
+
+static const struct drm_plane_funcs exynos7580_plane_funcs = {
+	.update_plane		= drm_plane_helper_update,
+	.disable_plane		= drm_plane_helper_disable,
+	.destroy		= exynos7580_plane_destroy,
+	.reset			= drm_atomic_helper_plane_reset,
+	.atomic_duplicate_state	= drm_atomic_helper_plane_duplicate_state,
+	.atomic_destroy_state	= drm_atomic_helper_plane_destroy_state,
+};
+
+static const struct drm_plane_helper_funcs exynos7580_plane_helper_funcs = {
+	.atomic_check		= exynos7580_plane_atomic_check,
+	.atomic_update		= exynos7580_plane_atomic_update_cb,
+	.atomic_disable		= exynos7580_plane_atomic_disable_cb,
+};
+
+int exynos7580_planes_init(struct exynos7580_device *ex)
+{
+	const struct decon_kms_caps *caps =
+		ex->decon ? decon_kms_caps(ex->decon) : NULL;
+	unsigned int i, nplanes;
+	int ret;
+
+	/*
+	 * One window is the minimum (the primary plane).  More planes than the
+	 * vendor instance has windows are still registered: atomic_check()
+	 * rejects them with -ENOSPC, which is the documented TEST_ONLY
+	 * fallback that makes a compositor drop the overlay instead of
+	 * failing the whole commit.
+	 */
+	if (!caps || caps->max_win == 0) {
+		DRM_ERROR("DECON exposes no windows\n");
+		return -ENOSPC;
+	}
+
+	if (!ex->drm || !ex->dev)
+		return -EINVAL;
+
+	nplanes = EXYNOS7580_MAX_PLANES;
+	if (nplanes > ARRAY_SIZE(exynos7580_plane_idma))
+		nplanes = ARRAY_SIZE(exynos7580_plane_idma);
+
+	for (i = 0; i < nplanes; i++) {
+		const u32 *formats;
+		unsigned int count;
+		enum drm_plane_type type;
+
+		if (i == 0) {
+			type = DRM_PLANE_TYPE_PRIMARY;
+			formats = exynos7580_rgb_formats;
+			count = ARRAY_SIZE(exynos7580_rgb_formats);
+		} else {
+			type = DRM_PLANE_TYPE_OVERLAY;
+			/*
+			 * Only the last window is the VG channel; the ones in
+			 * between are G channels and take RGB only.
+			 */
+			if (i == 2) {
+				formats = exynos7580_vg_formats;
+				count = ARRAY_SIZE(exynos7580_vg_formats);
+			} else {
+				formats = exynos7580_rgb_formats;
+				count = ARRAY_SIZE(exynos7580_rgb_formats);
+			}
+		}
+
+		ret = drm_universal_plane_init(ex->drm, &ex->planes[i], BIT(0),
+					       &exynos7580_plane_funcs,
+					       formats, count, type);
+		if (ret) {
+			DRM_ERROR("failed to init plane %u: %d\n", i, ret);
+			return ret;
+		}
+
+		drm_plane_helper_add(&ex->planes[i],
+				     &exynos7580_plane_helper_funcs);
+	}
+
+	ex->num_planes = nplanes;
+
+	return 0;
+}
diff -u -Naur a/drivers/gpu/drm/panfrost/Kconfig b/drivers/gpu/drm/panfrost/Kconfig
--- a/drivers/gpu/drm/panfrost/Kconfig
+++ b/drivers/gpu/drm/panfrost/Kconfig
@@ -0,0 +1,12 @@
+# Mali-T720 render-only DRM driver for Exynos 7580 (j7elte).
+config DRM_PANFROST7580
+	tristate "Panfrost-7580 render-only DRM (Mali-T720, no modeset)"
+	depends on DRM && ARM64 && MMU
+	select DRM_GEM_CMA_HELPER if DRM
+	default n
+	help
+	  Render-minor-only DRM driver for the Exynos 7580 Mali-T720.
+	  Binds mali@0x11400000 (arm,mali) and exposes renderD128 with
+	  six v5.2 ioctls (SUBMIT/WAIT_BO/CREATE_BO/MMAP_BO/GET_PARAM/
+	  GET_BO_OFFSET). No modeset, no display takeover; vendor
+	  DECON fbdev keeps the panel.
