+
+int p7580_drv_sched_ensure(void)
+{
+	int ret = 0;
+
+	mutex_lock(&p7580_drv_sched_lock);
+	if (!p7580_drv_sched_live) {
+		ret = drm_sched_init(&p7580_drv_sched,
+				     &p7580_drv_sched_ops,
+				     msecs_to_jiffies(p7580_drv_job_timeout_ms),
+				     "panfrost7580");
+		if (!ret)
+			p7580_drv_sched_live = 1;
+	}
+	mutex_unlock(&p7580_drv_sched_lock);
+	return ret;
+}
+
+/* gpu31-watchdog: job_timeout_ms get/set (jobs slice debugfs hook).
+ * The value is the drm_sched dispatch budget: it is copied into
+ * entity->timeout at entity_init (per open), so a write takes effect
+ * for the next client; the live sched->timeout is updated too. Clamp
+ * to 100..60000 ms (below the poll granularity this part can resolve,
+ * above the 5 s the port shipped with). */
+unsigned int p7580_drv_get_job_timeout_ms(void *priv)
+{
+	(void)priv;
+	return p7580_drv_job_timeout_ms;
+}
+
+int p7580_drv_set_job_timeout_ms(void *priv, unsigned int ms)
+{
+	(void)priv;
+	if (ms < 100u || ms > 60000u)
+		return -EINVAL;
+	mutex_lock(&p7580_drv_sched_lock);
+	p7580_drv_job_timeout_ms = ms;
+	if (p7580_drv_sched_live)
+		p7580_drv_sched.timeout = msecs_to_jiffies(ms);
+	mutex_unlock(&p7580_drv_sched_lock);
+	pr_info("p7580_sched: job_timeout_ms=%u (new entities)\n", ms);
+	return 0;
+}
+
+/* Per-file entities on the shared scheduler workqueue. */
+struct p7580_shadow_pin {
+	struct list_head node;
+	struct drm_gem_object *obj;
+};
+
+int p7580_drv_file_init(struct p7580_drv_file *df, struct p7580_drv *drv)
+{
+	int i, ret;
+
+	if (!df || !drv)
+		return -EINVAL;
+	/* R1: the shared sched workqueue does not exist until the first
+	 * ensure. drm_sched_entity_init takes sched->lock, so running it
+	 * against a never-initialised (zeroed) sched wedges the opener.
+	 * Ensure here so open stays O(1) with no waits on the fast path
+	 * (ensure only inits once; later opens hit the live flag). */
+	ret = p7580_drv_sched_ensure();
+	if (ret)
+		return ret;
+	df->drv = drv;
+	df->next_seqno = 0;
+	df->entities_live = 0;
+	INIT_LIST_HEAD(&df->shadow_pins);
+	df->shadow_pin_count = 0;
+	mutex_init(&df->serial_lock);
+	df->serial_prev = NULL;
+	drm_syncobj_manager_init(&df->mgr);
+	df->job_fctx = NULL;
+	df->job_dev = &drv->jd;
+	for (i = 0; i < P7580_NUM_JOB_SLOTS; i++) {
+		ret = drm_sched_entity_init(&df->entity[i],
+					    &p7580_drv_sched);
+		if (ret) {
+			while (--i >= 0)
+				drm_sched_entity_fini(&p7580_drv_sched,
+						      &df->entity[i]);
+			drm_syncobj_manager_fini(&df->mgr);
+			return ret;
+		}
+	}
+	df->entities_live = 1;
+	return 0;
+}
+
+void p7580_drv_file_fini(struct p7580_drv_file *df)
+{
+	struct p7580_drv *drv;
+	int pm_held = 0;
+	int i;
+
+	if (!df)
+		return;
+	drv = df->drv;
+	/* Teardown can run while runtime-suspended (close after idle):
+	 * entity fini retires queued jobs whose free_job drops the
+	 * live-job PM ref, and the 0004 fini/flush path runs the
+	 * retirement workqueue. Hold one PM ref across the walk so a
+	 * concurrent run_job/timeout worker (still covered by its own
+	 * re-get) and the fini flush both see a powered block. The
+	 * free_job puts below are per-job refs, NOT this hold: this
+	 * hold is released once, after the last entity is torn down.
+	 * On get failure the block is already dark: MMIO inside fini
+	 * (there is none directly) is skipped by the workers'
+	 * fail-closed arms, and the CPU-side list flush below still
+	 * runs so no job/fence leaks. */
+	/* Bounded close (gpu31-close-fix): the hold below is a single
+	 * pm_runtime_get_sync. Its only unbounded phase is waiting out a
+	 * concurrent suspend/resume transition, which is itself bounded
+	 * (runtime_suspend/resume callbacks poll READY with 100 us steps
+	 * and 100 ms caps; no step sleeps unbounded). The entity loop
+	 * then cancels queued jobs synchronously and waits BOUNDED for
+	 * dispatched jobs (0004 wait_idle: one timeout + 8 s margin),
+	 * whose retirement is unconditional (timedout_job always signals
+	 * the fence, even dark). Syncobj fini last: it drops manager refs
+	 * without waiting on any fence, so no waiter can be wedged by
+	 * teardown order. Double fini is safe (entities_live guards the
+	 * loop, manager drain of an empty idr is a no-op). */
+	if (drv && p7580_drv_teardown_hold(drv))
+		pm_held = 1;
+	if (df->entities_live) {
+		for (i = 0; i < P7580_NUM_JOB_SLOTS; i++)
+			drm_sched_entity_fini(&p7580_drv_sched,
+					      &df->entity[i]);
+		df->entities_live = 0;
+	}
+	/* gpu31-shadowpin: all queued jobs are drained above, so nothing
+	 * can still read a shadow chain; drop the lifetime pins. */
+	{
+		struct p7580_shadow_pin *pin, *tmp;
+		unsigned int n = 0;
+
+		list_for_each_entry_safe(pin, tmp, &df->shadow_pins, node) {
+			list_del(&pin->node);
+			drm_gem_object_unreference_unlocked(pin->obj);
+			kfree(pin);
+			n++;
+		}
+		df->shadow_pin_count = 0;
+		if (n)
+			pr_info("p7580 shadow unpin n=%u\n", n);
+	}
+	/* Drop the serial-chain reference (if any): no new dispatch can
+	 * attach it after the entities above drained, and the job that
+	 * armed it still owns its own ref via out_sync/retire. */
+	mutex_lock(&df->serial_lock);
+	if (df->serial_prev) {
+		dma_fence_put(df->serial_prev);
+		df->serial_prev = NULL;
+	}
+	mutex_unlock(&df->serial_lock);
+	drm_syncobj_manager_fini(&df->mgr);
+	if (pm_held)
+		p7580_drv_teardown_release(drv);
+	df->drv = NULL;
+	df->job_dev = NULL;
+}
+
+/* gpu31-firstfault: dump one 4 KiB GPU page (all 16 256-byte job
+ * slots) of the memory a job descriptor, framebuffer descriptor or
+ * tiler-heap header lives in. Registered on the jobs slice as the
+ * first-fault dumper (process context only: it resolves the IOVA to a
+ * BO, takes a ref and kmaps; the caller is the sched timeout work).
+ * The read is clean-then-invalidate (p7580_drv_gpu_read), so the dump
+ * shows what the GPU sees, not a stale CPU line. */
+#define P7580_PAGE_DUMP_LEN	4096u
+
+/* Defined below with the chain-split helpers. */
+static int p7580_drv_gpu_read(struct p7580_drv *drv, uint64_t gpu,
+			      void *dst, size_t len);
+
+int p7580_drv_desc_dump(void *priv, uint64_t gpu, const char *tag)
+{
+	struct p7580_drv *drv = priv;
+	uint32_t *buf;
+	uint64_t base;
+	unsigned int i;
+	int ret;
+
+	if (!drv || !tag)
+		return -EINVAL;
+	base = gpu & ~(uint64_t)(P7580_PAGE_DUMP_LEN - 1u);
+	buf = kmalloc(P7580_PAGE_DUMP_LEN, GFP_KERNEL);
+	if (!buf)
+		return -ENOMEM;
+	ret = p7580_drv_gpu_read(drv, base, buf, P7580_PAGE_DUMP_LEN);
+	if (ret) {
+		pr_err("p7580_job: PAGEDUMP %s gpu=0x%llx rc=%d (unmapped)\n",
+		       tag, (unsigned long long)gpu, ret);
+		kfree(buf);
+		return ret;
+	}
+	pr_err("p7580_job: PAGEDUMP %s gpu=0x%llx page=0x%llx off=0x%llx\n",
+	       tag, (unsigned long long)gpu, (unsigned long long)base,
+	       (unsigned long long)(gpu - base));
+	/* One line per 16 words (64 bytes): 64 lines cover the whole
+	 * 4 KiB page. The first form printed only the first 64 bytes of
+	 * every 256-byte job slot, i.e. 1 KiB with wrong offsets, which
+	 * skipped exactly the interesting bytes on int42: the fragment
+	 * SFBD tiler section at page+0x540 and the SFBD-adjacent
+	 * descriptor at +0x5c0. slot is the 256-byte job slot the line
+	 * starts in, off the page offset. */
+	for (i = 0; i < P7580_PAGE_DUMP_LEN / 4u / 16u; i++) {
+		const uint32_t *q = buf + i * 16u;
+
+		pr_err("p7580_job: PAGE %s slot%02u off=%03x %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x\n",
+		       tag, (unsigned int)(i / 4u), (unsigned int)(i * 64u),
+		       q[0], q[1], q[2], q[3], q[4], q[5], q[6], q[7],
+		       q[8], q[9], q[10], q[11], q[12], q[13], q[14], q[15]);
+	}
+	kfree(buf);
+	return 0;
+}
+
+/* gpu31-iova: IRQ-safe fault-time mapping resolver (registered on
+ * struct p7580_job_dev at probe). Renders the faulting job's SUBMIT-
+ * time {handle,iova,size} snapshot as "h<H>=0x<IOVA>/0x<SZ> ..." into
+ * buf (or counts when buf is NULL, snprintf-style). IRQ context: only
+ * the snapshot arrays + snprintf, no GEM dereference, no locks, no
+ * MMIO. Truncates at the buffer end (always NUL-terminated); returns
+ * the full untruncated length so the caller can size its buffer. */
+int p7580_drv_iova_resolve(void *priv, char *buf, size_t len,
+				  const uint32_t *handles,
+				  const uint64_t *addrs,
+				  const uint32_t *sizes, uint32_t n)
+{
+	(void)priv;
+	if (!handles || !addrs || !sizes || !n)
+		return 0;
+	{
+		size_t off = 0;
+		uint32_t i;
+		int w;
+
+		for (i = 0; i < n; i++) {
+			if (!buf || off >= len)
+				w = snprintf(NULL, 0, "%s%u=0x%llx/0x%x",
+					       i ? " " : "h",
+					       handles[i],
+					       (unsigned long long)addrs[i],
+					       sizes[i]);
+			else
+				w = snprintf(buf + off, len - off,
+					     "%s%u=0x%llx/0x%x",
+					     i ? " " : "h",
+					     handles[i],
+					     (unsigned long long)addrs[i],
+					     sizes[i]);
+			if (w < 0)
+				return (int)off;
+			off += (size_t)w;
+			if (buf && off >= len) {
+				buf[len - 1] = '\0';
+				break;
+			}
+		}
+		return (int)off;
+	}
+}
+
+/* Map one BO's pages into AS 0 if not yet bound; track on bo_list.
+ * Caller (p7580_drv_submit) holds a runtime-PM ref: the invalidate()
+ * below is MMIO on the AS block and MUST NOT run while the power
+ * domain/clocks are dark (F-SUB1 bus-hang). */
+static int p7580_drv_map_bo(struct p7580_drv *drv, struct drm_gem_object *obj)
+{
+	struct p7580_bo *bo = to_p7580_bo(obj);
+	unsigned int npages = p7580_bo_npages(obj);
+	unsigned int i;
+	int ret = 0;
+
+	mutex_lock(&drv->bo_lock);
+	{
+		struct p7580_drv_bo *e;
+
+		list_for_each_entry(e, &drv->bo_list, node) {
+			if (e->obj == obj) {
+				mutex_unlock(&drv->bo_lock);
+				return 0;
+			}
+			/* gpu31-iova: live-overlap detector. Two distinct
+			 * live BOs must never cover the same IOVA: that
+			 * means an IOVA was recycled while still mapped
+			 * (the stale-TLB signature). Always-on WARN. */
+			if (bo->iova < e->iova + e->size &&
+			    e->iova < bo->iova + bo->base.size)
+				pr_warn("p7580_iova: OVERLAP obj=%lu iova=0x%llx size=0x%zx vs obj=%lu iova=0x%llx size=0x%zx\n",
+					(unsigned long)obj,
+					(unsigned long long)bo->iova,
+					bo->base.size,
+					(unsigned long)e->obj,
+					(unsigned long long)e->iova,
+					e->size);
+		}
+	}
+	mutex_unlock(&drv->bo_lock);
+
+	/* gpu31-coherency: bind-time dma_map before the AS0 walk so PTEs
+	 * carry bus addresses (p7580_bo_page_phys routes SHMEM through
+	 * the dma_addrs cache) and completion sync has a mapping. */
+	{
+		int bret = p7580_gem_dma_bind(obj, drv->dev);
+
+		if (bret)
+			return bret;
+	}
+
+	/* gpu31-iova: IOVA-reuse fence. A recycled range can only reach
+	 * here after p7580_gem_gpu_unmap cleared its leaves on free;
+	 * still, invalidate the range BEFORE writing new leaves so any
+	 * TLB entry surviving a dark free (flush skipped, resume pending)
+	 * or a racing PTW is purged first. Barrier order: invalidate
+	 * (purge old) -> map (write new) -> invalidate (publish new),
+	 * matching the kbase LOCK/FLUSH/UPDATE discipline. */
+	p7580_mmu_invalidate(drv->regs, P7580_DRV_AS_NR,
+			     bo->iova >> PAGE_SHIFT, npages, 1);
+	for (i = 0; i < npages; i++) {
+		int ok = 0;
+		phys_addr_t phys = p7580_bo_page_phys(obj, i, &ok);
+
+		if (!ok) {
+			ret = -EFAULT;
+			goto rollback;
+		}
+		ret = p7580_mmu_map(&drv->mmu, bo->iova +
+				    ((u64)i << PAGE_SHIFT),
+				    phys, P7580_PROT_RD | P7580_PROT_WR,
+				    P7580_MEMATTR_IDX_DEFAULT);
+		if (ret)
+			goto rollback;
+	}
+	p7580_mmu_invalidate(drv->regs, P7580_DRV_AS_NR,
+			     bo->iova >> PAGE_SHIFT, npages, 0);
+
+	{
+		struct p7580_drv_bo *e = kzalloc(sizeof(*e), GFP_KERNEL);
+
+		if (!e) {
+			ret = -ENOMEM;
+			goto rollback;
+		}
+		mutex_lock(&drv->bo_lock);
+		/* gpu31-boleak: NON-OWNING entry -- deliberately no
+		 * drm_gem_object_reference() here. The only unlink of
+		 * this entry lives in p7580_gem_gpu_unmap(), which runs
+		 * from p7580_gem_free_object() i.e. only once the
+		 * refcount is zero; a reference owned by the entry would
+		 * therefore never be dropped and every submitted BO
+		 * (pages + shmem inode + IOVA) would leak forever.
+		 * The object is guaranteed live here: the caller holds a
+		 * handle-lookup reference (SUBMIT) or the shadow's own
+		 * per-node refs. */
+		e->obj = obj;
+		e->iova = bo->iova;
+		e->size = bo->base.size;
+		list_add_tail(&e->node, &drv->bo_list);
+		mutex_unlock(&drv->bo_lock);
+	}
+	/* gpu31-iova trace: one line per fresh map (already-bound BOs
+	 * return early above and print nothing). Own budget so the
+	 * 8-line job budget is never starved. */
+	if (p7580_iova_trace) {
+		p7580_iova_trace--;
+		pr_info("p7580_iova: map obj=%lu iova=0x%llx size=0x%zx npages=%u\n",
+			(unsigned long)obj, (unsigned long long)bo->iova,
+			bo->base.size, npages);
+	}
+	return 0;
+
+rollback:
+	/* gpu31-boleak: this bind failed after programming leaves, and no
+	 * bo_list entry exists for the object yet -- so nothing would ever
+	 * unmap them (the free-time unmap keys on the entry). Clear what
+	 * this call programmed and publish the clear, keeping "leaves
+	 * programmed" exactly equivalent to "entry linked"; otherwise a
+	 * freed BO could leave PTEs naming recycled pages. i is the index
+	 * that failed (not yet mapped), or npages when only the entry
+	 * allocation failed. */
+	{
+		unsigned int k = i;
+
+		while (k--)
+			p7580_mmu_unmap(&drv->mmu, bo->iova +
+					((u64)k << PAGE_SHIFT));
+	}
+	p7580_mmu_invalidate(drv->regs, P7580_DRV_AS_NR,
+			     bo->iova >> PAGE_SHIFT, npages, 0);
+	return ret;
+}
+
+/* ------------------------------------------------------------------ */
+/* gpu31-chainsplit: chain walk, shadow descriptors, per-node queue.  */
+/*                                                                    */
+/* The UAPI hands the driver one jc = chain head. A chained dispatch   */
+/* runs to the last next pointer before the slot reports DONE, so the  */
+/* chain's END_FLUSH_CLEAN_INV happens once, after the tiler; the      */
+/* vertex -> tiler handoff is then not visible (gpu31-chainexec). The  */
+/* driver splits the chain: every node is queued as its own sched job  */
+/* on the SAME slot entity, so each START carries the standard         */
+/* p7580_js_config() (START/END_FLUSH_CLEAN_INV) and the nodes are     */
+/* ordered by a drm_sched dependency on the previous node's armed      */
+/* fence. One submitted chain therefore becomes N sched jobs and one   */
+/* out_sync fence: the LAST node's fence covers the whole split.       */
+/*                                                                    */
+/* Each node is dispatched from a driver-owned shadow copy with        */
+/*   - next_job = NULL  (the JM must stop after this node),            */
+/*   - dep1/dep2 = 0    (ordering is enforced by drm_sched now; the    */
+/*                       original indices name nodes that are not in   */
+/*                       this dispatch),                               */
+/*   - index = position + 1 (well-formed standalone chain).            */
+/* The 32-byte header plus the inline payload is copied; every payload */
+/* field is an absolute GPU address, so the copy is relocatable.       */
+/* ------------------------------------------------------------------ */
+
+/* One shadow BO per submitted chain; every split job holds one object */
+/* reference and the last release unmaps it. iova is the GPU base. */
+struct p7580_chain_shadow {
+	struct drm_gem_object *obj;
+	uint64_t iova;
+	atomic_t refs;
+};
+
+/* Locate the live BO covering [gpu, gpu+len) and take a reference.
+ * The bo_list entry is weak (gpu31-boleak), so the reference is taken
+ * with kref_get_unless_zero(): an entry whose object is already in
+ * p7580_gem_free_object() is skipped rather than resurrected. The
+ * caller's own submitted BOs are still referenced (job lookup refs),
+ * so the lookup for a live descriptor always succeeds. */
+static int p7580_drv_gpu_span(struct p7580_drv *drv, uint64_t gpu,
+			      size_t len, struct drm_gem_object **out,
+			      uint64_t *base)
+{
+	struct p7580_drv_bo *e;
+	int found = 0;
+
+	if (!drv || !out || !base || !len)
+		return -EINVAL;
+	mutex_lock(&drv->bo_lock);
+	list_for_each_entry(e, &drv->bo_list, node) {
+		if (e->size < len || gpu < e->iova)
+			continue;
+		if (gpu - e->iova > e->size - len)
+			continue;
+		if (!p7580_drv_gem_try_get(e->obj))
+			continue;
+		*out = e->obj;
+		*base = e->iova;
+		found = 1;
+		break;
+	}
+	mutex_unlock(&drv->bo_lock);
+	return found ? 0 : -ENOENT;
+}
+
+/* Read len bytes of (already bound) GPU memory at gpu into dst. The   */
+/* read is clean-then-invalidate like the descriptor snapshot: the CPU */
+/* must not observe a stale line the GPU has already overwritten.      */
+static int p7580_drv_gpu_read(struct p7580_drv *drv, uint64_t gpu,
+			      void *dst, size_t len)
+{
+	struct drm_gem_object *obj;
+	struct p7580_bo *bo;
+	uint64_t base = 0;
+	size_t done = 0;
+	int ret;
+
+	ret = p7580_drv_gpu_span(drv, gpu, len, &obj, &base);
+	if (ret)
+		return ret;
+	bo = to_p7580_bo(obj);
+	p7580_gem_invalidate_for_cpu(obj);
+	while (done < len) {
+		uint64_t a = gpu + done;
+		unsigned int idx = (unsigned int)((a - base) >> PAGE_SHIFT);
+		unsigned int off = (unsigned int)(a & (PAGE_SIZE - 1));
+		size_t n = len - done;
+		void *kv;
+
+		if (n > PAGE_SIZE - off)
+			n = PAGE_SIZE - off;
+		if (idx >= bo->nr_pages || !bo->pages[idx]) {
+			ret = -EFAULT;
+			break;
+		}
+		kv = kmap_atomic(bo->pages[idx]);
+		memcpy((char *)dst + done, (char *)kv + off, n);
+		kunmap_atomic(kv);
+		done += n;
+	}
+	drm_gem_object_unreference_unlocked(obj);
+	return ret;
+}
+
+/* Write len bytes into the freshly created shadow BO (SHMEM pages).   */
+static int p7580_drv_shadow_write(struct drm_gem_object *obj, size_t off,
+				  const void *src, size_t len)
+{
+	struct p7580_bo *bo = to_p7580_bo(obj);
+	size_t done = 0;
+
+	while (done < len) {
+		size_t a = off + done;
+		unsigned int idx = (unsigned int)(a >> PAGE_SHIFT);
+		unsigned int poff = (unsigned int)(a & (PAGE_SIZE - 1));
+		size_t n = len - done;
+		void *kv;
+
+		if (n > PAGE_SIZE - poff)
+			n = PAGE_SIZE - poff;
+		if (idx >= bo->nr_pages || !bo->pages[idx])
+			return -EFAULT;
+		kv = kmap_atomic(bo->pages[idx]);
+		memcpy((char *)kv + poff, (const char *)src + done, n);
+		kunmap_atomic(kv);
+		done += n;
+	}
+	return 0;
+}
+
+/* Allocate + map the shadow BO holding `nodes` slots. The returned    */
+/* object carries exactly `nodes` references (one per split job); the  */
+/* create-time reference is job 0's, the rest are taken here.          */
+static struct p7580_chain_shadow *p7580_drv_shadow_create(
+		struct p7580_drv *drv, struct drm_device *dev,
+		struct p7580_drv_file *df, unsigned int nodes)
+{
+	struct p7580_chain_shadow *sh;
+	struct drm_gem_object *obj = NULL;
+	size_t size;
+	unsigned int i;
+	int ret;
+
+	if (!nodes || nodes > P7580_CHAIN_MAX_JOBS)
+		return ERR_PTR(-EINVAL);
+	size = (size_t)nodes * P7580_CHAIN_SLOT_STRIDE;
+	sh = kzalloc(sizeof(*sh), GFP_KERNEL);
+	if (!sh)
+		return ERR_PTR(-ENOMEM);
+	ret = p7580_gem_create(&drv->gd, dev, size, P7580_BO_SHMEM, 0,
+			       &obj);
+	if (ret) {
+		kfree(sh);
+		return ERR_PTR(ret);
+	}
+	for (i = 1; i < nodes; i++)
+		drm_gem_object_reference(obj);
+	sh->obj = obj;
+	sh->iova = to_p7580_bo(obj)->iova;
+	atomic_set(&sh->refs, nodes);
+	ret = p7580_drv_map_bo(drv, obj);
+	if (ret) {
+		for (i = 0; i < nodes; i++)
+			drm_gem_object_unreference_unlocked(obj);
+		kfree(sh);
+		return ERR_PTR(ret);
+	}
+	if (df) {
+		struct p7580_shadow_pin *pin = kzalloc(sizeof(*pin), GFP_KERNEL);
+
+		if (pin) {
+			drm_gem_object_reference(obj);
+			pin->obj = obj;
+			list_add_tail(&pin->node, &df->shadow_pins);
+			df->shadow_pin_count++;
+			pr_info("p7580 shadow pin obj=%p iova=0x%llx refs=%d\n",
+				obj, (unsigned long long)sh->iova,
+				atomic_read(&sh->refs));
+		}
+	}
+	return sh;
+}
+
+/* Drop one split job's reference; the last one unmaps the shadow BO   */
+/* before dropping its final object reference (gpu_unmap unlinks the   */
+/* bo_list entry and invalidates the TLB range).                      */
+static void p7580_drv_shadow_put(struct p7580_chain_shadow *sh)
+{
+	int last;
+
+	if (!sh)
+		return;
+	last = atomic_dec_and_test(&sh->refs);
+	/* Do NOT unmap here.  The shadow BO lives outside the file's idr, so
+	 * map_file_bos cannot re-establish its leaves; unmapping it when the
+	 * last queued node is freed leaves the GPU following a stale chain
+	 * pointer.  The mapping is torn down by p7580_gem_free_object() when
+	 * the GEM object itself dies. */
+	drm_gem_object_unreference_unlocked(sh->obj);
+	if (last)
+		kfree(sh);
+}
+
+/* Shared context for the per-node build/queue helper. */
+struct p7580_split_ctx {
+	struct p7580_drv *drv;
+	struct drm_device *dev;
+	struct p7580_drv_file *df;
+	struct drm_sched_entity *entity;
+	int slot;
+	uint32_t requirements;
+	uint32_t out_sync;
+	struct drm_gem_object **objs;
+	uint32_t *hsave;
+	unsigned int nr;
+	struct dma_fence **inf;
+	unsigned int nf;
+	struct p7580_chain_shadow *shadow;
+	unsigned int nodes;
+	/* gpu31-firstfault: the live (Mesa) chain-node addresses the
+	 * shadows were copied from, so the fault-time page dump can show
+	 * both pages. NULL when no shadow was allocated (the dispatched
+	 * jc is the original). */
+	const uint64_t *src;
+	/* gpu31-storm58: per-node SFBD address (descriptor word 10,
+	 * fragment nodes only; 0 elsewhere) and the per-BO age of each
+	 * entry in objs[] (SUBMITs since this file last used that BO). */
+	const uint32_t *fbd;
+	const uint32_t *age;
+};
+
+/* gpu31-storm58: BO-age ledger (diagnostic). Returns how many SUBMITs
+ * this file made since it last referenced the page at `iova`, then
+ * records `seq` as the newest user. Direct-mapped and bounded; a
+ * collision restarts the age instead of chaining. */
+static uint32_t p7580_drv_bo_age_touch(struct p7580_drv_file *df,
+				       uint64_t iova, uint32_t seq)
+{
+	unsigned int s = (unsigned int)((iova >> 12) &
+					(P7580_BO_AGE_SLOTS - 1u));
+	uint32_t age = 0;
+
+	if (df->bo_age[s].iova == iova && df->bo_age[s].seq)
+		age = seq - df->bo_age[s].seq;
+	df->bo_age[s].iova = iova;
+	df->bo_age[s].seq = seq;
+	return age;
+}
+
+/* Build one sched job for chain node `pos` and queue it on the slot    */
+/* entity. prev is the fence this node must wait for (pos 0: the serial */
+/* predecessor; pos > 0: the previous split node's armed fence).        */
+/* External in-fences and BO exclusion fences attach to node 0 only:    */
+/* the split's own chain orders everything after it.                    */
+/* On success *fence_out holds one caller reference to the armed fence  */
+/* (may be NULL if arm failed closed). On failure nothing is queued and */
+/* every reference taken by this helper is dropped.                     */
+static int p7580_drv_split_queue(struct p7580_split_ctx *s,
+				 unsigned int pos, uint64_t jc,
+				 const uint32_t hdr[8],
+				 struct dma_fence *prev,
+				 struct dma_fence **fence_out)
+{
+	struct p7580_submit_job *job;
+	struct drm_sched_job *sched_job = NULL;
+	struct dma_fence *fence_ref = NULL;
+	unsigned int i;
+	int ret;
+
+	*fence_out = NULL;
+	job = kzalloc(sizeof(*job), GFP_KERNEL);
+	if (!job)
+		return -ENOMEM;
+	job->seqno = s->df->next_seqno++;
+	job->slot = s->slot;
+	job->file_priv = s->df;
+	job->drv_priv = s->drv;
+	job->jc = jc;
+	job->src_jc = (s->src && s->shadow) ? s->src[pos] : 0;
+	job->requirements = s->requirements;
+	job->as_nr = P7580_DRV_AS_NR;
+	job->affinity = s->drv->jd.shader_present;
+	job->chain_shadow = s->shadow;
+	job->chain_pos = pos;
+	job->chain_len = s->nodes;
+	memcpy(job->desc, hdr, sizeof(job->desc));
+	if (pos + 1 == s->nodes)
+		job->out_sync = s->out_sync;
+	/* gpu31-storm58: what the one-shot fault dump needs, captured
+	 * at SUBMIT. fbd is the SFBD pointer the chain walker read from
+	 * this node's live descriptor word 10 (fragment nodes only).
+	 * jc_age is this file's SUBMIT age of the BO holding jc: 1 means
+	 * the previous SUBMIT rewrote that page, 2 the previous frame's
+	 * FS submit -- the "was the descriptor page just recycled"
+	 * number. */
+	job->fbd = s->fbd ? s->fbd[pos] : 0;
+	for (i = 0; i < s->nr; i++) {
+		struct p7580_bo *b = to_p7580_bo(s->objs[i]);
+
+		if (jc >= b->iova && jc - b->iova < b->base.size) {
+			job->jc_age = s->age ? s->age[i] : 0;
+			break;
+		}
+	}
+
+	/* Per-job BO references (gpu31-chainsplit): every split node owns
+	 * its own set, so free_job retires each node's sync + refs in
+	 * retire order and no job depends on another's lifetime. The
+	 * caller's lookup references stay in objs[] until the whole
+	 * split has been queued. */
+	if (s->nr) {
+		job->bos = kcalloc(s->nr, sizeof(*job->bos), GFP_KERNEL);
+		job->iova_handles = kcalloc(s->nr,
+					    sizeof(*job->iova_handles),
+					    GFP_KERNEL);
+		job->iova_addrs = kcalloc(s->nr,
+					  sizeof(*job->iova_addrs),
+					  GFP_KERNEL);
+		job->iova_sizes = kcalloc(s->nr,
+					  sizeof(*job->iova_sizes),
+					  GFP_KERNEL);
+		if (!job->bos || !job->iova_handles || !job->iova_addrs ||
+		    !job->iova_sizes) {
+			ret = -ENOMEM;
+			goto err_job;
+		}
+		for (i = 0; i < s->nr; i++) {
+			struct p7580_bo *sbo = to_p7580_bo(s->objs[i]);
+
+			drm_gem_object_reference(s->objs[i]);
+			job->bos[i] = s->objs[i];
+			job->iova_handles[i] = s->hsave[i];
+			job->iova_addrs[i] = sbo->iova;
+			job->iova_sizes[i] = (uint32_t)sbo->base.size;
+		}
+		job->bo_count = s->nr;
+		job->iova_bo_count = s->nr;
+	}
+
+	sched_job = drm_sched_job_alloc(s->entity, &p7580_drv_sched_ops,
+					job);
+	if (!sched_job) {
+		ret = -ENOMEM;
+		goto err_job;
+	}
+	if (!s->entity || sched_job->entity != s->entity ||
+	    sched_job->ops != &p7580_drv_sched_ops ||
+	    !sched_job->ops->run_job || !sched_job->ops->alloc_fence) {
+		ret = -EFAULT;
+		goto err_sched;
+	}
+	sched_job->slot = s->slot;
+	/* Fault-latency kick target (gpu31-latency): the IRQ fault leg
+	 * needs the owning sched job to re-arm its timeout work at delay
+	 * 0. Stored only after the ops/entity validation above so the
+	 * IRQ never dereferences a half-initialized pairing. */
+	job->sched_job = sched_job;
+	drm_sched_job_arm(sched_job);
+	if (sched_job->fence) {
+		fence_ref = sched_job->fence;
+		dma_fence_get(fence_ref);
+	}
+
+	/* Ordering: this node waits for the previous fence. For pos 0
+	 * that is the per-file serial predecessor; for every later node
+	 * it is the node queued immediately before it, which is what
+	 * gives the split its strict WRITE_VALUE -> VERTEX -> TILER
+	 * order across separate dispatches. */
+	if (prev && prev != sched_job->fence &&
+	    !dma_fence_is_signaled(prev)) {
+		ret = drm_sched_job_add_dependency(sched_job, prev);
+		if (ret)
+			goto err_sched;
+	}
+	if (pos == 0) {
+		for (i = 0; i < s->nf; i++) {
+			if (dma_fence_is_signaled(s->inf[i]))
+				continue;
+			ret = drm_sched_job_add_dependency(sched_job,
+							   s->inf[i]);
+			if (ret)
+				goto err_sched;
+		}
+		for (i = 0; i < s->nr; i++) {
+			struct p7580_bo *bo = to_p7580_bo(s->objs[i]);
+			struct dma_fence *f = dma_resv_get_excl(&bo->resv);
+
+			if (f) {
+				if (!dma_fence_is_signaled(f))
+					ret = drm_sched_job_add_dependency(
+						sched_job, f);
+				dma_fence_put(f);
+				if (ret)
+					goto err_sched;
+			}
+		}
+	}
+
+	/* Per-job runtime-PM lifetime: armed before the job becomes
+	 * visible to the async worker, released in free_job. */
+	p7580_drv_job_pm_arm(s->drv);
+	ret = drm_sched_job_submit(sched_job);
+	if (ret) {
+		p7580_drv_job_pm_release(s->drv);
+		goto err_sched;
+	}
+	if (p7580_sched_trace) {
+		p7580_sched_trace--;
+		pr_info("p7580_sched: split seq=%u pos=%u/%u slot=%d jc=0x%llx rc=0\n",
+			job->seqno, pos, s->nodes - 1, s->slot,
+			(unsigned long long)jc);
+	}
+	*fence_out = fence_ref;
+	return 0;
+
+err_sched:
+	if (fence_ref)
+		dma_fence_put(fence_ref);
+	drm_sched_job_cleanup(sched_job);
+	kfree(sched_job);
+err_job:
+	if (job->bos) {
+		for (i = 0; i < job->bo_count; i++) {
+			if (job->bos[i])
+				drm_gem_object_unreference_unlocked(
+					job->bos[i]);
+		}
+		job->bo_count = 0;
+	}
+	p7580_job_free(job);
+	return ret;
+}
+
+
+/* gpu31-allbos: map every BO this DRM file owns, not only the handles in
+ * the submit array.  Mesa 26 references a VA that belongs to no BO of the
+ * batch (kwin faults at 0x24864000, access type 2, every animation
+ * window) while Mesa 20.3.5 does not, so its command stream expects the
+ * context's BOs to be resident.  map_bo is idempotent (bo_list check). */
+static void p7580_drv_map_file_bos(struct p7580_drv *drv,
+				   struct drm_file *file_priv)
+{
+	struct drm_gem_object *objs[256];
+	unsigned int n = 0, i;
+	struct drm_gem_object *obj;
+	int id;
+
+	spin_lock(&file_priv->table_lock);
+	idr_for_each_entry(&file_priv->object_idr, obj, id) {
+		if (n >= ARRAY_SIZE(objs))
+			break;
+		drm_gem_object_reference(obj);
+		objs[n++] = obj;
+	}
+	spin_unlock(&file_priv->table_lock);
+
+	for (i = 0; i < n; i++) {
+		p7580_drv_map_bo(drv, objs[i]);
+		drm_gem_object_unreference_unlocked(objs[i]);
+	}
+}
+
+int p7580_drv_submit(struct p7580_drv *drv, struct drm_device *dev,
+		     struct drm_file *file_priv,
+		     const struct p7580_submit *args)
+{
+	struct p7580_drv_file *df = file_priv->driver_priv;
+	struct drm_gem_object *objs[P7580_MAX_SUBMIT_BOS];
+	uint32_t hsave[P7580_MAX_SUBMIT_BOS];
+	struct dma_fence *inf[P7580_MAX_IN_SYNCS];
+	struct drm_sched_entity *entity;
+	unsigned int i, nr = 0, nf = 0;
+	/* gpu31-mmaprefs closure probe: at most 8 ledger lines per
+	 * submit so the job trace budget is never starved. */
+	unsigned int pin_budget = 8;
+	int slot, ret;
+
+	if (!drv || !dev || !file_priv || !args || !df)
+		return (int)p7580_submit_err("validate", -EINVAL);
+	if (!p7580_jc_valid(args->jc))
+		return (int)p7580_submit_err("validate", -EINVAL);
+	if (args->requirements & ~(P7580_JD_REQ_FS |
+				   P7580_JD_REQ_ONLY_COMPUTE))
+		return (int)p7580_submit_err("validate", -EINVAL);
+	if (args->in_sync_count > P7580_MAX_IN_SYNCS ||
+	    args->bo_handle_count > P7580_MAX_SUBMIT_BOS)
+		return (int)p7580_submit_err("validate", -EINVAL);
+
+	/* ST-IOCTL: ioctl reached the driver with a valid envelope. */
+	if (p7580_sched_trace) {
+		p7580_sched_trace--;
+		pr_info("p7580_sched: ioctl jc=0x%llx req=0x%x bo=%u in=%u out=%u\n",
+			(unsigned long long)args->jc, args->requirements,
+			args->bo_handle_count, args->in_sync_count,
+			args->out_sync);
+	}
+
+	slot = p7580_job_slot(args->requirements);
+	if (slot < 0 || slot >= P7580_NUM_JOB_SLOTS)
+		return (int)p7580_submit_err("validate", -EINVAL);
+	if (!(drv->jd.js_present & (1u << slot)))
+		return (int)p7580_submit_err("validate", -ENODEV);
+
+	ret = p7580_drv_sched_ensure();
+	if (ret)
+		return ret;
+	entity = &df->entity[slot];
+	/* gpu31-firstfault: serialize_fs queues the FS (slot 0) submit on
+	 * the chain slot's entity, so the fragment job is ordered behind
+	 * the tiler by one FIFO instead of by a cross-entity shim
+	 * dependency alone. The hardware slot stays job->slot (0); only
+	 * the queue it rides changes. A/B knob, default 0. */
+	if (slot == 0 && drv->jd.serialize_fs &&
+	    (drv->jd.js_present & (1u << 1)))
+		entity = &df->entity[1];
+
+	/* 1. in-fences (referenced; put on every exit path). */
+	if (args->in_sync_count) {
+		const uint32_t *hs =
+			(const uint32_t *)(uintptr_t)args->in_syncs;
+
+		for (i = 0; i < args->in_sync_count; i++) {
+			struct drm_syncobj *s =
+				drm_syncobj_find(&df->mgr, hs[i]);
+			struct dma_fence *f;
+
+			if (!s) {
+ret = (int)p7580_submit_err("in_sync", -ENOENT);
+				goto err_inf;
+			}
+			f = drm_syncobj_find_fence(s);
+			drm_syncobj_put(s);
+			if (!f) {
+				/* Empty syncobj: already signaled (0003). */
+				continue;
+			}
+			inf[nf++] = f;
+		}
+	}
+
+	/* 2. BO lookup + map into AS 0 (referenced; unref on exit). */
+	p7580_drv_map_file_bos(drv, file_priv);
+	if (args->bo_handle_count) {
+		const uint32_t *uh =
+			(const uint32_t *)(uintptr_t)args->bo_handles;
+
+		for (i = 0; i < args->bo_handle_count; i++) {
+			struct drm_gem_object *obj =
+				drm_gem_object_lookup(dev, file_priv,
+						      uh[i]);
+
+			if (!obj) {
+ret = (int)p7580_submit_err("bo", -ENOENT);
+				goto err_objs;
+			}
+			objs[nr++] = obj;
+			hsave[nr - 1] = uh[i];
+			ret = p7580_drv_map_bo(drv, obj);
+			if (ret)
+				goto err_objs;
+			/* gpu31-coherency + gpu31-cachedir: CPU fills
+			 * descriptors/payloads before SUBMIT (ioctl copy
+			 * / mmap writes); CLEAN (writeback, never
+			 * invalidate) those lines to the point the GPU
+			 * reads now that the BO is bound, and before
+			 * anything else can invalidate the range.
+			 * Before the job is queued. */
+			p7580_gem_submit_sync(obj);
+			/* gpu31-mmaprefs closure probe (shaderbo §5.1):
+			 * page ledger + first words of this BO's first
+			 * page at SUBMIT, after the clean. count must
+			 * stay >= 3 for a mapped BO (page cache + BO +
+			 * mapping pin; +1 per mapped PTE) and the ISA
+			 * words must not be zero. Budgeted. */
+			if (pin_budget) {
+				pin_budget--;
+				p7580_gem_debug_page_ledger(obj, "sub", 0);
+			}
+		}
+	}
+
+	/* 3. gpu31-chainsplit: walk the submitted chain (next pointers)
+	 * and queue one sched job per node on this slot's entity. Each
+	 * node gets its own START, so the standard p7580_js_config()
+	 * (START/END_FLUSH_CLEAN_INV) brackets every stage and the
+	 * vertex->tiler handoff crosses a real submit boundary.
+	 * Ordering is a drm_sched dependency on the previous node; the
+	 * ioctl's out_sync goes on the LAST node's fence only. */
+	{
+		uint32_t hdr[P7580_CHAIN_MAX_JOBS][P7580_CHAIN_HDR_WORDS];
+		uint64_t jcs[P7580_CHAIN_MAX_JOBS];
+		uint64_t srcjcs[P7580_CHAIN_MAX_JOBS];
+		/* gpu31-storm58: live SFBD pointer per fragment node and
+		 * the SUBMIT age of every submitted BO. */
+		uint32_t fbds[P7580_CHAIN_MAX_JOBS];
+		uint32_t ages[P7580_MAX_SUBMIT_BOS];
+		struct p7580_chain_shadow *shadow = NULL;
+		struct p7580_split_ctx sctx;
+		struct dma_fence *serial_prev = NULL;
+		struct dma_fence *last_fence = NULL;
+		unsigned int nodes = 0, queued = 0, ci;
+		int need_shadow;
+		uint64_t walk = args->jc;
+
+		ret = 0;
+
+		/* gpu31-storm58: stamp the age ledger once per SUBMIT so
+		 * every node of this split reads the same "SUBMITs since
+		 * this file last used this BO" number. Bounded (nr is
+		 * capped by P7580_MAX_SUBMIT_BOS), no allocation. */
+		df->submit_no++;
+		for (i = 0; i < nr; i++)
+			ages[i] = p7580_drv_bo_age_touch(
+				df, to_p7580_bo(objs[i])->iova,
+				df->submit_no);
+
+		for (;;) {
+			uint64_t next;
+
+			if (nodes == P7580_CHAIN_MAX_JOBS) {
+				ret = (int)p7580_submit_err("chain", -E2BIG);
+				goto err_split;
+			}
+			ret = p7580_drv_gpu_read(drv, walk, hdr[nodes],
+						 P7580_JOB_DESC_HDR_SIZE);
+			if (ret) {
+				ret = (int)p7580_submit_err("chain", ret);
+				goto err_split;
+			}
+			/* gpu31-storm58: a fragment job (type 9) carries
+			 * the SFBD pointer in payload word 10. Capture it
+			 * here (4 bytes; p7580_drv_gpu_read bounds-checks
+			 * it against the owning BO) so the one-shot fault
+			 * dump can dump the SFBD page without an
+			 * out-of-bounds desc[] read. 0 when unreadable. */
+			fbds[nodes] = 0;
+			if (((hdr[nodes][4] >> 1) & 0x7fu) == 9u)
+				(void)p7580_drv_gpu_read(drv, walk + 40u,
+							 &fbds[nodes],
+							 sizeof(fbds[0]));
+			/* Only grounded Midgard job aggregates can be
+			 * isolated into a shadow slot. */
+			if (!p7580_chain_job_bytes(
+					p7580_chain_hdr_type(hdr[nodes]))) {
+				ret = (int)p7580_submit_err("chain", -EINVAL);
+				goto err_split;
+			}
+			jcs[nodes] = walk;
+			nodes++;
+			next = p7580_chain_hdr_next(hdr[nodes - 1]);
+			if (!next)
+				break;
+			if (!p7580_jc_valid(next)) {
+				ret = (int)p7580_submit_err("chain", -EINVAL);
+				goto err_split;
+			}
+			walk = next;
+		}
+
+		/* A one-node chain with no dependency indices is already a
+		 * standalone dispatch (Mesa's fragment submit): keep the
+		 * original descriptor and allocate no shadow BO. */
+		need_shadow = nodes > 1 ||
+			p7580_chain_hdr_dep1(hdr[0]) ||
+			p7580_chain_hdr_dep2(hdr[0]);
+		/* gpu31-firstfault: words 0..3 are hardware OUTPUT fields
+		 * (exception_status, first_incomplete_task, fault_pointer)
+		 * that Mesa never initialises. A nonzero value left in a
+		 * recycled pool page would otherwise be dispatched
+		 * verbatim; route such a descriptor through the shadow so
+		 * it can be sanitised. */
+		for (ci = 0; ci < nodes && !need_shadow; ci++) {
+			if (hdr[ci][0] | hdr[ci][1] | hdr[ci][2] | hdr[ci][3]) {
+				need_shadow = 1;
+				pr_info("p7580_job: desc-stale nodes=%u pos=%u src=0x%llx w=%08x %08x %08x %08x (shadowed+sanitised)\n",
+					nodes, ci, (unsigned long long)jcs[ci],
+					hdr[ci][0], hdr[ci][1], hdr[ci][2],
+					hdr[ci][3]);
+			}
+		}
+
+		if (need_shadow) {
+			shadow = p7580_drv_shadow_create(drv, dev, df, nodes);
+			if (IS_ERR(shadow)) {
+				ret = (int)p7580_submit_err("chain",
+							    PTR_ERR(shadow));
+				shadow = NULL;
+				goto err_split;
+			}
+			for (ci = 0; ci < nodes; ci++) {
+				uint32_t jobw[48];
+				unsigned int bytes = p7580_chain_job_bytes(
+					p7580_chain_hdr_type(hdr[ci]));
+
+				/* Copy header + inline payload, then
+				 * isolate: next = NULL, deps = 0,
+				 * index = position + 1. */
+				ret = p7580_drv_gpu_read(drv, jcs[ci], jobw,
+							 bytes);
+				if (ret) {
+					ret = (int)p7580_submit_err("chain",
+								    ret);
+					goto err_split;
+				}
+				p7580_chain_hdr_isolate(jobw, ci);
+				/* gpu31-firstfault: the JM writes the four
+				 * header status words on fault (measured:
+				 * word0=0x00010258, fault_pointer=jc after
+				 * a 0x58). They are outputs: never feed a
+				 * recycled page's leftovers back to the
+				 * hardware. */
+				jobw[0] = 0;
+				jobw[1] = 0;
+				jobw[2] = 0;
+				jobw[3] = 0;
+				memcpy(hdr[ci], jobw,
+				       P7580_JOB_DESC_HDR_SIZE);
+				ret = p7580_drv_shadow_write(shadow->obj,
+					(size_t)ci * P7580_CHAIN_SLOT_STRIDE,
+					jobw, bytes);
+				if (ret) {
+					ret = (int)p7580_submit_err("chain",
+								    ret);
+					goto err_split;
+				}
+			}
+			/* Publish every rewritten descriptor to DRAM. */
+			p7580_gem_submit_sync(shadow->obj);
+			/* Keep the live addresses for the fault dump: jcs[]
+			 * is about to be overwritten with the shadows. */
+			for (ci = 0; ci < nodes; ci++)
+				srcjcs[ci] = jcs[ci];
+			for (ci = 0; ci < nodes; ci++)
+				jcs[ci] = shadow->iova +
+					(uint64_t)ci *
+						P7580_CHAIN_SLOT_STRIDE;
+			if (p7580_chain_trace) {
+				p7580_chain_trace--;
+				pr_info("p7580_sched: chain jc=0x%llx nodes=%u shadow=0x%llx stride=%u\n",
+					(unsigned long long)args->jc, nodes,
+					(unsigned long long)shadow->iova,
+					P7580_CHAIN_SLOT_STRIDE);
+			}
+		}
+
+		/* Validate out_sync before anything is queued (-ENOENT
+		 * contract preserved from the single-job path). */
+		if (args->out_sync) {
+			struct drm_syncobj *vs =
+				drm_syncobj_find(&df->mgr, args->out_sync);
+
+			if (!vs) {
+				ret = (int)p7580_submit_err("out_sync",
+							    -ENOENT);
+				goto err_split;
+			}
+			drm_syncobj_put(vs);
+		}
+
+		/* Per-file serial predecessor: one temporary ref, used by
+		 * node 0 and released after the attach attempt. */
+		mutex_lock(&df->serial_lock);
+		serial_prev = df->serial_prev;
+		if (serial_prev)
+			dma_fence_get(serial_prev);
+		mutex_unlock(&df->serial_lock);
+
+		sctx.drv = drv;
+		sctx.dev = dev;
+		sctx.df = df;
+		sctx.entity = entity;
+		sctx.slot = slot;
+		sctx.requirements = args->requirements;
+		sctx.out_sync = args->out_sync;
+		sctx.objs = objs;
+		sctx.hsave = hsave;
+		sctx.nr = nr;
+		sctx.inf = inf;
+		sctx.nf = nf;
+		sctx.shadow = shadow;
+		sctx.nodes = nodes;
+		sctx.src = shadow ? srcjcs : NULL;
+		sctx.fbd = fbds;
+		sctx.age = ages;
+
+		for (ci = 0; ci < nodes; ci++) {
+			struct dma_fence *prev =
+				ci ? last_fence : serial_prev;
+			struct dma_fence *fence = NULL;
+
+			ret = p7580_drv_split_queue(&sctx, ci, jcs[ci],
+						    hdr[ci], prev, &fence);
+			if (ci == 0 && serial_prev) {
+				dma_fence_put(serial_prev);
+				serial_prev = NULL;
+			}
+			if (ret) {
+				ret = (int)p7580_submit_err("queue", ret);
+				break;
+			}
+			if (last_fence)
+				dma_fence_put(last_fence);
+			last_fence = fence;
+			queued++;
+		}
+
+		/* gpu31-latency (MFBD hand-off) + gpu31-storm58: the BO
+		 * exclusive-fence publication of the split's final fence
+		 * lives in the serial section below, under serial_lock,
+		 * together with the serial_prev swap. The resv holds ONE
+		 * exclusive fence (0002 add_excl replaces), so the publish
+		 * order must be the file's serial submit order; otherwise
+		 * an older submit's fence can land on a BO after a newer
+		 * one did, a WAIT_BO then reports the BO idle while the
+		 * newer job still uses it, and userspace rewrites it under
+		 * the GPU (int42 fragment storm). The publish still
+		 * happens before the ioctl returns, which is what the
+		 * readback path needs (flush_batches then
+		 * panfrost_bo_wait must see this submit's fence). */
+		/* One out-fence for the whole split: install on the last
+		 * queued node's armed fence. On a partial queue failure
+		 * that is the last node the GPU accepted, so a waiter
+		 * still observes the work that did run. */
+		if (queued && args->out_sync && last_fence) {
+			struct drm_syncobj *s =
+				drm_syncobj_find(&df->mgr, args->out_sync);
+
+			if (!s) {
+				ret = (int)p7580_submit_err("out_sync",
+							    -ENOENT);
+			} else {
+				int oret = drm_syncobj_replace_fence(s,
+								     last_fence);
+
+				drm_syncobj_put(s);
+				if (oret)
+					ret = (int)p7580_submit_err(
+						"out_sync", oret);
+			}
+		}
+
+		/* Publish the split's final fence as the file serial
+		 * predecessor (one slot ref) AND as the BOs' exclusive
+		 * fence, both under serial_lock. A partial failure
+		 * publishes the last node that queued, so the next SUBMIT
+		 * still orders behind everything accepted here.
+		 *
+		 * gpu31-storm58: the BO stamp must be inside this lock.
+		 * The resv carries a single exclusive fence, so whichever
+		 * SUBMIT publishes last wins; with the stamp outside the
+		 * lock (and a second identical stamp in the async run_job
+		 * path, now removed) an earlier submit's *older* fence could
+		 * overwrite a *newer* one, making WAIT_BO report a BO
+		 * busy-in-GPU as idle; Mesa's BO-cache fetch then reused
+		 * the page and rewrote the descriptor/SFBD of a job still
+		 * in flight. Publishing here makes the last writer the
+		 * last submit in serial order, whose fence dominates every
+		 * earlier submit touching the same BOs. */
+		if (queued) {
+			struct dma_fence *old = NULL;
+
+			mutex_lock(&df->serial_lock);
+			if (last_fence) {
+				for (i = 0; i < nr; i++) {
+					struct drm_gem_object *o = objs[i];
+
+					if (!o)
+						continue;
+					dma_resv_add_excl_fence(
+						&to_p7580_bo(o)->resv,
+						last_fence);
+				}
+			}
+			old = df->serial_prev;
+			df->serial_prev = last_fence;
+			if (df->serial_prev)
+				dma_fence_get(df->serial_prev);
+			mutex_unlock(&df->serial_lock);
+			if (old)
+				dma_fence_put(old);
+		}
+
+err_split:
+		/* Nodes that never queued still own one shadow reference
+		 * each; queued nodes release theirs in free_job. */
+		if (shadow) {
+			for (ci = queued; ci < nodes; ci++)
+				p7580_drv_shadow_put(shadow);
+		}
+		if (last_fence)
+			dma_fence_put(last_fence);
+		if (serial_prev)
+			dma_fence_put(serial_prev);
+	}
+
+	/* The ioctl's lookup references and in-fence references are no
+	 * longer needed: each queued node owns its own set, and the
+	 * sched dependency graph owns the external fence references. */
+err_objs:
+	for (i = 0; i < nr; i++)
+		drm_gem_object_unreference_unlocked(objs[i]);
+err_inf:
+	for (i = 0; i < nf; i++)
+		dma_fence_put(inf[i]);
+	return ret;
+}
+
+/* SUBMIT ioctl override (wired in main.c's table instead of GEM's
+ * panfrost_ioctl_submit). Stages user arrays with copy_from_user, then
+ * runs p7580_drv_submit. Caps mirror the jobs slice (64 BOs / 16 syncs).
+ * Must stay in sync with jobs/panfrost7580_jm_hw.h struct p7580_submit
+ * (the staged local). */
+int panfrost_ioctl_submit_override(struct drm_device *dev, void *data,
+				   struct drm_file *file_priv)
+{
+	struct drm_panfrost_submit *args = data;
+	struct p7580_drv_file *df = file_priv->driver_priv;
+	struct p7580_drv *drv;
+	uint32_t bo_handles[P7580_MAX_SUBMIT_BOS];
+	uint32_t in_syncs[P7580_MAX_IN_SYNCS];
+	struct p7580_submit staged;
+
+	if (!df || !df->drv)
+		return -ENODEV;
+	drv = df->drv;
+	if (!p7580_jc_valid(args->jc))
+		return -EINVAL;
+	if (args->requirements & ~PANFROST_JD_REQ_FS)
+		return -EINVAL;
+	if (args->in_sync_count > P7580_MAX_IN_SYNCS ||
+	    args->bo_handle_count > P7580_MAX_SUBMIT_BOS)
+		return -EINVAL;
+
+	if (args->bo_handle_count) {
+		if (!args->bo_handles ||
+		    copy_from_user(bo_handles, (void __user *)(uintptr_t)
+				   args->bo_handles,
+				   args->bo_handle_count * sizeof(uint32_t)))
+			return -EFAULT;
+	}
+	if (args->in_sync_count) {
+		if (!args->in_syncs ||
+		    copy_from_user(in_syncs, (void __user *)(uintptr_t)
+				   args->in_syncs,
+				   args->in_sync_count * sizeof(uint32_t)))
+			return -EFAULT;
+	}
+
+	staged.jc = args->jc;
+	staged.in_syncs = (uint64_t)(uintptr_t)in_syncs;
+	staged.in_sync_count = args->in_sync_count;
+	staged.out_sync = args->out_sync;
+	staged.bo_handles = (uint64_t)(uintptr_t)bo_handles;
+	staged.bo_handle_count = args->bo_handle_count;
+	staged.requirements = args->requirements;
+
+	/* Under runtime PM the GPU must be awake for the synchronous
+	 * MMU-map + queue leg. p7580_drv_submit arms a second,
+	 * job-lifetime ref before the job is visible to the async
+	 * worker, so dropping this ref on return is safe: the block
+	 * stays powered until free_job releases the job's own ref.
+	 * Fail closed: no MMIO (not even map_bo) after a failed get. */
+	{
+		int ret = p7580_drv_pm_get(drv);
+
+		if (ret < 0)
+			return ret;
+		ret = p7580_drv_submit(drv, dev, file_priv, &staged);
+		p7580_drv_pm_put(drv);
+		return ret;
+	}
+}
diff -u -Naur a/drivers/gpu/drm/panfrost/panfrost7580_syncobj.c b/drivers/gpu/drm/panfrost/panfrost7580_syncobj.c
--- a/drivers/gpu/drm/panfrost/panfrost7580_syncobj.c
+++ b/drivers/gpu/drm/panfrost/panfrost7580_syncobj.c
@@ -0,0 +1,859 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * panfrost7580_syncobj.c - generic DRM syncobj ioctl bodies for the
+ * T720 port (Exynos 7580, Nura 3.10.108, j7elte).
+ *
+ * Context (see the header): Mesa 20.3.5 panfrost asserts on
+ * drmSyncobjCreate (pan_context.c:1632-1633). The 3.10 core exposes
+ * no core SYNCOBJ rows, and the driver-private table only serves
+ * nr < DRM_COMMAND_END (0xA0); the generic syncobj numbers
+ * (0xBF-0xC5) always fall through to the core table, where a NULL
+ * func returns -EINVAL (drm_drv.c:401-435). So this file registers
+ * NOTHING in the driver's ioctl table. Instead the driver's fops
+ * .unlocked_ioctl/.compat_ioctl point at panfrost_syncobj_ioctl,
+ * which routes the seven syncobj numbers here and forwards
+ * everything else to drm_ioctl() unchanged.
+ *
+ * errno contract (what Mesa/libdrm expect; same as mainline):
+ *  - CREATE: unknown flags bits -> -EINVAL (mainline rejects
+ *    anything but CREATE_SIGNALED at once: the check is
+ *    flags & ~DRM_SYNCOBJ_CREATE_SIGNALED).
+ *  - CREATE_SIGNALED: installs a signaled fence so a first WAIT
+ *    returns 0 instead of blocking forever. 3.10 has no pre-signaled
+ *    fence type, so an already-signaled private fence is used
+ *    (dma_fence_init + dma_fence_signal, released on replace).
+ *  - DESTROY of an unknown handle -> -ENOENT (0003 shim contract;
+ *    matches mainline ENOENT-on-stale-handle).
+ *  - WAIT: unknown flag bits -> -EINVAL; timeout is ABSOLUTE
+ *    CLOCK_MONOTONIC ns (drm_syncobj_wait in the 20.x libdrm wrapper
+ *    passes the absolute stamp straight through). Past/zero stamp is
+ *    non-blocking (0 jiffies). count==0 or NULL handles -> -EINVAL.
+ *    WAIT_ALL(all fences signaled -> 0) and WAIT_ANY(first signaled
+ *    index in first_signaled, still 0; none signaled in budget ->
+ *    -ETIME, matching the shim's dma_fence_wait_timeout -ETIME).
+ *    WAIT_FOR_SUBMIT/WAIT_AVAILABLE need the timeline/eventfd code
+ *    the 0003 shim deliberately omits -> -EINVAL (never silently
+ *    ignored: Mesa would hang on an un-waited submit fence).
+ *  - RESET of an unknown handle -> -ENOENT; NULL fence is already
+ *    the signaled state, so reset keeps fence NULL and returns 0.
+ *  - SIGNAL: unknown handle -> -ENOENT; the installed fence is a
+ *    private already-signaled fence (see CREATE_SIGNALED). Signaling
+ *    an already-signaled (or empty) syncobj is a no-op 0 -- Mesa
+ *    re-signals without checking.
+ *  - HANDLE_TO_FD/FD_TO_HANDLE tolerate bit 0 (libdrm 2.4.134 sets
+ *    EXPORT/IMPORT_SYNC_FILE unconditionally; no sync_file.c on 3.10
+ *    but the plain-fence anon-inode fd satisfies Mesa's snapshot use)
+ *    and reject all other unknown bits (TIMELINE bit 1 included).
+ *  - copy_from_user/copy_to_user faults -> -EFAULT (the 3.10 core
+ *    copies the fixed struct, NOT the pointed-to handle array; the
+ *    array is copied here).
+ *  - no driver_priv (open did not run) -> -ENODEV.
+ *
+ * Locking: the 0003 manager serialises the idr; each syncobj
+ * serialises its own fence pointer. WAIT snapshots fence refs under
+ * the manager then sleeps unlocked. The anon-inode export holds a
+ * fence ref for the file's lifetime (released in syncobj_file_release).
+ *
+ * SHIM-CALLSITES: 0003 (manager create/destroy/find, replace_fence,
+ * find_fence). 0001 (dma_fence_init/signal/wait_timeout/get/put via
+ * the 0003 wrappers). No 0002/0004 use.
+ */
+
+#include <linux/anon_inodes.h>
+#include <linux/device.h>
+#include <linux/dma-mapping.h>
+#include <linux/file.h>
+#include <linux/jiffies.h>
+#include <linux/ktime.h>
+#include <linux/mutex.h>
+#include <linux/slab.h>
+#include <linux/time.h>
+#include <linux/uaccess.h>
+
+#include <drm/drmP.h>
+#include <drm/drm.h>
+
+#include <linux/dma-fence.h>		/* 0001 (staged by Makefile) */
+#include "drm_syncobj.h"		/* 0003 (staged by Makefile) */
+#include "panfrost7580_syncobj.h"
+
+/* ---- UAPI payload mirrors (3.10-era sizes, byte-identical wire) ---- */
+/* v5.2/20.x drm.h: SYNCOBJ ioctls are core numbers, NOT driver-private:
+ * CREATE 0xBF, DESTROY 0xC0, HANDLE_TO_FD 0xC1, FD_TO_HANDLE 0xC2,
+ * WAIT 0xC3, RESET 0xC4, SIGNAL 0xC5 (DRM_IOWR). The _IOC_NR (low 8
+ * bits) is what drm_ioctl dispatches on; the core table has no rows
+ * there, so our fops dispatcher catches them first. */
+#define P7580_SYNCOBJ_NR_CREATE		0xBFu
+#define P7580_SYNCOBJ_NR_DESTROY	0xC0u
+#define P7580_SYNCOBJ_NR_HANDLE_TO_FD	0xC1u
+#define P7580_SYNCOBJ_NR_FD_TO_HANDLE	0xC2u
+#define P7580_SYNCOBJ_NR_WAIT		0xC3u
+#define P7580_SYNCOBJ_NR_RESET		0xC4u
+#define P7580_SYNCOBJ_NR_SIGNAL		0xC5u
+/* DEBUG-ONLY (gpu31-gpuwrite, strip before cutover): kernel BO word
+ * readback route. 0xCF sits above the syncobj 0xBF-0xC5 block and
+ * below DRM_COMMAND_BASE 0x40-space driver numbers: no collision
+ * with either table; the six-ioctl driver table is untouched. */
+#define P7580_DEBUG_READ_BO_NR		0xCFu
+
+#define P7580_SYNCOBJ_CREATE_SIGNALED	(1u << 0)
+
+#define P7580_SYNCOBJ_WAIT_ALL		(1u << 0)
+#define P7580_SYNCOBJ_WAIT_FOR_SUBMIT	(1u << 1)
+#define P7580_SYNCOBJ_WAIT_AVAILABLE	(1u << 2)
+/* Bits the 20.x WAIT struct defines but this binary subset cannot
+ * honour: deadline hint (needs fence deadlines, absent in 0001). */
+#define P7580_SYNCOBJ_WAIT_DEADLINE	(1u << 3)
+
+struct p7580_syncobj_create {
+	__u32 handle;
+	__u32 flags;
+};
+
+struct p7580_syncobj_destroy {
+	__u32 handle;
+	__u32 pad;
+};
+
+struct p7580_syncobj_handle {
+	__u32 handle;
+	__u32 flags;
+	__s32 fd;
+	__u32 pad;
+};
+
+struct p7580_syncobj_wait {
+	__u64 handles;
+	__s64 timeout_nsec;	/* absolute CLOCK_MONOTONIC */
+	__u32 count_handles;
+	__u32 flags;
+	__u32 first_signaled;
+	__u32 pad;
+};
+
+struct p7580_syncobj_array {
+	__u64 handles;
+	__u32 count_handles;
+	__u32 pad;
+};
+/* DEBUG-ONLY (gpu31-gpuwrite, strip before cutover): 16 B payload
+ * mirror of struct p7580_debug_read_bo (ioctl.c): handle + byte
+ * offset + OUT value + zero pad. Same 16 B shape discipline as the
+ * syncobj structs. */
+struct p7580_debug_read_bo {
+	__u32 handle;
+	__u32 offset;
+	__u32 value;
+	__u32 pad;
+};
+int panfrost_debug_read_bo(struct drm_device *dev, void *data,
+			   struct drm_file *file_priv);
+
+/* ABI gate (gpu31-abialign, both TUs): Mesa 20.3 bundles the 20.x
+ * drm.h syncobj shapes (verified on-device 2026-11-20 from
+ * /data/mesabuild/mesa20/include/drm-uapi/drm.h + disassembled
+ * libdrm.so.2.134.0 wrappers):
+ *   CREATE 8 B  IOWR(0xBF), DESTROY 8 B (v5.2-era: IOWR, current is
+ *   IOWR too -- the old IOW comment in pf7580.c predates the check),
+ *   HANDLE 16 B IOWR(0xC1/0xC2, NO point field),
+ *   WAIT   32 B IOWR(0xC3, NO deadline_nsec tail),
+ *   ARRAY  16 B IOWR(0xC4/0xC5).
+ * The 3.10 core keys copy_from/to_user on OUR asize (the dispatcher's
+ * asize table below), so the struct MUST stay 16/32 B: a 24/40 B
+ * current-header struct would over-copy into the stack buffer. The
+ * dispatcher ALSO keys on _IOC_NR only (not _IOC_SIZE), so a 24 B
+ * HANDLE_TO_FD from libdrm 2.4.134 lands here with usize=24; the
+ * handler reads only the first 16 B and ignores the point tail.
+ * ioctl direction (client pf7580.c asserts the same): CREATE+WAIT are
+ * IOWR, DESTROY is IOWR on the wire the kernel serves (20.x drm.h says
+ * DRM_IOWR for all three; the legacy IOW DESTROY encoding aliases the
+ * same _IOC_NR so dispatch is unaffected, but new code MUST use IOWR).
+ * Flag contract: SYNC_FILE bits (HTOF/FTOH bit 0) need sync_file.c
+ * (absent on 3.10) and are the ONLY rejected HTOF/FTOH bits; WAIT
+ * rejects FOR_SUBMIT/AVAILABLE/DEADLINE. See the handle_to_fd body for
+ * why SYNC_FILE is silently tolerated on plain-fence exports. */
+#include <linux/bug.h>
+/* Bit 0 doubles as the only valid HTOF/FTOH flag on BOTH the 20.x
+ * header (EXPORT/IMPORT_SYNC_FILE) and mainline (TIMELINE is bit 1). */
+#define P7580_SYNCOBJ_HTOF_EXPORT_SYNC_FILE	(1u << 0)
+#define P7580_SYNCOBJ_FTOH_IMPORT_SYNC_FILE	(1u << 0)
+static inline void p7580_syncobj_abi_check(void)
+{
+	BUILD_BUG_ON(sizeof(struct p7580_syncobj_create) != 8);
+	BUILD_BUG_ON(sizeof(struct p7580_syncobj_destroy) != 8);
+	BUILD_BUG_ON(sizeof(struct p7580_syncobj_handle) != 16);
+	BUILD_BUG_ON(__builtin_offsetof(struct p7580_syncobj_handle,
+					handle) != 0);
+	BUILD_BUG_ON(__builtin_offsetof(struct p7580_syncobj_handle,
+					flags) != 4);
+	BUILD_BUG_ON(__builtin_offsetof(struct p7580_syncobj_handle,
+					fd) != 8);
+	BUILD_BUG_ON(__builtin_offsetof(struct p7580_syncobj_handle,
+					pad) != 12);
+	BUILD_BUG_ON(sizeof(struct p7580_syncobj_wait) != 32);
+	BUILD_BUG_ON(__builtin_offsetof(struct p7580_syncobj_wait,
+					handles) != 0);
+	BUILD_BUG_ON(__builtin_offsetof(struct p7580_syncobj_wait,
+					timeout_nsec) != 8);
+	BUILD_BUG_ON(__builtin_offsetof(struct p7580_syncobj_wait,
+					count_handles) != 16);
+	BUILD_BUG_ON(__builtin_offsetof(struct p7580_syncobj_wait,
+					flags) != 20);
+	BUILD_BUG_ON(__builtin_offsetof(struct p7580_syncobj_wait,
+					first_signaled) != 24);
+	BUILD_BUG_ON(__builtin_offsetof(struct p7580_syncobj_wait,
+					pad) != 28);
+	BUILD_BUG_ON(sizeof(struct p7580_syncobj_array) != 16);
+	BUILD_BUG_ON(P7580_SYNCOBJ_CREATE_SIGNALED !=
+		     (1u << 0));
+	BUILD_BUG_ON(P7580_SYNCOBJ_WAIT_ALL != (1u << 0));
+	BUILD_BUG_ON(P7580_SYNCOBJ_WAIT_FOR_SUBMIT != (1u << 1));
+	BUILD_BUG_ON(P7580_SYNCOBJ_WAIT_AVAILABLE != (1u << 2));
+	BUILD_BUG_ON(P7580_SYNCOBJ_HTOF_EXPORT_SYNC_FILE != (1u << 0));
+	BUILD_BUG_ON(P7580_SYNCOBJ_FTOH_IMPORT_SYNC_FILE != (1u << 0));
+	/* DEBUG-ONLY (gpu31-gpuwrite): 16 B readback payload pin. */
+	BUILD_BUG_ON(sizeof(struct p7580_debug_read_bo) != 16);
+	BUILD_BUG_ON(__builtin_offsetof(struct p7580_debug_read_bo,
+					handle) != 0);
+	BUILD_BUG_ON(__builtin_offsetof(struct p7580_debug_read_bo,
+					offset) != 4);
+	BUILD_BUG_ON(__builtin_offsetof(struct p7580_debug_read_bo,
+					value) != 8);
+	BUILD_BUG_ON(__builtin_offsetof(struct p7580_debug_read_bo,
+					pad) != 12);
+	BUILD_BUG_ON(P7580_DEBUG_READ_BO_NR != 0xCFu);
+}
+
+/* The manager lives first in driver_priv (GEM p7580_file_priv and the
+ * driver's p7580_drv_file share the layout: mgr, ...). */
+static struct drm_syncobj_manager *p7580_sync_mgr(struct drm_file *fp)
+{
+	struct drm_syncobj_manager *mgr;
+
+	if (!fp)
+		return NULL;
+	mgr = (struct drm_syncobj_manager *)fp->driver_priv;
+	return mgr;
+}
+
+/* A pre-signaled fence: 0001 has no timeline/signaled constructor, so
+ * init a private fence and signal it once. Ops mirror the submit-job
+ * fence backend contract (release via release_base). The table is
+ * writable static (NOT const): dma_fence_init BUGs on a NULL release,
+ * so the hook must be assignable at definition time, and a const
+ * table would take a .rodata write on first CREATE_SIGNALED/SIGNAL. */
+static void p7580_sync_signaled_release(struct dma_fence *fence)
+{
+	dma_fence_release_base(fence);
+	kfree(fence);
+}
+
+static struct dma_fence_ops p7580_sync_signaled_ops = {
+	.get_driver_name = NULL,
+	.get_timeline_name = NULL,
+	.enable_signaling = NULL,
+	.signaled = NULL,
+	.wait = NULL,
+	.release = p7580_sync_signaled_release,
+};
+
+static struct dma_fence *p7580_sync_signaled_fence(void)
+{
+	struct dma_fence *f;
+
+	f = kzalloc(sizeof(*f), GFP_KERNEL);
+	if (!f)
+		return NULL;
+	dma_fence_init(f, &p7580_sync_signaled_ops,
+		       dma_fence_context_alloc(1), 1);
+	dma_fence_signal(f);
+	return f;
+}
+
+int panfrost_syncobj_create(struct drm_device *dev, void *data,
+			    struct drm_file *file_priv)
+{
+	struct p7580_syncobj_create *args = data;
+	struct drm_syncobj_manager *mgr = p7580_sync_mgr(file_priv);
+	struct drm_syncobj *s;
+	u32 handle;
+	int ret;
+
+	(void)dev;
+	p7580_syncobj_abi_check();
+	if (!mgr)
+		return -ENODEV;
+	/* Mainline rejects any unknown bit at once (flags & ~SIGNALED). */
+	if (args->flags & ~P7580_SYNCOBJ_CREATE_SIGNALED)
+		return -EINVAL;
+	ret = drm_syncobj_create(mgr, &handle);
+	if (ret)
+		return ret;
+	if (args->flags & P7580_SYNCOBJ_CREATE_SIGNALED) {
+		struct dma_fence *f = p7580_sync_signaled_fence();
+
+		if (!f) {
+			drm_syncobj_destroy(mgr, handle);
+			return -ENOMEM;
+		}
+		s = drm_syncobj_find(mgr, handle);
+		if (!s) {
+			dma_fence_put(f);
+			drm_syncobj_destroy(mgr, handle);
+			return -ENOENT;
+		}
+		ret = drm_syncobj_replace_fence(s, f);
+		drm_syncobj_put(s);
+		/* replace takes its own ref. */
+		dma_fence_put(f);
+		if (ret) {
+			drm_syncobj_destroy(mgr, handle);
+			return ret;
+		}
+	}
+	args->handle = handle;
+	return 0;
+}
+
+int panfrost_syncobj_destroy(struct drm_device *dev, void *data,
+			     struct drm_file *file_priv)
+{
+	struct p7580_syncobj_destroy *args = data;
+	struct drm_syncobj_manager *mgr = p7580_sync_mgr(file_priv);
+
+	(void)dev;
+	if (!mgr)
+		return -ENODEV;
+	if (args->pad)
+		return -EINVAL;
+	/* Unknown handle -> -ENOENT (0003 contract, mainline parity). */
+	return drm_syncobj_destroy(mgr, args->handle);
+}
+
+/* ---- FD export/import: plain-fence anon_inode transport ---- */
+/* 3.10 has no sync_file.c, so HANDLE_TO_FD exports the CURRENT fence
+ * (snapshot ref at export time; later replaces do not follow the fd).
+ * Bit 0 (EXPORT/IMPORT_SYNC_FILE) is tolerated (see handler bodies);
+ * all other flag bits are -EINVAL. */
+
+struct p7580_syncobj_export {
+	struct dma_fence *fence;	/* ref held for the file */
+};
+
+static int p7580_syncobj_file_release(struct inode *inode, struct file *filp)
+{
+	struct p7580_syncobj_export *ex = filp->private_data;
+
+	(void)inode;
+	if (ex) {
+		dma_fence_put(ex->fence);
+		kfree(ex);
+	}
+	return 0;
+}
+
+static const struct file_operations p7580_syncobj_file_fops = {
+	.owner = THIS_MODULE,
+	.release = p7580_syncobj_file_release,
+};
+
+int panfrost_syncobj_handle_to_fd(struct drm_device *dev, void *data,
+				  struct drm_file *file_priv)
+{
+	struct p7580_syncobj_handle *args = data;
+	struct drm_syncobj_manager *mgr = p7580_sync_mgr(file_priv);
+	struct drm_syncobj *s;
+	struct dma_fence *f;
+	struct p7580_syncobj_export *ex;
+	int fd;
+
+	(void)dev;
+	p7580_syncobj_abi_check();
+	if (!mgr)
+		return -ENODEV;
+	if (args->pad)
+		return -EINVAL;
+	/* Mesa 20.3 libdrm 2.4.134 unconditionally sets bit 0
+	 * (EXPORT_SYNC_FILE) in drmSyncobjExportSyncFile/HandleToFD
+	 * (disassembled: stp w1=handle,w2=-1 + mov w1=#1 for the flag
+	 * word; pan_screen.c panfrost_fence_create calls ExportSyncFile
+	 * so EVERY fence snapshot -- and therefore every glFinish/
+	 * ReadPixels flush -- goes through here). There is no sync_file
+	 * layer on 3.10, but the plain-fence anon-inode fd we install
+	 * satisfies the only thing Mesa does with it: import the fence
+	 * into a fresh syncobj. Rejecting bit 0 broke all draws (3x
+	 * EINVAL per flush, SUBMIT never reached). So: tolerate bit 0,
+	 * reject every OTHER unknown bit (TIMELINE bit 1 included --
+	 * the 0003 shim has no timeline points, and silently dropping
+	 * them would hang Mesa on a fence we never signalled). */
+	if (args->flags & ~P7580_SYNCOBJ_HTOF_EXPORT_SYNC_FILE)
+		return -EINVAL;
+	s = drm_syncobj_find(mgr, args->handle);
+	if (!s)
+		return -ENOENT;
+	f = drm_syncobj_find_fence(s);
+	drm_syncobj_put(s);
+	if (!f)
+		return -EINVAL;	/* NULL fence: nothing to export */
+	ex = kzalloc(sizeof(*ex), GFP_KERNEL);
+	if (!ex) {
+		dma_fence_put(f);
+		return -ENOMEM;
+	}
+	ex->fence = f;	/* fd owns this ref now */
+	fd = anon_inode_getfd("syncobj", &p7580_syncobj_file_fops, ex,
+			      O_CLOEXEC);
+	if (fd < 0) {
+		dma_fence_put(f);
+		kfree(ex);
+		return fd;
+	}
+	args->fd = fd;
+	return 0;
+}
+
+int panfrost_syncobj_fd_to_handle(struct drm_device *dev, void *data,
+				  struct drm_file *file_priv)
+{
+	struct p7580_syncobj_handle *args = data;
+	struct drm_syncobj_manager *mgr = p7580_sync_mgr(file_priv);
+	struct file *filp;
+	struct p7580_syncobj_export *ex;
+	struct drm_syncobj *s;
+	u32 handle;
+	int ret;
+
+	(void)dev;
+	if (!mgr)
+		return -ENODEV;
+	if (args->pad)
+		return -EINVAL;
+	/* Mirror HANDLE_TO_FD: libdrm drmSyncobjImportSyncFile sets bit 0
+	 * (IMPORT_SYNC_FILE); tolerate it, reject the rest (TIMELINE bit 1
+	 * included). A foreign sync_file fd (real sync_file.c file) still
+	 * fails the f_op check below -- we only snapshot fences from fds
+	 * this driver exported. */
+	if (args->flags & ~P7580_SYNCOBJ_FTOH_IMPORT_SYNC_FILE)
+		return -EINVAL;
+	if (args->fd < 0)
+		return -EINVAL;
+	filp = fget((unsigned int)args->fd);
+	if (!filp)
+		return -EINVAL;
+	/* Only fds this driver exported carry a fence; anything else
+	 * (eventfd, pipe, foreign sync_file) is -EINVAL, never a
+	 * blind pointer dereference. */
+	if (filp->f_op != &p7580_syncobj_file_fops) {
+		fput(filp);
+		return -EINVAL;
+	}
+	ex = filp->private_data;
+	if (!ex || !ex->fence) {
+		fput(filp);
+		return -EINVAL;
+	}
+	ret = drm_syncobj_create(mgr, &handle);
+	if (ret) {
+		fput(filp);
+		return ret;
+	}
+	s = drm_syncobj_find(mgr, handle);
+	if (!s) {
+		fput(filp);
+		drm_syncobj_destroy(mgr, handle);
+		return -ENOENT;
+	}
+	/* Import snapshots the CURRENT fence of the fd (same non-sync_file
+	 * limit as export: later fence replaces on the source syncobj do
+	 * not propagate through the fd). */
+	ret = drm_syncobj_replace_fence(s, ex->fence);
+	drm_syncobj_put(s);
+	fput(filp);
+	if (ret) {
+		drm_syncobj_destroy(mgr, handle);
+		return ret;
+	}
+	args->handle = handle;
+	return 0;
+}
+
+int panfrost_syncobj_wait(struct drm_device *dev, void *data,
+			  struct drm_file *file_priv)
+{
+	struct p7580_syncobj_wait *args = data;
+	struct drm_syncobj_manager *mgr = p7580_sync_mgr(file_priv);
+	struct drm_syncobj **syncs = NULL;
+	struct dma_fence **fences = NULL;
+	uint32_t count, i;
+	struct timespec now;
+	int64_t remain_ns;
+	long timeout;
+	int ret = 0;
+
+	(void)dev;
+	if (!mgr)
+		return -ENODEV;
+	count = args->count_handles;
+	if (!count || !args->handles)
+		return -EINVAL;
+	/* WAIT_FOR_SUBMIT/WAIT_AVAILABLE need the timeline/eventfd code
+	 * the 0003 shim omits; deadline needs 0001 fence deadlines.
+	 * Reject (never ignore): Mesa would hang on a fence we never
+	 * waited for. WAIT_ALL vs ANY is honoured below. */
+	if (args->flags & ~(P7580_SYNCOBJ_WAIT_ALL))
+		return -EINVAL;
+	/* Absolute -> relative: same shape as WAIT_BO (ktime_get_ts is
+	 * the 3.10 spelling). Past stamp stays non-blocking. */
+	ktime_get_ts(&now);
+	remain_ns = (int64_t)args->timeout_nsec -
+		    ((int64_t)now.tv_sec * 1000000000LL + now.tv_nsec);
+	if (remain_ns <= 0)
+		timeout = 0;
+	else if ((uint64_t)remain_ns > (uint64_t)LONG_MAX)
+		timeout = LONG_MAX;
+	else
+		timeout = nsecs_to_jiffies((uint64_t)remain_ns);
+
+	/* Snapshot syncobj + fence refs under the manager, sleep after.
+	 * Caps mirror SUBMIT (64 BOs / 16 in-syncs): 64 handles max. */
+	if (count > 64)
+		return -EINVAL;
+	syncs = kcalloc(count, sizeof(*syncs), GFP_KERNEL);
+	if (!syncs)
+		return -ENOMEM;
+	fences = kcalloc(count, sizeof(*fences), GFP_KERNEL);
+	if (!fences) {
+		kfree(syncs);
+		return -ENOMEM;
+	}
+	for (i = 0; i < count; i++) {
+		uint32_t h;
+
+		if (copy_from_user(&h,
+				   (void __user *)(uintptr_t)args->handles +
+				   i * sizeof(h), sizeof(h))) {
+			ret = -EFAULT;
+			count = i;
+			goto out_put_syncs;
+		}
+		syncs[i] = drm_syncobj_find(mgr, h);
+		if (!syncs[i]) {
+			ret = -ENOENT;
+			count = i;
+			goto out_put_syncs;
+		}
+		/* NULL fence == already signaled (0003 contract): no
+		 * fence ref, counted as signaled below. */
+		fences[i] = drm_syncobj_find_fence(syncs[i]);
+	}
+	if (args->flags & P7580_SYNCOBJ_WAIT_ALL) {
+		for (i = 0; i < args->count_handles; i++) {
+			long r;
+
+			if (!fences[i])
+				continue;
+			r = dma_fence_wait_timeout(fences[i], true,
+						   timeout);
+			if (r < 0) {
+				ret = (int)r;
+				goto out_put_all;
+			}
+			/* r == 0 is ambiguous: non-blocking probe on a
+			 * pending fence (timeout == 0) also yields 0
+			 * (0001 maps helper-0 to 0 when no budget was
+			 * given). Only a signaled fence counts: re-test
+			 * and time out otherwise, or a WAIT_ALL poll on
+			 * a pending fence would falsely report success. */
+			if (!dma_fence_is_signaled(fences[i])) {
+				ret = -ETIME;
+				goto out_put_all;
+			}
+			/* Chained budget: each fence consumes from what
+			 * the previous one left (0001 returns remaining;
+			 * 0 with budget left means signaled now). */
+			timeout = r;
+		}
+		args->first_signaled = 0;
+	} else {
+		/* ANY: poll without consuming the whole budget on the
+		 * first unsignaled fence. Zero-timeout test first, then
+		 * bounded wait on each in turn with the remaining
+		 * budget split evenly (binary-subset approximation). */
+		uint32_t n = args->count_handles;
+
+		for (i = 0; i < n; i++) {
+			if (!fences[i] ||
+			    dma_fence_is_signaled(fences[i])) {
+				args->first_signaled = i;
+				goto out_put_all;
+			}
+		}
+		if (timeout == 0) {
+			ret = -ETIME;
+			goto out_put_all;
+		}
+		for (i = 0; i < n; i++) {
+			long r = dma_fence_wait_timeout(fences[i], true,
+							timeout / (n - i));
+
+			if (r < 0 && r != -ETIME) {
+				ret = (int)r;
+				goto out_put_all;
+			}
+			/* r >= 0: signaled with remaining budget (or a
+			 * 0-budget hit exactly at signal). r == 0 with an
+			 * unsignaled fence is the non-blocking probe
+			 * outcome: fall through to the -ETIME below. */
+			if (r >= 0) {
+				if (!fences[i] ||
+				    dma_fence_is_signaled(fences[i])) {
+					args->first_signaled = i;
+					ret = 0;
+					goto out_put_all;
+				}
+			}
+		}
+		ret = -ETIME;
+	}
+out_put_all:
+	count = args->count_handles;
+out_put_syncs:
+	for (i = 0; i < count; i++) {
+		dma_fence_put(fences[i]);
+		if (syncs[i])
+			drm_syncobj_put(syncs[i]);
+	}
+	kfree(fences);
+	kfree(syncs);
+	return ret;
+}
+
+int panfrost_syncobj_reset(struct drm_device *dev, void *data,
+			   struct drm_file *file_priv)
+{
+	struct p7580_syncobj_array *args = data;
+	struct drm_syncobj_manager *mgr = p7580_sync_mgr(file_priv);
+	uint32_t i, count = args->count_handles;
+
+	(void)dev;
+	if (!mgr)
+		return -ENODEV;
+	if (!count || !args->handles)
+		return -EINVAL;
+	if (count > 64)
+		return -EINVAL;
+	for (i = 0; i < count; i++) {
+		uint32_t h;
+		struct drm_syncobj *s;
+
+		if (copy_from_user(&h,
+				   (void __user *)(uintptr_t)args->handles +
+				   i * sizeof(h), sizeof(h)))
+			return -EFAULT;
+		s = drm_syncobj_find(mgr, h);
+		if (!s)
+			return -ENOENT;
+		/* Binary reset: drop the fence (NULL == signaled in the
+		 * 0003 contract, but Mesa only resets after WAIT, so the
+		 * next SUBMIT re-installs via replace_fence anyway). */
+		drm_syncobj_replace_fence(s, NULL);
+		drm_syncobj_put(s);
+	}
+	return 0;
+}
+
+int panfrost_syncobj_signal(struct drm_device *dev, void *data,
+			    struct drm_file *file_priv)
+{
+	struct p7580_syncobj_array *args = data;
+	struct drm_syncobj_manager *mgr = p7580_sync_mgr(file_priv);
+	uint32_t i, count = args->count_handles;
+
+	(void)dev;
+	if (!mgr)
+		return -ENODEV;
+	if (!count || !args->handles)
+		return -EINVAL;
+	if (count > 64)
+		return -EINVAL;
+	for (i = 0; i < count; i++) {
+		uint32_t h;
+		struct drm_syncobj *s;
+		struct dma_fence *f;
+		int ret;
+
+		if (copy_from_user(&h,
+				   (void __user *)(uintptr_t)args->handles +
+				   i * sizeof(h), sizeof(h)))
+			return -EFAULT;
+		s = drm_syncobj_find(mgr, h);
+		if (!s)
+			return -ENOENT;
+		/* Already-signaled (or empty) is a no-op 0. */
+		f = drm_syncobj_find_fence(s);
+		if (!f || dma_fence_is_signaled(f)) {
+			dma_fence_put(f);
+			drm_syncobj_put(s);
+			continue;
+		}
+		dma_fence_put(f);
+		f = p7580_sync_signaled_fence();
+		if (!f) {
+			drm_syncobj_put(s);
+			return -ENOMEM;
+		}
+		ret = drm_syncobj_replace_fence(s, f);
+		dma_fence_put(f);
+		drm_syncobj_put(s);
+		if (ret)
+			return ret;
+	}
+	return 0;
+}
+
+/* ---- fops dispatcher (main.c wires .unlocked_ioctl here) ---- */
+
+static long p7580_syncobj_dispatch(struct drm_device *dev, void *kdata,
+				   struct drm_file *file_priv,
+				   unsigned int nr)
+{
+	switch (nr) {
+	case P7580_SYNCOBJ_NR_CREATE:
+		return panfrost_syncobj_create(dev, kdata, file_priv);
+	case P7580_SYNCOBJ_NR_DESTROY:
+		return panfrost_syncobj_destroy(dev, kdata, file_priv);
+	case P7580_SYNCOBJ_NR_HANDLE_TO_FD:
+		return panfrost_syncobj_handle_to_fd(dev, kdata, file_priv);
+	case P7580_SYNCOBJ_NR_FD_TO_HANDLE:
+		return panfrost_syncobj_fd_to_handle(dev, kdata, file_priv);
+	case P7580_SYNCOBJ_NR_WAIT:
+		return panfrost_syncobj_wait(dev, kdata, file_priv);
+	case P7580_SYNCOBJ_NR_RESET:
+		return panfrost_syncobj_reset(dev, kdata, file_priv);
+	case P7580_SYNCOBJ_NR_SIGNAL:
+		return panfrost_syncobj_signal(dev, kdata, file_priv);
+	case P7580_DEBUG_READ_BO_NR:
+		/* DEBUG-ONLY (gpu31-gpuwrite): kernel BO word readback.
+		 * Not a syncobj number and not a driver-table number:
+		 * handled here at the fops layer only. */
+		return panfrost_debug_read_bo(dev, kdata, file_priv);
+	default:
+		return -ENOENT;	/* not a syncobj number: caller forwards */
+	}
+}
+
+/* Same copy discipline as drm_ioctl (drm_drv.c:444-490): fixed-size
+ * struct is kernel-copied; only the pointed-to handle arrays are
+ * copied in the handlers. asize>usize zero-pads (older libdrm with a
+ * shorter WAIT struct keeps working); usize>asize truncates (newer
+ * libdrm with a LONGER struct: 24 B HANDLE with point tail, 40 B WAIT
+ * with deadline_nsec -- the extra tail bytes are NOT copied in, so
+ * the handler never sees them, and the copy_to_user writes back only
+ * usize... see below). Copy-back is capped at asize (never usize):
+ * with a 24 B userspace HANDLE, blindly writing 24 B back would leak
+ * 8 B of stack past our 16 B struct into userspace. */
+static long p7580_syncobj_do(struct file *filp, unsigned int cmd,
+			     unsigned long arg)
+{
+	struct drm_file *file_priv = filp->private_data;
+	struct drm_device *dev;
+	unsigned int nr = _IOC_NR(cmd);
+	unsigned int usize = _IOC_SIZE(cmd);
+	char stack_kdata[128];
+	char *kdata = stack_kdata;
+	unsigned int asize;
+	long ret;
+
+	if (!file_priv)
+		return -EINVAL;
+	dev = file_priv->minor->dev;
+	if (!dev)
+		return -ENODEV;
+	if (drm_device_is_unplugged(dev))
+		return -ENODEV;
+	switch (nr) {
+	case P7580_SYNCOBJ_NR_CREATE:
+		asize = sizeof(struct p7580_syncobj_create);
+		break;
+	case P7580_SYNCOBJ_NR_DESTROY:
+		asize = sizeof(struct p7580_syncobj_destroy);
+		break;
+	case P7580_SYNCOBJ_NR_HANDLE_TO_FD:
+	case P7580_SYNCOBJ_NR_FD_TO_HANDLE:
+		asize = sizeof(struct p7580_syncobj_handle);
+		break;
+	case P7580_SYNCOBJ_NR_WAIT:
+		asize = sizeof(struct p7580_syncobj_wait);
+		break;
+	case P7580_SYNCOBJ_NR_RESET:
+	case P7580_SYNCOBJ_NR_SIGNAL:
+		asize = sizeof(struct p7580_syncobj_array);
+		break;
+	case P7580_DEBUG_READ_BO_NR:
+		asize = sizeof(struct p7580_debug_read_bo);
+		break;
+	default:
+		return drm_ioctl(filp, cmd, arg);
+	}
+	if (asize > sizeof(stack_kdata)) {
+		kdata = kmalloc(asize, GFP_KERNEL);
+		if (!kdata)
+			return -ENOMEM;
+	}
+	if (asize > usize)
+		memset(kdata + usize, 0, asize - usize);
+	if (cmd & IOC_IN) {
+		/* Truncate: copy at most asize (our struct); a longer
+		 * userspace struct (24 B HANDLE, 40 B WAIT) leaves its
+		 * tail in userspace, untouched. */
+		unsigned int cpin = usize < asize ? usize : asize;
+
+		if (copy_from_user(kdata, (void __user __force *)arg,
+				   cpin) != 0) {
+			ret = -EFAULT;
+			goto out;
+		}
+		if (cpin < asize)
+			memset(kdata + cpin, 0, asize - cpin);
+	} else {
+		memset(kdata, 0, asize);
+	}
+	ret = p7580_syncobj_dispatch(dev, kdata, file_priv, nr);
+	if (ret == -ENOENT)
+		ret = drm_ioctl(filp, cmd, arg);
+	else if ((cmd & IOC_OUT) && ret == 0) {
+		/* Cap the write-back at asize: never leak stack past our
+		 * struct into a longer userspace struct's tail. */
+		unsigned int cpout = usize < asize ? usize : asize;
+
+		if (copy_to_user((void __user __force *)arg, kdata,
+				 cpout) != 0)
+			ret = -EFAULT;
+	}
+out:
+	if (kdata != stack_kdata)
+		kfree(kdata);
+	return ret;
+}
+
+long panfrost_syncobj_ioctl(struct file *filp, unsigned int cmd,
+			    unsigned long arg)
+{
+	unsigned int nr = _IOC_NR(cmd);
+
+	/* Fast path: driver-private numbers never reach us with extra
+	 * work -- straight to the core. */
+	if ((nr >= DRM_COMMAND_BASE) && (nr < DRM_COMMAND_END))
+		return drm_ioctl(filp, cmd, arg);
+	return p7580_syncobj_do(filp, cmd, arg);
+}
+
+#ifdef CONFIG_COMPAT
+long panfrost_syncobj_compat_ioctl(struct file *filp, unsigned int cmd,
+				   unsigned long arg)
+{
+	/* Payload structs are width-clean (no pointers, only u32/__u64/
+	 * __s32); compat32 handling is identical. */
+	return panfrost_syncobj_ioctl(filp, cmd, arg);
+}
+#endif
diff -u -Naur a/drivers/gpu/drm/panfrost/panfrost7580_syncobj.h b/drivers/gpu/drm/panfrost/panfrost7580_syncobj.h
--- a/drivers/gpu/drm/panfrost/panfrost7580_syncobj.h
+++ b/drivers/gpu/drm/panfrost/panfrost7580_syncobj.h
@@ -0,0 +1,70 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * panfrost7580_syncobj.h - generic DRM syncobj ioctl handlers for the
+ * T720 port (Exynos 7580, Nura 3.10.108, j7elte).
+ *
+ * Why this file exists: Mesa 20.3.5 panfrost hard-asserts on
+ * drmSyncobjCreate at context creation (pan_context.c:1632-1633:
+ * "assert(!ret && ctx->syncobj)"). The stock 3.10 core has NO generic
+ * syncobj ioctls (drm.h ends at 0xBA;drm_drv.c dispatches only its own
+ * core table), so SYNCOBJ_CREATE arrived as -EINVAL. The shim backport
+ * (0003) provides the per-file handle table; this file wires the
+ * UAPI surface Mesa actually calls.
+ *
+ * UAPI source of truth: v5.2-era drm.h (Mesa 20.3.5 bundles it at
+ * include/drm-uapi/drm.h): SYNCOBJ_CREATE 0xBF, DESTROY 0xC0,
+ * HANDLE_TO_FD 0xC1, FD_TO_HANDLE 0xC2, WAIT 0xC3, RESET 0xC4,
+ * SIGNAL 0xC5. The 20.x libdrm wrappers emit exactly these numbers
+ * (disassembled, aarch64): CREATE 0xc00864bf, DESTROY 0xc00864c0,
+ * HANDLE_TO_FD 0xc01864c1, FD_TO_HANDLE 0xc01864c2, WAIT 0xc02864c3,
+ * RESET/SIGNAL 0xc01064c4/5. Payload structs are the 3.10-era
+ * (40-byte WAIT, no deadline_nsec; handle struct has fd+pad, no
+ * point field, 16 bytes).
+ *
+ * Scope (binary syncobj only, same omissions as the 0003 shim):
+ * no timeline payloads, no eventfd, no WAIT_FOR_SUBMIT/WAIT_AVAILABLE
+ * (rejected -EINVAL), no sync_file fd passing (3.10 has no
+ * sync_file.c). HANDLE_TO_FD/FD_TO_HANDLE support ONLY plain
+ * dma-fence export/import via anon_inode fd (flags==0); any
+ * *_SYNC_FILE flag is -EINVAL, unknown flags -EINVAL.
+ *
+ * File state: file_priv->driver_priv leads with struct
+ * drm_syncobj_manager (same layout contract as GEM's p7580_file_priv
+ * and the driver's p7580_drv_file: mgr first). Handlers take the
+ * manager via driver_priv + 0, so GEM's and the driver's own file
+ * states both work unchanged.
+ */
+
+#ifndef PANFROST7580_SYNCOBJ_H
+#define PANFROST7580_SYNCOBJ_H
+
+struct drm_device;
+struct drm_file;
+
+int panfrost_syncobj_create(struct drm_device *dev, void *data,
+			    struct drm_file *file_priv);
+int panfrost_syncobj_destroy(struct drm_device *dev, void *data,
+			     struct drm_file *file_priv);
+int panfrost_syncobj_handle_to_fd(struct drm_device *dev, void *data,
+				  struct drm_file *file_priv);
+int panfrost_syncobj_fd_to_handle(struct drm_device *dev, void *data,
+				  struct drm_file *file_priv);
+int panfrost_syncobj_wait(struct drm_device *dev, void *data,
+			  struct drm_file *file_priv);
+int panfrost_syncobj_reset(struct drm_device *dev, void *data,
+			   struct drm_file *file_priv);
+int panfrost_syncobj_signal(struct drm_device *dev, void *data,
+			    struct drm_file *file_priv);
+
+/* fops-level dispatcher: routes 3.10-unknown ioctl numbers (core has
+ * no SYNCOBJ rows) to the handlers above; everything else falls
+ * through to drm_ioctl. compat32 maps to the same handlers (payload
+ * structs are u32/__u64/__s32-width-clean, no pointer fields). */
+long panfrost_syncobj_ioctl(struct file *filp, unsigned int cmd,
+			    unsigned long arg);
+#ifdef CONFIG_COMPAT
+long panfrost_syncobj_compat_ioctl(struct file *filp, unsigned int cmd,
+				   unsigned long arg);
+#endif
+
+#endif /* PANFROST7580_SYNCOBJ_H */
diff -u -Naur a/drivers/gpu/drm/panfrost/panfrost_drm.h b/drivers/gpu/drm/panfrost/panfrost_drm.h
--- a/drivers/gpu/drm/panfrost/panfrost_drm.h
+++ b/drivers/gpu/drm/panfrost/panfrost_drm.h
@@ -0,0 +1,211 @@
+/* SPDX-License-Identifier: MIT */
+/*
+ * Copyright © 2014-2018 Broadcom
+ * Copyright © 2019 Collabora ltd.
+ *
+ * T720 UAPI mirror for the panfrost port. Payload structs/ioctls below are
+ * BYTE-IDENTICAL to Linux v5.2 include/uapi/drm/panfrost_drm.h
+ * (gpu31-target.md H1, verified 2026-11-19 via raw.githubusercontent.com/
+ * torvalds/linux refs/tags/v5.2 14817897): 6 ioctls SUBMIT(0x00)/
+ * WAIT_BO(0x01)/CREATE_BO(0x02)/MMAP_BO(0x03)/GET_PARAM(0x04)/
+ * GET_BO_OFFSET(0x05); GET_PARAM = DRM_PANFROST_PARAM_GPU_PROD_ID only;
+ * SUBMIT ends at requirements (no jm_ctx_handle/pad). CREATE_BO.flags
+ * reserved-zero. No JM_CTX_CREATE/DESTROY, MADVISE, perfcnt, timeline
+ * syncobj (postdate v5.2; handled Mesa-side by G31_Mesa 0005).
+ * Single-line adaptation: upstream spells the sibling include "drm.h"
+ * (resolves inside the v5.2 uapi/drm/ dir); here it is <drm/drm.h> so
+ * the file compiles against the 3.10 include/uapi layout (-I include/uapi).
+ */
+#ifndef _PANFROST_DRM_H_
+#define _PANFROST_DRM_H_
+
+#include <drm/drm.h>
+
+#if defined(__cplusplus)
+extern "C" {
+#endif
+
+#define DRM_PANFROST_SUBMIT			0x00
+#define DRM_PANFROST_WAIT_BO			0x01
+#define DRM_PANFROST_CREATE_BO			0x02
+#define DRM_PANFROST_MMAP_BO			0x03
+#define DRM_PANFROST_GET_PARAM			0x04
+#define DRM_PANFROST_GET_BO_OFFSET		0x05
+
+#define DRM_IOCTL_PANFROST_SUBMIT		DRM_IOW(DRM_COMMAND_BASE + DRM_PANFROST_SUBMIT, struct drm_panfrost_submit)
+#define DRM_IOCTL_PANFROST_WAIT_BO		DRM_IOW(DRM_COMMAND_BASE + DRM_PANFROST_WAIT_BO, struct drm_panfrost_wait_bo)
+#define DRM_IOCTL_PANFROST_CREATE_BO		DRM_IOWR(DRM_COMMAND_BASE + DRM_PANFROST_CREATE_BO, struct drm_panfrost_create_bo)
+#define DRM_IOCTL_PANFROST_MMAP_BO		DRM_IOWR(DRM_COMMAND_BASE + DRM_PANFROST_MMAP_BO, struct drm_panfrost_mmap_bo)
+#define DRM_IOCTL_PANFROST_GET_PARAM		DRM_IOWR(DRM_COMMAND_BASE + DRM_PANFROST_GET_PARAM, struct drm_panfrost_get_param)
+#define DRM_IOCTL_PANFROST_GET_BO_OFFSET	DRM_IOWR(DRM_COMMAND_BASE + DRM_PANFROST_GET_BO_OFFSET, struct drm_panfrost_get_bo_offset)
+
+#define PANFROST_JD_REQ_FS (1 << 0)
+/**
+ * struct drm_panfrost_submit - ioctl argument for submitting commands to the 3D
+ * engine.
+ *
+ * This asks the kernel to have the GPU execute a render command list.
+ */
+struct drm_panfrost_submit {
+
+	/** Address to GPU mapping of job descriptor */
+	__u64 jc;
+
+	/** An optional array of sync objects to wait on before starting this job. */
+	__u64 in_syncs;
+
+	/** Number of sync objects to wait on before starting this job. */
+	__u32 in_sync_count;
+
+	/** An optional sync object to place the completion fence in. */
+	__u32 out_sync;
+
+	/** Pointer to a u32 array of the BOs that are referenced by the job. */
+	__u64 bo_handles;
+
+	/** Number of BO handles passed in (size is that times 4). */
+	__u32 bo_handle_count;
+
+	/** A combination of PANFROST_JD_REQ_* */
+	__u32 requirements;
+};
+
+/**
+ * struct drm_panfrost_wait_bo - ioctl argument for waiting for
+ * completion of the last DRM_PANFROST_SUBMIT on a BO.
+ *
+ * This is useful for cases where multiple processes might be
+ * rendering to a BO and you want to wait for all rendering to be
+ * completed.
+ */
+struct drm_panfrost_wait_bo {
+	__u32 handle;
+	__u32 pad;
+	__s64 timeout_ns;	/* absolute */
+};
+
+/**
+ * struct drm_panfrost_create_bo - ioctl argument for creating Panfrost BOs.
+ *
+ * There are currently no values for the flags argument, but it may be
+ * used in a future extension.
+ */
+/* Valid flags for drm_panfrost_create_bo (modern uapi; 1.1 and later).
+ * PANFROST_BO_NOEXEC/HEAP are hints to the kernel: this driver always backs
+ * CREATE_BO with pre-faulted SHMEM, so they are accepted and recorded only.
+ * PANFROST_BO_WB_MMAP is accepted for ABI completeness (WC is the default
+ * mapping; the flag is a no-op here). */
+#define PANFROST_BO_NOEXEC	1
+#define PANFROST_BO_HEAP	2
+#define PANFROST_BO_WB_MMAP	4
+
+struct drm_panfrost_create_bo {
+	__u32 size;
+	__u32 flags;
+	/** Returned GEM handle for the BO. */
+	__u32 handle;
+	/* Pad, must be zero-filled. */
+	__u32 pad;
+	/**
+	 * Returned offset for the BO in the GPU address space.  This offset
+	 * is private to the DRM fd and is valid for the lifetime of the GEM
+	 * handle.
+	 *
+	 * This offset value will always be nonzero, since various HW
+	 * units treat 0 specially.
+	 */
+	__u64 offset;
+};
+
+/**
+ * struct drm_panfrost_mmap_bo - ioctl argument for mapping Panfrost BOs.
+ *
+ * This doesn't actually perform an mmap.  Instead, it returns the
+ * offset you need to use in an mmap on the DRM device node.  This
+ * means that tools like valgrind end up knowing about the mapped
+ * memory.
+ *
+ * There are currently no values for the flags argument, but it may be
+ * used in a future extension.
+ */
+struct drm_panfrost_mmap_bo {
+	/** Handle for the object being mapped. */
+	__u32 handle;
+	__u32 flags;
+	/** offset into the drm node to use for subsequent mmap call. */
+	__u64 offset;
+};
+
+/* Queryable parameters.  The order and values are the modern uapi
+ * (Mesa 26+); the first entry is the v5.2 GPU_PROD_ID so old and new
+ * userspace read the same handshake. */
+enum drm_panfrost_param {
+	DRM_PANFROST_PARAM_GPU_PROD_ID,
+	DRM_PANFROST_PARAM_GPU_REVISION,
+	DRM_PANFROST_PARAM_SHADER_PRESENT,
+	DRM_PANFROST_PARAM_TILER_PRESENT,
+	DRM_PANFROST_PARAM_L2_PRESENT,
+	DRM_PANFROST_PARAM_STACK_PRESENT,
+	DRM_PANFROST_PARAM_AS_PRESENT,
+	DRM_PANFROST_PARAM_JS_PRESENT,
+	DRM_PANFROST_PARAM_L2_FEATURES,
+	DRM_PANFROST_PARAM_CORE_FEATURES,
+	DRM_PANFROST_PARAM_TILER_FEATURES,
+	DRM_PANFROST_PARAM_MEM_FEATURES,
+	DRM_PANFROST_PARAM_MMU_FEATURES,
+	DRM_PANFROST_PARAM_THREAD_FEATURES,
+	DRM_PANFROST_PARAM_MAX_THREADS,
+	DRM_PANFROST_PARAM_THREAD_MAX_WORKGROUP_SZ,
+	DRM_PANFROST_PARAM_THREAD_MAX_BARRIER_SZ,
+	DRM_PANFROST_PARAM_COHERENCY_FEATURES,
+	DRM_PANFROST_PARAM_TEXTURE_FEATURES0,
+	DRM_PANFROST_PARAM_TEXTURE_FEATURES1,
+	DRM_PANFROST_PARAM_TEXTURE_FEATURES2,
+	DRM_PANFROST_PARAM_TEXTURE_FEATURES3,
+	DRM_PANFROST_PARAM_JS_FEATURES0,
+	DRM_PANFROST_PARAM_JS_FEATURES1,
+	DRM_PANFROST_PARAM_JS_FEATURES2,
+	DRM_PANFROST_PARAM_JS_FEATURES3,
+	DRM_PANFROST_PARAM_JS_FEATURES4,
+	DRM_PANFROST_PARAM_JS_FEATURES5,
+	DRM_PANFROST_PARAM_JS_FEATURES6,
+	DRM_PANFROST_PARAM_JS_FEATURES7,
+	DRM_PANFROST_PARAM_JS_FEATURES8,
+	DRM_PANFROST_PARAM_JS_FEATURES9,
+	DRM_PANFROST_PARAM_JS_FEATURES10,
+	DRM_PANFROST_PARAM_JS_FEATURES11,
+	DRM_PANFROST_PARAM_JS_FEATURES12,
+	DRM_PANFROST_PARAM_JS_FEATURES13,
+	DRM_PANFROST_PARAM_JS_FEATURES14,
+	DRM_PANFROST_PARAM_JS_FEATURES15,
+	DRM_PANFROST_PARAM_NR_CORE_GROUPS,
+	DRM_PANFROST_PARAM_THREAD_TLS_ALLOC,
+	DRM_PANFROST_PARAM_AFBC_FEATURES,
+	DRM_PANFROST_PARAM_SYSTEM_TIMESTAMP,
+	DRM_PANFROST_PARAM_SYSTEM_TIMESTAMP_FREQUENCY,
+	DRM_PANFROST_PARAM_ALLOWED_JM_CTX_PRIORITIES,
+	DRM_PANFROST_PARAM_SELECTED_COHERENCY,
+};
+
+struct drm_panfrost_get_param {
+	__u32 param;
+	__u32 pad;
+	__u64 value;
+};
+
+/**
+ * Returns the offset for the BO in the GPU address space for this DRM fd.
+ * This is the same value returned by drm_panfrost_create_bo, if that was called
+ * from this DRM fd.
+ */
+struct drm_panfrost_get_bo_offset {
+	__u32 handle;
+	__u32 pad;
+	__u64 offset;
+};
+
+#if defined(__cplusplus)
+}
+#endif
+
+#endif /* _PANFROST_DRM_H_ */
diff -u -Naur a/drivers/gpu/drm/panfrost/pf7580_devfreq.c b/drivers/gpu/drm/panfrost/pf7580_devfreq.c
--- a/drivers/gpu/drm/panfrost/pf7580_devfreq.c
+++ b/drivers/gpu/drm/panfrost/pf7580_devfreq.c
@@ -0,0 +1,355 @@
+/*
+ * pf7580_devfreq.c - panfrost devfreq/DVFS for Mali-T720 on 3.10.108.
+ *
+ * Follows the kbase backend shape (t7xx/r15p0/backend/gpu/
+ * mali_kbase_devfreq.c) ported onto the power slice
+ * (code/gpu31/power/: pf7580_set_rate / pf7580_set_voltage, parking
+ * dance, -EAGAIN while gated):
+ *
+ *  - init: OPP ladder (opp_add + opp_enable, ascending) -> freq_table
+ *    (ascending Hz, kmalloc_array like kbase_devfreq_init_freq_table)
+ *    -> seed boot OPP 350 MHz (PF7580_DVFS_BOOT_HZ) ->
+ *    devfreq_add_device ("simple_ondemand", NULL governor data: stock
+ *    DFSO 90/5 defaults, no PM-QoS leg) with polling_ms 100 (kbase
+ *    parity). The profile is per-instance (embedded in struct
+ *    pf7580_dvfs, like kbase's kbdev->devfreq_profile): a static shared
+ *    profile would corrupt freq_table/max_state on a second init.
+ *  - target: devfreq_recommended_opp() ceil/floor by the caller's flags
+ *    (LUB/GLB, under rcu_read_lock like kbase_devfreq_target and the MIF
+ *    bus driver), skip on no-change, then GPU_SET_CLK_VOL order (up:
+ *    V->f, down: f->V). On -EAGAIN from the power slice (clock gated /
+ *    runtime suspended) leave state untouched and propagate:
+ *    devfreq_monitor() logs it and retries next poll.
+ *  - suspend/resume: devfreq suspend/resume_device wrappers (NULL-safe)
+ *    for dev_pm_ops; power sequencing stays in the power slice.
+ *  - max clamp: devfreq max_freq (the panfrost equivalent of the kbase
+ *    TMU max-lock from thermal patch 0001), applied through
+ *    update_devfreq() exactly like the max_freq sysfs store.
+ *
+ * Lookup: this slice never touches dev drvdata (the owning DRM driver
+ * keeps it for its own struct; overwriting it would break the driver's
+ * remove path). The single G3D block is resolved through a file-static
+ * handle, the same pattern as kbase's global pkbdev
+ * (platform/exynos/gpu_notifier.c); callbacks verify dev == dvfs->dev.
+ *
+ * Concurrency: devfreq core already serialises target()/get_status()
+ * under devfreq->lock on 3.10 (update_devfreq + monitor take it); the
+ * slice mutex additionally makes the OPP lookup + two-step actuation
+ * atomic against concurrent sysfs max_freq writes that re-enter
+ * target() through a second update_devfreq().
+ */
+
+#include <linux/device.h>
+#include <linux/devfreq.h>
+#include <linux/err.h>
+#include <linux/mutex.h>
+#include <linux/opp.h>
+#include <linux/rcupdate.h>
+#include <linux/slab.h>
+
+#include "pf7580_devfreq.h"
+
+/* Power-slice actuation (code/gpu31/power/panfrost7580_power.h). The
+ * power handle is intentionally opaque here: this slice must build
+ * without pulling the whole power header into the profile path. */
+int pf7580_set_rate(void *power, unsigned long rate_hz);
+int pf7580_set_voltage(void *power, int uv);
+
+/* drivers/devfreq/devfreq.c:209 (EXPORT_SYMBOL), contract in
+ * drivers/devfreq/governor.h:29: caller must hold devfreq->lock.
+ * No public prototype on 3.10 (internal governor header only), so it
+ * is declared here for pf7580_dvfs_set_max(), which mirrors the
+ * max_freq sysfs store (devfreq.c store_max_freq). */
+extern int update_devfreq(struct devfreq *devfreq);
+
+struct pf7580_dvfs {
+	struct device *dev;
+	void *power;
+	struct devfreq *df;
+	struct devfreq_dev_profile profile; /* per-instance, not static */
+	unsigned int *ftab;	/* profile.freq_table backing */
+	struct mutex lock;	/* OPP lookup + V/f steps + counters */
+	unsigned long long busy_ns;
+	unsigned long long idle_ns;
+	unsigned long cur_hz;	/* last committed OPP */
+};
+
+/* Single G3D block on 7580: exactly one live instance. init returns
+ * -EBUSY while the handle is held. */
+static struct pf7580_dvfs *pf7580_dvfs_g;
+
+static struct pf7580_dvfs *pf7580_dvfs_get(struct device *dev)
+{
+	if (pf7580_dvfs_g && pf7580_dvfs_g->dev == dev)
+		return pf7580_dvfs_g;
+	return NULL;
+}
+
+int pf7580_dvfs_target(struct device *dev, unsigned long *freq, u32 flags)
+{
+	struct pf7580_dvfs *dvfs = pf7580_dvfs_get(dev);
+	struct opp *opp;
+	unsigned long opp_freq, opp_volt;
+	unsigned long cur;
+	int ret;
+
+	if (!dvfs || !freq)
+		return -EINVAL;
+
+	mutex_lock(&dvfs->lock);
+	opp_freq = *freq;
+	rcu_read_lock();
+	/* Flags pass through exactly like kbase_devfreq_target: plain
+	 * polls arrive with 0 (ceil to the least upper bound); the core
+	 * sets DEVFREQ_FLAG_LEAST_UPPER_BOUND when max_freq clamps the
+	 * request from above (update_devfreq, devfreq.c:188-195) and
+	 * clears it when min_freq lifts it from below. Forwarding them
+	 * (instead of forcing 0) is what makes a non-OPP max_freq ceiling
+	 * resolve down to the right OPP instead of up past it. */
+	opp = devfreq_recommended_opp(dev, &opp_freq, flags);
+	if (IS_ERR(opp)) {
+		rcu_read_unlock();
+		mutex_unlock(&dvfs->lock);
+		return PTR_ERR(opp);
+	}
+	opp_freq = opp_get_freq(opp);
+	opp_volt = opp_get_voltage(opp);
+	rcu_read_unlock();
+
+	cur = dvfs->cur_hz;
+	if (opp_freq == cur) {
+		*freq = cur;
+		mutex_unlock(&dvfs->lock);
+		return 0;
+	}
+
+	/* GPU_SET_CLK_VOL order (dvfs_api.c:20-31; kbase_devfreq_target):
+	 * scale-UP programs the voltage first then the rate (the
+	 * 534->668 step crosses the 1.00 V -> 1.10 V corner;
+	 * clock-before-voltage browns out: power report F4); scale-DOWN
+	 * programs the rate first then the voltage. */
+	if (opp_freq > cur) {
+		ret = pf7580_set_voltage(dvfs->power, (int)opp_volt);
+		if (ret) {
+			mutex_unlock(&dvfs->lock);
+			return ret;
+		}
+		ret = pf7580_set_rate(dvfs->power, opp_freq);
+	} else {
+		ret = pf7580_set_rate(dvfs->power, opp_freq);
+		if (ret) {
+			mutex_unlock(&dvfs->lock);
+			return ret;
+		}
+		ret = pf7580_set_voltage(dvfs->power, (int)opp_volt);
+	}
+	if (!ret) {
+		dvfs->cur_hz = opp_freq;
+		*freq = opp_freq;
+	}
+	mutex_unlock(&dvfs->lock);
+	return ret;
+}
+
+int pf7580_dvfs_get_status(struct device *dev,
+			   struct devfreq_dev_status *stat)
+{
+	struct pf7580_dvfs *dvfs = pf7580_dvfs_get(dev);
+
+	if (!dvfs || !stat)
+		return -EINVAL;
+	mutex_lock(&dvfs->lock);
+	stat->total_time = dvfs->busy_ns + dvfs->idle_ns;
+	stat->busy_time = dvfs->busy_ns;
+	stat->current_frequency = dvfs->cur_hz;
+	stat->private_data = NULL;
+	dvfs->busy_ns = 0;
+	dvfs->idle_ns = 0;
+	mutex_unlock(&dvfs->lock);
+	return 0;
+}
+
+int pf7580_dvfs_get_cur(struct device *dev, unsigned long *freq)
+{
+	struct pf7580_dvfs *dvfs = pf7580_dvfs_get(dev);
+
+	if (!dvfs || !freq)
+		return -EINVAL;
+	*freq = dvfs->cur_hz;
+	return 0;
+}
+
+void pf7580_dvfs_mark_busy(struct pf7580_dvfs *dvfs,
+			   unsigned long busy_ns, unsigned long idle_ns)
+{
+	if (!dvfs)
+		return;
+	mutex_lock(&dvfs->lock);
+	dvfs->busy_ns += busy_ns;
+	dvfs->idle_ns += idle_ns;
+	mutex_unlock(&dvfs->lock);
+}
+
+/* devfreq profile exit: runs inside devfreq_remove_device (kbase parity:
+ * kbase_devfreq_exit -> kbase_devfreq_term_freq_table). Frees only the
+ * table this instance allocated. */
+static void pf7580_dvfs_exit(struct device *dev)
+{
+	struct pf7580_dvfs *dvfs = pf7580_dvfs_get(dev);
+
+	if (!dvfs)
+		return;
+	kfree(dvfs->ftab);
+	dvfs->ftab = NULL;
+	dvfs->profile.freq_table = NULL;
+	dvfs->profile.max_state = 0;
+}
+
+int pf7580_dvfs_init(struct device *dev, void *power,
+		     struct pf7580_dvfs **out)
+{
+	struct pf7580_dvfs *dvfs;
+	unsigned int i;
+	int ret;
+
+	if (!dev || !power || !out)
+		return -EINVAL;
+	if (pf7580_dvfs_g)
+		return -EBUSY;
+
+	dvfs = kzalloc(sizeof(*dvfs), GFP_KERNEL);
+	if (!dvfs)
+		return -ENOMEM;
+	dvfs->dev = dev;
+	dvfs->power = power;
+	dvfs->cur_hz = PF7580_DVFS_BOOT_HZ;
+	mutex_init(&dvfs->lock);
+
+	dvfs->profile.initial_freq = PF7580_DVFS_BOOT_HZ;
+	dvfs->profile.polling_ms = PF7580_DEVFREQ_POLL_MS;
+	dvfs->profile.target = pf7580_dvfs_target;
+	dvfs->profile.get_dev_status = pf7580_dvfs_get_status;
+	dvfs->profile.get_cur_freq = pf7580_dvfs_get_cur;
+	dvfs->profile.exit = pf7580_dvfs_exit;
+
+	/* OPP ladder, ascending (opp_add keeps the list sorted; walk the
+	 * table in order so freq_table is ascending like
+	 * kbase_devfreq_init_freq_table). opp_add makes entries available
+	 * by default; the explicit opp_enable() pins that (no-op on 3.10
+	 * for fresh entries, but documents intent and survives a
+	 * disable-all elsewhere). */
+	for (i = 0; i < PF7580_DVFS_OPP_COUNT; i++) {
+		ret = opp_add(dev, pf7580_dvfs_opps[i].freq_hz,
+			      pf7580_dvfs_opps[i].volt_uv);
+		if (ret)
+			goto err_free;
+		ret = opp_enable(dev, pf7580_dvfs_opps[i].freq_hz);
+		if (ret)
+			goto err_free;
+	}
+
+	/* Governor statistics table: ascending Hz copy (unsigned int,
+	 * matching struct devfreq_dev_profile.freq_table on 3.10). */
+	dvfs->ftab = kmalloc_array(PF7580_DVFS_OPP_COUNT, sizeof(dvfs->ftab[0]),
+				  GFP_KERNEL);
+	if (!dvfs->ftab) {
+		ret = -ENOMEM;
+		goto err_free;
+	}
+	for (i = 0; i < PF7580_DVFS_OPP_COUNT; i++)
+		dvfs->ftab[i] = (unsigned int)pf7580_dvfs_opps[i].freq_hz;
+	dvfs->profile.freq_table = dvfs->ftab;
+	dvfs->profile.max_state = PF7580_DVFS_OPP_COUNT;
+
+	/* Publish before the poller can see us: the governor START event
+	 * inside devfreq_add_device queues the first poll. */
+	pf7580_dvfs_g = dvfs;
+	dvfs->df = devfreq_add_device(dev, &dvfs->profile,
+				      PF7580_DEVFREQ_GOVERNOR, NULL);
+	if (IS_ERR(dvfs->df)) {
+		ret = PTR_ERR(dvfs->df);
+		dvfs->df = NULL;
+		pf7580_dvfs_g = NULL;
+		goto err_tab;
+	}
+
+	*out = dvfs;
+	return 0;
+
+err_tab:
+	kfree(dvfs->ftab);
+	dvfs->profile.freq_table = NULL;
+	dvfs->profile.max_state = 0;
+err_free:
+	kfree(dvfs);
+	return ret;
+}
+
+void pf7580_dvfs_fini(struct pf7580_dvfs *dvfs)
+{
+	if (!dvfs)
+		return;
+	if (dvfs->df)
+		devfreq_remove_device(dvfs->df);
+	/* profile->exit ran inside remove and freed the table copy. */
+	if (pf7580_dvfs_g == dvfs)
+		pf7580_dvfs_g = NULL;
+	kfree(dvfs);
+}
+
+int pf7580_dvfs_suspend(struct pf7580_dvfs *dvfs)
+{
+	/* NULL-safe like kbase (CONFIG_MALI_DEVFREQ unset path):
+	 * devfreq_suspend_device(NULL) is -EINVAL; sleep must not fail
+	 * for a missing DVFS handle. */
+	if (!dvfs)
+		return 0;
+	return devfreq_suspend_device(dvfs->df);
+}
+
+int pf7580_dvfs_resume(struct pf7580_dvfs *dvfs)
+{
+	if (!dvfs)
+		return 0;
+	return devfreq_resume_device(dvfs->df);
+}
+
+int pf7580_dvfs_set_max(struct pf7580_dvfs *dvfs, unsigned long max_hz)
+{
+	struct devfreq *df;
+	unsigned long eff = max_hz;
+	struct opp *opp;
+	int ret;
+
+	if (!dvfs || !dvfs->dev)
+		return -ENODEV;
+	df = dvfs->df;
+	if (!df)
+		return -ENODEV;
+
+	/* Resolve non-OPP ceilings by ceil (recommended-OPP semantics);
+	 * 0 releases the clamp. */
+	if (eff) {
+		rcu_read_lock();
+		opp = devfreq_recommended_opp(dvfs->dev, &eff, 0);
+		if (IS_ERR(opp)) {
+			rcu_read_unlock();
+			return PTR_ERR(opp);
+		}
+		eff = opp_get_freq(opp);
+		rcu_read_unlock();
+	}
+
+	/* Same sequence as the max_freq sysfs store (devfreq.c
+	 * store_max_freq): hold devfreq->lock across the clamp write and
+	 * the re-evaluation so a concurrent poll cannot slip a target()
+	 * in between. update_devfreq() routes through the governor (the
+	 * core sets LUB when the clamp bites) into pf7580_dvfs_target(),
+	 * which applies the f-before-V down-step. -EAGAIN (gated /
+	 * suspended) just leaves the clamp armed for the next poll. */
+	mutex_lock(&df->lock);
+	df->max_freq = eff;
+	ret = update_devfreq(df);
+	mutex_unlock(&df->lock);
+	return ret;
+}
diff -u -Naur a/drivers/gpu/drm/panfrost/pf7580_devfreq.h b/drivers/gpu/drm/panfrost/pf7580_devfreq.h
--- a/drivers/gpu/drm/panfrost/pf7580_devfreq.h
+++ b/drivers/gpu/drm/panfrost/pf7580_devfreq.h
@@ -0,0 +1,251 @@
+/*
+ * pf7580_devfreq.h - panfrost devfreq/DVFS for Mali-T720 (Exynos 7580,
+ *                     j7elte) on the 3.10.108 vendor tree.
+ *
+ * Provenance (all read from the shared tree, never modified):
+ *  - OPP rows (freq MHz, voltage uV): the stock kbase table
+ *    gpu_dvfs_table_default[] in
+ *    drivers/gpu/arm/t7xx/r15p0/platform/exynos/gpu_exynos7580.c:46-55
+ *    (8 rows: 800/734/668/534/440/350/266/160 MHz at
+ *    1100/1100/1100/1000/1000/1000/900/900 mV).
+ *  - target() voltage/clock order (GPU_SET_CLK_VOL, up: V then f,
+ *    down: f then V): drivers/gpu/arm/r15p0/backend/gpu/
+ *    mali_kbase_devfreq.c kbase_devfreq_target(); same order in
+ *    platform/exynos/gpu_dvfs_api.c:27-38.
+ *  - OPP API (opp_add/opp_enable/opp_find_freq_ceil/opp_get_freq/
+ *    opp_get_voltage, RCU read side): include/linux/opp.h:30-49 +
+ *    drivers/base/power/opp.c:257-440 (freq in Hz, voltage in uV).
+ *  - devfreq core (devfreq_add_device(dev, profile, "simple_ondemand",
+ *    NULL), devfreq_recommended_opp, devfreq_suspend/resume_device,
+ *    freq_table/max_state accounting): include/linux/devfreq.h:89-171,
+ *    drivers/devfreq/devfreq.c:150-240/540-577 (3.10.108 vendor copy).
+ *  - Governor: drivers/devfreq/governor_simpleondemand.c
+ *    (DFSO_UPTHRESHOLD 90 / DFSO_DOWNDIFFERENCTIAL 5 / DFSO_WEIGHT 100;
+ *    NULL governor data is legal: defaults apply, no PM-QoS leg).
+ *    CONFIG_DEVFREQ_GOV_SIMPLE_ONDEMAND=y in the vendor .config.
+ *    kbase likewise passes NULL governor data
+ *    (mali_kbase_devfreq.c kbase_devfreq_init: devfreq_add_device(...,
+ *    "simple_ondemand", NULL)) with polling_ms 100.
+ *  - Clock/voltage actuation: code/gpu31/power/panfrost7580_power.h
+ *    (pf7580_set_rate / pf7580_set_voltage; parking dance, -EAGAIN
+ *    while gated, boot 50 ms autosuspend).
+ *  - Thermal max-lock path this plugs under:
+ *    code/gpu31/thermal/patches/0001-gpu-cdev-state-to-tmu-maxlock.patch
+ *    (cdev state -> TMU lock -> gpu_dvfs_clock_lock(TMU_LOCK)) and
+ *    gpu31-thermal.md (live 5-level ASV table 668..266, max_state 5,
+ *    "thermal-gpufreq-0"). No CONFIG_DEVFREQ_THERMAL/of_devfreq_cooling
+ *    on this tree (thermal report section 1), so the max clamp is the
+ *    devfreq max_freq knob / TMU max-lock, not a cooling device.
+ *
+ * Relationship to the sibling GEM-slice draft
+ * (code/gpu31/gem/panfrost7580_devfreq.[ch], G31_Gem2): that file is a
+ * GEM-internal hook sketch owned by the GEM slice. This header + its
+ * companion .c are the standalone DVFS slice for the integrator: full
+ * OPP ladder registration, governor profile, suspend/idle behaviour,
+ * and thermal max-lock interaction, with a host logic test. The two
+ * overlap by design (same table, same order rule); dedup at land time
+ * keeps one canonical copy (Main/Integrator call). This slice never
+ * edits the GEM file.
+ * Wiring for the owning DRM driver (integrator):
+ *
+ *	struct my_drv { struct pf7580_power *pwr; struct pf7580_dvfs *dvfs; };
+ *
+ *	probe:  pf7580_power_probe(...) -> pf7580_dvfs_init(dev, pwr, &dvfs)
+ *	        (pins boot OPP 350 MHz first, then enables polling);
+ *	remove: pf7580_dvfs_fini(dvfs) then pf7580_power_remove(pwr);
+ *	pm:     suspend: pf7580_dvfs_suspend(dvfs);
+ *	        resume:  pf7580_dvfs_resume(dvfs);
+ *	job:    on submit fence / retired fence, call
+ *	        pf7580_dvfs_mark_busy(dvfs, busy_ns_delta, idle_ns_delta)
+ *	        (the get_dev_status hook drains these accumulators).
+ * Locking: a single slice-local handle serialises OPP lookup +
+ * voltage/clock steps (mirrors the kbase target() no-concurrency
+ * assumption: devfreq core already holds devfreq->lock across
+ * get_target_freq/target on this tree; update_devfreq documents that
+ * its caller must hold it).
+ *
+ * Lookup: the slice never touches dev drvdata (the owning DRM driver
+ * keeps it for its own struct). The single G3D block is resolved
+ * through a file-static handle, the same pattern as kbase's global
+ * pkbdev (gpu_notifier.c); callbacks verify dev == dvfs->dev.
+ */
+
+#ifndef PF7580_DEVFREQ_H
+#define PF7580_DEVFREQ_H
+
+#ifdef __KERNEL__
+#include <linux/device.h>
+#include <linux/devfreq.h>
+#else
+/* Host test build: forward declarations only (no kernel types). */
+struct device;
+struct devfreq_dev_status;
+typedef unsigned int u32;
+#endif
+
+
+/* OPP ladder: 8 stock rows, ascending for the freq_table walk.
+ * { clock Hz, voltage uV }. Source: gpu_exynos7580.c
+ * gpu_dvfs_table_default[] (MHz/mV), converted verbatim to Hz/uV.
+ * opp_add() takes Hz (opp.c:389-396 "@freq: Frequency in Hz"); the
+ * 3.10 MIF bus driver likewise stores opp_get_freq results
+ * (Hz-scale) straight into its freq_table.
+ *
+ * Naming: the ladder symbols carry a dvfs_ infix on purpose. The
+ * power header (code/gpu31/power/panfrost7580_power.h) already owns
+ * a TU-local `struct pf7580_opp { int mhz; int uv; }` ladder and the
+ * firmware header owns `struct pf7580_opp { freq_hz; volt_uv }` plus
+ * an extern table; reusing that tag/table name here would break any
+ * driver TU that includes both headers (probe needs both). Shapes
+ * stay identical on purpose; only the names are namespaced. */
+struct pf7580_dvfs_opp {
+	unsigned long freq_hz;
+	unsigned long volt_uv;
+};
+
+#define PF7580_DVFS_BOOT_HZ	350000000UL
+
+static const struct pf7580_dvfs_opp pf7580_dvfs_opps[] = {
+	{ 160000000UL,  900000UL },
+	{ 266000000UL,  900000UL },
+	{ 350000000UL, 1000000UL },
+	{ 440000000UL, 1000000UL },
+	{ 534000000UL, 1000000UL },
+	{ 668000000UL, 1100000UL },
+	{ 734000000UL, 1100000UL },
+	{ 800000000UL, 1100000UL },
+};
+
+#define PF7580_DVFS_OPP_COUNT \
+	(sizeof(pf7580_dvfs_opps) / sizeof(pf7580_dvfs_opps[0]))
+
+/* Governor tuning: kbase parity.
+ * kbase backend uses "simple_ondemand" + NULL governor data with
+ * polling_ms 100 (mali_kbase_devfreq.c). Tunables below are only what
+ * we pass: the drain-side table/poll seed. DFSO_UPTHRESHOLD=90 /
+ * DFSO_DOWNDIFFERENCTIAL=5 apply inside the governor (defaults, data
+ * NULL), matching kbase behaviour of shipping stock governor knobs. */
+#define PF7580_DEVFREQ_GOVERNOR	"simple_ondemand"
+#define PF7580_DEVFREQ_POLL_MS	100
+
+/* --- Pure host-testable helpers (no kernel types) --- */
+/* Ceil an arbitrary request to the OPP ladder (recommended-OPP
+ * semantics: least OPP >= request; requests above the top clamp to
+ * the top OPP; request 0 yields the floor). Returns index 0..7. */
+static inline int pf7580_dvfs_opp_ceil_idx(unsigned long req_hz)
+{
+	int i;
+	for (i = 0; i < (int)PF7580_DVFS_OPP_COUNT; i++) {
+		if (pf7580_dvfs_opps[i].freq_hz >= req_hz)
+			return i;
+	}
+	return (int)PF7580_DVFS_OPP_COUNT - 1;
+}
+
+/* Voltage step direction for a transition cur -> want.
+ * Returns +1 (V before f), -1 (f before V), 0 (no voltage change or
+ * no-op). Encodes the GPU_SET_CLK_VOL rule for the host test. */
+static inline int pf7580_dvfs_volt_first(unsigned long cur_hz,
+				    unsigned long want_hz)
+{
+	unsigned long cur_v, want_v;
+	int ci = pf7580_dvfs_opp_ceil_idx(cur_hz);
+	int wi = pf7580_dvfs_opp_ceil_idx(want_hz);
+	if (pf7580_dvfs_opps[ci].freq_hz == pf7580_dvfs_opps[wi].freq_hz)
+		return 0;
+	cur_v = pf7580_dvfs_opps[ci].volt_uv;
+	want_v = pf7580_dvfs_opps[wi].volt_uv;
+	if (want_v == cur_v)
+		return 0;
+	return (want_v > cur_v) ? 1 : -1;
+}
+
+
+struct pf7580_dvfs;
+
+/*
+ * Register the 8 OPPs (opp_add + opp_enable, ascending), build the
+ * per-instance profile freq_table (ascending Hz), seed the boot OPP,
+ * and attach devfreq with PF7580_DEVFREQ_GOVERNOR. power is the
+ * code/gpu31/power/ pf7580_power handle (opaque here to avoid a
+ * cross-include). The owning driver's dev drvdata is left alone (the
+ * instance is found through a file-static handle). Returns 0 with *out
+ * filled, -EBUSY if an instance already lives, negative errno.
+ */
+int pf7580_dvfs_init(struct device *dev, void *power,
+		     struct pf7580_dvfs **out);
+
+/* Detach devfreq (devfreq_remove_device runs profile->exit, which frees
+ * the freq_table copy) and free the instance. Leaves OPP entries
+ * registered (opp table is device-lifetime on 3.10: no opp_remove
+ * export used by any in-tree devfreq driver). */
+void pf7580_dvfs_fini(struct pf7580_dvfs *dvfs);
+
+/*
+ * devfreq profile callbacks (wired into devfreq_dev_profile by init;
+ * exported for the host test + integrator assertions):
+ *  - target: resolve *freq through devfreq_recommended_opp()
+ *    (ceil to OPP, LUB/GLB by flags), then step voltage+clock in
+ *    GPU_SET_CLK_VOL order (up: V->f; down: f->V) via
+ *    pf7580_set_voltage/pf7580_set_rate.
+ *  - get_status: report busy/total/current and drain counters.
+ *  - get_cur: report the last committed OPP.
+ */
+int pf7580_dvfs_target(struct device *dev, unsigned long *freq, u32 flags);
+int pf7580_dvfs_get_status(struct device *dev,
+			   struct devfreq_dev_status *stat);
+int pf7580_dvfs_get_cur(struct device *dev, unsigned long *freq);
+
+/* Feed one completed window (ns) into the load accumulators the
+ * get_status hook drains. The jobs slice calls this on job retire
+ * (busy = GPU-active ns) and on idle gaps (idle = wall ns); both may
+ * be 0 (poll-only quanta still reset the governor baseline). */
+void pf7580_dvfs_mark_busy(struct pf7580_dvfs *dvfs,
+			   unsigned long busy_ns, unsigned long idle_ns);
+
+/*
+ * Suspend/resume pair for dev_pm_ops (mirrors kbase NULL-safety:
+ * devfreq_suspend_device(NULL) returns -EINVAL; our wrapper treats a
+ * NULL dvfs as a no-op 0 so system sleep never fails for lack of a
+ * DVFS handle):
+ *  - suspend: devfreq_suspend_device() (monitor stop) so polling does
+ *    not re-rate while the runtime PM path gates aclk_g3d; call BEFORE
+ *    the runtime-suspend leg (clock must still be on for the final
+ *    readback-free stop).
+ *  - resume: devfreq_resume_device() (monitor restart); call AFTER the
+ *    runtime-resume leg (clock + reset + cores back first, so the
+ *    resumed poller's first target() sees -EAGAIN-free hardware).
+ * Idle: no hook. Runtime autosuspend (50 ms, power slice) already
+ * parks the rail at the boot OPP clock-off; devfreq polling at 100 ms
+ * only fires while the device is runtime-resumed (monitor work holds
+ * no PM ref; when suspended, target() short-circuits -EAGAIN and the
+ * core logs once per poll at most).
+ */
+int pf7580_dvfs_suspend(struct pf7580_dvfs *dvfs);
+int pf7580_dvfs_resume(struct pf7580_dvfs *dvfs);
+
+/*
+ * Thermal max-lock interaction (no devfreq cooling device on this
+ * tree: CONFIG_DEVFREQ_THERMAL is unset, so of_devfreq_cooling is
+ * absent and the kbase path is gpu_dvfs_clock_lock(TMU_LOCK), not a
+ * devfreq notifier):
+ *  - On the kbase tree the 0001 thermal patch turns cdev state into
+ *    TMU max locks inside gpu_notifier; on the panfrost tree the same
+ *    effect is devfreq max_freq: clamp dvfs->df->max_freq to the
+ *    allowed ceiling and let update_devfreq() apply it on the next
+ *    poll (devfreq.c:192-195: freq = min(freq, max_freq) with LUB).
+ *  - pf7580_dvfs_set_max() applies that clamp immediately (and drops
+ *    to it now if we sit above it, via update_devfreq-equivalent
+ *    target()). max_hz==0 releases the clamp. Frequencies not on the
+ *    OPP ladder resolve by ceil (devfreq_recommended_opp semantics).
+ *  - The live ASV table on this unit is the 5-level variant
+ *    {668,534,440,350,266} (gpu31-thermal.md section 1); clamp values
+ *    above the live ceiling fail closed in kbase
+ *    (gpu_dvfs_get_level "max lock error") and resolve to the top OPP
+ *    here. Integrator note: align the TMU clamp table with the live
+ *    ASV table (thermal patch 0002 follow-up) before relying on
+ *    sub-668 ceilings.
+ */
+int pf7580_dvfs_set_max(struct pf7580_dvfs *dvfs, unsigned long max_hz);
+
+#endif /* PF7580_DEVFREQ_H */
diff -u -Naur a/drivers/iommu/exynos-iovmm-v6.c b/drivers/iommu/exynos-iovmm-v6.c
--- a/drivers/iommu/exynos-iovmm-v6.c
+++ b/drivers/iommu/exynos-iovmm-v6.c
@@ -13,6 +13,7 @@
