diff -u -Naur a/include/drm/drm_modeset_lock.h b/include/drm/drm_modeset_lock.h
--- a/include/drm/drm_modeset_lock.h
+++ b/include/drm/drm_modeset_lock.h
@@ -0,0 +1,142 @@
+/*
