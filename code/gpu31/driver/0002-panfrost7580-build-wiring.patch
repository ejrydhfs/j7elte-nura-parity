diff -u '--exclude=.git' -Naur a2/drivers/gpu/drm/Makefile b2/drivers/gpu/drm/Makefile
--- a2/drivers/gpu/drm/Makefile	2026-11-19 10:48:44.346196454 -0500
+++ b2/drivers/gpu/drm/Makefile	2026-11-19 10:48:44.349560124 -0500
@@ -53,3 +53,5 @@
 obj-$(CONFIG_DRM_TILCDC)	+= tilcdc/
