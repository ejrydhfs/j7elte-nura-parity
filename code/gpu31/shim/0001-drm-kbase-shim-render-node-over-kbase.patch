diff --git a/drivers/gpu/drm/kbase-shim/kbase_shim.c b/drivers/gpu/drm/kbase-shim/kbase_shim.c
new file mode 100644
index 0000000..5555555 100644
--- /dev/null
+++ b/drivers/gpu/drm/kbase-shim/kbase_shim.c
@@ -0,0 +1,407 @@
+/*
+ * kbase_shim.c - optional H2 render node backed by kbase UK 10.6 (revised).
+ *
+ * One render node, no display pipe.  The DRM core owns the open file
+ * (filp->private_data = struct drm_file, installed by drm_open_helper);
+ * the kbase context (kctx) is created alongside it and stored in
+ * priv->driver_priv.  Every file operation that must reach kbase swaps
+ * filp->private_data to the kctx for the duration of the kbase call and
+ * restores the drm_file afterwards -- kbase_open/release/ioctl/read/poll/
+ * mmap all take ONLY filp->private_data (as the kctx) plus the raw
+ * (cmd, arg) / (vma); none of them touch drm state.
+ *
+ * Why the swap, not two files or a stacked open: drm_stub_open() swaps
+ * filp->f_op to driver->fops and calls its ->open(); the DRM dispatcher
+ * (drm_ioctl) and drm_release() then read filp->private_data as a
+ * struct drm_file unconditionally.  Calling kbase_open() inside the DRM
+ * .open hook would clobber private_data with the kctx and leave the
+ * drm_file unreachable (release would misread the kctx as a drm_file).
+ * The swap keeps exactly one owner per layer with zero DRM core or kbase
+ * duplication: open creates both states, release destroys both (kbase
+ * first, then the stock drm_release body), ioctl/mmap/read/poll forward
+ * with the kctx installed.
+ *
+ * Concurrency: the swap is per-file (filp), and ioctl/mmap/read/poll on
+ * one fd are serialized by the caller holding the fd; two threads sharing
+ * one fd race in the kernel exactly as they would on /dev/mali0 (kbase
+ * takes its own locks per context).  No new locking is introduced.
+ */
+
+#include <linux/module.h>
+#include <linux/platform_device.h>
+#include <linux/slab.h>
+
+#include <drm/drmP.h>
+
+/* kbase entry points (drivers/gpu/arm/t7xx/r15p0, all EXPORT_SYMBOL): */
+extern struct kbase_context *kbase_create_context(struct kbase_device *kbdev,
+						  bool is_compat);
+extern void kbase_destroy_context(struct kbase_context *kctx);
+extern struct kbase_device *kbase_find_device(int minor);
+extern void kbase_release_device(struct kbase_device *kbdev);
+extern long kbase_ioctl(struct file *filp, unsigned int cmd,
+			unsigned long arg);
+extern int kbase_mmap(struct file *file, struct vm_area_struct *vma);
+extern ssize_t kbase_read(struct file *filp, char __user *buf, size_t count,
+			  loff_t *f_pos);
+extern unsigned int kbase_poll(struct file *filp, poll_table *wait);
+
+/* Forward declaration: the kctx type is private to kbase; the shim only
+ * stores the pointer opaquely (never dereferences it). */
+struct kbase_context;
+
+struct kbase_shim_dev {
+	struct drm_device *dev;
+	struct platform_device *pdev;
+	struct kbase_device *kbdev;
+};
+
+static struct kbase_shim_dev *shim;
+
+/* Render node only: every KMS number fails loudly here, never reaching
+ * display hardware.  KMS numbers on 3.10 are the core range below
+ * DRM_COMMAND_BASE (0x40); driver ioctls live at 0x40..0xA0.  The kbase UK
+ * ioctl is NOT a DRM ioctl number at all (kbase_ioctl ignores type/nr and
+ * dispatches on the in-buffer id), so it never collides with this test. */
+#define KBASE_SHIM_KMS_END DRM_COMMAND_BASE
+
+static int kbase_shim_kms_number(unsigned int nr)
+{
+	return nr < KBASE_SHIM_KMS_END;
+}
+
+/* Swap helpers: install the kctx, call kbase, restore the drm_file. */
+#define KBASE_SHIM_SWAP_IN(filp, priv)					\
+	struct drm_file *__drm_priv = (struct drm_file *)(filp)->private_data; \
+	(filp)->private_data = (priv)->driver_priv
+
+#define KBASE_SHIM_SWAP_OUT(filp)					\
+	(filp)->private_data = __drm_priv
+
+/* DRM .open: drm_open_helper() already installed the drm_file in
+ * filp->private_data and ran drm_gem_open + prime init.  Create the kbase
+ * context the same way kbase_open() does (find device, create context),
+ * store it in priv->driver_priv.  First opener also becomes render-minor
+ * master via the stock helper path (authenticated, never modeset master:
+ * no KMS ioctls exist on this node to abuse it with). */
+static int kbase_shim_open(struct drm_device *dev, struct drm_file *priv)
+{
+	struct kbase_context *kctx;
+
+	if (!shim || !shim->kbdev)
+		return -ENODEV;
+
+	/* Mirrors kbase_open(): one context per open file.  is_compat follows
+	 * the caller (32-bit Mesa on CONFIG_COMPAT gets a compat context). */
+	kctx = kbase_create_context(shim->kbdev,
+				    is_compat_task());
+	if (!kctx)
+		return -ENOMEM;
+
+	priv->driver_priv = kctx;
+	(void)dev;
+	return 0;
+}
+
+static void kbase_shim_preclose(struct drm_device *dev, struct drm_file *priv)
+{
+	/* Nothing to tear down here: the kctx dies in release().  GEM/PRIME
+	 * per-file state is torn down by drm_release() after this hook. */
+	(void)dev;
+	(void)priv;
+}
+
+static void kbase_shim_postclose(struct drm_device *dev, struct drm_file *priv)
+{
+	/* kctx already destroyed in release; drop our reference. */
+	priv->driver_priv = NULL;
+	(void)dev;
+}
+
+/* DRM .release runs FIRST in our fops wrapper (see below): destroy the
+ * kctx with kbase's own destructor while the drm_file is still intact,
+ * then fall through to the stock drm_release() body.  Implemented by
+ * swapping private_data around kbase_destroy_context() + release_device.
+ * (kbase_release() itself is inode-based teardown + destroy; the
+ * destroy + put pair below is exactly its tail half, minus the debugfs
+ * list walk that needs the inode -- see kbase_core_linux.c:kbase_release;
+ * the kctx_list element is removed by kbase_destroy_context path.) */
+static int kbase_shim_release(struct inode *inode, struct file *filp)
+{
+	struct drm_file *priv = filp->private_data;
+	struct kbase_context *kctx;
+
+	(void)inode;
+	if (priv)
+		kctx = priv->driver_priv;
+	else
+		kctx = NULL;
+	if (kctx) {
+		/* Keep the kctx alive across the swap: destroy takes it. */
+		priv->driver_priv = NULL;
+		filp->private_data = kctx;
+		kbase_destroy_context(kctx);
+		kbase_release_device(shim->kbdev);
+		filp->private_data = priv;
+	}
+	return drm_release(inode, filp);
+}
+
+/* ioctl: VERSION is served from the DRM table (node identification);
+ * every other number arrives via .dma_ioctl below.  KMS numbers are
+ * refused; UK calls are forwarded to kbase_ioctl() with the kctx swapped
+ * in (kbase_ioctl reads ONLY filp->private_data as the kctx, plus
+ * _IOC_SIZE(cmd) -- it never touches drm state). */
+static int kbase_shim_dma_ioctl(struct drm_device *dev, void *data,
+				struct drm_file *priv)
+{
+	struct file *filp = priv->filp;
+	unsigned int cmd;
+	unsigned long arg;
+	long ret;
+
+	/* .dma_ioctl receives the already-copied kdata buffer, NOT the raw
+	 * (cmd, arg) -- it cannot forward UK calls (which need the user
+	 * pointer).  UK ioctls therefore NEVER route through here: the fops
+	 * wrapper (kbase_shim_ioctl) intercepts them first.  Reaching here
+	 * means a real DRM_IOCTL_DMA number, which this node does not
+	 * implement. */
+	(void)dev;
+	(void)data;
+	(void)filp;
+	(void)cmd;
+	(void)arg;
+	(void)ret;
+	return -EINVAL;
+}
+
+/* fops-level ioctl wrapper: the single dispatch point.  VERSION goes to
+ * the DRM dispatcher (table lookup + AUTH/MASTER checks); KMS numbers
+ * fail; everything else is a UK call forwarded to kbase_ioctl() with the
+ * kctx installed.  compat_ioctl shares the wrapper (kbase handles compat
+ * via is_compat_task, same as /dev/mali0). */
+static long kbase_shim_ioctl(struct file *filp, unsigned int cmd,
+			     unsigned long arg)
+{
+	struct drm_file *priv = filp->private_data;
+	struct kbase_context *kctx;
+	unsigned int nr = _IOC_NR(cmd);
+	long ret;
+
+	if (!priv || !priv->driver_priv)
+		return -ENODEV;
+	if (kbase_shim_kms_number(nr))
+		return -EINVAL;
+
+	/* VERSION (nr 0) is a real DRM core ioctl: serve it through the
+	 * dispatcher so libdrm/render-node-probe identification works. */
+	if (nr == DRM_IOCTL_NR(DRM_IOCTL_VERSION))
+		return drm_ioctl(filp, cmd, arg);
+
+	kctx = priv->driver_priv;
+	KBASE_SHIM_SWAP_IN(filp, priv);
+	ret = kbase_ioctl(filp, cmd, arg);
+	KBASE_SHIM_SWAP_OUT(filp);
+	(void)kctx;
+	return ret;
+}
+
+static ssize_t kbase_shim_read(struct file *filp, char __user *buf,
+			       size_t count, loff_t *f_pos)
+{
+	struct drm_file *priv = filp->private_data;
+	ssize_t ret;
+
+	if (!priv || !priv->driver_priv)
+		return -ENODEV;
+	KBASE_SHIM_SWAP_IN(filp, priv);
+	ret = kbase_read(filp, buf, count, f_pos);
+	KBASE_SHIM_SWAP_OUT(filp);
+	return ret;
+}
+
+static unsigned int kbase_shim_poll(struct file *filp, poll_table *wait)
+{
+	struct drm_file *priv = filp->private_data;
+	unsigned int ret;
+
+	if (!priv || !priv->driver_priv)
+		return POLLERR;
+	KBASE_SHIM_SWAP_IN(filp, priv);
+	ret = kbase_poll(filp, wait);
+	KBASE_SHIM_SWAP_OUT(filp);
+	return ret;
+}
+
+/* mmap: kbase SAME_VA cookies (BASE_MEM_COOKIE_BASE + n*PAGE, 0x40000-range)
+ * vs GEM fake offsets (>= DRM_FILE_PAGE_OFFSET_START, 0x100000+ on 32-bit):
+ * disjoint ranges, and this driver creates no GEM objects, so no
+ * drm_mmap_locked lookup can succeed -- forward unconditionally. */
+static int kbase_shim_mmap(struct file *filp, struct vm_area_struct *vma)
+{
+	struct drm_file *priv = filp->private_data;
+	int ret;
+
+	if (!priv || !priv->driver_priv)
+		return -ENODEV;
+	KBASE_SHIM_SWAP_IN(filp, priv);
+	ret = kbase_mmap(filp, vma);
+	KBASE_SHIM_SWAP_OUT(filp);
+	return ret;
+}
+
+static const struct file_operations kbase_shim_fops = {
+	.owner = THIS_MODULE,
+	.open = drm_open,
+	.read = kbase_shim_read,
+	.poll = kbase_shim_poll,
+	.mmap = kbase_shim_mmap,
+	.unlocked_ioctl = kbase_shim_ioctl,
+#ifdef CONFIG_COMPAT
+	.compat_ioctl = kbase_shim_ioctl,
+#endif
+	.release = kbase_shim_release,
+};
+
+/* Only VERSION is served through the DRM table (node identification).
+ * All UK calls go through kbase_shim_ioctl above, never this table. */
+static const struct drm_ioctl_desc kbase_shim_ioctls[] = {
+	DRM_IOCTL_DEF(DRM_IOCTL_VERSION, drm_version, DRM_UNLOCKED),
+};
+
+static struct drm_driver kbase_shim_driver = {
+	/* No DRIVER_MODESET: no control/legacy minors, no CRTC/encoder. */
+	.driver_features = DRIVER_GEM,
+	.open = kbase_shim_open,
+	.preclose = kbase_shim_preclose,
+	.postclose = kbase_shim_postclose,
+	.dma_ioctl = kbase_shim_dma_ioctl,
+	.ioctls = (struct drm_ioctl_desc *)kbase_shim_ioctls,
+	.num_ioctls = ARRAY_SIZE(kbase_shim_ioctls),
+	.fops = (struct file_operations *)&kbase_shim_fops,
+	.name = "kbase-shim",
+	.desc = "kbase UK 10.6 render node (H2, optional)",
+	.date = "20261119",
+	.major = 1,
+	.minor = 0,
+	.patchlevel = 0,
+};
+
+static int kbase_shim_probe(struct platform_device *pdev)
+{
+	struct kbase_shim_dev *sdev;
+	struct drm_device *dev;
+	int ret;
+
+	sdev = kzalloc(sizeof(*sdev), GFP_KERNEL);
+	if (!sdev)
+		return -ENOMEM;
+
+	dev = kzalloc(sizeof(*dev), GFP_KERNEL);
+	if (!dev) {
+		kfree(sdev);
+		return -ENOMEM;
+	}
+
+	dev->platformdev = pdev;
+	dev->dev = &pdev->dev;
+	platform_set_drvdata(pdev, sdev);
+	sdev->dev = dev;
+
+	/* Render minor only (128..383 carve-out; first free = 128). */
+	ret = drm_get_minor(dev, &dev->render, DRM_MINOR_RENDER);
+	if (ret)
+		goto err_free_dev;
+
+	/* File list + GEM init; load() is NULL so no display HW is touched.
+	 * No primary/control minors (no DRIVER_MODESET): render-only by
+	 * construction. */
+	ret = drm_fill_in_dev(dev, NULL, &kbase_shim_driver);
+	if (ret)
+		goto err_minor;
+
+	/* Hold the kbase device the way kbase_open() does (find + get). */
+	sdev->kbdev = kbase_find_device(-1);
+	if (!sdev->kbdev) {
+		ret = -ENODEV;
+		goto err_fill;
+	}
+
+	if (shim) {
+		kbase_release_device(sdev->kbdev);
+		ret = -EBUSY;
+		goto err_fill;
+	}
+	shim = sdev;
+	return 0;
+
+err_fill:
+	drm_put_dev(dev);
+	goto err_sdev;
+err_minor:
+	drm_put_minor(&dev->render);
+err_free_dev:
+	kfree(dev);
+err_sdev:
+	kfree(sdev);
+	return ret;
+}
+
+static int kbase_shim_remove(struct platform_device *pdev)
+{
+	struct kbase_shim_dev *sdev = platform_get_drvdata(pdev);
+
+	drm_put_minor(&sdev->dev->render);
+	drm_put_dev(sdev->dev);
+	kbase_release_device(sdev->kbdev);
+	if (shim == sdev)
+		shim = NULL;
+	kfree(sdev);
+	return 0;
+}
+
+static struct platform_driver kbase_shim_platform_driver = {
+	.probe = kbase_shim_probe,
+	.remove = kbase_shim_remove,
+	.driver = {
+		.name = "drm-kbase-shim",
+		.owner = THIS_MODULE,
+	},
+};
+
+static struct platform_device *kbase_shim_pdev;
+
+static int __init kbase_shim_init(void)
+{
+	int ret;
+
+	/* In-code device: matches NO DT compatible, steals no display node. */
+	kbase_shim_pdev = platform_device_register_simple("drm-kbase-shim",
+							  -1, NULL, 0);
+	if (IS_ERR(kbase_shim_pdev))
+		return PTR_ERR(kbase_shim_pdev);
+
+	ret = platform_driver_probe(&kbase_shim_platform_driver,
+				    kbase_shim_probe);
+	if (ret) {
+		platform_device_unregister(kbase_shim_pdev);
+		kbase_shim_pdev = NULL;
+	}
+	return ret;
+}
+
+static void __exit kbase_shim_exit(void)
+{
+	platform_driver_unregister(&kbase_shim_platform_driver);
+	if (kbase_shim_pdev) {
+		platform_device_unregister(kbase_shim_pdev);
+		kbase_shim_pdev = NULL;
+	}
+}
+
+module_init(kbase_shim_init);
+module_exit(kbase_shim_exit);
+MODULE_AUTHOR("G31_KbaseShim3");
+MODULE_DESCRIPTION("Optional H2 render node backed by kbase UK 10.6");
+MODULE_LICENSE("GPL v2");
+MODULE_ALIAS("platform:drm-kbase-shim");

