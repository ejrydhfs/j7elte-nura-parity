---
 drivers/gpu/drm/drm_sched.c  | 604 ++++++++++++++++++++++++++++++++++++++++++++++++++
 drivers/gpu/drm/drm_sched.h  | 231 ++++++++++++++++++++++++++++++++++++++++++++++++++
 2 files changed, 835 insertions(+)
