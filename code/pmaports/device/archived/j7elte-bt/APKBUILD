# Maintainer: ROM/Nura parity integration (SM-J700M / j7elte)
#
# Userspace bring-up for the BCM43438 Bluetooth controller on UART 3
# (/dev/ttySAC3).  The kernel has CONFIG_BT_HCIUART(_H4)=y but no hci_bcm /
# btbcm driver, so hciattach must download the patch RAM from
# /lib/firmware/postmarketos/samsung-j7elte/BCM43438A1.hcd.
pkgname=j7elte-bt
pkgver=0.1
pkgrel=0
pkgdesc="BCM43438 Bluetooth UART attach (hciattach) for the Samsung Galaxy J7"
url="https://postmarketos.org"
arch="noarch"
license="MIT"
options="!check"
# bluez-openrc supplies /etc/init.d/bluetooth, which this service starts after
# the HCI transport is attached.  hciattach ships in bluez-deprecated;
# /usr/sbin/rfkill is in util-linux-misc.
depends="bluez bluez-deprecated bluez-openrc util-linux-misc"
install="$pkgname.post-install"
source="j7elte-bt.initd
	j7elte-bt.confd
	j7elte-bt.service
	j7elte-bt.post-install
	"
builddir="$srcdir"

package() {
	install -Dm755 "$srcdir"/j7elte-bt.initd \
		"$pkgdir"/etc/init.d/j7elte-bt
	install -Dm644 "$srcdir"/j7elte-bt.confd \
		"$pkgdir"/etc/conf.d/j7elte-bt

	# Optional systemd equivalent; on OpenRC images the init script above is
	# used.  Both read /etc/conf.d/j7elte-bt.
	install -Dm644 "$srcdir"/j7elte-bt.service \
		"$pkgdir"/usr/lib/systemd/system/j7elte-bt.service
}

