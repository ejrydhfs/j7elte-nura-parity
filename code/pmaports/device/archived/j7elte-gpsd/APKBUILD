# Archived: unmaintained
# Reference: <https://postmarketos.org/devicepkg>
#
# Userspace bridge for the Broadcom BCM4752 GPS of the Samsung Galaxy J7
# (j7elte).  The kernel side (linux-samsung-j7elte) already provides
# /sys/class/sec/gps/GPS_PWR_EN/value and leaves /dev/ttySAC0 free; see
# parity/reports/gps.md and parity/reports/gps-userspace.md.
maintainer=""
pkgname=j7elte-gpsd
pkgver=1.0
pkgrel=0
pkgdesc="BCM4752 GPS NMEA bridge for the Samsung Galaxy J7 (j7elte)"
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends=""
makedepends=""
install=""
subpackages=""
source="
	j7elte-gpsd.c
	j7elte-gpsd.conf
	j7elte-gpsd.initd
	j7elte-gpsd.service
"

build() {
	$CC $CPPFLAGS $CFLAGS -std=c11 -Wall -Wextra -Wshadow \
		-o j7elte-gpsd j7elte-gpsd.c $LDFLAGS
}

package() {
	install -Dm755 j7elte-gpsd "$pkgdir"/usr/sbin/j7elte-gpsd
	install -Dm644 j7elte-gpsd.conf "$pkgdir"/etc/j7elte-gpsd.conf
	install -Dm755 j7elte-gpsd.initd "$pkgdir"/etc/init.d/j7elte-gpsd
	install -Dm644 j7elte-gpsd.service \
		"$pkgdir"/usr/lib/systemd/system/j7elte-gpsd.service
}

