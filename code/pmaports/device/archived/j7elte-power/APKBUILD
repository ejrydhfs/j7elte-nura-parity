# Battery charge limit and capacity_max restore for the Samsung Galaxy J7
# (SM-J700F/M, "j7elte", Exynos 7580 / SM5703).
#
# The vendor 3.10 kernel already exposes the standard power_supply class
# ("battery", "ac", "usb", "wireless"), so UPower gets level and charging state
# without any helper.  What userspace was missing:
#  * the stock ROM's /efs/Battery/batt_capacity_max calibration restore
#    (/system/bin/lpm does this on Android),
#  * any way to set a charge limit; the kernel has no
#    charge_control_end_threshold, only the sec_battery batt_slate_mode knob.
pkgname=j7elte-power
pkgver=1.0
pkgrel=0
pkgdesc="Battery charge limit and capacity_max restore for Samsung Galaxy J7 (j7elte)"
url="https://postmarketos.org"
arch="aarch64"
license="MIT"
depends=""
install="$pkgname.post-install"
source="
	j7elte-power.c
	j7elte-power.conf
	j7elte-power.service
	j7elte-efs-restore.service
	j7elte-power.initd
	j7elte-efs-restore.initd
	j7elte-power.post-install
	restore-capacity-max.sh
"
builddir="$srcdir"

build() {
	${CC:-cc} $CFLAGS -std=c11 -D_GNU_SOURCE -Wall -Wextra \
		-o j7elte-power j7elte-power.c $LDFLAGS
}

package() {
	install -Dm755 j7elte-power \
		"$pkgdir"/usr/bin/j7elte-power
	install -Dm755 restore-capacity-max.sh \
		"$pkgdir"/usr/libexec/j7elte-power/restore-capacity-max
	install -Dm644 j7elte-power.conf \
		"$pkgdir"/etc/j7elte-power.conf
	install -Dm644 j7elte-power.service \
		"$pkgdir"/usr/lib/systemd/system/j7elte-power.service
	install -Dm644 j7elte-efs-restore.service \
		"$pkgdir"/usr/lib/systemd/system/j7elte-efs-restore.service

	# OpenRC is the default service manager on this pmOS port; the systemd
	# units are installed alongside for systemd images.  The .post-install
	# script enables the restore service in whichever manager exists and
	# leaves the opt-in charge-limit daemon disabled.
	install -Dm755 j7elte-efs-restore.initd \
		"$pkgdir"/etc/init.d/j7elte-efs-restore
	install -Dm755 j7elte-power.initd \
		"$pkgdir"/etc/init.d/j7elte-power
}

